@namespace Lumeo
@inject Lumeo.Services.Localization.ILumeoLocalizer L

@* FlowNodeToolbar — a small toolbar that floats above (or below) the selected node(s). Place it
   inside FlowCanvas' ChildContent, same as FlowControls/FlowMiniMap/FlowPanel.

   Position: computed from the canvas' latest known viewport and the target rect (flow coords *
   zoom + viewport translation — the same transform the viewport layer applies), so it moves with
   every Blazor render (selection change, pane resize, a settled pan/zoom/drag). With exactly ONE
   node selected the target is that node's own rect, and while a POINTER DRAG of it is in flight
   flow.js additionally repositions the element live via data-flow-toolbar-for (mirroring how it
   redraws edges), so it does not lag a full render behind. With TWO OR MORE nodes selected
   (phase 4) the target is the union of every selected node's rect — ONE toolbar at the
   selection's bounding box, not one per node — and it settles on the next render only (no
   per-frame live tracking during a multi-node drag; the same "next viewport report settles it"
   caveat this component has always documented for pan/zoom now also covers that case). With
   zero nodes selected it renders nothing. *@

@if (TargetBounds is { } bounds)
{
    <div data-slot="flow-toolbar"
         data-flow-toolbar-for="@SingleNodeId"
         data-flow-toolbar-position="@(Position == ToolbarPosition.Bottom ? "bottom" : "top")"
         data-flow-overlay
         role="toolbar"
         aria-label="@L["Flow.NodeToolbar"]"
         class="@RootClass"
         style="@Style(bounds)"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private FlowCanvas.FlowCanvasContext? Context { get; set; }

    /// <summary>Which edge of the node the toolbar floats off.</summary>
    public enum ToolbarPosition { Top, Bottom }

    /// <summary>Floats above (default) or below the node.</summary>
    [Parameter] public ToolbarPosition Position { get; set; } = ToolbarPosition.Top;

    /// <summary>Gap between the node and the toolbar, in pane pixels.</summary>
    [Parameter] public double Offset { get; set; } = 8;

    /// <summary>The toolbar's content — usually a row of <c>Button</c>s.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS classes merged onto the toolbar.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Captures unmatched attributes and applies them to the toolbar.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The single selected node's own id, for flow.js's live drag tracking — null (and so absent from the DOM) with zero or several nodes selected.</summary>
    private string? SingleNodeId => Context?.Canvas.SingleSelectedNode()?.Id;

    private FlowRect? TargetBounds => Context?.Canvas.SelectedNodesBounds();

    private string? RootClass => Class;

    private string Style(FlowRect rect)
    {
        var v = Context!.Viewport;
        var zoom = v.Zoom > 0 ? v.Zoom : 1;
        var cx = (rect.X + rect.Width / 2) * zoom + v.X;
        var edgeY = Position == ToolbarPosition.Bottom ? rect.Bottom : rect.Y;
        var cy = edgeY * zoom + v.Y;
        var translateY = Position == ToolbarPosition.Bottom ? "0" : "-100%";
        var offsetPx = Position == ToolbarPosition.Bottom ? Offset : -Offset;
        return "position:absolute;z-index:6;left:" + FlowGeometry.Fmt(cx) + "px;top:" + FlowGeometry.Fmt(cy + offsetPx)
               + "px;transform:translate(-50%, " + translateY + ");";
    }
}
