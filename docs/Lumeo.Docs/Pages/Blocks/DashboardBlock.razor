                                                <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Icon" Class="size-8" OnClick="@(() => _page++)" Disabled="@(_page >= PageCount - 1)"><span class="sr-only">Go to next page</span><SvgGlyph Svg="@(Lucide.ChevronRight)" /></Button>
                                                <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Icon" Class="hidden size-8 lg:flex" OnClick="@(() => _page = PageCount - 1)" Disabled="@(_page >= PageCount - 1)"><span class="sr-only">Go to last page</span><SvgGlyph Svg="@(Lucide.ChevronsRight)" /></Button>
