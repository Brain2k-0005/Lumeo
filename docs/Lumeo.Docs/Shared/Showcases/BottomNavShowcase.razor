@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem] relative rounded-lg border border-border/40 overflow-hidden h-16">
    <BottomNav Fixed="false">
        <BottomNavItem Label="Home" IsActive="@(_active == 0)" OnClick="@(() => _active = 0)">
            <IconContent><DynamicIcon Name="House" Class="h-5 w-5" /></IconContent>
        </BottomNavItem>
        <BottomNavItem Label="Search" IsActive="@(_active == 1)" OnClick="@(() => _active = 1)">
            <IconContent><DynamicIcon Name="Search" Class="h-5 w-5" /></IconContent>
        </BottomNavItem>
        <BottomNavItem Label="Inbox" IsActive="@(_active == 2)" OnClick="@(() => _active = 2)">
            <IconContent><DynamicIcon Name="Inbox" Class="h-5 w-5" /></IconContent>
        </BottomNavItem>
        <BottomNavItem Label="Profile" IsActive="@(_active == 3)" OnClick="@(() => _active = 3)">
            <IconContent><DynamicIcon Name="User" Class="h-5 w-5" /></IconContent>
        </BottomNavItem>
    </BottomNav>
</div>

@code {
    private int _active;
}
