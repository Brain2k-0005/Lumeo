@page "/e2e/flow-preview"
@using System.Globalization

@* FlowCanvas E2E fixture (Lumeo.Flow). Deliberately NOT linked in navigation and NOT part
   of the component registry. The same nodes, edges and test ids as the Server-host fixture
   (tests/Lumeo.Tests.ServerHost/Components/Pages/E2E/FlowPage.razor) that the Playwright specs in
   tests/Lumeo.Tests.E2E/Flow drive over a real SignalR circuit; this copy runs the identical
   canvas on the docs WASM host.

   Query params: ?fit=0, ?snap=1, ?readonly=1. Sinks: flow-nodes-sink ("id:x,y;..." of the bound
   list), flow-viewport-sink ("x|y|zoom"), flow-commit-count (OnNodeDragStop calls),
   flow-last-click, flow-edges-sink ("id:source-target;..." of the bound edge list),
   flow-selection-sink ("nodeId,...|edgeId,..." of the latest OnSelectionChanged).
   [data-testid="flow-root"] gets data-flow-ready="done" once the engine has mounted and applied
   the initial fit. *@

<PageTitle>Flow canvas preview — Lumeo</PageTitle>

<PageHeader Title="Flow canvas (E2E fixture)"
            Description="FlowCanvas fixture for the browser-driven test suite. Not linked in navigation — see /components/flow-canvas for the docs." />

<div class="mt-6">
    <FlowCanvas data-testid="flow-root"
                Height="560px"
                @bind-Nodes="_nodes"
                @bind-Viewport="_viewport"
                @bind-Edges="_edges"
                FitViewOnInit="@(Fit != "0")"
                SnapToGrid="@(Snap == "1")"
                Readonly="@(Readonly == "1")"
                OnNodeDragStop="HandleDragStop"
                OnNodeClick="@(n => _lastClick = n.Id)"
                OnSelectionChanged="HandleSelectionChanged"
                IsValidConnection="RejectN1AsTarget">
        <NodeTemplate Context="ctx">
            <div class="w-40 rounded-lg border border-border bg-card px-3 py-2 text-sm text-card-foreground shadow-sm" data-testid="@("flow-card-" + ctx.Node.Id)">
                <FlowHandle Type="FlowHandleType.Target" Position="FlowPosition.Left" />
                <div class="font-medium">@ctx.Node.Data</div>
                <div class="text-xs text-muted-foreground">@ctx.Node.Id</div>
                <FlowHandle Type="FlowHandleType.Source" Position="FlowPosition.Right" />
            </div>
        </NodeTemplate>
        <ChildContent>
            <FlowBackground />
            <FlowControls />
            <FlowMiniMap />
        </ChildContent>
    </FlowCanvas>
</div>

<pre data-testid="flow-nodes-sink" hidden>@NodesText</pre>
<pre data-testid="flow-viewport-sink" hidden>@ViewportText</pre>
<pre data-testid="flow-commit-count" hidden>@_commits</pre>
<pre data-testid="flow-last-click" hidden>@_lastClick</pre>
<pre data-testid="flow-edges-sink" hidden>@EdgesText</pre>
<pre data-testid="flow-selection-sink" hidden>@_selectionText</pre>

@code {
    [SupplyParameterFromQuery] public string? Fit { get; set; }
    [SupplyParameterFromQuery] public string? Snap { get; set; }
    [SupplyParameterFromQuery] public string? Readonly { get; set; }

    private IReadOnlyList<FlowNode> _nodes = new List<FlowNode>
    {
        new("n1", 0, 0, Data: "Trigger"),
        new("n2", 320, 0, Data: "Enrich"),
        new("n3", 640, 0, Data: "Branch"),
        new("n4", 0, 240, Data: "Notify"),
        new("n5", 320, 240, Data: "Store"),
        new("n6", 960, 420, Data: "Archive"),
    };

    private IReadOnlyList<FlowEdge> _edges = new List<FlowEdge>
    {
        new("e1", "n1", "n2"),
        new("e2", "n2", "n3", Type: FlowEdgeType.SmoothStep),
        new("e3", "n1", "n4", Type: FlowEdgeType.Step),
        new("e4", "n4", "n5"),
        new("e5", "n3", "n6", Type: FlowEdgeType.Straight),
    };

    private FlowViewport _viewport = new(0, 0, 1);
    private int _commits;
    private string _lastClick = "";
    private string _selectionText = "|";

    private void HandleDragStop(IReadOnlyList<FlowNodeChange> changes) => _commits++;

    // Test-only rule so the "invalid connection is rejected" E2E spec has something to reject:
    // n1 may never be a connection TARGET (it already has two outgoing edges as a source).
    private bool RejectN1AsTarget(FlowConnection c) => c.Target != "n1";

    private void HandleSelectionChanged(FlowSelection selection)
        => _selectionText = string.Join(",", selection.NodeIds.OrderBy(x => x, StringComparer.Ordinal))
                             + "|" + string.Join(",", selection.EdgeIds.OrderBy(x => x, StringComparer.Ordinal));

    private static string R(double v) => v.ToString("R", CultureInfo.InvariantCulture);

    private string NodesText => string.Join(";", _nodes.Select(n => n.Id + ":" + R(n.X) + "," + R(n.Y)));

    private string ViewportText => R(_viewport.X) + "|" + R(_viewport.Y) + "|" + R(_viewport.Zoom);

    private string EdgesText => string.Join(";", _edges.Select(e => e.Id + ":" + e.Source + "-" + e.Target));
}
