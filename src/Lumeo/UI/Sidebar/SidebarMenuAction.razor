@namespace Lumeo
@* shadcn's SidebarMenuAction: the small button on the right edge of a menu entry (the
   "..." that opens a per-item menu). Positioned against SidebarMenuItem; its top follows
   the sibling button's size. ShowOnHover keeps it invisible on pointer devices until the
   entry is hovered or focused, or its own menu is open. *@
<button type="button" data-slot="sidebar-menu-action" data-sidebar="menu-action" class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS classes, merged after the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Reveal only while the entry is hovered or focused (or the action's own menu is open).</summary>
    [Parameter] public bool ShowOnHover { get; set; }

    private string CssClass => Cx.Merge(
        "text-sidebar-foreground ring-sidebar-ring hover:bg-sidebar-accent hover:text-sidebar-accent-foreground peer-hover/menu-button:text-sidebar-accent-foreground",
        "absolute top-1.5 right-1 flex aspect-square w-5 items-center justify-center rounded-md p-0 outline-hidden transition-transform focus-visible:ring-2",
        "[&>svg]:size-4 [&>svg]:shrink-0 after:absolute after:-inset-2 md:after:hidden",
        "peer-data-[size=sm]/menu-button:top-1 peer-data-[size=default]/menu-button:top-1.5 peer-data-[size=lg]/menu-button:top-2.5",
        "group-data-[collapsible=icon]:hidden",
        Cx.When(ShowOnHover, "peer-data-[active=true]/menu-button:text-sidebar-accent-foreground group-focus-within/menu-item:opacity-100 group-hover/menu-item:opacity-100 aria-expanded:opacity-100 data-[state=open]:opacity-100 md:opacity-0"),
        Class);
}
