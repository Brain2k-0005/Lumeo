@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem] h-[200px] rounded-lg border border-border/40 p-3">
    <OverlayForm Model="@_model" OnValidSubmit="@(_ => { })">
        <Body>
            <Stack Gap="3">
                <Stack Gap="1.5">
                    <Label>Name</Label>
                    <Input @bind-Value="_model.Name" />
                </Stack>
                <Stack Gap="1.5">
                    <Label>Email</Label>
                    <Input @bind-Value="_model.Email" />
                </Stack>
            </Stack>
        </Body>
        <Footer>
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" Type="Button.ButtonType.Button">Cancel</Button>
            <Button Size="Button.ButtonSize.Sm" Type="Button.ButtonType.Submit">Save</Button>
        </Footer>
    </OverlayForm>
</div>

@code {
    private readonly ContactModel _model = new() { Name = "Jane Doe", Email = "jane@example.com" };

    private sealed class ContactModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
    }
}
