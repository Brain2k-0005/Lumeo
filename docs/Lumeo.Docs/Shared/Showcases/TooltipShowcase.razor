@namespace Lumeo.Docs.Shared.Showcases

@* Real component end to end (fix round 1): TooltipContent is positioned through
   Interop.PositionFixed and escapes the card's overflow-hidden (README rule 4). Tooltip
   has no controlled-open param at all (hover/focus only), so the trigger is real and the
   bubble opens on real hover/focus, exactly like anywhere else in the app. *@
<div class="w-full max-w-[22rem]">
    <Tooltip>
        <TooltipTrigger>
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm">Hover me</Button>
        </TooltipTrigger>
        <TooltipContent>
            <Lumeo.Text>Add to library</Lumeo.Text>
        </TooltipContent>
    </Tooltip>
</div>
