@namespace Lumeo.Docs.Shared.Showcases

@* DropdownMenuContent is positioned via Interop.PositionFixed (real `position: fixed`,
   floating-ui anchored to the trigger) — per the wave brief this still gets a static inline
   replica rather than a click-driven open (so the card shows the menu immediately, and the
   showcase doesn't depend on the floating-ui JS running against a catalog-grid layout). Classes
   lifted from DropdownMenuContent/DropdownMenuLabel/DropdownMenuItem/DropdownMenuSeparator. *@
<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" Class="w-fit">
            Open
            <DynamicIcon Name="ChevronDown" Class="ml-2 h-4 w-4" />
        </Button>
        <Stack Gap="0" Class="w-40 rounded-lg border border-border/60 bg-popover p-1 text-popover-foreground shadow-md">
            <Lumeo.Text As="span" Size="xs" Weight="semibold" Class="px-2 py-1.5">My Account</Lumeo.Text>
            <div class="-mx-1 my-1 h-px bg-border"></div>
            <Lumeo.Text As="span" Size="sm" Class="rounded-sm px-2 py-1.5 hover:bg-accent">Profile</Lumeo.Text>
            <Lumeo.Text As="span" Size="sm" Class="rounded-sm px-2 py-1.5 hover:bg-accent">Settings</Lumeo.Text>
            <div class="-mx-1 my-1 h-px bg-border"></div>
            <Lumeo.Text As="span" Size="sm" Class="rounded-sm px-2 py-1.5 hover:bg-accent">Log out</Lumeo.Text>
        </Stack>
    </Stack>
</div>
