@namespace Lumeo

@* One option inside a MenubarRadioGroup (shadcn MenubarRadioItem). Mirrors
   DropdownMenuRadioItem: selected state is derived from the cascaded group Value,
   and the filled dot lives in the ps-8 gutter. *@
<button data-slot="menubar-radio-item" type="button" role="menuitemradio" aria-checked="@IsSelected.ToString().ToLower()" tabindex="-1" class="@CssClass" @onclick="Select" disabled="@Disabled" @attributes="AdditionalAttributes">
    <span class="flex h-3.5 w-3.5 items-center justify-center">
        @if (IsSelected)
        {
            <SvgGlyph Svg="@(LumeoIcons.Circle)" class="h-2 w-2 fill-current" />
        }
    </span>
    @ChildContent
</button>

@code {
    [CascadingParameter] public MenubarRadioGroup.MenubarRadioGroupContext Context { get; set; } = default!;
    // The enclosing Menubar's open-menu context. Mirrors the DropdownMenuRadioItem fix:
    // Radix closes the menu on radio item selection, same as a plain item (field report
    // #464, finding 2). Nullable/null-checked (unlike MenubarItem's non-nullable Context)
    // so an isolated render (e.g. a unit test rendering just the radio group) doesn't NRE.
    [CascadingParameter] public Menubar.MenubarContext? MenuContext { get; set; }
    /// <summary>The option's label content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>This option's value, compared against the ambient <see cref="MenubarRadioGroup.Value"/> to decide whether it's selected and passed to <see cref="MenubarRadioGroup.ValueChanged"/> on selection. Required.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    /// <summary>Disables the option, preventing clicks from selecting it.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Additional CSS classes merged onto the option's <c>&lt;button&gt;</c>.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Captures any unmatched attributes and applies them to the option's <c>&lt;button&gt;</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsSelected => Context.Value == Value;

    // DocFlow T2 density follow-up (#523): see ContextMenuItem.MinHClass's remarks — same
    // token wiring, same no-op-by-default guarantee. Menubar is not density-aware either.
    private const string MinHClass = "min-h-[var(--lumeo-menu-item-h,calc(var(--spacing,0.25rem)*8))]";

    private string CssClass => Cx.Merge("relative flex w-full cursor-default select-none items-center gap-2 rounded-sm ps-8 pe-2 py-1.5 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground disabled:pointer-events-none disabled:opacity-50 disabled:cursor-not-allowed", MinHClass, Class);

    private async Task Select()
    {
        if (Disabled) return;
        await Context.OnSelect.InvokeAsync(Value);
        if (MenuContext is not null)
        {
            await MenuContext.SetOpenMenuId.InvokeAsync(null);
        }
    }
}
