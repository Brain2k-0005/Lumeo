@namespace Lumeo

<div class="lumeo-chart-legend flex flex-wrap items-center gap-x-3.5 gap-y-1 @Class" @attributes="AdditionalAttributes">
    @foreach (var item in Items)
    {
        var isHidden = HiddenKeys?.Contains(item.Key) ?? false;
        var isDimmed = HoveredKey is not null && HoveredKey != item.Key;
        <button type="button"
                class="lumeo-chart-legend-item inline-flex items-center gap-1.5 border-0 bg-transparent p-0 text-xs font-medium text-muted-foreground transition-opacity hover:text-foreground @(isHidden ? "opacity-45" : "")"
                style="opacity:@(isDimmed && !isHidden ? "0.45" : "1")"
                @onclick="() => OnToggle.InvokeAsync(item.Key)"
                @onmouseenter="() => OnHover.InvokeAsync(item.Key)"
                @onmouseleave="() => OnHover.InvokeAsync(null)">
            <span class="lumeo-chart-legend-swatch inline-block h-2.5 w-2.5 rounded-sm"
                  style="@(isHidden ? $"background:transparent;box-shadow:inset 0 0 0 1.5px {item.Color}" : $"background:{item.Color}")"></span>
            <span>@item.Name</span>
            @if (item.Value is not null)
            {
                <b class="font-semibold text-foreground">@item.Value</b>
            }
        </button>
    }
</div>

@code {
    /// <summary>Custom CSS classes appended to the root <c>&lt;div&gt;</c>.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The series to render swatches for.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ChartLegendItem> Items { get; set; } = Array.Empty<ChartLegendItem>();

    /// <summary>Keys currently toggled off (rendered as an outline-only swatch).</summary>
    [Parameter] public IReadOnlyCollection<string>? HiddenKeys { get; set; }

    /// <summary>Key of the currently-hovered item; every OTHER item dims.</summary>
    [Parameter] public string? HoveredKey { get; set; }

    /// <summary>Fires with the clicked item's key — the caller owns the
    /// visibility decision (typically via <see cref="ChartLegendState.Toggle"/>).</summary>
    [Parameter] public EventCallback<string> OnToggle { get; set; }

    /// <summary>Fires with the hovered item's key, or <c>null</c> on mouse-leave.</summary>
    [Parameter] public EventCallback<string?> OnHover { get; set; }
}
