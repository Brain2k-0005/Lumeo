@namespace Lumeo

@* Native (first-party, non-ECharts) Radar chart — N straight axes radiating
   from a shared center (RadarCoordinateSystem), per the charts-first-party-
   engine spec. Sits ALONGSIDE the legacy ECharts RadarChart — that file is
   untouched. *@

<div class="lumeo-native-radar relative flex flex-col gap-2 @Class" style="width:@Width;height:@Height" @attributes="AdditionalAttributes">
    <div class="relative min-h-0 flex-1">
        <svg viewBox="0 0 @ViewW @ViewH" preserveAspectRatio="xMidYMid meet" class="h-full w-full" role="img" aria-label="@_a11ySummary">
            @((MarkupString)_gridMarkup)
            @for (var s = 0; s < _series.Count; s++)
            {
                var series = _series[s];
                var dimmed = _legend.IsDimmed(series.Key) || (_activeSeries is { } asx && asx != s && (_hovered || _keyboardActive));
                @if (FillArea)
                {
                    <polygon points="@series.Points" fill="@series.Color" fill-opacity="@(dimmed ? "0.06" : "0.18")" stroke="none" style="transition:fill-opacity 150ms ease;" />
                }
                <polygon points="@series.Points" fill="none" stroke="@series.Color" stroke-width="2" opacity="@(dimmed ? "0.35" : "1")" style="transition:opacity 150ms ease;">
                    <animate attributeName="opacity" from="0" to="@(dimmed ? "0.35" : "1")" dur="@(EntryDurationMs)ms" fill="freeze" />
                </polygon>
                @for (var a = 0; a < series.Dots.Count; a++)
                {
                    var dot = series.Dots[a];
                    var isActive = _activeSeries == s && _activeAxis == a && (_hovered || _keyboardActive);
                    <circle cx="@NativeChartShared.Fmt(dot.X)" cy="@NativeChartShared.Fmt(dot.Y)" r="@(isActive ? "4.5" : "3")" fill="@series.Color"
                            stroke="var(--color-card)" stroke-width="1.5" opacity="@(dimmed ? "0.35" : "1")"
                            @onpointerenter="@(e => OnDotEnter(s, a, e))" @onpointerleave="OnDotLeave" />
                }
            }
            @((MarkupString)_axisLabelsMarkup)
            <rect x="0" y="0" width="@ViewW" height="@ViewH" fill="transparent" tabindex="0" role="img"
                  aria-label="@_a11ySummary" class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
                  @onkeydown="OnKeyDown" @onfocus="OnFocusHost" @onblur="OnBlurHost" />
        </svg>
        <div class="pointer-events-none absolute left-2 top-2 max-w-[70%] rounded-md border border-border/60 bg-background/90 px-2 py-1 text-xs text-foreground shadow-sm transition-opacity"
             style="opacity:@(string.IsNullOrEmpty(_statusText) ? "0" : "1")" role="status" aria-live="polite">
            @_statusText
        </div>
        @if (ShouldShowSkeleton)
        {
            <div class="absolute inset-0 pointer-events-none">
                <ChartSkeleton Kind="@SkeletonKind" Width="100%" Height="100%" Class="!rounded-none" />
            </div>
            @if (ShowLoadingLabel)
            {
                <div role="status" aria-live="polite" class="pointer-events-none absolute top-2 right-2 rounded-[calc(var(--radius)*2)] border border-border/60 bg-background/85 px-2.5 py-1 text-xs shadow-sm">
                    @(LoadingText ?? "Loading…")
                </div>
            }
        }
    </div>
    @if (ShowLegend && _legendItems.Count > 0)
    {
        <ChartLegend Items="@_legendItems" HiddenKeys="@_legend.HiddenKeys" HoveredKey="@_legend.HoveredKey"
                     Class="justify-center"
                     OnToggle="@(EventCallback.Factory.Create<string>(this, OnLegendToggle))"
                     OnHover="@(EventCallback.Factory.Create<string?>(this, OnLegendHover))" />
    }
    @if (_a11yTable is { } table)
    {
        <table class="sr-only" aria-label="@table.Summary">
            <caption>@table.Summary</caption>
            <thead><tr>@foreach (var h in table.ColumnHeaders) { <th scope="col">@h</th> }</tr></thead>
            <tbody>
                @foreach (var row in table.Rows)
                {
                    <tr><th scope="row">@row.Header</th>@foreach (var cell in row.Cells) { <td>@cell</td> }</tr>
                }
                @if (table.TruncationNote is { } note)
                {
                    <tr><td colspan="@table.ColumnHeaders.Count">@note</td></tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    /// <summary>The radar's axes, each with a name and a max value defining its scale.</summary>
    [Parameter] public List<RadarIndicator> Indicators { get; set; } = new();
    /// <summary>Each data line's values, one per <see cref="Indicators"/> entry, drawn across the radar axes.</summary>
    [Parameter] public List<RadarSeriesData> Series { get; set; } = new();
    /// <summary>When true (default), renders a legend listing each series/segment name.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;
    /// <summary>When true (default), shows a tooltip with the value(s) under the cursor on hover.</summary>
    [Parameter] public bool ShowTooltip { get; set; } = true;
    /// <summary>Radar grid shape. <c>circle</c> draws circular rings; anything else (default <c>polygon</c>) draws polygon rings matching the axis count. Data boundaries are always straight-line polygons (matches ECharts' own behavior — <c>Shape</c> only affects the background grid).</summary>
    [Parameter] public string Shape { get; set; } = "polygon";
    /// <summary>When true (default), fills the area under each series line.</summary>
    [Parameter] public bool FillArea { get; set; } = true;
    /// <summary>Explicit colors, in series order. Falls back to the active theme's chart palette when not set and <see cref="ColorPalette"/> is not set.</summary>
    [Parameter] public List<string>? Colors { get; set; }
    /// <summary>Explicit ordered color palette applied to each series; takes precedence over <see cref="Colors"/> when both are set.</summary>
    [Parameter] public List<string>? ColorPalette { get; set; }
    /// <summary>CSS width of the chart container. Defaults to <c>100%</c>.</summary>
    [Parameter] public string Width { get; set; } = "100%";
    /// <summary>CSS height of the chart container. Defaults to <c>350px</c>.</summary>
    [Parameter] public string Height { get; set; } = "350px";
    /// <summary>Additional CSS class(es) applied to the chart's root element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Additional HTML attributes captured and forwarded to the chart's root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    /// <summary>When true, overlays a shape-aware loading skeleton on top of the chart (consumer is fetching data).</summary>
    [Parameter] public bool IsLoading { get; set; }
    /// <summary>When true (default), renders a shape-aware skeleton while <see cref="IsLoading"/> is true.</summary>
    [Parameter] public bool ShowLoadingSkeleton { get; set; } = true;
    /// <summary>Shape family for the loading skeleton. Defaults to <c>ChartSkeletonKind.Radar</c>.</summary>
    [Parameter] public ChartSkeletonKind SkeletonKind { get; set; } = ChartSkeletonKind.Radar;
    /// <summary>See <see cref="NativePieChart.SkeletonStyle"/> — only <c>Silhouette</c> is implemented natively.</summary>
    [Parameter] public ChartSkeletonStyle SkeletonStyle { get; set; } = ChartSkeletonStyle.Phantom;
    /// <summary>Inert on the native engine; kept for API parity.</summary>
    [Parameter] public int PhantomCycleMs { get; set; } = 1400;
    /// <summary>When true (default), shows a small "Loading…" pill in the top-right corner whenever <see cref="IsLoading"/> is active.</summary>
    [Parameter] public bool ShowLoadingLabel { get; set; } = true;
    /// <summary>Label rendered next to the loading pill. Defaults to "Loading…".</summary>
    [Parameter] public string? LoadingText { get; set; } = "Loading…";
    /// <summary>When true, renders a label with each data point's value directly on the chart.</summary>
    [Parameter] public bool ShowDataLabels { get; set; }
    /// <summary>Placement of the value label; kept for API parity (native dots always sit at the axis position).</summary>
    [Parameter] public string LabelPosition { get; set; } = "top";
    /// <summary>Label formatter template supporting the <c>{b}</c>/<c>{c}</c> tokens from the legacy ECharts formatter mini-language.</summary>
    [Parameter] public string? LabelFormat { get; set; }
    /// <summary>Entrance-animation duration (ms) for each series polygon's fade-in. Defaults to 500ms.</summary>
    [Parameter] public int? AnimationDuration { get; set; }
    /// <summary>See <see cref="NativePieChart.AnimationEasing"/> — accepted for API parity, currently has no effect.</summary>
    [Parameter] public string? AnimationEasing { get; set; }

    private const double ViewW = 420, ViewH = 300;
    private double CenterX => ViewW / 2;
    private double CenterY => ViewH / 2 + 6;
    private const double MaxRadius = 100;
    private int EntryDurationMs => AnimationDuration ?? 500;
    private bool ShouldShowSkeleton => IsLoading && ShowLoadingSkeleton;

    private readonly ChartLegendState _legend = new();
    private List<RadarSeriesRender> _series = new();
    private List<ChartLegendItem> _legendItems = new();
    private int? _activeSeries;
    private int _activeAxis;
    private bool _hovered;
    private bool _keyboardActive;
    private string _statusText = string.Empty;
    private string _a11ySummary = string.Empty;
    private string _gridMarkup = string.Empty;
    private string _axisLabelsMarkup = string.Empty;
    private ChartAccessibility.ChartDataTable? _a11yTable;

    protected override void OnParametersSet()
    {
        BuildGrid();
        BuildSeries();
        BuildAccessibility();
    }

    private void BuildGrid()
    {
        var sb = new System.Text.StringBuilder();
        var axisCount = Math.Max(Indicators.Count, 3);
        if (Indicators.Count >= 3)
        {
            var radar = new RadarCoordinateSystem(CenterX, CenterY, MaxRadius, axisCount);
            for (var ring = 1; ring <= 4; ring++)
            {
                var f = ring / 4.0;
                if (string.Equals(Shape, "circle", StringComparison.OrdinalIgnoreCase))
                {
                    sb.Append("<circle cx=\"").Append(NativeChartShared.Fmt(CenterX)).Append("\" cy=\"").Append(NativeChartShared.Fmt(CenterY))
                      .Append("\" r=\"").Append(NativeChartShared.Fmt(MaxRadius * f)).Append("\" fill=\"none\" stroke=\"var(--color-border)\" />");
                }
                else
                {
                    var pts = string.Join(' ', Enumerable.Range(0, axisCount).Select(i =>
                    {
                        var (x, y) = radar.PointAt(f, i);
                        return $"{NativeChartShared.Fmt(x)},{NativeChartShared.Fmt(y)}";
                    }));
                    sb.Append("<polygon points=\"").Append(pts).Append("\" fill=\"none\" stroke=\"var(--color-border)\" />");
                }
            }
            for (var i = 0; i < axisCount; i++)
            {
                var (x, y) = radar.PointAt(1, i);
                sb.Append("<line x1=\"").Append(NativeChartShared.Fmt(CenterX)).Append("\" y1=\"").Append(NativeChartShared.Fmt(CenterY))
                  .Append("\" x2=\"").Append(NativeChartShared.Fmt(x)).Append("\" y2=\"").Append(NativeChartShared.Fmt(y)).Append("\" stroke=\"var(--color-border)\" />");
            }
        }
        _gridMarkup = sb.ToString();
    }

    private void BuildSeries()
    {
        _series = new List<RadarSeriesRender>();
        _legendItems = new List<ChartLegendItem>();

        for (var s = 0; s < Series.Count; s++)
        {
            var key = SeriesKey(s);
            _legendItems.Add(new ChartLegendItem(key, Series[s].Name, NativeChartShared.ColorFor(s, ColorPalette, Colors)));
        }

        if (Indicators.Count < 3) { _axisLabelsMarkup = string.Empty; return; }

        var radar = new RadarCoordinateSystem(CenterX, CenterY, MaxRadius, Indicators.Count);
        for (var s = 0; s < Series.Count; s++)
        {
            var key = SeriesKey(s);
            if (_legend.IsHidden(key)) continue;
            var data = Series[s];
            var normalized = new List<double>(Indicators.Count);
            for (var a = 0; a < Indicators.Count; a++)
            {
                var raw = a < data.Values.Count ? data.Values[a] : 0;
                var max = Indicators[a].Max > 0 ? Indicators[a].Max : 1;
                normalized.Add(Math.Clamp(raw / max, 0, 1));
            }
            var points = string.Join(' ', Enumerable.Range(0, Indicators.Count).Select(i =>
            {
                var (x, y) = radar.PointAt(normalized[i], i);
                return $"{NativeChartShared.Fmt(x)},{NativeChartShared.Fmt(y)}";
            }));
            var dots = Enumerable.Range(0, Indicators.Count).Select(i =>
            {
                var (x, y) = radar.PointAt(normalized[i], i);
                return (X: x, Y: y);
            }).ToList();

            _series.Add(new RadarSeriesRender(s, key, data.Name, NativeChartShared.ColorFor(s, ColorPalette, Colors), points, dots, data.Values));
        }

        // Axis-name labels are structural (like a cartesian axis' category labels) and
        // always render, independent of ShowDataLabels (which — per the legacy
        // wrapper's own semantics — governs per-point VALUE labels, not axis names).
        var sbLabels = new System.Text.StringBuilder();
        {
            for (var i = 0; i < Indicators.Count; i++)
            {
                var (x, y) = radar.PointAt(1.12, i);
                var angle = radar.AngleForAxis(i);
                var anchor = Math.Cos(angle) > 0.25 ? "start" : Math.Cos(angle) < -0.25 ? "end" : "middle";
                sbLabels.Append("<text x=\"").Append(NativeChartShared.Fmt(x)).Append("\" y=\"").Append(NativeChartShared.Fmt(y))
                  .Append("\" fill=\"var(--color-muted-foreground)\" font-size=\"11\" text-anchor=\"").Append(anchor).Append("\">")
                  .Append(System.Net.WebUtility.HtmlEncode(Indicators[i].Name)).Append("</text>");
            }
        }
        _axisLabelsMarkup = sbLabels.ToString();
    }

    private string SeriesKey(int index) => $"series-{index}-{Series[index].Name}";

    private void OnDotEnter(int seriesIndex, int axisIndex, Microsoft.AspNetCore.Components.Web.PointerEventArgs _)
    {
        _hovered = true;
        _activeSeries = seriesIndex;
        _activeAxis = axisIndex;
        UpdateStatus();
    }

    private void OnDotLeave()
    {
        _hovered = false;
        if (!_keyboardActive) { _activeSeries = null; _statusText = string.Empty; }
    }

    private void OnFocusHost()
    {
        _keyboardActive = true;
        _activeSeries ??= _series.Count > 0 ? _series[0].OriginalIndex : null;
        UpdateStatus();
    }

    private void OnBlurHost()
    {
        _keyboardActive = false;
        if (!_hovered) { _activeSeries = null; _statusText = string.Empty; }
    }

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (_series.Count == 0 || Indicators.Count == 0) return;
        _keyboardActive = true;
        switch (e.Key)
        {
            case "ArrowRight":
                _activeAxis = ChartKeyboardNav.MoveIndex(_activeAxis, Indicators.Count, 1) ?? _activeAxis;
                break;
            case "ArrowLeft":
                _activeAxis = ChartKeyboardNav.MoveIndex(_activeAxis, Indicators.Count, -1) ?? _activeAxis;
                break;
            case "Home":
                _activeAxis = ChartKeyboardNav.First();
                break;
            case "End":
                _activeAxis = ChartKeyboardNav.Last(Indicators.Count);
                break;
            case "ArrowUp":
            case "ArrowDown":
                if (_series.Count > 1)
                {
                    var cur = _activeSeries is { } asx ? _series.FindIndex(s => s.OriginalIndex == asx) : 0;
                    var next = ChartKeyboardNav.MoveSeries(Math.Max(cur, 0), _series.Count, e.Key == "ArrowUp" ? -1 : 1);
                    _activeSeries = _series[next].OriginalIndex;
                }
                break;
            default:
                return;
        }
        _activeSeries ??= _series.Count > 0 ? _series[0].OriginalIndex : null;
        UpdateStatus();
    }

    private void UpdateStatus()
    {
        if (!ShowTooltip || _activeSeries is not { } asIdx) { _statusText = string.Empty; return; }
        var series = _series.FirstOrDefault(s => s.OriginalIndex == asIdx);
        if (series is null || _activeAxis >= series.RawValues.Count) { _statusText = string.Empty; return; }
        var axisName = _activeAxis < Indicators.Count ? Indicators[_activeAxis].Name : $"Axis {_activeAxis + 1}";
        _statusText = $"{series.Name} · {axisName}: {NativeChartShared.FmtValue(series.RawValues[_activeAxis])}";
    }

    private void OnLegendToggle(string key)
    {
        _legend.Toggle(key, Series.Count);
        BuildSeries();
    }

    private void OnLegendHover(string? key) => _legend.SetHover(key);

    private void BuildAccessibility()
    {
        var categories = Indicators.Select(i => i.Name).ToList();
        var seriesData = Series.Select(s => (s.Name, (IReadOnlyList<double>)s.Values)).ToList();
        var json = NativeChartShared.BuildCartesianOptionJson("radar", categories, seriesData);
        _a11yTable = ChartAccessibility.Build(json);
        _a11ySummary = _a11yTable?.Summary ?? "Radar chart";
    }

    private sealed record RadarSeriesRender(
        int OriginalIndex, string Key, string Name, string Color, string Points,
        List<(double X, double Y)> Dots, List<double> RawValues);

    public class RadarIndicator
    {
        public string Name { get; set; } = "";
        public double Max { get; set; }
    }

    public class RadarSeriesData
    {
        public string Name { get; set; } = "";
        public List<double> Values { get; set; } = new();
    }
}
