@namespace Lumeo
@* shadcn's SidebarMenuSub: the indented list under a menu button, with the guide line on
   its left. Measured live 2026-09-02: mx-3.5, px-2.5, py-0.5, gap-1, 1px border. Hidden
   in the icon rail, where there is no room for a second level. *@
<ul data-slot="sidebar-menu-sub" data-sidebar="menu-sub" class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</ul>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS classes, merged after the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Cx.Merge(
        "border-sidebar-border mx-3.5 flex min-w-0 translate-x-px flex-col gap-1 border-l px-2.5 py-0.5",
        "group-data-[collapsible=icon]:hidden",
        Class);
}
