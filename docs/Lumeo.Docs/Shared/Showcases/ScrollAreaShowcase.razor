@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <ScrollArea Class="h-32 rounded-md border bg-card p-3">
        <Stack Gap="0">
            @foreach (var tag in _tags)
            {
                <Stack Class="text-sm text-foreground py-1.5 border-b last:border-0">@tag</Stack>
            }
        </Stack>
    </ScrollArea>
</div>

@code {
    private readonly string[] _tags = ["Blazor", "Tailwind CSS", "C#", "SignalR", ".NET 10", "WebAssembly"];
}
