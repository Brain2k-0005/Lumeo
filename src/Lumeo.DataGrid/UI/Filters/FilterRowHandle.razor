@namespace Lumeo

@* The drag handle of an advanced row or group: a pointer drag moves the node (Alt copies), and
   the keyboard shortcut is announced for those who cannot drag. *@
<button type="button"
        id="@Panel.CellId(NodeId, FilterChipSegment.Drag)"
        data-filter-cell="drag"
        data-filter-drag="@(Context.Locked ? null : "true")"
        tabindex="@(Active ? 0 : -1)"
        class="@Cx.Join(FilterAdvancedRow.IconButtonClass(Context.Size), "cursor-grab touch-none active:cursor-grabbing focus-visible:text-foreground")"
        aria-label="@Context.Labels.Reorder"
        aria-keyshortcuts="Alt+ArrowUp Alt+ArrowDown"
        aria-description="@Context.Labels.ReorderHint"
        disabled="@Context.Disabled"
        aria-disabled="@(Context.ReadOnly ? "true" : null)"
        @onfocus="() => Context.SetFocus(NodeId, FilterChipSegment.Drag)"
        @onkeydown="e => Panel.HandleCellKey(NodeId, FilterChipSegment.Drag, e, false)">
    <SvgGlyph Svg="@(LumeoIcons.GripVertical)" class="h-4 w-4" />
</button>

@code {
    [CascadingParameter] public FiltersContext Context { get; set; } = default!;
    [CascadingParameter] public FiltersAdvancedPanel Panel { get; set; } = default!;
    [Parameter, EditorRequired] public string NodeId { get; set; } = "";
    [Parameter] public bool Active { get; set; }
}
