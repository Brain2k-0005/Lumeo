@namespace Lumeo
@* shadcn's FieldSeparator: a rule between fields, optionally with a label sitting on it
   ("Or continue with"). Measured live 2026-09-02: 20px tall, pulled in by -my-2 so it
   costs the group 4px net. *@
<div data-slot="field-separator" data-content="@(ChildContent is not null ? "true" : "false")" class="@CssClass" @attributes="AdditionalAttributes">
    <Separator Class="absolute inset-0 top-1/2" />
    @if (ChildContent is not null)
    {
        <span data-slot="field-separator-content" class="text-muted-foreground relative mx-auto block w-fit bg-background px-2">@ChildContent</span>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS classes, merged after the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Cx.Merge("relative -my-2 h-5 text-sm group-data-[variant=outline]/field-group:-mb-2", Class);
}
