@namespace Lumeo.Docs.Shared.Showcases

@* Fix round 1: real Sheet + real trigger — clicking "Open Sheet" opens the REAL
   SheetContent as a full-height edge panel over the page (expected, same as anywhere
   else in the app). The strip below is an explicitly-marked PREVIEW ONLY static mock
   of that panel's edge-anchored shape, no ARIA roles. *@
<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <Sheet @bind-Open="_open">
            <SheetTrigger>
                <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" Class="w-fit">Open Sheet</Button>
            </SheetTrigger>
            <SheetContent>
                <SheetHeader>
                    <SheetTitle>Edit Profile</SheetTitle>
                    <SheetDescription>Make changes to your profile here. Click save when you're done.</SheetDescription>
                </SheetHeader>
                <Grid Columns="4" Gap="4" Class="items-center py-4">
                    <Label Class="justify-end text-right">Name</Label>
                    <Input Class="col-span-3" Value="John Doe" />
                    <Label Class="justify-end text-right">Username</Label>
                    <Input Class="col-span-3" Value="@("@johndoe")" />
                </Grid>
                <SheetFooter>
                    <SheetClose>
                        <Button>Save Changes</Button>
                    </SheetClose>
                </SheetFooter>
            </SheetContent>
        </Sheet>

        @* PREVIEW ONLY — not the live panel. *@
        <div class="h-24 rounded-lg border border-border/40 bg-muted/20 overflow-hidden relative">
            <Stack Gap="1" Class="absolute inset-y-0 end-0 w-2/3 bg-background p-2 shadow-lg">
                <Lumeo.Text Size="xs" Weight="semibold">Edit Profile</Lumeo.Text>
                <Lumeo.Text Size="xs" Color="muted" Class="truncate">Make changes to your profile here.</Lumeo.Text>
            </Stack>
        </div>
    </Stack>
</div>

@code {
    private bool _open;
}
