@namespace Lumeo
@using System.ComponentModel
@using System.Globalization
@using Microsoft.AspNetCore.Components.Rendering
@inject Lumeo.Services.Localization.ILumeoLocalizer L
@attribute [EditorBrowsable(EditorBrowsableState.Never)]

@* FlowEdgeLayer — one <path> per edge, in flow coordinates, inside FlowCanvas' viewport layer, plus
   a sibling div per labelled edge (no <foreignObject> — a positioned div is simpler and themeable).
   Rendered by FlowCanvas; not meant to be used directly.

   The <svg> is zero-sized with overflow: visible so it never intercepts pointer events or affects
   layout; paths are drawn from FlowGeometry. While a node is dragged the engine rewrites the `d`
   of every connected path (and moves the matching label div) with its JS port of the same math,
   keyed by the data-source/data-target/data-*-handle/data-edge-type attributes below — keep those
   in sync with flow.js. A path's own pointer-events override the layer's "none" so it can be
   clicked/selected without the (invisible, 1x1) layer intercepting the rest of the pane.

   Phase 5 sub-flows: an edge whose deeper end sits inside a group (nesting level N > 0) is drawn in
   an extra, raised <svg data-slot="flow-edges-raised"> with z-index N — above its group (which
   stacks at N - 1) and below the nested nodes (which stack at N and come later in the DOM). Without
   that a group's tinted background would cover the edges between its own children.
   data-sa/data-ta stamp each end's anchor ("x|y|position") so the engine can still redraw an edge
   whose OTHER end is not mounted (virtualization) while its mounted end is dragged.

   LU-02/03: the DEFAULT stroke is a CSS custom property (`--lumeo-flow-edge-stroke`, declared in
   lumeo-flow.css), referenced through `var()` even in the INLINE style below (needed so the very
   first paint, before flow.js injects lumeo-flow.css, already shows the right colour) — a consumer
   can still win over it without `!important` by setting that custom property from an external rule
   (`[data-edge-id="x"] { --lumeo-flow-edge-stroke: ...; }`, or via `edge.Class`), because a `var()`
   reference resolves the custom property from wherever the cascade sets it, inline or not.
   `edge.Style` is appended last so it always wins (the documented one-off escape hatch).
   Two markers: the default one tracks that same custom property (falls back to
   `context-stroke` under `@supports` for Chromium, which then follows the LIVE resolved stroke
   including any consumer override — Firefox/Safari get the correct DEFAULT colour, and the correct
   SELECTED colour from the second, always-primary marker, but not a fully custom per-edge colour,
   since a `<marker>` in `<defs>` is not a DOM descendant of the `<path>` that references it and so
   does not inherit a property scoped to that one path — documented). *@

<svg data-slot="flow-edges"
     aria-hidden="true"
     class="@Cx.Merge("lumeo-flow-edges", Class)"
     style="position:absolute;left:0;top:0;width:1px;height:1px;overflow:visible;pointer-events:none;"
     @attributes="AdditionalAttributes">
    <defs>
        <marker id="@_markerId" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto-start-reverse" markerUnits="userSpaceOnUse">
            <path class="lumeo-flow-marker-path" d="M0,0 L8,4 L0,8 Z" fill="var(--lumeo-flow-edge-stroke, var(--color-muted-foreground))" />
        </marker>
        <marker id="@_selectedMarkerId" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto-start-reverse" markerUnits="userSpaceOnUse">
            <path d="M0,0 L8,4 L0,8 Z" fill="var(--color-primary)" />
        </marker>
    </defs>
    @if (Context is not null)
    {
        RenderEdges(__builder, 0);
    }
</svg>
@if (Context is not null && Context.Canvas.MaxEdgeLevel > 0)
{
    @for (var level = 1; level <= Context.Canvas.MaxEdgeLevel; level++)
    {
        var lvl = level;
        <svg @key="@("raised-" + lvl)"
             data-slot="flow-edges-raised"
             data-level="@lvl.ToString(CultureInfo.InvariantCulture)"
             aria-hidden="true"
             style="@("position:absolute;left:0;top:0;width:1px;height:1px;overflow:visible;pointer-events:none;z-index:" + lvl.ToString(CultureInfo.InvariantCulture) + ";")">
            @{ RenderEdges(__builder, lvl); }
        </svg>
    }
}
@if (Context is not null)
{
    <div data-slot="flow-edge-labels" style="position:absolute;left:0;top:0;">
        @foreach (var (edge, path, _, _) in Edges)
        {
            var editable = Context.Canvas.EdgeLabelEditable;
            var editingThis = editable && _editingEdgeId == edge.Id;
            // Still requires an existing Label/EdgeLabelTemplate (or an edit already in flight) to
            // render at all — EdgeLabelEditable alone must NOT put an always-present, always-hit-
            // testable div at every edge's midpoint: a genuinely empty one there would silently eat
            // the click a bare edge (no label) otherwise needs for on-path selection.
            if (!editingThis && Context.Canvas.EdgeLabelTemplate is null && string.IsNullOrEmpty(edge.Label)) continue;
            <div @key="@("label-" + edge.Id)"
                 data-flow-edge-label
                 data-flow-nodrag
                 data-edge-id="@edge.Id"
                 style="@LabelStyle(path, Context.Canvas.EdgeLevel(edge))"
                 @ondblclick="@(() => BeginEdit(edge))">
                @if (editingThis)
                {
                    <div @onclick:stopPropagation="true" style="min-width:6rem;">
                        <Input @bind-Value="_editText" Size="Lumeo.Size.Sm" AutoFocus="true" aria-label="@L["Flow.EdgeLabelEdit"]"
                               @onkeydown="@(e => HandleEditKeyDownAsync(e, edge))" />
                    </div>
                }
                else if (Context.Canvas.EdgeLabelTemplate is not null)
                {
                    @Context.Canvas.EdgeLabelTemplate(new FlowEdgeContext(edge, Context.Canvas.IsEdgeSelected(edge.Id), path.LabelX, path.LabelY))
                }
                else
                {
                    @* LU-09: nowrap so a short label ("owns · X") never wraps into a two-line pill
                       with background per line; a long label instead truncates with an ellipsis
                       rather than growing the pill unboundedly. *@
                    <span class="max-w-32 overflow-hidden text-ellipsis whitespace-nowrap rounded border border-border bg-card px-1.5 py-0.5 text-[10px] text-card-foreground shadow-sm" title="@edge.Label">@edge.Label</span>
                }
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private FlowCanvas.FlowCanvasContext? Context { get; set; }

    /// <summary>Additional CSS classes merged onto the edge layer's <c>&lt;svg&gt;</c>.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Captures unmatched attributes and applies them to the edge layer's <c>&lt;svg&gt;</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _markerId = "lumeo-flow-arrow-" + Guid.NewGuid().ToString("N")[..10];
    private readonly string _selectedMarkerId = "lumeo-flow-arrow-selected-" + Guid.NewGuid().ToString("N")[..10];

    // Phase 4: inline edge-label editing state. Lives here (not on FlowCanvas) because only this
    // component renders the label — at most one edge editing at a time.
    private string? _editingEdgeId;
    private string _editText = "";

    // One pass over the canvas' edges per render (paths computed once, shared by every layer below).
    private List<(FlowEdge Edge, FlowEdgePath Path, FlowPoint Source, FlowPoint Target)> _edges = new();
    private List<(FlowEdge Edge, FlowEdgePath Path, FlowPoint Source, FlowPoint Target)> Edges => _edges;

    protected override void OnParametersSet()
        => _edges = Context is null ? new() : Context.Canvas.RenderableEdges().ToList();

    private void RenderEdges(RenderTreeBuilder __builder, int level)
    {
        var canvas = Context!.Canvas;
        var selectable = canvas.CanSelectEdges;
        foreach (var (edge, path, sourcePt, targetPt) in _edges)
        {
            if (canvas.EdgeLevel(edge) != level) continue;
            var selected = canvas.IsEdgeSelected(edge.Id);
            var sa = Anchor(sourcePt, canvas.SourcePositionOf(edge));
            var ta = Anchor(targetPt, canvas.TargetPositionOf(edge));
            if (selectable)
            {
                @* A wide, invisible "hit" twin of the visible path below — the 1.5px visible
                   stroke is much too thin a click target on its own (real pointer/touch, and a
                   fractional-pixel Playwright click, routinely miss it). Same d/data-* so
                   flow.js's live redraw during a drag keeps both in lockstep; stroke="transparent"
                   still registers pointer-events:stroke hits (painted-ness, not visible colour,
                   is what the hit test cares about). *@
                <path @key="@("hit-" + edge.Id)"
                      data-flow-edge-hit
                      data-edge-id="@edge.Id"
                      data-source="@edge.Source"
                      data-target="@edge.Target"
                      data-source-handle="@edge.SourceHandle"
                      data-target-handle="@edge.TargetHandle"
                      data-edge-type="@FlowGeometry.FormatEdgeType(edge.Type)"
                      data-sa="@sa"
                      data-ta="@ta"
                      d="@path.D"
                      fill="none"
                      stroke="transparent"
                      stroke-width="14"
                      style="pointer-events:stroke;cursor:pointer;"
                      @onclick="e => canvas.HandleEdgeClickAsync(edge, e.ShiftKey, e.CtrlKey || e.MetaKey)" />
            }
            <path @key="edge.Id"
                  data-flow-edge
                  data-edge-id="@edge.Id"
                  data-source="@edge.Source"
                  data-target="@edge.Target"
                  data-source-handle="@edge.SourceHandle"
                  data-target-handle="@edge.TargetHandle"
                  data-edge-type="@FlowGeometry.FormatEdgeType(edge.Type)"
                  data-sa="@sa"
                  data-ta="@ta"
                  data-selected="@(selected ? "" : null)"
                  data-animated="@(edge.Animated ? "" : null)"
                  d="@path.D"
                  fill="none"
                  class="@Cx.Merge(edge.Class)"
                  stroke-dasharray="@(edge.Dashed ? "5 4" : null)"
                  marker-end="@(string.IsNullOrEmpty(edge.MarkerEnd) ? null : "url(#" + (selected ? _selectedMarkerId : _markerId) + ")")"
                  style="@EdgeStyle(selectable, selected, edge)"
                  @onclick="e => canvas.HandleEdgeClickAsync(edge, e.ShiftKey, e.CtrlKey || e.MetaKey)" />
            @* LU-04: Animated no longer forces a dash on the edge itself — a decorative, aria-hidden
               "flow" overlay (sparse dash + travelling offset) sits on top instead, so a solid
               Animated=true/Dashed=false edge stays visually solid. Only rendered for that
               combination; a Dashed edge's own stroke-dasharray already reads as "in motion" once
               data-animated triggers its dash-offset animation (unchanged phase-2 behaviour).
               Reduced motion turns the animation off in CSS; the overlay itself still draws (a
               static sparse dash), same as a paused film frame rather than disappearing. *@
            @if (edge.Animated && !edge.Dashed)
            {
                <path @key="@("flow-" + edge.Id)"
                      data-flow-edge-flow
                      data-source="@edge.Source"
                      data-target="@edge.Target"
                      data-source-handle="@edge.SourceHandle"
                      data-target-handle="@edge.TargetHandle"
                      data-edge-type="@FlowGeometry.FormatEdgeType(edge.Type)"
                      data-sa="@sa"
                      data-ta="@ta"
                      aria-hidden="true"
                      d="@path.D"
                      fill="none"
                      style="@FlowStyle(selected)" />
            }
        }
    }

    private static string Anchor(FlowPoint p, FlowPosition position)
        => FlowGeometry.Fmt(p.X) + "|" + FlowGeometry.Fmt(p.Y) + "|" + FlowGeometry.FormatPosition(position);

    private void BeginEdit(FlowEdge edge)
    {
        if (Context is null || !Context.Canvas.EdgeLabelEditable || Context.Canvas.Readonly) return;
        _editingEdgeId = edge.Id;
        _editText = edge.Label ?? "";
    }

    private async Task HandleEditKeyDownAsync(KeyboardEventArgs e, FlowEdge edge)
    {
        switch (e.Key)
        {
            case "Enter":
                _editingEdgeId = null;
                await Context!.Canvas.CommitEdgeLabelAsync(edge, _editText);
                return;
            case "Escape":
                _editingEdgeId = null;
                return;
        }
    }

    private static string LabelStyle(FlowEdgePath path, int level)
        => "position:absolute;left:" + FlowGeometry.Fmt(path.LabelX) + "px;top:" + FlowGeometry.Fmt(path.LabelY)
           + "px;transform:translate(-50%,-50%);pointer-events:auto;"
           + (level > 0 ? "z-index:" + level.ToString(CultureInfo.InvariantCulture) + ";" : "");

    // Inline (not just the lumeo-flow.css rule) so an edge is coloured correctly on the very first
    // paint, before flow.js has injected the stylesheet — same reasoning as the pane's own inline
    // layout styles. LU-02: the DEFAULT branch goes through the --lumeo-flow-edge-stroke custom
    // property (var()'s fallback chain, not a literal colour) so a consumer's external rule setting
    // that property still wins despite this being inline (see the component-level comment above the
    // markup); the SELECTED branch stays a literal var(--color-primary) — the selection highlight is
    // deliberately not overridable per edge, it must always read as "selected". edge.Style is
    // appended last so it always wins over both (the documented one-off escape hatch).
    private static string EdgeStyle(bool selectable, bool selected, FlowEdge edge)
        => "stroke:" + (selected ? "var(--color-primary)" : "var(--lumeo-flow-edge-stroke, var(--color-muted-foreground))")
           + ";opacity:" + (selected ? "1" : "0.6")
           + ";stroke-width:1.5;pointer-events:" + (selectable ? "stroke" : "none") + ";"
           + (selectable ? "cursor:pointer;" : "")
           + edge.Style;

    // LU-04: the travelling-dash overlay for a solid Animated edge. Sparse dashes (short mark, long
    // gap) read as "flow" rather than "outline", at the same opacity/colour rule as the base edge
    // (minus pointer handling — aria-hidden, decorative only) so a selected animated edge still
    // shows the primary highlight colour travelling along it.
    private static string FlowStyle(bool selected)
        => "stroke:" + (selected ? "var(--color-primary)" : "var(--lumeo-flow-edge-stroke, var(--color-muted-foreground))")
           + ";opacity:" + (selected ? "1" : "0.6")
           + ";stroke-width:1.5;stroke-dasharray:2 10;pointer-events:none;";
}
