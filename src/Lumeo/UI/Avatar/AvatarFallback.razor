@namespace Lumeo
@implements IDisposable

@* Renders only while the sibling AvatarImage has NOT successfully loaded — the
   Radix image→fallback chain. Used standalone (no Avatar parent) it always
   renders, so existing fallback-only usages are unaffected. *@
@if (ShowFallback)
{
    <div data-slot="avatar-fallback" class="@CssClass" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private Avatar.AvatarImageContext? ImageContext { get; set; }

    /// <summary>The fallback content, typically the person's initials.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Additional CSS classes merged onto the fallback's root element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Unmatched attributes splatted onto the fallback's root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Avatar.AvatarImageContext? _subscribed;

    private bool ShowFallback => ImageContext is null || !ImageContext.ImageLoaded;

    protected override void OnParametersSet()
    {
        // (Re)subscribe to the active context so an image that loads/errors
        // after first paint flips our visibility without the parent forcing it.
        if (!ReferenceEquals(_subscribed, ImageContext))
        {
            if (_subscribed is not null) _subscribed.OnChange -= OnImageStateChanged;
            _subscribed = ImageContext;
            if (_subscribed is not null) _subscribed.OnChange += OnImageStateChanged;
        }
    }

    private void OnImageStateChanged() => InvokeAsync(StateHasChanged);

    // No own border-radius: the fallback fills the avatar's inner wrapper, which
    // already clips to the active shape (Circle/Square/Themed via ShapeClasses +
    // overflow-hidden). A hardcoded full-circle class here painted the bg-muted
    // surface as a circle INSIDE the square/themed clip — since the clip was larger
    // than the circle, Square and Themed avatars with initials rendered as circles
    // anyway (user-reported against Themed; had silently affected Square since day
    // one). Also why the radius-token guard test scans raw file text: keep the class
    // name out of comments here.
    // Inside an Avatar it INHERITS the avatar's font size, which every rung now carries -
    // its own text-sm used to override the small rungs, and at Xxs that put a 20px line box
    // in a 16px box behind overflow-hidden and clipped the initials. Standalone there is
    // nothing to inherit from, so it keeps the 14px it always had rather than picking up
    // whatever ambient typography surrounds it (review of PR #430).
    private string CssClass => Cx.Merge(
        // bg-muted is a page-tone surface, so its text is page-tone too rather than inherited:
        // inside a dark sidebar the inherited sidebar-foreground made the initials white on a
        // light disc.
        "flex h-full w-full items-center justify-center bg-muted text-foreground font-medium leading-none",
        ImageContext is null ? "text-sm" : null,
        Class);

    public void Dispose()
    {
        if (_subscribed is not null) _subscribed.OnChange -= OnImageStateChanged;
    }
}
