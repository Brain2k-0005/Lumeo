@namespace Lumeo.Docs.Shared.Showcases
@* Static exception (see ../README.md): every Scheduler view (month/week/day/agenda/resource)
   needs real height (320px-640px in its own docs demos) to show more than an empty grid —
   there is no meaningfully smaller live state that fits a 16:9 card. This renders the exact
   agenda-row markup SchedulerAgendaView itself produces (color dot, title, time — same
   classes) for a small fixed set of events, without the scrolling list container. *@

<div class="w-full max-w-[22rem] h-36 rounded-md border border-border/60 overflow-hidden flex flex-col">
    <div class="px-3 pt-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Today</div>
    <div class="flex flex-col px-2 pb-2">
        @foreach (var ev in _events)
        {
            <div class="flex items-center gap-2.5 py-1.5 px-1 rounded-md">
                <span class="w-2 h-2 rounded-full flex-none" style="background-color:@ev.Color"></span>
                <span class="flex-1 min-w-0 text-sm font-medium truncate">@ev.Title</span>
                <span class="text-xs text-muted-foreground flex-none">@ev.Time</span>
            </div>
        }
    </div>
</div>

@code {
    private record Event(string Title, string Time, string Color);

    private readonly List<Event> _events = new()
    {
        new("Design sync", "10:00 AM", "var(--color-primary)"),
        new("Release readiness", "3:00 PM", "var(--color-chart-2)"),
        new("Client call", "4:30 PM", "var(--color-chart-4)"),
    };
}
