    private string _account = Accounts[0].Email;
    private string _tab = "all";
    private string? _selected = Mails[0].Id;
    private bool _mute;

    private Mail? Selected => Mails.FirstOrDefault(m => m.Id == _selected);

    private static Badge.BadgeVariant BadgeVariantFor(string label) => label.ToLowerInvariant() switch
    {
        "work" => Badge.BadgeVariant.Default,
        "personal" => Badge.BadgeVariant.Outline,
        _ => Badge.BadgeVariant.Secondary,
    };

    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(chunk => chunk[0]));

    // date-fns formatDistanceToNow(date, { addSuffix: true }), with its thresholds.
    private static string DistanceToNow(DateTime date)
    {
        var diff = DateTime.Now - date;
        var minutes = Math.Round(diff.TotalMinutes);
        var months = Math.Round(diff.TotalDays / 30);
        string text;
        if (minutes < 1) text = "less than a minute";
        else if (minutes < 45) text = minutes == 1 ? "1 minute" : $"{minutes:0} minutes";
        else if (minutes < 90) text = "about 1 hour";
        else if (minutes < 24 * 60) text = $"about {Math.Round(diff.TotalHours):0} hours";
        else if (minutes < 42 * 60) text = "1 day";
        else if (minutes < 30 * 24 * 60) text = $"{Math.Round(diff.TotalDays):0} days";
        else if (minutes < 45 * 24 * 60) text = "about 1 month";
        else if (minutes < 60 * 24 * 60) text = "about 2 months";
        else if (months < 12) text = $"{months:0} months";
        else
        {
            var years = Math.Floor(months / 12);
            var rest = months % 12;
            text = rest < 3 ? $"about {years:0} year{(years == 1 ? "" : "s")}"
                 : rest < 9 ? $"over {years:0} year{(years == 1 ? "" : "s")}"
                 : $"almost {years + 1:0} years";
        }
        return text + " ago";
    }

    // date-fns format(date, "E, h:m b")
    private static string Snooze(DateTime d) => $"{d.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture)}, {(d.Hour % 12 == 0 ? 12 : d.Hour % 12)}:{d.Minute} {(d.Hour < 12 ? "am" : "pm")}";

    private static DateTime NextSaturday(DateTime d)
    {
        var days = ((int)DayOfWeek.Saturday - (int)d.DayOfWeek + 7) % 7;
        return d.AddDays(days == 0 ? 7 : days);
    }
}
