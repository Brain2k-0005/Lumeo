        <span class="rounded bg-secondary px-1.5 py-0.5 text-[10px] font-mono text-secondary-foreground">JSON</span>
    </div>
    <div class="flex gap-3 bg-background px-3 py-2.5 font-mono text-xs leading-relaxed">
        <div class="select-none text-muted-foreground/50">
            <div>1</div>
            <div>2</div>
            <div>3</div>
            <div>4</div>
        </div>
        <div class="text-foreground">
            <div>{</div>
            <div class="ps-3"><span class="text-primary">"theme"</span>: <span class="text-muted-foreground">"dark"</span>,</div>
            <div class="ps-3"><span class="text-primary">"strict"</span>: <span class="text-foreground">true</span></div>
