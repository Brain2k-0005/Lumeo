@namespace Lumeo.Docs.Shared.Showcases

<div id="@_containerId" class="relative flex w-full max-w-[22rem] items-center justify-center gap-20 rounded-lg border border-border/40 bg-muted/20 p-8">
    <div id="@_fromId" class="z-10 flex h-10 w-10 items-center justify-center rounded-full bg-primary text-primary-foreground shadow">
        <SvgGlyph Svg="@(Lucide.Cpu)" class="h-5 w-5 text-primary-foreground" />
    </div>
    <AnimatedBeam ContainerId="@_containerId" FromId="@_fromId" ToId="@_toId" DurationMs="3500" />
    <div id="@_toId" class="z-10 flex h-10 w-10 items-center justify-center rounded-full bg-primary text-primary-foreground shadow">
        <SvgGlyph Svg="@(Lucide.Cloud)" class="h-5 w-5 text-primary-foreground" />
    </div>
</div>

@code {
    private readonly string _containerId = $"beam-showcase-{Guid.NewGuid():N}";
    private readonly string _fromId = $"beam-showcase-from-{Guid.NewGuid():N}";
    private readonly string _toId = $"beam-showcase-to-{Guid.NewGuid():N}";
}
