@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Segmented @bind-Value="_value" Options="_options" />
</div>

@code {
    private string _value = "weekly";

    private readonly List<Segmented.SegmentedOption> _options = new()
    {
        new() { Label = "Daily", Value = "daily" },
        new() { Label = "Weekly", Value = "weekly" },
        new() { Label = "Monthly", Value = "monthly" },
    };
}
