                                                draggable=""true"" @ondragstart=""@(() => _dragId = row.Id)"" @ondragover:preventDefault @ondrop=""@(() => DropOn(row.Id))""
                                                class=""@($""border-b border-border/40 transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted {(_dragId == row.Id ? ""relative z-10 opacity-80"" : ""relative z-0"")}"")"">
                                                <TableCell Class=""w-8"">
                                                    <Button Variant=""Button.ButtonVariant.Ghost"" Size=""Button.ButtonSize.Icon"" Class=""size-7 cursor-grab text-muted-foreground hover:bg-transparent"">
                                                        <SvgGlyph Svg=""@(Lucide.GripVertical)"" class=""size-3 text-muted-foreground"" />
                                                        <span class=""sr-only"">Drag to reorder</span>
                                                    </Button>
                                                </TableCell>
                                                <TableCell>
                                                    <div class=""flex items-center justify-center"">
                                                        <Checkbox Checked=""@_selected.Contains(row.Id)"" CheckedChanged=""@(on => ToggleRow(row.Id, on))"" AriaLabel=""Select row"" />
                                                    </div>
                                                </TableCell>
                                                <TableCell>
                                                    <Button Variant=""Button.ButtonVariant.Link"" Class=""w-fit px-0 text-left text-foreground"" OnClick=""@(() => OpenDrawer(row))"">@row.Header</Button>
                                                </TableCell>
                                                @if (!_hidden.Contains(""type""))
                                                {
                                                    <TableCell><div class=""w-32""><Badge Variant=""Badge.BadgeVariant.Outline"" Class=""px-1.5 text-muted-foreground"">@row.Type</Badge></div></TableCell>
                                                }
                                                @if (!_hidden.Contains(""status""))
                                                {
                                                    <TableCell>
                                                        <Badge Variant=""Badge.BadgeVariant.Outline"" Class=""px-1.5 text-muted-foreground"">
                                                            @if (row.Status == ""Done"")
                                                            {
                                                                <SvgGlyph Svg=""@(Lucide.CircleCheck)"" class=""fill-green-500 text-background dark:fill-green-400"" />
                                                            }
                                                            else
                                                            {
                                                                <SvgGlyph Svg=""@(Lucide.Loader)"" />
                                                            }
                                                            @row.Status
                                                        </Badge>
                                                    </TableCell>
                                                }
                                                @if (!_hidden.Contains(""target""))
                                                {
                                                    <TableCell>
                                                        <Label For=""@($""dash-{row.Id}-target"")"" Class=""sr-only"">Target</Label>
                                                        <Input id=""@($""dash-{row.Id}-target"")"" Value=""@row.Target"" Class=""h-8 w-16 border-transparent bg-transparent text-right shadow-none hover:bg-input/30 focus-visible:border focus-visible:bg-background dark:bg-transparent dark:hover:bg-input/30"" />
                                                    </TableCell>
                                                }
                                                @if (!_hidden.Contains(""limit""))
                                                {
                                                    <TableCell>
                                                        <Label For=""@($""dash-{row.Id}-limit"")"" Class=""sr-only"">Limit</Label>
                                                        <Input id=""@($""dash-{row.Id}-limit"")"" Value=""@row.Limit"" Class=""h-8 w-16 border-transparent bg-transparent text-right shadow-none hover:bg-input/30 focus-visible:border focus-visible:bg-background dark:bg-transparent dark:hover:bg-input/30"" />
                                                    </TableCell>
                                                }
                                                @if (!_hidden.Contains(""reviewer""))
                                                {
                                                    <TableCell>
                                                        @if (row.Reviewer != ""Assign reviewer"")
                                                        {
                                                            @row.Reviewer
                                                        }
                                                        else
                                                        {
                                                            <Select>
                                                                <SelectTrigger Class=""w-38"" Placeholder=""Assign reviewer"" />
                                                                <SelectContent>
                                                                    <SelectItem Value=""Eddie Lake"">Eddie Lake</SelectItem>
                                                                    <SelectItem Value=""Jamik Tashpulatov"">Jamik Tashpulatov</SelectItem>
                                                                </SelectContent>
                                                            </Select>
                                                        }
                                                    </TableCell>
                                                }
                                                <TableCell>
                                                    <DropdownMenu>
                                                        <DropdownMenuTrigger AsChild>
                                                            <ChildContentSlot Context=""slot"">
                                                                <Button Variant=""Button.ButtonVariant.Ghost"" Size=""Button.ButtonSize.Icon"" Class=""flex size-8 text-muted-foreground data-[state=open]:bg-muted"" id=""@slot.Id"" @attributes=""slot.Attributes"" OnClick=""slot.OnClick"">
                                                                    <SvgGlyph Svg=""@(Lucide.EllipsisVertical)"" />
                                                                    <span class=""sr-only"">Open menu</span>
                                                                </Button>
                                                            </ChildContentSlot>
                                                        </DropdownMenuTrigger>
                                                        <DropdownMenuContent Align=""Lumeo.Align.End"" Class=""w-32"">
                                                            <DropdownMenuItem>Edit</DropdownMenuItem>
                                                            <DropdownMenuItem>Make a copy</DropdownMenuItem>
                                                            <DropdownMenuItem>Favorite</DropdownMenuItem>
                                                            <DropdownMenuSeparator />
                                                            <DropdownMenuItem Variant=""MenuItemVariant.Destructive"">Delete</DropdownMenuItem>
                                                        </DropdownMenuContent>
                                                    </DropdownMenu>
                                                </TableCell>
                                            </tr>
                                        }
                                    </TableBody>
                                </Table>
                            </div>
                            <div class=""flex items-center justify-between px-4"">
                                <div class=""hidden flex-1 text-sm text-muted-foreground lg:flex"">@_selected.Count of @_rows.Count row(s) selected.</div>
                                <div class=""flex w-full items-center gap-8 lg:w-fit"">
                                    <div class=""hidden items-center gap-2 lg:flex"">
                                        <Label For=""dash-rows-per-page"" Class=""text-sm font-medium"">Rows per page</Label>
                                        <Select Value=""@_pageSize.ToString()"" ValueChanged=""@(v => SetPageSize(v))"">
                                            <SelectTrigger id=""dash-rows-per-page"" Class=""w-20"">@_pageSize</SelectTrigger>
                                            <SelectContent>
                                                @foreach (var size in new[] { 10, 20, 30, 40, 50 })
                                                {
                                                    <SelectItem Value=""@size.ToString()"">@size</SelectItem>
                                                }
                                            </SelectContent>
                                        </Select>
                                    </div>
                                    <div class=""flex w-fit items-center justify-center text-sm font-medium"">Page @(_page + 1) of @PageCount</div>
                                    <div class=""ml-auto flex items-center gap-2 lg:ml-0"">
                                        <Button Variant=""Button.ButtonVariant.Outline"" Class=""hidden h-8 w-8 p-0 lg:flex"" OnClick=""@(() => _page = 0)"" Disabled=""@(_page == 0)""><span class=""sr-only"">Go to first page</span><SvgGlyph Svg=""@(Lucide.ChevronsLeft)"" /></Button>
                                        <Button Variant=""Button.ButtonVariant.Outline"" Size=""Button.ButtonSize.Icon"" Class=""size-8"" OnClick=""@(() => _page--)"" Disabled=""@(_page == 0)""><span class=""sr-only"">Go to previous page</span><SvgGlyph Svg=""@(Lucide.ChevronLeft)"" /></Button>
                                        <Button Variant=""Button.ButtonVariant.Outline"" Size=""Button.ButtonSize.Icon"" Class=""size-8"" OnClick=""@(() => _page++)"" Disabled=""@(_page >= PageCount - 1)""><span class=""sr-only"">Go to next page</span><SvgGlyph Svg=""@(Lucide.ChevronRight)"" /></Button>
                                        <Button Variant=""Button.ButtonVariant.Outline"" Size=""Button.ButtonSize.Icon"" Class=""hidden size-8 lg:flex"" OnClick=""@(() => _page = PageCount - 1)"" Disabled=""@(_page >= PageCount - 1)""><span class=""sr-only"">Go to last page</span><SvgGlyph Svg=""@(Lucide.ChevronsRight)"" /></Button>
                                    </div>
                                </div>
                            </div>
                        </TabsContent>
                        <TabsContent Value=""past-performance"" Class=""flex flex-col px-4 lg:px-6"">
                            <div class=""aspect-video w-full flex-1 rounded-lg border border-dashed""></div>
                        </TabsContent>
                        <TabsContent Value=""key-personnel"" Class=""flex flex-col px-4 lg:px-6"">
                            <div class=""aspect-video w-full flex-1 rounded-lg border border-dashed""></div>
                        </TabsContent>
                        <TabsContent Value=""focus-documents"" Class=""flex flex-col px-4 lg:px-6"">
                            <div class=""aspect-video w-full flex-1 rounded-lg border border-dashed""></div>
                        </TabsContent>
                    </Tabs>
                </div>
            </div>
        </div>
    </SidebarInset>
</SidebarProvider>
<Drawer Open=""@_drawerOpen"" OpenChanged=""@(v => _drawerOpen = v)"">
    <DrawerContent Side=""Lumeo.Side.Right"">
        <DrawerHeader Class=""gap-1"">
            <DrawerTitle>@(_drawerItem?.Header)</DrawerTitle>
            <DrawerDescription>Showing total visitors for the last 6 months</DrawerDescription>
        </DrawerHeader>
        <div class=""flex flex-col gap-4 overflow-y-auto px-4 text-sm"">
            <AreaChart Categories=""@DrawerCategories"" Series=""@DrawerSeries"" Height=""200px"" Stacked=""true"" Smooth=""true"" Gradient=""true"" ShowDots=""false"" ShowLegend=""false"" LabelStrategy=""ChartLabelStrategy.Auto"" LabelRotate=""0"" />
            <Separator />
            <div class=""grid gap-2"">
                <div class=""flex gap-2 leading-none font-medium"">Trending up by 5.2% this month <SvgGlyph Svg=""@(Lucide.TrendingUp)"" class=""size-4"" /></div>
                <div class=""text-muted-foreground"">Showing total visitors for the last 6 months. This is just some random text to test the layout. It spans multiple lines and should wrap around.</div>
            </div>
            <Separator />
            <form class=""flex flex-col gap-4"" @onsubmit:preventDefault>
                <div class=""flex flex-col gap-3"">
                    <Label For=""dash-drawer-header"">Header</Label>
                    <Input id=""dash-drawer-header"" Value=""@(_drawerItem?.Header)"" />
                </div>
                <div class=""grid grid-cols-2 gap-4"">
                    <div class=""flex flex-col gap-3"">
                        <Label For=""dash-drawer-type"">Type</Label>
                        <Select Value=""@(_drawerItem?.Type)"">
                            <SelectTrigger id=""dash-drawer-type"" Class=""w-full"">@(_drawerItem?.Type)</SelectTrigger>
                            <SelectContent>
                                <SelectItem Value=""Table of Contents"">Table of Contents</SelectItem>
                                <SelectItem Value=""Executive Summary"">Executive Summary</SelectItem>
                                <SelectItem Value=""Technical Approach"">Technical Approach</SelectItem>
                                <SelectItem Value=""Design"">Design</SelectItem>
                                <SelectItem Value=""Capabilities"">Capabilities</SelectItem>
                                <SelectItem Value=""Focus Documents"">Focus Documents</SelectItem>
                                <SelectItem Value=""Narrative"">Narrative</SelectItem>
                                <SelectItem Value=""Cover Page"">Cover Page</SelectItem>
                            </SelectContent>
                        </Select>
                    </div>
                    <div class=""flex flex-col gap-3"">
                        <Label For=""dash-drawer-status"">Status</Label>
                        <Select Value=""@(_drawerItem?.Status)"">
                            <SelectTrigger id=""dash-drawer-status"" Class=""w-full"">@(_drawerItem?.Status)</SelectTrigger>
                            <SelectContent>
                                <SelectItem Value=""Done"">Done</SelectItem>
                                <SelectItem Value=""In Progress"">In Progress</SelectItem>
                                <SelectItem Value=""Not Started"">Not Started</SelectItem>
                            </SelectContent>
                        </Select>
                    </div>
                </div>
                <div class=""grid grid-cols-2 gap-4"">
                    <div class=""flex flex-col gap-3"">
                        <Label For=""dash-drawer-target"">Target</Label>
                        <Input id=""dash-drawer-target"" Value=""@(_drawerItem?.Target)"" />
                    </div>
                    <div class=""flex flex-col gap-3"">
                        <Label For=""dash-drawer-limit"">Limit</Label>
                        <Input id=""dash-drawer-limit"" Value=""@(_drawerItem?.Limit)"" />
                    </div>
                </div>
                <div class=""flex flex-col gap-3"">
                    <Label For=""dash-drawer-reviewer"">Reviewer</Label>
                    <Select Value=""@(_drawerItem?.Reviewer)"">
                        <SelectTrigger id=""dash-drawer-reviewer"" Class=""w-full"">@(_drawerItem?.Reviewer)</SelectTrigger>
                        <SelectContent>
                            <SelectItem Value=""Eddie Lake"">Eddie Lake</SelectItem>
                            <SelectItem Value=""Jamik Tashpulatov"">Jamik Tashpulatov</SelectItem>
                            <SelectItem Value=""Emily Whalen"">Emily Whalen</SelectItem>
                        </SelectContent>
                    </Select>
                </div>
            </form>
        </div>
        <DrawerFooter>
            <Button OnClick=""@(() => _drawerOpen = false)"">Submit</Button>
            <Button Variant=""Button.ButtonVariant.Outline"" OnClick=""@(() => _drawerOpen = false)"">Done</Button>
        </DrawerFooter>
    </DrawerContent>
</Drawer>";

