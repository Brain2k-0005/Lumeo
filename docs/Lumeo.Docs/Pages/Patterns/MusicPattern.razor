                                                    </div>
                                                </div>
                                                <DialogFooter>
                                                    <Button>Import Podcast</Button>
                                                </DialogFooter>
                                            </DialogContent>
                                        </Dialog>
                                    </div>
                                </div>
                            </TabsContent>
                        </Tabs>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>";

