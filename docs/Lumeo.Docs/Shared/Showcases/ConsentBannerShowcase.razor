@namespace Lumeo.Docs.Shared.Showcases

@* The real ConsentBanner only mounts once per browser (Consent.HasDecided gates it) and
   is position:fixed to the viewport bottom — neither works miniaturized inside a catalog
   card, and wiring it to the live ConsentService would pop the real site-wide banner.
   This is a faithful static rendition of its own card content, laid out in normal flow. *@
<div class="w-full max-w-[22rem]">
    <div class="rounded-lg border border-border/60 bg-popover text-popover-foreground shadow-sm p-4">
        <Flex Align="center" Gap="2" Class="mb-1">
            <SvgGlyph Svg="@(Lucide.Cookie)" class="h-4 w-4 text-primary" />
            <Lumeo.Text As="span" Size="sm" Weight="semibold" Color="foreground">Cookies &amp; consent</Lumeo.Text>
        </Flex>
        <Lumeo.Text Size="xs" Color="muted" Class="mb-3">We use a minimal set of cookies to run the site.</Lumeo.Text>
        <Flex Align="center" Gap="2">
            <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Sm">Customize</Button>
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm">Reject</Button>
            <Button Variant="Button.ButtonVariant.Default" Size="Button.ButtonSize.Sm">Accept</Button>
        </Flex>
    </div>
</div>
