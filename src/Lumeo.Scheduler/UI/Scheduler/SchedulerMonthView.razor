@namespace Lumeo
@using System.Globalization
@using Lumeo.SchedulerKernel
@using Lumeo.Services.Localization
@implements IAsyncDisposable
@inject Lumeo.Services.IComponentInteropService Interop
@inject Lumeo.Services.Localization.ILumeoLocalizer L

@* First-party month-grid view (spec §1.1/§1.2/§1.4/§5). Consumes SchedulerDateMath.BuildMonthGrid
   for the always-42-cell grid, SchedulerRecurrenceExpander for occurrence expansion, and
   SchedulerMonthLayout for continuous multi-day lane assignment. Internal building block —
   Scheduler.razor (the only component with public parameters, spec §1.2) is the eventual host;
   this component is usable and independently testable on its own in the meantime. *@
<div class="@($"flex flex-col w-full rounded-md border border-border/60 overflow-hidden {Class}".Trim())" @attributes="AdditionalAttributes">
    @* Live region for pointer-gesture outcomes (ReUI parity). Rendered
       unconditionally and EMPTY at mount: assistive tech must be observing the
       node before the text lands, so a region created at announce time is
       frequently missed. Same sr-only/polite/atomic shape Carousel.razor
       already uses. *@
    <span class="sr-only" aria-live="polite" aria-atomic="true"
          data-testid="scheduler-live-region" data-announce-epoch="@_announcementEpoch">@AnnouncementText</span>
    <div class="@GridColsClass border-b border-border/60 bg-card">
        @if (ShowWeekNumbers)
        {
            @* Corner cell above the week-number column. aria-hidden + presentation:
               it labels nothing, and letting it into the header row would make
               screen readers announce an empty column header for every row. *@
            <span class="px-1 py-1.5 text-center text-[11px] font-medium text-muted-foreground">@L["Scheduler.WeekNumberAbbrev"]</span>
        }
        @for (var i = 0; i < _weekdayHeaders.Length; i++)
        {
            var dow = (DayOfWeek)(((int)FirstDayOfWeek + i) % 7);
            if (HideWeekends && dow is DayOfWeek.Saturday or DayOfWeek.Sunday) { continue; }
            <span class="px-2 py-1.5 text-right text-[11px] font-medium text-muted-foreground">@_weekdayHeaders[i]</span>
        }
    </div>
    <div class="@GridColsClass" role="grid" aria-label="@L["Scheduler.Month"]" @ref="_hostRef">
        @for (var row = 0; row < 6; row++)
        {
            <div role="row" class="contents">
                @if (ShowWeekNumbers)
                {
                    @* role="rowheader" (not gridcell): it labels the row rather
                       than holding a focusable day, so keyboard grid navigation
                       — which walks _cellRefs by index — is untouched. *@
                    @* aria-label, not a bare number (Codex review of this PR, P2):
                       the "Wk"/"KW" column header lives in the header strip
                       ABOVE the grid, so it is not a columnheader of this grid
                       and carries no ARIA relationship to these cells. A screen
                       reader walking the grid would otherwise read an
                       unexplained "35". Labelling each row header makes it
                       self-describing regardless of what the header strip does. *@
                    <div role="rowheader"
                         class="flex items-start justify-center border-b border-e border-border/60 bg-muted/30 px-1 py-1 text-[11px] tabular-nums text-muted-foreground"
                         aria-label="@L["Scheduler.WeekNumberLabel", WeekNumberForRow(row)]"
                         data-week-number="@WeekNumberForRow(row)">@WeekNumberForRow(row)</div>
                }
                @for (var col = 0; col < 7; col++)
                {
                    var cellIndex = row * 7 + col;
                    var cell = _cellModels[cellIndex];
                    if (IsHiddenColumn(cell.Date)) { continue; }
                    var isFocused = cellIndex == _focusedIndex;
                    <div role="gridcell"
                         @ref="_cellRefs[cellIndex]"
                         tabindex="@(isFocused ? "0" : "-1")"
                         data-cell-date="@cell.Date.ToString("yyyy-MM-dd")"
                         data-cell-index="@cellIndex"
                         data-off="@(cell.IsOffDay ? "true" : null)"
                         aria-label="@CellAriaLabel(cell)"
                         aria-selected="@(SelectedDate.HasValue && SelectedDate.Value.Date == cell.Date ? "true" : "false")"
                         class="@CellClasses(cell)"
                         @onclick="() => OnCellClickAsync(cellIndex)"
                         @ondblclick="() => OnCellDoubleClickAsync(cell.Date)"
                         @onkeydown="e => OnGridKeyDownAsync(e, cellIndex)">
                        <span class="@DayNumberClasses(cell)">@cell.Date.Day</span>
                        @foreach (var slot in cell.Lanes)
                        {
                            if (slot is null)
                            {
                                <div class="h-[19px]" aria-hidden="true"></div>
                            }
                            else
                            {
                                var key = InstanceKey(slot.Instance);
                                <Tooltip ShowDelay="400" Class="w-full">
                                    <TooltipTrigger AsChild="true">
                                        <ChildContentSlot Context="pillSlot">
                                            <button type="button"
                                                    @ref="_pillRefs[key]"
                                                    class="@PillClasses(slot)"
                                                    data-event-instance="@key"
                                                    data-event-id="@slot.Instance.EventId"
                                                    style="@PillStyle(slot)"
                                                    tabindex="-1"
                                                    aria-label="@PillAriaLabel(slot)"
                                                    @attributes="pillSlot.Attributes"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OnEventClickAsync(slot.Source)"
                                                    @onkeydown="e => OnPillKeyDownAsync(e, slot.Source, cellIndex)">
                                                @if (slot.ShowTitle)
                                                {
                                                    @slot.Source.Title
                                                }
                                                else
                                                {
                                                    <span aria-hidden="true">&nbsp;</span>
                                                }
                                            </button>
                                        </ChildContentSlot>
                                    </TooltipTrigger>
                                    <TooltipContent>@TooltipLabel(slot.Source, slot.Instance)</TooltipContent>
                                </Tooltip>
                            }
                        }
                        @if (cell.HiddenCount > 0)
                        {
                            @* Self-contained popover (not the Popover/PopoverTrigger primitives — both the
                               AsChild and non-AsChild compositions were found, via this task's own Playwright
                               run (not just bUnit, which doesn't exercise real DOM event dispatch), to not
                               reliably open when nested this deep inside a 42-times-repeated grid structure;
                               PopoverTrigger AsChild in particular is exercised nowhere else in this codebase.
                               Mirrors DataGridColumnVisibility.razor's own proven manual click-outside popover
                               pattern — same RegisterClickOutside/UnregisterClickOutside lifecycle, just scoped
                               to this cell instead of a column id.) *@
                            <div class="relative">
                                <button type="button"
                                        class="px-0.5 text-left text-[11px] text-muted-foreground hover:text-foreground hover:underline cursor-pointer"
                                        data-testid="month-more-events"
                                        @onclick="() => ToggleMorePopoverAsync(cellIndex)"
                                        @onclick:stopPropagation="true">
                                    @L[LumeoPlurals.PluralKey(cell.HiddenCount, "Scheduler.MoreEvents", CultureInfo.CurrentUICulture), cell.HiddenCount]
                                </button>
                                @if (_openMoreCellIndex == cellIndex)
                                {
                                    <div id="@MorePopoverId(cellIndex)"
                                         role="dialog"
                                         aria-label="@L[LumeoPlurals.PluralKey(cell.HiddenCount, "Scheduler.MoreEvents", CultureInfo.CurrentUICulture), cell.HiddenCount]"
                                         class="absolute left-0 top-full mt-1 z-50 w-56 rounded-md border border-border/60 bg-popover text-popover-foreground shadow-lg p-2"
                                         data-testid="month-more-popover"
                                         @onclick:stopPropagation="true"
                                         @onkeydown="e => OnMorePopoverKeyDown(e, cellIndex)">
                                        <div class="flex flex-col gap-0.5">
                                            @foreach (var hidden in cell.HiddenInstances)
                                            {
                                                <button type="button"
                                                        class="flex items-center gap-1.5 w-full text-left text-xs px-1.5 py-1 rounded hover:bg-accent/60"
                                                        data-event-id="@hidden.Instance.EventId"
                                                        @onclick="() => OnMoreEventClickAsync(hidden.Source)">
                                                    <span class="w-1.5 h-1.5 rounded-[calc(var(--radius)*2)] flex-none" style="background-color: @(ResolveEventColor?.Invoke(hidden.Source) ?? hidden.Source.Color ?? "var(--color-primary)")" aria-hidden="true"></span>
                                                    <span class="flex-1 min-w-0 truncate">@hidden.Source.Title</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>The calendar's events (expanded per occurrence internally via <c>SchedulerRecurrenceExpander</c>).</summary>
    [Parameter] public IEnumerable<SchedulerEvent>? Events { get; set; }

    /// <summary>The month this grid renders. Only Year/Month are read.</summary>
    [Parameter] public DateTime AnchorDate { get; set; } = DateTime.Today;

    /// <summary>First day of the week for grid layout. Default Monday.</summary>
    [Parameter] public DayOfWeek FirstDayOfWeek { get; set; } = DayOfWeek.Monday;

    /// <summary>
    /// Renders an extra leading column with each row's ISO-8601 week number
    /// (ReUI parity — its event calendar exposes a "week numbers" display
    /// toggle). Default <c>false</c>: when off, the grid keeps its exact
    /// previous 7-column markup, so this cannot shift any existing layout.
    /// <para>
    /// The number is always the ISO-8601 week (<see cref="System.Globalization.ISOWeek"/>),
    /// computed from each row's own THURSDAY. Thursday is ISO's defining day —
    /// the week a Thursday falls in IS its ISO week — and every 7-day row
    /// contains exactly one Thursday no matter which
    /// <see cref="FirstDayOfWeek"/> the grid starts on. That makes the label
    /// independent of the grid's start day, which a naive "first cell of the
    /// row" reading is not: in a Sunday-start grid the leading Sunday belongs
    /// to the PREVIOUS ISO week, so reading the row's first cell would label
    /// most rows one week too low.
    /// </para>
    /// </summary>
    [Parameter] public bool ShowWeekNumbers { get; set; }

    /// <summary>
    /// Hides the Saturday and Sunday columns (ReUI parity — its event calendar
    /// exposes a weekend-hiding toggle). Default <c>false</c>: with it off the
    /// grid renders its exact previous seven-column markup.
    /// <para>
    /// The 42-cell model is untouched; only rendering and keyboard navigation
    /// skip the hidden columns. That matters because arrow navigation moves by
    /// raw cell index (+/-1, +/-7) — walking that index across a hidden column
    /// would put focus on a cell that is not in the DOM, so navigation runs over
    /// the VISIBLE cells instead (see <c>VisibleCellIndices</c>).
    /// </para>
    /// </summary>
    [Parameter] public bool HideWeekends { get; set; }

    /// <summary>Max visible pill lanes per day before "+N more". Default <see cref="SchedulerMonthLayout.DefaultMaxVisibleLanes"/>.</summary>
    [Parameter] public int MaxVisibleLanes { get; set; } = SchedulerMonthLayout.DefaultMaxVisibleLanes;

    /// <summary>The currently selected date (keyboard focus anchor / agenda-strip driver). Controlled via <see cref="SelectedDateChanged"/>.</summary>
    [Parameter] public DateTime? SelectedDate { get; set; }
    [Parameter] public EventCallback<DateTime> SelectedDateChanged { get; set; }

    /// <summary>Raised when an event chip is clicked or activated (Enter/Space).</summary>
    [Parameter] public EventCallback<SchedulerEvent> OnEventClick { get; set; }

    /// <summary>Raised when the user selects a date (double-click, or Enter/Space on an empty cell).</summary>
    [Parameter] public EventCallback<SchedulerDateRange> OnDateSelect { get; set; }

    /// <summary>Bubbles a PageUp (previous month) keyboard request up to the toolbar's own Prev.</summary>
    [Parameter] public EventCallback OnRequestPrev { get; set; }

    /// <summary>Bubbles a PageDown (next month) keyboard request up to the toolbar's own Next.</summary>
    [Parameter] public EventCallback OnRequestNext { get; set; }

    /// <summary>Resolves the effective CSS color for an event chip. Falls back to <c>var(--color-primary)</c>.</summary>
    [Parameter] public Func<SchedulerEvent, string?>? ResolveEventColor { get; set; }

    /// <summary>Resolves extra CSS class names appended to an event chip.</summary>
    [Parameter] public Func<SchedulerEvent, string?>? ResolveEventClassNames { get; set; }

    /// <summary>Allows events to be dragged to another day. Month has no edge-resize (spec §3.4). Default true.</summary>
    [Parameter] public bool Editable { get; set; } = true;

    /// <summary>
    /// Fail-closed validation predicate for a day-move drop (spec §3.2), widened to a three-way
    /// reject/accept/accept-with-adjustment contract (mirrors ReUI's <c>onEventUpdate</c>) — see
    /// <see cref="SchedulerDropResult"/>. <c>null</c> (default) means no consumer opted in — JS
    /// is told via <c>hasCanDrop: false</c> so zero <see cref="ValidateDrop"/> interop calls
    /// happen per drag.
    /// </summary>
    [Parameter] public Func<SchedulerEvent, SchedulerScheduleDropContext, SchedulerDropResult>? CanDrop { get; set; }

    /// <summary>Allows drag-across-cells date-range selection on empty grid background (spec §3.4's Month row — previously entirely absent). Default true.</summary>
    [Parameter] public bool Selectable { get; set; } = true;

    /// <summary>
    /// Shades non-business days (spec's business-hours regression fix — the first-party views
    /// previously had no equivalent at all, unlike the time-grid views' <c>BusinessHours</c>
    /// toggle). Month has no hour axis, so this shades whole day cells outside
    /// <see cref="BusinessDays"/>. Default false (opt-in, matches the wrapper's own default).
    /// </summary>
    [Parameter] public bool BusinessHours { get; set; }

    /// <summary>Which days of the week count as business days when <see cref="BusinessHours"/> is true. Default Mon–Fri, matching FullCalendar's own hardcoded default.</summary>
    [Parameter] public IReadOnlyList<DayOfWeek>? BusinessDays { get; set; }

    /// <summary>Raised after a day-move drag commits (post-<see cref="CanDrop"/> validation, ghost already removed).</summary>
    [Parameter] public EventCallback<SchedulerEvent> OnEventChange { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private DateTime[] _cells = Array.Empty<DateTime>();
    private MonthCellModel[] _cellModels = new MonthCellModel[42];
    private readonly ElementReference[] _cellRefs = new ElementReference[42];
    private readonly Dictionary<string, ElementReference> _pillRefs = new(StringComparer.Ordinal);
    private int _focusedIndex;
    private string[] _weekdayHeaders = Array.Empty<string>();

    // Written as literal class strings, never interpolated: the Tailwind v4
    // build only emits utilities it can SEE in source, so a computed
    // $"grid-cols-{n}" would produce a class with no rule behind it — the
    // "class in the DOM without a rule" trap this repo has hit before.
    /// <summary>Whether <paramref name="date"/>'s column is hidden by <see cref="HideWeekends"/>.</summary>
    private bool IsHiddenColumn(DateTime date) =>
        HideWeekends && date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    /// <summary>
    /// The 0-41 indices actually rendered, in reading order. Arrow navigation
    /// walks POSITIONS in this list rather than raw indices, so a hidden column
    /// is stepped over instead of focused.
    /// </summary>
    private List<int> VisibleCellIndices
    {
        get
        {
            var list = new List<int>(42);
            for (var i = 0; i < 42; i++)
                if (!IsHiddenColumn(_cells[i].Date)) list.Add(i);
            return list;
        }
    }

    /// <summary>Rendered day columns per row — 5 when weekends are hidden.</summary>
    private int VisibleColumns => HideWeekends ? 5 : 7;

    // Every combination written out literally: Tailwind v4 only emits utilities
    // it can see in source, so an interpolated class would land in the DOM with
    // no rule behind it — a trap this repo has already been bitten by.
    private string GridColsClass => (ShowWeekNumbers, HideWeekends) switch
    {
        (true, true) => "grid grid-cols-[2.5rem_repeat(5,minmax(0,1fr))]",
        (true, false) => "grid grid-cols-[2.5rem_repeat(7,minmax(0,1fr))]",
        (false, true) => "grid grid-cols-5",
        (false, false) => "grid grid-cols-7",
    };

    /// <summary>
    /// The ISO-8601 week number for display row <paramref name="row"/>, read off
    /// that row's own Thursday — see <see cref="ShowWeekNumbers"/> for why
    /// Thursday rather than the row's first cell.
    /// </summary>
    private int WeekNumberForRow(int row)
    {
        for (var col = 0; col < 7; col++)
        {
            var date = _cells[row * 7 + col].Date;
            if (date.DayOfWeek == DayOfWeek.Thursday) return ISOWeek.GetWeekOfYear(date);
        }
        // Unreachable for a 7-day row, but a silent 0 would be a worse failure
        // than falling back to the row's first date.
        return ISOWeek.GetWeekOfYear(_cells[row * 7].Date);
    }
    private ElementReference _hostRef;
    private DotNetObjectReference<SchedulerMonthView>? _selfRef;
    private bool _dragRegistered;
    private int _lastDragOptionsHash;
    private int? _openMoreCellIndex;
    private bool _moreClickOutsideRegistered;

    protected override void OnParametersSet()
    {
        _cells = SchedulerDateMath.BuildMonthGrid(AnchorDate, FirstDayOfWeek).ToArray();
        BuildWeekdayHeaders();
        BuildCellModels();

        // Keep the roving-tabindex anchor in bounds when the grid changes from under it.
        if (_focusedIndex < 0 || _focusedIndex >= 42)
            _focusedIndex = 0;

        if (IsHiddenColumn(_cells[_focusedIndex].Date))
        {
            var firstVisible = VisibleCellIndices;
            _focusedIndex = firstVisible.Count > 0 ? firstVisible[0] : 0;
        }

        // ...and on a cell that is actually RENDERED (Codex review of this PR,
        // P1). A bounds check alone is not enough once HideWeekends exists: a
        // Sunday-first grid anchors at index 0, which is hidden, and toggling
        // the option on while a weekend cell holds focus strands it the same
        // way. Either case leaves every cell at tabindex="-1", so the grid
        // drops out of the tab order entirely and arrow keys do nothing.

    }

    private void BuildWeekdayHeaders()
    {
        var culture = CultureInfo.CurrentUICulture;
        var headers = new string[7];
        for (var i = 0; i < 7; i++)
        {
            var dow = (DayOfWeek)(((int)FirstDayOfWeek + i) % 7);
            headers[i] = culture.DateTimeFormat.AbbreviatedDayNames[(int)dow];
        }
        _weekdayHeaders = headers;
    }

    private void BuildCellModels()
    {
        _pillRefs.Clear();
        if (_cells.Length == 0) { _cellModels = new MonthCellModel[42]; return; }

        var events = (Events ?? Enumerable.Empty<SchedulerEvent>()).ToList();
        var byId = new Dictionary<string, SchedulerEvent>(StringComparer.Ordinal);
        foreach (var ev in events)
            if (!string.IsNullOrEmpty(ev.Id)) byId[ev.Id] = ev;

        var rangeStart = _cells[0];
        var rangeEnd = _cells[^1].AddDays(1);
        var allInstances = SchedulerRecurrenceExpander.ExpandAll(events, rangeStart, rangeEnd);

        var models = new MonthCellModel[42];
        for (var row = 0; row < 6; row++)
        {
            var weekStart = _cells[row * 7];
            var weekEnd = weekStart.AddDays(7);

            var rowInstances = allInstances
                .Where(i => i.Start < weekEnd && i.End > weekStart && byId.ContainsKey(i.EventId))
                .ToList();

            var packInput = rowInstances
                .Select(i => (Id: InstanceKey(i), StartDate: i.Start, EndDate: i.End, AllDay: byId[i.EventId].AllDay))
                .ToList();

            var lanes = SchedulerMonthLayout.PackRow(weekStart, packInput);
            var hidden = SchedulerMonthLayout.HiddenCounts(weekStart, lanes, packInput, MaxVisibleLanes);

            var maxLane = lanes.Count == 0 ? -1 : lanes.Values.Max();
            var visibleLaneCount = Math.Max(0, Math.Min(MaxVisibleLanes, maxLane + 1));

            for (var col = 0; col < 7; col++)
            {
                var date = weekStart.AddDays(col);
                var touching = rowInstances.Where(i => TouchesDay(i.Start, i.End, byId[i.EventId].AllDay, date)).ToList();

                var slots = new PillSlot?[visibleLaneCount];
                for (var lane = 0; lane < visibleLaneCount; lane++)
                {
                    var found = touching.FirstOrDefault(i => lanes.TryGetValue(InstanceKey(i), out var l) && l == lane);
                    if (found.EventId is null) { slots[lane] = null; continue; }

                    var src = byId[found.EventId];
                    var contL = date.Date > found.Start.Date;
                    var contR = date.Date < LastTouchedDate(found.End, src.AllDay, found.Start);
                    slots[lane] = new PillSlot(found, src, contL, contR, !contL);
                }

                // The events beyond the visible-lane budget — what the "+N more" popover
                // lists (spec §1's "the data is there; the affordance is not" finding: the
                // kernel's HiddenCounts already computed the COUNT, but nothing surfaced
                // WHICH instances were hidden until now).
                var hiddenInstances = touching
                    .Where(i => lanes.TryGetValue(InstanceKey(i), out var l) && l >= visibleLaneCount)
                    .OrderBy(i => byId[i.EventId].AllDay ? TimeSpan.MinValue : i.Start.TimeOfDay)
                    .Select(i => new PillSlot(i, byId[i.EventId], false, false, true))
                    .ToList();

                models[row * 7 + col] = new MonthCellModel(
                    date,
                    date.Month == AnchorDate.Month && date.Year == AnchorDate.Year,
                    date.Date == DateTime.Today,
                    slots,
                    hidden.TryGetValue(date, out var h) ? h : 0,
                    touching.Count,
                    hiddenInstances,
                    IsOffDay(date));
            }
        }

        _cellModels = models;
        PromoteTitlesOntoVisibleCells();
    }

    /// <summary>
    /// Moves a run's title onto its first RENDERED segment when
    /// <see cref="HideWeekends"/> hides the segment that would normally carry it
    /// (Codex review of this PR, P2).
    /// <para>
    /// <c>ShowTitle</c> is set to <c>!contL</c>, i.e. only the run's first day
    /// shows the name. For an event starting on a Saturday and continuing into
    /// the working week, hiding that Saturday removes the ONLY titled segment,
    /// so every weekday chip renders a non-breaking space and the event appears
    /// as an unlabelled bar. No-op when weekends are shown.
    /// </para>
    /// </summary>
    private void PromoteTitlesOntoVisibleCells()
    {
        if (!HideWeekends) return;

        // One pass in reading order; the first visible segment of each instance
        // wins, so a run that begins on a visible day is left untouched.
        var titled = new HashSet<string>(StringComparer.Ordinal);
        foreach (var cell in _cellModels)
        {
            if (cell is null || IsHiddenColumn(cell.Date)) continue;
            for (var lane = 0; lane < cell.Lanes.Count; lane++)
            {
                if (cell.Lanes[lane] is not { } slot) continue;
                var key = InstanceKey(slot.Instance);
                if (!titled.Add(key)) continue;
                if (!slot.ShowTitle) ((IList<PillSlot?>)cell.Lanes)[lane] = slot with { ShowTitle = true };
            }
        }
    }

    /// <summary>Whether <paramref name="date"/> is a non-business day per <see cref="BusinessDays"/> (default Mon–Fri) when <see cref="BusinessHours"/> is enabled.</summary>
    private bool IsOffDay(DateTime date)
    {
        if (!BusinessHours) return false;
        var businessDays = BusinessDays ?? DefaultBusinessDays;
        return !businessDays.Contains(date.DayOfWeek);
    }

    private static readonly DayOfWeek[] DefaultBusinessDays =
        { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };

    private static DateTime LastTouchedDate(DateTime end, bool allDay, DateTime start)
    {
        if (!allDay && end.Date == start.Date) return start.Date;
        var last = end.TimeOfDay == TimeSpan.Zero ? end.Date.AddDays(-1) : end.Date;
        return last < start.Date ? start.Date : last;
    }

    private static bool TouchesDay(DateTime start, DateTime end, bool allDay, DateTime day)
    {
        if (!allDay && end.Date == start.Date) return day.Date == start.Date;
        var last = LastTouchedDate(end, allDay, start);
        return day.Date >= start.Date && day.Date <= last;
    }

    private static string InstanceKey(SchedulerEventInstance i) => $"{i.EventId}|{i.Start:O}";

    private string CellClasses(MonthCellModel cell)
    {
        var classes = "relative flex flex-col gap-0.5 min-h-[92px] p-1 border-b border-r border-border/60 cursor-pointer transition-colors hover:bg-accent/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring focus-visible:-outline-offset-2";
        if (!cell.InCurrentMonth) classes += " bg-muted/30 text-muted-foreground";
        if (SelectedDate.HasValue && SelectedDate.Value.Date == cell.Date) classes += " outline outline-2 outline-ring -outline-offset-2";
        return classes;
    }

    /// <summary>Hover-tooltip label for an event chip: title + time range (spec §3.4's promised "title, time range, resource" — resource omitted here since neither view resolves a resource DISPLAY NAME, only the raw <see cref="SchedulerEvent.ResourceId"/>; falls back to that id, labelled, when present).</summary>
    private static string TooltipLabel(SchedulerEvent ev, SchedulerEventInstance inst)
    {
        var time = ev.AllDay ? null : $"{inst.Start:t}–{inst.End:t}";
        var parts = new List<string> { ev.Title };
        if (time is not null) parts.Add(time);
        if (!string.IsNullOrEmpty(ev.ResourceId)) parts.Add(ev.ResourceId);
        return string.Join(" · ", parts);
    }

    private static string DayNumberClasses(MonthCellModel cell)
    {
        var classes = "self-end w-6 h-6 rounded-[calc(var(--radius)*4)] flex items-center justify-center text-xs font-medium";
        if (cell.IsToday) classes += " bg-primary text-primary-foreground font-semibold";
        return classes;
    }

    private string PillClasses(PillSlot slot)
    {
        var classes = "block w-full text-left text-[11px] leading-tight font-medium px-1.5 py-0.5 rounded truncate cursor-pointer select-none border-0";
        if (slot.ContL) classes += " rounded-l-none";
        if (slot.ContR) classes += " rounded-r-none";
        var extra = ResolveEventClassNames?.Invoke(slot.Source);
        if (!string.IsNullOrEmpty(extra)) classes += " " + extra;
        return classes;
    }

    /// <summary>
    /// A day cell pads its content by <c>p-1</c> (4px) and carries a 1px right border, so two
    /// segments of the SAME run sat 9px apart and a multi-day event read as a row of separate
    /// bars — the continuation days looking like empty stubs, since only the first segment
    /// carries the title. A continued segment therefore bleeds out to the cell's border box on
    /// the side it continues, which closes the gap exactly and makes the run render as one
    /// bar. The rounded corners were already dropped on those sides for this reason; only the
    /// spacing was missing.
    /// </summary>
    private const double CellPadPx = 4;
    private const double CellBorderPx = 1;

    private string PillStyle(PillSlot slot)
    {
        var color = ResolveEventColor?.Invoke(slot.Source) ?? slot.Source.Color ?? "var(--color-primary)";
        var style = $"background-color: color-mix(in oklab, {color} 18%, transparent); color: color-mix(in oklab, {color} 38%, var(--lumeo-event-fg-anchor));";

        // Left bleed is only the padding — the border belongs to the PREVIOUS cell and is
        // already covered by that cell's own segment bleeding right.
        var left = slot.ContL ? CellPadPx : 0;
        var right = slot.ContR ? CellPadPx + CellBorderPx : 0;
        if (left == 0 && right == 0) return style;

        // The pill is w-full, i.e. width:100%. A negative margin alone only SHIFTS that box,
        // it does not widen it, so the first attempt closed 4px of the 9px gap and left a
        // visible seam. The width has to grow by the same amount it bleeds.
        var inv = CultureInfo.InvariantCulture;
        if (left > 0) style += $" margin-left: -{left.ToString(inv)}px;";
        if (right > 0) style += $" margin-right: -{right.ToString(inv)}px;";
        style += $" width: calc(100% + {(left + right).ToString(inv)}px);";
        return style;
    }

    private string CellAriaLabel(MonthCellModel cell)
    {
        var dateLabel = cell.Date.ToString("D", CultureInfo.CurrentUICulture);
        var countLabel = L[LumeoPlurals.PluralKey(cell.TotalCount, "Scheduler.EventCount", CultureInfo.CurrentUICulture), cell.TotalCount];
        return $"{dateLabel}, {countLabel}";
    }

    private static string PillAriaLabel(PillSlot slot) => slot.Source.AllDay
        ? slot.Source.Title
        : $"{slot.Source.Title}, {slot.Instance.Start:t}";

    // ── Interaction ──────────────────────────────────────────────────────

    private async Task OnCellClickAsync(int index)
    {
        _focusedIndex = index;
        var date = _cellModels[index].Date;
        if (SelectedDateChanged.HasDelegate) await SelectedDateChanged.InvokeAsync(date);
    }

    private async Task OnCellDoubleClickAsync(DateTime date)
    {
        if (OnDateSelect.HasDelegate)
            await OnDateSelect.InvokeAsync(new SchedulerDateRange(date, date.AddDays(1), true));
    }

    private async Task OnEventClickAsync(SchedulerEvent ev)
    {
        if (OnEventClick.HasDelegate) await OnEventClick.InvokeAsync(ev);
    }

    private async Task OnPillKeyDownAsync(KeyboardEventArgs e, SchedulerEvent ev, int cellIndex)
    {
        if (e.Key is "Enter" or " ")
        {
            await OnEventClickAsync(ev);
        }
        else if (e.Key == "Escape")
        {
            _focusedIndex = cellIndex;
            await FocusCellAsync(cellIndex);
        }
    }

    /// <summary>
    /// Roving-tabindex 2-D grid navigation (spec §5.2's Month column). Arrow keys move one
    /// day/week; Home/End snap to the row's first/last day; PageUp/PageDown bubble up as a
    /// month-navigation request (same effect as the toolbar's own Prev/Next); Enter/Space
    /// opens <see cref="OnDateSelect"/> for an empty cell, or moves focus to the cell's first
    /// event chip when one exists (mirrors a native listbox's "hand off focus to content").
    /// </summary>
    private async Task OnGridKeyDownAsync(KeyboardEventArgs e, int cellIndex)
    {
        _focusedIndex = cellIndex;

        // Navigation walks POSITIONS in the visible list, not raw 0-41 indices
        // (HideWeekends): stepping the raw index would move focus onto a cell
        // that is not rendered. With weekends shown the visible list is the
        // identity 0..41 and the arithmetic below is exactly what it was —
        // +/-1 for a day, +/-VisibleColumns for a week, and Home/End snapping to
        // the row's own first/last VISIBLE column.
        var visible = VisibleCellIndices;
        var pos = visible.IndexOf(cellIndex);
        if (pos < 0) return; // focused cell is hidden — nothing to move from

        var cols = VisibleColumns;
        var rowStart = pos - (pos % cols);
        int nextPos;
        switch (e.Key)
        {
            case "ArrowRight": nextPos = Math.Min(visible.Count - 1, pos + 1); break;
            case "ArrowLeft": nextPos = Math.Max(0, pos - 1); break;
            // Clamped by STAYING PUT, not by pinning to the first/last position
            // (Codex review of this PR, P2): clamping a flattened position
            // changes its column, so ArrowUp in the top row used to slide from
            // Friday to Monday instead of doing nothing.
            case "ArrowDown": nextPos = pos + cols < visible.Count ? pos + cols : pos; break;
            case "ArrowUp": nextPos = pos - cols >= 0 ? pos - cols : pos; break;
            case "Home": nextPos = rowStart; break;
            case "End": nextPos = Math.Min(visible.Count - 1, rowStart + cols - 1); break;
            case "PageUp":
                if (OnRequestPrev.HasDelegate) await OnRequestPrev.InvokeAsync();
                return;
            case "PageDown":
                if (OnRequestNext.HasDelegate) await OnRequestNext.InvokeAsync();
                return;
            case "Enter":
            case " ":
                await ActivateFocusedCellAsync(cellIndex);
                return;
            default:
                return;
        }

        var next = visible[nextPos];
        if (next != cellIndex)
        {
            _focusedIndex = next;
            await FocusCellAsync(next);
        }
    }

    private async Task ActivateFocusedCellAsync(int cellIndex)
    {
        var cell = _cellModels[cellIndex];
        var first = cell.Lanes.FirstOrDefault(s => s is not null);
        if (first is not null)
        {
            var key = InstanceKey(first.Instance);
            if (_pillRefs.TryGetValue(key, out var pillRef))
            {
                try { await pillRef.FocusAsync(); }
                catch (Microsoft.JSInterop.JSDisconnectedException) { }
            }
        }
        else if (OnDateSelect.HasDelegate)
        {
            await OnDateSelect.InvokeAsync(new SchedulerDateRange(cell.Date, cell.Date.AddDays(1), true));
        }
    }

    private async Task FocusCellAsync(int index)
    {
        try { await _cellRefs[index].FocusAsync(); }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    // ── Drag (whole-day move only — month has no edge-resize, spec §3.4) ──────
    // Ghost-only + fail-closed: see SchedulerTimeGridView's identical remarks and
    // scheduler-views.js's own header comment — the same two invariants apply here.

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncMorePopoverClickOutsideAsync();

        var hash = HashCode.Combine(Editable, CanDrop is not null, Selectable);
        if (_dragRegistered && hash == _lastDragOptionsHash) return;
        _lastDragOptionsHash = hash;
        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            var options = new Dictionary<string, object?> { ["editable"] = Editable, ["hasCanDrop"] = CanDrop is not null, ["selectable"] = Selectable && OnDateSelect.HasDelegate };
            await Interop.SchedulerViewsRegisterMonthDragAsync(_hostRef, _selfRef, options);
            _dragRegistered = true;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    // ── "+N more" self-contained popover (spec's dead-text regression fix, §1) ─────
    // Not the Popover/PopoverTrigger primitives — see the markup's own remarks
    // for why. (Written without angle brackets on purpose: the registry generator
    // scans this file for component tags, and a tag named in a line comment reads
    // as a real dependency.) Mirrors
    // DataGridColumnVisibility.razor's proven manual click-outside popover lifecycle.

    private async Task ToggleMorePopoverAsync(int cellIndex)
    {
        if (_openMoreCellIndex == cellIndex)
        {
            await CloseMorePopoverAsync();
        }
        else
        {
            if (_openMoreCellIndex is not null) await CloseMorePopoverAsync();
            _openMoreCellIndex = cellIndex;
        }
    }

    private async Task CloseMorePopoverAsync()
    {
        var wasOpen = _openMoreCellIndex;
        _openMoreCellIndex = null;
        if (_moreClickOutsideRegistered && wasOpen is { } idx)
        {
            _moreClickOutsideRegistered = false;
            try { await Interop.UnregisterClickOutside(MorePopoverId(idx)); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
    }

    private async Task SyncMorePopoverClickOutsideAsync()
    {
        if (_openMoreCellIndex is { } idx && !_moreClickOutsideRegistered)
        {
            try
            {
                await Interop.RegisterClickOutside(MorePopoverId(idx), null, async () =>
                {
                    _moreClickOutsideRegistered = false;
                    _openMoreCellIndex = null;
                    await InvokeAsync(StateHasChanged);
                });
                _moreClickOutsideRegistered = true;
            }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
    }

    private async Task OnMoreEventClickAsync(SchedulerEvent ev)
    {
        await CloseMorePopoverAsync();
        await OnEventClickAsync(ev);
    }

    private void OnMorePopoverKeyDown(KeyboardEventArgs e, int cellIndex)
    {
        if (e.Key == "Escape" && _openMoreCellIndex == cellIndex)
            _ = CloseMorePopoverAsync();
    }

    private static string MorePopoverId(int cellIndex) => $"scheduler-month-more-{cellIndex}";

    /// <summary>
    /// [JSInvokable] fail-closed CanDrop check for a candidate day-move. Returns
    /// <c>false</c> for any input JS shouldn't have been able to produce (unknown
    /// event id, unparsable date) rather than treating an unrecognized shape as
    /// permission. Only the <see cref="SchedulerDropResult.Accepted"/> half of the
    /// three-way verdict crosses the JS boundary here — the visual ghost only needs
    /// accept/reject; <see cref="SchedulerDropResult.Adjustment"/> is applied once,
    /// authoritatively, in <see cref="CommitDrag"/>.
    /// </summary>
    [JSInvokable]
    public bool ValidateDrop(string eventId, string dateIso)
    {
        if (CanDrop is null) return true;
        var ev = FindEvent(eventId);
        if (ev is null) return false;
        if (!DateTime.TryParse(dateIso, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)) return false;
        var newStart = date.Date + ev.Start.TimeOfDay;
        var newEnd = newStart + (ev.End - ev.Start);
        return CanDrop(ev, new SchedulerScheduleDropContext(newStart, newEnd, SchedulerEventUpdateSource.Move)).Accepted;
    }

    [JSInvokable]
    public async Task CommitDrag(string eventId, string dateIso)
    {
        var ev = FindEvent(eventId);
        if (ev is null) return;
        if (!DateTime.TryParse(dateIso, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)) return;
        var newStart = date.Date + ev.Start.TimeOfDay;
        if (newStart == ev.Start) return;
        var newEnd = newStart + (ev.End - ev.Start);
        var newAllDay = ev.AllDay;

        // Re-validate at commit time (not just trust the JS-side ValidateDrop that gated
        // getting here) — this is the ONLY place a SchedulerDropResult.Adjustment can be
        // applied, since ValidateDrop only surfaces the Accepted half over the JS boundary.
        // Also closes a staleness gap: a CanDrop that changes between the last ValidateDrop
        // poll and the actual drop no longer has to be trusted from a cached JS-side verdict.
        if (CanDrop is not null)
        {
            var ctx = new SchedulerScheduleDropContext(newStart, newEnd, SchedulerEventUpdateSource.Move);
            var result = CanDrop(ev, ctx);
            // The ORDINARY rejection never reaches this method — the JS awaits
            // ValidateDrop and returns before calling CommitDrag (see
            // NotifyDropRejected). What DOES reach it is the staleness case this
            // second check exists for: CanDrop said yes during the drag and says
            // no now. JS has already passed its own rejection branch, so this is
            // the only place that outcome can be announced (Codex review of this
            // PR, P2) — without it the drop silently does nothing.
            if (!result.Accepted)
            {
                Announce(L["Scheduler.Announce.MoveRejected", ev.Title]);
                return;
            }
            if (result.Adjustment is { } adjustment)
            {
                newStart = adjustment.Start ?? newStart;
                newEnd = adjustment.End ?? newEnd;
                newAllDay = adjustment.AllDay ?? newAllDay;
            }
        }

        var updated = ev with { Start = newStart, End = newEnd, AllDay = newAllDay };
        // Announced from the COMMITTED values, after any CanDrop adjustment has
        // been applied — an adjusted drop lands somewhere other than where the
        // pointer was released, so announcing the proposed date would tell the
        // user something that did not happen.
        //
        // Gated on OnEventChange (Codex review of this PR, P2): with no handler
        // the drag is ghost-only — the real chip snaps back and Events is
        // untouched — so announcing a move would describe something the user
        // can neither see nor keep.
        // A CanDrop adjustment can snap the event back to exactly where it
        // started; the earlier no-op check ran against the PROPOSED values,
        // not these (Codex review of this PR, P2). Announcing a move for an
        // unchanged event states something that did not happen.
        if (updated.Start == ev.Start && updated.End == ev.End && updated.AllDay == ev.AllDay) return;
        if (!OnEventChange.HasDelegate) return;
        // Announced AFTER the handler completes (Codex review of this PR,
        // P2): an async OnEventChange that faults — persistence refusing
        // the update, say — leaves the JS caller catching a failed
        // CommitDrag while the user has already been told it moved.
        await OnEventChange.InvokeAsync(updated);
        Announce(L["Scheduler.Announce.EventMoved", ev.Title, FormatAnnounceDate(updated.Start)]);
    }

    // ── Live-region announcements (ReUI parity) ──────────────────────────────
    // reui.io's event calendar lists "live-region announcements for gestures";
    // these views had no aria-live region at all, so a pointer drag produced no
    // screen-reader signal whatsoever. Mirrors Carousel.razor's existing house
    // pattern (sr-only span, polite, atomic) rather than inventing a second one.

    /// <summary>
    /// [JSInvokable] the drag engine calls when it refuses to commit a drop
    /// (Codex review of this PR, P1). The ordinary rejection path lives entirely
    /// in JS — it awaits <see cref="ValidateDrop"/> and returns without ever
    /// calling <see cref="CommitDrag"/> — so this is the ONLY seam where a
    /// refused drag can be announced.
    /// </summary>
    [JSInvokable]
    public void NotifyDropRejected(string eventId)
    {
        var ev = FindEvent(eventId);
        Announce(L["Scheduler.Announce.MoveRejected", ev?.Title ?? string.Empty]);
    }

    private string? _announcement;
    private int _announcementEpoch;

    /// <summary>
    /// The live region's rendered text. A zero-width space is appended on every
    /// other announcement so that repeating an identical message still changes
    /// the text node.
    /// <para>
    /// Two earlier attempts at this were both wrong, and the second was worse
    /// than the first. Clearing and re-setting inside one method does nothing —
    /// Blazor coalesces the two renders. Keying the element on an epoch does
    /// mutate the DOM, but by REMOVING the observed region and inserting a new,
    /// already-populated one; screen readers that only announce changes inside
    /// an already-observed live region can then miss every announcement (Codex
    /// review of this PR, P2). The node must stay mounted, so only its text
    /// changes — and U+200B is inaudible.
    /// </para>
    /// </summary>
    private string? AnnouncementText =>
        _announcement is null ? null : _announcementEpoch % 2 == 0 ? _announcement : _announcement + ZeroWidthSpace;

    /// <summary>
    /// U+200B. Named rather than written literally: an invisible character in
    /// source is unreadable and easy to delete by accident.
    /// </summary>
    private const string ZeroWidthSpace = "​";

    private void Announce(string message)
    {
        _announcementEpoch++;
        _announcement = message;
        StateHasChanged();
    }

    /// <summary>
    /// Long-date format for announcements — deliberately NOT the terse cell
    /// label: read aloud out of context, "14" says nothing, "14 March 2026" does.
    /// </summary>
    private static string FormatAnnounceDate(DateTime value) =>
        value.ToString("D", CultureInfo.CurrentUICulture);

    /// <summary>
    /// [JSInvokable] commits a drag-across-cells date-range selection (spec §3.4's Month row —
    /// previously entirely absent, only <see cref="OnCellDoubleClickAsync"/>'s single-day
    /// no-drag selection existed). Not CanDrop-gated: this creates a brand-new selection, there
    /// is no existing <see cref="SchedulerEvent"/> for a drop predicate to validate against
    /// (mirrors <see cref="SchedulerTimeGridView.CommitCreate"/>'s identical reasoning).
    /// </summary>
    [JSInvokable]
    public async Task CommitDateRangeSelect(string startDateIso, string endDateIso)
    {
        if (!DateTime.TryParse(startDateIso, CultureInfo.InvariantCulture, DateTimeStyles.None, out var start)) return;
        if (!DateTime.TryParse(endDateIso, CultureInfo.InvariantCulture, DateTimeStyles.None, out var end)) return;
        if (start > end) (start, end) = (end, start);
        if (OnDateSelect.HasDelegate) await OnDateSelect.InvokeAsync(new SchedulerDateRange(start.Date, end.Date.AddDays(1), true));
    }

    private SchedulerEvent? FindEvent(string id) =>
        (Events ?? Enumerable.Empty<SchedulerEvent>()).FirstOrDefault(e => e.Id == id);

    public async ValueTask DisposeAsync()
    {
        if (_dragRegistered)
        {
            try { await Interop.SchedulerViewsUnregisterMonthDragAsync(_hostRef); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        if (_moreClickOutsideRegistered && _openMoreCellIndex is { } idx)
        {
            try { await Interop.UnregisterClickOutside(MorePopoverId(idx)); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }

    private sealed record MonthCellModel(DateTime Date, bool InCurrentMonth, bool IsToday, IReadOnlyList<PillSlot?> Lanes, int HiddenCount, int TotalCount, IReadOnlyList<PillSlot> HiddenInstances, bool IsOffDay);

    private sealed record PillSlot(SchedulerEventInstance Instance, SchedulerEvent Source, bool ContL, bool ContR, bool ShowTitle);
}
