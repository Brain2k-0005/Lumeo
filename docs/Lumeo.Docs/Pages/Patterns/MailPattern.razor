@page "/blocks/mail"
@namespace Lumeo.Docs.Pages.Patterns

<PageTitle>Mail — Lumeo Blocks</PageTitle>

<PageHeader Title="Mail"
            Description="shadcn's Mail example, ported one to one: three resizable panes with an account switcher and a folder nav that collapses into an icon rail with tooltips, an inbox list with All and Unread tabs and a search field, and a reading pane with archive, junk, trash, snooze (with a calendar), reply and forward actions and a reply composer. shadcn's 17 sample mails." />

<Stack Gap="10" Class="mt-8">
    <ComponentDemo Id="mail" Title="Mail" Description="A three-pane mail client built with Resizable, Tabs, ScrollArea and Tooltip." Code="@_code">
        <div class="w-full overflow-hidden rounded-[var(--radius-lg)] border border-border/40 bg-background">
            <ResizablePanelGroup Direction="Lumeo.Orientation.Horizontal" DefaultSizes="@(new double[] { 20, 32, 48 })" Class="h-full max-h-[800px] items-stretch">
                <ResizablePanel Order="0" MinSize="15" MaxSize="20" Collapsible="true" CollapsedSize="4" Class="group/nav data-[collapsed=true]:min-w-[50px] data-[collapsed=true]:transition-all data-[collapsed=true]:duration-300 data-[collapsed=true]:ease-in-out">
                    <div class="flex h-[52px] items-center justify-center px-2 group-data-[collapsed=true]/nav:px-0">
                        <Select Value="@_account" ValueChanged="@(v => _account = v ?? _account)">
                            <SelectTrigger aria-label="Select account" Class="flex items-center gap-2 [&>span]:line-clamp-1 [&>span]:flex [&>span]:w-full [&>span]:items-center [&>span]:gap-1 [&>span]:truncate [&_svg]:h-4 [&_svg]:w-4 [&_svg]:shrink-0 group-data-[collapsed=true]/nav:h-9 group-data-[collapsed=true]/nav:w-9 group-data-[collapsed=true]/nav:shrink-0 group-data-[collapsed=true]/nav:justify-center group-data-[collapsed=true]/nav:p-0 group-data-[collapsed=true]/nav:[&>span]:w-auto group-data-[collapsed=true]/nav:[&>svg]:hidden">
                                <span>
                                    @((MarkupString)Accounts.First(a => a.Email == _account).Icon)
                                    <span class="ml-2 group-data-[collapsed=true]/nav:hidden">@Accounts.First(a => a.Email == _account).Label</span>
                                </span>
                            </SelectTrigger>
                            <SelectContent>
                                @foreach (var account in Accounts)
                                {
                                    <SelectItem Value="@account.Email">
                                        <div class="flex items-center gap-3 [&_svg]:h-4 [&_svg]:w-4 [&_svg]:shrink-0 [&_svg]:text-foreground">
                                            @((MarkupString)account.Icon)
                                            @account.Email
                                        </div>
                                    </SelectItem>
                                }
                            </SelectContent>
                        </Select>
                    </div>
                    <Separator />
                    <div class="group flex flex-col gap-4 py-2 group-data-[collapsed=true]/nav:py-2">
                        <nav class="grid gap-1 px-2 group-data-[collapsed=true]/nav:justify-center group-data-[collapsed=true]/nav:px-2">
                            @foreach (var link in PrimaryLinks)
                            {
                                <Button Variant="@link.Variant" Size="Button.ButtonSize.Sm" Href="#" Class="@("justify-start " + Cx.When(link.Variant == Button.ButtonVariant.Default, "dark:bg-muted dark:text-white dark:hover:bg-muted dark:hover:text-white") + " group-data-[collapsed=true]/nav:hidden")">
                                    <SvgGlyph Svg="@(link.Icon)" class="mr-2 h-4 w-4" />
                                    @link.Title
                                    @if (link.Label.Length > 0)
                                    {
                                        <span class="@("ml-auto " + Cx.When(link.Variant == Button.ButtonVariant.Default, "text-background dark:text-white"))">@link.Label</span>
                                    }
                                </Button>
                                <Tooltip ShowDelay="0">
                                    <TooltipTrigger Class="hidden group-data-[collapsed=true]/nav:inline-flex">
                                        <Button Variant="@link.Variant" Size="Button.ButtonSize.Icon" Href="#" Class="@("h-9 w-9 " + Cx.When(link.Variant == Button.ButtonVariant.Default, "dark:bg-muted dark:text-muted-foreground dark:hover:bg-muted dark:hover:text-white"))">
                                            <SvgGlyph Svg="@(link.Icon)" class="h-4 w-4" />
                                            <span class="sr-only">@link.Title</span>
                                        </Button>
                                    </TooltipTrigger>
                                    <TooltipContent Side="Lumeo.Side.Right" Class="flex items-center gap-4">
                                        @link.Title
                                        @if (link.Label.Length > 0)
                                        {
                                            <span class="ml-auto text-muted-foreground">@link.Label</span>
                                        }
                                    </TooltipContent>
                                </Tooltip>
                            }
                        </nav>
                    </div>
                    <Separator />
                    <div class="group flex flex-col gap-4 py-2 group-data-[collapsed=true]/nav:py-2">
                        <nav class="grid gap-1 px-2 group-data-[collapsed=true]/nav:justify-center group-data-[collapsed=true]/nav:px-2">
                            @foreach (var link in SecondaryLinks)
                            {
                                <Button Variant="@link.Variant" Size="Button.ButtonSize.Sm" Href="#" Class="@("justify-start " + Cx.When(link.Variant == Button.ButtonVariant.Default, "dark:bg-muted dark:text-white dark:hover:bg-muted dark:hover:text-white") + " group-data-[collapsed=true]/nav:hidden")">
                                    <SvgGlyph Svg="@(link.Icon)" class="mr-2 h-4 w-4" />
                                    @link.Title
                                    @if (link.Label.Length > 0)
                                    {
                                        <span class="@("ml-auto " + Cx.When(link.Variant == Button.ButtonVariant.Default, "text-background dark:text-white"))">@link.Label</span>
                                    }
                                </Button>
                                <Tooltip ShowDelay="0">
                                    <TooltipTrigger Class="hidden group-data-[collapsed=true]/nav:inline-flex">
                                        <Button Variant="@link.Variant" Size="Button.ButtonSize.Icon" Href="#" Class="@("h-9 w-9 " + Cx.When(link.Variant == Button.ButtonVariant.Default, "dark:bg-muted dark:text-muted-foreground dark:hover:bg-muted dark:hover:text-white"))">
                                            <SvgGlyph Svg="@(link.Icon)" class="h-4 w-4" />
                                            <span class="sr-only">@link.Title</span>
                                        </Button>
                                    </TooltipTrigger>
                                    <TooltipContent Side="Lumeo.Side.Right" Class="flex items-center gap-4">
                                        @link.Title
                                        @if (link.Label.Length > 0)
                                        {
                                            <span class="ml-auto text-muted-foreground">@link.Label</span>
                                        }
                                    </TooltipContent>
                                </Tooltip>
                            }
                        </nav>
                    </div>
                </ResizablePanel>
                <ResizableHandle PanelIndex="0" WithHandle="true" />
                <ResizablePanel Order="1" MinSize="30">
                    <Tabs ActiveValue="@_tab" ActiveValueChanged="@(v => _tab = v)" Class="flex h-full flex-col">
                        <div class="flex items-center px-4 py-2">
                            <h1 class="text-xl font-bold">Inbox</h1>
                            <TabsList Class="ml-auto">
                                <TabsTrigger Value="all" Class="text-zinc-600 dark:text-zinc-200">All mail</TabsTrigger>
                                <TabsTrigger Value="unread" Class="text-zinc-600 dark:text-zinc-200">Unread</TabsTrigger>
                            </TabsList>
                        </div>
                        <Separator />
                        <div class="bg-background/95 p-4 backdrop-blur supports-[backdrop-filter]:bg-background/60">
                            <form @onsubmit:preventDefault>
                                <div class="relative">
                                    <SvgGlyph Svg="@(Lucide.Search)" class="absolute left-2 top-2.5 h-4 w-4 text-muted-foreground" />
                                    <Input Placeholder="Search" Class="pl-8" />
                                </div>
                            </form>
                        </div>
                        <TabsContent Value="all" Class="m-0 min-h-0 flex-1">
                            <ScrollArea Class="h-full">
                                <div class="flex flex-col gap-2 p-4 pt-0">
                                    @foreach (var item in Mails)
                                    {
                                        <button type="button" class="@("flex flex-col items-start gap-2 rounded-lg border p-3 text-left text-sm transition-all hover:bg-accent " + Cx.When(_selected == item.Id, "bg-muted"))" @onclick="@(() => _selected = item.Id)">
                                            <div class="flex w-full flex-col gap-1">
                                                <div class="flex items-center">
                                                    <div class="flex items-center gap-2">
                                                        <div class="font-semibold">@item.Name</div>
                                                        @if (!item.Read)
                                                        {
                                                            <span class="flex h-2 w-2 rounded-full bg-blue-600"></span>
                                                        }
                                                    </div>
                                                    <div class="@("ml-auto text-xs " + (_selected == item.Id ? "text-foreground" : "text-muted-foreground"))">@DistanceToNow(item.Date)</div>
                                                </div>
                                                <div class="text-xs font-medium">@item.Subject</div>
                                            </div>
                                            <div class="line-clamp-2 text-xs text-muted-foreground">@(item.Text.Length > 300 ? item.Text[..300] : item.Text)</div>
                                            @if (item.Labels.Length > 0)
                                            {
                                                <div class="flex items-center gap-2">
                                                    @foreach (var label in item.Labels)
                                                    {
                                                        <Badge Variant="@BadgeVariantFor(label)">@label</Badge>
                                                    }
                                                </div>
                                            }
                                        </button>
                                    }
                                </div>
                            </ScrollArea>
                        </TabsContent>
                        <TabsContent Value="unread" Class="m-0 min-h-0 flex-1">
                            <ScrollArea Class="h-full">
                                <div class="flex flex-col gap-2 p-4 pt-0">
                                    @foreach (var item in Mails.Where(m => !m.Read))
                                    {
                                        <button type="button" class="@("flex flex-col items-start gap-2 rounded-lg border p-3 text-left text-sm transition-all hover:bg-accent " + Cx.When(_selected == item.Id, "bg-muted"))" @onclick="@(() => _selected = item.Id)">
                                            <div class="flex w-full flex-col gap-1">
                                                <div class="flex items-center">
                                                    <div class="flex items-center gap-2">
                                                        <div class="font-semibold">@item.Name</div>
                                                        @if (!item.Read)
                                                        {
                                                            <span class="flex h-2 w-2 rounded-full bg-blue-600"></span>
                                                        }
                                                    </div>
                                                    <div class="@("ml-auto text-xs " + (_selected == item.Id ? "text-foreground" : "text-muted-foreground"))">@DistanceToNow(item.Date)</div>
                                                </div>
                                                <div class="text-xs font-medium">@item.Subject</div>
                                            </div>
                                            <div class="line-clamp-2 text-xs text-muted-foreground">@(item.Text.Length > 300 ? item.Text[..300] : item.Text)</div>
                                            @if (item.Labels.Length > 0)
                                            {
                                                <div class="flex items-center gap-2">
                                                    @foreach (var label in item.Labels)
                                                    {
                                                        <Badge Variant="@BadgeVariantFor(label)">@label</Badge>
                                                    }
                                                </div>
                                            }
                                        </button>
                                    }
                                </div>
                            </ScrollArea>
                        </TabsContent>
                    </Tabs>
                </ResizablePanel>
                <ResizableHandle PanelIndex="1" WithHandle="true" />
                <ResizablePanel Order="2" MinSize="30">
                    <div class="flex h-full flex-col">
                        <div class="flex items-center p-2">
                            <div class="flex items-center gap-2">
                                <Tooltip ShowDelay="0">
                                    <TooltipTrigger>
                                        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Icon" Disabled="@(Selected is null)">
                                            <SvgGlyph Svg="@(Lucide.Archive)" class="h-4 w-4" />
                                            <span class="sr-only">Archive</span>
                                        </Button>
                                    </TooltipTrigger>
                                    <TooltipContent>Archive</TooltipContent>
                                </Tooltip>
                                <Tooltip ShowDelay="0">
                                    <TooltipTrigger>
                                        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Icon" Disabled="@(Selected is null)">
                                            <SvgGlyph Svg="@(Lucide.ArchiveX)" class="h-4 w-4" />
                                            <span class="sr-only">Move to junk</span>
                                        </Button>
                                    </TooltipTrigger>
                                    <TooltipContent>Move to junk</TooltipContent>
                                </Tooltip>
                                <Tooltip ShowDelay="0">
                                    <TooltipTrigger>
                                        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Icon" Disabled="@(Selected is null)">
                                            <SvgGlyph Svg="@(Lucide.Trash2)" class="h-4 w-4" />
                                            <span class="sr-only">Move to trash</span>
                                        </Button>
                                    </TooltipTrigger>
                                    <TooltipContent>Move to trash</TooltipContent>
                                </Tooltip>
                                <Separator Orientation="Lumeo.Orientation.Vertical" Class="mx-1 h-6" />
                                <Tooltip ShowDelay="0">
                                    <Popover>
                                        <PopoverTrigger>
                                            <TooltipTrigger>
                                                <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Icon" Disabled="@(Selected is null)">
                                                    <SvgGlyph Svg="@(Lucide.Clock)" class="h-4 w-4" />
                                                    <span class="sr-only">Snooze</span>
                                                </Button>
                                            </TooltipTrigger>
                                        </PopoverTrigger>
                                        <PopoverContent Class="flex w-[535px] p-0">
                                            <div class="flex flex-col gap-2 border-r border-border px-2 py-4">
                                                <div class="px-4 text-sm font-medium">Snooze until</div>
                                                <div class="grid min-w-[250px] gap-1">
                                                    <Button Variant="Button.ButtonVariant.Ghost" Class="justify-start font-normal">Later today <span class="ml-auto text-muted-foreground">@Snooze(DateTime.Now.AddHours(4))</span></Button>
                                                    <Button Variant="Button.ButtonVariant.Ghost" Class="justify-start font-normal">Tomorrow <span class="ml-auto text-muted-foreground">@Snooze(DateTime.Now.AddDays(1))</span></Button>
                                                    <Button Variant="Button.ButtonVariant.Ghost" Class="justify-start font-normal">This weekend <span class="ml-auto text-muted-foreground">@Snooze(NextSaturday(DateTime.Now))</span></Button>
                                                    <Button Variant="Button.ButtonVariant.Ghost" Class="justify-start font-normal">Next week <span class="ml-auto text-muted-foreground">@Snooze(DateTime.Now.AddDays(7))</span></Button>
                                                </div>
                                            </div>
                                            <div class="p-2">
                                                <Calendar />
                                            </div>
                                        </PopoverContent>
                                    </Popover>
                                    <TooltipContent>Snooze</TooltipContent>
                                </Tooltip>
                            </div>
                            <div class="ml-auto flex items-center gap-2">
                                <Tooltip ShowDelay="0">
                                    <TooltipTrigger>
                                        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Icon" Disabled="@(Selected is null)">
                                            <SvgGlyph Svg="@(Lucide.Reply)" class="h-4 w-4" />
                                            <span class="sr-only">Reply</span>
                                        </Button>
                                    </TooltipTrigger>
                                    <TooltipContent>Reply</TooltipContent>
                                </Tooltip>
                                <Tooltip ShowDelay="0">
                                    <TooltipTrigger>
                                        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Icon" Disabled="@(Selected is null)">
                                            <SvgGlyph Svg="@(Lucide.ReplyAll)" class="h-4 w-4" />
                                            <span class="sr-only">Reply all</span>
                                        </Button>
                                    </TooltipTrigger>
                                    <TooltipContent>Reply all</TooltipContent>
                                </Tooltip>
                                <Tooltip ShowDelay="0">
                                    <TooltipTrigger>
                                        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Icon" Disabled="@(Selected is null)">
                                            <SvgGlyph Svg="@(Lucide.Forward)" class="h-4 w-4" />
                                            <span class="sr-only">Forward</span>
                                        </Button>
                                    </TooltipTrigger>
                                    <TooltipContent>Forward</TooltipContent>
                                </Tooltip>
                            </div>
                            <Separator Orientation="Lumeo.Orientation.Vertical" Class="mx-2 h-6" />
                            <DropdownMenu>
                                <DropdownMenuTrigger AsChild>
                                    <ChildContentSlot Context="slot">
                                        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Icon" Disabled="@(Selected is null)" id="@slot.Id" @attributes="slot.Attributes" OnClick="slot.OnClick">
                                            <SvgGlyph Svg="@(Lucide.EllipsisVertical)" class="h-4 w-4" />
                                            <span class="sr-only">More</span>
                                        </Button>
                                    </ChildContentSlot>
                                </DropdownMenuTrigger>
                                <DropdownMenuContent Align="Lumeo.Align.End">
                                    <DropdownMenuItem>Mark as unread</DropdownMenuItem>
                                    <DropdownMenuItem>Star thread</DropdownMenuItem>
                                    <DropdownMenuItem>Add label</DropdownMenuItem>
                                    <DropdownMenuItem>Mute thread</DropdownMenuItem>
                                </DropdownMenuContent>
                            </DropdownMenu>
                        </div>
                        <Separator />
                        @if (Selected is { } mail)
                        {
                            <div class="flex flex-1 flex-col">
                                <div class="flex items-start p-4">
                                    <div class="flex items-start gap-4 text-sm">
                                        <Avatar>
                                            <AvatarFallback>@Initials(mail.Name)</AvatarFallback>
                                        </Avatar>
                                        <div class="grid gap-1">
                                            <div class="font-semibold">@mail.Name</div>
                                            <div class="line-clamp-1 text-xs">@mail.Subject</div>
                                            <div class="line-clamp-1 text-xs"><span class="font-medium">Reply-To:</span> @mail.Email</div>
                                        </div>
                                    </div>
                                    <div class="ml-auto text-xs text-muted-foreground">@mail.Date.ToString("MMM d, yyyy, h:mm:ss tt", System.Globalization.CultureInfo.InvariantCulture)</div>
                                </div>
                                <Separator />
                                <div class="flex-1 whitespace-pre-wrap p-4 text-sm">@mail.Text</div>
                                <Separator Class="mt-auto" />
                                <div class="p-4">
                                    <form @onsubmit:preventDefault>
                                        <div class="grid gap-4">
                                            <Textarea Class="p-4" placeholder="@($"Reply {mail.Name}...")" />
                                            <div class="flex items-center">
                                                <Label For="mail-mute" Class="flex items-center gap-2 text-xs font-normal">
                                                    <Switch id="mail-mute" AriaLabel="Mute thread" Checked="@_mute" CheckedChanged="@(v => _mute = v)" /> Mute this thread
                                                </Label>
                                                <Button Size="Button.ButtonSize.Sm" Class="ml-auto">Send</Button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-8 text-center text-muted-foreground">No message selected</div>
                        }
                    </div>
                </ResizablePanel>
            </ResizablePanelGroup>
        </div>
    </ComponentDemo>
</Stack>

