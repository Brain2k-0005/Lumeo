@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <SwipeActions>
            <TrailingActions>
                <Button Variant="Button.ButtonVariant.Destructive" Class="h-full rounded-none px-4">Delete</Button>
                <Button Variant="Button.ButtonVariant.Secondary" Class="h-full rounded-none px-4">Archive</Button>
            </TrailingActions>
            <ChildContent>
                <Flex Align="center" Gap="3" Class="border border-border/40 rounded-lg px-3 py-2.5 bg-background">
                    <Lumeo.Text Size="sm" Class="flex-1">Project proposal draft</Lumeo.Text>
                    <Lumeo.Text Size="xs" Color="muted">Swipe left</Lumeo.Text>
                </Flex>
            </ChildContent>
        </SwipeActions>
        <SwipeActions>
            <TrailingActions>
                <Button Variant="Button.ButtonVariant.Destructive" Class="h-full rounded-none px-4">Delete</Button>
                <Button Variant="Button.ButtonVariant.Secondary" Class="h-full rounded-none px-4">Archive</Button>
            </TrailingActions>
            <ChildContent>
                <Flex Align="center" Gap="3" Class="border border-border/40 rounded-lg px-3 py-2.5 bg-background">
                    <Lumeo.Text Size="sm" Class="flex-1">Q2 budget review</Lumeo.Text>
                    <Lumeo.Text Size="xs" Color="muted">Swipe left</Lumeo.Text>
                </Flex>
            </ChildContent>
        </SwipeActions>
    </Stack>
</div>
