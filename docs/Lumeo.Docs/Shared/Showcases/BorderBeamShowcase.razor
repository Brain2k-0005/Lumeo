@namespace Lumeo.Docs.Shared.Showcases

<div class="flex w-full max-w-[22rem] justify-center">
    <BorderBeam Class="w-full max-w-[16rem]" DurationMs="4000">
        <Card Class="bg-card">
            <CardHeader>
                <Flex Align="center" Justify="between">
                    <Heading Level="3" Size="sm">Pro plan</Heading>
                    <Badge Variant="Badge.BadgeVariant.Secondary">Popular</Badge>
                </Flex>
            </CardHeader>
            <CardFooter>
                <Button Size="Button.ButtonSize.Sm" FullWidth="true">Start free trial</Button>
            </CardFooter>
        </Card>
    </BorderBeam>
</div>
