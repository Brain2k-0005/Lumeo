@namespace Lumeo

@if (Active)
{
    <g class="lumeo-chart-crosshair @Class" @attributes="AdditionalAttributes">
        <line x1="@Fmt(X)" x2="@Fmt(X)" y1="@Fmt(GridStart)" y2="@Fmt(GridEnd)"
              stroke="var(--color-muted-foreground)" stroke-width="1" stroke-dasharray="3 3" />
        @foreach (var m in Markers)
        {
            <circle cx="@Fmt(m.X)" cy="@Fmt(m.Y)" r="3.5" fill="@m.Color"
                    stroke="var(--color-card)" stroke-width="1.5" />
        }
    </g>
}

@code {
    /// <summary>Custom CSS classes appended to the root <c>&lt;g&gt;</c>.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Whether the crosshair is currently shown (a hover is active).</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>X position of the vertical guide line, from
    /// <see cref="ChartHitTester.IndexForPointerX"/>'s resolved index mapped
    /// back through the x-scale.</summary>
    [Parameter] public double X { get; set; }

    /// <summary>Guide-line vertical extent — plot top.</summary>
    [Parameter] public double GridStart { get; set; }

    /// <summary>Guide-line vertical extent — plot bottom.</summary>
    [Parameter] public double GridEnd { get; set; }

    /// <summary>One marker dot per visible series at the hovered index.</summary>
    [Parameter] public IReadOnlyList<ChartCrosshairMarker> Markers { get; set; } = Array.Empty<ChartCrosshairMarker>();

    private static string Fmt(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
