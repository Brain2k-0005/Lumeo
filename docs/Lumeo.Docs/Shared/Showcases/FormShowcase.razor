@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Form TModel="ShowcaseProfile" Model="@_model">
        <Stack Gap="3">
            <FormField Name="name" Label="Name">
                <Input @bind-Value="_model.Name" />
            </FormField>
            <FormField Name="email" Label="Email" Error="@_emailError">
                <Input @bind-Value="_model.Email" />
            </FormField>
        </Stack>
    </Form>
</div>

@code {
    private readonly ShowcaseProfile _model = new() { Name = "Ada Lovelace", Email = "not-an-email" };
    private readonly string _emailError = "Enter a valid email address.";

    private sealed class ShowcaseProfile
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
    }
}
