@namespace Lumeo.Docs.Shared.Showcases
@* Static exception (see ../README.md): PdfViewer loads pdf.js from a CDN and paints pages to
   a canvas — no document, no network, no canvas under bUnit or in a catalog card. This
   renders the exact toolbar chrome (page nav + zoom, same classes as PdfViewer's own) above
   a page-shaped placeholder, without the pdf.js wiring. *@

<div class="w-full max-w-[22rem] h-40 rounded-lg border border-border/40 overflow-hidden flex flex-col">
    <div class="flex items-center justify-between gap-2 border-b border-border/40 bg-background/60 px-2 py-1.5 shrink-0">
        <div class="flex items-center gap-1">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-md text-muted-foreground">
                <DynamicIcon Name="ChevronLeft" Class="h-3.5 w-3.5" />
            </span>
            <Lumeo.Text As="span" Size="xs" Color="muted">1 / 4</Lumeo.Text>
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-md text-muted-foreground">
                <DynamicIcon Name="ChevronRight" Class="h-3.5 w-3.5" />
            </span>
        </div>
        <div class="flex items-center gap-1">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-md text-muted-foreground">
                <DynamicIcon Name="Minus" Class="h-3.5 w-3.5" />
            </span>
            <Lumeo.Text As="span" Size="xs" Color="muted">100%</Lumeo.Text>
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-md text-muted-foreground">
                <DynamicIcon Name="Plus" Class="h-3.5 w-3.5" />
            </span>
        </div>
    </div>
    <div class="flex-1 flex items-center justify-center bg-muted/30">
        <div class="h-24 rounded-sm bg-card border border-border/60 shadow-md" style="width:4.6rem"></div>
    </div>
</div>
