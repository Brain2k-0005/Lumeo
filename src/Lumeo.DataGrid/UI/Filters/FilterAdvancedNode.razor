@namespace Lumeo

@* Dispatches a node to its row: a group card, a rule row, or the removable row of a rule whose
   field left the schema. *@
@if (Node is FilterGroup group)
{
    <FilterAdvancedGroup Group="group" Index="Index" ParentId="@ParentId" Combinator="Combinator" Depth="Depth" />
}
else if (Node is FilterRule rule)
{
    <FilterAdvancedRow Rule="rule" Index="Index" ParentId="@ParentId" Combinator="Combinator" Depth="Depth" />
}

@code {
    [Parameter, EditorRequired] public FilterNode Node { get; set; } = default!;
    [Parameter] public int Index { get; set; }
    [Parameter] public string ParentId { get; set; } = "";
    [Parameter] public FilterCombinator Combinator { get; set; }
    [Parameter] public int Depth { get; set; } = 1;
}
