@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <ResizablePanelGroup Direction="Lumeo.Orientation.Horizontal" DefaultSizes="@(new double[] { 50, 50 })" Class="h-32 rounded-lg border">
        <ResizablePanel Order="0">
            <Flex Class="h-full items-center justify-center">
                <Lumeo.Text As="span" Size="sm" Weight="semibold">Left</Lumeo.Text>
            </Flex>
        </ResizablePanel>
        <ResizableHandle PanelIndex="0" WithHandle="true" />
        <ResizablePanel Order="1">
            <Flex Class="h-full items-center justify-center">
                <Lumeo.Text As="span" Size="sm" Weight="semibold">Right</Lumeo.Text>
            </Flex>
        </ResizablePanel>
    </ResizablePanelGroup>
</div>
