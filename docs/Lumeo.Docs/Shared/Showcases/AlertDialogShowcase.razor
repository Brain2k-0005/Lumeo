@namespace Lumeo.Docs.Shared.Showcases

@* Fix round 1: real AlertDialog + real trigger — clicking "Delete Account" opens the
   REAL AlertDialogContent as a full-viewport modal over the page (expected, same as
   anywhere else in the app). The block below is an explicitly-marked PREVIEW ONLY
   static mock of that panel, no ARIA roles, inert <span> "buttons". *@
<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <AlertDialog @bind-Open="_open">
            <AlertDialogTrigger>
                <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" Class="w-fit">Delete Account</Button>
            </AlertDialogTrigger>
            <AlertDialogContent>
                <AlertDialogHeader>
                    <AlertDialogTitle>Are you absolutely sure?</AlertDialogTitle>
                    <AlertDialogDescription>
                        This action cannot be undone. This will permanently delete your account
                        and remove your data from our servers.
                    </AlertDialogDescription>
                </AlertDialogHeader>
                <AlertDialogFooter>
                    <AlertDialogCancel>Cancel</AlertDialogCancel>
                    <AlertDialogAction>Continue</AlertDialogAction>
                </AlertDialogFooter>
            </AlertDialogContent>
        </AlertDialog>

        @* PREVIEW ONLY — not the live panel. *@
        <div class="rounded-lg border border-border/40 bg-background p-3 shadow-lg">
            <Stack Gap="1">
                <Lumeo.Text Size="sm" Weight="semibold">Are you absolutely sure?</Lumeo.Text>
                <Lumeo.Text Size="xs" Color="muted">This action cannot be undone. This will permanently delete your account.</Lumeo.Text>
            </Stack>
            <Flex Justify="end" Gap="2" Class="mt-2">
                <span class="inline-flex h-7 items-center rounded-md border border-input bg-background px-2.5 text-xs">Cancel</span>
                <span class="inline-flex h-7 items-center rounded-md bg-destructive px-2.5 text-xs text-destructive-foreground">Continue</span>
            </Flex>
        </div>
    </Stack>
</div>

@code {
    private bool _open;
}
