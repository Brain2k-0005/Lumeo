@namespace Lumeo.Docs.Shared.Showcases
@using Lumeo

@* LIVE (see ../README.md): SatelliteBoundShowcase now lazy-loads Lumeo.Gantt.dll
   (ShowcaseResolver.SatelliteAssembliesFor) before this mounts. GanttChart's row
   virtualizer (GanttViewportReconciler) copes fine with a small, fully-visible task list —
   the old static replica's "needs a real scroll viewport" concern only bites once a task
   list is taller than its container, which three rows never triggers. The component's own
   view-mode/prev-next toolbar is built in (no way to hide it), so the box is a little taller
   than the other live showcases to give the day grid below it real room. Fixed dates (no
   DateTime.Now, per rule 1). Interactive: the real toolbar works, and a bar can be dragged
   to reschedule it. *@

<div class="w-full max-w-[22rem] h-40 rounded-md border border-border/60 overflow-hidden bg-background">
    <GanttChart Tasks="_tasks" ViewMode="GanttViewMode.Day" Height="160px" />
</div>

@code {
    private readonly List<GanttTask> _tasks =
    [
        new("design", "Design", new DateTime(2026, 3, 2), new DateTime(2026, 3, 4), 100),
        new("build", "Build", new DateTime(2026, 3, 4), new DateTime(2026, 3, 7), 45, Dependencies: new[] { "design" }),
        new("launch", "Launch", new DateTime(2026, 3, 7), new DateTime(2026, 3, 7), 0, IsMilestone: true, Dependencies: new[] { "build" }),
    ];
}
