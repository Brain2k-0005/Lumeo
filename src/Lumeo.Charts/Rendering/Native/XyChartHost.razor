@namespace Lumeo

@* Shared rendering/interaction orchestrator for the continuous-x/y native
   Cartesian types (Scatter, EffectScatter). Deliberately NOT built on
   CartesianChartHost: points here have no category index, so there is no
   band/point scale, no stacking, no bar slotting — and per spec §3.3,
   non-ordered point sets skip index-based hit-testing entirely in favor of
   native per-shape pointer events, which means this host needs none of
   CartesianChartHost's JS pointer-tracking registration either. Keyboard
   access is still a hard requirement (spec §3.6) — implemented here with the
   same pure ChartKeyboardNav index arithmetic, just triggered by a plain
   Blazor @@onkeydown instead of routing through ChartInteractionSurface. *@

@if (IsLoading && ShowLoadingSkeleton)
{
    <div class="lumeo-chart-native-loading relative inline-block w-full @Class" style="width:@Width;height:@Height;" @attributes="AdditionalAttributes">
        <ChartSkeleton Kind="@SkeletonKind" Width="100%" Height="100%" />
        @if (ShowLoadingLabel)
        {
            <div class="lumeo-chart-loading-pill absolute top-2 right-2 inline-flex items-center gap-1.5 rounded-full bg-card/90 px-2.5 py-1 text-xs text-muted-foreground shadow-sm" role="status">
                <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-primary"></span>
                <span>@LoadingText</span>
            </div>
        }
    </div>
}
else
{
    <div class="lumeo-chart-native relative inline-block w-full @Class" style="width:@Width;height:@Height;" @attributes="AdditionalAttributes">
        <svg viewBox="@Invariant($"0 0 {Fmt(_viewW)} {Fmt(_viewH)}")" preserveAspectRatio="none" class="lumeo-chart-native-svg block w-full h-full" role="presentation" focusable="false">
            <ChartAxis Ticks="@_xTicks" Orientation="ChartAxisOrientation.Bottom" GridStart="@_plot.Y" GridEnd="@_plot.Bottom" AxisLinePosition="@_plot.Bottom" />
            <ChartAxis Ticks="@_yTicks" Orientation="ChartAxisOrientation.Left" GridStart="@_plot.X" GridEnd="@_plot.Right" AxisLinePosition="@_plot.X" />

            @for (var s = 0; s < Series.Count; s++)
            {
                var seriesIndex = s;
                var ser = Series[seriesIndex];
                var color = ser.Color ?? NativeChartPalette.Resolve(ColorPalette, Colors, seriesIndex);
                @for (var p = 0; p < ser.Points.Count; p++)
                {
                    var pointIndex = p;
                    var (dx, dy) = ser.Points[pointIndex];
                    var cx = _xScale!.Scale(dx);
                    var cy = _yScale!.Scale(dy);
                    var r = (ser.PerPointSymbolSize is { } sz && pointIndex < sz.Count ? sz[pointIndex] : ser.SymbolSize) / 2;

                    @if (ser.Rippled)
                    {
                        @* Reduced-motion handling lives in lumeo.css (.lumeo-chart-native-ripple /
                           @@media (prefers-reduced-motion: reduce)) — a plain hand-authored CSS
                           rule, not a Tailwind utility, so it needs no JIT-bundle rebuild/verification. *@
                        <circle cx="@Fmt(cx)" cy="@Fmt(cy)" r="@Fmt(r)" fill="none" stroke="@color" stroke-width="1.5"
                                class="lumeo-chart-native-ripple" aria-hidden="true" />
                    }
                    <circle class="lumeo-chart-native-point" data-series="@seriesIndex" data-index="@pointIndex"
                            cx="@Fmt(cx)" cy="@Fmt(cy)" r="@Fmt(r)" fill="@color"
                            opacity="@(_hoverSeries is null || _hoverSeries == seriesIndex ? "1" : "0.35")"
                            @onmouseenter="() => OnPointHoverAsync(seriesIndex, pointIndex)"
                            @onmouseleave="OnPointLeaveAsync" />
                }
            }

            @if (ShowDataLabels)
            {
                @((MarkupString)_labelsMarkup)
            }

            <rect x="@Fmt(_plot.X)" y="@Fmt(_plot.Y)" width="@Fmt(_plot.Width)" height="@Fmt(_plot.Height)" fill="transparent"
                  class="lumeo-chart-native-kbd-surface" tabindex="0" role="img" aria-label="@_a11y?.Summary" @onkeydown="OnKeyDownAsync" />
        </svg>

        <ChartTooltipHost Active="@(ShowTooltip && _hoverFlatIndex is not null)" X="@_pointerClientX" Y="@_pointerClientY" Context="@_tooltipContext">
            <div class="lumeo-chart-native-tooltip rounded-md border border-border bg-popover px-2.5 py-2 text-xs shadow-md">
                <div class="flex items-center gap-1.5">
                    <span class="inline-block h-2 w-2 rounded-full" style="background:@context.Color"></span>
                    <span class="text-muted-foreground">@context.SeriesName</span>
                    <b class="ml-auto text-popover-foreground">(@(context.Raw.TryGetValue("x", out var xv) ? xv : ""), @(context.Value?.ToString("0.##") ?? "—"))</b>
                </div>
            </div>
        </ChartTooltipHost>

        @if (ShowLegend && Series.Count > 1)
        {
            <ChartLegend Class="mt-1" Items="@_legendItems" />
        }

        <div aria-live="polite" class="sr-only">@_announcement</div>
        @if (_a11y is not null)
        {
            <table class="sr-only">
                <caption>@_a11y.Summary</caption>
                <thead><tr>@foreach (var h in _a11y.ColumnHeaders) { <th>@h</th> }</tr></thead>
                <tbody>
                    @foreach (var row in _a11y.Rows)
                    {
                        <tr><th scope="row">@row.Header</th>@foreach (var cell in row.Cells) { <td>@cell</td> }</tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NativeXySeries> Series { get; set; } = Array.Empty<NativeXySeries>();
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "350px";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool ShowTooltip { get; set; } = true;
    [Parameter] public bool ShowDataLabels { get; set; }
    [Parameter] public string LabelPosition { get; set; } = "top";
    [Parameter] public string? LabelFormat { get; set; }
    [Parameter] public List<string>? Colors { get; set; }
    [Parameter] public List<string>? ColorPalette { get; set; }
    [Parameter] public string EChartsTypeLabel { get; set; } = "scatter";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool ShowLoadingSkeleton { get; set; } = true;
    [Parameter] public ChartSkeletonKind SkeletonKind { get; set; } = ChartSkeletonKind.Scatter;
    [Parameter] public ChartSkeletonStyle SkeletonStyle { get; set; } = ChartSkeletonStyle.Phantom;
    [Parameter] public int PhantomCycleMs { get; set; } = 1400;
    [Parameter] public bool ShowLoadingLabel { get; set; } = true;
    [Parameter] public string? LoadingText { get; set; } = "Loading…";

    private double _viewW = NativeChartViewport.DefaultViewBoxWidth;
    private double _viewH = NativeChartViewport.DefaultViewBoxHeight;
    private ChartPlotRect _plot;
    private LinearScale? _xScale;
    private LinearScale? _yScale;
    private IReadOnlyList<ChartAxisTick> _xTicks = Array.Empty<ChartAxisTick>();
    private IReadOnlyList<ChartAxisTick> _yTicks = Array.Empty<ChartAxisTick>();
    private IReadOnlyList<ChartLegendItem> _legendItems = Array.Empty<ChartLegendItem>();
    private ChartAccessibility.ChartDataTable? _a11y;
    private string _labelsMarkup = "";
    private string _announcement = "";
    private int? _hoverSeries;
    private int? _hoverFlatIndex;
    private ChartTooltipContext _tooltipContext = ChartTooltipContext.Empty;
    private double _pointerClientX, _pointerClientY;
    private Dictionary<(int Series, int Point), int> _flatIndexOf = new();
    private List<(int Series, int Point)> _flatOrder = new();

    protected override void OnParametersSet()
    {
        _viewW = NativeChartViewport.ParseViewBoxDimension(Width, NativeChartViewport.DefaultViewBoxWidth);
        _viewH = NativeChartViewport.ParseViewBoxDimension(Height, NativeChartViewport.DefaultViewBoxHeight);

        BuildFlatIndex();
        RecomputeLayout();
        BuildLegend();
        BuildAccessibility();
        if (ShowDataLabels) BuildLabelsMarkup(); else _labelsMarkup = "";
    }

    private void BuildFlatIndex()
    {
        _flatIndexOf = new Dictionary<(int, int), int>();
        _flatOrder = new List<(int, int)>();
        for (var s = 0; s < Series.Count; s++)
            for (var p = 0; p < Series[s].Points.Count; p++)
            {
                _flatIndexOf[(s, p)] = _flatOrder.Count;
                _flatOrder.Add((s, p));
            }
    }

    private void RecomputeLayout()
    {
        var allX = Series.SelectMany(s => s.Points.Select(p => p.X)).ToList();
        var allY = Series.SelectMany(s => s.Points.Select(p => p.Y)).ToList();
        var (xMin, xMax) = allX.Count > 0 ? (allX.Min(), allX.Max()) : (0.0, 1.0);
        var (yMin, yMax) = allY.Count > 0 ? (allY.Min(), allY.Max()) : (0.0, 1.0);
        if (xMin == xMax) xMax = xMin + 1;
        if (yMin == yMax) yMax = yMin + 1;

        var xTickVals = NiceTicks.Compute(xMin, xMax, 5);
        var yTickVals = NiceTicks.Compute(yMin, yMax, 5);

        var yLabelWidths = NativeChartViewport.EstimateLabelWidths(yTickVals.Select(FormatAxisNumber));
        var margin = ChartLayout.ComputeCartesianMargin(yLabelWidths, 0, 16, 0);
        if (ShowLegend && Series.Count > 1) margin = margin with { Top = margin.Top + 20 };

        _plot = ChartLayout.ComputePlotRect(_viewW, _viewH, margin);

        _xScale = new LinearScale(xTickVals[0], xTickVals[^1], _plot.X, _plot.Right);
        _yScale = new LinearScale(yTickVals[0], yTickVals[^1], _plot.Bottom, _plot.Y);
        _xTicks = xTickVals.Select(v => new ChartAxisTick(_xScale.Scale(v), FormatAxisNumber(v))).ToList();
        _yTicks = yTickVals.Select(v => new ChartAxisTick(_yScale.Scale(v), FormatAxisNumber(v))).ToList();
    }

    private static string FormatAxisNumber(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private void BuildLegend()
    {
        _legendItems = Series.Select((s, i) => new ChartLegendItem(s.Name, s.Name, s.Color ?? NativeChartPalette.Resolve(ColorPalette, Colors, i))).ToList();
    }

    private void BuildAccessibility()
    {
        var json = NativeChartAccessibilityJson.BuildXy(Series.Select(s => (s.Name, s.Points)).ToList(), EChartsTypeLabel);
        _a11y = ChartAccessibility.Build(json);
    }

    private void BuildLabelsMarkup()
    {
        var sb = new System.Text.StringBuilder();
        for (var s = 0; s < Series.Count; s++)
        {
            for (var p = 0; p < Series[s].Points.Count; p++)
            {
                var (dx, dy) = Series[s].Points[p];
                var x = _xScale!.Scale(dx);
                var y = _yScale!.Scale(dy) - 10;
                var text = NativeChartLabelFormat.Format(dy, LabelFormat);
                sb.Append("<text x=\"").Append(Fmt(x)).Append("\" y=\"").Append(Fmt(y))
                  .Append("\" fill=\"var(--color-foreground)\" font-size=\"10\" text-anchor=\"middle\">")
                  .Append(System.Net.WebUtility.HtmlEncode(text)).Append("</text>");
            }
        }
        _labelsMarkup = sb.ToString();
    }

    private Task OnPointHoverAsync(int seriesIndex, int pointIndex)
    {
        var ser = Series[seriesIndex];
        var (dx, dy) = ser.Points[pointIndex];
        var color = ser.Color ?? NativeChartPalette.Resolve(ColorPalette, Colors, seriesIndex);
        _hoverSeries = seriesIndex;
        _hoverFlatIndex = _flatIndexOf[(seriesIndex, pointIndex)];
        _tooltipContext = new ChartTooltipContext(ser.Name, EChartsTypeLabel, seriesIndex, ser.Name, pointIndex, dy, color,
            new Dictionary<string, object?> { ["x"] = dx, ["y"] = dy });
        _pointerClientX = _xScale!.Scale(dx);
        _pointerClientY = _yScale!.Scale(dy);
        _announcement = $"{ser.Name}: ({FormatAxisNumber(dx)}, {FormatAxisNumber(dy)})";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnPointLeaveAsync()
    {
        _hoverSeries = null;
        _hoverFlatIndex = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (_flatOrder.Count == 0) return Task.CompletedTask;

        int? next = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => ChartKeyboardNav.MoveIndex(_hoverFlatIndex, _flatOrder.Count, 1),
            "ArrowLeft" or "ArrowUp" => ChartKeyboardNav.MoveIndex(_hoverFlatIndex, _flatOrder.Count, -1),
            "Home" => ChartKeyboardNav.First(),
            "End" => ChartKeyboardNav.Last(_flatOrder.Count),
            _ => null,
        };

        if (next is null) return Task.CompletedTask;
        var (s, p) = _flatOrder[next.Value];
        return OnPointHoverAsync(s, p);
    }

    private static string Fmt(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private static string Invariant(FormattableString s) => s.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
