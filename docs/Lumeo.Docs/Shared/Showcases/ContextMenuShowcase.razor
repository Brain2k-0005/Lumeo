@namespace Lumeo.Docs.Shared.Showcases

@* Real component end to end (fix round 1): ContextMenuContent is positioned through
   Interop.PositionFixed at the right-click coordinates and escapes the card's
   overflow-hidden (README rule 4). Right-click the trigger area to open the real menu. *@
<div class="w-full max-w-[22rem]">
    <ContextMenu>
        <ContextMenuTrigger>
            <Flex Class="h-16 items-center justify-center rounded-md border border-dashed border-border/60 text-sm text-muted-foreground">
                Right click here
            </Flex>
        </ContextMenuTrigger>
        <ContextMenuContent>
            <ContextMenuItem>Back</ContextMenuItem>
            <ContextMenuItem>Forward</ContextMenuItem>
            <ContextMenuItem>Reload</ContextMenuItem>
            <ContextMenuSeparator />
            <ContextMenuItem>Print</ContextMenuItem>
        </ContextMenuContent>
    </ContextMenu>
</div>
