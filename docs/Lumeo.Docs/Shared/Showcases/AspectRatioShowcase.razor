@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Grid Columns="2" Gap="3" Class="w-full">
        <Stack Gap="1">
            <Lumeo.Text Size="xs" Color="muted">16:9</Lumeo.Text>
            <AspectRatio Ratio="16.0 / 9.0" Class="rounded-md overflow-hidden bg-muted">
                <Flex Class="items-center justify-center h-full text-muted-foreground text-xs">16:9</Flex>
            </AspectRatio>
        </Stack>
        <Stack Gap="1">
            <Lumeo.Text Size="xs" Color="muted">1:1</Lumeo.Text>
            <AspectRatio Ratio="1" Class="rounded-md overflow-hidden bg-muted">
                <Flex Class="items-center justify-center h-full text-muted-foreground text-xs">1:1</Flex>
            </AspectRatio>
        </Stack>
    </Grid>
</div>
