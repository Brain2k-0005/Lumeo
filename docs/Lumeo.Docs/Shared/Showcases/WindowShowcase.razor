@namespace Lumeo.Docs.Shared.Showcases

@* Window's own root panel is `position: fixed` (its Initial X/Y are viewport-relative drag
   coordinates, not relative to any wrapper) — the real component would float away from this
   card to a fixed spot on the page, exactly like a modal overlay would. Per the wave brief this
   renders a static replica of the panel chrome instead: the same title bar / body / resize-
   handle classes as Window.razor, laid out in normal flow so it stays inside the box. *@
<div class="w-full max-w-[22rem] h-40 rounded-lg border border-border/40 bg-muted/20 p-3">
    <div class="relative flex h-full flex-col bg-card border border-border/40 rounded-lg shadow-xl overflow-hidden">
        <div class="flex items-center gap-2 px-3 py-2 border-b border-border/40 bg-card rounded-t-lg">
            <Lumeo.Text As="span" Size="xs" Weight="medium" Class="flex-1 truncate">My Window</Lumeo.Text>
            <SvgGlyph Svg="@(LumeoIcons.X)" class="h-3 w-3 text-muted-foreground" />
        </div>
        <div class="overflow-auto p-3 flex-1">
            <Lumeo.Text Size="xs" Color="muted">This is a draggable, resizable floating window.</Lumeo.Text>
        </div>
        <svg viewBox="0 0 10 10" class="absolute bottom-1 right-1 w-3 h-3 text-muted-foreground fill-current" aria-hidden="true">
            <path d="M0 10L10 0M4 10L10 4M8 10L10 8" stroke="currentColor" stroke-width="1" fill="none" />
        </svg>
    </div>
</div>
