@namespace Lumeo
@implements IAsyncDisposable
@inject IComponentInteropService Interop

@* Shared rendering/interaction orchestrator for every category-based native
   Cartesian type (Line, Area, Bar, Mixed, Waterfall) — the Wave-1 composition
   layer over the Wave-0 core's scales/geometry/interaction primitives. Not
   part of the core itself: this is exactly the kind of per-wave "compose the
   primitives into a chart type" work the task describes, kept in one place so
   the five callers share one axis/legend/tooltip/hit-test/a11y/keyboard
   implementation instead of five divergent ones. *@

@if (IsLoading && ShowLoadingSkeleton)
{
    <div class="lumeo-chart-native-loading relative inline-block w-full @Class" style="width:@Width;height:@Height;" @attributes="AdditionalAttributes">
        <ChartSkeleton Kind="@SkeletonKind" Width="100%" Height="100%" />
        @if (ShowLoadingLabel)
        {
            <div class="lumeo-chart-loading-pill absolute top-2 right-2 inline-flex items-center gap-1.5 rounded-full bg-card/90 px-2.5 py-1 text-xs text-muted-foreground shadow-sm" role="status">
                <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-primary"></span>
                <span>@LoadingText</span>
            </div>
        }
    </div>
}
else
{
    <div class="lumeo-chart-native relative inline-block w-full @Class" style="width:@Width;height:@Height;@(_hasMeasuredBox ? "" : "visibility:hidden;")" @attributes="AdditionalAttributes">
        <svg id="@_svgId" viewBox="@Invariant($"0 0 {Fmt(_viewW)} {Fmt(_viewH)}")" preserveAspectRatio="none" class="lumeo-chart-native-svg block w-full h-full" role="presentation" focusable="false">
            <defs>@ExtraDefs</defs>

            <ChartAxis Ticks="@_valueTicks" Orientation="@(Horizontal ? ChartAxisOrientation.Bottom : ChartAxisOrientation.Left)"
                       GridStart="@(Horizontal ? _plot.Y : _plot.X)" GridEnd="@(Horizontal ? _plot.Bottom : _plot.Right)"
                       AxisLinePosition="@(Horizontal ? _plot.Bottom : _plot.X)" />
            @if (ShowSecondYAxis)
            {
                <ChartAxis Ticks="@_valueTicks2" Orientation="ChartAxisOrientation.Right"
                           GridStart="@_plot.Y" GridEnd="@_plot.Bottom" AxisLinePosition="@_plot.Right" ShowGridLines="false" />
            }
            @* Category axis is NOT rendered via <ChartAxis> — that primitive has
               no label-rotation support, and LabelStrategy/LabelRotate parity
               requires rotated labels at higher category counts. Built here
               instead (baseline + optionally-rotated <text>), reusing the same
               tick positions ChartAxis would have used. *@
            <line x1="@Fmt(_plot.X)" x2="@Fmt(Horizontal ? _plot.X : _plot.Right)"
                  y1="@Fmt(Horizontal ? _plot.Y : _plot.Bottom)" y2="@Fmt(_plot.Bottom)"
                  stroke="var(--color-border)" stroke-width="1" />
            @((MarkupString)_categoryLabelsMarkup)

            @((MarkupString)_seriesMarkup)
            @if (ShowDataLabels)
            {
                @((MarkupString)_labelsMarkup)
            }

            <ChartCrosshair Active="@_hover.IsActive" X="@_crosshairX" GridStart="@_plot.Y" GridEnd="@_plot.Bottom" Markers="@_crosshairMarkers" />

            <ChartInteractionSurface PlotX="@_plot.X" PlotY="@_plot.Y" PlotWidth="@_plot.Width" PlotHeight="@_plot.Height"
                                      PointCount="@_visibleCount" SeriesCount="@_tooltipSeriesCount"
                                      AriaLabel="@_a11y?.Summary" OnIndexChanged="OnIndexChangedAsync" OnSeriesChanged="OnSeriesChangedAsync" />
        </svg>

        <ChartTooltipHost Active="@(ShowTooltip && _hover.IsActive)" X="@_pointerClientX" Y="@_pointerClientY" Context="@_tooltipContext">
            <div class="lumeo-chart-native-tooltip rounded-md border border-border bg-popover px-2.5 py-2 text-xs shadow-md">
                <div class="mb-1 font-medium text-popover-foreground">@context.DataName</div>
                @foreach (var pt in context.Points)
                {
                    <div class="flex items-center gap-1.5">
                        <span class="inline-block h-2 w-2 rounded-full" style="background:@pt.Color"></span>
                        <span class="text-muted-foreground">@pt.SeriesName</span>
                        <b class="ml-auto text-popover-foreground">@(pt.Value?.ToString("0.##") ?? "—")</b>
                    </div>
                }
            </div>
        </ChartTooltipHost>

        @if (ShowLegend)
        {
            <ChartLegend Class="mt-1" Items="@_legendItems" HiddenKeys="@_legendState.HiddenKeys" HoveredKey="@_legendState.HoveredKey"
                         OnToggle="OnLegendToggleAsync" OnHover="OnLegendHoverAsync" />
        }
        @if (DataZoom && Categories.Count > 1)
        {
            <ChartZoomSlider Class="mt-2" Width="@_viewW" Height="16" Start="@_zoom.Start" End="@_zoom.End" OnRangeChanged="OnZoomRangeChangedAsync" />
        }

        <div aria-live="polite" class="sr-only">@_announcement</div>
        @if (_a11y is not null)
        {
            <table class="sr-only">
                <caption>@_a11y.Summary</caption>
                <thead><tr>@foreach (var h in _a11y.ColumnHeaders) { <th>@h</th> }</tr></thead>
                <tbody>
                    @foreach (var row in _a11y.Rows)
                    {
                        <tr><th scope="row">@row.Header</th>@foreach (var cell in row.Cells) { <td>@cell</td> }</tr>
                    }
                    @if (_a11y.TruncationNote is not null)
                    {
                        <tr><td colspan="@(_a11y.ColumnHeaders.Count)">@_a11y.TruncationNote</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Categories { get; set; } = Array.Empty<string>();
    [Parameter, EditorRequired] public IReadOnlyList<NativeCartesianSeries> Series { get; set; } = Array.Empty<NativeCartesianSeries>();
    /// <summary>true = PointScale (Line/Area's boundaryGap:false parity), false = BandScale (Bar/Mixed/Waterfall).</summary>
    [Parameter] public bool UsePointScale { get; set; }
    [Parameter] public bool Horizontal { get; set; }
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "350px";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool ShowTooltip { get; set; } = true;
    [Parameter] public bool ShowDataLabels { get; set; }
    [Parameter] public string LabelPosition { get; set; } = "top";
    [Parameter] public string? LabelFormat { get; set; }
    [Parameter] public ChartLabelStrategy LabelStrategy { get; set; } = ChartLabelStrategy.Smart;
    [Parameter] public int? LabelRotate { get; set; }
    [Parameter] public bool DataZoom { get; set; }
    [Parameter] public List<string>? Colors { get; set; }
    [Parameter] public List<string>? ColorPalette { get; set; }
    [Parameter] public int? AnimationDuration { get; set; }
    [Parameter] public string? AnimationEasing { get; set; }
    /// <summary>ECharts-style type string ("line"/"bar"/"area") used only to
    /// pick the right human-readable label in the reused
    /// <see cref="ChartAccessibility"/> table (e.g. "Bar chart with…").</summary>
    [Parameter] public string EChartsTypeLabel { get; set; } = "line";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool ShowLoadingSkeleton { get; set; } = true;
    [Parameter] public ChartSkeletonKind SkeletonKind { get; set; } = ChartSkeletonKind.Line;
    [Parameter] public ChartSkeletonStyle SkeletonStyle { get; set; } = ChartSkeletonStyle.Phantom;
    [Parameter] public int PhantomCycleMs { get; set; } = 1400;
    [Parameter] public bool ShowLoadingLabel { get; set; } = true;
    [Parameter] public string? LoadingText { get; set; } = "Loading…";
    [Parameter] public RenderFragment? ExtraDefs { get; set; }
    [Parameter] public bool ShowSecondYAxis { get; set; }

    private double _viewW = NativeChartViewport.DefaultViewBoxWidth;
    private double _viewH = NativeChartViewport.DefaultViewBoxHeight;
    private ChartPlotRect _plot;
    private LinearScale? _valueScale;
    private LinearScale? _valueScale2;
    private BandScale? _bandScale;
    private PointScale? _pointScale;
    private IReadOnlyList<ChartAxisTick> _valueTicks = Array.Empty<ChartAxisTick>();
    private IReadOnlyList<ChartAxisTick> _valueTicks2 = Array.Empty<ChartAxisTick>();
    private IReadOnlyList<ChartAxisTick> _categoryTicks = Array.Empty<ChartAxisTick>();
    private string _seriesMarkup = "";
    private string _labelsMarkup = "";
    private readonly ChartHoverState _hover = new();
    private readonly ChartLegendState _legendState = new();
    private readonly ChartZoomState _zoom = new();
    private IReadOnlyList<ChartLegendItem> _legendItems = Array.Empty<ChartLegendItem>();
    private IReadOnlyList<ChartCrosshairMarker> _crosshairMarkers = Array.Empty<ChartCrosshairMarker>();
    private double _crosshairX;
    private double _pointerClientX;
    private double _pointerClientY;
    private ChartTooltipContext _tooltipContext = ChartTooltipContext.Empty;
    private int _tooltipSeriesCount;
    private ChartAccessibility.ChartDataTable? _a11y;
    private string _announcement = "";
    private int _visibleStart, _visibleEnd;
    private int _visibleCount => _visibleEnd - _visibleStart;
    private string[] _resolvedColors = Array.Empty<string>();

    // --- Screen-space tooltip positioning -----------------------------------
    // The SVG is drawn in a fixed LOGICAL viewBox (_viewW x _viewH). Once
    // _hasMeasuredBox is true, _viewW/_viewH ARE the real rendered box's pixel
    // size (see the aspect-ratio-fix remarks below), so preserveAspectRatio's
    // scaling is an identity transform and ToScreen below is nearly a no-op
    // translate; before that first measurement lands (or in a JS-less/test
    // context) it still correctly accounts for a genuine viewBox/box mismatch.
    // Converting through NativeChartScreenTransform — shared with XyChartHost/
    // NativeBoxPlotChart/NativeCandlestickChart, see its own remarks for why
    // this is ONE implementation instead of four — is what makes
    // ChartTooltipHost (position:fixed, raw X/Y) track the cursor instead of
    // drifting.
    private readonly string _svgId = $"lumeo-chart-native-svg-{Guid.NewGuid():N}";
    private readonly NativeChartScreenTransform _screen = new();

    private Task RefreshScreenTransformAsync() => _screen.RefreshAsync(Interop, _svgId, _viewW, _viewH);

    /// <summary>Converts a logical (viewBox-space) point to real viewport
    /// pixels, for <see cref="ChartTooltipHost"/>'s position:fixed coordinates.</summary>
    private (double X, double Y) ToScreen(double logicalX, double logicalY) => _screen.ToScreen(logicalX, logicalY);

    // --- Aspect-ratio fix: sync the viewBox to the REAL measured box -------
    // Every native chart used to render into a hardcoded 600x350 viewBox with
    // preserveAspectRatio="none". Since these charts default to Width="100%",
    // the rendered box's aspect essentially never matched 600:350, so the
    // non-uniform stretch turned circles into ellipses and stretched axis
    // glyphs — the largest remaining visual defect in the native engine.
    //
    // The Wave-0 authors deliberately did NOT wire up a JS round-trip for
    // layout measurement (see NativeChartViewport's own remarks) specifically
    // to avoid a flash of wrong margins on first paint, before axis-label
    // text metrics arrive. That reasoning is respected here, not overridden:
    // this host still renders synchronously with a best-effort viewW/viewH
    // (parsed from Width/Height, falling back to the historical 600x350) on
    // first render — but the outer container stays `visibility:hidden` (see
    // the markup above) until the FIRST real ResizeObserver measurement
    // lands, so no visibly-wrong-aspect frame is ever painted; the trade is a
    // brief blank instead, resolved within one interop round-trip (a single
    // microtask on WASM; one circuit message on Server). Once measured,
    // _hasMeasuredBox latches true and _viewW/_viewH permanently track the
    // real box (Width/Height parameters no longer override it) — a
    // ResizeObserver keeps reporting on every subsequent resize.
    private bool _hasMeasuredBox;
    private bool _boxObserverRegistered;
    private DotNetObjectReference<CartesianChartHost>? _boxSelfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsLoading && ShowLoadingSkeleton)
        {
            // The skeleton branch renders no <svg id="@_svgId">; once loading
            // ends the "else" branch mounts a BRAND NEW element under the same
            // id, so force re-registration next time instead of no-op'ing.
            _boxObserverRegistered = false;
            return;
        }
        if (_boxObserverRegistered) return;

        _boxSelfRef ??= DotNetObjectReference.Create(this);
        await Interop.ChartObserveBox(_svgId, _boxSelfRef, nameof(OnChartBoxResize));
        _boxObserverRegistered = true;
    }

    [Microsoft.JSInterop.JSInvokable]
    public void OnChartBoxResize(double width, double height)
    {
        if (width <= 0 || height <= 0) return;
        if (_hasMeasuredBox && _viewW == width && _viewH == height) return;

        _viewW = width;
        _viewH = height;
        _hasMeasuredBox = true;
        RebuildAll();
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (!_hasMeasuredBox)
        {
            _viewW = NativeChartViewport.ParseViewBoxDimension(Width, NativeChartViewport.DefaultViewBoxWidth);
            _viewH = NativeChartViewport.ParseViewBoxDimension(Height, NativeChartViewport.DefaultViewBoxHeight);
        }

        RebuildAll();
    }

    private void RebuildAll()
    {
        _resolvedColors = Series.Select((s, i) => s.Color ?? NativeChartPalette.Resolve(ColorPalette, Colors, i)).ToArray();

        RecomputeVisibleWindow();
        RecomputeLayout();
        BuildSeriesMarkup();
        if (ShowDataLabels) BuildLabelsMarkup(); else _labelsMarkup = "";
        BuildLegend();
        BuildAccessibility();
        _tooltipSeriesCount = ActiveSeries(VisibleSeries()).Count(s => s.IncludeInTooltip);
    }

    private void RecomputeVisibleWindow()
    {
        var n = Categories.Count;
        if (!DataZoom || n <= 1) { _visibleStart = 0; _visibleEnd = n; return; }
        var s = (int)Math.Floor(_zoom.Start * n);
        var e = (int)Math.Ceiling(_zoom.End * n);
        s = Math.Clamp(s, 0, Math.Max(0, n - 1));
        e = Math.Clamp(e, s + 1, n);
        _visibleStart = s;
        _visibleEnd = e;
    }

    private List<string> VisibleCategories() => Categories.Skip(_visibleStart).Take(_visibleCount).ToList();

    /// <summary>Series sliced to the visible (zoom) window. INDEX-ALIGNED with
    /// the original <see cref="Series"/>/<see cref="_resolvedColors"/> arrays
    /// — always returns one entry per input series, in the same order,
    /// specifically so callers can keep indexing <c>_resolvedColors[s]</c>
    /// without a separate index-mapping table. Legend-hidden series are NOT
    /// removed here (that would break the alignment); callers skip them
    /// individually via <see cref="IsSeriesHidden"/>.</summary>
    private List<NativeCartesianSeries> VisibleSeries() => Series.Select(s => new NativeCartesianSeries
    {
        Name = s.Name,
        Kind = s.Kind,
        Values = s.Values.Skip(_visibleStart).Take(_visibleCount).ToList(),
        Color = s.Color,
        Smooth = s.Smooth,
        ShowDots = s.ShowDots,
        Stacked = s.Stacked,
        YAxisIndex = s.YAxisIndex,
        PointColors = s.PointColors?.Skip(_visibleStart).Take(_visibleCount).ToList(),
        DisplayValues = s.DisplayValues?.Skip(_visibleStart).Take(_visibleCount).ToList(),
        IncludeInLegend = s.IncludeInLegend,
        IncludeInTooltip = s.IncludeInTooltip,
        FillPaint = s.FillPaint,
        FillOpacity = s.FillOpacity,
    }).ToList();

    private bool IsSeriesHidden(NativeCartesianSeries s) => s.IncludeInLegend && _legendState.IsHidden(s.Name);

    /// <summary>The subset of <see cref="VisibleSeries"/> that a legend
    /// toggle hasn't hidden — used everywhere stacking/domain/rendering must
    /// actually omit a hidden series (not just dim its legend swatch).</summary>
    private List<NativeCartesianSeries> ActiveSeries(List<NativeCartesianSeries> visibleSeries) =>
        visibleSeries.Where(s => !IsSeriesHidden(s)).ToList();

    /// <summary>Same filter as <see cref="ActiveSeries"/>, but also returns
    /// each surviving series' ORIGINAL index into <see cref="VisibleSeries"/>
    /// (== <see cref="Series"/>/<see cref="_resolvedColors"/>) — needed
    /// wherever a caller must both (a) feed the filtered list into
    /// <see cref="NativeCartesianLayout"/>'s stacking math, which returns
    /// results keyed by position in ITS input list, AND (b) resolve that same
    /// series' pre-computed color, which is keyed by the ORIGINAL index.</summary>
    private (List<NativeCartesianSeries> Active, List<int> OriginalIndex) ActiveSeriesWithIndex(List<NativeCartesianSeries> visibleSeries)
    {
        var active = new List<NativeCartesianSeries>();
        var originalIndex = new List<int>();
        for (var i = 0; i < visibleSeries.Count; i++)
        {
            if (IsSeriesHidden(visibleSeries[i])) continue;
            active.Add(visibleSeries[i]);
            originalIndex.Add(i);
        }
        return (active, originalIndex);
    }

    private void RecomputeLayout()
    {
        var visibleSeries = ActiveSeries(VisibleSeries());
        var n = _visibleCount;

        var (yMin, yMax) = NativeCartesianLayout.ComputeYDomain(visibleSeries, n, 0);
        var yTickVals = NiceTicks.Compute(yMin, yMax, 5);
        var yDomainMin = yTickVals[0];
        var yDomainMax = yTickVals[^1];

        var yLabelWidths = NativeChartViewport.EstimateLabelWidths(yTickVals.Select(FormatAxisNumber));
        var xLabelHeight = LabelRotate is not null && LabelRotate != 0 ? 34.0 : 16.0;
        var margin = ChartLayout.ComputeCartesianMargin(yLabelWidths, 0, xLabelHeight, 0);
        if (ShowLegend) margin = margin with { Top = margin.Top + 20 };
        if (DataZoom && Categories.Count > 1) margin = margin with { Bottom = margin.Bottom + 22 };

        double margin2Right = 0;
        IReadOnlyList<double> yTickVals2 = Array.Empty<double>();
        if (ShowSecondYAxis)
        {
            var (y2Min, y2Max) = NativeCartesianLayout.ComputeYDomain(visibleSeries, n, 1);
            yTickVals2 = NiceTicks.Compute(y2Min, y2Max, 5);
            var w2 = NativeChartViewport.EstimateLabelWidths(yTickVals2.Select(FormatAxisNumber)).DefaultIfEmpty(0).Max();
            margin2Right = w2 + 14 + 8;
        }
        margin = margin with { Right = margin.Right + margin2Right };

        _plot = ChartLayout.ComputePlotRect(_viewW, _viewH, margin);

        var categoryRangeMin = Horizontal ? _plot.Y : _plot.X;
        var categoryRangeMax = Horizontal ? _plot.Bottom : _plot.Right;
        var valueRangeMin = Horizontal ? _plot.X : _plot.Bottom;   // pixel for the value-domain MIN
        var valueRangeMax = Horizontal ? _plot.Right : _plot.Y;    // pixel for the value-domain MAX

        _valueScale = new LinearScale(yDomainMin, yDomainMax, valueRangeMin, valueRangeMax);
        if (UsePointScale) { _pointScale = new PointScale(n, categoryRangeMin, categoryRangeMax); _bandScale = null; }
        else { _bandScale = new BandScale(n, categoryRangeMin, categoryRangeMax); _pointScale = null; }

        _valueTicks = yTickVals.Select(v => new ChartAxisTick(_valueScale.Scale(v), FormatAxisNumber(v))).ToList();

        if (ShowSecondYAxis && yTickVals2.Count > 0)
        {
            var d2min = yTickVals2[0]; var d2max = yTickVals2[^1];
            _valueScale2 = new LinearScale(d2min, d2max, _plot.Bottom, _plot.Y);
            _valueTicks2 = yTickVals2.Select(v => new ChartAxisTick(_valueScale2.Scale(v), FormatAxisNumber(v))).ToList();
        }
        else { _valueScale2 = null; _valueTicks2 = Array.Empty<ChartAxisTick>(); }

        var visibleCats = VisibleCategories();
        var (_, rotate) = ChartLabelHelper.Resolve(LabelStrategy, visibleCats.Count, LabelRotate);
        _categoryLabelRotate = rotate ?? 0;
        _categoryTicks = visibleCats.Select((c, i) => new ChartAxisTick(CategoryPixel(i), c)).ToList();
        BuildCategoryLabelsMarkup();
    }

    private int _categoryLabelRotate;
    private string _categoryLabelsMarkup = "";

    private void BuildCategoryLabelsMarkup()
    {
        // Mirrors ChartAxis.razor's own label placement math (text-anchor /
        // dominant-baseline / offset) for the two orientations this host ever
        // uses for the category axis (Bottom when vertical, Left when
        // Horizontal), plus a rotate() transform ChartAxis itself can't do —
        // the one reason this host builds category labels itself instead of
        // delegating to <ChartAxis> like the value axis does.
        const double offset = 8;
        var sb = new System.Text.StringBuilder();
        foreach (var t in _categoryTicks)
        {
            double lx, ly;
            string anchor;
            if (Horizontal) { lx = _plot.X - offset; ly = t.Position; anchor = "end"; }
            else { lx = t.Position; ly = _plot.Bottom + offset; anchor = _categoryLabelRotate != 0 ? "end" : "middle"; }
            var baseline = Horizontal ? "middle" : "hanging";
            var transform = !Horizontal && _categoryLabelRotate != 0
                ? Invariant($" transform=\"rotate({_categoryLabelRotate} {Fmt(lx)} {Fmt(ly)})\"")
                : "";
            sb.Append("<text x=\"").Append(Fmt(lx)).Append("\" y=\"").Append(Fmt(ly))
              .Append("\" fill=\"var(--color-muted-foreground)\" font-size=\"11\" text-anchor=\"").Append(anchor)
              .Append("\" dominant-baseline=\"").Append(baseline).Append('"').Append(transform).Append('>')
              .Append(System.Net.WebUtility.HtmlEncode(t.Label)).Append("</text>");
        }
        _categoryLabelsMarkup = sb.ToString();
    }

    private static string FormatAxisNumber(double v) => NativeChartShared.FormatAxisNumber(v);

    private double CategoryPixel(int i) => _bandScale is not null ? _bandScale.Center(i) : _pointScale!.Position(i);

    private double ValuePixel(double v, int yAxisIndex) => yAxisIndex == 1 && _valueScale2 is not null ? _valueScale2.Scale(v) : _valueScale!.Scale(v);

    private (double X, double Y) Pt(int i, double v, int yAxisIndex = 0)
    {
        var cat = CategoryPixel(i);
        var val = ValuePixel(v, yAxisIndex);
        return Horizontal ? (val, cat) : (cat, val);
    }

    /// <summary>Minimum rendered thickness (viewBox units) for a bar whose
    /// true value is non-zero — a genuinely-zero value still renders nothing
    /// (0 correctly means "no bar"), but a tiny non-zero value no longer
    /// disappears into a sub-pixel sliver. The edge anchored to the baseline
    /// (0, or the layer below in a stack) never moves; only the far edge is
    /// pushed outward to meet the minimum, so the bar still visually "starts"
    /// from the right place.</summary>
    private const double MinVisibleBarThickness = 2;

    private (double X, double Y, double W, double H) BarRect(int i, double v0, double v1, int slotIndex, int slotCount, int yAxisIndex)
    {
        var bandStart = _bandScale!.Start(i);
        var slotWidth = _bandScale.Bandwidth / Math.Max(1, slotCount);
        var gap = slotWidth * 0.16;
        var thickness = Math.Max(0.5, slotWidth - gap);
        var slotStart = bandStart + slotIndex * slotWidth + gap / 2;

        // v0 is always the baseline-side value (0, or the stack layer below);
        // its pixel position is the edge that must stay fixed when the
        // minimum-thickness rule below pushes the other edge outward.
        var baselinePx = ValuePixel(v0, yAxisIndex);
        var valuePx = ValuePixel(v1, yAxisIndex);
        double lo, hi;
        if (valuePx <= baselinePx) { lo = valuePx; hi = baselinePx; } else { lo = baselinePx; hi = valuePx; }

        if (v1 != v0 && hi - lo < MinVisibleBarThickness)
        {
            if (valuePx <= baselinePx) lo = hi - MinVisibleBarThickness;
            else hi = lo + MinVisibleBarThickness;
        }

        return Horizontal ? (lo, slotStart, hi - lo, thickness) : (slotStart, lo, thickness, hi - lo);
    }

    private static IEnumerable<List<int>> ContiguousRuns(IReadOnlyList<double?> values)
    {
        var run = new List<int>();
        for (var i = 0; i < values.Count; i++)
        {
            if (values[i].HasValue) { run.Add(i); }
            else if (run.Count > 0) { yield return run; run = new List<int>(); }
        }
        if (run.Count > 0) yield return run;
    }

    private void BuildSeriesMarkup()
    {
        var (activeSeries, originalIndex) = ActiveSeriesWithIndex(VisibleSeries());
        var n = _visibleCount;
        var sb = new System.Text.StringBuilder();
        var barExtents = NativeCartesianLayout.ComputeStackedExtents(activeSeries, NativeCartesianSeriesKind.Bar, n);
        var areaExtents = NativeCartesianLayout.ComputeStackedExtents(activeSeries, NativeCartesianSeriesKind.Area, n);
        var barSlots = NativeCartesianLayout.ComputeBarSlots(activeSeries);

        for (var s = 0; s < activeSeries.Count; s++)
        {
            var ser = activeSeries[s];
            var color = _resolvedColors[originalIndex[s]];
            var dur = AnimationDuration is > 0 ? AnimationDuration.Value : 0;
            // Transition duration/easing ride in as CSS custom properties, not
            // a `transition:` property, on purpose: the actual `transition`
            // rule lives in lumeo.css (`.lumeo-chart-native-line`, `-area`,
            // `-bar`) behind a `prefers-reduced-motion: reduce` override.
            // Inline `style="transition:…"` can't be overridden by a
            // stylesheet media query (inline always wins), which would have
            // made every data-change/initial-paint animation ignore reduced
            // motion — the one other animated chart affordance in this file
            // (the EffectScatter ripple) already respects it; this brings
            // Line/Area/Bar in line with that instead of being the exception.
            var transition = dur > 0
                ? Invariant($"--lumeo-chart-transition-duration:{dur}ms;--lumeo-chart-transition-easing:{System.Net.WebUtility.HtmlEncode(string.IsNullOrEmpty(AnimationEasing) ? "ease" : AnimationEasing)};")
                : "";

            switch (ser.Kind)
            {
                case NativeCartesianSeriesKind.Line:
                {
                    var curve = ser.Smooth ? ChartCurve.Monotone : ChartCurve.Linear;
                    foreach (var run in ContiguousRuns(ser.Values))
                    {
                        var pts = run.Select(i => Pt(i, ser.Values[i]!.Value, ser.YAxisIndex)).ToList();
                        var d = ChartPathBuilder.BuildLine(pts, curve);
                        sb.Append("<path class=\"lumeo-chart-native-line\" data-series=\"").Append(originalIndex[s]).Append("\" d=\"").Append(System.Net.WebUtility.HtmlEncode(d))
                          .Append("\" fill=\"none\" stroke=\"").Append(color).Append("\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"").Append(transition).Append("\" />");
                        if (ser.ShowDots)
                        {
                            foreach (var i in run)
                            {
                                var (x, y) = Pt(i, ser.Values[i]!.Value, ser.YAxisIndex);
                                sb.Append("<circle class=\"lumeo-chart-native-dot\" data-series=\"").Append(originalIndex[s]).Append("\" data-index=\"").Append(i)
                                  .Append("\" cx=\"").Append(Fmt(x)).Append("\" cy=\"").Append(Fmt(y)).Append("\" r=\"3\" fill=\"").Append(color).Append("\" />");
                            }
                        }
                    }
                    break;
                }
                case NativeCartesianSeriesKind.Area:
                {
                    var curve = ser.Smooth ? ChartCurve.Monotone : ChartCurve.Linear;
                    var extents = areaExtents[s];
                    var fill = ser.FillPaint ?? $"color-mix(in oklab, {color} {(int)Math.Round(ser.FillOpacity * 100)}%, transparent)";
                    foreach (var run in ContiguousRuns(ser.Values))
                    {
                        var band = run.Select(i => (X: CategoryPixel(i), Y0: ValuePixel(extents[i].Bottom, ser.YAxisIndex), Y1: ValuePixel(extents[i].Top, ser.YAxisIndex))).ToList();
                        var fillD = ChartPathBuilder.BuildBand(band, curve);
                        // Fill-only: BuildBand returns a CLOSED contour (top edge
                        // forward, bottom/baseline edge backward, "Z"). Stroking
                        // that whole closed path — the previous behavior — draws
                        // a visible line along the baseline AND the two vertical
                        // seams at the run's start/end, reading as an unwanted
                        // box around the chart (worst in dark mode, most visible
                        // on the bottom-most series where the baseline IS the
                        // x-axis). No engine we compare against (ECharts, ReUI)
                        // strokes anything but the top edge, so this path carries
                        // fill only; the top-edge stroke is a separate path below.
                        sb.Append("<path class=\"lumeo-chart-native-area\" data-series=\"").Append(originalIndex[s]).Append("\" d=\"").Append(System.Net.WebUtility.HtmlEncode(fillD))
                          .Append("\" fill=\"").Append(fill).Append("\" stroke=\"none\" style=\"").Append(transition).Append("\" />");

                        var topPoints = run.Select(i => (CategoryPixel(i), ValuePixel(extents[i].Top, ser.YAxisIndex))).ToList();
                        var topD = ChartPathBuilder.BuildLine(topPoints, curve);
                        sb.Append("<path class=\"lumeo-chart-native-area-line\" data-series=\"").Append(originalIndex[s]).Append("\" d=\"").Append(System.Net.WebUtility.HtmlEncode(topD))
                          .Append("\" fill=\"none\" stroke=\"").Append(color).Append("\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"").Append(transition).Append("\" />");

                        // Dots draw AFTER (on top of, in SVG paint order) both paths
                        // above so they're never hidden underneath the area's own fill —
                        // same <circle class="lumeo-chart-native-dot"> markup the Line
                        // case uses, at the series' own top (value) edge, not the
                        // stacked bottom.
                        if (ser.ShowDots)
                        {
                            foreach (var i in run)
                            {
                                var (x, y) = (CategoryPixel(i), ValuePixel(extents[i].Top, ser.YAxisIndex));
                                sb.Append("<circle class=\"lumeo-chart-native-dot\" data-series=\"").Append(originalIndex[s]).Append("\" data-index=\"").Append(i)
                                  .Append("\" cx=\"").Append(Fmt(x)).Append("\" cy=\"").Append(Fmt(y)).Append("\" r=\"3\" fill=\"").Append(color).Append("\" />");
                            }
                        }
                    }
                    break;
                }
                case NativeCartesianSeriesKind.Bar:
                {
                    if (!barExtents.TryGetValue(s, out var extents) || !barSlots.TryGetValue(s, out var slot)) break;
                    for (var i = 0; i < n; i++)
                    {
                        if (i >= ser.Values.Count || ser.Values[i] is null) continue;
                        var (x, y, w, h) = BarRect(i, extents[i].Bottom, extents[i].Top, slot.SlotIndex, slot.SlotCount, ser.YAxisIndex);
                        var barColor = ser.PointColors is { } pc && i < pc.Count && pc[i] is not null ? pc[i] : color;
                        // Radius capped at 4 (viewBox units) — a bit more than the
                        // previous 3, closer to the library's --radius-sm scale
                        // (used for other small filled shapes like badges) without
                        // going full "pill" on a normal-width bar.
                        var d = Horizontal || h < 1 ? "" : ChartRoundedRectPath.TopRounded(x, y, w, h, Math.Min(4, w / 2));
                        // data-x/y/width/height are written on BOTH the <path> (rounded-top,
                        // the normal vertical-bar case) and the <rect> variant, so a bar's exact
                        // computed geometry is always assertable the same way regardless of which
                        // element it rendered as — a <path>'s "d" isn't a simple x/y/w/h tuple to
                        // parse back out, and per this task's own testability rule, tests must
                        // assert rendered/computed VALUES, not re-derive them from markup.
                        if (!string.IsNullOrEmpty(d))
                        {
                            sb.Append("<path class=\"lumeo-chart-native-bar\" data-series=\"").Append(originalIndex[s]).Append("\" data-index=\"").Append(i)
                              .Append("\" data-x=\"").Append(Fmt(x)).Append("\" data-y=\"").Append(Fmt(y)).Append("\" data-width=\"").Append(Fmt(w)).Append("\" data-height=\"").Append(Fmt(h))
                              .Append("\" d=\"").Append(d).Append("\" fill=\"").Append(barColor).Append("\" style=\"").Append(transition).Append("\" />");
                        }
                        else
                        {
                            sb.Append("<rect class=\"lumeo-chart-native-bar\" data-series=\"").Append(originalIndex[s]).Append("\" data-index=\"").Append(i)
                              .Append("\" data-x=\"").Append(Fmt(x)).Append("\" data-y=\"").Append(Fmt(y)).Append("\" data-width=\"").Append(Fmt(w)).Append("\" data-height=\"").Append(Fmt(h))
                              .Append("\" x=\"").Append(Fmt(x)).Append("\" y=\"").Append(Fmt(y)).Append("\" width=\"").Append(Fmt(w)).Append("\" height=\"").Append(Fmt(h))
                              .Append("\" fill=\"").Append(barColor).Append("\" style=\"").Append(transition).Append("\" />");
                        }
                    }
                    break;
                }
            }
        }
        _seriesMarkup = sb.ToString();
    }

    private void BuildLabelsMarkup()
    {
        var (activeSeries, _) = ActiveSeriesWithIndex(VisibleSeries());
        var n = _visibleCount;
        var barExtents = NativeCartesianLayout.ComputeStackedExtents(activeSeries, NativeCartesianSeriesKind.Bar, n);
        var barSlots = NativeCartesianLayout.ComputeBarSlots(activeSeries);
        var sb = new System.Text.StringBuilder();

        for (var s = 0; s < activeSeries.Count; s++)
        {
            var ser = activeSeries[s];
            if (!ser.IncludeInTooltip) continue;
            for (var i = 0; i < n; i++)
            {
                if (i >= ser.Values.Count || ser.Values[i] is not { } value) continue;
                double lx, ly;
                if (ser.Kind == NativeCartesianSeriesKind.Bar && barExtents.TryGetValue(s, out var ext) && barSlots.TryGetValue(s, out var slot))
                {
                    var (x, y, w, _) = BarRect(i, ext[i].Bottom, ext[i].Top, slot.SlotIndex, slot.SlotCount, ser.YAxisIndex);
                    lx = x + w / 2; ly = y - 4;
                }
                else
                {
                    var (px, py) = Pt(i, value, ser.YAxisIndex);
                    lx = px; ly = py - 8;
                }
                var text = NativeChartLabelFormat.Format((ser.DisplayValues?.ElementAtOrDefault(i)) ?? value, LabelFormat);
                sb.Append("<text x=\"").Append(Fmt(lx)).Append("\" y=\"").Append(Fmt(ly))
                  .Append("\" fill=\"var(--color-foreground)\" font-size=\"10\" text-anchor=\"middle\">")
                  .Append(System.Net.WebUtility.HtmlEncode(text)).Append("</text>");
            }
        }
        _labelsMarkup = sb.ToString();
    }

    private void BuildLegend()
    {
        var items = new List<ChartLegendItem>();
        for (var i = 0; i < Series.Count; i++)
        {
            if (!Series[i].IncludeInLegend) continue;
            items.Add(new ChartLegendItem(Series[i].Name, Series[i].Name, _resolvedColors[i]));
        }
        _legendItems = items;
    }

    private void BuildAccessibility()
    {
        var visibleSeries = ActiveSeries(VisibleSeries());
        var json = NativeChartAccessibilityJson.BuildCartesian(VisibleCategories(), visibleSeries, EChartsTypeLabel);
        _a11y = ChartAccessibility.Build(json);
    }

    private Task OnLegendToggleAsync(string key)
    {
        _legendState.Toggle(key, _legendItems.Count);
        OnParametersSet(); // hiding/showing a series changes the y-domain, stacking, and bar slotting — not just the swatch style
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnLegendHoverAsync(string? key)
    {
        _legendState.SetHover(key);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnZoomRangeChangedAsync((double Start, double End) range)
    {
        _zoom.SetRange(range.Start, range.End);
        OnParametersSet();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task OnIndexChangedAsync(int? index)
    {
        if (index is null) { if (_hover.Clear()) StateHasChanged(); _announcement = ""; return; }

        // Fresh measurement per resolved index change — see RefreshScreenTransformAsync's remarks.
        await RefreshScreenTransformAsync();

        var (activeSeries, originalIndex) = ActiveSeriesWithIndex(VisibleSeries());
        _tooltipSeriesCount = activeSeries.Count(s => s.IncludeInTooltip);

        var points = new List<ChartTooltipPoint>();
        var markers = new List<ChartCrosshairMarker>();
        for (var s = 0; s < activeSeries.Count; s++)
        {
            var ser = activeSeries[s];
            if (!ser.IncludeInTooltip) continue;
            if (index.Value >= ser.Values.Count || ser.Values[index.Value] is not { } raw) continue;
            var color = _resolvedColors[originalIndex[s]];
            var displayVal = ser.DisplayValues is { } dv && index.Value < dv.Count && dv[index.Value] is { } d ? d : raw;
            points.Add(new ChartTooltipPoint(ser.Name, EChartsTypeLabel, originalIndex[s], index.Value, displayVal, color, null));
            var (x, y) = Pt(index.Value, raw, ser.YAxisIndex);
            markers.Add(new ChartCrosshairMarker(x, y, color));
        }

        var category = index.Value < VisibleCategories().Count ? VisibleCategories()[index.Value] : "";
        _tooltipContext = new ChartTooltipContext(
            points.Count > 0 ? points[0].SeriesName : "", EChartsTypeLabel, points.Count > 0 ? points[0].SeriesIndex : 0,
            category, index.Value, points.Count > 0 ? points[0].Value : null, points.Count > 0 ? points[0].Color : null,
            new Dictionary<string, object?>()) with { Points = points };

        _crosshairX = Horizontal ? _plot.X : CategoryPixel(index.Value);
        _crosshairMarkers = markers;
        // Logical viewBox point for the hovered index, converted to real
        // viewport pixels via ToScreen (see its remarks) so the tooltip lands
        // under the cursor even when the rendered SVG box differs from the
        // logical viewBox (e.g. a "100%"-width chart in a narrow column).
        var logicalPointerX = Horizontal ? (markers.Count > 0 ? markers[0].X : _plot.X) : CategoryPixel(index.Value);
        var logicalPointerY = Horizontal ? CategoryPixel(index.Value) : (markers.Count > 0 ? markers[0].Y : _plot.Y);
        (_pointerClientX, _pointerClientY) = ToScreen(logicalPointerX, logicalPointerY);

        _hover.TrySet(points.Count > 0 ? points[0].SeriesIndex : (int?)null, index.Value, _pointerClientX, _pointerClientY);
        _announcement = $"{category}: " + string.Join(", ", points.Select(p => $"{p.SeriesName} {p.Value?.ToString("0.##") ?? "—"}"));

        StateHasChanged();
    }

    private Task OnSeriesChangedAsync(int seriesIndex) => Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Interop.ChartUnobserveBox(_svgId);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        _boxSelfRef?.Dispose();
    }

    private static string Fmt(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private static string Invariant(FormattableString s) => s.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
