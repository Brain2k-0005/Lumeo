@namespace Lumeo
@using System.Globalization
@using Lumeo.SchedulerKernel
@implements IAsyncDisposable
@inject Lumeo.Services.IComponentInteropService Interop
@inject Lumeo.Services.Localization.ILumeoLocalizer L

@* First-party time-grid view (spec §1.1/§1.2/§1.3/§5), shared by Week (Days=7) and Day
   (Days=1) — mirrors the uploaded demo's renderWeek(days) sharing one implementation via a
   `days` parameter (spec §1.1). Consumes SchedulerDateMath for week boundaries,
   SchedulerRecurrenceExpander for occurrence expansion, and SchedulerTimeGridLayout for
   overlapping-event column packing. Internal building block — see SchedulerMonthView's own
   remarks for the "Scheduler.razor is the only component with public parameters" note. *@
<div class="@($"flex flex-col rounded-md border border-border/60 overflow-hidden {Class}".Trim())" @attributes="AdditionalAttributes">
    @if (_allDayInstances.Any())
    {
        <div class="flex border-b border-border/60">
            <div class="flex-none w-14 text-[10px] text-muted-foreground pt-1.5 pl-1">@L["Scheduler.AllDay"]</div>
            <div class="flex-1 grid min-w-0" style="grid-template-columns: repeat(@Days, minmax(0, 1fr));">
                @for (var d = 0; d < Days; d++)
                {
                    var day = _dayColumns[d];
                    <div class="border-l border-border/40 p-1 flex flex-col gap-0.5 min-w-0">
                        @foreach (var inst in _allDayInstances.Where(i => TouchesDay(i.Instance.Start, i.Instance.End, true, day)))
                        {
                            <button type="button" class="@AllDayPillClasses(inst)" style="@PillStyle(inst.Source)"
                                    @onclick="() => OnEventClickAsync(inst.Source)">
                                @inst.Source.Title
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="flex" style="max-height: 34rem; overflow-y: auto;" @ref="_scrollRef">
        <div class="flex-none w-14">
            @foreach (var hour in _hours)
            {
                <div class="h-12 relative">
                    <span class="absolute -top-1.5 right-1.5 text-[11px] text-muted-foreground">@FormatHour(hour)</span>
                </div>
            }
        </div>
        <div class="flex-1 grid min-w-0 relative" role="grid" aria-label="@GridAriaLabel()" style="grid-template-columns: repeat(@Days, minmax(0, 1fr));" @ref="_hostRef">
            @for (var d = 0; d < Days; d++)
            {
                var dayIndex = d;
                var day = _dayColumns[dayIndex];
                <div class="relative border-l border-border/40" role="row" data-daycol="@day.ToString("yyyy-MM-dd")" @ref="_dayColumnRefs[dayIndex]">
                    @for (var h = 0; h < _hours.Length; h++)
                    {
                        var hourIndex = h;
                        var cellLinear = hourIndex * Days + dayIndex;
                        var isFocused = cellLinear == _focusedIndex;
                        <div role="gridcell"
                             @ref="_cellRefs[cellLinear]"
                             tabindex="@(isFocused ? "0" : "-1")"
                             data-slot-hour="@_hours[hourIndex]"
                             aria-label="@SlotAriaLabel(day, _hours[hourIndex])"
                             class="h-12 border-b border-border/30 cursor-crosshair focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring focus-visible:-outline-offset-2"
                             @onclick="() => OnSlotClickAsync(day, _hours[hourIndex])"
                             @ondblclick="() => OnSlotDoubleClickAsync(day, _hours[hourIndex])"
                             @onkeydown="e => OnGridKeyDownAsync(e, dayIndex, hourIndex)">
                        </div>
                    }
                    @foreach (var block in _timedByDay[dayIndex])
                    {
                        var key = InstanceKey(block.Instance);
                        var blockHourIndex = HourIndexOf(block.Instance.Start);
                        <button type="button"
                                @ref="_pillRefs[key]"
                                class="@TimedPillClasses()"
                                style="@TimedPillStyle(block)"
                                data-event-instance="@key"
                                data-event-id="@block.Instance.EventId"
                                tabindex="-1"
                                aria-label="@PillAriaLabel(block.Source, block.Instance)"
                                @onclick:stopPropagation="true"
                                @onclick="() => OnEventClickAsync(block.Source)"
                                @onkeydown="e => OnPillKeyDownAsync(e, block.Source, dayIndex, blockHourIndex)">
                            <span class="block font-semibold truncate">@block.Source.Title</span>
                            <span class="block text-[10px] opacity-80">@block.Instance.Start.ToString("t", CultureInfo.CurrentUICulture)</span>
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>The calendar's events (expanded per occurrence internally via <c>SchedulerRecurrenceExpander</c>).</summary>
    [Parameter] public IEnumerable<SchedulerEvent>? Events { get; set; }

    /// <summary>Anchor date. Week mode (<see cref="Days"/> == 7) resolves the containing week via <see cref="FirstDayOfWeek"/>; Day mode (<see cref="Days"/> == 1) shows this date only.</summary>
    [Parameter] public DateTime AnchorDate { get; set; } = DateTime.Today;

    /// <summary>Number of day columns: 7 = Week, 1 = Day (spec §1.1). Any other value renders that many columns starting at <see cref="AnchorDate"/> (wave-3 N-day groundwork, not yet a public view).</summary>
    [Parameter] public int Days { get; set; } = 7;

    [Parameter] public DayOfWeek FirstDayOfWeek { get; set; } = DayOfWeek.Monday;

    /// <summary>Earliest visible slot. Default 00:00. Never changes the underlying wall-clock grid math (spec §2.3) — purely a visible-range clamp.</summary>
    [Parameter] public TimeOnly? SlotMinTime { get; set; }

    /// <summary>Latest visible slot. Default 24:00.</summary>
    [Parameter] public TimeOnly? SlotMaxTime { get; set; }

    [Parameter] public EventCallback<SchedulerEvent> OnEventClick { get; set; }
    [Parameter] public EventCallback<SchedulerDateRange> OnDateSelect { get; set; }
    [Parameter] public EventCallback OnRequestPrev { get; set; }
    [Parameter] public EventCallback OnRequestNext { get; set; }
    [Parameter] public Func<SchedulerEvent, string?>? ResolveEventColor { get; set; }
    [Parameter] public Func<SchedulerEvent, string?>? ResolveEventClassNames { get; set; }

    /// <summary>Allows events to be dragged (move) and edge-resized. Default true.</summary>
    [Parameter] public bool Editable { get; set; } = true;

    /// <summary>Allows drag-to-create on empty grid background. Default true.</summary>
    [Parameter] public bool Selectable { get; set; } = true;

    /// <summary>Shows the browser-local current-time indicator line (spec §2.2 — positioned and refreshed entirely client-side, never a server-computed value). Default true.</summary>
    [Parameter] public bool NowIndicator { get; set; } = true;

    /// <summary>
    /// Fail-closed validation predicate for a move/resize drop (spec §3.2). <c>null</c> (default)
    /// means no consumer opted in — JS is told via <c>hasCanDrop: false</c> so zero
    /// <see cref="ValidateDrop"/> interop calls happen per drag, not "always permit".
    /// </summary>
    [Parameter] public Func<SchedulerEvent, SchedulerScheduleDropContext, bool>? CanDrop { get; set; }

    /// <summary>Raised after a move/resize drag commits (post-<see cref="CanDrop"/> validation, ghost already removed).</summary>
    [Parameter] public EventCallback<SchedulerEvent> OnEventChange { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private DateTime[] _dayColumns = Array.Empty<DateTime>();
    private int[] _hours = Array.Empty<int>();
    private int _minMinute;
    private int _maxMinute = 1440;
    private List<TimedBlock>[] _timedByDay = Array.Empty<List<TimedBlock>>();
    private List<TimedBlock> _allDayInstances = new();
    private int _focusedIndex;
    private ElementReference _scrollRef;
    private ElementReference _hostRef;
    private ElementReference[] _cellRefs = Array.Empty<ElementReference>();
    private ElementReference[] _dayColumnRefs = Array.Empty<ElementReference>();
    private ElementReference[] _registeredNowIndicatorRefs = Array.Empty<ElementReference>();
    private readonly Dictionary<string, ElementReference> _pillRefs = new(StringComparer.Ordinal);
    private DotNetObjectReference<SchedulerTimeGridView>? _selfRef;
    private bool _dragRegistered;
    private int _lastDragOptionsHash;
    // Nullable so a first-render hash that happens to equal a sentinel value can never
    // be mistaken for "already synced" — mirrors the drag-registration gate's own
    // `_dragRegistered && hash == _lastDragOptionsHash` short-circuit (see
    // SyncDragRegistrationAsync above), just expressed via nullability instead of a
    // separate bool since this sync has no other "have we ever registered" state to hang one off of.
    private int? _lastNowIndicatorHash;

    protected override void OnParametersSet()
    {
        _minMinute = (int)(SlotMinTime?.ToTimeSpan().TotalMinutes ?? 0);
        _maxMinute = (int)(SlotMaxTime?.ToTimeSpan().TotalMinutes ?? 1440);
        if (_maxMinute <= _minMinute) _maxMinute = _minMinute + 60;

        var hourStart = _minMinute / 60;
        var hourEnd = (int)Math.Ceiling(_maxMinute / 60.0);
        _hours = Enumerable.Range(hourStart, Math.Max(1, hourEnd - hourStart)).ToArray();

        var days = Math.Max(1, Days);
        if (days == 7)
        {
            var weekStart = SchedulerDateMath.StartOfWeek(AnchorDate, FirstDayOfWeek);
            _dayColumns = Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToArray();
        }
        else
        {
            _dayColumns = Enumerable.Range(0, days).Select(i => AnchorDate.Date.AddDays(i)).ToArray();
        }

        _cellRefs = new ElementReference[_hours.Length * _dayColumns.Length];
        _dayColumnRefs = new ElementReference[_dayColumns.Length];
        if (_focusedIndex < 0 || _focusedIndex >= _cellRefs.Length) _focusedIndex = 0;

        BuildEventLayout();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncDragRegistrationAsync();
        await SyncNowIndicatorAsync();
    }

    private async Task SyncDragRegistrationAsync()
    {
        var hash = HashCode.Combine(Editable, Selectable, CanDrop is not null);
        if (_dragRegistered && hash == _lastDragOptionsHash) return;
        _lastDragOptionsHash = hash;
        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            await Interop.SchedulerViewsRegisterTimeGridDragAsync(_hostRef, _selfRef, BuildDragOptions());
            _dragRegistered = true;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    private object BuildDragOptions()
    {
        const double pxPerMinute = 48.0 / 60.0;
        return new Dictionary<string, object?>
        {
            ["editable"] = Editable,
            ["selectable"] = Selectable,
            ["allowResize"] = true,
            ["hasCanDrop"] = CanDrop is not null,
            ["pixelsPerMinute"] = pxPerMinute,
            ["snapMinutes"] = 15,
            ["slotMinMinute"] = _minMinute,
        };
    }

    private async Task SyncNowIndicatorAsync()
    {
        var hash = HashCode.Combine(NowIndicator, _minMinute, string.Join(",", _dayColumns.Select(d => d.ToString("yyyyMMdd"))));
        if (hash == _lastNowIndicatorHash) return;
        _lastNowIndicatorHash = hash;

        foreach (var r in _registeredNowIndicatorRefs)
        {
            try { await Interop.SchedulerViewsUnregisterNowIndicatorAsync(r); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        _registeredNowIndicatorRefs = Array.Empty<ElementReference>();

        if (!NowIndicator) return;

        const double pxPerMinute = 48.0 / 60.0;
        for (var i = 0; i < _dayColumns.Length && i < _dayColumnRefs.Length; i++)
        {
            var options = new Dictionary<string, object?>
            {
                ["pixelsPerMinute"] = pxPerMinute,
                ["slotMinMinute"] = _minMinute,
                ["dayIso"] = _dayColumns[i].ToString("yyyy-MM-dd"),
            };
            try { await Interop.SchedulerViewsRegisterNowIndicatorAsync(_dayColumnRefs[i], options); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        _registeredNowIndicatorRefs = _dayColumnRefs.ToArray();
    }

    private void BuildEventLayout()
    {
        _pillRefs.Clear();
        if (_dayColumns.Length == 0) { _timedByDay = Array.Empty<List<TimedBlock>>(); _allDayInstances = new(); return; }

        var events = (Events ?? Enumerable.Empty<SchedulerEvent>()).ToList();
        var byId = new Dictionary<string, SchedulerEvent>(StringComparer.Ordinal);
        foreach (var ev in events)
            if (!string.IsNullOrEmpty(ev.Id)) byId[ev.Id] = ev;

        var rangeStart = _dayColumns[0];
        var rangeEnd = _dayColumns[^1].AddDays(1);
        var allInstances = SchedulerRecurrenceExpander.ExpandAll(events, rangeStart, rangeEnd)
            .Where(i => byId.ContainsKey(i.EventId))
            .ToList();

        _allDayInstances = allInstances
            .Where(i => byId[i.EventId].AllDay)
            .Select(i => new TimedBlock(i, byId[i.EventId], 0, 1))
            .ToList();

        var timedByDay = new List<TimedBlock>[_dayColumns.Length];
        for (var d = 0; d < _dayColumns.Length; d++)
        {
            var day = _dayColumns[d];
            var dayInstances = allInstances
                .Where(i => !byId[i.EventId].AllDay && i.Start.Date == day.Date)
                .ToList();

            var packInput = dayInstances
                .Select(i => (Id: InstanceKey(i), StartMinute: (int)i.Start.TimeOfDay.TotalMinutes, EndMinute: Math.Max((int)i.Start.TimeOfDay.TotalMinutes + 1, (int)i.End.TimeOfDay.TotalMinutes)))
                .ToList();
            var packed = SchedulerTimeGridLayout.Pack(packInput);
            var packedById = packed.ToDictionary(p => p.Id, p => (p.Column, p.ColumnsInCluster), StringComparer.Ordinal);

            var blocks = new List<TimedBlock>();
            foreach (var inst in dayInstances)
            {
                var key = InstanceKey(inst);
                var (col, colCount) = packedById.TryGetValue(key, out var v) ? v : (0, 1);
                blocks.Add(new TimedBlock(inst, byId[inst.EventId], col, colCount));
            }
            timedByDay[d] = blocks;
        }
        _timedByDay = timedByDay;
    }

    private static DateTime LastTouchedDate(DateTime end, bool allDay, DateTime start)
    {
        if (!allDay && end.Date == start.Date) return start.Date;
        var last = end.TimeOfDay == TimeSpan.Zero ? end.Date.AddDays(-1) : end.Date;
        return last < start.Date ? start.Date : last;
    }

    private static bool TouchesDay(DateTime start, DateTime end, bool allDay, DateTime day)
    {
        if (!allDay && end.Date == start.Date) return day.Date == start.Date;
        var last = LastTouchedDate(end, allDay, start);
        return day.Date >= start.Date && day.Date <= last;
    }

    private static string InstanceKey(SchedulerEventInstance i) => $"{i.EventId}|{i.Start:O}";

    private static string FormatHour(int hour) => $"{hour % 24:D2}:00";

    private string GridAriaLabel() => Days == 1 ? L["Scheduler.Day"] : L["Scheduler.Week"];

    private string SlotAriaLabel(DateTime day, int hour) =>
        $"{day.ToString("D", CultureInfo.CurrentUICulture)}, {FormatHour(hour)}";

    private static string PillAriaLabel(SchedulerEvent ev, SchedulerEventInstance inst) =>
        $"{ev.Title}, {inst.Start:t}–{inst.End:t}";

    private string AllDayPillClasses(TimedBlock block)
    {
        var classes = "block w-full text-left text-[11px] font-medium px-1.5 py-0.5 rounded truncate border-0 cursor-pointer";
        var extra = ResolveEventClassNames?.Invoke(block.Source);
        if (!string.IsNullOrEmpty(extra)) classes += " " + extra;
        return classes;
    }

    private static string TimedPillClasses() =>
        "absolute rounded-md overflow-hidden text-left text-[11px] leading-tight px-1.5 py-0.5 border-l-4 cursor-pointer select-none";

    private string PillStyle(SchedulerEvent ev)
    {
        var color = ResolveEventColor?.Invoke(ev) ?? ev.Color ?? "var(--color-primary)";
        return $"background-color: color-mix(in oklab, {color} 18%, transparent); color: {color};";
    }

    private string TimedPillStyle(TimedBlock block)
    {
        var color = ResolveEventColor?.Invoke(block.Source) ?? block.Source.Color ?? "var(--color-primary)";
        var startMinute = Math.Clamp((int)block.Instance.Start.TimeOfDay.TotalMinutes, _minMinute, _maxMinute);
        var rawEndMinute = (int)block.Instance.End.TimeOfDay.TotalMinutes;
        if (rawEndMinute <= startMinute) rawEndMinute = startMinute + 15;
        var endMinute = Math.Clamp(rawEndMinute, _minMinute, _maxMinute);
        const double pxPerMinute = 48.0 / 60.0;
        var top = (startMinute - _minMinute) * pxPerMinute;
        var height = Math.Max(16, (endMinute - startMinute) * pxPerMinute);
        var width = 100.0 / block.ColumnsInCluster;
        var left = block.Column * width;
        return $"top:{top.ToString(CultureInfo.InvariantCulture)}px; height:{height.ToString(CultureInfo.InvariantCulture)}px; left:calc({left.ToString(CultureInfo.InvariantCulture)}% + 2px); width:calc({width.ToString(CultureInfo.InvariantCulture)}% - 4px); background-color: color-mix(in oklab, {color} 18%, transparent); color: {color}; border-left-color: {color};";
    }

    // ── Interaction ──────────────────────────────────────────────────────

    private async Task OnEventClickAsync(SchedulerEvent ev)
    {
        if (OnEventClick.HasDelegate) await OnEventClick.InvokeAsync(ev);
    }

    private void OnSlotClickAsync(DateTime day, int hour)
    {
        _focusedIndex = LinearIndex(Array.IndexOf(_dayColumns, day), hour);
    }

    private async Task OnSlotDoubleClickAsync(DateTime day, int hour)
    {
        if (!OnDateSelect.HasDelegate) return;
        var start = day.Date.AddHours(hour);
        await OnDateSelect.InvokeAsync(new SchedulerDateRange(start, start.AddMinutes(30), false));
    }

    private async Task OnPillKeyDownAsync(KeyboardEventArgs e, SchedulerEvent ev, int dayIndex, int hourIndex)
    {
        if (e.Key is "Enter" or " ")
        {
            await OnEventClickAsync(ev);
        }
        else if (e.Key == "Escape")
        {
            var idx = LinearIndex(dayIndex, hourIndex);
            _focusedIndex = idx;
            await FocusCellAsync(idx);
        }
    }

    private int LinearIndex(int dayIndex, int hourIndex) => hourIndex * _dayColumns.Length + dayIndex;

    private int HourIndexOf(DateTime instant)
    {
        var hour = instant.Hour;
        var idx = Array.IndexOf(_hours, hour);
        return idx >= 0 ? idx : 0;
    }

    /// <summary>Roving-tabindex 2-D grid navigation (spec §5.2's Week/Day column).</summary>
    private async Task OnGridKeyDownAsync(KeyboardEventArgs e, int dayIndex, int hourIndex)
    {
        var current = LinearIndex(dayIndex, hourIndex);
        _focusedIndex = current;
        int nextDay = dayIndex, nextHour = hourIndex;
        switch (e.Key)
        {
            case "ArrowRight": nextDay = Math.Min(_dayColumns.Length - 1, dayIndex + 1); break;
            case "ArrowLeft": nextDay = Math.Max(0, dayIndex - 1); break;
            case "ArrowDown": nextHour = Math.Min(_hours.Length - 1, hourIndex + 1); break;
            case "ArrowUp": nextHour = Math.Max(0, hourIndex - 1); break;
            case "Home": nextHour = 0; break;
            case "End": nextHour = _hours.Length - 1; break;
            case "PageUp":
                if (OnRequestPrev.HasDelegate) await OnRequestPrev.InvokeAsync();
                return;
            case "PageDown":
                if (OnRequestNext.HasDelegate) await OnRequestNext.InvokeAsync();
                return;
            case "Enter":
            case " ":
                await ActivateFocusedSlotAsync(dayIndex, hourIndex);
                return;
            default:
                return;
        }

        var next = LinearIndex(nextDay, nextHour);
        if (next != current)
        {
            _focusedIndex = next;
            await FocusCellAsync(next);
        }
    }

    private async Task ActivateFocusedSlotAsync(int dayIndex, int hourIndex)
    {
        var block = _timedByDay.Length > dayIndex
            ? _timedByDay[dayIndex].FirstOrDefault(b => (int)b.Instance.Start.TimeOfDay.TotalMinutes / 60 == _hours[hourIndex])
            : null;
        if (block is not null)
        {
            var key = InstanceKey(block.Instance);
            if (_pillRefs.TryGetValue(key, out var pillRef))
            {
                try { await pillRef.FocusAsync(); }
                catch (Microsoft.JSInterop.JSDisconnectedException) { }
            }
        }
        else
        {
            await OnSlotDoubleClickAsync(_dayColumns[dayIndex], _hours[hourIndex]);
        }
    }

    private async Task FocusCellAsync(int index)
    {
        try { await _cellRefs[index].FocusAsync(); }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    // ── Drag/resize/create (spec §3.1-§3.4) ────────────────────────────────
    // Ghost-only: JS never mutates the real chip (data-event-instance element) during a
    // drag — only a cloned ghost moves (scheduler-views.js's makeGhost). Fail-closed:
    // ValidateDrop is awaited by JS BEFORE CommitDrag/CommitCreate is ever invoked; any
    // rejected/thrown invocation resolves to `false` on the JS side (.catch(() => false)),
    // never `true`. See scheduler-views.js's own header comment for the full argument.

    /// <summary>
    /// [JSInvokable] fail-closed CanDrop check for a move/resize candidate. Returns
    /// <c>false</c> (never permits) for any input JS shouldn't have been able to produce
    /// (unknown instance key, malformed mode) — an unrecognized shape is not evidence of
    /// permission, only of something already gone wrong upstream.
    /// </summary>
    [JSInvokable]
    public bool ValidateDrop(string instanceKey, string mode, string? dayIso, int deltaMinutes)
    {
        if (CanDrop is null) return true;
        var parsed = ParseInstanceKey(instanceKey);
        if (parsed is not { } p) return false;
        var src = FindEvent(p.EventId);
        if (src is null) return false;
        var (newStart, newEnd, source) = ComputeCandidate(p.Start, src.End - src.Start, mode, dayIso, deltaMinutes);
        if (newStart is null || newEnd is null) return false;
        return CanDrop(src, new SchedulerScheduleDropContext(newStart.Value, newEnd.Value, source));
    }

    [JSInvokable]
    public async Task CommitDrag(string instanceKey, string mode, string? dayIso, int deltaMinutes)
    {
        var parsed = ParseInstanceKey(instanceKey);
        if (parsed is not { } p) return;
        var src = FindEvent(p.EventId);
        if (src is null) return;
        var (newStart, newEnd, _) = ComputeCandidate(p.Start, src.End - src.Start, mode, dayIso, deltaMinutes);
        if (newStart is null || newEnd is null || newStart == src.Start && newEnd == src.End) return;
        var updated = src with { Start = newStart.Value, End = newEnd.Value };
        if (OnEventChange.HasDelegate) await OnEventChange.InvokeAsync(updated);
    }

    [JSInvokable]
    public async Task CommitCreate(string dayIso, int startMinute, int endMinute)
    {
        if (!DateTime.TryParse(dayIso, CultureInfo.InvariantCulture, DateTimeStyles.None, out var day)) return;
        var start = day.Date.AddMinutes(startMinute);
        var end = day.Date.AddMinutes(Math.Max(startMinute + 1, endMinute));
        if (OnDateSelect.HasDelegate) await OnDateSelect.InvokeAsync(new SchedulerDateRange(start, end, false));
    }

    private SchedulerEvent? FindEvent(string id) =>
        (Events ?? Enumerable.Empty<SchedulerEvent>()).FirstOrDefault(e => e.Id == id);

    /// <summary>Splits an instance key on its LAST '|' — the ISO-O suffix never contains one, so an event Id that itself contains '|' still round-trips correctly.</summary>
    private static (string EventId, DateTime Start)? ParseInstanceKey(string key)
    {
        var idx = key.LastIndexOf('|');
        if (idx < 0) return null;
        var eventId = key[..idx];
        if (!DateTime.TryParseExact(key[(idx + 1)..], "O", CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var start)) return null;
        return (eventId, start);
    }

    private static (DateTime? Start, DateTime? End, SchedulerEventUpdateSource Source) ComputeCandidate(
        DateTime instanceStart, TimeSpan duration, string mode, string? dayIso, int deltaMinutes)
    {
        var instanceEnd = instanceStart + duration;
        switch (mode)
        {
            case "move":
                if (string.IsNullOrEmpty(dayIso) || !DateTime.TryParse(dayIso, CultureInfo.InvariantCulture, DateTimeStyles.None, out var day))
                    return (null, null, SchedulerEventUpdateSource.Move);
                var newStart = day.Date + instanceStart.TimeOfDay + TimeSpan.FromMinutes(deltaMinutes);
                return (newStart, newStart + duration, SchedulerEventUpdateSource.Move);
            case "resize-start":
                var rsStart = instanceStart + TimeSpan.FromMinutes(deltaMinutes);
                if (rsStart >= instanceEnd) rsStart = instanceEnd.AddMinutes(-15);
                return (rsStart, instanceEnd, SchedulerEventUpdateSource.ResizeStart);
            case "resize-end":
                var reEnd = instanceEnd + TimeSpan.FromMinutes(deltaMinutes);
                if (reEnd <= instanceStart) reEnd = instanceStart.AddMinutes(15);
                return (instanceStart, reEnd, SchedulerEventUpdateSource.ResizeEnd);
            default:
                return (null, null, SchedulerEventUpdateSource.Move);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dragRegistered)
        {
            try { await Interop.SchedulerViewsUnregisterTimeGridDragAsync(_hostRef); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        foreach (var r in _registeredNowIndicatorRefs)
        {
            try { await Interop.SchedulerViewsUnregisterNowIndicatorAsync(r); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }

    private sealed record TimedBlock(SchedulerEventInstance Instance, SchedulerEvent Source, int Column, int ColumnsInCluster);
}
