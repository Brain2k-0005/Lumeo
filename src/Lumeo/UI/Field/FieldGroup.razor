@namespace Lumeo
@* shadcn's FieldGroup: the column that spaces fields apart. Measured live 2026-09-02:
   gap 20px. It is a container-query root so a Responsive Field can switch to a row when
   the GROUP is wide enough, independent of the viewport. *@
<div data-slot="field-group" class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS classes, merged after the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Cx.Merge("group/field-group @container/field-group flex w-full flex-col gap-5", Class);
}
