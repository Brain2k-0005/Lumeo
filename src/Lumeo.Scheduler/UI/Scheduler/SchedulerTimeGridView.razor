@namespace Lumeo
@using System.Globalization
@using Lumeo.SchedulerKernel
@implements IAsyncDisposable
@inject Lumeo.Services.IComponentInteropService Interop
@inject Lumeo.Services.Localization.ILumeoLocalizer L

@* First-party time-grid view (spec §1.1/§1.2/§1.3/§5), shared by Week (Days=7) and Day
   (Days=1) — mirrors the uploaded demo's renderWeek(days) sharing one implementation via a
   `days` parameter (spec §1.1). Consumes SchedulerDateMath for week boundaries,
   SchedulerRecurrenceExpander for occurrence expansion, and SchedulerTimeGridLayout for
   overlapping-event column packing. Internal building block — see SchedulerMonthView's own
   remarks for the "Scheduler.razor is the only component with public parameters" note. *@
<div class="@($"flex flex-col rounded-md border border-border/60 overflow-hidden {Class}".Trim())" @attributes="AdditionalAttributes">
    @* See SchedulerMonthView's own live-region remarks — rendered empty at
       mount so assistive tech is already observing the node. *@
    <span class="sr-only" aria-live="polite" aria-atomic="true"
          data-testid="scheduler-live-region" data-announce-epoch="@_announcementEpoch">@AnnouncementText</span>
    @if (_allDayInstances.Any())
    {
        <div class="flex border-b border-border/60">
            <div class="flex-none w-14 text-[10px] text-muted-foreground pt-1.5 pl-1">@L["Scheduler.AllDay"]</div>
            <div class="flex-1 grid min-w-0" style="grid-template-columns: repeat(@Days, minmax(0, 1fr));">
                @for (var d = 0; d < Days; d++)
                {
                    var dayIndex = d;
                    var laneSlots = dayIndex < _allDayLaneSlots.Length ? _allDayLaneSlots[dayIndex] : Array.Empty<AllDaySlot?>();
                    <div class="border-l border-border/40 p-1 flex flex-col gap-0.5 min-w-0">
                        @for (var lane = 0; lane < laneSlots.Count; lane++)
                        {
                            var slot = laneSlots[lane];
                            if (slot is null)
                            {
                                <div class="h-[19px]" data-lane="@lane" aria-hidden="true"></div>
                            }
                            else
                            {
                                <Tooltip ShowDelay="400" Class="w-full">
                                    <TooltipTrigger AsChild="true">
                                        <ChildContentSlot Context="pillSlot">
                                            <button type="button" class="@AllDayPillClasses(slot)" style="@PillStyle(slot.Source)"
                                                    data-event-id="@slot.Instance.EventId"
                                                    data-lane="@lane"
                                                    @attributes="pillSlot.Attributes"
                                                    @onclick="() => OnEventClickAsync(slot.Source)">
                                                @if (slot.ShowTitle)
                                                {
                                                    @slot.Source.Title
                                                }
                                                else
                                                {
                                                    <span aria-hidden="true">&nbsp;</span>
                                                }
                                            </button>
                                        </ChildContentSlot>
                                    </TooltipTrigger>
                                    <TooltipContent>@TooltipLabel(slot.Source, slot.Instance)</TooltipContent>
                                </Tooltip>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="flex" style="max-height: 34rem; overflow-y: auto;" @ref="_scrollRef">
        <div class="flex-none w-14">
            @foreach (var hour in _hourLabels)
            {
                <div class="h-12 relative">
                    <span class="absolute -top-1.5 right-1.5 text-[11px] text-muted-foreground">@FormatHour(hour)</span>
                </div>
            }
        </div>
        <div class="flex-1 grid min-w-0 relative" role="grid" aria-label="@GridAriaLabel()" style="grid-template-columns: repeat(@Days, minmax(0, 1fr));" @ref="_hostRef">
            @for (var d = 0; d < Days; d++)
            {
                var dayIndex = d;
                var day = _dayColumns[dayIndex];
                <div class="relative border-l border-border/40" role="row" data-daycol="@day.ToString("yyyy-MM-dd")" @ref="_dayColumnRefs[dayIndex]">
                    @for (var h = 0; h < _slotStarts.Length; h++)
                    {
                        var slotIndex = h;
                        var slotStart = _slotStarts[slotIndex];
                        var cellLinear = slotIndex * Days + dayIndex;
                        var isFocused = cellLinear == _focusedIndex;
                        <div role="gridcell"
                             @ref="_cellRefs[cellLinear]"
                             tabindex="@(isFocused ? "0" : "-1")"
                             data-slot-hour="@(slotStart / 60)"
                             data-slot-minute="@slotStart"
                             data-off="@(IsOffSlot(day, slotStart) ? "true" : null)"
                             aria-label="@SlotAriaLabel(day, slotStart)"
                             style="@SlotCellStyle()"
                             class="@SlotCellClasses(slotStart)"
                             @onclick="() => OnSlotClickAsync(day, slotIndex)"
                             @ondblclick="() => OnSlotDoubleClickAsync(day, slotStart)"
                             @onkeydown="e => OnGridKeyDownAsync(e, dayIndex, slotIndex)">
                        </div>
                    }
                    @foreach (var block in _timedByDay[dayIndex])
                    {
                        var key = InstanceKey(block.Instance);
                        var blockHourIndex = SlotIndexOf(block.Instance.Start);
                        <Tooltip ShowDelay="400" Class="static">
                            <TooltipTrigger AsChild="true">
                                <ChildContentSlot Context="pillSlot">
                                    <button type="button"
                                            @ref="_pillRefs[key]"
                                            class="@TimedPillClasses()"
                                            style="@TimedPillStyle(block)"
                                            data-event-instance="@key"
                                            data-event-id="@block.Instance.EventId"
                                            data-resizable="@(Editable ? "true" : null)"
                                            tabindex="-1"
                                            aria-label="@PillAriaLabel(block.Source, block.Instance)"
                                            @attributes="pillSlot.Attributes"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OnEventClickAsync(block.Source)"
                                            @onkeydown="e => OnPillKeyDownAsync(e, block.Source, dayIndex, blockHourIndex)">
                                        <span class="block font-semibold truncate">@block.Source.Title</span>
                                        <span class="block text-[10px] opacity-80">@block.Instance.Start.ToString("t", CultureInfo.CurrentUICulture)</span>
                                    </button>
                                </ChildContentSlot>
                            </TooltipTrigger>
                            <TooltipContent>@TooltipLabel(block.Source, block.Instance)</TooltipContent>
                        </Tooltip>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>The calendar's events (expanded per occurrence internally via <c>SchedulerRecurrenceExpander</c>).</summary>
    [Parameter] public IEnumerable<SchedulerEvent>? Events { get; set; }

    /// <summary>Anchor date. Week mode (<see cref="Days"/> == 7) resolves the containing week via <see cref="FirstDayOfWeek"/>; Day mode (<see cref="Days"/> == 1) shows this date only.</summary>
    [Parameter] public DateTime AnchorDate { get; set; } = DateTime.Today;

    /// <summary>Number of day columns: 7 = Week, 1 = Day (spec §1.1). Any other value renders that many columns starting at <see cref="AnchorDate"/> (wave-3 N-day groundwork, not yet a public view).</summary>
    [Parameter] public int Days { get; set; } = 7;

    [Parameter] public DayOfWeek FirstDayOfWeek { get; set; } = DayOfWeek.Monday;

    /// <summary>Earliest visible slot. Default 00:00. Never changes the underlying wall-clock grid math (spec §2.3) — purely a visible-range clamp.</summary>
    [Parameter] public TimeOnly? SlotMinTime { get; set; }

    /// <summary>Latest visible slot. Default 24:00.</summary>
    [Parameter] public TimeOnly? SlotMaxTime { get; set; }

    /// <summary>
    /// How long one grid row represents. Default (<c>null</c>) is one hour, which is the
    /// grid this view has always drawn.
    /// <para>
    /// Rows have to tile an hour exactly or the labels in the gutter drift away from the
    /// lines they name, so a value that does not divide 60 is rounded UP to the next one
    /// that does (25 minutes becomes 30). Values are clamped to 1..60 minutes.
    /// </para>
    /// </summary>
    [Parameter] public TimeSpan? SlotDuration { get; set; }

    /// <summary>
    /// How far a drag, resize or drag-create snaps. Defaults to <see cref="SlotDuration"/>
    /// when that is set — dragging onto a line the grid does not draw is the kind of
    /// mismatch users read as a bug — and to 15 minutes otherwise, which is what this view
    /// snapped to before the grid was configurable.
    /// </summary>
    [Parameter] public TimeSpan? SnapDuration { get; set; }

    /// <summary>
    /// IANA zone the NOW-INDICATOR is read in. The grid itself stays wall-clock — the wrapper
    /// has already projected the events it hands down (see SchedulerTimeZoneProjection) — but
    /// the now line is computed in the browser from the real clock, so without this it would
    /// sit at the viewer's local time on a grid drawn for somewhere else.
    /// </summary>
    [Parameter] public string? NowTimeZoneId { get; set; }

    /// <summary>
    /// Whether a 7-day grid snaps to the configured week start. True (the default) is the Week
    /// view. False makes seven days mean "seven days from the anchor" — the rolling N-day
    /// window, which happens to collide with the Week view at exactly this one width.
    /// </summary>
    [Parameter] public bool AlignToWeek { get; set; } = true;

    [Parameter] public EventCallback<SchedulerEvent> OnEventClick { get; set; }
    [Parameter] public EventCallback<SchedulerDateRange> OnDateSelect { get; set; }
    [Parameter] public EventCallback OnRequestPrev { get; set; }
    [Parameter] public EventCallback OnRequestNext { get; set; }
    [Parameter] public Func<SchedulerEvent, string?>? ResolveEventColor { get; set; }
    [Parameter] public Func<SchedulerEvent, string?>? ResolveEventClassNames { get; set; }

    /// <summary>Allows events to be dragged (move) and edge-resized. Default true.</summary>
    [Parameter] public bool Editable { get; set; } = true;

    /// <summary>Allows drag-to-create on empty grid background. Default true.</summary>
    [Parameter] public bool Selectable { get; set; } = true;

    /// <summary>Shows the browser-local current-time indicator line (spec §2.2 — positioned and refreshed entirely client-side, never a server-computed value). Default true.</summary>
    [Parameter] public bool NowIndicator { get; set; } = true;

    /// <summary>
    /// Fail-closed validation predicate for a move/resize drop (spec §3.2), widened to a
    /// three-way reject/accept/accept-with-adjustment contract (mirrors ReUI's
    /// <c>onEventUpdate</c>) — see <see cref="SchedulerDropResult"/>. <c>null</c> (default)
    /// means no consumer opted in — JS is told via <c>hasCanDrop: false</c> so zero
    /// <see cref="ValidateDrop"/> interop calls happen per drag, not "always permit".
    /// </summary>
    [Parameter] public Func<SchedulerEvent, SchedulerScheduleDropContext, SchedulerDropResult>? CanDrop { get; set; }

    /// <summary>
    /// Shades non-business-hour slots and non-business days (spec's business-hours regression
    /// fix — the first-party views previously had no equivalent at all, unlike the FullCalendar
    /// wrapper's <c>BusinessHours</c> toggle). Default false (opt-in, matches the wrapper's own
    /// default). Grid interval and snap duration remain out of scope for this pass (still
    /// hardcoded — see the report).
    /// </summary>
    [Parameter] public bool BusinessHours { get; set; }

    /// <summary>Earliest business hour (inclusive) when <see cref="BusinessHours"/> is true. Default 09:00, matching the FullCalendar wrapper's own hardcoded default.</summary>
    [Parameter] public TimeOnly BusinessHoursStart { get; set; } = new(9, 0);

    /// <summary>Latest business hour (exclusive) when <see cref="BusinessHours"/> is true. Default 17:00.</summary>
    [Parameter] public TimeOnly BusinessHoursEnd { get; set; } = new(17, 0);

    /// <summary>Which days of the week count as business days when <see cref="BusinessHours"/> is true. Default Mon–Fri, matching FullCalendar's own hardcoded default.</summary>
    [Parameter] public IReadOnlyList<DayOfWeek>? BusinessDays { get; set; }

    /// <summary>Raised after a move/resize drag commits (post-<see cref="CanDrop"/> validation, ghost already removed).</summary>
    [Parameter] public EventCallback<SchedulerEvent> OnEventChange { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private DateTime[] _dayColumns = Array.Empty<DateTime>();
    /// <summary>Start of each grid row, in minutes from midnight.</summary>
    private int[] _slotStarts = Array.Empty<int>();
    /// <summary>Whole hours covered by the grid — the gutter labels, one per hour regardless of row size.</summary>
    private int[] _hourLabels = Array.Empty<int>();
    private int _slotMinutes = 60;
    private int _minMinute;
    private int _maxMinute = 1440;
    private List<TimedBlock>[] _timedByDay = Array.Empty<List<TimedBlock>>();
    private List<TimedBlock> _allDayInstances = new();
    private IReadOnlyList<AllDaySlot?>[] _allDayLaneSlots = Array.Empty<IReadOnlyList<AllDaySlot?>>();
    private int _focusedIndex;
    private ElementReference _scrollRef;
    private ElementReference _hostRef;
    private ElementReference[] _cellRefs = Array.Empty<ElementReference>();
    private ElementReference[] _dayColumnRefs = Array.Empty<ElementReference>();
    private ElementReference[] _registeredNowIndicatorRefs = Array.Empty<ElementReference>();
    private readonly Dictionary<string, ElementReference> _pillRefs = new(StringComparer.Ordinal);
    private DotNetObjectReference<SchedulerTimeGridView>? _selfRef;
    private bool _dragRegistered;
    private int _lastDragOptionsHash;
    // Nullable so a first-render hash that happens to equal a sentinel value can never
    // be mistaken for "already synced" — mirrors the drag-registration gate's own
    // `_dragRegistered && hash == _lastDragOptionsHash` short-circuit (see
    // SyncDragRegistrationAsync above), just expressed via nullability instead of a
    // separate bool since this sync has no other "have we ever registered" state to hang one off of.
    private int? _lastNowIndicatorHash;

    protected override void OnParametersSet()
    {
        _minMinute = (int)(SlotMinTime?.ToTimeSpan().TotalMinutes ?? 0);
        _maxMinute = (int)(SlotMaxTime?.ToTimeSpan().TotalMinutes ?? 1440);
        if (_maxMinute <= _minMinute) _maxMinute = _minMinute + 60;

        _slotMinutes = NormalizeSlotMinutes(SlotDuration);

        var hourStart = _minMinute / 60;
        var hourEnd = (int)Math.Ceiling(_maxMinute / 60.0);
        _hourLabels = Enumerable.Range(hourStart, Math.Max(1, hourEnd - hourStart)).ToArray();

        // Rows span whole hours even when SlotMinTime/SlotMaxTime fall mid-hour, exactly as
        // the hour grid did — the gutter is still one label per hour, so the body has to
        // start and end on the same boundaries or the two columns shear apart.
        var firstMinute = hourStart * 60;
        var lastMinute = Math.Max(firstMinute + _slotMinutes, hourEnd * 60);
        var slotCount = (lastMinute - firstMinute) / _slotMinutes;
        _slotStarts = Enumerable.Range(0, slotCount).Select(i => firstMinute + i * _slotMinutes).ToArray();

        var days = Math.Max(1, Days);
        if (days == 7 && AlignToWeek)
        {
            var weekStart = SchedulerDateMath.StartOfWeek(AnchorDate, FirstDayOfWeek);
            _dayColumns = Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToArray();
        }
        else
        {
            _dayColumns = Enumerable.Range(0, days).Select(i => AnchorDate.Date.AddDays(i)).ToArray();
        }

        _cellRefs = new ElementReference[_slotStarts.Length * _dayColumns.Length];
        _dayColumnRefs = new ElementReference[_dayColumns.Length];
        if (_focusedIndex < 0 || _focusedIndex >= _cellRefs.Length) _focusedIndex = 0;

        BuildEventLayout();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncDragRegistrationAsync();
        await SyncNowIndicatorAsync();
    }

    private async Task SyncDragRegistrationAsync()
    {
        // Snap belongs in the hash: it is pushed to JS in the drag options, so a caller
        // changing SlotDuration/SnapDuration after first render has to re-register or the
        // grid would draw one interval while dragging at another.
        var hash = HashCode.Combine(Editable, Selectable, CanDrop is not null, EffectiveSnapMinutes());
        if (_dragRegistered && hash == _lastDragOptionsHash) return;
        _lastDragOptionsHash = hash;
        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            await Interop.SchedulerViewsRegisterTimeGridDragAsync(_hostRef, _selfRef, BuildDragOptions());
            _dragRegistered = true;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    private object BuildDragOptions()
    {
        const double pxPerMinute = 48.0 / 60.0;
        return new Dictionary<string, object?>
        {
            ["editable"] = Editable,
            ["selectable"] = Selectable,
            ["allowResize"] = true,
            ["hasCanDrop"] = CanDrop is not null,
            ["pixelsPerMinute"] = pxPerMinute,
            ["snapMinutes"] = EffectiveSnapMinutes(),
            ["slotMinMinute"] = _minMinute,
        };
    }

    private async Task SyncNowIndicatorAsync()
    {
        var hash = HashCode.Combine(NowIndicator, _minMinute, NowTimeZoneId,
                                    string.Join(",", _dayColumns.Select(d => d.ToString("yyyyMMdd"))));
        if (hash == _lastNowIndicatorHash) return;
        _lastNowIndicatorHash = hash;

        foreach (var r in _registeredNowIndicatorRefs)
        {
            try { await Interop.SchedulerViewsUnregisterNowIndicatorAsync(r); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        _registeredNowIndicatorRefs = Array.Empty<ElementReference>();

        if (!NowIndicator) return;

        const double pxPerMinute = 48.0 / 60.0;
        for (var i = 0; i < _dayColumns.Length && i < _dayColumnRefs.Length; i++)
        {
            var options = new Dictionary<string, object?>
            {
                ["pixelsPerMinute"] = pxPerMinute,
                ["slotMinMinute"] = _minMinute,
                ["dayIso"] = _dayColumns[i].ToString("yyyy-MM-dd"),
                ["timeZone"] = NowTimeZoneId,
            };
            try { await Interop.SchedulerViewsRegisterNowIndicatorAsync(_dayColumnRefs[i], options); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        _registeredNowIndicatorRefs = _dayColumnRefs.ToArray();
    }

    private void BuildEventLayout()
    {
        _pillRefs.Clear();
        if (_dayColumns.Length == 0) { _timedByDay = Array.Empty<List<TimedBlock>>(); _allDayInstances = new(); _allDayLaneSlots = Array.Empty<IReadOnlyList<AllDaySlot?>>(); return; }

        var events = (Events ?? Enumerable.Empty<SchedulerEvent>()).ToList();
        var byId = new Dictionary<string, SchedulerEvent>(StringComparer.Ordinal);
        foreach (var ev in events)
            if (!string.IsNullOrEmpty(ev.Id)) byId[ev.Id] = ev;

        var rangeStart = _dayColumns[0];
        var rangeEnd = _dayColumns[^1].AddDays(1);
        var allInstances = SchedulerRecurrenceExpander.ExpandAll(events, rangeStart, rangeEnd)
            .Where(i => byId.ContainsKey(i.EventId))
            .ToList();

        _allDayInstances = allInstances
            .Where(i => byId[i.EventId].AllDay)
            .Select(i => new TimedBlock(i, byId[i.EventId], 0, 1))
            .ToList();
        BuildAllDayLanes();

        var timedByDay = new List<TimedBlock>[_dayColumns.Length];
        for (var d = 0; d < _dayColumns.Length; d++)
        {
            var day = _dayColumns[d];
            var dayInstances = allInstances
                .Where(i => !byId[i.EventId].AllDay && i.Start.Date == day.Date)
                .ToList();

            var packInput = dayInstances
                .Select(i => (Id: InstanceKey(i), StartMinute: (int)i.Start.TimeOfDay.TotalMinutes, EndMinute: Math.Max((int)i.Start.TimeOfDay.TotalMinutes + 1, (int)i.End.TimeOfDay.TotalMinutes)))
                .ToList();
            var packed = SchedulerTimeGridLayout.Pack(packInput);
            var packedById = packed.ToDictionary(p => p.Id, p => (p.Column, p.ColumnsInCluster), StringComparer.Ordinal);

            var blocks = new List<TimedBlock>();
            foreach (var inst in dayInstances)
            {
                var key = InstanceKey(inst);
                var (col, colCount) = packedById.TryGetValue(key, out var v) ? v : (0, 1);
                blocks.Add(new TimedBlock(inst, byId[inst.EventId], col, colCount));
            }
            timedByDay[d] = blocks;
        }
        _timedByDay = timedByDay;
    }

    /// <summary>
    /// Lane-packs the all-day strip via <see cref="SchedulerMonthLayout.PackRow"/> — the SAME
    /// kernel algorithm Month view already uses for its own row continuity (spec's "one engine"
    /// point) — instead of the previous per-day-column independent <c>.Where(...)</c> filter,
    /// whose stacking order silently shifted a multi-day all-day event's vertical position
    /// between day columns (the structural gap the audit found, not previously flagged
    /// anywhere: Month view's rows were lane-packed for continuity, the TimeGrid's own all-day
    /// strip was not).
    /// </summary>
    private void BuildAllDayLanes()
    {
        if (_allDayInstances.Count == 0 || _dayColumns.Length == 0)
        {
            _allDayLaneSlots = Array.Empty<IReadOnlyList<AllDaySlot?>>();
            return;
        }

        var rowStart = _dayColumns[0];
        var packInput = _allDayInstances
            .Select(b => (Id: InstanceKey(b.Instance), StartDate: b.Instance.Start, EndDate: b.Instance.End, AllDay: true))
            .ToList();
        var lanes = SchedulerMonthLayout.PackRow(rowStart, packInput);
        var maxLane = lanes.Count == 0 ? -1 : lanes.Values.Max();
        var laneCount = maxLane + 1;

        var perDay = new IReadOnlyList<AllDaySlot?>[_dayColumns.Length];
        for (var d = 0; d < _dayColumns.Length; d++)
        {
            var day = _dayColumns[d];
            var daySlots = new AllDaySlot?[laneCount];
            foreach (var block in _allDayInstances)
            {
                if (!TouchesDay(block.Instance.Start, block.Instance.End, true, day)) continue;
                var key = InstanceKey(block.Instance);
                if (!lanes.TryGetValue(key, out var lane) || lane >= laneCount) continue;

                var contL = day.Date > block.Instance.Start.Date;
                var contR = day.Date < LastTouchedDate(block.Instance.End, true, block.Instance.Start);
                daySlots[lane] = new AllDaySlot(block.Instance, block.Source, contL, contR, !contL);
            }
            perDay[d] = daySlots;
        }
        _allDayLaneSlots = perDay;
    }

    /// <summary>Whether the row starting <paramref name="startMinute"/> minutes into <paramref name="day"/> falls outside <see cref="BusinessHoursStart"/>/<see cref="BusinessHoursEnd"/>/<see cref="BusinessDays"/> when <see cref="BusinessHours"/> is enabled.</summary>
    private bool IsOffSlot(DateTime day, int startMinute)
    {
        if (!BusinessHours) return false;
        var businessDays = BusinessDays ?? DefaultBusinessDays;
        if (!businessDays.Contains(day.DayOfWeek)) return true;
        var slotStart = MinuteToTimeOnly(startMinute);
        return slotStart < BusinessHoursStart || slotStart >= BusinessHoursEnd;
    }

    private static readonly DayOfWeek[] DefaultBusinessDays =
        { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };

    /// <summary>Hover-tooltip label for an event chip: title + time range (spec §3.4's promised "title, time range, resource" — resource omitted here since neither view resolves a resource DISPLAY NAME, only the raw <see cref="SchedulerEvent.ResourceId"/>; falls back to that id, labelled, when present).</summary>
    private static string TooltipLabel(SchedulerEvent ev, SchedulerEventInstance inst)
    {
        var time = ev.AllDay ? null : $"{inst.Start:t}–{inst.End:t}";
        var parts = new List<string> { ev.Title };
        if (time is not null) parts.Add(time);
        if (!string.IsNullOrEmpty(ev.ResourceId)) parts.Add(ev.ResourceId);
        return string.Join(" · ", parts);
    }

    private static DateTime LastTouchedDate(DateTime end, bool allDay, DateTime start)
    {
        if (!allDay && end.Date == start.Date) return start.Date;
        var last = end.TimeOfDay == TimeSpan.Zero ? end.Date.AddDays(-1) : end.Date;
        return last < start.Date ? start.Date : last;
    }

    private static bool TouchesDay(DateTime start, DateTime end, bool allDay, DateTime day)
    {
        if (!allDay && end.Date == start.Date) return day.Date == start.Date;
        var last = LastTouchedDate(end, allDay, start);
        return day.Date >= start.Date && day.Date <= last;
    }

    private static string InstanceKey(SchedulerEventInstance i) => $"{i.EventId}|{i.Start:O}";

    private static string FormatHour(int hour) => $"{hour % 24:D2}:00";

    private static TimeOnly MinuteToTimeOnly(int minute) => new((minute / 60) % 24, minute % 60);

    private static string FormatMinute(int minute) => $"{(minute / 60) % 24:D2}:{minute % 60:D2}";

    /// <summary>
    /// Row height in pixels. The 0.8px-per-minute scale is the same constant the drag and
    /// now-indicator maths use (48px per hour); deriving the height from it rather than a
    /// fixed class is what keeps a sub-hour grid aligned with the chips drawn on top of it.
    /// </summary>
    private string SlotCellStyle() =>
        string.Create(CultureInfo.InvariantCulture, $"height:{_slotMinutes * PxPerMinute:0.###}px;");

    /// <summary>
    /// Hour boundaries keep the full rule; lines inside an hour are drawn fainter, so a
    /// 15-minute grid still reads as hours at a glance instead of 96 identical stripes.
    /// </summary>
    private string SlotCellClasses(int startMinute)
    {
        // border/20, not a finer step: the opacity utilities are generated per literal, and
        // border-border/15 is not one the bundle carries — an ungenerated class silently
        // leaves border-b on its default colour, which drew the sub-hour lines DARKER than
        // the hour rules instead of fainter. Caught in the browser; the class name alone
        // looked right in the DOM.
        var border = startMinute % 60 == 0 ? "border-border/30" : "border-border/20";
        return $"border-b {border} cursor-crosshair focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring focus-visible:-outline-offset-2";
    }

    /// <summary>
    /// Rounds UP to the next whole-minute divisor of 60 (see <see cref="SlotDuration"/>), so
    /// every configured grid tiles an hour exactly.
    /// </summary>
    private static int NormalizeSlotMinutes(TimeSpan? requested)
    {
        if (requested is not { } span) return 60;
        var minutes = (int)Math.Round(span.TotalMinutes);
        if (minutes <= 1) return 1;
        if (minutes >= 60) return 60;
        foreach (var divisor in SupportedSlotMinutes)
        {
            if (divisor >= minutes) return divisor;
        }
        return 60;
    }

    private static readonly int[] SupportedSlotMinutes = { 1, 2, 3, 4, 5, 6, 10, 12, 15, 20, 30, 60 };

    private const double PxPerMinute = 48.0 / 60.0;

    /// <summary>Drag/resize/create granularity — see <see cref="SnapDuration"/> for why it follows the grid.</summary>
    private int EffectiveSnapMinutes()
    {
        if (SnapDuration is { } snap)
        {
            var minutes = (int)Math.Round(snap.TotalMinutes);
            return Math.Clamp(minutes, 1, 60);
        }
        return SlotDuration is null ? 15 : _slotMinutes;
    }

    private string GridAriaLabel() => Days == 1 ? L["Scheduler.Day"] : L["Scheduler.Week"];

    private string SlotAriaLabel(DateTime day, int startMinute) =>
        $"{day.ToString("D", CultureInfo.CurrentUICulture)}, {FormatMinute(startMinute)}";

    private static string PillAriaLabel(SchedulerEvent ev, SchedulerEventInstance inst) =>
        $"{ev.Title}, {inst.Start:t}–{inst.End:t}";

    private string AllDayPillClasses(AllDaySlot slot)
    {
        var classes = "block w-full text-left text-[11px] font-medium px-1.5 py-0.5 rounded truncate border-0 cursor-pointer";
        if (slot.ContL) classes += " rounded-l-none";
        if (slot.ContR) classes += " rounded-r-none";
        var extra = ResolveEventClassNames?.Invoke(slot.Source);
        if (!string.IsNullOrEmpty(extra)) classes += " " + extra;
        return classes;
    }

    private static string TimedPillClasses() =>
        "absolute rounded-md overflow-hidden text-left text-[11px] leading-tight px-1.5 py-0.5 border-l-4 cursor-pointer select-none";

    private string PillStyle(SchedulerEvent ev)
    {
        var color = ResolveEventColor?.Invoke(ev) ?? ev.Color ?? "var(--color-primary)";
        return $"background-color: color-mix(in oklab, {color} 18%, transparent); color: color-mix(in oklab, {color} 38%, var(--lumeo-event-fg-anchor));";
    }

    private string TimedPillStyle(TimedBlock block)
    {
        var color = ResolveEventColor?.Invoke(block.Source) ?? block.Source.Color ?? "var(--color-primary)";
        var startMinute = Math.Clamp((int)block.Instance.Start.TimeOfDay.TotalMinutes, _minMinute, _maxMinute);
        var rawEndMinute = (int)block.Instance.End.TimeOfDay.TotalMinutes;
        if (rawEndMinute <= startMinute) rawEndMinute = startMinute + 15;
        var endMinute = Math.Clamp(rawEndMinute, _minMinute, _maxMinute);
        const double pxPerMinute = 48.0 / 60.0;
        var top = (startMinute - _minMinute) * pxPerMinute;
        var height = Math.Max(16, (endMinute - startMinute) * pxPerMinute);
        var width = 100.0 / block.ColumnsInCluster;
        var left = block.Column * width;
        return $"top:{top.ToString(CultureInfo.InvariantCulture)}px; height:{height.ToString(CultureInfo.InvariantCulture)}px; left:calc({left.ToString(CultureInfo.InvariantCulture)}% + 2px); width:calc({width.ToString(CultureInfo.InvariantCulture)}% - 4px); background-color: color-mix(in oklab, {color} 18%, transparent); color: color-mix(in oklab, {color} 38%, var(--lumeo-event-fg-anchor)); border-left-color: {color};";
    }

    // ── Interaction ──────────────────────────────────────────────────────

    private async Task OnEventClickAsync(SchedulerEvent ev)
    {
        if (OnEventClick.HasDelegate) await OnEventClick.InvokeAsync(ev);
    }

    /// <summary>
    /// Takes the ROW INDEX, not the hour: <see cref="LinearIndex"/> indexes into
    /// <see cref="_slotStarts"/>, so passing a clock hour put the roving tabindex on the
    /// wrong cell whenever SlotMinTime moved the grid off midnight.
    /// </summary>
    private void OnSlotClickAsync(DateTime day, int slotIndex)
    {
        _focusedIndex = LinearIndex(Array.IndexOf(_dayColumns, day), slotIndex);
    }

    private async Task OnSlotDoubleClickAsync(DateTime day, int startMinute)
    {
        if (!OnDateSelect.HasDelegate) return;
        var start = day.Date.AddMinutes(startMinute);
        // 30 minutes stays the default so the out-of-the-box behaviour is unchanged; once a
        // caller has asked for a specific grid, the row they clicked is the obvious range.
        var length = SlotDuration is null ? 30 : _slotMinutes;
        await OnDateSelect.InvokeAsync(new SchedulerDateRange(start, start.AddMinutes(length), false));
    }

    private async Task OnPillKeyDownAsync(KeyboardEventArgs e, SchedulerEvent ev, int dayIndex, int hourIndex)
    {
        if (e.Key is "Enter" or " ")
        {
            await OnEventClickAsync(ev);
        }
        else if (e.Key == "Escape")
        {
            var idx = LinearIndex(dayIndex, hourIndex);
            _focusedIndex = idx;
            await FocusCellAsync(idx);
        }
    }

    private int LinearIndex(int dayIndex, int hourIndex) => hourIndex * _dayColumns.Length + dayIndex;

    /// <summary>The row <paramref name="instant"/> falls in — the LAST row that starts at or before it, since an instant rarely lands exactly on a boundary once rows are shorter than an hour.</summary>
    private int SlotIndexOf(DateTime instant)
    {
        var minute = (int)instant.TimeOfDay.TotalMinutes;
        var best = 0;
        for (var i = 0; i < _slotStarts.Length; i++)
        {
            if (_slotStarts[i] > minute) break;
            best = i;
        }
        return best;
    }

    /// <summary>Roving-tabindex 2-D grid navigation (spec §5.2's Week/Day column).</summary>
    private async Task OnGridKeyDownAsync(KeyboardEventArgs e, int dayIndex, int hourIndex)
    {
        var current = LinearIndex(dayIndex, hourIndex);
        _focusedIndex = current;
        int nextDay = dayIndex, nextHour = hourIndex;
        switch (e.Key)
        {
            case "ArrowRight": nextDay = Math.Min(_dayColumns.Length - 1, dayIndex + 1); break;
            case "ArrowLeft": nextDay = Math.Max(0, dayIndex - 1); break;
            case "ArrowDown": nextHour = Math.Min(_slotStarts.Length - 1, hourIndex + 1); break;
            case "ArrowUp": nextHour = Math.Max(0, hourIndex - 1); break;
            case "Home": nextHour = 0; break;
            case "End": nextHour = _slotStarts.Length - 1; break;
            case "PageUp":
                if (OnRequestPrev.HasDelegate) await OnRequestPrev.InvokeAsync();
                return;
            case "PageDown":
                if (OnRequestNext.HasDelegate) await OnRequestNext.InvokeAsync();
                return;
            case "Enter":
            case " ":
                await ActivateFocusedSlotAsync(dayIndex, hourIndex);
                return;
            default:
                return;
        }

        var next = LinearIndex(nextDay, nextHour);
        if (next != current)
        {
            _focusedIndex = next;
            await FocusCellAsync(next);
        }
    }

    private async Task ActivateFocusedSlotAsync(int dayIndex, int hourIndex)
    {
        var slotStart = _slotStarts[hourIndex];
        var slotEnd = slotStart + _slotMinutes;
        var block = _timedByDay.Length > dayIndex
            ? _timedByDay[dayIndex].FirstOrDefault(b =>
            {
                var m = (int)b.Instance.Start.TimeOfDay.TotalMinutes;
                return m >= slotStart && m < slotEnd;
            })
            : null;
        if (block is not null)
        {
            var key = InstanceKey(block.Instance);
            if (_pillRefs.TryGetValue(key, out var pillRef))
            {
                try { await pillRef.FocusAsync(); }
                catch (Microsoft.JSInterop.JSDisconnectedException) { }
            }
        }
        else
        {
            await OnSlotDoubleClickAsync(_dayColumns[dayIndex], slotStart);
        }
    }

    private async Task FocusCellAsync(int index)
    {
        try { await _cellRefs[index].FocusAsync(); }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    // ── Drag/resize/create (spec §3.1-§3.4) ────────────────────────────────
    // Ghost-only: JS never mutates the real chip (data-event-instance element) during a
    // drag — only a cloned ghost moves (scheduler-views.js's makeGhost). Fail-closed:
    // ValidateDrop is awaited by JS BEFORE CommitDrag/CommitCreate is ever invoked; any
    // rejected/thrown invocation resolves to `false` on the JS side (.catch(() => false)),
    // never `true`. See scheduler-views.js's own header comment for the full argument.

    /// <summary>
    /// [JSInvokable] fail-closed CanDrop check for a move/resize candidate. Returns
    /// <c>false</c> (never permits) for any input JS shouldn't have been able to produce
    /// (unknown instance key, malformed mode) — an unrecognized shape is not evidence of
    /// permission, only of something already gone wrong upstream. Only the
    /// <see cref="SchedulerDropResult.Accepted"/> half of the three-way verdict crosses the JS
    /// boundary here — the visual ghost only needs accept/reject;
    /// <see cref="SchedulerDropResult.Adjustment"/> is applied once, authoritatively, in
    /// <see cref="CommitDrag"/>.
    /// </summary>
    [JSInvokable]
    public bool ValidateDrop(string instanceKey, string mode, string? dayIso, int deltaMinutes)
    {
        if (CanDrop is null) return true;
        var parsed = ParseInstanceKey(instanceKey);
        if (parsed is not { } p) return false;
        var src = FindEvent(p.EventId);
        if (src is null) return false;
        var (newStart, newEnd, source) = ComputeCandidate(p.Start, src.End - src.Start, mode, dayIso, deltaMinutes);
        if (newStart is null || newEnd is null) return false;
        return CanDrop(src, new SchedulerScheduleDropContext(newStart.Value, newEnd.Value, source)).Accepted;
    }

    [JSInvokable]
    public async Task CommitDrag(string instanceKey, string mode, string? dayIso, int deltaMinutes)
    {
        var parsed = ParseInstanceKey(instanceKey);
        if (parsed is not { } p) return;
        var src = FindEvent(p.EventId);
        if (src is null) return;
        var (newStart, newEnd, source) = ComputeCandidate(p.Start, src.End - src.Start, mode, dayIso, deltaMinutes);
        if (newStart is null || newEnd is null || newStart == src.Start && newEnd == src.End) return;
        var finalStart = newStart.Value;
        var finalEnd = newEnd.Value;
        var finalAllDay = src.AllDay;

        // Re-validate at commit time — same reasoning as SchedulerMonthView.CommitDrag: this is
        // the only place a SchedulerDropResult.Adjustment can be applied (ValidateDrop only
        // surfaces Accepted over the JS boundary), and it closes the staleness gap where JS's
        // last cached ValidateDrop poll could otherwise be trusted without a final re-check.
        if (CanDrop is not null)
        {
            var ctx = new SchedulerScheduleDropContext(finalStart, finalEnd, source);
            var result = CanDrop(src, ctx);
            // See SchedulerMonthView's twin: the ordinary rejection is handled
            // in NotifyDropRejected, but the commit-time staleness rejection
            // lands HERE and would otherwise be silent. `source` already carries
            // the gesture kind, so a refused resize keeps its own wording.
            if (!result.Accepted)
            {
                var stale = source is SchedulerEventUpdateSource.ResizeStart or SchedulerEventUpdateSource.ResizeEnd;
                Announce(L[stale ? "Scheduler.Announce.ResizeRejected" : "Scheduler.Announce.MoveRejected", src.Title]);
                return;
            }
            if (result.Adjustment is { } adjustment)
            {
                finalStart = adjustment.Start ?? finalStart;
                finalEnd = adjustment.End ?? finalEnd;
                finalAllDay = adjustment.AllDay ?? finalAllDay;
            }
        }

        var updated = src with { Start = finalStart, End = finalEnd, AllDay = finalAllDay };
        // Announced from the COMMITTED values, after any CanDrop adjustment —
        // and with TIMES, not just the date: in a time grid the times are the
        // whole point of the gesture. Covers resize as well as move, which is
        // why the wording is "now <start> to <end>" rather than "moved to".
        // Gated on OnEventChange (Codex review of this PR, P2): with no handler
        // the gesture is ghost-only and the real block snaps back, so announcing
        // a reschedule would describe something that did not persist.
        // A CanDrop adjustment can snap the event back to exactly where it
        // started; the earlier no-op check ran against the PROPOSED values,
        // not these (Codex review of this PR, P2). Announcing a move for an
        // unchanged event states something that did not happen.
        if (updated.Start == src.Start && updated.End == src.End && updated.AllDay == src.AllDay) return;
        if (!OnEventChange.HasDelegate) return;
        // See SchedulerMonthView's twin: announce only once the handler
        // has completed, so a faulted persist cannot be heard as success.
        await OnEventChange.InvokeAsync(updated);
        Announce(L["Scheduler.Announce.EventRescheduled",
            src.Title, FormatAnnounceMoment(updated.Start), FormatAnnounceMoment(updated.End)]);
    }

    // ── Live-region announcements (ReUI parity) ──────────────────────────────
    // See SchedulerMonthView's own remarks — same house pattern (Carousel.razor),
    // same reason: these views shipped with no aria-live region at all.

    /// <summary>
    /// [JSInvokable] counterpart to <see cref="SchedulerMonthView.NotifyDropRejected"/> — see its
    /// remarks. <paramref name="mode"/> carries the gesture kind so a refused RESIZE is not
    /// announced as a refused move (Codex review of this PR, P2).
    /// </summary>
    [JSInvokable]
    public void NotifyDropRejected(string instanceKey, string? mode)
    {
        // Same instanceKey -> event resolution CommitDrag performs.
        var title = ParseInstanceKey(instanceKey) is { } p ? FindEvent(p.EventId)?.Title ?? string.Empty : string.Empty;
        var isResize = mode is not null && mode.StartsWith("resize", StringComparison.OrdinalIgnoreCase);
        Announce(L[isResize ? "Scheduler.Announce.ResizeRejected" : "Scheduler.Announce.MoveRejected", title]);
    }

    private string? _announcement;
    private int _announcementEpoch;

    /// <summary>
    /// See <see cref="SchedulerMonthView"/>'s twin: the region element stays
    /// MOUNTED and only its text changes, with a zero-width space alternating so
    /// a repeated identical message is still a text mutation.
    /// </summary>
    private string? AnnouncementText =>
        _announcement is null ? null : _announcementEpoch % 2 == 0 ? _announcement : _announcement + ZeroWidthSpace;

    /// <summary>
    /// U+200B. Named rather than written literally: an invisible character in
    /// source is unreadable and easy to delete by accident.
    /// </summary>
    private const string ZeroWidthSpace = "​";

    private void Announce(string message)
    {
        _announcementEpoch++;
        _announcement = message;
        StateHasChanged();
    }

    /// <summary>Date + time of day, spelled out — an announcement is heard without the grid for context.</summary>
    private static string FormatAnnounceMoment(DateTime value) =>
        value.ToString("f", CultureInfo.CurrentUICulture);

    [JSInvokable]
    public async Task CommitCreate(string dayIso, int startMinute, int endMinute)
    {
        if (!DateTime.TryParse(dayIso, CultureInfo.InvariantCulture, DateTimeStyles.None, out var day)) return;
        var start = day.Date.AddMinutes(startMinute);
        var end = day.Date.AddMinutes(Math.Max(startMinute + 1, endMinute));
        if (OnDateSelect.HasDelegate) await OnDateSelect.InvokeAsync(new SchedulerDateRange(start, end, false));
    }

    private SchedulerEvent? FindEvent(string id) =>
        (Events ?? Enumerable.Empty<SchedulerEvent>()).FirstOrDefault(e => e.Id == id);

    /// <summary>Splits an instance key on its LAST '|' — the ISO-O suffix never contains one, so an event Id that itself contains '|' still round-trips correctly.</summary>
    private static (string EventId, DateTime Start)? ParseInstanceKey(string key)
    {
        var idx = key.LastIndexOf('|');
        if (idx < 0) return null;
        var eventId = key[..idx];
        if (!DateTime.TryParseExact(key[(idx + 1)..], "O", CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var start)) return null;
        return (eventId, start);
    }

    private static (DateTime? Start, DateTime? End, SchedulerEventUpdateSource Source) ComputeCandidate(
        DateTime instanceStart, TimeSpan duration, string mode, string? dayIso, int deltaMinutes)
    {
        var instanceEnd = instanceStart + duration;
        switch (mode)
        {
            case "move":
                if (string.IsNullOrEmpty(dayIso) || !DateTime.TryParse(dayIso, CultureInfo.InvariantCulture, DateTimeStyles.None, out var day))
                    return (null, null, SchedulerEventUpdateSource.Move);
                var newStart = day.Date + instanceStart.TimeOfDay + TimeSpan.FromMinutes(deltaMinutes);
                return (newStart, newStart + duration, SchedulerEventUpdateSource.Move);
            case "resize-start":
                var rsStart = instanceStart + TimeSpan.FromMinutes(deltaMinutes);
                if (rsStart >= instanceEnd) rsStart = instanceEnd.AddMinutes(-15);
                return (rsStart, instanceEnd, SchedulerEventUpdateSource.ResizeStart);
            case "resize-end":
                var reEnd = instanceEnd + TimeSpan.FromMinutes(deltaMinutes);
                if (reEnd <= instanceStart) reEnd = instanceStart.AddMinutes(15);
                return (instanceStart, reEnd, SchedulerEventUpdateSource.ResizeEnd);
            default:
                return (null, null, SchedulerEventUpdateSource.Move);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dragRegistered)
        {
            try { await Interop.SchedulerViewsUnregisterTimeGridDragAsync(_hostRef); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        foreach (var r in _registeredNowIndicatorRefs)
        {
            try { await Interop.SchedulerViewsUnregisterNowIndicatorAsync(r); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }

    private sealed record TimedBlock(SchedulerEventInstance Instance, SchedulerEvent Source, int Column, int ColumnsInCluster);

    /// <summary>An all-day strip lane slot — mirrors <c>SchedulerMonthView.PillSlot</c>'s continuation-styling shape (spec's "one engine" point, §1's structural fix).</summary>
    private sealed record AllDaySlot(SchedulerEventInstance Instance, SchedulerEvent Source, bool ContL, bool ContR, bool ShowTitle);
}
