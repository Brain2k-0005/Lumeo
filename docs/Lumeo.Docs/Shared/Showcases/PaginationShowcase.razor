@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Pagination>
        <PaginationContent>
            <PaginationPrevious OnClick="@(() => Go(_page - 1))" Disabled="@(_page <= 1)" />
            @for (var i = 1; i <= 5; i++)
            {
                var pageNum = i;
                <PaginationItem IsActive="@(pageNum == _page)" OnClick="@(() => Go(pageNum))">
                    @pageNum
                </PaginationItem>
            }
            <PaginationNext OnClick="@(() => Go(_page + 1))" Disabled="@(_page >= 5)" />
        </PaginationContent>
    </Pagination>
</div>

@code {
    private int _page = 1;
    private void Go(int page) => _page = Math.Clamp(page, 1, 5);
}
