        new("ac0797b0-7e31-43b6-a494-da7e2ab43445", "text-babbage-001", "Capable of straightforward tasks, very fast, and lower cost.", "GPT-3", "Moderate classification, semantic search"),
        new("be638fb1-973b-4471-a49c-290325085802", "text-ada-001", "Capable of very simple tasks, usually the fastest model in the GPT-3 series, and lowest cost.", "GPT-3", "Parsing text, simple classification, address correction, keywords"),
        new("b43c0ea9-5ad4-456a-ae29-26cd77b6d0fb", "code-davinci-002", "Most capable Codex model. Particularly good at translating natural language to code. In addition to completing code, also supports inserting completions within code.", "Codex"),
