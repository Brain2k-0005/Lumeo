@namespace Lumeo.Docs.Shared.Showcases

@* Real component end to end (fix round 1): HoverCardContent is positioned through
   Interop.PositionFixed and escapes the card's overflow-hidden (README rule 4). The
   trigger opens on real hover/focus (and also toggles-pin on click), exactly like
   anywhere else in the app. *@
<div class="w-full max-w-[22rem]">
    <HoverCard>
        <HoverCardTrigger>
            <Button Variant="Button.ButtonVariant.Link">@@blazor</Button>
        </HoverCardTrigger>
        <HoverCardContent>
            <Stack Gap="1">
                <Heading Level="4" Size="sm" Weight="semibold">@@blazor</Heading>
                <Lumeo.Text Size="sm" Color="muted">
                    A free and open-source web framework for building interactive web UIs using C#.
                </Lumeo.Text>
                <Lumeo.Text Size="xs" Color="muted" Class="pt-2">Joined December 2018</Lumeo.Text>
            </Stack>
        </HoverCardContent>
    </HoverCard>
</div>
