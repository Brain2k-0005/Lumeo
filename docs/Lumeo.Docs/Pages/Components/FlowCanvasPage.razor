            @if (ctx.Node.Type != ""trigger"")
            {
                <FlowHandle Type=""FlowHandleType.Target"" Position=""FlowPosition.Left"" />
            }
            @ctx.Node.Data
            <FlowHandle Type=""FlowHandleType.Source"" Position=""FlowPosition.Right"" />
        </div>
    </NodeTemplate>
</FlowCanvas>

@code {
    // A trigger card renders no target handle, but IsValidConnection is the real gate: it also
    // rejects a connection dragged onto one from elsewhere (e.g. a custom node without that check).
    private bool ValidateConnection(FlowConnection c)
        => _nodes.FirstOrDefault(n => n.Id == c.Target)?.Type != ""trigger"";
}";

