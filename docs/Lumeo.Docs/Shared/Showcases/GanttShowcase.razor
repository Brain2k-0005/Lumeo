@namespace Lumeo.Docs.Shared.Showcases
@using Lumeo

@* LIVE (see ../README.md): SatelliteBoundShowcase now lazy-loads Lumeo.Gantt.dll
   (ShowcaseResolver.SatelliteAssembliesFor) before this mounts, so the legacy SVG engine no
   longer needs the real-viewport room the old static replica's comment described. The
   component's own view-mode/prev-next toolbar is built in (no way to hide it), so the box is
   a little taller than the other live showcases to give the day grid below it real room; a
   compact three-task, three-day window still fits without an inner scrollbar. Fixed dates (no
   DateTime.Now, per rule 1). Interactive: the real toolbar works (switch Day/Week/Month/Year),
   and a bar can be dragged to reschedule it. *@

<div class="w-full max-w-[22rem] h-40 rounded-md border border-border/60 overflow-hidden bg-background">
    <Gantt Tasks="_tasks" ViewMode="GanttViewMode.Day" Height="160px" ColumnWidth="18" />
</div>

@code {
    private readonly List<GanttTask> _tasks =
    [
        new("design", "Design", new DateTime(2026, 3, 2), new DateTime(2026, 3, 4), 100),
        new("build", "Build", new DateTime(2026, 3, 4), new DateTime(2026, 3, 7), 45, Dependencies: new[] { "design" }),
        new("launch", "Launch", new DateTime(2026, 3, 7), new DateTime(2026, 3, 7), 0, IsMilestone: true, Dependencies: new[] { "build" }),
    ];
}
