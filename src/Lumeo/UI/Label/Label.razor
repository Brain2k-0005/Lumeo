@namespace Lumeo

<label for="@For" class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</label>

@code {
    /// <summary>The label text/markup.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Id of the form control this label describes. Rendered as the
    /// native <c>for</c> attribute so clicking/focusing the label activates the control.</summary>
    [Parameter] public string? For { get; set; }

    /// <summary>Additional CSS classes merged onto the <c>&lt;label&gt;</c> element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Captures unmatched attributes and applies them to the <c>&lt;label&gt;</c> element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // shadcn's label is a flex row with a gap, which is what spaces a label from the
    // control it wraps - a checkbox or radio beside its text. Consequence worth knowing:
    // text-* alignment no longer positions a shrink-wrapped child, because the child is a
    // flex item pinned to main-start. A consumer aligning a label within a wider column
    // needs justify-*, which is what FormField's horizontal orientation now passes.
    private string CssClass => Cx.Merge("flex items-center gap-2 text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70", Class);
}
