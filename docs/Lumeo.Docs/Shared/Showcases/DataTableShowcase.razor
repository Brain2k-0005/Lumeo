@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <DataTable Items="_payments" Context="payment">
        <HeaderTemplate>
            <th class="h-8 px-3 text-left align-middle text-xs font-medium text-muted-foreground">Status</th>
            <th class="h-8 px-3 text-left align-middle text-xs font-medium text-muted-foreground">Email</th>
        </HeaderTemplate>
        <RowTemplate>
            <td class="p-2 px-3 align-middle">
                <Badge Size="Lumeo.Size.Sm" Variant="@(payment.Status == "Success" ? Badge.BadgeVariant.Success : Badge.BadgeVariant.Warning)">
                    @payment.Status
                </Badge>
            </td>
            <td class="p-2 px-3 align-middle text-xs text-foreground">@payment.Email</td>
        </RowTemplate>
    </DataTable>
</div>

@code {
    private record Payment(string Status, string Email);

    private readonly Payment[] _payments =
    {
        new("Success", "ken@example.com"),
        new("Pending", "abe@example.com"),
        new("Success", "mira@example.com"),
    };
}
