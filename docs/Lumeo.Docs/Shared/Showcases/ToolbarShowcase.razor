@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Toolbar>
        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Sm">
            <DynamicIcon Name="Bold" Class="h-4 w-4" />
        </Button>
        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Sm">
            <DynamicIcon Name="Italic" Class="h-4 w-4" />
        </Button>
        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Sm">
            <DynamicIcon Name="Underline" Class="h-4 w-4" />
        </Button>
        <ToolbarSeparator />
        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Sm">
            <DynamicIcon Name="AlignLeft" Class="h-4 w-4" />
        </Button>
        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Sm">
            <DynamicIcon Name="AlignCenter" Class="h-4 w-4" />
        </Button>
    </Toolbar>
</div>
