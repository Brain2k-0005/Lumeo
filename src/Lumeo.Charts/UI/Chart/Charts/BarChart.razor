@namespace Lumeo
@inject Lumeo.Services.Localization.ILumeoLocalizer L

<Chart Option="@_option" Width="@Width" Height="@Height" Theme="@Theme" Class="@Class" IsLoading="@IsLoading" ShowLoadingSkeleton="@ShowLoadingSkeleton" SkeletonKind="@SkeletonKind" SkeletonStyle="@SkeletonStyle" ShowLoadingLabel="@ShowLoadingLabel" LoadingText="@EffectiveLoadingText" PhantomCycleMs="@PhantomCycleMs" ChildContent="@ChildContent" @attributes="AdditionalAttributes" />

@code {
    /// <summary>Category labels along the axis, one per data point; series values are matched to these by index.</summary>
    [Parameter] public List<string> Categories { get; set; } = new();
    /// <summary>The series to plot, each with a name and its list of values aligned to <see cref="Categories"/> by index.</summary>
    [Parameter] public List<ChartSeriesData> Series { get; set; } = new();
    /// <summary>When true, renders horizontal bars (categories on the Y-axis) instead of vertical columns.</summary>
    [Parameter] public bool Horizontal { get; set; }
    /// <summary>When true, stacks each series on top of the previous one instead of overlaying them independently.</summary>
    [Parameter] public bool Stacked { get; set; }
    /// <summary>When true (default), renders a legend listing each series/segment name.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;
    /// <summary>When true (default), shows a tooltip with the value(s) under the cursor on hover.</summary>
    [Parameter] public bool ShowTooltip { get; set; } = true;
    /// <summary>Explicit colors, in series/segment order. Falls back to the active theme's chart palette when not set and <see cref="ColorPalette"/> is not set.</summary>
    [Parameter] public List<string>? Colors { get; set; }
    /// <summary>CSS width of the chart container. Defaults to <c>100%</c>.</summary>
    [Parameter] public string Width { get; set; } = "100%";
    /// <summary>CSS height of the chart container. Defaults to <c>350px</c>.</summary>
    [Parameter] public string Height { get; set; } = "350px";
    /// <summary>ECharts theme name (or registered custom theme) applied to the chart. Falls back to the library default when not set.</summary>
    [Parameter] public string? Theme { get; set; }
    /// <summary>Additional CSS class(es) applied to the chart's root element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Declarative annotation children — <see cref="ChartThreshold"/> and
    /// <see cref="ChartReferenceZone"/>. Forwarded to the underlying <see cref="Chart"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Additional HTML attributes captured and forwarded to the chart's root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    /// <summary>When true, overlays a shape-aware loading skeleton on top of the chart (consumer is fetching data). Flips back to the real chart once set to false.</summary>
    [Parameter] public bool IsLoading { get; set; }
    /// <summary>When true (default), renders a shape-aware skeleton while the chart has not yet mounted and whenever <see cref="IsLoading"/> is true. Set to <c>false</c> to opt out.</summary>
    [Parameter] public bool ShowLoadingSkeleton { get; set; } = true;
    /// <summary>Shape family for the loading skeleton. Defaults to <c>ChartSkeletonKind.Bars</c> for this chart type; override if you want a different silhouette.</summary>
    [Parameter] public ChartSkeletonKind SkeletonKind { get; set; } = ChartSkeletonKind.Bars;
    /// <summary>Phantom (default) renders the real chart with placeholder data and morphs to real data via ECharts' option-change animation. Silhouette falls back to the legacy SVG skeleton overlay.</summary>
    [Parameter] public ChartSkeletonStyle SkeletonStyle { get; set; } = ChartSkeletonStyle.Phantom;
    /// <summary>Phantom-mode refresh interval in milliseconds. Lower = faster data cycling while loading. Defaults to 1400.</summary>
    [Parameter] public int PhantomCycleMs { get; set; } = 1400;
    /// <summary>When true (default), shows a small "Loading…" pill in the top-right corner whenever <see cref="IsLoading"/> is active. Works on top of any <see cref="SkeletonStyle"/>.</summary>
    [Parameter] public bool ShowLoadingLabel { get; set; } = true;
    /// <summary>Label rendered next to the spinner inside the loading pill. Set to empty to hide. Defaults to "Loading…".</summary>
    [Parameter] public string? LoadingText { get; set; }
    private string EffectiveLoadingText => LoadingText ?? L["Chart.Loading"];

    /// <summary>When true, renders a label with each data point's value directly on the chart.</summary>
    [Parameter] public bool ShowDataLabels { get; set; }
    /// <summary>Placement of the value label relative to its data point (e.g. <c>top</c>, <c>inside</c>). Only applies when <see cref="ShowDataLabels"/> is true.</summary>
    [Parameter] public string LabelPosition { get; set; } = "top";
    /// <summary>ECharts label formatter string/template applied to the value labels (e.g. <c>{c}%</c>). Only applies when <see cref="ShowDataLabels"/> is true.</summary>
    [Parameter] public string? LabelFormat { get; set; }

    /// <summary>Controls how category-axis labels are rendered.
    /// <list type="bullet">
    ///   <item><c>Smart</c> (default): show every label; auto-rotate -30° at 11–16 categories, -60° at 17–24, -75° above 24.</item>
    ///   <item><c>ShowAll</c>: force every label with no rotation (may overlap on dense datasets).</item>
    ///   <item><c>Auto</c>: let ECharts auto-thin labels that would overlap (original ECharts default — hides every second label when crowded).</item>
    /// </list>
    /// </summary>
    [Parameter] public ChartLabelStrategy LabelStrategy { get; set; } = ChartLabelStrategy.Smart;

    /// <summary>Manual override for category-label rotation in degrees (e.g. -30, -45). When set,
    /// takes precedence over the rotation implied by <see cref="LabelStrategy"/>.</summary>
    [Parameter] public int? LabelRotate { get; set; }

    /// <summary>Back-compat alias for <see cref="ChartLabelStrategy"/>. The enum was
    /// originally defined per-chart as <c>BarChart.BarLabelStrategy</c>; it now lives
    /// in the shared <see cref="ChartLabelHelper"/>. Existing references continue to
    /// compile via this alias.</summary>
    public enum BarLabelStrategy
    {
        Smart = ChartLabelStrategy.Smart,
        ShowAll = ChartLabelStrategy.ShowAll,
        Auto = ChartLabelStrategy.Auto,
    }
    /// <summary>When true, adds a zoom/pan slider (plus inside wheel-zoom) so users can navigate large datasets.</summary>
    [Parameter] public bool DataZoom { get; set; }
    /// <summary>When true, shows the ECharts toolbox (save-as-image, restore, data-zoom) in the corner of the chart.</summary>
    [Parameter] public bool Toolbox { get; set; }
    /// <summary>Explicit ordered color palette applied to the chart's series/segments; takes precedence over <see cref="Colors"/> when both are set.</summary>
    [Parameter] public List<string>? ColorPalette { get; set; }
    /// <summary>Duration (in milliseconds) of the chart's entrance/update animation. Uses ECharts' default when not set.</summary>
    [Parameter] public int? AnimationDuration { get; set; }
    /// <summary>ECharts easing function name (e.g. <c>cubicOut</c>) used for the chart's entrance/update animation.</summary>
    [Parameter] public string? AnimationEasing { get; set; }
    /// <summary>Optional mark-line configuration (e.g. average/threshold lines) applied to the first series.</summary>
    [Parameter] public EChartMarkLine? MarkLine { get; set; }
    /// <summary>Optional mark-point configuration (e.g. max/min markers) applied to the first series.</summary>
    [Parameter] public EChartMarkPoint? MarkPoint { get; set; }
    /// <summary>Optional mark-area configuration (e.g. shaded threshold bands) applied to the first series.</summary>
    [Parameter] public EChartMarkArea? MarkArea { get; set; }
    /// <summary>Raw ECharts option fragment merged over the generated option after all other parameters are applied — an escape hatch for options this component doesn't expose directly.</summary>
    [Parameter] public Dictionary<string, object>? OptionOverride { get; set; }

    private EChartOption _option = new();

    protected override void OnParametersSet()
    {
        var categoryAxis = new EChartAxis { Type = "category", Data = Categories };
        ChartLabelHelper.ApplyTo(categoryAxis, LabelStrategy, Categories.Count, LabelRotate);
        // Bar-only: no axis line, no ticks (the shared theme already turns those off for
        // every value axis) AND no value-number labels either — the reference this pass
        // matches ("clean like EvilCharts") carries the reading entirely on the faint
        // dashed gridlines, with no Y axis at all. Scoped to BarChart's own axis instance
        // rather than the shared theme's valueAxis block, so a value-heavy chart type
        // (e.g. a KPI trend AreaChart) that still needs its numbers keeps them.
        var valueAxis = new EChartAxis { Type = "value", AxisLabel = new EChartAxisLabel { Show = false } };

        var seriesList = Series.Select(s => new EChartSeries
        {
            Name = s.Name,
            Type = "bar",
            Data = s.Values,
            Stack = Stacked ? "total" : null
        }).ToList();

        // When stacked, the theme's rounded corners on every segment make
        // the stack look like floating pills (each segment rounds its own
        // 4 corners, so adjacent segments meet at the arc). We flatten
        // the inner segments and round only the outermost end of the stack:
        //
        //   Vertical stacked   → last series (top) rounds top corners
        //   Horizontal stacked → last series (right) rounds right corners
        //
        // Radius is "var(--radius)" — the SAME token-driven value the shared theme's
        // own default bar rounding uses (see buildLumeoTheme's barRadius in
        // echarts-interop.js), not a disconnected literal. The chart interop's
        // resolveCssVars pass resolves the var() reference to the live computed pixel
        // value at render time (see resolveCssVarValue's length-to-px conversion) — a
        // previous pass hardcoded `const int r = 6` here, which silently ignored
        // whatever --radius the active theme/style actually set. Consumers who want a
        // different value can still override via OptionOverride on the series.
        if (Stacked && seriesList.Count > 0)
        {
            object[] outerCorners = Horizontal
                ? new object[] { 0, "var(--radius)", "var(--radius)", 0 }   // round right side
                : new object[] { "var(--radius)", "var(--radius)", 0, 0 };  // round top side
            object[] flat = { 0, 0, 0, 0 };

            // Use the array form everywhere — ECharts merges theme + series
            // itemStyle and a scalar `borderRadius: 0` doesn't reliably replace
            // the theme's array default; an all-zero array always wins.
            for (int i = 0; i < seriesList.Count; i++)
            {
                var isOuter = i == seriesList.Count - 1;
                seriesList[i].ItemStyle = new EChartItemStyle
                {
                    BorderRadiusCorners = isOuter ? outerCorners : flat
                };
            }
        }
        else if (Horizontal)
        {
            // Non-stacked horizontal: theme default `[r, r, 0, 0]` rounds the
            // TOP edge (rectangle corners), which looks wrong for a horizontal
            // bar. Override so every bar's right end is rounded instead.
            foreach (var s in seriesList)
                s.ItemStyle = new EChartItemStyle { BorderRadiusCorners = new object[] { 0, "var(--radius)", "var(--radius)", 0 } };
        }

        // No per-series decal (pattern fill) here anymore — a previous pass added one
        // for grouped/stacked multi-series bars (see ChartHelper.GetDecal, still used by
        // Pie/Donut). Removed for bar specifically: the reference this pass matches is
        // explicit ("no pattern"), and nothing else in Lumeo — Button, Badge, Card —
        // textures a solid fill; each series' own palette colour plus the legend swatch
        // is the same "which series is which" signal every other Lumeo surface relies on
        // (a table row doesn't get a hatch pattern to read apart from the row above it).
        if (ShowDataLabels)
            foreach (var s in seriesList)
                s.Label = new EChartLabel { Show = true, Position = LabelPosition, Formatter = LabelFormat };

        if (seriesList.Count > 0)
        {
            if (MarkLine is not null) seriesList[0].MarkLine = MarkLine;
            if (MarkPoint is not null) seriesList[0].MarkPoint = MarkPoint;
            if (MarkArea is not null) seriesList[0].MarkArea = MarkArea;
        }

        _option = new EChartOption
        {
            XAxis = new List<EChartAxis> { Horizontal ? valueAxis : categoryAxis },
            YAxis = new List<EChartAxis> { Horizontal ? categoryAxis : valueAxis },
            Series = seriesList,
            // Left tightened from the previous 3% now that the value axis carries no
            // number labels — ContainLabel still reserves exactly the space the visible
            // category labels need, so this is reclaimed whitespace, not a clipped axis.
            // Top comes down with it: a small top-right legend (below) needs far less
            // vertical band than the old centred one, matching the reference's "generous
            // whitespace... the chart breathes" read instead of ECharts' cramped defaults.
            Grid = new EChartGrid
            {
                Left = "0.5%", Right = "1%",
                Top = ShowLegend ? "10%" : "3%",
                Bottom = DataZoom ? "15%" : "3%",
                ContainLabel = true
            },
            Color = ColorPalette ?? Colors
        };

        if (ShowTooltip)
            _option.Tooltip = new EChartTooltip { Trigger = "axis", AxisPointer = new EChartAxisPointer { Type = "shadow" } };

        // Bar-only: top-right, matching the reference ("small, top-right, tiny square
        // swatches") rather than the shared theme's centred default (left: every other
        // chart wrapper still gets that centred legend unchanged).
        if (ShowLegend && Series.Count > 0)
            _option.Legend = new EChartLegend { Data = Series.Select(s => s.Name).ToList(), Left = "right", Top = "0%" };

        if (DataZoom)
            _option.DataZoom = new List<EChartDataZoom> { new() { Type = "slider", Show = true }, new() { Type = "inside" } };

        if (Toolbox)
            _option.Toolbox = new EChartToolbox { Show = true, Feature = new EChartToolboxFeature { SaveAsImage = new() { Show = true }, Restore = new() { Show = true }, DataZoom = new() { Show = true } } };

        ChartHelper.ApplyAnimation(_option, AnimationDuration, AnimationEasing);

        ChartHelper.ApplyOptionOverride(_option, OptionOverride);
    }

    public class ChartSeriesData
    {
        public string Name { get; set; } = "";
        public List<double> Values { get; set; } = new();
    }
}
