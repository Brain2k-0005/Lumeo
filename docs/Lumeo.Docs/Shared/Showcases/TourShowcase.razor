@namespace Lumeo.Docs.Shared.Showcases

@* Tour fundamentally observes real DOM elements elsewhere on the page (Steps target selectors,
   and the spotlight ring is measured against their live bounding rects) — there is nothing to
   miniaturise inside a self-contained 16:9 card. Per the README's exception pattern this
   renders a faithful static rendition of the component's own visible control: the step
   tooltip card exactly as TourTooltip renders it (classes lifted from Tour.razor), with no
   spotlight/targeting wiring. *@
<div class="w-full max-w-[22rem]">
    <div class="w-72 rounded-lg border border-border/60 bg-popover p-3 text-popover-foreground shadow-lg">
        <Stack Gap="2">
            <Stack Gap="1">
                <Lumeo.Text As="span" Size="sm" Weight="semibold">Dashboard overview</Lumeo.Text>
                <Lumeo.Text Size="xs" Color="muted">This is where you'll see your key metrics at a glance.</Lumeo.Text>
            </Stack>
            <Flex Align="center" Justify="between" Class="pt-1">
                <Lumeo.Text As="span" Size="xs" Color="muted">2 / 4</Lumeo.Text>
                <Flex Gap="2">
                    <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Xs">Back</Button>
                    <Button Size="Button.ButtonSize.Xs">Next</Button>
                </Flex>
            </Flex>
        </Stack>
    </div>
</div>
