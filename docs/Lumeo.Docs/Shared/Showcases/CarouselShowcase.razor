@namespace Lumeo.Docs.Shared.Showcases

@* A fixed-height slide (not aspect-square) so this stays as tall as every other
   Navigation showcase — aspect-square made the slide portrait-tall, which stretched
   the whole grid row far past its neighbours. See Showcases/README.md rule 2. *@
<div class="w-full max-w-[22rem]">
    <Carousel>
        <CarouselContent>
            @for (var i = 1; i <= 3; i++)
            {
                var index = i;
                <CarouselItem>
                    <Stack Class="p-1">
                        <Card>
                            <CardContent Class="flex h-28 items-center justify-center p-4">
                                <Lumeo.Text As="span" Class="text-2xl font-semibold">@index</Lumeo.Text>
                            </CardContent>
                        </Card>
                    </Stack>
                </CarouselItem>
            }
        </CarouselContent>
        <CarouselPrevious Class="start-1 top-1/2 -translate-y-1/2" />
        <CarouselNext Class="end-1 top-1/2 -translate-y-1/2" />
    </Carousel>
</div>
