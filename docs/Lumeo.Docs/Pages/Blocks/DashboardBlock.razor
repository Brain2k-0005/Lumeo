                </div>
                <DrawerFooter>
                    <Button OnClick="@(() => _drawerOpen = false)">Submit</Button>
                    <Button Variant="Button.ButtonVariant.Outline" OnClick="@(() => _drawerOpen = false)">Done</Button>
                </DrawerFooter>
            </DrawerContent>
        </Drawer>
    </ComponentDemo>
</Stack>

