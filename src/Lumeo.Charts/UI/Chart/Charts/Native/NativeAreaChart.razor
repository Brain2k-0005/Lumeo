@namespace Lumeo

@* First-party native counterpart of Lumeo.AreaChart (UI/Chart/Charts/AreaChart.razor,
   untouched). See NativeLineChart.razor's header comment for why this lives under a
   distinct name/folder instead of replacing the legacy file in place. *@

<CartesianChartHost Series="@_series" Categories="@Categories" UsePointScale="true" Horizontal="false"
                     Width="@Width" Height="@Height" Class="@Class" AdditionalAttributes="@AdditionalAttributes"
                     ShowLegend="@ShowLegend" ShowTooltip="@ShowTooltip" ShowDataLabels="@ShowDataLabels"
                     LabelPosition="@LabelPosition" LabelFormat="@LabelFormat" LabelStrategy="@LabelStrategy" LabelRotate="@LabelRotate"
                     DataZoom="@DataZoom" Colors="@Colors" ColorPalette="@ColorPalette"
                     AnimationDuration="@AnimationDuration" AnimationEasing="@AnimationEasing" EChartsTypeLabel="line"
                     IsLoading="@IsLoading" ShowLoadingSkeleton="@ShowLoadingSkeleton" SkeletonKind="@SkeletonKind"
                     SkeletonStyle="@SkeletonStyle" PhantomCycleMs="@PhantomCycleMs" ShowLoadingLabel="@ShowLoadingLabel" LoadingText="@EffectiveLoadingText">
    <ExtraDefs>
        @for (var i = 0; i < _gradientStopsPerSeries.Count; i++)
        {
            var stops = _gradientStopsPerSeries[i];
            <linearGradient id="@GradientId(i)" x1="0" y1="0" x2="0" y2="1">
                @foreach (var stop in stops)
                {
                    <stop offset="@FormatPercent(stop.Offset)" stop-color="@stop.Color" />
                }
            </linearGradient>
        }
    </ExtraDefs>
</CartesianChartHost>

@code {
    /// <summary>Category labels along the axis, one per data point; series values are matched to these by index.</summary>
    [Parameter] public List<string> Categories { get; set; } = new();
    /// <summary>The series to plot, each with a name and its list of values aligned to <see cref="Categories"/> by index.</summary>
    [Parameter] public List<ChartSeriesData> Series { get; set; } = new();
    [Parameter] public bool Smooth { get; set; }
    [Parameter] public bool ShowDots { get; set; } = true;
    [Parameter] public bool Stacked { get; set; }
    /// <summary>When true (default), the fill uses a lighter opacity (0.3 vs 0.7) than a solid area.</summary>
    [Parameter] public bool Gradient { get; set; } = true;
    /// <summary>Opt into a real per-series linear gradient fill (own color at top → transparent at bottom).</summary>
    [Parameter] public bool GradientFill { get; set; }
    /// <summary>Explicit gradient stops applied to every series' fill when set (implies <see cref="GradientFill"/>).
    /// Reuses the legacy <see cref="EChartGradientColorStop"/> DTO — it's already an ECharts-independent
    /// (offset,color) pair, so no new type was introduced for this.</summary>
    [Parameter] public List<EChartGradientColorStop>? GradientStops { get; set; }
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool ShowTooltip { get; set; } = true;
    [Parameter] public List<string>? Colors { get; set; }
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "350px";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool ShowLoadingSkeleton { get; set; } = true;
    [Parameter] public ChartSkeletonKind SkeletonKind { get; set; } = ChartSkeletonKind.Area;
    [Parameter] public ChartSkeletonStyle SkeletonStyle { get; set; } = ChartSkeletonStyle.Phantom;
    [Parameter] public int PhantomCycleMs { get; set; } = 1400;
    [Parameter] public bool ShowLoadingLabel { get; set; } = true;
    [Parameter] public string? LoadingText { get; set; } = "Loading…";
    private string EffectiveLoadingText => LoadingText ?? "Loading…";

    [Parameter] public bool ShowDataLabels { get; set; }
    [Parameter] public string LabelPosition { get; set; } = "top";
    [Parameter] public string? LabelFormat { get; set; }
    [Parameter] public ChartLabelStrategy LabelStrategy { get; set; } = ChartLabelStrategy.Smart;
    [Parameter] public int? LabelRotate { get; set; }
    [Parameter] public bool DataZoom { get; set; }
    [Parameter] public List<string>? ColorPalette { get; set; }
    [Parameter] public int? AnimationDuration { get; set; }
    [Parameter] public string? AnimationEasing { get; set; }

    private List<NativeCartesianSeries> _series = new();
    private List<List<(double Offset, string Color)>> _gradientStopsPerSeries = new();

    protected override void OnParametersSet()
    {
        var useGradient = GradientFill || GradientStops is { Count: > 0 };
        _gradientStopsPerSeries = new List<List<(double, string)>>();

        _series = Series.Select((s, i) =>
        {
            string? fillPaint = null;
            if (useGradient)
            {
                var color = ResolveColor(i);
                var stops = GradientStops is { Count: > 0 } custom
                    ? custom.Select(c => (c.Offset, c.Color)).ToList()
                    : new List<(double, string)> { (0, color), (1, "transparent") };
                _gradientStopsPerSeries.Add(stops);
                fillPaint = $"url(#{GradientId(i)})";
            }

            return new NativeCartesianSeries
            {
                Name = s.Name,
                Kind = NativeCartesianSeriesKind.Area,
                Values = s.Values.Select(v => (double?)v).ToList(),
                Smooth = Smooth,
                Stacked = Stacked,
                FillPaint = fillPaint,
                FillOpacity = Gradient ? 0.3 : 0.7,
            };
        }).ToList();
    }

    private string ResolveColor(int index) => NativeChartPalette.Resolve(ColorPalette, Colors, index);

    private static string FormatPercent(double offset01) =>
        (offset01 * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private string GradientId(int seriesIndex) => $"lumeo-area-grad-{_instanceId}-{seriesIndex}";
    private readonly string _instanceId = Guid.NewGuid().ToString("N")[..8];

    public class ChartSeriesData
    {
        public string Name { get; set; } = "";
        public List<double> Values { get; set; } = new();
    }
}
