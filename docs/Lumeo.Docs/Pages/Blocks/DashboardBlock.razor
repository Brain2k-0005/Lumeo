        {
            var days = _range switch { "30d" => 30, "7d" => 7, _ => 90 };
            var start = new DateTime(2024, 6, 30).AddDays(-days);
            return _points.Where(p => DateTime.Parse(p.Date, System.Globalization.CultureInfo.InvariantCulture) >= start);
        }
    }

    // Formatted by hand: the docs run WebAssembly in invariant-globalization mode, where
    // CultureInfo.GetCultureInfo("en-US") throws.
    private static readonly string[] _monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    private static string ShortDate(string iso) { var d = DateTime.Parse(iso, System.Globalization.CultureInfo.InvariantCulture); return $"{_monthNames[d.Month - 1]} {d.Day}"; }
    private List<string> ChartCategories => RangePoints.Select(p => ShortDate(p.Date)).ToList();
    private List<AreaChart.ChartSeriesData> ChartSeries =>
    [
        new() { Name = "Mobile", Values = RangePoints.Select(p => (double)p.Mobile).ToList() },
        new() { Name = "Desktop", Values = RangePoints.Select(p => (double)p.Desktop).ToList() },
    ];

    private static readonly List<string> _months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"];
    private List<string> DrawerCategories => _months;
    private List<AreaChart.ChartSeriesData> DrawerSeries =>
    [
        new() { Name = "Mobile", Values = [80, 200, 120, 190, 130, 140] },
        new() { Name = "Desktop", Values = [186, 305, 237, 73, 209, 214] },
    ];

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));
    private IEnumerable<Section> PageRows => _rows.Skip(_page * _pageSize).Take(_pageSize);
    private bool AllPageSelected => PageRows.All(r => _selected.Contains(r.Id));
    private bool SomePageSelected => !AllPageSelected && PageRows.Any(r => _selected.Contains(r.Id));

    private void ToggleAllPage(bool on)
    {
        foreach (var r in PageRows) { if (on) _selected.Add(r.Id); else _selected.Remove(r.Id); }
    }

    private void ToggleRow(int id, bool on) { if (on) _selected.Add(id); else _selected.Remove(id); }
    private void ToggleColumn(string col, bool on) { if (on) _hidden.Remove(col); else _hidden.Add(col); }

    private void SetPageSize(string? v)
    {
        if (int.TryParse(v, out var size) && size > 0) { _pageSize = size; _page = Math.Min(_page, PageCount - 1); }
    }

    // Drag a row onto another to move it there - the block's dnd-kit reorder, without dnd-kit.
    private void DropOn(int targetId)
    {
        if (_dragId is not { } from || from == targetId) { _dragId = null; return; }
        var item = _rows.First(r => r.Id == from);
        _rows.Remove(item);
        _rows.Insert(_rows.FindIndex(r => r.Id == targetId), item);
        _dragId = null;
    }

    private void OpenDrawer(Section row) { _drawerItem = row; _drawerOpen = true; }
}
