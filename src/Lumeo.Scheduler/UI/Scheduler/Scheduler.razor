@namespace Lumeo
@using Lumeo.SchedulerKernel
@inject Lumeo.Services.IComponentInteropService Interop
@inject Lumeo.Services.Localization.ILumeoLocalizer L

<div class="@($"flex flex-col gap-3 rounded-md border border-border/60 bg-card p-3 {Class}".Trim())" @attributes="AdditionalAttributes">
    @* Lumeo-styled toolbar above the calendar grid. *@
    <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-1">
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" OnClick="PrevAsync" aria-label="@L["Scheduler.Previous"]">
                <SvgGlyph Svg="@(LumeoIcons.ChevronLeft)" class="h-4 w-4" />
            </Button>
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" OnClick="TodayAsync">@L["Scheduler.Today"]</Button>
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" OnClick="NextAsync" aria-label="@L["Scheduler.Next"]">
                <SvgGlyph Svg="@(LumeoIcons.ChevronRight)" class="h-4 w-4" />
            </Button>
        </div>
        <div class="flex-1 text-center text-sm font-medium text-foreground truncate px-2">
            @_title
        </div>
        <ToggleGroup Type="ToggleGroup.ToggleGroupType.Single"
                     Variant="ToggleGroup.ToggleGroupVariant.Outline"
                     Size="Lumeo.Size.Sm"
                     Value="@_currentViewValue"
                     ValueChanged="OnViewChangedAsync">
            <ToggleGroupItem Value="Month">@L["Scheduler.Month"]</ToggleGroupItem>
            <ToggleGroupItem Value="Week">@L["Scheduler.Week"]</ToggleGroupItem>
            <ToggleGroupItem Value="Day">@L["Scheduler.Day"]</ToggleGroupItem>
            <ToggleGroupItem Value="List">@L["Scheduler.List"]</ToggleGroupItem>
            @if (VisibleDays is > 0)
            {
                @* Labelled with the actual count — "N days" is meaningless as a fixed string,
                   and this button only exists once a caller has chosen an N. *@
                <ToggleGroupItem Value="MultiDay">@string.Format(L["Scheduler.NDays"], EffectiveVisibleDays)</ToggleGroupItem>
            }
            @if (Resources is { Count: > 0 })
            {
                <ToggleGroupItem Value="Resource">@L["Scheduler.Resources"]</ToggleGroupItem>
                <ToggleGroupItem Value="Timeline">@L["Scheduler.Timeline"]</ToggleGroupItem>
            }
        </ToggleGroup>
    </div>

    @* Calendar chips. Each toggles its own visibility; the trailing control switches every
       pane at once, and only appears once there is a second calendar to put beside the first. *@
    @if (Calendars is { Count: > 0 })
    {
        <div class="flex flex-wrap items-center gap-1.5 px-1" aria-label="@L["Scheduler.Calendars"]">
            @foreach (var cal in Calendars)
            {
                var hidden = _hiddenCalendars.Contains(cal.Id);
                <button type="button"
                        class="@($"inline-flex items-center gap-1.5 rounded-[calc(var(--radius)*2)] border px-2 py-0.5 text-xs transition-colors {(hidden ? "border-border/60 text-muted-foreground" : "border-transparent bg-accent text-foreground")}")"
                        data-scheduler-calendar="@cal.Id"
                        aria-pressed="@((!hidden).ToString().ToLowerInvariant())"
                        aria-label="@string.Format(L["Scheduler.ToggleCalendar"], cal.Name)"
                        @onclick="@(() => ToggleCalendarAsync(cal.Id))">
                    @* The dot keeps its colour when hidden, at reduced opacity: it is the only
                       thing tying the chip to its events, and dropping it would make an off
                       calendar unidentifiable. *@
                    <span class="inline-block h-2.5 w-2.5 flex-shrink-0 rounded-[calc(var(--radius)*2)]"
                          style="background: @(cal.Color ?? "var(--color-primary)"); opacity: @(hidden ? "0.4" : "1")"></span>
                    <span class="@(hidden ? "line-through" : null)">@cal.Name</span>
                </button>
            }

            @* Visible, not declared: with everything but one switched off the split has
               nothing to put side by side, and ShowsPanes refuses it. A control still offered
               there changes the mode and flips its own label to "Merge panes" while the layout
               stays overlaid, promising a state it cannot reach (Codex review of PR #426). *@
            @if (VisibleCalendars.Count > 1)
            {
                <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Sm"
                        OnClick="@(() => SetPaneModeAsync(_paneMode == SchedulerPaneMode.SideBySide ? SchedulerPaneMode.Overlay : SchedulerPaneMode.SideBySide))"
                        aria-label="@(_paneMode == SchedulerPaneMode.SideBySide ? L["Scheduler.MergePanes"] : L["Scheduler.SplitPanes"])"
                        title="@(_paneMode == SchedulerPaneMode.SideBySide ? L["Scheduler.MergePanes"] : L["Scheduler.SplitPanes"])"
                        data-scheduler-pane-toggle>
                    <SvgGlyph Svg="@(_paneMode == SchedulerPaneMode.SideBySide ? LumeoIcons.Minimize2 : LumeoIcons.Columns3)" class="h-4 w-4" />
                </Button>
            }
        </div>
    }

    @* Resource legend — rendered when Resources are provided.
       Uses simple color-coded dots. *@
    @if (_resolvedResources is { Count: > 0 })
    {
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-1 pb-1" aria-label="@L["Scheduler.ResourceLegend"]">
            @foreach (var resource in _resolvedResources)
            {
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="inline-block h-2.5 w-2.5 rounded-[calc(var(--radius)*2)] flex-shrink-0"
                          style="background: @(resource.Color ?? "var(--color-primary)")"></span>
                    <span>@resource.Title</span>
                </div>
            }
        </div>
    }

    @* Height bounds the SCROLL viewport (Codex review, P2): applied only as an
       outer max-height it left the inner views free to grow past it, so a tall
       month rendered outside the box the caller asked for. *@
    @{
        // The whole view switch as ONE fragment, rendered once per pane with that pane's own
        // events. Duplicating the switch instead would let a pane drift from the overlay the
        // first time a view gained a parameter.
        RenderFragment<(IEnumerable<SchedulerEvent>? Events, string? CalendarId)> viewFor = pane =>
        @<text>
            @switch (_currentView)
            {
                case SchedulerView.Month:
                    <SchedulerMonthView Events="@pane.Events" AnchorDate="@_fpAnchor"
                                        FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                        BusinessHours="@BusinessHours"
                                        ShowWeekNumbers="@ShowWeekNumbers" HideWeekends="@HideWeekends"
                                        Editable="@Editable" Selectable="@Selectable" CanDrop="@CanDrop"
                                        ResolveEventColor="@ResolveFirstPartyColor"
                                        ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                        OnEventClick="@EffectiveEventClick" OnDateSelect="@DateSelectFor(pane.CalendarId)"
                                        OnEventChange="@OnFirstPartyEventChangeAsync"
                                        OnRequestPrev="@PrevAsync" OnRequestNext="@NextAsync" />
                    break;
                case SchedulerView.Week:
                    <SchedulerTimeGridView Events="@pane.Events" AnchorDate="@_fpAnchor" Days="7"
                                           ReserveFullAllDayStrip="@SharesPaneScroll"
                                           SelfScrolling="@(!SharesPaneScroll)"
                                           Today="@(_displayZone is not null ? SchedulerTimeZoneProjection.TodayIn(_displayZone) : _browserToday)"
                                           FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                           BusinessHours="@BusinessHours" NowIndicator="@NowIndicator" NowTimeZoneId="@SchedulerTimeZoneProjection.JsZoneId(_displayZone)"
                                           SlotMinTime="@SlotMinTime" SlotMaxTime="@SlotMaxTime" SlotDuration="@SlotDuration"
                                           Editable="@Editable" Selectable="@Selectable" CanDrop="@CanDrop"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@EffectiveEventClick" OnDateSelect="@DateSelectFor(pane.CalendarId)"
                                           OnEventChange="@OnFirstPartyEventChangeAsync"
                                           OnRequestPrev="@PrevAsync" OnRequestNext="@NextAsync" />
                    break;
                case SchedulerView.Day:
                    <SchedulerTimeGridView Events="@pane.Events" AnchorDate="@_fpAnchor" Days="1"
                                           ReserveFullAllDayStrip="@SharesPaneScroll"
                                           SelfScrolling="@(!SharesPaneScroll)"
                                           Today="@(_displayZone is not null ? SchedulerTimeZoneProjection.TodayIn(_displayZone) : _browserToday)"
                                           FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                           BusinessHours="@BusinessHours" NowIndicator="@NowIndicator" NowTimeZoneId="@SchedulerTimeZoneProjection.JsZoneId(_displayZone)"
                                           SlotMinTime="@SlotMinTime" SlotMaxTime="@SlotMaxTime" SlotDuration="@SlotDuration"
                                           Editable="@Editable" Selectable="@Selectable" CanDrop="@CanDrop"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@EffectiveEventClick" OnDateSelect="@DateSelectFor(pane.CalendarId)"
                                           OnEventChange="@OnFirstPartyEventChangeAsync"
                                           OnRequestPrev="@PrevAsync" OnRequestNext="@NextAsync" />
                    break;
                case SchedulerView.MultiDay:
                    @* Days != 7 makes the time grid start at the anchor itself instead of a
                       week boundary, which is exactly the rolling window this view wants. *@
                    <SchedulerTimeGridView Events="@pane.Events" AnchorDate="@_fpAnchor" Days="@EffectiveVisibleDays"
                                           ReserveFullAllDayStrip="@SharesPaneScroll"
                                           SelfScrolling="@(!SharesPaneScroll)"
                                           Today="@(_displayZone is not null ? SchedulerTimeZoneProjection.TodayIn(_displayZone) : _browserToday)"
                                           AlignToWeek="false"
                                           FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                           BusinessHours="@BusinessHours" NowIndicator="@NowIndicator" NowTimeZoneId="@SchedulerTimeZoneProjection.JsZoneId(_displayZone)"
                                           SlotMinTime="@SlotMinTime" SlotMaxTime="@SlotMaxTime" SlotDuration="@SlotDuration"
                                           Editable="@Editable" Selectable="@Selectable" CanDrop="@CanDrop"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@EffectiveEventClick" OnDateSelect="@DateSelectFor(pane.CalendarId)"
                                           OnEventChange="@OnFirstPartyEventChangeAsync"
                                           OnRequestPrev="@PrevAsync" OnRequestNext="@NextAsync" />
                    break;
                case SchedulerView.Timeline when Resources is { Count: > 0 }:
                    @* Today comes from the DISPLAY zone (Codex review, P2): events are
                       projected into it, so letting the view fall back to the host's
                       DateTime.Today highlighted a different column than the data sits in —
                       and disagreed with this wrapper's own Today button. *@
                    <SchedulerTimelineView Events="@pane.Events" Resources="@Resources"
                                           Today="@(_displayZone is not null ? SchedulerTimeZoneProjection.TodayIn(_displayZone) : _browserToday)"
                                           RangeStart="@_fpAnchor" Columns="@EffectiveTimelineColumns"
                                           Unit="@TimelineUnit" FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@EffectiveEventClick" />
                    break;
                case SchedulerView.Resource when Resources is { Count: > 0 }:
                    <SchedulerResourceView Events="@pane.Events" Date="@_fpAnchor"
                                           SelfScrolling="@(!SharesPaneScroll)"
                                           Resources="@Resources"
                                           SlotMinTime="@SlotMinTime" SlotMaxTime="@SlotMaxTime" SlotDuration="@SlotDuration"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@EffectiveEventClick" />
                    break;
                case SchedulerView.Resource:
                case SchedulerView.Timeline:
                    @* Both views need Resources to mean anything. Their documentation has
                       always said they degrade to the day view; without this case they fell
                       through to `default`, i.e. the AGENDA — a flat list, which is not what
                       was promised and not the nearest thing either. Caught by a test written
                       against the documented behaviour. *@
                    <SchedulerTimeGridView Events="@pane.Events" AnchorDate="@_fpAnchor" Days="1"
                                           ReserveFullAllDayStrip="@SharesPaneScroll"
                                           SelfScrolling="@(!SharesPaneScroll)"
                                           Today="@(_displayZone is not null ? SchedulerTimeZoneProjection.TodayIn(_displayZone) : _browserToday)"
                                           FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                           BusinessHours="@BusinessHours" NowIndicator="@NowIndicator" NowTimeZoneId="@SchedulerTimeZoneProjection.JsZoneId(_displayZone)"
                                           SlotMinTime="@SlotMinTime" SlotMaxTime="@SlotMaxTime" SlotDuration="@SlotDuration"
                                           Editable="@Editable" Selectable="@Selectable" CanDrop="@CanDrop"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@EffectiveEventClick" OnDateSelect="@DateSelectFor(pane.CalendarId)"
                                           OnEventChange="@OnFirstPartyEventChangeAsync"
                                           OnRequestPrev="@PrevAsync" OnRequestNext="@NextAsync" />
                    break;
                default:
                    @* List maps to the agenda view — the same "flat, chronological"
                       reading a week-long agenda gives. *@
                    <SchedulerAgendaView Events="@pane.Events" AnchorDate="@FirstPartyAgendaStart" DaysToShow="7"
                                           SelfScrolling="@(!SharesPaneScroll)"
                                         ResolveEventColor="@ResolveFirstPartyColor"
                                         ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                         OnEventClick="@EffectiveEventClick" />
                    break;
            }
        </text>;
    }

    <div style="height: @Height; max-height: @Height; overflow: auto;">
        @if (ShowsPanes)
        {
            <div class="flex h-full gap-3">
                @* Keyed by calendar, not by position. A parent reordering a still-visible set
                   otherwise hands each stateful view the NEXT calendar's events while keeping its
                   own state: an open overflow popover, a roving-focus index, a live-region
                   announcement. The popover then silently switches feeds and lists a different
                   calendar's events (Codex review of PR #426). *@
                @foreach (var cal in VisibleCalendars)
                {
                    <div @key="cal.Id" class="flex min-w-0 flex-1 flex-col gap-1" data-scheduler-pane="@cal.Id">
                        <div class="flex items-center justify-between gap-2 border-b border-border/60 pb-1">
                            <span class="flex min-w-0 items-center gap-1.5 text-xs font-medium text-foreground">
                                <span class="inline-block h-2.5 w-2.5 flex-shrink-0 rounded-[calc(var(--radius)*2)]"
                                      style="background: @(cal.Color ?? "var(--color-primary)")"></span>
                                <span class="truncate">@cal.Name</span>
                            </span>
                            @* Merges ALL panes, not just this one: side by side is a MODE rather
                               than a per-calendar flag, and a control that looked per-pane would
                               promise something the mode cannot deliver. *@
                            <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Sm"
                                    OnClick="@(() => SetPaneModeAsync(SchedulerPaneMode.Overlay))"
                                    aria-label="@L["Scheduler.MergePanes"]" title="@L["Scheduler.MergePanes"]">
                                <SvgGlyph Svg="@(LumeoIcons.Minimize2)" class="h-4 w-4" />
                            </Button>
                        </div>
                        @* No scroller of its own. One per pane meant one scrollbar per
                           calendar, each moving only its own column — so the same hour was
                           never on screen twice, which is the whole point of putting the
                           calendars beside each other. The scheduler's own box scrolls them
                           all together instead, and the views hand their scrolling over via
                           SelfScrolling. *@
                        <div class="@(SharesPaneScroll ? "min-h-0 flex-1" : "min-h-0 flex-1 overflow-auto")">
                            @viewFor((EventsFor(cal.Id), cal.Id))
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @viewFor((EffectiveEvents, (string?)null))
        }
    </div>
</div>

@* Opt-in only. With BuiltInEventDialog off this renders nothing at all, so a caller with its own
   appointment form pays neither markup nor behaviour for a feature it does not use. *@
@if (BuiltInEventDialog)
{
    <Dialog @bind-Open="_dialogOpen">
        <DialogContent data-scheduler-dialog="@(DialogIsEdit ? "edit" : "create")">
            <DialogHeader>
                <DialogTitle>@(DialogIsEdit ? L["Scheduler.EditEvent"] : L["Scheduler.NewEvent"])</DialogTitle>
            </DialogHeader>

            <div class="flex flex-col gap-3 py-2">
                <div class="flex flex-col gap-1.5">
                    <Label For="scheduler-dialog-title">@L["Scheduler.EventTitle"]</Label>
                    @* OnInput rather than @bind-Value:event, which only applies to HTML
                       elements: the Save button is disabled while the title is empty, and
                       waiting for blur to notice would leave it dead under the user's hands. *@
                    <Input id="scheduler-dialog-title" data-scheduler-dialog-title
                           Value="@_dialogTitle"
                           OnInput="@(e => _dialogTitle = e.Value?.ToString())" />
                </div>

                <div class="flex items-center gap-2">
                    @* Bound through a setter, not directly: switching to all-day swaps the
                       controls to date-only inputs, and leaving the times behind them intact
                       saved instants the user could no longer see — and toggling back revealed
                       them again (Codex review of PR #426). *@
                    <Switch id="scheduler-dialog-allday" Checked="_dialogAllDay"
                            CheckedChanged="@OnDialogAllDayChanged" data-scheduler-dialog-allday />
                    <Label For="scheduler-dialog-allday">@L["Scheduler.AllDay"]</Label>
                </div>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="flex flex-col gap-1.5">
                        <Label For="scheduler-dialog-start">@L["Scheduler.Starts"]</Label>
                        <input id="scheduler-dialog-start" data-scheduler-dialog-start
                               type="@(_dialogAllDay ? "date" : "datetime-local")"
                               class="flex h-9 w-full rounded-[var(--radius)] border border-input bg-transparent px-3 py-1 text-sm shadow-xs outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                               value="@FormatForInput(_dialogStart)"
                               @onchange="@(e => _dialogStartValid = TryReadInput(e.Value?.ToString(), ref _dialogStart))" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <Label For="scheduler-dialog-end">@L["Scheduler.Ends"]</Label>
                        <input id="scheduler-dialog-end" data-scheduler-dialog-end
                               type="@(_dialogAllDay ? "date" : "datetime-local")"
                               class="flex h-9 w-full rounded-[var(--radius)] border border-input bg-transparent px-3 py-1 text-sm shadow-xs outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                               value="@FormatForInput(_dialogEnd)"
                               @onchange="@(e => _dialogEndValid = TryReadInput(e.Value?.ToString(), ref _dialogEnd))" />
                    </div>
                </div>

                @if (Calendars is { Count: > 0 })
                {
                    <div class="flex flex-col gap-1.5">
                        <Label For="scheduler-dialog-calendar">@L["Scheduler.Calendars"]</Label>
                        <select id="scheduler-dialog-calendar" data-scheduler-dialog-calendar
                                class="flex h-9 w-full rounded-[var(--radius)] border border-input bg-transparent px-3 py-1 text-sm shadow-xs outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                                value="@(_dialogCalendarId ?? string.Empty)"
                                @onchange="@(e => _dialogCalendarId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                            @* An explicit "no calendar" entry, because null is a real choice here:
                               an event filed nowhere is the one thing a visibility toggle can
                               never hide. *@
                            <option value="">@L["Scheduler.NoCalendar"]</option>
                            @foreach (var cal in Calendars)
                            {
                                <option value="@cal.Id" selected="@(cal.Id == _dialogCalendarId)">@cal.Name</option>
                            }
                            @* The parent can drop a calendar while the dialog stands open on an
                               event filed there. With no option of its own the browser falls back
                               to "no calendar" while the field still holds the removed id, so
                               saving without touching the select committed something other than
                               what the form showed. Keeping the id visible refiles nothing
                               (Codex review of PR #426). *@
                            @if (_dialogCalendarId is { Length: > 0 } orphan
                                 && !Calendars.Any(c => c.Id == orphan))
                            {
                                <option value="@orphan" selected="true">@orphan</option>
                            }
                        </select>
                    </div>
                }
            </div>

            <DialogFooter>
                @if (DialogIsEdit)
                {
                    <Button Variant="Button.ButtonVariant.Destructive" OnClick="DeleteDialogAsync"
                            data-scheduler-dialog-delete>@L["Scheduler.Delete"]</Button>
                }
                <Button Variant="Button.ButtonVariant.Outline" OnClick="@(() => _dialogOpen = false)"
                        data-scheduler-dialog-cancel>@L["Scheduler.Cancel"]</Button>
                <Button OnClick="SaveDialogAsync" Disabled="@(!CanSaveDialog)"
                        data-scheduler-dialog-save>@L["Scheduler.Save"]</Button>
            </DialogFooter>
        </DialogContent>
    </Dialog>
}

@code {
    // ── Core parameters ──────────────────────────────────────────────────
    /// <summary>The calendar's events. Controlled when <see cref="EventsChanged"/> has a delegate — the
    /// caller owns the collection and must apply drag/resize/click edits back onto it; otherwise the
    /// component manages its own working copy internally, seeded from this value.</summary>
    [Parameter] public IEnumerable<SchedulerEvent>? Events { get; set; }
    /// <summary>Invoked with the updated event collection after a drag, resize, or other edit. Binding
    /// this makes <see cref="Events"/> controlled.</summary>
    [Parameter] public EventCallback<IEnumerable<SchedulerEvent>> EventsChanged { get; set; }


    /// <summary>
    /// Shows an ISO-8601 week-number column in the month view..
    /// </summary>
    [Parameter] public bool ShowWeekNumbers { get; set; }

    /// <summary>
    /// Hides the Saturday and Sunday columns in the month view..
    /// </summary>
    [Parameter] public bool HideWeekends { get; set; }

    /// <summary>
    /// Three-way drop validation for first-party drags: reject, accept, or accept with an
    /// adjustment.
    /// seam.
    /// </summary>
    [Parameter] public Func<SchedulerEvent, SchedulerScheduleDropContext, SchedulerDropResult>? CanDrop { get; set; }
    /// <summary>The calendar view shown on mount. Default: <see cref="SchedulerView.Month"/>.</summary>
    [Parameter] public SchedulerView InitialView { get; set; } = SchedulerView.Month;
    /// <summary>The date the calendar is centered on at mount. Default: today.</summary>
    [Parameter] public DateTime? InitialDate { get; set; }
    /// <summary>Allows events to be dragged and resized. Default: true.</summary>
    [Parameter] public bool Editable { get; set; } = true;
    /// <summary>Allows the user to click/drag a date range to select it, raising <see cref="OnDateSelect"/>.
    /// Default: true.</summary>
    [Parameter] public bool Selectable { get; set; } = true;
    /// <summary>Shades non-business hours in the time-grid views.</summary>
    [Parameter] public bool BusinessHours { get; set; }
    /// <summary>CSS height of the calendar canvas. Default: <c>"640px"</c>.</summary>
    [Parameter] public string Height { get; set; } = "640px";
    /// <summary>The first day of the week, 0 (Sunday) through 6 (Saturday). Default: 1 (Monday).</summary>
    [Parameter] public int FirstDayOfWeek { get; set; } = 1;
    /// <summary>Invoked when an event chip is clicked.</summary>
    [Parameter] public EventCallback<SchedulerEvent> OnEventClick { get; set; }
    /// <summary>Invoked when the user selects a date/time range (click-drag on the grid).</summary>
    [Parameter] public EventCallback<SchedulerDateRange> OnDateSelect { get; set; }
    /// <summary>Invoked when an event's time window changes via drag or resize, alongside <see cref="EventsChanged"/>.</summary>
    [Parameter] public EventCallback<SchedulerEvent> OnEventChange { get; set; }

    // ── Time-grid display parameters ─────────────────────────────────────
    /// <summary>
    /// Show the current-time indicator line in time-grid views. Default: true.
    /// </summary>
    [Parameter] public bool NowIndicator { get; set; } = true;

    /// <summary>
    /// Earliest visible time slot in time-grid views (e.g. 07:00).
    /// Default: 00:00 — the full day.
    /// </summary>
    [Parameter] public TimeOnly? SlotMinTime { get; set; }

    /// <summary>
    /// Latest visible time slot in time-grid views (e.g. 22:00).
    /// Default: 24:00 — the full day.
    /// </summary>
    [Parameter] public TimeOnly? SlotMaxTime { get; set; }

    /// <summary>
    /// Duration of each time slot row in time-grid views.
    /// Default: one hour. Values that do not divide an hour are rounded up to one that does.
    /// </summary>
    [Parameter] public TimeSpan? SlotDuration { get; set; }

    /// <summary>
    /// How many days <see cref="SchedulerView.MultiDay"/> shows, and the step size when paging
    /// through it. Clamped to 1..14. Leaving this unset hides the view's toolbar button
    /// entirely — an N-day view with no N is not a view.
    /// <para>First-party engine only; see <see cref="SchedulerView.MultiDay"/>.</para>
    /// </summary>
    [Parameter] public int? VisibleDays { get; set; }

    /// <summary>
    /// Column granularity for <see cref="SchedulerView.Timeline"/> — a day, a week, or a
    /// calendar month per column. Default: days.
    /// </summary>
    [Parameter] public SchedulerTimelineUnit TimelineUnit { get; set; } = SchedulerTimelineUnit.Day;

    /// <summary>
    /// How many columns <see cref="SchedulerView.Timeline"/> spans. Default 14. Kept separate
    /// from <see cref="VisibleDays"/> because the two count different things: a timeline column
    /// is one <see cref="TimelineUnit"/> — a day, a week or a month — while
    /// <see cref="VisibleDays"/> always counts days.
    /// </summary>
    [Parameter] public int? TimelineColumns { get; set; }

    private int EffectiveTimelineColumns => Math.Clamp(TimelineColumns ?? 14, 1, 366);

    private int _lastTimelineShape;
    private bool _titleSeeded;

    /// <summary>
    /// IANA time zone the grid is READ in, e.g. <c>"Europe/Berlin"</c>. Unset renders the
    /// values exactly as given.
    /// <para>
    /// Only events carrying a real instant move — see
    /// <see cref="SchedulerTimeZoneProjection"/> for why <see cref="DateTimeKind"/> decides,
    /// and why a caller passing naive wall-clock values (the overwhelming majority) sees no
    /// change at all. Edits are converted back before they reach
    /// <see cref="OnEventChange"/>/<see cref="EventsChanged"/>, so what you get out is in the
    /// frame you put in. An id this host has no data for degrades to "no projection" rather
    /// than failing the render.
    /// </para>
    /// <para>First-party engine only.</para>
    /// </summary>
    [Parameter] public string? TimeZone { get; set; }

    private TimeZoneInfo? _displayZone;

    /// <summary>The clamped <see cref="VisibleDays"/>, defaulting to 3 — the window ReUI's own N-day example uses.</summary>
    private int EffectiveVisibleDays => Math.Clamp(VisibleDays ?? 3, 1, 14);

    // ── Resource / color-coding parameters ──────────────────────────────
    /// <summary>
    /// Optional list of resources (people, rooms, equipment). When provided, events
    /// are color-coded by their <see cref="SchedulerEvent.ResourceId"/> and a legend
    /// is rendered above the calendar.
    /// <br />
    /// Note: this colour-codes events by resource. <see cref="SchedulerView.Resource"/> is
    /// what lays out one lane per resource.
    /// </summary>
    [Parameter] public IReadOnlyList<SchedulerResource>? Resources { get; set; }

    /// <summary>
    /// The calendars events can belong to. Supplying any renders a row of visibility chips, and
    /// an event whose <see cref="SchedulerEvent.CalendarId"/> names a HIDDEN calendar is left out
    /// of every view. An event with a null CalendarId belongs to no calendar and is therefore
    /// never hidden — hiding "Team" must not silently swallow everything unfiled.
    /// </summary>
    [Parameter] public IReadOnlyList<SchedulerCalendar>? Calendars { get; set; }

    /// <summary>
    /// Whether visible calendars share ONE view (<see cref="SchedulerPaneMode.Overlay"/>, the
    /// default and the behaviour before calendars existed) or each get their own pane side by
    /// side. Two-way bindable, so a caller can drive the mode from its own chrome.
    /// </summary>
    [Parameter] public SchedulerPaneMode PaneMode { get; set; }

    /// <summary>Raised when the user switches modes with the toolbar's own control.</summary>
    [Parameter] public EventCallback<SchedulerPaneMode> PaneModeChanged { get; set; }

    /// <summary>
    /// Opt into the built-in create/edit dialog. OFF by default, and deliberately so: most
    /// callers already have their own appointment form, wired through
    /// <see cref="OnDateSelect"/> and <see cref="OnEventClick"/>, and a dialog that appeared on
    /// its own would fight it.
    /// </summary>
    /// <remarks>
    /// It never DISPLACES that workflow. <see cref="OnDateSelect"/> and
    /// <see cref="OnEventClick"/> still fire exactly as they do with the dialog off — the dialog
    /// is additive, so a caller can keep its own handlers for logging, navigation or analytics
    /// and still get the form for free. Saving raises <see cref="OnEventChange"/> and
    /// <see cref="EventsChanged"/>, the same pair a drag already uses, so nothing downstream has
    /// to learn a new channel.
    /// </remarks>
    [Parameter] public bool BuiltInEventDialog { get; set; }

    // ── Event styling callbacks ──────────────────────────────────────────
    /// <summary>
    /// Optional callback that returns extra CSS class names for an event chip.
    /// The classes are appended to the event chip's own.
    /// Use for conditional styling without touching <see cref="SchedulerEvent.Color"/>.
    /// </summary>
    [Parameter] public Func<SchedulerEvent, string>? EventClassNames { get; set; }

    /// <summary>
    /// Optional callback that returns a CSS color string for an event.
    /// Applied to the event chip's background and text colour.
    /// Supersedes <see cref="SchedulerEvent.Color"/> when both are set; resource
    /// color applies as a fallback when neither is set.
    /// </summary>
    [Parameter] public Func<SchedulerEvent, string>? EventColor { get; set; }

    // ── Error handling ───────────────────────────────────────────────────

    // ── Standard pass-through ────────────────────────────────────────────
    /// <summary>Additional CSS classes merged onto the root card.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Additional HTML attributes captured and forwarded to the root card.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int _lastEventsHash;
    private SchedulerView _currentView;
    // EffectiveView, not _currentView: with Timeline selected and no resources the Timeline
    // item is hidden while the day grid renders, so binding the raw selection left every
    // visible item — Day included — unpressed (Codex review round 2, P2).
    private string _currentViewValue => EffectiveView.ToString();
    private string _title = "";

    // The UI culture the cached title was last formatted for.
    // Re-read on every parameter set, not just at init: the title is cached, so a culture
    // change arriving through an ordinary re-render has to invalidate it.
    private string _currentLocale = "en";

    // Snapshot of the most recent events set — used by eventChange to build the
    // updated collection without reaching back into `Events` (which may have
    // been replaced by the parent since init).
    private List<SchedulerEvent> _events = new();

    // CONTROLLED discriminator: hash of the events collection most recently pushed via
    // EventsChanged (also re-synced whenever we adopt an authoritative Events collection).
    // A controlled parent re-render that echoes back this exact collection is safe to
    // ignore (keep in-flight state); any other collection is an authoritative assertion
    // (veto / normalization / reset) and must win.
    private int _lastPushedEventsHash;

    // Resolved resource lookup — built once and used for both legend rendering
    // and event colour-coding.
    private List<SchedulerResource> _resolvedResources = new();
    private Dictionary<string, SchedulerResource> _resourceById = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        _currentView = InitialView;
        _events = Events?.ToList() ?? new List<SchedulerEvent>();
        _lastEventsHash = ComputeEventsHash(_events);
        _lastPushedEventsHash = _lastEventsHash;
        SeedFirstPartyAnchor();
        // ComputeTitle has no branch for List, Resource or MultiDay, so all three used to
        // open on the month name and only corrected themselves once the user navigated.
        _title = ComputeFirstPartyTitle();
        _titleSeeded = true;
        _currentLocale = System.Globalization.CultureInfo.CurrentUICulture.Name;
        RebuildResourceLookup();
    }

    protected override void OnParametersSet()
    {
        _displayZone = SchedulerTimeZoneProjection.Resolve(TimeZone);

        // A parent can withdraw the dialog with the form standing open. Only its MARKUP is
        // conditional, so the state survived: switching the opt-in back on remounted the
        // Dialog with Open=true and the stale form reappeared, ready to commit values from a
        // session the user had left (Codex review of PR #426). The create form goes the same
        // way when Selectable is withdrawn, since that is the gesture that opened it.
        if (_dialogOpen && (!BuiltInEventDialog || (_dialogSource is null && !Selectable)))
        {
            _dialogOpen = false;
            _dialogSource = null;
        }

        // The timeline rebuilds its columns from these immediately, but the toolbar title is
        // cached and was only refreshed by navigation or a culture change — so it kept naming
        // the old end date until the user pressed something (Codex review, P2).
        // EffectiveFirstDayOfWeek moves a week timeline's column origin, and resource presence
        // decides EffectiveView outright — gaining or losing Resources swaps the day grid for the
        // timeline. Both change what the title should read without touching unit or column count
        // (Codex review round 2, P2).
        var timelineShape = HashCode.Combine(TimelineUnit, EffectiveTimelineColumns,
                                             EffectiveFirstDayOfWeek, EffectiveView);
        if (timelineShape != _lastTimelineShape)
        {
            _lastTimelineShape = timelineShape;
            if (_titleSeeded) RefreshFirstPartyTitle();
        }
        // Rebuild the resource lookup whenever the Resources param changes.
        RebuildResourceLookup();

        SeedCalendarVisibility();

        // The parameter WINS whenever the caller changes it, but the user's own toggling of the
        // toolbar control is component state in between — the same split the view selection uses.
        if (PaneMode != _lastPaneModeParameter)
        {
            _lastPaneModeParameter = PaneMode;
            _paneMode = PaneMode;
        }

        // The title is cached, so a UI-culture change that arrives through a normal
        // re-render has to invalidate it explicitly — otherwise a German toolbar sat over
        // an English calendar until the user happened to navigate.
        var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        if (culture != _currentLocale)
        {
            _currentLocale = culture;
            RefreshFirstPartyTitle();
        }

        if (Events is not null)
        {
            var incoming = Events.ToList();
            var hash = ComputeEventsHash(incoming);

            bool shouldAdopt;
            if (EventsChanged.HasDelegate)
            {
                // CONTROLLED: the parent owns the collection.
                // Echo of our own push (hash == _lastPushedEventsHash) → keep in-flight state.
                // Anything else (veto, normalization, reset) → adopt the parent's assertion.
                shouldAdopt = hash != _lastPushedEventsHash;
            }
            else
            {
                // UNCONTROLLED: component owns the live collection.
                // Adopt the parameter only when the parent genuinely changes it; a stale
                // re-render that re-supplies the same collection must not clobber local edits.
                shouldAdopt = hash != _lastEventsHash;
            }

            if (shouldAdopt)
            {
                _events = incoming;
                _lastPushedEventsHash = hash;
            }

            // Keep the uncontrolled discriminator pointing at the last Events hash observed.
            _lastEventsHash = hash;
        }
    }

    private void RebuildResourceLookup()
    {
        _resolvedResources = Resources?.ToList() ?? new List<SchedulerResource>();

        // Duplicate (or null) resource Ids must not throw. ToDictionary blows up on a
        // duplicate key, taking down the whole render; consumers may legitimately pass a
        // list with repeated/blank Ids (e.g. a merged or partially-populated source).
        // Build defensively instead — last entry wins, and null Ids are skipped (they can
        // never be matched by SchedulerEvent.ResourceId lookups anyway).
        var lookup = new Dictionary<string, SchedulerResource>(StringComparer.Ordinal);
        foreach (var r in _resolvedResources)
        {
            if (r.Id is null) continue;
            lookup[r.Id] = r;
        }
        _resourceById = lookup;
    }

    private static int ComputeEventsHash(IEnumerable<SchedulerEvent> events)
    {
        // Cheap identity hash good enough to detect "did the caller hand us a
        // new event list?" without triggering a JS round-trip on every render.
        var hash = new HashCode();
        foreach (var ev in events)
        {
            hash.Add(ev.Id);
            hash.Add(ev.Title);
            hash.Add(ev.Start);
            hash.Add(ev.End);
            hash.Add(ev.AllDay);
            hash.Add(ev.Color);
            hash.Add(ev.Url);
            hash.Add(ev.ResourceId);
            hash.Add(ev.ClassNames);
            hash.Add(ev.RecurrenceEnd);

            // Hash the recurrence rule by value — not just its length. Folding only
            // DaysOfWeek.Count missed edits that swap days without changing the count
            // (e.g. {Mon} → {Tue}), so the calendar never re-rendered.
            if (ev.DaysOfWeek is { Count: > 0 })
            {
                foreach (var d in ev.DaysOfWeek)
                    hash.Add((int)d);
            }

            // Same reasoning, extended to the wave-1 structured Recurrence rule
            // (Lumeo.Scheduler's SchedulerEvent.Recurrence, additive alongside the
            // legacy DaysOfWeek pair above): fold it by value, not by reference/
            // presence, so e.g. flipping Freq or editing an Interval/Count/Until/
            // ByDay entry is detected even though the record reference itself may
            // differ from a caller rebuilding it each render regardless of edit.
            if (ev.Recurrence is { } rule)
            {
                hash.Add(rule.Freq);
                hash.Add(rule.Interval);
                hash.Add(rule.Count);
                hash.Add(rule.Until);
                if (rule.ByDay is { Count: > 0 })
                {
                    foreach (var byDay in rule.ByDay)
                    {
                        hash.Add((int)byDay.Day);
                        hash.Add(byDay.Ordinal);
                    }
                }
            }

            // ExceptionDates carry real recurrence edits (skip/un-skip a day);
            // omitting them suppressed the JS round-trip entirely.
            if (ev.ExceptionDates is { Count: > 0 })
            {
                foreach (var ex in ev.ExceptionDates)
                    hash.Add(ex);
            }

            // ExtendedProps is arbitrary app metadata round-tripped to JS; fold a
            // stable per-entry signature so changing a value is detected.
            if (ev.ExtendedProps is { Count: > 0 })
            {
                foreach (var kvp in ev.ExtendedProps)
                {
                    hash.Add(kvp.Key);
                    hash.Add(kvp.Value);
                }
            }
        }
        return hash.ToHashCode();
    }

    /// <summary>Recomputes the toolbar title from the anchor date.</summary>
    private void RefreshFirstPartyTitle() => _title = ComputeFirstPartyTitle();
    /// <summary>
    /// Title for a first-party view. List shows a WEEK from the aligned start and Resource shows
    /// a single day, neither of which ComputeTitle's wrapper-shaped branches describe (Codex
    /// review of this PR, P2) — List fell through to the month name, Resource to a week.
    /// </summary>
    private string ComputeFirstPartyTitle() => EffectiveView switch
    {
        SchedulerView.List => ComputeTitle(FirstPartyAgendaStart, SchedulerView.Week),
        SchedulerView.Resource => ComputeTitle(_fpAnchor, SchedulerView.Day),
        // Neither a month nor a week: name both ends, or two adjacent pages are indistinguishable.
        SchedulerView.MultiDay => MultiDayTitle(),
        SchedulerView.Timeline => TimelineTitle(),
        var v => ComputeTitle(_fpAnchor, v),
    };

    private string ComputeTitle(DateTime date, SchedulerView view) => view switch
    {
        SchedulerView.Month => date.ToString("MMMM yyyy", Ui),
        SchedulerView.Week => string.Format(L["Scheduler.WeekOf"], StartOfWeek(date).ToString("MMM d, yyyy", Ui)),
        SchedulerView.Day => date.ToString("dddd, MMM d, yyyy", Ui),
        SchedulerView.List => date.ToString("MMMM yyyy", Ui),
        _ => date.ToString("MMMM yyyy", Ui)
    };

    /// <summary>
    /// The UI culture, not the ambient one. Every view formats its own dates against
    /// CurrentUICulture and the toolbar's change detection watches it too, so formatting the
    /// title against CurrentCulture left the two disagreeing whenever a host set them apart —
    /// German buttons over an English month name.
    /// </summary>
    private static System.Globalization.CultureInfo Ui => System.Globalization.CultureInfo.CurrentUICulture;

    private string MultiDayTitle()
    {
        var start = _fpAnchor.Date;
        var end = start.AddDays(EffectiveVisibleDays - 1);
        return EffectiveVisibleDays == 1
            ? ComputeTitle(start, SchedulerView.Day)
            : $"{start:MMM d} – {end:MMM d, yyyy}";
    }

    /// <summary>
    /// What the view effectively is. Resource and Timeline both need <see cref="Resources"/>;
    /// without it they render the day grid — and the toolbar has to agree (Codex review, P2).
    /// Previously only the RENDERER fell back, so the title still described a timeline range
    /// and prev/next still jumped by TimelineColumns while a single day was on screen.
    /// </summary>
    private SchedulerView EffectiveView =>
        _currentView is SchedulerView.Resource or SchedulerView.Timeline && Resources is not { Count: > 0 }
            ? SchedulerView.Day
            : _currentView;

    private string TimelineTitle()
    {
        var origin = SchedulerTimelineScale.AlignOrigin(TimelineUnit, _fpAnchor, EffectiveFirstDayOfWeek);
        // Derived from the columns actually built, not from the requested count: near the end
        // of the calendar the axis is truncated, and subtracting a day from a saturated
        // endpoint read the title backwards — "Dec 31 – Dec 30, 9999" (Codex review round 6).
        var cols = SchedulerTimelineScale.BuildColumns(TimelineUnit, origin, EffectiveTimelineColumns);
        // A saturated advance is DateTime.MaxValue — a later instant on the SAME final day, so
        // it compares as progress while not being a real exclusive end. Subtracting a day from
        // it read the title backwards. The last VISIBLE day is then the last representable date,
        // not the final column's start: a month column titled "Dec 1 – Dec 1, 9999" while the
        // axis draws through the 31st is just as wrong (Codex review round 7).
        var exclusiveEnd = SchedulerTimelineScale.Advance(TimelineUnit, cols[^1], 1);
        var last = exclusiveEnd == DateTime.MaxValue ? DateTime.MaxValue.Date : exclusiveEnd.AddDays(-1);
        return $"{origin.ToString("MMM d", Ui)} – {last.ToString("MMM d, yyyy", Ui)}";
    }

    private DateTime StartOfWeek(DateTime date)
    {
        // FirstDayOfWeek is 0-6 (Sun-Sat).
        var first = (DayOfWeek)FirstDayOfWeek;
        var diff = (7 + (date.DayOfWeek - first)) % 7;
        return date.AddDays(-diff).Date;
    }

    // ── Navigation state ─────────────────────────────────────────────────
    // The views are pure Blazor renderers of a date range, so the toolbar owns the
    // anchor date. Seeded once from InitialDate.
    private DateTime _fpAnchor = DateTime.Today;

    /// <summary>
    /// The browser's calendar date, resolved once interop is available. Without it the timeline
    /// marked the HOST's today while this wrapper's own Today button jumped to the browser's —
    /// on a Blazor Server circuit those can be different days, so after clicking Today the axis
    /// moved and the marker stayed behind or left the range entirely (Codex review round 9).
    /// Null until the first render completes, which is the documented prerender fallback.
    /// </summary>
    private DateTime? _browserToday;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Re-resolved on every render, not cached from the first one. A circuit that stays
        // connected across the browser's local midnight otherwise keeps marking yesterday, and
        // the time-grid header inherited that the moment it started reading this date (Codex
        // review of PR #427). Skipped when a display zone is configured, because then nothing
        // reads this value.
        //
        // The cost is one small interop per render in the default configuration. The scheduler
        // renders on user actions rather than continuously - a drag runs in JS and commits once -
        // so that is a handful of calls, against a marker that is otherwise wrong for a day.
        if (_displayZone is not null) return;

        var resolved = await ResolveBrowserTodayAsync();
        if (resolved == _browserToday) return;

        _browserToday = resolved;
        StateHasChanged();
    }
    private bool _fpAnchorSeeded;


    /// <summary>
    /// What the first-party views render: the component's own working copy, which is
    /// what makes uncontrolled edits stick. Reading the raw <see cref="Events"/>
    /// parameter would show the parent's unchanged collection straight back.
    /// </summary>
    /// <summary>
    /// What the first-party views actually render. With no <see cref="TimeZone"/> this is the
    /// working copy itself; with one it is that copy read in the display zone. The projection
    /// lives HERE rather than inside the views so they stay pure wall-clock renderers.
    /// </summary>
    /// <summary>
    /// Calendars the user has switched off. Component state rather than a parameter write, so a
    /// parent re-rendering with the same Calendars list does not undo the user's toggling — the
    /// same reason the view selection is not pushed back either.
    /// </summary>
    private readonly HashSet<string> _hiddenCalendars = new(StringComparer.Ordinal);

    /// <summary>Seeded once from each calendar's declared Visible, then owned by the user.</summary>
    private readonly HashSet<string> _seededCalendars = new(StringComparer.Ordinal);

    private SchedulerPaneMode _paneMode;

    /// <summary>The last value the CALLER set, so a re-render with an unchanged parameter does not
    /// undo what the user chose with the toolbar control in the meantime.</summary>
    private SchedulerPaneMode _lastPaneModeParameter;

    /// <summary>
    /// The calendars a view should draw, hidden ones removed and each id appearing ONCE. Nothing
    /// stops a caller handing over a merged list carrying the same id twice, and since the panes
    /// are keyed by that id a repeat threw a duplicate-key exception and took the whole component
    /// down — a caller's imperfect list should degrade, not crash (Codex review of PR #426). The
    /// first entry wins, so a caller's own order is what survives.
    /// </summary>
    private IReadOnlyList<SchedulerCalendar> VisibleCalendars
    {
        get
        {
            if (Calendars is null) return Array.Empty<SchedulerCalendar>();

            var seen = new HashSet<string>(StringComparer.Ordinal);
            var result = new List<SchedulerCalendar>(Calendars.Count);
            foreach (var cal in Calendars)
            {
                var id = cal.Id ?? string.Empty;
                if (_hiddenCalendars.Contains(id)) continue;
                if (!seen.Add(id)) continue;
                result.Add(cal);
            }

            return result;
        }
    }

    private void SeedCalendarVisibility()
    {
        if (Calendars is null) return;

        foreach (var cal in Calendars)
        {
            // Seeded ONCE per id. Re-seeding on every parameter set would fight the user every
            // time the parent re-rendered.
            if (!_seededCalendars.Add(cal.Id)) continue;
            if (!cal.Visible) _hiddenCalendars.Add(cal.Id);
        }
    }

    private async Task ToggleCalendarAsync(string id)
    {
        if (!_hiddenCalendars.Remove(id)) _hiddenCalendars.Add(id);

        // Popping a pane out only to hide it would leave an empty column, so hiding the last
        // visible calendar falls back to overlay rather than rendering nothing.
        if (_paneMode == SchedulerPaneMode.SideBySide && VisibleCalendars.Count == 0)
            await SetPaneModeAsync(SchedulerPaneMode.Overlay);
    }

    private async Task SetPaneModeAsync(SchedulerPaneMode mode)
    {
        if (_paneMode == mode) return;

        _paneMode = mode;
        if (PaneModeChanged.HasDelegate) await PaneModeChanged.InvokeAsync(mode);
    }

    /// <summary>
    /// Side by side needs at least two visible calendars to mean anything — with one it is the
    /// overlay wearing a column header, and with none it is an empty box.
    /// </summary>
    private bool ShowsPanes => _paneMode == SchedulerPaneMode.SideBySide && VisibleCalendars.Count > 1;

    /// <summary>
    /// Whether the panes give up their own scrollers so this component's box moves them together.
    ///
    /// TIME GRIDS only. Their vertical axis is the clock, which is identical in every pane, so one
    /// scroll offset means the same hour everywhere. Nothing else has that property: a Resource
    /// pane's rows are its own resources, a Timeline's row heights come from its own overlaps, and
    /// two agendas of different lengths share no row N — sharing a scroll there moves both panes
    /// without aligning anything, and costs each of them the headings its own scroller kept in
    /// place (Codex review of PR #427).
    /// </summary>
    private bool SharesPaneScroll =>
        ShowsPanes && EffectiveView is SchedulerView.Week or SchedulerView.Day or SchedulerView.MultiDay;

    // ── Built-in dialog ──────────────────────────────────────────────────
    private bool _dialogOpen;

    /// <summary>The event being edited, or null when the dialog is creating a new one.</summary>
    private SchedulerEvent? _dialogSource;

    // string? rather than string: Input.Value is nullable, and a non-nullable field
    // makes the two-way binding's EventCallback types disagree.
    private string? _dialogTitle;
    private DateTime _dialogStart;
    private DateTime _dialogEnd;
    private bool _dialogAllDay;
    private bool _dialogStartValid = true;
    private bool _dialogEndValid = true;

    /// <summary>
    /// The zone the form's wall-clock values were READ in. Converting them back through whatever
    /// <see cref="TimeZone"/> happens to say at save time reinterprets numbers the user never
    /// retyped: a 09:00Z event opened as 10:00 in Berlin and saved after the parameter moved to
    /// Tokyo came back as 01:00Z on a title-only edit (Codex review of PR #426).
    /// </summary>
    private TimeZoneInfo? _dialogZone;
    private string? _dialogCalendarId;

    private bool DialogIsEdit => _dialogSource is not null;

    /// <summary>
    /// Runs BEFORE the caller's own handler and never in place of it: the dialog is additive, so
    /// a consumer keeps whatever it already does with the selection.
    /// </summary>
    /// <summary>
    /// A delegate ONLY when something can actually happen with it — the caller wants the range,
    /// or the built-in dialog is on. The views arm their drag-create gesture on
    /// <c>OnDateSelect.HasDelegate</c> precisely so a gesture that can do nothing is never
    /// offered, and routing unconditionally through the internal handler armed it for everyone:
    /// on the docs demo the create gesture then intercepted the drag that MOVES an event, so
    /// nothing committed. Caught by the E2E suite, which the local gate filters out.
    /// </summary>
    private EventCallback<SchedulerDateRange> EffectiveDateSelect => DateSelectFor(null);

    /// <summary>
    /// Carries the PANE's calendar into the callback. Every pane shares one handler, so without
    /// this a range selected in the second pane was filed into the first visible calendar and
    /// the new appointment appeared in the wrong column (Codex review of PR #426).
    /// </summary>
    private EventCallback<SchedulerDateRange> DateSelectFor(string? calendarId) =>
        DialogCreates || OnDateSelect.HasDelegate
            ? EventCallback.Factory.Create<SchedulerDateRange>(
                this, (SchedulerDateRange r) => OnDateSelectInternalAsync(r, calendarId))
            : default;

    private EventCallback<SchedulerEvent> EffectiveEventClick =>
        BuiltInEventDialog || OnEventClick.HasDelegate
            ? EventCallback.Factory.Create<SchedulerEvent>(this, OnEventClickInternalAsync)
            : default;

    /// <summary>
    /// The index of the one stored event carrying <paramref name="id"/>, or -1 when the id is
    /// blank or borne by more than one — see the drag path's remarks for why ambiguity is
    /// refused rather than resolved to the first match. <c>Matches</c> tells the two apart:
    /// zero means "not here yet", more than one means "here, but unidentifiable".
    /// </summary>
    private (int Index, int Matches) ResolveUnambiguously(string? id)
    {
        if (string.IsNullOrEmpty(id)) return (-1, 0);

        var matches = 0;
        var idx = -1;
        for (var i = 0; i < _events.Count; i++)
        {
            if (!string.Equals(_events[i].Id, id, StringComparison.Ordinal)) continue;
            matches++;
            if (idx < 0) idx = i;
        }

        return (matches > 1 ? -1 : idx, matches);
    }

    /// <summary>
    /// The views gate the create gesture on nothing but <c>OnDateSelect.HasDelegate</c>, so arming
    /// it for the dialog armed it past <see cref="Selectable"/> as well: double-clicking an empty
    /// day opened the create form on a scheduler that had explicitly turned selection off (Codex
    /// review of PR #426). A caller's own handler is deliberately left alone — that contract
    /// predates the dialog and is not mine to change here.
    /// </summary>
    private bool DialogCreates => BuiltInEventDialog && Selectable;

    private async Task OnDateSelectInternalAsync(SchedulerDateRange range, string? paneCalendarId = null)
    {
        if (DialogCreates)
        {
            _dialogSource = null;
            _dialogTitle = string.Empty;
            _dialogStart = range.Start;
            _dialogEnd = range.End;
            _dialogAllDay = range.AllDay;
            // The pane it was drawn in, when there is one. Failing that the first VISIBLE
            // calendar rather than the first declared one, or it would be created straight into
            // something the user cannot see.
            _dialogCalendarId = paneCalendarId ?? VisibleCalendars.FirstOrDefault()?.Id;
            _dialogStartValid = _dialogEndValid = true;
            _dialogZone = _displayZone;
            _dialogOpen = true;
        }

        // The pane travels to the CALLER too, not just to the built-in dialog. A custom
        // creation workflow sees one selection shape from every pane otherwise, so it cannot
        // file the new event into the column the user drew it in (Codex review of PR #426).
        if (OnDateSelect.HasDelegate)
        {
            await OnDateSelect.InvokeAsync(
                paneCalendarId is null ? range : range with { CalendarId = paneCalendarId });
        }
    }

    private async Task OnEventClickInternalAsync(SchedulerEvent ev)
    {
        if (BuiltInEventDialog)
        {
            _dialogSource = ev;
            _dialogTitle = ev.Title;
            _dialogStart = ev.Start;
            _dialogEnd = ev.End;
            _dialogAllDay = ev.AllDay;
            _dialogCalendarId = ev.CalendarId;
            _dialogStartValid = _dialogEndValid = true;
            _dialogZone = _displayZone;
            _dialogOpen = true;
        }

        if (OnEventClick.HasDelegate) await OnEventClick.InvokeAsync(ev);
    }

    private void OnDialogAllDayChanged(bool allDay)
    {
        _dialogAllDay = allDay;

        // Both controls are re-rendered from the retained bounds, so whatever was cleared is
        // showing a real date again — leaving its flag false kept Save disabled over a form
        // with nothing wrong with it (Codex review of PR #426).
        _dialogStartValid = _dialogEndValid = true;

        if (!allDay) return;

        _dialogStart = _dialogStart.Date;
        _dialogEnd = _dialogEnd.Date > _dialogStart ? _dialogEnd.Date : NextMidnight(_dialogStart);
    }

    /// <summary>
    /// The bounds an all-day source hands back, in the frame the dialog actually SHOWED them in.
    /// ToDisplay leaves all-day instants alone, so the form displayed them raw; keeping a UTC or
    /// local kind on an event that is now TIMED would have the very next render project it, and
    /// a 00:00Z appointment would jump to 01:00 in Berlin without the user touching the time
    /// (Codex review of PR #426). Naive bounds are what those readings were all along.
    /// </summary>
    private SchedulerEvent Unprojected(SchedulerEvent saved) =>
        _dialogZone is null || saved.AllDay
            ? saved
            : saved with
            {
                Start = DateTime.SpecifyKind(saved.Start, DateTimeKind.Unspecified),
                End = DateTime.SpecifyKind(saved.End, DateTimeKind.Unspecified),
            };

    /// <summary>
    /// An all-day end is EXCLUSIVE — the convention <c>SchedulerMonthLayout.DayCellSpan</c> and
    /// the expander's <c>End &gt; rangeStart</c> overlap check both read — so a single day ends
    /// at the NEXT midnight. Collapsing both bounds to the same midnight produced a zero-length
    /// event that vanished the moment it was saved on the first visible day (Codex review of
    /// PR #426). Applied only where the end would otherwise be empty: an end a caller already
    /// set is left exactly as it is, even when it carries a time, because re-dating it on a
    /// title-only edit is the same defect as shifting a start.
    /// </summary>
    private static DateTime NextMidnight(DateTime start) => start.Date.AddDays(1);

    private async Task SaveDialogAsync()
    {
        if (!CanSaveDialog) return;

        // Read once. CanSaveDialog already rules out a blank title, but that check now sits
        // behind a property, so the compiler's flow analysis no longer sees it here.
        var title = (_dialogTitle ?? string.Empty).Trim();

        // An end before its start is the one input the form itself can produce, and every
        // downstream consumer — layout, recurrence, the expander's seek — assumes otherwise.
        // An all-day event cannot fall back to the start, because the two bounds being equal
        // is exactly the zero-length case the expander drops; it takes the next midnight
        // instead. That covers the toggle and a user picking the same date twice, which reads
        // as one day.
        var end = _dialogEnd > _dialogStart
            ? _dialogEnd
            : _dialogAllDay ? NextMidnight(_dialogStart) : _dialogStart;

        // Resolved the way the drag path resolves it: only an Id matching EXACTLY one stored
        // event identifies anything. A blank or duplicated Id is ambiguous, and acting on the
        // first match corrupts the wrong record.
        var (idx, matches) = ResolveUnambiguously(_dialogSource?.Id);
        var original = idx >= 0 ? _events[idx] : null;

        // Built on the CURRENT stored record, not on the snapshot the dialog opened with. A
        // parent that refreshes while the form stands open — a poll landing new ExtendedProps, a
        // colour, a recurrence — has already been adopted into _events, and rebuilding from the
        // stale copy silently reverted every one of those properties on a title-only save, none
        // of which the dialog even shows (Codex review of PR #426).
        var basis = original ?? _dialogSource;

        var saved = basis is { } existing
            ? existing with
            {
                Title = title,
                Start = _dialogStart,
                End = end,
                AllDay = _dialogAllDay,
                CalendarId = _dialogCalendarId,
            }
            : new SchedulerEvent(
                Id: Guid.NewGuid().ToString("n"),
                Title: title,
                Start: _dialogStart,
                End: end,
                AllDay: _dialogAllDay)
            {
                CalendarId = _dialogCalendarId,
            };

        // The dialog was populated from the DISPLAY copy, so its wall-clock values have to be
        // read back through the same projection the drag path uses. Without it even a title-only
        // edit stored the shifted reading as an Unspecified instant and quietly rewrote the
        // caller's data into a different frame (Codex review of PR #426).
        //
        // Unless the source was ALL-DAY: ToDisplay leaves those instants untouched, so they were
        // never projected, and inverting one moves the event a day when the user did nothing but
        // switch all-day off. That reads _dialogSource, not the current record: whether these
        // numbers were projected is a fact about the moment the form was FILLED.
        var committed = _dialogSource is { AllDay: true }
            ? Unprojected(saved)
            : SchedulerTimeZoneProjection.FromDisplay(saved, original, _dialogZone);

        if (_dialogSource is not null && idx < 0)
        {
            // Every edit that does not resolve, not only the duplicated one: a blank id, or a
            // parent that removed the event while the dialog stood open, lands here too. The
            // old guard let those through to report the edit on OnEventChange while
            // EventsChanged carried the unchanged collection — two notifications contradicting
            // each other about an edit that had gone nowhere (Codex review of PR #426).
            //
            // Nothing stored, nothing reported — but the dialog still closes. Returning with it
            // open would leave the user pressing Save against a form that can never commit,
            // with no way to tell that from a slow render.
            _dialogOpen = false;
            _dialogSource = null;
            return;
        }

        if (_dialogSource is null) _events.Add(committed);
        else _events[idx] = committed;

        _dialogOpen = false;
        _dialogSource = null;

        // The SAME pair a drag raises, so nothing downstream has to learn a new channel.
        _lastPushedEventsHash = ComputeEventsHash(_events);
        if (OnEventChange.HasDelegate) await OnEventChange.InvokeAsync(committed);
        if (EventsChanged.HasDelegate) await EventsChanged.InvokeAsync(_events.ToList());
    }

    /// <summary>
    /// The value shape an &lt;input type="date"/"datetime-local"&gt; expects. Invariant on
    /// purpose: this is a wire format the browser parses, not something a user reads, so a
    /// culture with a different separator would simply make the control ignore the value.
    /// </summary>
    private string FormatForInput(DateTime value) =>
        _dialogAllDay
            ? value.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
            : value.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>
    /// Keeps the previous value when the control hands back something unparseable — which an
    /// empty date field does on every keystroke while it is being retyped — and reports whether
    /// it did. The KEEPING is why the report matters: a user who clears the field and presses
    /// Save was otherwise committing a date the form no longer showed them, silently restored
    /// from behind the empty control (Codex review of PR #426).
    /// </summary>
    private static bool TryReadInput(string? raw, ref DateTime value)
    {
        if (!DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
                               System.Globalization.DateTimeStyles.None, out var parsed))
        {
            return false;
        }

        value = parsed;
        return true;
    }

    /// <summary>A title is not the only thing the form can be missing.</summary>
    private bool CanSaveDialog =>
        !string.IsNullOrWhiteSpace(_dialogTitle) && _dialogStartValid && _dialogEndValid;

    private async Task DeleteDialogAsync()
    {
        if (_dialogSource is not { } victim) return;

        // By id, not by reference: the dialog holds the display PROJECTION of the event, which
        // is a different instance from the one in the list. And only when that id resolves to
        // exactly one event: RemoveAll on a duplicated id deleted every record sharing it,
        // turning the ambiguity the drag path refuses to act on into silent multi-record data
        // loss (Codex review of PR #426).
        var (victimIdx, _) = ResolveUnambiguously(victim.Id);
        if (victimIdx < 0)
        {
            _dialogOpen = false;
            _dialogSource = null;
            return;
        }

        _events.RemoveAt(victimIdx);
        _dialogOpen = false;
        _dialogSource = null;

        _lastPushedEventsHash = ComputeEventsHash(_events);
        if (EventsChanged.HasDelegate) await EventsChanged.InvokeAsync(_events.ToList());
    }

    private IEnumerable<SchedulerEvent>? EffectiveEvents => EventsFor(calendarId: null);

    /// <summary>
    /// The events a view should draw: projected into the display zone, with hidden calendars
    /// removed, and — when <paramref name="calendarId"/> is given — narrowed to that one pane.
    /// </summary>
    private IEnumerable<SchedulerEvent>? EventsFor(string? calendarId)
    {
        var events = _events.AsEnumerable();

        if (Calendars is { Count: > 0 })
        {
            // Null CalendarId means "no calendar", which no toggle owns and nothing can hide.
            events = events.Where(e => e.CalendarId is null || !_hiddenCalendars.Contains(e.CalendarId));
        }

        if (calendarId is not null)
            events = events.Where(e => string.Equals(e.CalendarId, calendarId, StringComparison.Ordinal));

        return _displayZone is null
            ? events
            : events.Select(e => SchedulerTimeZoneProjection.ToDisplay(e, _displayZone));
    }

    /// <summary>
    /// Colour for a first-party chip, preserving the wrapper's own precedence
    /// (Codex review of this PR, P2): EventColor delegate, then the event's own
    /// Color, then its resource's. Passing EventColor straight through dropped the
    /// resource fallback, so an event carrying only a ResourceId lost its colour
    /// the moment a consumer switched engines.
    /// </summary>
    private string? ResolveFirstPartyColor(SchedulerEvent ev) =>
        EventColor?.Invoke(ev)
        ?? ev.Color
        ?? (ev.ResourceId is { } rid && _resourceById.TryGetValue(rid, out var res) ? res.Color : null)
        // The calendar comes LAST, after the resource: an event's own resource is more specific
        // than the feed it arrived on, and a room's colour should survive being filed under Team.
        ?? (ev.CalendarId is { } cid ? Calendars?.FirstOrDefault(c => c.Id == cid)?.Color : null);

    /// <summary>
    /// Extra chip classes, combining the EventClassNames delegate with the event's
    /// own ClassNames — the pair the removed JS wrapper used to merge on its side
    /// (Codex review, P2), which neither reached the first-party views before.
    /// </summary>
    private string? ResolveFirstPartyClassNames(SchedulerEvent ev)
    {
        var fromDelegate = EventClassNames?.Invoke(ev);
        if (string.IsNullOrEmpty(fromDelegate)) return ev.ClassNames;
        return string.IsNullOrEmpty(ev.ClassNames) ? fromDelegate : $"{fromDelegate} {ev.ClassNames}";
    }

    /// <summary>
    /// Applies a first-party edit through this component's own state before telling
    /// the parent (Codex review of this PR, P1). Forwarding OnEventChange straight
    /// to the children skipped EventsChanged entirely, so a consumer using
    /// @bind-Events without a separate OnEventChange handler saw the chip snap back:
    /// the edit reached nobody.
    /// </summary>
    private async Task OnFirstPartyEventChangeAsync(SchedulerEvent updated)
    {
        // Applied to the component's OWN working copy first (Codex review of this
        // PR, P1). My previous fix built a local list and pushed it through
        // EventsChanged — which repaired the controlled case and left the
        // documented UNCONTROLLED mode broken: with no EventsChanged delegate the
        // edit went into a temporary list and was dropped, so the chip snapped
        // back exactly as before.
        // Resolve by Id, but only when it resolves UNAMBIGUOUSLY (battle-test finding #21,
        // carried over from the deleted JS bridge — the guard lived only there,
        // and this path used the same bare FindIndex the finding was about). A blank Id
        // identifies nothing, and a duplicate Id is genuinely ambiguous; silently merging
        // onto the first match corrupts the wrong record. In both cases the stored
        // collection is left untouched and only the reported event is surfaced.
        var (idx, matches) = ResolveUnambiguously(updated.Id);

        // Converted back BEFORE it is stored or handed on: the views work in display
        // wall-clock and cannot know what frame the caller used, so the original event is what
        // says whether these instants were UTC, local, or naive. Storing the display reading
        // would quietly rewrite the caller's data into a different frame on every drag.
        var committed = SchedulerTimeZoneProjection.FromDisplay(updated, idx >= 0 ? _events[idx] : null, _displayZone);

        if (idx >= 0)
        {
            _events[idx] = committed;
        }
        else if (matches == 0 && !string.IsNullOrEmpty(updated.Id))
        {
            // A genuinely new event (the drag-create path) — an ambiguous or blank Id adds
            // nothing, which is what leaves the stored collection untouched above.
            _events.Add(committed);
        }
        // Recorded BEFORE invoking the parent (Codex review, P1): a controlled parent
        // re-renders synchronously inside InvokeAsync, so OnParametersSetAsync must
        // already see this hash as "the value we just pushed" to tell an accepted echo
        // from a veto. Set afterwards, a parent that REJECTS the edit by handing its old
        // collection straight back looked like an unrelated change and was adopted — the
        // rejection silently became the new truth.
        //
        // _lastEventsHash is deliberately NOT touched here. It tracks what the Events
        // PARAMETER last was, and that is what the uncontrolled path compares against:
        // writing the locally-edited hash into it made the parent's very next re-render —
        // re-supplying the same collection it always passes, for some unrelated reason —
        // look like a genuine change, and the user's drag was clawed back. The deleted
        // deleted JS bridge had this right; the commit path that replaced it did not.
        _lastPushedEventsHash = ComputeEventsHash(_events);

        if (OnEventChange.HasDelegate) await OnEventChange.InvokeAsync(committed);
        if (EventsChanged.HasDelegate) await EventsChanged.InvokeAsync(_events.ToList());
    }

    /// <summary>
    /// The agenda's inclusive start, snapped to the configured week (Codex review,
    /// P2). Passing the raw anchor showed "the next seven days from wherever we
    /// happen to be", which is not the week the toolbar's own title names.
    /// </summary>
    private DateTime FirstPartyAgendaStart =>
        SchedulerDateMath.StartOfWeek(_fpAnchor, EffectiveFirstDayOfWeek);

    private DayOfWeek EffectiveFirstDayOfWeek => (DayOfWeek)Math.Clamp(FirstDayOfWeek, 0, 6);

    /// <summary>The browser's calendar date, falling back to the server's when interop yields nothing.</summary>
    private async Task<DateTime> ResolveBrowserTodayAsync()
    {
        try
        {
            // The SCHEDULER's own asset, not the Gantt's: Lumeo.Scheduler does not reference
            // Lumeo.Gantt, so in a standalone install that module 404s and this silently returned
            // the server's date — exactly the case this resolution exists for (Codex review
            // round 10).
            var iso = await Interop.SchedulerViewsGetLocalDateAsync();
            if (!string.IsNullOrEmpty(iso)
                && DateTime.TryParseExact(iso, "yyyy-MM-dd",
                                          System.Globalization.CultureInfo.InvariantCulture,
                                          System.Globalization.DateTimeStyles.None, out var browserToday))
            {
                return browserToday.Date;
            }
        }
        catch (Exception) { /* prerender / torn-down circuit — fall through */ }
        return DateTime.Today;
    }

    private void SeedFirstPartyAnchor()
    {
        if (_fpAnchorSeeded) return;
        _fpAnchor = (InitialDate ?? DateTime.Today).Date;
        _fpAnchorSeeded = true;
    }

    /// <summary>Steps the first-party anchor by one view-sized unit. Month moves whole months, Week/List a week, Day a day.</summary>
    private void StepFirstPartyAnchor(int direction) => _fpAnchor = EffectiveView switch
    {
        SchedulerView.Month => _fpAnchor.AddMonths(direction),
        // Resource renders a SINGLE date, so a week-sized step skipped six days
        // (Codex review of this PR, P2).
        SchedulerView.Day or SchedulerView.Resource => _fpAnchor.AddDays(direction),
        // A rolling window pages by its OWN width, so consecutive pages tile the calendar
        // instead of overlapping or skipping days.
        SchedulerView.MultiDay => _fpAnchor.AddDays(EffectiveVisibleDays * direction),
        // Pages by the WHOLE axis, in whatever unit its columns are — a month-per-column
        // timeline stepping by days would barely move.
        // Clamped in both directions: an axis at either calendar boundary renders, so its own
        // Next/Previous must not be able to crash it (Codex review round 6).
        SchedulerView.Timeline =>
            SchedulerTimelineScale.Step(TimelineUnit, _fpAnchor, EffectiveTimelineColumns * direction),
        _ => _fpAnchor.AddDays(7 * direction),
    };

    private void PrevAsync()
    {
        StepFirstPartyAnchor(-1);
        RefreshFirstPartyTitle();
    }

    private void NextAsync()
    {
        StepFirstPartyAnchor(1);
        RefreshFirstPartyTitle();
    }

    private async Task TodayAsync()
    {
        // An explicit display zone is more specific than the browser's own clock, so it
        // wins: "Today" in Europe/Berlin must be Berlin's today even for a viewer in Tokyo.
        // Failing that, the BROWSER's date rather than the host's — on a Blazor Server
        // circuit the two can be different calendar days, so "Today" jumped to the wrong
        // day for anyone whose timezone is ahead of or behind the server. DateTime.Today
        // stays the documented fallback when interop is unavailable at all (prerender, a
        // torn-down circuit, a custom service that no-ops).
        if (_displayZone is not null)
        {
            _fpAnchor = SchedulerTimeZoneProjection.TodayIn(_displayZone);
        }
        else
        {
            // Refreshed, not read from the first-render cache: a circuit that stays connected
            // across the browser's local midnight would otherwise move the axis to the new day
            // while still handing the timeline yesterday (Codex review round 10).
            _browserToday = await ResolveBrowserTodayAsync();
            _fpAnchor = _browserToday.Value;
        }
        RefreshFirstPartyTitle();
    }

    private void OnViewChangedAsync(string? v)
    {
        // A single-select ToggleGroup emits null when the already-pressed item is clicked, so
        // ignoring null used to leave _currentView on the hidden Timeline/Resource selection
        // while Day was shown — and that hidden view came back the moment Resources was
        // repopulated. Normalising to what is actually on screen makes the fallback a real
        // state change rather than a display trick (Codex review round 6).
        if (string.IsNullOrEmpty(v))
        {
            if (_currentView != EffectiveView)
            {
                _currentView = EffectiveView;
                RefreshFirstPartyTitle();
            }
            return;
        }
        if (!Enum.TryParse<SchedulerView>(v, out var parsed)) return;
        _currentView = parsed;
        RefreshFirstPartyTitle();
    }

}
