@namespace Lumeo
@typeparam TItem

<tr class="@CssClass" role="row" aria-rowindex="@AriaRowIndex" @attributes="AdditionalAttributes">
    <td colspan="@ColSpan" class="p-4">
        @if (DetailTemplate is not null)
        {
            @if (EffectiveStickyToViewport)
            {
                @* Pins the detail content to the grid's visible scroll viewport instead of
                   letting it span the <td>'s full colspan width (which, once the table has
                   scrolled horizontally past the viewport, is the table's full scrolled
                   width — the panel's right portion would sit off-screen until the user
                   scrolls right; see DataGrid.DetailStickyToViewport).
                   data-slot="datagrid-detail-viewport" is a plain CSS hook (lumeo.css) —
                   NOT a Tailwind arbitrary class, since a var()-based arbitrary class never
                   reaches the precompiled bundle (repo rule). Its width rule reads the
                   --lumeo-grid-viewport-w custom property that DataGrid.razor's scroll
                   wrapper keeps current via a plain ResizeObserver (Interop.
                   RegisterViewportWidth in components.js) — inherited straight through as
                   an ordinary CSS custom property, no container-type/cqw involved (that
                   approach broke DataGridHeaderCell's position:fixed popovers — see
                   DataGrid.razor's comment on the scroll wrapper). *@
                <div class="sticky left-0" data-slot="datagrid-detail-viewport">
                    @DetailTemplate(Item)
                </div>
            }
            else
            {
                @DetailTemplate(Item)
            }
        }
    </td>
</tr>

@code {
    [CascadingParameter] private DataGridContext<TItem>? Context { get; set; }

    // Defaults true (matching DataGrid.DetailStickyToViewport's own default) when
    // rendered outside the grid's cascade, e.g. an isolated component test with no
    // DataGridContext supplied.
    private bool EffectiveStickyToViewport => Context?.DetailStickyToViewport ?? true;

    /// <summary>The row data whose detail content is being expanded, passed to
    /// <see cref="DetailTemplate"/>.</summary>
    [Parameter] public TItem Item { get; set; } = default!;

    /// <summary>1-based <c>aria-rowindex</c> for this detail row, among EVERY rendered
    /// <c>&lt;tr&gt;</c> in the table (per ARIA grid semantics — a detail row occupies a
    /// real table row, same as a data or group-header row). Allocated by
    /// <see cref="DataGridBody{TItem}"/>'s <see cref="DataGridRowIndexer"/> via
    /// <see cref="DataGridRow{TItem}.DetailAriaRowIndex"/>. Null at render sites that
    /// don't yet compute a table-wide index for detail rows (the virtualized branches —
    /// see <see cref="DataGridRowIndexer"/>'s remarks), in which case the attribute is
    /// omitted and the browser falls back to DOM order.</summary>
    [Parameter] public int? AriaRowIndex { get; set; }

    /// <summary>Template rendered inside the spanning detail cell. Renders nothing
    /// when unset.</summary>
    [Parameter] public RenderFragment<TItem>? DetailTemplate { get; set; }

    /// <summary>Number of columns the detail cell spans, matching the parent row's
    /// total column count. Defaults to 1.</summary>
    [Parameter] public int ColSpan { get; set; } = 1;

    /// <summary>Additional CSS classes merged onto the <c>&lt;tr&gt;</c> element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Captures unmatched attributes and applies them to the <c>&lt;tr&gt;</c> element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => $"bg-muted/20 {Class}".Trim();
}
