@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Stack Gap="3">
        <Flex Align="center" Justify="between">
            <Lumeo.Text Size="sm">Email notifications</Lumeo.Text>
            <Switch @bind-Checked="_email" />
        </Flex>
        <Flex Align="center" Justify="between">
            <Lumeo.Text Size="sm">Marketing emails</Lumeo.Text>
            <Switch @bind-Checked="_marketing" />
        </Flex>
    </Stack>
</div>

@code {
    private bool _email = true;
    private bool _marketing;
}
