@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Grid Columns="3" Gap="3" Class="w-full">
        @for (var i = 1; i <= 6; i++)
        {
            var n = i;
            <Flex Class="h-12 rounded-md bg-primary/20 items-center justify-center text-sm text-primary">@n</Flex>
        }
    </Grid>
</div>
