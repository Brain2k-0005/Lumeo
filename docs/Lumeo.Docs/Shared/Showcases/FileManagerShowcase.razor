@namespace Lumeo.Docs.Shared.Showcases
@* Static exception (see ../README.md): FileManager is a full explorer chrome (folder tree +
   breadcrumb + toolbar + list/grid body) built around a real hierarchical viewport — there is
   no small subset of that which stays meaningful at card size without either scrolling or
   losing the tree pane entirely. This renders the exact breadcrumb and list-row markup
   FileManager itself produces (same classes), for a small fixed set of entries, without the
   tree pane or interactivity. *@

<div class="w-full max-w-[22rem] h-36 rounded-lg border border-border/40 overflow-hidden flex flex-col">
    <div class="flex items-center gap-1.5 px-2.5 py-1.5 border-b border-border/40 bg-card shrink-0 text-xs">
        <DynamicIcon Name="HardDrive" Class="h-3.5 w-3.5 text-muted-foreground" />
        <span class="text-muted-foreground">/</span>
        <span class="font-medium text-foreground">Documents</span>
    </div>
    <table class="w-full text-xs border-collapse">
        <tbody>
            @foreach (var row in _rows)
            {
                <tr class="border-b border-border/20">
                    <td class="p-1.5">
                        <div class="flex items-center gap-2">
                            <DynamicIcon Name="@row.Icon" Class="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                            <span class="truncate">@row.Name</span>
                        </div>
                    </td>
                    <td class="p-1.5 text-end text-muted-foreground whitespace-nowrap">@row.Size</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private record Row(string Icon, string Name, string Size);

    private readonly List<Row> _rows = new()
    {
        new("Folder", "Reports", "—"),
        new("Folder", "Invoices", "—"),
        new("FileText", "Resume.pdf", "212 KB"),
    };
}
