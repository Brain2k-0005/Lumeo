@namespace Lumeo.Tests.Components.Tabs

@* Test host for the shadcn-named Value/ValueChanged alias: exercises real
   @bind-Value codegen (the inline RenderFragment DSL used by TabsTests.razor
   can wire ValueChanged manually but can't produce a genuine @bind-), so a
   two-way-binding regression in the generated code is only caught here. *@
<Tabs @bind-Value="_value">
    <TabsList>
        <TabsTrigger Value="a">Tab A</TabsTrigger>
        <TabsTrigger Value="b">Tab B</TabsTrigger>
    </TabsList>
    <TabsContent Value="a">Panel A</TabsContent>
    <TabsContent Value="b">Panel B</TabsContent>
</Tabs>

@code {
    [Parameter] public string InitialValue { get; set; } = "a";

    private string _value = "a";
    public string CurrentValue => _value;

    protected override void OnInitialized()
    {
        _value = InitialValue;
    }
}
