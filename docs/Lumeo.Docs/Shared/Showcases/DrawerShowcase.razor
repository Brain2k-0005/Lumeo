@namespace Lumeo.Docs.Shared.Showcases

@* Fix round 1: real Drawer + real trigger — clicking "Open Drawer" opens the REAL
   DrawerContent as a bottom sheet over the page (expected, same as anywhere else in
   the app). The strip below is an explicitly-marked PREVIEW ONLY static mock of that
   bottom-sheet shape, no ARIA roles. *@
<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <Drawer @bind-Open="_open">
            <DrawerTrigger>
                <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" Class="w-fit">Open Drawer</Button>
            </DrawerTrigger>
            <DrawerContent>
                <DrawerHeader>
                    <DrawerTitle>Move Goal</DrawerTitle>
                    <DrawerDescription>Set your daily activity goal.</DrawerDescription>
                </DrawerHeader>
                <DrawerFooter>
                    <DrawerClose>
                        <Button Class="w-full">Submit</Button>
                    </DrawerClose>
                    <DrawerClose>
                        <Button Variant="Button.ButtonVariant.Outline" Class="w-full">Cancel</Button>
                    </DrawerClose>
                </DrawerFooter>
            </DrawerContent>
        </Drawer>

        @* PREVIEW ONLY — not the live panel. *@
        <div class="h-24 rounded-lg border border-border/40 bg-muted/20 overflow-hidden relative">
            <Stack Gap="1" Class="absolute inset-x-0 bottom-0 rounded-t-[10px] bg-background p-2 shadow-lg">
                <div class="mx-auto h-1.5 w-12 rounded-full bg-muted"></div>
                <Lumeo.Text Size="xs" Weight="semibold">Move Goal</Lumeo.Text>
                <Lumeo.Text Size="xs" Color="muted">Set your daily activity goal.</Lumeo.Text>
            </Stack>
        </div>
    </Stack>
</div>

@code {
    private bool _open;
}
