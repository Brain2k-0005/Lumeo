@namespace Lumeo

<div data-slot="card-header" class="@(Cx.Merge("@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-[var(--card-spacing,1rem)]", PadClass, Class))" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>The header content, typically a <see cref="CardTitle"/> and optional
    /// <see cref="CardDescription"/> stacked with vertical spacing.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Additional CSS classes merged onto the header's root <c>div</c>, after the
    /// density-driven padding classes.</summary>
    [Parameter] public string? Class { get; set; }
    [CascadingParameter] private Lumeo.Density? Density { get; set; }
    /// <summary>Unmatched attributes splatted onto the root <c>div</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string PadClass => "px-[var(--card-spacing,1rem)]";
}
