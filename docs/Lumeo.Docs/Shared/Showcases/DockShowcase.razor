@namespace Lumeo.Docs.Shared.Showcases

<div class="flex w-full max-w-[22rem] justify-center py-6">
    <Dock MaxScale="1.6" MagnifyRadius="80">
        <button type="button" class="flex h-10 w-10 items-center justify-center rounded-xl border border-border/40 bg-card shadow" title="Files">
            <SvgGlyph Svg="@(Lucide.Folder)" class="h-5 w-5 text-foreground/80" />
        </button>
        <button type="button" class="flex h-10 w-10 items-center justify-center rounded-xl border border-border/40 bg-card shadow" title="Mail">
            <SvgGlyph Svg="@(Lucide.Mail)" class="h-5 w-5 text-foreground/80" />
        </button>
        <button type="button" class="flex h-10 w-10 items-center justify-center rounded-xl border border-border/40 bg-card shadow" title="Calendar">
            <SvgGlyph Svg="@(Lucide.Calendar)" class="h-5 w-5 text-foreground/80" />
        </button>
        <button type="button" class="flex h-10 w-10 items-center justify-center rounded-xl border border-border/40 bg-card shadow" title="Settings">
            <SvgGlyph Svg="@(Lucide.Settings)" class="h-5 w-5 text-foreground/80" />
        </button>
    </Dock>
</div>
