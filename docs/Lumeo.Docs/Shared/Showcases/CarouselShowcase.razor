@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[14rem]">
    <Carousel>
        <CarouselContent>
            @for (var i = 1; i <= 3; i++)
            {
                var index = i;
                <CarouselItem>
                    <Stack Class="p-1">
                        <Card>
                            <CardContent Class="flex aspect-square items-center justify-center p-6">
                                <Lumeo.Text As="span" Class="text-3xl font-semibold">@index</Lumeo.Text>
                            </CardContent>
                        </Card>
                    </Stack>
                </CarouselItem>
            }
        </CarouselContent>
        <CarouselPrevious Class="start-1 top-1/2 -translate-y-1/2" />
        <CarouselNext Class="end-1 top-1/2 -translate-y-1/2" />
    </Carousel>
</div>
