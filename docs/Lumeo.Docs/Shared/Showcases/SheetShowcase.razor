@namespace Lumeo.Docs.Shared.Showcases

@* SheetContent renders `position: fixed; inset-y-0 end-0` — a real Sheet would cover the
   full-height edge of the viewport, not fit inside a 16:9 card. This shows the trigger plus a
   static replica of the panel (bg-background, shadow-lg, text-lg/sm tokens lifted from
   SheetContent/SheetHeader/SheetTitle), pinned to the end of the box in normal flow. *@
<div class="w-full max-w-[22rem] h-40 rounded-lg border border-border/40 bg-muted/20 overflow-hidden relative">
    <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Xs" Class="absolute top-2 start-2">Open Sheet</Button>
    <Stack Gap="3" Class="absolute inset-y-0 end-0 w-2/3 bg-background p-3 shadow-lg">
        <Stack Gap="1">
            <Lumeo.Text Size="sm" Weight="semibold">Edit Profile</Lumeo.Text>
            <Lumeo.Text Size="xs" Color="muted">Make changes to your profile here.</Lumeo.Text>
        </Stack>
        <Stack Gap="2">
            <Label Class="text-xs">Name</Label>
            <Input Value="John Doe" Class="h-7 text-xs" />
        </Stack>
        <Button Size="Button.ButtonSize.Xs" Class="mt-auto w-fit self-end">Save Changes</Button>
    </Stack>
</div>
