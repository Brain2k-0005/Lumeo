@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <DataGrid TItem="Person" Items="@_people">
        <DataGridColumnDef TItem="Person" Title="Name" Field="Name" />
        <DataGridColumnDef TItem="Person" Title="Status" Field="Status" />
    </DataGrid>
</div>

@code {
    private record Person(string Name, string Status);

    private readonly List<Person> _people = new()
    {
        new("Alice Johnson", "Active"),
        new("Bob Smith", "Active"),
        new("Carol White", "Away"),
    };
}
