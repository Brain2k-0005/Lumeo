@namespace Lumeo
@implements IAsyncDisposable
@inject Lumeo.Services.IComponentInteropService Interop

<button @ref="_el"
        class="@CssClass"
        style="@StyleString"
        disabled="@Disabled"
        @attributes="AdditionalAttributes"
        @onclick="OnClick">
    <span class="@InnerContentClass">
        @ChildContent
    </span>
</button>

@code {
    /// <summary>The button's label content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Invoked when the button is clicked.</summary>
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }

    /// <summary>When true (default), plays a continuous shimmering light sweep across the button.</summary>
    [Parameter] public bool Shimmer { get; set; } = true;

    /// <summary>CSS color used for the shimmer sweep — defaults to a translucent foreground.</summary>
    [Parameter] public string? ShimmerColor { get; set; }

    /// <summary>Visual style, matching <see cref="Button.ButtonVariant"/>. Defaults to <see cref="Button.ButtonVariant.Default"/>.</summary>
    [Parameter] public Button.ButtonVariant Variant { get; set; } = Button.ButtonVariant.Default;

    /// <summary>Button height/padding, matching <see cref="Button.ButtonSize"/>. Defaults to <see cref="Button.ButtonSize.Default"/>.</summary>
    [Parameter] public Button.ButtonSize Size { get; set; } = Button.ButtonSize.Default;

    /// <summary>Disables interaction and dims the button.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Visual feedback when the button is pressed down. Default is <see cref="Button.ButtonPressEffect.None"/>
    /// (no press animation — original behaviour).
    /// </summary>
    [Parameter] public Button.ButtonPressEffect PressEffect { get; set; } = Button.ButtonPressEffect.None;

    /// <summary>Additional CSS classes merged onto the root button element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes are splatted onto the root button element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Microsoft.AspNetCore.Components.ElementReference _el;
    private bool _rippleAttached;

    private const string BaseClasses = "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-[1.5px] focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50";

    private string VariantClasses => Variant switch
    {
        Button.ButtonVariant.Default => "bg-primary text-primary-foreground shadow hover:bg-primary/90",
        Button.ButtonVariant.Destructive => "bg-destructive text-destructive-foreground shadow-sm hover:bg-destructive/90",
        Button.ButtonVariant.Outline => "border border-input bg-background hover:bg-accent hover:text-accent-foreground",
        Button.ButtonVariant.Secondary => "bg-secondary text-secondary-foreground shadow-sm hover:bg-secondary/80",
        Button.ButtonVariant.Ghost => "hover:bg-accent hover:text-accent-foreground",
        Button.ButtonVariant.Link => "text-primary underline-offset-4 hover:underline",
        _ => ""
    };

    // Deliberately EXHAUSTIVE (no `_ => ...` fallback): Button.ButtonSize is a public
    // enum this switch mirrors arm-by-arm. Every CURRENT member is listed, so a
    // future ButtonSize addition left unhandled here trips CS8509 under
    // `-warnaserror` instead of the button silently rendering with
    // `SizeClasses == ""` (no height/padding at all) — the same class of bug that
    // shipped this PR's Xs-arm miss and Lg px-8 drift (Codex #386 review, round 3).
    //
    // The `#pragma` below suppresses ONLY CS8524 — a SEPARATE diagnostic that fires
    // even when every NAMED member is covered, because an enum's underlying value
    // isn't restricted to its named members. Verified empirically against
    // UploadTrigger.razor's identical mirror: building with all arms present but no
    // fallback and no pragma already emitted CS8524, i.e. deleting the fallback
    // outright breaks the build immediately, not just "on a future ButtonSize
    // addition" as hoped. Scoping the pragma to CS8524 specifically (never CS8509)
    // keeps the actually-useful guard live.
    //
    // Gap between icon/spinner and label is intentionally NOT set here — it lives on
    // InnerGapClass / the inner <span>, the actual flex container with multiple
    // children (see finding 3 below). A gap-* class on THIS outer switch would be
    // inert (the <button> has a single child, this span) and, worse, would sit
    // alongside BaseClasses' own `gap-2` as two conflicting utility classes joined by
    // plain string concatenation (this CssClass build is NOT Cx.Merge) — undefined
    // which one wins in the compiled CSS.
#pragma warning disable CS8524
    private string SizeClasses => Size switch
    {
        // Mirrors Button.SizeClasses at Comfortable. Moved with the 5.0 scale alignment:
        // left behind, an animated button beside a plain one sat a rung taller.
        Button.ButtonSize.Default => "h-8 px-2.5",
        Button.ButtonSize.Sm => "h-7 rounded-md px-2.5 text-[0.8rem]",
        // Button moved Lg's Comfortable padding to px-6 in this PR (px-8 -> px-6);
        // this mirror had drifted and still rendered a large ShimmerButton 16px wider
        // than the matching regular Button (Codex #386 P2 finding, round 3).
        Button.ButtonSize.Lg => "h-9 rounded-md px-2.5",
        Button.ButtonSize.Icon => "h-8 w-8",
        // Matches Button's Comfortable-density Xs geometry (h-6 px-2 text-xs); the
        // gap-1 override lives on InnerGapClass instead (see above).
        Button.ButtonSize.Xs => "h-6 px-2 text-xs",
    };
#pragma warning restore CS8524

    // The actual flex container laying out [icon/spinner] + [label] + [right icon] —
    // unlike the outer <button>, which wraps this single span and so cannot visibly
    // apply a gap-* utility at all. Codex #386 P2 finding 3 (round 3): the Xs arm's
    // gap-1 was applied to the outer button, so the rendered icon-to-label spacing
    // stayed at the inner span's hardcoded gap-2 (8px) instead of the intended 4px,
    // even though the class-string assertion passed.
    private string InnerContentClass => Cx.Join("relative z-10 inline-flex items-center justify-center", InnerGapClass);

    // Mirrors Button's own SizeOverrideClass: only Xs/Sm tighten the gap below
    // BaseClasses' default gap-2; Default/Lg/Icon keep gap-2 (shadcn's own
    // default/lg sizes don't override gap either). Not required to be exhaustive —
    // an unmatched future size falling back to gap-2 is the same safe default
    // Button.SizeOverrideClass itself uses (`_ => null`).
    private string InnerGapClass => Size switch
    {
        Button.ButtonSize.Xs => "gap-1",
        Button.ButtonSize.Sm => "gap-1.5",
        _ => "gap-2"
    };

    private string? PressEffectClass => PressEffect switch
    {
        Button.ButtonPressEffect.Scale => "lumeo-press-scale",
        Button.ButtonPressEffect.Brightness => "lumeo-press-brightness",
        Button.ButtonPressEffect.Ripple => "lumeo-press-ripple",
        _ => null
    };

    private string CssClass => string.Join(" ",
        new[] { BaseClasses, VariantClasses, SizeClasses, "cursor-pointer disabled:cursor-not-allowed", Shimmer ? "lumeo-shimmer" : null, PressEffectClass, Class }
            .Where(s => !string.IsNullOrWhiteSpace(s)));

    private string StyleString =>
        !string.IsNullOrWhiteSpace(ShimmerColor)
            ? $"--lumeo-shimmer-color: {ShimmerColor};"
            : string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Reconcile the ripple listener with the current PressEffect on EVERY render,
        // not just the first-render value (triage #18, mirrors Button.razor): a runtime
        // None->Ripple flip must now attach, and a Ripple->None flip must detach the
        // leaked listener. DisposeAsync handles the unmount teardown.
        if (PressEffect == Button.ButtonPressEffect.Ripple && !_rippleAttached)
        {
            try
            {
                await Interop.RippleAttachAsync(_el);
                _rippleAttached = true;
            }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        else if (PressEffect != Button.ButtonPressEffect.Ripple && _rippleAttached)
        {
            try
            {
                await Interop.RippleDetachAsync(_el);
            }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            _rippleAttached = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_rippleAttached)
        {
            try
            {
                await Interop.RippleDetachAsync(_el);
            }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
    }
}
