                                        <CommandItem FilterValue=""@option.Label"" OnSelect=""@(() => ToggleFacet(_statusFilter, option.Value))"">
                                            <div class=""@(""flex size-4 items-center justify-center rounded-[4px] border "" + (isSelected ? ""border-primary bg-primary text-primary-foreground"" : ""border-input [&_svg]:invisible""))"">
                                                <SvgGlyph Svg=""@(Lucide.Check)"" class=""size-3.5 text-primary-foreground"" />
                                            </div>
                                            <SvgGlyph Svg=""@(option.Icon)"" class=""size-4 text-muted-foreground"" />
                                            <span>@option.Label</span>
                                            @if (facet > 0)
                                            {
                                                <span class=""ml-auto flex size-4 items-center justify-center font-mono text-xs text-muted-foreground"">@facet</span>
                                            }
                                        </CommandItem>
                                    }
                                </CommandGroup>
                                @if (_statusFilter.Count > 0)
                                {
                                    <CommandSeparator />
                                    <CommandGroup>
                                        <CommandItem FilterValue=""Clear filters"" Class=""justify-center text-center"" OnSelect=""@(() => ClearFacet(_statusFilter))"">Clear filters</CommandItem>
                                    </CommandGroup>
                                }
                            </CommandList>
                        </Command>
                    </PopoverContent>
                </Popover>
                <Popover>
                    <PopoverTrigger>
                        <Button Variant=""Button.ButtonVariant.Outline"" Size=""Button.ButtonSize.Sm"" Class=""h-8 border-dashed"">
                            <SvgGlyph Svg=""@(Lucide.CirclePlus)"" />
                            Priority
                            @if (_priorityFilter.Count > 0)
                            {
                                <Separator Orientation=""Lumeo.Orientation.Vertical"" Class=""mx-2 h-4"" />
                                <Badge Variant=""Badge.BadgeVariant.Secondary"" Class=""rounded-sm px-1 font-normal lg:hidden"">@_priorityFilter.Count</Badge>
                                <div class=""hidden gap-1 lg:flex"">
                                    @if (_priorityFilter.Count > 2)
                                    {
                                        <Badge Variant=""Badge.BadgeVariant.Secondary"" Class=""rounded-sm px-1 font-normal"">@_priorityFilter.Count selected</Badge>
                                    }
                                    else
                                    {
                                        @foreach (var option in Priorities.Where(o => _priorityFilter.Contains(o.Value)))
                                        {
                                            <Badge Variant=""Badge.BadgeVariant.Secondary"" Class=""rounded-sm px-1 font-normal"">@option.Label</Badge>
                                        }
                                    }
                                </div>
                            }
                        </Button>
                    </PopoverTrigger>
                    <PopoverContent Align=""Lumeo.Align.Start"" Class=""w-[200px] p-0"">
                        <Command>
                            <CommandInput Placeholder=""Priority"" />
                            <CommandList>
                                <CommandEmpty>No results found.</CommandEmpty>
                                <CommandGroup>
                                    @foreach (var option in Priorities)
                                    {
                                        var isSelected = _priorityFilter.Contains(option.Value);
                                        var facet = FacetCount(""priority"", option.Value);
                                        <CommandItem FilterValue=""@option.Label"" OnSelect=""@(() => ToggleFacet(_priorityFilter, option.Value))"">
                                            <div class=""@(""flex size-4 items-center justify-center rounded-[4px] border "" + (isSelected ? ""border-primary bg-primary text-primary-foreground"" : ""border-input [&_svg]:invisible""))"">
                                                <SvgGlyph Svg=""@(Lucide.Check)"" class=""size-3.5 text-primary-foreground"" />
                                            </div>
                                            <SvgGlyph Svg=""@(option.Icon)"" class=""size-4 text-muted-foreground"" />
                                            <span>@option.Label</span>
                                            @if (facet > 0)
                                            {
                                                <span class=""ml-auto flex size-4 items-center justify-center font-mono text-xs text-muted-foreground"">@facet</span>
                                            }
                                        </CommandItem>
                                    }
                                </CommandGroup>
                                @if (_priorityFilter.Count > 0)
                                {
                                    <CommandSeparator />
                                    <CommandGroup>
                                        <CommandItem FilterValue=""Clear filters"" Class=""justify-center text-center"" OnSelect=""@(() => ClearFacet(_priorityFilter))"">Clear filters</CommandItem>
                                    </CommandGroup>
                                }
                            </CommandList>
                        </Command>
                    </PopoverContent>
                </Popover>
                @if (IsFiltered)
                {
                    <Button Variant=""Button.ButtonVariant.Ghost"" Size=""Button.ButtonSize.Sm"" OnClick=""@ResetFilters"">
                        Reset
                        <SvgGlyph Svg=""@(Lucide.X)"" />
                    </Button>
                }
            </div>
            <div class=""flex items-center gap-2"">
                <DropdownMenu>
                    <DropdownMenuTrigger AsChild>
                        <ChildContentSlot Context=""slot"">
                            <Button Variant=""Button.ButtonVariant.Outline"" Size=""Button.ButtonSize.Sm"" Class=""ml-auto hidden h-8 lg:flex"" id=""@slot.Id"" @attributes=""slot.Attributes"" OnClick=""slot.OnClick"">
                                <SvgGlyph Svg=""@(Lucide.Settings2)"" />
                                View
                            </Button>
                        </ChildContentSlot>
                    </DropdownMenuTrigger>
                    <DropdownMenuContent Align=""Lumeo.Align.End"" Class=""w-[150px]"">
                        <DropdownMenuLabel>Toggle columns</DropdownMenuLabel>
                        <DropdownMenuSeparator />
                        @foreach (var column in HideableColumns)
                        {
                            <DropdownMenuCheckboxItem Class=""capitalize"" Checked=""@(!_hidden.Contains(column))"" CheckedChanged=""@(on => SetVisible(column, on))"">@column</DropdownMenuCheckboxItem>
                        }
                    </DropdownMenuContent>
                </DropdownMenu>
                <Button Size=""Button.ButtonSize.Sm"">Add Task</Button>
            </div>
        </div>
        <div class=""overflow-hidden rounded-md border border-border"">
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead>
                            <Checkbox Checked=""@AllPageSelected"" IsIndeterminate=""@SomePageSelected"" CheckedChanged=""@ToggleAllPage"" AriaLabel=""Select all"" />
                        </TableHead>
                        <TableHead><div>Task</div></TableHead>
                        @if (!_hidden.Contains(""title""))
                        {
                            <TableHead>
                                <div class=""flex items-center gap-2"">
                                    <DropdownMenu>
                                        <DropdownMenuTrigger AsChild>
                                            <ChildContentSlot Context=""slot"">
                                                <Button Variant=""Button.ButtonVariant.Ghost"" Size=""Button.ButtonSize.Sm"" Class=""-ml-3 h-8 data-[state=open]:bg-accent"" id=""@slot.Id"" @attributes=""slot.Attributes"" OnClick=""slot.OnClick"">
                                                    <span>Title</span>
                                                    @if (_sortColumn == ""title"" && _sortDesc)
                                                    {
                                                        <SvgGlyph Svg=""@(Lucide.ArrowDown)"" />
                                                    }
                                                    else if (_sortColumn == ""title"")
                                                    {
                                                        <SvgGlyph Svg=""@(Lucide.ArrowUp)"" />
                                                    }
                                                    else
                                                    {
                                                        <SvgGlyph Svg=""@(Lucide.ChevronsUpDown)"" />
                                                    }
                                                </Button>
                                            </ChildContentSlot>
                                        </DropdownMenuTrigger>
                                        <DropdownMenuContent Align=""Lumeo.Align.Start"">
                                            <DropdownMenuItem OnClick=""@(() => Sort(""title"", false))""><SvgGlyph Svg=""@(Lucide.ArrowUp)"" />Asc</DropdownMenuItem>
                                            <DropdownMenuItem OnClick=""@(() => Sort(""title"", true))""><SvgGlyph Svg=""@(Lucide.ArrowDown)"" />Desc</DropdownMenuItem>
                                            <DropdownMenuSeparator />
                                            <DropdownMenuItem OnClick=""@(() => SetVisible(""title"", false))""><SvgGlyph Svg=""@(Lucide.EyeOff)"" />Hide</DropdownMenuItem>
                                        </DropdownMenuContent>
                                    </DropdownMenu>
                                </div>
                            </TableHead>
                        }
                        @if (!_hidden.Contains(""status""))
                        {
                            <TableHead>
                                <div class=""flex items-center gap-2"">
                                    <DropdownMenu>
                                        <DropdownMenuTrigger AsChild>
                                            <ChildContentSlot Context=""slot"">
                                                <Button Variant=""Button.ButtonVariant.Ghost"" Size=""Button.ButtonSize.Sm"" Class=""-ml-3 h-8 data-[state=open]:bg-accent"" id=""@slot.Id"" @attributes=""slot.Attributes"" OnClick=""slot.OnClick"">
                                                    <span>Status</span>
                                                    @if (_sortColumn == ""status"" && _sortDesc)
                                                    {
                                                        <SvgGlyph Svg=""@(Lucide.ArrowDown)"" />
                                                    }
                                                    else if (_sortColumn == ""status"")
                                                    {
                                                        <SvgGlyph Svg=""@(Lucide.ArrowUp)"" />
                                                    }
                                                    else
                                                    {
                                                        <SvgGlyph Svg=""@(Lucide.ChevronsUpDown)"" />
                                                    }
                                                </Button>
                                            </ChildContentSlot>
                                        </DropdownMenuTrigger>
                                        <DropdownMenuContent Align=""Lumeo.Align.Start"">
                                            <DropdownMenuItem OnClick=""@(() => Sort(""status"", false))""><SvgGlyph Svg=""@(Lucide.ArrowUp)"" />Asc</DropdownMenuItem>
                                            <DropdownMenuItem OnClick=""@(() => Sort(""status"", true))""><SvgGlyph Svg=""@(Lucide.ArrowDown)"" />Desc</DropdownMenuItem>
                                            <DropdownMenuSeparator />
                                            <DropdownMenuItem OnClick=""@(() => SetVisible(""status"", false))""><SvgGlyph Svg=""@(Lucide.EyeOff)"" />Hide</DropdownMenuItem>
                                        </DropdownMenuContent>
                                    </DropdownMenu>
                                </div>
                            </TableHead>
                        }
                        @if (!_hidden.Contains(""priority""))
                        {
                            <TableHead>
                                <div class=""flex items-center gap-2"">
                                    <DropdownMenu>
                                        <DropdownMenuTrigger AsChild>
                                            <ChildContentSlot Context=""slot"">
                                                <Button Variant=""Button.ButtonVariant.Ghost"" Size=""Button.ButtonSize.Sm"" Class=""-ml-3 h-8 data-[state=open]:bg-accent"" id=""@slot.Id"" @attributes=""slot.Attributes"" OnClick=""slot.OnClick"">
                                                    <span>Priority</span>
                                                    @if (_sortColumn == ""priority"" && _sortDesc)
                                                    {
                                                        <SvgGlyph Svg=""@(Lucide.ArrowDown)"" />
                                                    }
                                                    else if (_sortColumn == ""priority"")
                                                    {
                                                        <SvgGlyph Svg=""@(Lucide.ArrowUp)"" />
                                                    }
                                                    else
                                                    {
                                                        <SvgGlyph Svg=""@(Lucide.ChevronsUpDown)"" />
                                                    }
                                                </Button>
                                            </ChildContentSlot>
                                        </DropdownMenuTrigger>
                                        <DropdownMenuContent Align=""Lumeo.Align.Start"">
                                            <DropdownMenuItem OnClick=""@(() => Sort(""priority"", false))""><SvgGlyph Svg=""@(Lucide.ArrowUp)"" />Asc</DropdownMenuItem>
                                            <DropdownMenuItem OnClick=""@(() => Sort(""priority"", true))""><SvgGlyph Svg=""@(Lucide.ArrowDown)"" />Desc</DropdownMenuItem>
                                            <DropdownMenuSeparator />
                                            <DropdownMenuItem OnClick=""@(() => SetVisible(""priority"", false))""><SvgGlyph Svg=""@(Lucide.EyeOff)"" />Hide</DropdownMenuItem>
                                        </DropdownMenuContent>
                                    </DropdownMenu>
                                </div>
                            </TableHead>
                        }
                        <TableHead></TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @if (PageRows.Count == 0)
                    {
                        <TableRow>
                            <TableCell colspan=""@ColumnCount"" Class=""h-24 text-center"">No results.</TableCell>
                        </TableRow>
                    }
                    else
                    {
                        @foreach (var task in PageRows)
                        {
                            <TableRow data-state=""@(_selected.Contains(task.Id) ? ""selected"" : null)"">
                                <TableCell>
                                    <Checkbox Checked=""@_selected.Contains(task.Id)"" CheckedChanged=""@(on => ToggleRow(task.Id, on))"" AriaLabel=""Select row"" />
                                </TableCell>
                                <TableCell><div class=""w-[80px]"">@task.Id</div></TableCell>
                                @if (!_hidden.Contains(""title""))
                                {
                                    <TableCell>
                                        <div class=""flex gap-2"">
                                            <Badge Variant=""Badge.BadgeVariant.Outline"">@LabelOf(task.Label)</Badge>
                                            <span class=""max-w-[500px] truncate font-medium"">@task.Title</span>
                                        </div>
                                    </TableCell>
                                }
                                @if (!_hidden.Contains(""status""))
                                {
                                    var status = Statuses.First(s => s.Value == task.Status);
                                    <TableCell>
                                        <div class=""flex w-[100px] items-center gap-2"">
                                            <SvgGlyph Svg=""@(status.Icon)"" class=""size-4 text-muted-foreground"" />
                                            <span>@status.Label</span>
                                        </div>
                                    </TableCell>
                                }
                                @if (!_hidden.Contains(""priority""))
                                {
                                    var priority = Priorities.First(p => p.Value == task.Priority);
                                    <TableCell>
                                        <div class=""flex items-center gap-2"">
                                            <SvgGlyph Svg=""@(priority.Icon)"" class=""size-4 text-muted-foreground"" />
                                            <span>@priority.Label</span>
                                        </div>
                                    </TableCell>
                                }
                                <TableCell>
                                    <DropdownMenu>
                                        <DropdownMenuTrigger AsChild>
                                            <ChildContentSlot Context=""slot"">
                                                <Button Variant=""Button.ButtonVariant.Ghost"" Size=""Button.ButtonSize.Icon"" Class=""size-8 data-[state=open]:bg-muted"" id=""@slot.Id"" @attributes=""slot.Attributes"" OnClick=""slot.OnClick"">
                                                    <SvgGlyph Svg=""@(Lucide.Ellipsis)"" />
                                                    <span class=""sr-only"">Open menu</span>
                                                </Button>
                                            </ChildContentSlot>
                                        </DropdownMenuTrigger>
                                        <DropdownMenuContent Align=""Lumeo.Align.End"" Class=""w-[160px]"">
                                            <DropdownMenuItem>Edit</DropdownMenuItem>
                                            <DropdownMenuItem>Make a copy</DropdownMenuItem>
                                            <DropdownMenuItem>Favorite</DropdownMenuItem>
                                            <DropdownMenuSeparator />
                                            <DropdownMenuSub>
                                                <DropdownMenuSubTrigger>Labels</DropdownMenuSubTrigger>
                                                <DropdownMenuSubContent>
                                                    <DropdownMenuRadioGroup Value=""@task.Label"" ValueChanged=""@(v => task.Label = v)"">
                                                        @foreach (var label in Labels)
                                                        {
                                                            <DropdownMenuRadioItem Value=""@label.Value"">@label.Label</DropdownMenuRadioItem>
                                                        }
                                                    </DropdownMenuRadioGroup>
                                                </DropdownMenuSubContent>
                                            </DropdownMenuSub>
                                            <DropdownMenuSeparator />
                                            <DropdownMenuItem Variant=""MenuItemVariant.Destructive"">Delete<DropdownMenuShortcut>⌘⌫</DropdownMenuShortcut></DropdownMenuItem>
                                        </DropdownMenuContent>
                                    </DropdownMenu>
                                </TableCell>
                            </TableRow>
                        }
                    }
                </TableBody>
            </Table>
        </div>
        <div class=""flex items-center justify-between px-2"">
            <div class=""flex-1 text-sm text-muted-foreground"">@FilteredSelectedCount of @Filtered.Count row(s) selected.</div>
            <div class=""flex items-center space-x-6 lg:space-x-8"">
                <div class=""flex items-center space-x-2"">
                    <p class=""text-sm font-medium"">Rows per page</p>
                    <Select Value=""@_pageSize.ToString()"" ValueChanged=""@(v => SetPageSize(v))"">
                        <SelectTrigger Class=""h-8 w-[70px]"">@_pageSize</SelectTrigger>
                        <SelectContent>
                            @foreach (var size in new[] { 10, 20, 25, 30, 40, 50 })
                            {
                                <SelectItem Value=""@size.ToString()"">@size</SelectItem>
                            }
                        </SelectContent>
                    </Select>
                </div>
                <div class=""flex w-[100px] items-center justify-center text-sm font-medium"">Page @(Page + 1) of @PageCount</div>
                <div class=""flex items-center space-x-2"">
                    <Button Variant=""Button.ButtonVariant.Outline"" Size=""Button.ButtonSize.Icon"" Class=""hidden size-8 lg:flex"" OnClick=""@(() => GoTo(0))"" Disabled=""@(Page == 0)"">
                        <span class=""sr-only"">Go to first page</span>
                        <SvgGlyph Svg=""@(Lucide.ChevronsLeft)"" />
                    </Button>
                    <Button Variant=""Button.ButtonVariant.Outline"" Size=""Button.ButtonSize.Icon"" Class=""size-8"" OnClick=""@(() => GoTo(Page - 1))"" Disabled=""@(Page == 0)"">
                        <span class=""sr-only"">Go to previous page</span>
                        <SvgGlyph Svg=""@(Lucide.ChevronLeft)"" />
                    </Button>
                    <Button Variant=""Button.ButtonVariant.Outline"" Size=""Button.ButtonSize.Icon"" Class=""size-8"" OnClick=""@(() => GoTo(Page + 1))"" Disabled=""@(Page >= PageCount - 1)"">
                        <span class=""sr-only"">Go to next page</span>
                        <SvgGlyph Svg=""@(Lucide.ChevronRight)"" />
                    </Button>
                    <Button Variant=""Button.ButtonVariant.Outline"" Size=""Button.ButtonSize.Icon"" Class=""hidden size-8 lg:flex"" OnClick=""@(() => GoTo(PageCount - 1))"" Disabled=""@(Page >= PageCount - 1)"">
                        <span class=""sr-only"">Go to last page</span>
                        <SvgGlyph Svg=""@(Lucide.ChevronsRight)"" />
                    </Button>
                </div>
            </div>
        </div>
    </div>
</div>";

