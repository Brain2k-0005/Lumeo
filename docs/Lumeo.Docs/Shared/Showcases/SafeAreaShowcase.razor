@namespace Lumeo.Docs.Shared.Showcases

@* SafeArea's env(safe-area-inset-*) padding is 0px on desktop browsers and most Android
   devices (see the component's own docs page note) — it only does real work on notched
   iPhones. A static preview can't demonstrate a real inset, so this is a faithful
   rendition of the component's canonical use — a bottom tab bar — exactly as it renders. *@
<div class="w-full max-w-[22rem] rounded-lg border border-border/40 bg-background overflow-hidden">
    <Stack Gap="2" Class="p-3">
        <div class="rounded-md border border-border/40 px-3 py-2 text-xs text-foreground">List item 1</div>
        <div class="rounded-md border border-border/40 px-3 py-2 text-xs text-foreground">List item 2</div>
    </Stack>
    <Flex Justify="around" Class="border-t border-border/40 py-2.5">
        <Stack Align="center" Gap="0.5">
            <SvgGlyph Svg="@(Lucide.House)" class="h-4 w-4" />
            <Lumeo.Text Size="xs">Home</Lumeo.Text>
        </Stack>
        <Stack Align="center" Gap="0.5">
            <SvgGlyph Svg="@(Lucide.Search)" class="h-4 w-4" />
            <Lumeo.Text Size="xs">Search</Lumeo.Text>
        </Stack>
        <Stack Align="center" Gap="0.5">
            <SvgGlyph Svg="@(Lucide.User)" class="h-4 w-4" />
            <Lumeo.Text Size="xs">Profile</Lumeo.Text>
        </Stack>
    </Flex>
</div>
