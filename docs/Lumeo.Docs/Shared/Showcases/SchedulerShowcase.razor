@namespace Lumeo.Docs.Shared.Showcases
@using Lumeo

@* LIVE (see ../README.md): SatelliteBoundShowcase now lazy-loads Lumeo.Scheduler.dll
   (ShowcaseResolver.SatelliteAssembliesFor) before this mounts. SchedulerView.List renders
   the same agenda-row markup the old static replica hand-copied, so three fixed events in a
   slightly taller card (h-40, still inside the aspect-[16/9] preview box's own budget) show
   the real toolbar + list with no page-scroll trap. Fixed InitialDate (no DateTime.Now, per
   rule 1) so "today" always lands on the day the events are on. Interactive: click an event
   to select it, Today/prev/next in the toolbar work.*@

<div class="w-full max-w-[22rem] h-40 rounded-md border border-border/60 overflow-hidden bg-background">
    <Scheduler Events="_events" InitialView="SchedulerView.List" InitialDate="new DateTime(2026, 3, 9)"
               Height="160px" Editable="false" />
</div>

@code {
    private readonly List<SchedulerEvent> _events =
    [
        new("design-sync", "Design sync", new DateTime(2026, 3, 9, 10, 0, 0), new DateTime(2026, 3, 9, 10, 30, 0)),
        new("release", "Release readiness", new DateTime(2026, 3, 9, 15, 0, 0), new DateTime(2026, 3, 9, 15, 30, 0), Color: "var(--color-chart-2)"),
        new("client-call", "Client call", new DateTime(2026, 3, 9, 16, 30, 0), new DateTime(2026, 3, 9, 17, 0, 0), Color: "var(--color-chart-4)"),
    ];
}
