@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Cascader Options="@_options" Value="@_value" ValueChanged="@(v => _value = v)" Placeholder="Select location..." Class="w-full" />
</div>

@code {
    private List<string>? _value = new() { "na", "us", "ca" };

    private readonly List<Cascader.CascaderOption> _options = new()
    {
        new()
        {
            Label = "North America", Value = "na",
            Children = new()
            {
                new()
                {
                    Label = "United States", Value = "us",
                    Children = new()
                    {
                        new() { Label = "California", Value = "ca" },
                        new() { Label = "New York", Value = "ny" },
                    }
                },
            }
        },
        new()
        {
            Label = "Europe", Value = "eu",
            Children = new()
            {
                new() { Label = "Germany", Value = "de" },
            }
        },
    };
}
