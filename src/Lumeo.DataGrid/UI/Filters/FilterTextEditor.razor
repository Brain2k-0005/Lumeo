@namespace Lumeo

<div data-slot="filter-editor" class="@Cx.Merge("flex w-72 max-w-[calc(100vw-2rem)] min-w-0 flex-col gap-2 p-2", Context.Field.Class, Class)" @attributes="AdditionalAttributes" @onkeydown="HandleKeyDown">
    <div class="@(Context.Host == FilterEditorHost.Amend ? FilterStyles.FieldGroup : "flex w-full items-stretch")">
        <Input id="@Context.AutoFocusId"
               Value="@(Context.Value as string ?? "")"
               OnInput="e => Context.SetValue(e.Value?.ToString())"
               Placeholder="@(Context.Field.Placeholder ?? Context.Labels.ValuePlaceholder)"
               Size="Context.Size"
               Class="@FilterStyles.InputClass(Context.Size, fused: Context.Host == FilterEditorHost.Amend)"
               aria-label="@Context.Field.Label" />
        @if (Context.Host == FilterEditorHost.Amend)
        {
            <FilterEditorButtons Context="Context" Fused="true" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public FilterEditorContext Context { get; set; } = default!;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Context.Commit();
        else if (e.Key == "Escape") Context.Cancel();
    }
}
