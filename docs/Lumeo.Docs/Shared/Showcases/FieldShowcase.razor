@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <FieldGroup>
        <Field>
            <FieldLabel For="field-showcase-email">Email</FieldLabel>
            <Input id="field-showcase-email" Type="email" Placeholder="m@example.com" />
        </Field>
        <Field Orientation="Field.FieldOrientation.Horizontal">
            <Checkbox id="field-showcase-terms" />
            <FieldContent>
                <FieldLabel For="field-showcase-terms">Accept terms</FieldLabel>
            </FieldContent>
        </Field>
    </FieldGroup>
</div>
