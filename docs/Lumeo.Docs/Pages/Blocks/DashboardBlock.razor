                                </Select>
                            </div>
                            <div class="flex flex-col gap-3">
                                <Label For="dash-drawer-status">Status</Label>
                                <Select Value="@(_drawerItem?.Status)">
                                    <SelectTrigger id="dash-drawer-status" Class="w-full">@(_drawerItem?.Status)</SelectTrigger>
                                    <SelectContent>
                                        <SelectItem Value="Done">Done</SelectItem>
                                        <SelectItem Value="In Progress">In Progress</SelectItem>
                                        <SelectItem Value="Not Started">Not Started</SelectItem>
                                    </SelectContent>
                                </Select>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="flex flex-col gap-3">
                                <Label For="dash-drawer-target">Target</Label>
                                <Input id="dash-drawer-target" Value="@(_drawerItem?.Target)" />
                            </div>
                            <div class="flex flex-col gap-3">
                                <Label For="dash-drawer-limit">Limit</Label>
                                <Input id="dash-drawer-limit" Value="@(_drawerItem?.Limit)" />
                            </div>
                        </div>
                        <div class="flex flex-col gap-3">
                            <Label For="dash-drawer-reviewer">Reviewer</Label>
                            <Select Value="@(_drawerItem?.Reviewer)">
                                <SelectTrigger id="dash-drawer-reviewer" Class="w-full">@(_drawerItem?.Reviewer)</SelectTrigger>
                                <SelectContent>
                                    <SelectItem Value="Eddie Lake">Eddie Lake</SelectItem>
                                    <SelectItem Value="Jamik Tashpulatov">Jamik Tashpulatov</SelectItem>
                                    <SelectItem Value="Emily Whalen">Emily Whalen</SelectItem>
                                </SelectContent>
                            </Select>
