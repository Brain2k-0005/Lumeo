@namespace Lumeo.Docs.Shared.Showcases

@* 2 items (not 3) with a one-line answer each, and tightened trigger/content padding
   (py-2/pb-2 instead of the default py-4/pb-4) — the default 3-item demo from the docs
   page is taller than the 16:9 preview box and used to get clipped. See
   Showcases/README.md rule 2. *@
<div class="w-full max-w-[22rem]">
    <Accordion Type="Accordion.AccordionType.Single" DefaultValues="@(new List<string> { "item-1" })">
        <AccordionItem Value="item-1">
            <AccordionTrigger Class="py-2">Is it accessible?</AccordionTrigger>
            <AccordionContent Class="pb-2">Yes — WAI-ARIA compliant.</AccordionContent>
        </AccordionItem>
        <AccordionItem Value="item-2">
            <AccordionTrigger Class="py-2">Is it styled?</AccordionTrigger>
            <AccordionContent Class="pb-2">Yes, matches the theme.</AccordionContent>
        </AccordionItem>
    </Accordion>
</div>
