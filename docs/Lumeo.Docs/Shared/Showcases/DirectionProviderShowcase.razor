@namespace Lumeo.Docs.Shared.Showcases
@using Lumeo.Services

<div class="w-full max-w-[22rem]">
    <Stack Gap="3">
        <Stack Gap="1">
            <Lumeo.Text Size="xs" Color="muted">Ltr</Lumeo.Text>
            <DirectionProvider Direction="LayoutDirection.Ltr" Class="rounded-lg border border-border p-2">
                <Flex Align="center" Gap="2">
                    <SvgGlyph Svg="@(Lucide.Info)" class="h-4 w-4 text-primary shrink-0" />
                    <Lumeo.Text Size="xs">Icon on the left</Lumeo.Text>
                    <Button Size="Button.ButtonSize.Sm" Class="ms-auto">Go</Button>
                </Flex>
            </DirectionProvider>
        </Stack>
        <Stack Gap="1">
            <Lumeo.Text Size="xs" Color="muted">Rtl</Lumeo.Text>
            <DirectionProvider Direction="LayoutDirection.Rtl" Class="rounded-lg border border-border p-2">
                <Flex Align="center" Gap="2">
                    <SvgGlyph Svg="@(Lucide.Info)" class="h-4 w-4 text-primary shrink-0" />
                    <Lumeo.Text Size="xs">Icon on the right</Lumeo.Text>
                    <Button Size="Button.ButtonSize.Sm" Class="ms-auto">Go</Button>
                </Flex>
            </DirectionProvider>
        </Stack>
    </Stack>
</div>
