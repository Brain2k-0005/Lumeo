@namespace Lumeo
@* shadcn's FieldSet: a <fieldset> that stacks its fields. Measured live 2026-09-02: gap 16px. *@
<fieldset data-slot="field-set" class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</fieldset>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS classes, merged after the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Cx.Merge("flex flex-col gap-4", Class);
}
