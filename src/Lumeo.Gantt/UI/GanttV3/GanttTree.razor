@namespace Lumeo
@using System.ComponentModel
@using System.Linq
@using Lumeo.GanttV3
@implements IAsyncDisposable
@inject Lumeo.Services.IComponentInteropService Interop
@inject Lumeo.Services.IThemeService Theme
@inject Lumeo.Services.Localization.ILumeoLocalizer L
@attribute [EditorBrowsable(EditorBrowsableState.Never)]

@* GanttTree — v3's left tree/list pane (design spec Phase 2, T3): one row per
   entry in Rows, the IDENTICAL row list GanttTimeline renders bars against
   (see GanttRowModel), so the two panes always align — same GanttScale.RowHeight
   per row, same order, same collapse-filtered visibility. Renders the task
   name (or, for a flat-grouping GanttRowKind.GroupHeader row, the group's
   label) indented per Depth, with a chevron toggle on any collapsible row
   (a hierarchy parent, or a group header).

   Purely presentational, same contract as GanttNav: every interaction
   bubbles up via OnToggleCollapse into whatever owns GanttState (Gantt3) —
   this component never touches GanttState itself. The leading spacer div
   matches GanttTimeline's two-row header height so the two panes' row
   canvases start at the same Y (Phase 2's "one shared scroll container"
   design — see Gantt3's remarks — relies on this alignment, not on any
   scroll-sync JS).

   Design spec Phase 3, T5 — three additions, kept structurally separate:
    - TreeColumns/TreeHeaderMenu: extra fixed-width columns rendered AFTER the
      pinned name column, plus a header-row slot. The header spacer (blank
      before T5) is now a real header ROW — its height stays HARD-PINNED to
      GanttScale.HeaderHeight (`overflow-hidden`, no auto-growth from a tall
      column title) precisely because that pinned height is what keeps this
      pane's row canvas starting at the SAME Y as GanttTimeline's — the entire
      row-alignment guarantee (see GanttRowModel's own remarks) rests on
      NEITHER pane's header nor any one row ever growing past its own fixed
      slot, however tall a caller's CellTemplate/RowTemplate content is.
    - RowTemplate: replaces ONLY the label span inside the name cell — the
      indent spacer and expander/toggle button are unconditionally rendered
      by THIS component regardless, so a custom template can never lose the
      chrome that makes the tree navigable (see RowTemplate's own remarks).
    - The splitter: a dedicated handle at this pane's own trailing (inline-end)
      edge, resizing the pinned name column. Live-drag visuals are JS-only,
      direct DOM mutation (no Blazor round-trip mid-gesture — see
      SyncSplitterRegistrationAsync's own remarks) via ONE CSS custom property
      (--lumeo-gantt-tree-name-width) set on THIS component's own root and
      inherited by every name-cell (header's and every row's), so a live
      drag needs exactly one style write per pointermove regardless of how
      many rows are currently virtualized/rendered.

   Design spec Phase 3, T6 — two more additions, kept structurally separate:
    - ShowRowCheckboxes: a checkbox rendered before the indent spacer on
      every row. A leaf task row's checkbox is a direct SelectedIds
      membership toggle; a parent/group row's is a TRI-STATE
      select-descendants view (GanttSelectionModel), following the SAME
      Checked/IsIndeterminate idiom DataGridHeader's own "select all"
      checkbox already established — no second selection idiom invented for
      GanttV3. SelectedIds only ever contains LEAF ids (see
      GanttSelectionModel's own remarks on why).
    - AllowRowReorder: a drag grip rendered before the checkbox on every TASK
      row (never a GroupHeader row — see GanttReorderModel's own remarks),
      wired through a THIRD gantt-v3.js registration channel
      (registerRowReorderDrag) that reuses the SAME conventions as the
      splitter/move-resize drag engines (pointer capture, a per-gesture
      snapshot, pointer-id isolation, activeCleanups) — ghost row + drop-index
      line, reorder confined to the dragged row's own "bucket" (same
      ParentId, or same GroupLabel in flat mode — cross-bucket moves are
      out of scope, never offered by the drag UI at all). Readonly disables
      BOTH additions server-side (checkbox Disabled + the JSInvokables
      themselves no-op fresh on every call — Phase-2 lesson: a gesture
      already in flight at the moment of a runtime Readonly flip must still
      no-op on commit, not just fail to register a NEW one).

   NOTE (accessibility): see GanttBar.razor's NOTE — the Razor compiler always
   generates a component's class as `public`, so despite the task spec asking
   for `internal`, this stays `public` and its new members are recorded in
   PublicAPI.Unshipped.txt; flagged for the reviewer/team lead to confirm.
   [EditorBrowsable(Never)] keeps this working-name API out of consumer
   IntelliSense until the Phase-4 rename (fix-round follow-up). *@
<div class="@RootClass" style="@RootStyle" @ref="_paneRef" @attributes="AdditionalAttributes">
    @* Bug fix (Codex round 4, P2 #1) — see the original remarks below, still
       correct: `sticky top-0` pins JUST this header row (not the whole tree
       pane), matching GanttTimeline's own sticky header in the sibling pane.
       Design spec Phase 3, T5: this is now a REAL header row (name-cell +
       any TreeColumns + TreeHeaderMenu), not a blank spacer — HeaderRowStyle's
       explicit `height:{HeaderHeight}px` + `overflow-hidden` on this div is
       load-bearing (see the class remarks above): a caller's column Title
       string is free text with no length contract, and letting it grow this
       row even a few pixels taller would push every row below it out of
       lockstep with GanttTimeline's own header/row canvas. *@
    <div class="sticky top-0 z-10 flex items-center overflow-hidden bg-card" style="@HeaderRowStyle"
        <span class="lumeo-gantt-v3-tree-header-name-cell shrink-0" style="@NameCellStyle"></span>
        @if (TreeColumns is { Count: > 0 })
        {
            @foreach (var column in TreeColumns)
            {
                <span class="lumeo-gantt-v3-tree-header-cell shrink-0 truncate px-2 text-xs font-medium text-muted-foreground" style="@ColumnCellStyle(column)">@column.Title</span>
            }
        }
        @if (TreeHeaderMenu is not null)
        {
            <span class="lumeo-gantt-v3-tree-header-menu ms-auto shrink-0 px-1">@TreeHeaderMenu</span>
        }
    </div>
    @* Virtualized (Codex round 2, P2 #10) — mirrors GanttTimeline's own
       Virtualize (same Rows list, same GanttScale.RowHeight ItemSize) so both
       panes stay consistent: before this fix, GanttTree rendered every row's
       markup unconditionally while GanttTimeline (already virtualized since
       T2) only materialized the visible slice — harmless for row ALIGNMENT
       (both still occupy one ItemSize-tall slot per row, virtualized or not),
       but meant a very long/deep tree paid the tree pane's full DOM cost on
       every render regardless of what was actually scrolled into view. *@
    <Virtualize Items="@RowItems" Context="row" ItemSize="@((float)GanttScale.RowHeight)">
        @* data-task-id/-reorder-bucket/-reorder-index are gated on
           ReorderPointerActive (not unconditional) DELIBERATELY — Gantt3's
           root wraps BOTH this pane and GanttTimeline, whose OWN bars
           already carry data-task-id (existing E2E specs, e.g.
           GanttV3TreeColumnsSplitterTests, locate a bar via an UNSCOPED-past-
           the-shared-root `[data-task-id='...']` selector that assumes
           exactly one match); an ALWAYS-rendered data-task-id on a tree row
           too would make every such selector ambiguous the moment a tree
           pane is visible. Gating on the one feature that actually consumes
           it (registerRowReorderDrag's own `closest('[data-task-id]')` hit
           test) keeps every existing route byte-identical unless a caller
           opts into AllowRowReorder. *@
        <div class="@RowClass(row)" style="@RowStyle" data-row-kind="@(row.Kind == GanttRowKind.GroupHeader ? "group" : "task")"
             data-task-id="@(ReorderPointerActive && row.Kind == GanttRowKind.Task ? row.Task!.Id : null)"
             data-reorder-bucket="@(ReorderPointerActive && row.Kind == GanttRowKind.Task ? ReorderBucketOf(row.Task!) : null)"
             data-reorder-index="@(ReorderPointerActive && row.Kind == GanttRowKind.Task ? ReorderIndexOf(row.Task!) : null)">
            <span class="lumeo-gantt-v3-tree-name-cell flex shrink-0 items-center gap-1 px-2" style="@NameCellStyle">
                @* Design spec Phase 3, T6 — reorder grip, leftmost so its column
                   aligns vertically regardless of a row's own indent depth
                   (same reasoning DataGridRow's own leading grip/selection
                   cells document). Never for a GroupHeader row (no GanttTask
                   to reorder — see GanttReorderModel's own remarks). *@
                @if (row.Kind == GanttRowKind.Task && ReorderPointerActive)
                {
                    <span data-row-reorder-grip
                          class="lumeo-gantt-v3-tree-reorder-grip inline-flex h-4 w-4 shrink-0 cursor-grab touch-none items-center justify-center text-muted-foreground/60 opacity-60 hover:opacity-100 active:cursor-grabbing"
                          aria-label="@L["Gantt.DragToReorderRow", row.Label]"
                          title="@L["Gantt.DragToReorderRow", row.Label]">
                        <SvgGlyph Svg="@(LumeoIcons.GripVertical)" class="h-3.5 w-3.5" />
                    </span>
                }
                else if (row.Kind == GanttRowKind.Task && AllowRowReorder && Readonly)
                {
                    @* Inert-but-visible grip while Readonly — mirrors
                       Lumeo.DataGrid's own RowReorderPointerActive-false
                       treatment (dimmed, no data-row-reorder-grip marker so
                       the delegated JS listener never even hit-tests it)
                       rather than disappearing outright. *@
                    <span class="lumeo-gantt-v3-tree-reorder-grip inline-flex h-4 w-4 shrink-0 cursor-not-allowed items-center justify-center text-muted-foreground/30"
                          aria-hidden="true"
                          title="@L["Gantt.RowReorderUnavailable"]">
                        <SvgGlyph Svg="@(LumeoIcons.GripVertical)" class="h-3.5 w-3.5" />
                    </span>
                }
                @if (ShowRowCheckboxes)
                {
                    var (isChecked, isIndeterminate) = CheckboxState(row);
                    <Checkbox Checked="@isChecked" IsIndeterminate="@isIndeterminate" Disabled="@Readonly"
                              CheckedChanged="@(v => HandleCheckChangedAsync(row, v))"
                              AriaLabel="@(row.HasChildren ? L["Gantt.SelectRowGroup", row.Label] : L["Gantt.SelectRow", row.Label])"
                              Class="lumeo-gantt-v3-tree-checkbox shrink-0" />
                }
                <span class="lumeo-gantt-v3-tree-indent shrink-0" style="@IndentStyle(row)"></span>
                @if (row.ToggleKey is not null)
                {
                    <button type="button"
                            class="lumeo-gantt-v3-tree-toggle inline-flex h-4 w-4 shrink-0 items-center justify-center"
                            aria-expanded="@((!row.IsCollapsed).ToString().ToLower())"
                            aria-label="@(row.IsCollapsed ? L["Gantt.ExpandRow", row.Label] : L["Gantt.CollapseRow", row.Label])"
                            @onclick="() => HandleToggleAsync(row.ToggleKey)">
                        <SvgGlyph Svg="@(row.IsCollapsed ? LumeoIcons.ChevronRight : LumeoIcons.ChevronDown)" class="h-3.5 w-3.5" />
                    </button>
                }
                else
                {
                    <span class="lumeo-gantt-v3-tree-toggle-spacer inline-block h-4 w-4 shrink-0"></span>
                }
                @* Design spec Phase 3, T5 — RowTemplate replaces ONLY this
                   label span. Never invoked for a row with no Task (a
                   GroupHeader row) — there is no GanttTask to hand it. *@
                @if (RowTemplate is not null && row.Task is not null)
                {
                    @RowTemplate(row.Task)
                }
                else
                {
                    <span class="lumeo-gantt-v3-tree-label truncate text-sm">@row.Label</span>
                }
            </span>
            @if (TreeColumns is { Count: > 0 })
            {
                @foreach (var column in TreeColumns)
                {
                    @* No Task (a GroupHeader row) -> an intentionally EMPTY
                       cell, not a skipped one — column alignment across every
                       row kind depends on every row emitting the same set of
                       fixed-width cells regardless of what's inside them. *@
                    <span class="lumeo-gantt-v3-tree-cell shrink-0 truncate px-2 text-sm" style="@ColumnCellStyle(column)">
                        @if (row.Task is not null)
                        {
                            @column.CellTemplate(row.Task)
                        }
                    </span>
                }
            }
        </div>
    </Virtualize>
    @* Design spec Phase 3, T5 — the tree/timeline splitter handle. A
       dedicated, single, non-delegated pointer target (unlike gantt-v3.js's
       bar-drag engine, which delegates ONE listener over many recycled bars —
       there is only ever one divider) at this pane's own trailing edge, so it
       sits at the physical boundary shared with GanttTimeline under BOTH LTR
       (`end-0` = physical right) and RTL (`end-0` = physical left — same
       logical-property mechanism this pane's own `start-0` sticky positioning
       already relies on; see RootClass' remarks). `touch-none` here is a
       SCOPED, narrow use on a dedicated non-scrolling drag handle — the exact
       same idiom Lumeo's own SplitterDivider/ResizableHandle already use on
       THEIR handles — not the blanket touch-action:none that caused the PR
       #381 dead-scroll-zone regression (that was applied broadly to elements
       that ALSO needed to pass through vertical touch-scroll; this element
       never does). *@
    <div @ref="_dividerRef"
         role="separator"
         aria-orientation="vertical"
         aria-label="@L["Gantt.ResizeTreePane"]"
         aria-valuenow="@((int)Math.Round(TreePaneWidth))"
         aria-valuemin="@GanttScale.MinTreePaneWidth"
         aria-valuemax="@GanttScale.MaxTreePaneWidth"
         tabindex="0"
         class="lumeo-gantt-v3-tree-splitter absolute inset-y-0 end-0 z-30 w-1.5 cursor-col-resize touch-none select-none hover:bg-primary/40 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
         @onkeydown="OnSplitterKeyDown">
    </div>
</div>

@code {
    /// <summary>The visible row list — identical to what's fed to GanttTimeline/GanttArrowLayer (design spec: single source of truth for row order/visibility).</summary>
    [Parameter] public IReadOnlyList<GanttVisibleRow> Rows { get; set; } = Array.Empty<GanttVisibleRow>();

    /// <summary>Raised with a row's <see cref="GanttVisibleRow.ToggleKey"/> when its chevron is clicked. The owner (Gantt3) applies it via <c>GanttState.ToggleCollapsed</c>.</summary>
    [Parameter] public EventCallback<string> OnToggleCollapse { get; set; }

    /// <summary>Extra columns rendered after the pinned name column (design spec Phase 3, T5). Null/empty renders exactly the single name column.</summary>
    [Parameter] public IReadOnlyList<GanttTreeColumn>? TreeColumns { get; set; }

    /// <summary>Slot rendered in the header row, after any column titles (design spec Phase 3, T5 — REUI "columns menu in header slot").</summary>
    [Parameter] public RenderFragment? TreeHeaderMenu { get; set; }

    /// <summary>Replaces a row's default label-cell content when set (design spec Phase 3, T5). The indent spacer and expander/toggle button are ALWAYS rendered by this component regardless — see the class remarks. Never invoked for a row with no <see cref="GanttVisibleRow.Task"/>.</summary>
    [Parameter] public RenderFragment<GanttTask>? RowTemplate { get; set; }

    /// <summary>
    /// The pinned name column's CURRENT resolved width in pixels. Gantt3 owns
    /// clamping and the controlled-vs-uncontrolled resolution (see its own
    /// <c>EffectiveTreePaneWidth</c>) — this component only renders whatever it
    /// is handed and reports completed drag/keyboard gestures via
    /// <see cref="OnResize"/>.
    /// </summary>
    [Parameter] public double TreePaneWidth { get; set; } = GanttScale.DefaultTreePaneWidth;

    /// <summary>
    /// Raised once per completed splitter gesture (a pointer-drag release via
    /// <see cref="CommitSplitterWidth"/>, or a keyboard nudge) with the new
    /// width. NOT raised continuously while dragging — the live visual is
    /// JS-only (see <see cref="SyncSplitterRegistrationAsync"/>'s own remarks).
    /// </summary>
    [Parameter] public EventCallback<double> OnResize { get; set; }

    /// <summary>
    /// The full task list <see cref="Rows"/> was built from (design spec Phase
    /// 3, T6) — used to compute per-row checkbox tri-state (<see
    /// cref="GanttSelectionModel"/>) and reorder bucket/index (<see
    /// cref="GanttReorderModel"/>), BOTH of which must see descendants/siblings
    /// hidden behind a collapsed ancestor, unlike the already collapse-filtered
    /// <see cref="Rows"/> — mirrors <see cref="Lumeo.GanttTimeline"/>'s own
    /// separate <c>Tasks</c> parameter for the identical reason (its own
    /// <c>Rollups</c>).
    /// </summary>
    [Parameter] public IReadOnlyList<GanttTask> Tasks { get; set; } = Array.Empty<GanttTask>();

    /// <summary>
    /// Ids of currently-selected LEAF rows (design spec Phase 3, T6 — see <see
    /// cref="GanttSelectionModel"/>'s own remarks for exactly which rows can be
    /// members). <c>Gantt3</c> owns <c>SelectedIds</c>' controlled/uncontrolled
    /// resolution and always hands this component the resolved, non-null set
    /// (never null here, even when nothing is selected — mirrors <see
    /// cref="TreePaneWidth"/>'s own resolved-not-raw contract).
    /// </summary>
    [Parameter] public IReadOnlySet<string> SelectedIds { get; set; } = EmptySelectedIds;

    /// <summary>Renders a checkbox column when true (design spec Phase 3, T6 — REUI "Leaf row selection (checkboxes)"). Default false.</summary>
    [Parameter] public bool ShowRowCheckboxes { get; set; }

    /// <summary>
    /// Raised when a row's checkbox is toggled. <c>Key</c> is the leaf task's
    /// own id for a leaf row, or the row's <see cref="GanttVisibleRow.ToggleKey"/>
    /// (a hierarchy-parent task id, or a <see cref="GanttRowModel.GroupToggleKey"/>-prefixed
    /// group key) for a tri-state parent/group row; <c>Selected</c> is the
    /// checkbox's NEW value (true = select all, false = deselect all, for a
    /// parent/group row). <c>Gantt3</c> resolves <c>Key</c> into the actual
    /// leaf id(s) to flip via <see cref="GanttSelectionModel.ResolveLeafIds"/>.
    /// </summary>
    [Parameter] public EventCallback<(string Key, bool Selected)> OnRowSelectionChange { get; set; }

    /// <summary>
    /// Enables drag-to-reorder tree rows (design spec Phase 3, T6 — REUI "Row
    /// reorder (drag tree rows)"). Default false. Reorder is confined to the
    /// dragged row's own "bucket" (same <see cref="GanttTask.ParentId"/>, or
    /// same <see cref="GanttTask.GroupLabel"/> in flat mode — see <see
    /// cref="GanttReorderModel"/>'s own remarks); a cross-bucket move is never
    /// offered by the drag UI at all. <see cref="Readonly"/> blocks it
    /// unconditionally.
    /// </summary>
    [Parameter] public bool AllowRowReorder { get; set; }

    /// <summary>
    /// Live validation predicate for a candidate row-reorder drop position
    /// (design spec Phase 3, T6 — the REUI <c>canDropEvent</c> analog applied
    /// to row reorder). Evaluated continuously while a reorder drag is in
    /// flight (<see cref="ValidateRowDrop"/>) and once more at drop
    /// (<see cref="CommitRowReorder"/> trusts the last live verdict — same
    /// two-phase discipline <see cref="Lumeo.GanttTimeline.CanDrop"/>/
    /// <c>ValidateDrop</c>/<c>CommitDrag</c> already established). Null
    /// (default) permits every within-bucket position.
    /// </summary>
    [Parameter] public Func<GanttTask, GanttDropContext, bool>? CanDropRow { get; set; }

    /// <summary>
    /// Raised once, after a completed row-reorder drop, with the resolved
    /// <see cref="GanttRowReorder"/> payload. <c>Gantt3</c> applies the
    /// equivalent list reorder (<see cref="GanttReorderModel.Move"/>) AND
    /// re-raises the same payload through its own public <c>OnRowReorder</c>.
    /// </summary>
    [Parameter] public EventCallback<GanttRowReorder> OnRowReorder { get; set; }

    /// <summary>
    /// Disables checkbox interaction and row-reorder dragging (design spec
    /// Phase 3, T6 — "Readonly blocks both"). Mirrors <see
    /// cref="Lumeo.GanttTimeline.Readonly"/>'s own contract exactly: checked
    /// FRESH on every JSInvokable call (<see cref="ValidateRowDrop"/>/<see
    /// cref="CommitRowReorder"/>), not just at registration time — the
    /// Phase-2 lesson (a gesture already in flight at the moment of a runtime
    /// flip has its own move/up handlers living in gantt-v3.js's per-drag
    /// closure, which survives <c>unregisterRowReorderDrag</c> unaffected and
    /// still calls these on release/hover).
    /// </summary>
    [Parameter] public bool Readonly { get; set; }

    /// <summary>Additional CSS classes merged onto the root pane element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Captures unmatched attributes and applies them to the root pane element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // A scoped <DirectionProvider> cascades its direction here; otherwise the
    // global ThemeService's own current direction applies — same resolution
    // Gantt3/SplitterDivider/ResizableHandle all use for their own RTL-aware
    // math (Codex round 5, P1 #4 precedent).
    [CascadingParameter(Name = "LumeoDirection")] private LayoutDirection? ScopedDirection { get; set; }
    private LayoutDirection EffectiveDirection => ScopedDirection ?? Theme.CurrentDirection;

    // Codex round 3, P2 #1: sticky + left-0 (was "relative") — Gantt3's outer
    // pane is now the timeline's horizontal scroll owner too (see
    // GanttTimeline.ScrollHost's remarks), so without this, GanttTree would
    // scroll away to the left along with the timeline instead of staying
    // pinned as a fixed left-hand pane. `sticky` is itself a positioned value
    // (same as `relative` was), so descendants needing a positioning context
    // are unaffected, and `position:sticky` doesn't itself establish a scroll
    // container (only a non-'visible' overflow does), so this has no effect
    // on this component's OWN Virtualize resolving its scroll ancestor
    // correctly (still Gantt3's outer pane, unaffected). z-20 keeps it opaque
    // above bars/grid-lines that scroll underneath it; bg-card (already
    // present) provides the opaque backdrop that needs.
    //
    // Bug fix (Codex round 4, P2 #10): `left-0` (was a PHYSICAL offset) pinned
    // the tree to the physical left edge unconditionally — under RTL, a
    // tree/sidebar's natural "leading" edge is the physical RIGHT (matching
    // every other Lumeo RTL-aware component's own logical-property idiom —
    // see GanttBar's `start-full`/`ms-2`), so a page rendered RTL saw the
    // tree stuck to the WRONG side (physical left, i.e. the RTL trailing/end
    // edge) instead of pinning to its leading edge. `start-0` (CSS
    // `inset-inline-start:0`) resolves to `left:0` under LTR (byte-identical
    // to the previous behavior there) and `right:0` under RTL — sticky
    // positioning resolves logical inset properties the same way it resolves
    // physical ones, so this is a drop-in swap.
    //
    // Design spec Phase 3, T5: `relative` dropped from this list deliberately
    // — `sticky` ALREADY establishes a positioning context (a positioned
    // element per the CSS spec), so the splitter handle's `position:absolute`
    // resolves against this root exactly as it would under an explicit
    // `relative` — no second positioning declaration needed.
    private string RootClass => Cx.Merge("sticky start-0 z-20 shrink-0 border-e border-border/60 bg-card", Class);

    // Bug fix (Codex round 4, P2 #2): an inline style built from the pane's
    // own width (was Tailwind's `w-56` utility class, a fixed 224px that
    // couldn't be referenced from C#) — Gantt3's scroll-centering math needs
    // this SAME width as an offset (see GanttTimeline.ScrollHostLeadingOffset's
    // remarks), so it's a single shared value instead of a magic number
    // duplicated between a CSS class here and nothing anywhere else.
    //
    // Design spec Phase 3, T5: TotalWidth (name column + any TreeColumns) is
    // the root's own physical box width; --lumeo-gantt-tree-name-width is the
    // ONE custom property every name-cell (header's and every row's) reads its
    // own width from — set here, ONCE, so a live splitter drag only ever needs
    // to touch THIS element's inline style/custom property, regardless of how
    // many rows Virtualize currently has materialized (see the class remarks).
    private string RootStyle => FormattableString.Invariant(
        $"width:{TotalWidth}px;--lumeo-gantt-tree-name-width:{TreePaneWidth}px;");

    private double TreeColumnsWidth => TreeColumns is { Count: > 0 } ? TreeColumns.Sum(c => c.Width) : 0;
    private double TotalWidth => TreePaneWidth + TreeColumnsWidth;

    private static string NameCellStyle => "width:var(--lumeo-gantt-tree-name-width);";
    private static string ColumnCellStyle(GanttTreeColumn column) => FormattableString.Invariant($"width:{column.Width}px;");

    // Design spec Phase 3, T5: the header spacer is now a real row, but its
    // HEIGHT stays hard-pinned to GanttScale.HeaderHeight regardless of
    // content — see the class remarks for why this is load-bearing for row
    // alignment (paired with `overflow-hidden` on the header div itself).
    private string HeaderRowStyle => FormattableString.Invariant($"height:{GanttScale.HeaderHeight}px;");

    private string RowStyle => FormattableString.Invariant($"height:{GanttScale.RowHeight}px;");

    // Virtualize<TItem>.Items requires ICollection<TItem> (IReadOnlyList doesn't
    // implement it) — same pattern GanttTimeline.RowItems already uses for its
    // own Virtualize (Codex round 2, P2 #10). Recomputed each render (cheap: a
    // single list copy over whatever Rows already is) rather than assuming the
    // caller's IReadOnlyList happens to also implement ICollection — a caller
    // could hand in anything (an array, a custom IReadOnlyList<T>), and an
    // unsafe cast would throw for exactly those.
    private List<GanttVisibleRow> RowItems => Rows as List<GanttVisibleRow> ?? Rows.ToList();

    // Group headers AND hierarchy parent rows get the same "summary row" treatment
    // (design spec point 4: "parent/group rows get a distinct CSS class... but NO
    // rollup bars yet") — one shared class regardless of which mode produced the row.
    private static string RowClass(GanttVisibleRow row) => Cx.Merge(
        "flex items-center border-b border-border/30 text-foreground",
        row.Kind == GanttRowKind.GroupHeader || row.HasChildren
            ? "lumeo-gantt-v3-tree-summary-row bg-accent/20 text-xs font-semibold uppercase tracking-wide text-muted-foreground"
            : null);

    private static string IndentStyle(GanttVisibleRow row) =>
        FormattableString.Invariant($"width:{row.Depth * 16}px;");

    private Task HandleToggleAsync(string? key) =>
        key is not null && OnToggleCollapse.HasDelegate ? OnToggleCollapse.InvokeAsync(key) : Task.CompletedTask;

    // ── Checkbox selection (design spec Phase 3, T6) ────────────────────────

    private static readonly IReadOnlySet<string> EmptySelectedIds = new HashSet<string>();
    private static readonly IReadOnlyDictionary<string, GanttRowSelectionState> EmptySelectionStates = new Dictionary<string, GanttRowSelectionState>();

    // Gated on ShowRowCheckboxes so a caller that never sets it pays nothing
    // beyond the one FilterValidDurationTasks pass every OTHER already-gated
    // computed property here does (Rollups' own ShowSummaryBars gate is the
    // direct precedent).
    private IReadOnlyDictionary<string, GanttRowSelectionState> SelectionStates => ShowRowCheckboxes
        ? GanttSelectionModel.ComputeStates(GanttRowModel.FilterValidDurationTasks(Tasks), SelectedIds)
        : EmptySelectionStates;

    // A leaf row's own state is a direct O(1) SelectedIds membership check —
    // no dictionary lookup needed (SelectionStates only ever has entries for
    // HasChildren rows — see GanttSelectionModel.ComputeStates' own remarks).
    private (bool Checked, bool Indeterminate) CheckboxState(GanttVisibleRow row)
    {
        if (!row.HasChildren) return (row.Task is not null && SelectedIds.Contains(row.Task.Id), false);
        if (row.ToggleKey is null || !SelectionStates.TryGetValue(row.ToggleKey, out var state)) return (false, false);
        return (state != GanttRowSelectionState.Unselected, state == GanttRowSelectionState.PartiallySelected);
    }

    // row.HasChildren -> the row's own ToggleKey (a parent task id, or a
    // GanttRowModel.GroupToggleKey-prefixed group key) so Gantt3 can resolve
    // every descendant/member LEAF via GanttSelectionModel.ResolveLeafIds;
    // a leaf row -> its own task id directly (ResolveLeafIds' own "a plain
    // task id with no children returns just that one id" branch handles this
    // identically either way, but resolving it here avoids a wasted round
    // trip through that branch for the overwhelmingly common leaf-click case).
    private Task HandleCheckChangedAsync(GanttVisibleRow row, bool selected)
    {
        if (Readonly) return Task.CompletedTask; // defensive server-side guard (design spec Phase 3, T6 — "Readonly blocks both") — the Checkbox's own Disabled=Readonly already prevents the click client-side; this is the untrusted-boundary backstop every JSInvokable in this campaign already applies to ITS OWN surface
        var key = row.HasChildren ? row.ToggleKey : row.Task?.Id;
        return key is not null && OnRowSelectionChange.HasDelegate
            ? OnRowSelectionChange.InvokeAsync((key, selected))
            : Task.CompletedTask;
    }

    // ── Row reorder (design spec Phase 3, T6) ───────────────────────────────

    private static readonly IReadOnlyDictionary<string, (string BucketKey, int Index)> EmptyReorderPositions =
        new Dictionary<string, (string, int)>();

    private bool ReorderPointerActive => AllowRowReorder && !Readonly;

    // Gated on AllowRowReorder (not ReorderPointerActive) so a Readonly flip
    // doesn't need to recompute anything — the MARKUP'S OWN ReorderPointerActive
    // check is what actually withholds the data-reorder-* attributes/grip
    // when Readonly, matching how the grip itself stays an INERT (not
    // recomputed-away) visual under Readonly.
    private IReadOnlyDictionary<string, (string BucketKey, int Index)> ReorderPositions => AllowRowReorder
        ? GanttReorderModel.ComputeBucketPositions(GanttRowModel.FilterValidDurationTasks(Tasks))
        : EmptyReorderPositions;

    private string? ReorderBucketOf(GanttTask task) =>
        ReorderPositions.TryGetValue(task.Id, out var pos) ? pos.BucketKey : null;

    private string? ReorderIndexOf(GanttTask task) =>
        ReorderPositions.TryGetValue(task.Id, out var pos) ? pos.Index.ToString(System.Globalization.CultureInfo.InvariantCulture) : null;

    // Phase 3, T1's own O(1) FindTask idiom (GanttTimeline), ported here for
    // the SAME reason: ValidateRowDrop/CommitRowReorder can arrive at any
    // time between renders (a live drag), and must resolve against whatever
    // Tasks a render just committed rather than an O(rows) scan repeated on
    // every one of these JSInvokable calls.
    private Dictionary<string, GanttTask> _taskIndex = new();
    private GanttTask? FindTask(string taskId) => _taskIndex.TryGetValue(taskId, out var t) ? t : null;

    /// <summary>
    /// JS -&gt; .NET live row-reorder drop validation (design spec Phase 3, T6
    /// — the REUI <c>canDropEvent</c> analog for tree-row reorder). Mirrors
    /// <see cref="Lumeo.GanttTimeline.ValidateDrop"/>'s exact contract:
    /// permits (<c>true</c>) when <see cref="Readonly"/>, when <see
    /// cref="CanDropRow"/> is unset, or when <paramref name="taskId"/>
    /// doesn't resolve; otherwise resolves the candidate <see
    /// cref="GanttDropContext"/> from THIS component's own <see
    /// cref="Tasks"/> (never trusts JS to compute bucket semantics — see
    /// <see cref="GanttReorderModel"/>'s own remarks) and defers to <see
    /// cref="CanDropRow"/>. <c>[JSInvokable]</c> requires it public — not
    /// meant for direct C# callers outside a test double simulating the JS
    /// side.
    /// </summary>
    [JSInvokable]
    public bool ValidateRowDrop(string taskId, int targetIndex)
    {
        if (Readonly) return true;
        if (CanDropRow is null) return true;

        var task = FindTask(taskId);
        if (task is null) return true;

        var visible = GanttRowModel.FilterValidDurationTasks(Tasks);
        var siblings = GanttReorderModel.SiblingsOf(visible, task);
        if (siblings.Count == 0) return true;
        var clamped = Math.Clamp(targetIndex, 0, siblings.Count - 1);
        var targetSibling = siblings[clamped];
        var targetTaskId = targetSibling.Id == taskId ? null : targetSibling.Id;

        return CanDropRow(task, new GanttDropContext(task.ParentId, clamped, targetTaskId));
    }

    /// <summary>
    /// JS -&gt; .NET row-reorder commit (design spec Phase 3, T6): fired
    /// exactly ONCE, on drop, by gantt-v3.js's <c>registerRowReorderDrag</c>
    /// (which already awaited <see cref="ValidateRowDrop"/> for this SAME
    /// position before ever calling here — mirrors <see
    /// cref="Lumeo.GanttTimeline.CommitDrag"/>'s own "JS validates, commit
    /// trusts it" two-phase split, no redundant re-check here). Resolves the
    /// FULL <see cref="GanttRowReorder"/> payload from THIS component's own
    /// <see cref="Tasks"/> and bubbles it via <see cref="OnRowReorder"/>;
    /// <c>Gantt3.HandleRowReorderAsync</c> applies the equivalent list
    /// reorder AND re-raises the same payload publicly.
    ///
    /// No-ops (server-side guard — design spec Phase 3, T6 "Readonly blocks
    /// both", Phase-2 lesson on a mid-drag Readonly flip surviving
    /// <c>unregisterRowReorderDrag</c> — same reasoning as <see
    /// cref="Lumeo.GanttTimeline.CommitDrag"/>'s own <see cref="Readonly"/>
    /// guard) when <see cref="Readonly"/> or <see cref="AllowRowReorder"/> is
    /// off, when <paramref name="taskId"/> doesn't resolve, or when the
    /// clamped target index equals the task's current index (a genuine
    /// no-op — mirrors <c>CommitDrag</c>'s own <c>movedDays == 0</c> rule).
    /// </summary>
    [JSInvokable]
    public async Task CommitRowReorder(string taskId, int targetIndex)
    {
        if (Readonly || !AllowRowReorder) return;

        var task = FindTask(taskId);
        if (task is null) return;

        var visible = GanttRowModel.FilterValidDurationTasks(Tasks);
        var siblings = GanttReorderModel.SiblingsOf(visible, task);
        var previousIndex = -1;
        for (var i = 0; i < siblings.Count; i++)
        {
            if (siblings[i].Id == taskId) { previousIndex = i; break; }
        }
        if (previousIndex < 0) return;

        var clamped = Math.Clamp(targetIndex, 0, siblings.Count - 1);
        if (clamped == previousIndex) return;

        var reorder = new GanttRowReorder(taskId, task.ParentId, task.ParentId, previousIndex, clamped);
        if (OnRowReorder.HasDelegate) await OnRowReorder.InvokeAsync(reorder);
    }

    // ── Splitter (design spec Phase 3, T5) ──────────────────────────────────
    //
    // Reuses the gantt-v3.js drag-engine conventions (pointer capture, a
    // per-gesture option snapshot taken at pointerdown, pointer-id isolation,
    // reg.activeCleanups) — see gantt-v3.js's own registerSplitterDrag remarks
    // for the full contract. No second drag idiom: the live-drag visual is a
    // DIRECT DOM mutation of this component's own root element (its `width`
    // inline style + the --lumeo-gantt-tree-name-width custom property), never
    // a Blazor round-trip mid-gesture — the ONE JSInvokable call
    // (CommitSplitterWidth) fires exactly once, at gesture end, mirroring
    // GanttTimeline's own CommitDrag/CommitProgress "ghost-only during the
    // drag, one commit at the end" discipline (there is no ghost here because,
    // unlike a task bar, a splitter resize has no invalid/rejectable position
    // to revert away from — see CommitSplitterWidth's own remarks).

    private ElementReference _paneRef;
    private ElementReference _dividerRef;
    private DotNetObjectReference<GanttTree>? _selfRef;
    private bool _splitterRegistered;
    private GanttSplitterOptions _lastSplitterOptions;
    private bool _reorderRegistered;

    // Phase 3, T1's own _taskIndex idiom (GanttTimeline) — rebuilt on EVERY
    // parameter pass (OnParametersSet runs synchronously before any render,
    // including the first), so it always reflects whatever Tasks a render
    // just committed, in lockstep with ReorderPositions/SelectionStates.
    protected override void OnParametersSet()
    {
        var index = new Dictionary<string, GanttTask>(Tasks.Count);
        foreach (var t in Tasks) index[t.Id] = t;
        _taskIndex = index;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncSplitterRegistrationAsync();
        await SyncRowReorderRegistrationAsync();
    }

    // Design spec Phase 3, T6 — registers/unregisters gantt-v3.js's
    // registerRowReorderDrag against THIS pane's own root (_paneRef — the
    // element every row lives inside, mirroring GanttTimeline.SyncDragRegistrationAsync's
    // own "delegate on the container that owns the recycled elements" choice).
    // Readonly is checked FRESH here too (not only at mount), exactly like
    // GanttTimeline.SyncDragRegistrationAsync's own contract — a runtime
    // Readonly (or AllowRowReorder) flip un-registers/re-registers instead of
    // only taking effect at the next mount.
    private async Task SyncRowReorderRegistrationAsync()
    {
        var want = AllowRowReorder && !Readonly;
        if (!want)
        {
            if (_reorderRegistered)
            {
                _reorderRegistered = false;
                try { await Interop.GanttV3UnregisterRowReorderDragAsync(_paneRef); }
                catch (JSDisconnectedException) { }
            }
            return;
        }
        if (_reorderRegistered) return; // no options bag to re-diff — see GanttV3RegisterRowReorderDragAsync's own remarks; register once, idempotent

        _selfRef ??= DotNetObjectReference.Create(this);
        _reorderRegistered = true;
        try
        {
            await Interop.GanttV3RegisterRowReorderDragAsync(_paneRef, _selfRef);
        }
        catch (Exception)
        {
            // Mirrors SyncSplitterRegistrationAsync's own "keep the rest of
            // the pane working when drag interop is unavailable" fix.
            _reorderRegistered = false;
        }
    }

    // Re-registers whenever TreePaneWidth/the min/max clamps actually change
    // (a plain equality-gated skip, mirroring GanttTimeline.SyncDragRegistrationAsync's
    // own GanttInteropOptions-equality gate) — the min/max clamps are compile-time
    // constants so in practice this only re-fires when TreePaneWidth itself
    // moves (a controlled caller pushing a new value, or this component's own
    // prior commit landing back through Gantt3).
    private async Task SyncSplitterRegistrationAsync()
    {
        var options = new GanttSplitterOptions(TreePaneWidth, GanttScale.MinTreePaneWidth, GanttScale.MaxTreePaneWidth);
        if (_splitterRegistered && options == _lastSplitterOptions) return;

        _selfRef ??= DotNetObjectReference.Create(this);
        _splitterRegistered = true;
        _lastSplitterOptions = options;
        try
        {
            await Interop.GanttV3RegisterSplitterDragAsync(_dividerRef, _paneRef, _selfRef, BuildSplitterOptions(options));
        }
        catch (Exception)
        {
            // Mirrors GanttTimeline.SyncDragRegistrationAsync's own "keep
            // pointer clicks when drag interop is unavailable" fix — a failed
            // registration degrades to "the splitter simply can't be dragged"
            // rather than taking the whole render down; a later render retries.
            _splitterRegistered = false;
        }
    }

    private static object BuildSplitterOptions(GanttSplitterOptions options) => new Dictionary<string, object?>
    {
        ["width"] = options.Width,
        ["minWidth"] = options.MinWidth,
        ["maxWidth"] = options.MaxWidth,
    };

    /// <summary>
    /// Called by gantt-v3.js's registerSplitterDrag exactly once per completed
    /// pointer gesture (pointerup with genuine movement — see its own remarks;
    /// a below-threshold/no-movement release never calls this at all, matching
    /// the move/resize drag engine's own "no-op re-render, no commit" rule).
    /// <c>[JSInvokable]</c> requires it public — not meant for direct C# callers
    /// outside a test double simulating the JS side (mirrors GanttTimeline's
    /// own CommitDrag/CommitProgress/CommitCreate).
    ///
    /// Re-clamps defensively (design spec Phase 3, T5 "min/max clamps") even
    /// though the JS side already clamps continuously during the live drag —
    /// this is the untrusted wire boundary, the same reason CommitDrag/
    /// CommitProgress never trust their own string arguments blindly either.
    /// No ghost/revert concept here (unlike a rejected move/resize/CanDrop
    /// drop): a splitter resize has no "invalid position", so there is nothing
    /// to roll back beyond the plain clamp.
    /// </summary>
    [JSInvokable]
    public Task CommitSplitterWidth(double width)
    {
        var clamped = Math.Clamp(width, GanttScale.MinTreePaneWidth, GanttScale.MaxTreePaneWidth);
        return OnResize.HasDelegate ? OnResize.InvokeAsync(clamped) : Task.CompletedTask;
    }

    // Keyboard resize (WAI-ARIA separator pattern parity with Lumeo's own
    // SplitterDivider/ResizableHandle): a single discrete commit per keypress,
    // through the SAME OnResize callback the pointer-drag commit uses — not a
    // second idiom, just a second TRIGGER for the one commit path. RTL swaps
    // Left/Right so the key pointing toward this pane's own visual "start"
    // always shrinks it, mirroring SplitterDivider.OnKeyDown's identical rule.
    private Task OnSplitterKeyDown(KeyboardEventArgs e)
    {
        const double step = 16.0;
        const double toBound = 1_000_000.0; // clamped to the actual bound by Math.Clamp below
        var isRtl = EffectiveDirection == LayoutDirection.Rtl;

        var delta = e.Key switch
        {
            "ArrowLeft" => isRtl ? step : -step,
            "ArrowRight" => isRtl ? -step : step,
            "Home" => isRtl ? toBound : -toBound,
            "End" => isRtl ? -toBound : toBound,
            _ => 0.0,
        };
        if (delta == 0.0) return Task.CompletedTask;

        var next = Math.Clamp(TreePaneWidth + delta, GanttScale.MinTreePaneWidth, GanttScale.MaxTreePaneWidth);
        if (Math.Abs(next - TreePaneWidth) < 0.5) return Task.CompletedTask;
        return OnResize.HasDelegate ? OnResize.InvokeAsync(next) : Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_splitterRegistered)
        {
            try { await Interop.GanttV3UnregisterSplitterDragAsync(_dividerRef); }
            catch (JSDisconnectedException) { }
        }
        if (_reorderRegistered)
        {
            try { await Interop.GanttV3UnregisterRowReorderDragAsync(_paneRef); }
            catch (JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }
}
