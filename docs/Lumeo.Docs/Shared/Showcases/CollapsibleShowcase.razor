@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Collapsible @bind-Open="_open">
        @* Explicit w-full max-w-[22rem] + whitespace-nowrap on the label: without it the
           label wrapped onto two lines ("Starred" / "repos") because this row otherwise
           shrinks to its flex-item min-content width instead of the showcase's own
           22rem wrapper. See Showcases/README.md rule 2. *@
        <Flex Align="center" Justify="between" Class="w-full max-w-[22rem]">
            <Lumeo.Text Size="sm" Weight="semibold" Class="whitespace-nowrap">Starred repos</Lumeo.Text>
            <CollapsibleTrigger>
                <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Sm">
                    <DynamicIcon Name="ChevronDown" Class="h-4 w-4" />
                </Button>
            </CollapsibleTrigger>
        </Flex>
        <Stack Class="rounded-md border bg-card px-3 py-1.5 text-xs text-foreground mt-2">
            lumeo/lumeo
        </Stack>
        <CollapsibleContent>
            <Stack Gap="1.5" Class="mt-1.5">
                <Stack Class="rounded-md border bg-card px-3 py-1.5 text-xs text-foreground">
                    lumeo/docs
                </Stack>
                <Stack Class="rounded-md border bg-card px-3 py-1.5 text-xs text-foreground">
                    lumeo/icons
                </Stack>
            </Stack>
        </CollapsibleContent>
    </Collapsible>
</div>

@code {
    private bool _open = true;
}
