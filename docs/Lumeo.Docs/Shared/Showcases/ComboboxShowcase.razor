@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Combobox @bind-Value="_fw" @bind-Open="_open">
        <ComboboxInput Placeholder="Search frameworks..." />
        <ComboboxContent>
            @foreach (var fw in _frameworks)
            {
                <ComboboxItem Value="@fw">@fw</ComboboxItem>
            }
            <ComboboxEmpty>No framework found.</ComboboxEmpty>
        </ComboboxContent>
    </Combobox>
</div>

@code {
    private string? _fw = "React";
    private bool _open;
    private readonly string[] _frameworks = ["Blazor", "React", "Vue", "Angular", "Svelte"];
}
