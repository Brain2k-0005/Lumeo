@namespace Lumeo

<kbd data-slot="kbd" class="@CssClass" @attributes="AdditionalAttributes">@ChildContent</kbd>

@code {
    /// <summary>The key or shortcut label (e.g. <c>"⌘"</c>, <c>"Ctrl"</c>, <c>"Esc"</c>).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Size of the badge. Supports all 7 <see cref="Lumeo.Size"/> values (Xxs–Xxl).
    /// Defaults to <see cref="Lumeo.Size.Md"/>.</summary>
    [Parameter] public Lumeo.Size Size { get; set; } = Lumeo.Size.Md;

    /// <summary>Additional CSS classes merged onto the root <c>kbd</c> element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes are splatted onto the root <c>kbd</c> element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Cx.Merge("pointer-events-none inline-flex select-none items-center gap-1 rounded border border-border/50 bg-muted font-mono font-medium text-muted-foreground", SizeClasses, Class);

    private string SizeClasses => Size switch
    {
        // Height's Sm->Md step is 0 (they tie at h-5), so a flat 1-step Tailwind
        // decrement is used for Xxs/Xs instead of mechanical extrapolation — see spec.
        Lumeo.Size.Xxs => "h-3.5 px-0 text-[8px]",
        Lumeo.Size.Xs => "h-4 px-0.5 text-[9px]",
        Lumeo.Size.Sm => "h-5 px-1 text-[10px]",
        Lumeo.Size.Lg => "h-6 px-2 text-xs",
        Lumeo.Size.Xl => "h-7 px-2.5 text-[13px]",
        Lumeo.Size.Xxl => "h-8 px-3 text-sm",
        _ => "h-5 px-1 text-[11px]"
    };
}
