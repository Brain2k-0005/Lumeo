@namespace Lumeo

@* The entries of a chip's (or an advanced row's) menu: duplicate, negate, the grouping entries of
   the advanced builder, the hand-over to an advanced editor, remove. *@
<DropdownMenuItem Disabled="Context.Locked" OnClick="() => Context.DuplicateNode(RuleId)">
    <SvgGlyph Svg="@(LumeoIcons.Copy)" class="h-4 w-4" />
    <span class="min-w-0 truncate">@Context.Labels.Duplicate</span>
</DropdownMenuItem>
<DropdownMenuItem Disabled="Context.Locked" OnClick="() => Context.NegateRule(RuleId)">
    <SvgGlyph Svg="@(LumeoIcons.ArrowLeftRight)" class="h-4 w-4" />
    <span class="min-w-0 truncate">@Context.Labels.Negate</span>
</DropdownMenuItem>
@if (AllowGrouping)
{
    <DropdownMenuItem Disabled="Context.Locked" OnClick="() => Context.WrapInGroup(RuleId)">
        <SvgGlyph Svg="@(LumeoIcons.Layers)" class="h-4 w-4" />
        <span class="min-w-0 truncate">@Context.Labels.WrapInGroup</span>
    </DropdownMenuItem>
    <FilterMoveToMenuItems NodeId="@RuleId" />
}
@if (Context.CanConvertToAdvanced)
{
    <DropdownMenuItem OnClick="() => OnConvertToAdvanced.InvokeAsync()">
        <SvgGlyph Svg="@(LumeoIcons.SlidersHorizontal)" class="h-4 w-4" />
        <span class="min-w-0 truncate">@Context.Labels.ConvertToAdvanced</span>
    </DropdownMenuItem>
}
<DropdownMenuItem Variant="MenuItemVariant.Destructive" Disabled="Context.Locked" OnClick="() => Context.RemoveNode(RuleId)">
    <SvgGlyph Svg="@(LumeoIcons.Trash2)" class="h-4 w-4" />
    <span class="min-w-0 truncate">@Context.Labels.Remove</span>
</DropdownMenuItem>

@code {
    [CascadingParameter] public FiltersContext Context { get; set; } = default!;
    [Parameter, EditorRequired] public string RuleId { get; set; } = "";
    /// <summary>Shows the wrap-in-group and move-to-group entries of the advanced builder.</summary>
    [Parameter] public bool AllowGrouping { get; set; }
    [Parameter] public EventCallback OnConvertToAdvanced { get; set; }
}
