@namespace Lumeo.Docs.Shared.Showcases

@* FeatureGrid's inner wrapper hardcodes py-16 (a landing-page band) — that
   padding isn't exposed via Class (it's on an inner div, not the root
   section), so omitting Title/Subtitle keeps this cropped slice as short as
   the component allows; it still clips at the bottom in the 236px box like
   any oversized showcase (see Showcases/README.md). *@
<div class="w-full max-w-[22rem] overflow-hidden">
    <FeatureGrid Columns="2">
        <FeatureItem Title="Fast" Description="Renders in milliseconds.">
            <IconContent><SvgGlyph Svg="@(Lucide.Zap)" class="h-4 w-4" /></IconContent>
        </FeatureItem>
        <FeatureItem Title="Accessible" Description="WAI-ARIA by default.">
            <IconContent><SvgGlyph Svg="@(Lucide.Check)" class="h-4 w-4" /></IconContent>
        </FeatureItem>
    </FeatureGrid>
</div>
