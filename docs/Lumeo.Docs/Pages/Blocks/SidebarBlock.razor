    private sealed record Team(string Name, IconSource Logo, string Plan);
    private sealed record NavItem(string Title, IconSource Icon, string[] Items);
    private sealed record Project(string Name, IconSource Icon);

    private readonly List<Team> _teams =
    [
        new("Acme Inc", Lucide.GalleryVerticalEnd, "Enterprise"),
        new("Acme Corp.", Lucide.AudioWaveform, "Startup"),
        new("Evil Corp.", Lucide.Command, "Free"),
    ];

    private Team _activeTeam = null!;

    private readonly List<NavItem> _navMain =
    [
        new("Playground", Lucide.SquareTerminal, ["History", "Starred", "Settings"]),
        new("Models", Lucide.Bot, ["Genesis", "Explorer", "Quantum"]),
        new("Documentation", Lucide.BookOpen, ["Introduction", "Get Started", "Tutorials", "Changelog"]),
        new("Settings", Lucide.Settings2, ["General", "Team", "Billing", "Limits"]),
    ];

    private readonly List<Project> _projects =
    [
        new("Design Engineering", Lucide.Frame),
        new("Sales & Marketing", Lucide.ChartPie),
        new("Travel", Lucide.Map),
    ];

    // Playground starts open, as isActive does in the block.
    private readonly HashSet<string> _open = ["Playground"];

    protected override void OnInitialized() => _activeTeam = _teams[0];

    private void ToggleOpen(string title)
    {
        if (!_open.Remove(title)) _open.Add(title);
    }
