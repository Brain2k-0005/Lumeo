@namespace Lumeo.Docs.Shared.Showcases
@* Static exception (see ../README.md): GanttChart virtualizes its rows against the real
   scroll viewport (GanttViewportReconciler) and lays out a wide day-by-day header — there is
   no small task set that reproduces that without a real, taller viewport to scroll. This
   renders a faithful miniature of the visible chrome: a day-scale header and a handful of
   task bars at proportional widths, without the drag/dependency machinery. *@

<div class="w-full max-w-[22rem] h-32 rounded-md border border-border/60 overflow-hidden flex flex-col text-xs">
    <div class="flex border-b border-border/60 bg-muted/40 text-muted-foreground">
        @foreach (var day in new[] { "Mon", "Tue", "Wed", "Thu", "Fri" })
        {
            <div class="flex-1 text-center py-1 border-e border-border/40 last:border-e-0">@day</div>
        }
    </div>
    <div class="flex-1 flex flex-col justify-center gap-2 px-2 py-2">
        <div class="h-3 rounded-sm bg-primary" style="width:60%"></div>
        <div class="h-3 rounded-sm bg-primary" style="width:45%;margin-left:20%"></div>
        <div class="h-3 rounded-sm bg-primary" style="width:70%;margin-left:10%"></div>
    </div>
</div>
