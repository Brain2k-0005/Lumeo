@namespace Lumeo.Docs.Shared.Showcases
@* Static exception (see ../README.md): the legacy SVG Gantt needs real height/width to lay
   out its day columns (420px in its own docs demos) and has no tree pane to shrink further —
   the same "needs a viewport" case as GanttChart. This renders a faithful miniature of the
   visible chrome: a day-scale header and task bars, without the drag machinery. *@

<div class="w-full max-w-[22rem] h-32 rounded-md border border-border/60 overflow-hidden flex flex-col text-xs">
    <div class="flex border-b border-border/60 bg-muted/40 text-muted-foreground">
        @foreach (var day in new[] { "5", "6", "7", "8", "9" })
        {
            <div class="flex-1 text-center py-1 border-e border-border/40 last:border-e-0">@day</div>
        }
    </div>
    <div class="flex-1 flex flex-col justify-center gap-2 px-2 py-2">
        <div class="h-3 rounded bg-primary" style="width:50%"></div>
        <div class="h-3 rounded bg-primary" style="width:55%;margin-left:15%"></div>
        <div class="h-3 rounded bg-primary" style="width:40%;margin-left:35%"></div>
    </div>
</div>
