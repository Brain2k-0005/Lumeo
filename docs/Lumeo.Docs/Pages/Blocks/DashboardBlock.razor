@page "/blocks/dashboard"
@namespace Lumeo.Docs.Pages.Blocks

<PageTitle>Dashboard — Lumeo Blocks</PageTitle>

<PageHeader Title="Dashboard"
            Description="shadcn's dashboard-01, ported one to one: the app sidebar with quick-create, documents and a user menu, a site header, four stat cards with trend badges, the interactive visitors chart with a time-range toggle, and the sections table with tabs, column visibility, selection, drag-to-reorder, pagination and a detail drawer." />

<Stack Gap="10" Class="mt-8">
    <ComponentDemo Id="dashboard-01" Title="dashboard-01" Description="A dashboard with sidebar, charts and data table." Code="@_code">
        <SidebarProvider Class="min-h-[820px] w-full overflow-hidden rounded-[var(--radius-lg)] border border-border/40 [--card-spacing:1.5rem]">
            <SidebarComponent>
                <SidebarHeader>
                    <SidebarMenu>
                        <SidebarMenuItem>
                            <SidebarMenuButton Href="#" Class="p-1.5!">
                                <SvgGlyph Svg="@(Lucide.Command)" class="size-5!" />
                                <span class="text-base font-semibold">Acme Inc.</span>
                            </SidebarMenuButton>
                        </SidebarMenuItem>
                    </SidebarMenu>
                </SidebarHeader>
                <SidebarContent>
                    <SidebarGroup>
                        <SidebarGroupContent Class="flex flex-col gap-2">
                            <SidebarMenu>
                                <SidebarMenuItem Class="flex items-center gap-2">
                                    <SidebarMenuButton Tooltip="Quick Create" Class="min-w-8 bg-primary text-primary-foreground duration-200 ease-linear hover:bg-primary/90 hover:text-primary-foreground active:bg-primary/90 active:text-primary-foreground">
                                        <SvgGlyph Svg="@(Lucide.CirclePlus)" />
                                        <span>Quick Create</span>
                                    </SidebarMenuButton>
                                    <Button Size="Button.ButtonSize.Icon" Variant="Button.ButtonVariant.Outline" Class="size-8 group-data-[collapsible=icon]:opacity-0">
                                        <SvgGlyph Svg="@(Lucide.Mail)" />
                                        <span class="sr-only">Inbox</span>
                                    </Button>
                                </SidebarMenuItem>
                            </SidebarMenu>
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="#" Tooltip="Dashboard">
                                        <SvgGlyph Svg="@(Lucide.LayoutDashboard)" />
                                        <span>Dashboard</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="#" Tooltip="Lifecycle">
                                        <SvgGlyph Svg="@(Lucide.ListChecks)" />
                                        <span>Lifecycle</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="#" Tooltip="Analytics">
                                        <SvgGlyph Svg="@(Lucide.ChartBar)" />
                                        <span>Analytics</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="#" Tooltip="Projects">
                                        <SvgGlyph Svg="@(Lucide.Folder)" />
                                        <span>Projects</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="#" Tooltip="Team">
                                        <SvgGlyph Svg="@(Lucide.Users)" />
                                        <span>Team</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarGroupContent>
                    </SidebarGroup>
                    <SidebarGroup Class="group-data-[collapsible=icon]:hidden">
                        <SidebarGroupLabel>Documents</SidebarGroupLabel>
                        <SidebarMenu>
                            @foreach (var doc in _documents)
                            {
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="#">
                                        <SvgGlyph Svg="@doc.Icon" />
                                        <span>@doc.Name</span>
                                    </SidebarMenuButton>
                                    <DropdownMenu Class="absolute inset-y-0 right-0 w-0">
                                        <DropdownMenuTrigger AsChild>
                                            <ChildContentSlot Context="slot">
                                                <SidebarMenuAction ShowOnHover="true" Class="data-[state=open]:bg-accent rounded-sm" id="@slot.Id" @attributes="slot.Attributes" @onclick="slot.OnClick">
                                                    <SvgGlyph Svg="@(Lucide.Ellipsis)" />
                                                    <span class="sr-only">More</span>
                                                </SidebarMenuAction>
                                            </ChildContentSlot>
                                        </DropdownMenuTrigger>
                                        <DropdownMenuContent Class="w-24 rounded-lg" Side="Lumeo.Side.Right" Align="Lumeo.Align.Start">
                                            <DropdownMenuItem><SvgGlyph Svg="@(Lucide.Folder)" /><span>Open</span></DropdownMenuItem>
                                            <DropdownMenuItem><SvgGlyph Svg="@(Lucide.Share)" /><span>Share</span></DropdownMenuItem>
                                            <DropdownMenuSeparator />
                                            <DropdownMenuItem Variant="MenuItemVariant.Destructive"><SvgGlyph Svg="@(Lucide.Trash2)" /><span>Delete</span></DropdownMenuItem>
                                        </DropdownMenuContent>
                                    </DropdownMenu>
                                </SidebarMenuItem>
                            }
                            <SidebarMenuItem>
                                <SidebarMenuButton Class="text-sidebar-foreground/70">
                                    <SvgGlyph Svg="@(Lucide.Ellipsis)" class="text-sidebar-foreground/70" />
                                    <span>More</span>
                                </SidebarMenuButton>
                            </SidebarMenuItem>
                        </SidebarMenu>
                    </SidebarGroup>
                    <SidebarGroup Class="mt-auto">
                        <SidebarGroupContent>
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="#" Tooltip="Settings">
                                        <SvgGlyph Svg="@(Lucide.Settings)" />
                                        <span>Settings</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="#" Tooltip="Get Help">
                                        <SvgGlyph Svg="@(Lucide.CircleQuestionMark)" />
                                        <span>Get Help</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="#" Tooltip="Search">
                                        <SvgGlyph Svg="@(Lucide.Search)" />
                                        <span>Search</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarGroupContent>
                    </SidebarGroup>
                </SidebarContent>
                <SidebarFooter>
                    <SidebarMenu>
                        <SidebarMenuItem>
                            <DropdownMenu Class="block w-full">
                                <DropdownMenuTrigger AsChild>
                                    <ChildContentSlot Context="slot">
                                        <SidebarMenuButton Size="SidebarMenuButton.ButtonSize.Lg" id="@slot.Id" Class="data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground" @attributes="slot.Attributes" @onclick="slot.OnClick">
                                            <Avatar Shape="Avatar.AvatarShape.Square" Class="h-8 w-8 rounded-lg grayscale"><AvatarFallback Class="rounded-lg">CN</AvatarFallback></Avatar>
                                            <div class="grid flex-1 text-left text-sm leading-tight">
                                                <span class="truncate font-medium">shadcn</span>
                                                <span class="text-muted-foreground truncate text-xs">m@example.com</span>
                                            </div>
                                            <SvgGlyph Svg="@(Lucide.EllipsisVertical)" class="ml-auto size-4" />
                                        </SidebarMenuButton>
                                    </ChildContentSlot>
                                </DropdownMenuTrigger>
                                <DropdownMenuContent Class="w-56 min-w-56 rounded-lg" Side="Lumeo.Side.Right" Align="Lumeo.Align.End">
                                    <DropdownMenuLabel Class="p-0 font-normal">
                                        <div class="flex items-center gap-2 px-1 py-1.5 text-left text-sm">
                                            <Avatar Shape="Avatar.AvatarShape.Square" Class="h-8 w-8 rounded-lg"><AvatarFallback Class="rounded-lg">CN</AvatarFallback></Avatar>
                                            <div class="grid flex-1 text-left text-sm leading-tight">
                                                <span class="truncate font-medium">shadcn</span>
                                                <span class="text-muted-foreground truncate text-xs">m@example.com</span>
                                            </div>
                                        </div>
                                    </DropdownMenuLabel>
                                    <DropdownMenuSeparator />
                                    <DropdownMenuGroup>
                                        <DropdownMenuItem><SvgGlyph Svg="@(Lucide.CircleUser)" />Account</DropdownMenuItem>
                                        <DropdownMenuItem><SvgGlyph Svg="@(Lucide.CreditCard)" />Billing</DropdownMenuItem>
                                        <DropdownMenuItem><SvgGlyph Svg="@(Lucide.Bell)" />Notifications</DropdownMenuItem>
                                    </DropdownMenuGroup>
                                    <DropdownMenuSeparator />
                                    <DropdownMenuItem><SvgGlyph Svg="@(Lucide.LogOut)" />Log out</DropdownMenuItem>
                                </DropdownMenuContent>
                            </DropdownMenu>
                        </SidebarMenuItem>
                    </SidebarMenu>
                </SidebarFooter>
            </SidebarComponent>
            <SidebarInset>
                <header class="flex h-12 shrink-0 items-center gap-2 border-b transition-[width,height] ease-linear">
                    <div class="flex w-full items-center gap-1 px-4 lg:gap-2 lg:px-6">
                        <SidebarTrigger Class="-ml-1" />
                        <Separator Orientation="Lumeo.Orientation.Vertical" Class="mx-2 h-4" />
                        <h1 class="text-base font-medium">Documents</h1>
                        <div class="ml-auto flex items-center gap-2">
                            <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Sm" Href="https://github.com/shadcn-ui/ui/tree/main/apps/v4/app/(examples)/dashboard" Class="hidden sm:flex dark:text-foreground">GitHub</Button>
                        </div>
                    </div>
                </header>
                <div class="flex flex-1 flex-col">
                    <div class="@@container/main flex flex-1 flex-col gap-2">
                        <div class="flex flex-col gap-4 py-4 md:gap-6 md:py-6">
                            <div class="grid grid-cols-1 gap-4 px-4 *:data-[slot=card]:bg-gradient-to-t *:data-[slot=card]:from-primary/5 *:data-[slot=card]:to-card *:data-[slot=card]:shadow-xs @@xl/main:grid-cols-2 @@5xl/main:grid-cols-4 lg:px-6">
                                <Card Class="@("@container/card")">
                                    <CardHeader>
                                        <CardDescription>Total Revenue</CardDescription>
                                        <CardTitle Class="@("text-2xl font-semibold tabular-nums @[250px]/card:text-3xl")">$1,250.00</CardTitle>
                                        <CardAction>
                                            <Badge Variant="Badge.BadgeVariant.Outline"><SvgGlyph Svg="@(Lucide.TrendingUp)" />+12.5%</Badge>
                                        </CardAction>
                                    </CardHeader>
                                    <CardFooter Class="flex-col items-start gap-1.5 text-sm">
                                        <div class="line-clamp-1 flex gap-2 font-medium">Trending up this month <SvgGlyph Svg="@(Lucide.TrendingUp)" class="size-4" /></div>
                                        <div class="text-muted-foreground">Visitors for the last 6 months</div>
                                    </CardFooter>
                                </Card>
                                <Card Class="@("@container/card")">
                                    <CardHeader>
                                        <CardDescription>New Customers</CardDescription>
                                        <CardTitle Class="@("text-2xl font-semibold tabular-nums @[250px]/card:text-3xl")">1,234</CardTitle>
                                        <CardAction>
                                            <Badge Variant="Badge.BadgeVariant.Outline"><SvgGlyph Svg="@(Lucide.TrendingDown)" />-20%</Badge>
                                        </CardAction>
                                    </CardHeader>
                                    <CardFooter Class="flex-col items-start gap-1.5 text-sm">
                                        <div class="line-clamp-1 flex gap-2 font-medium">Down 20% this period <SvgGlyph Svg="@(Lucide.TrendingDown)" class="size-4" /></div>
                                        <div class="text-muted-foreground">Acquisition needs attention</div>
                                    </CardFooter>
                                </Card>
                                <Card Class="@("@container/card")">
                                    <CardHeader>
                                        <CardDescription>Active Accounts</CardDescription>
                                        <CardTitle Class="@("text-2xl font-semibold tabular-nums @[250px]/card:text-3xl")">45,678</CardTitle>
                                        <CardAction>
                                            <Badge Variant="Badge.BadgeVariant.Outline"><SvgGlyph Svg="@(Lucide.TrendingUp)" />+12.5%</Badge>
                                        </CardAction>
                                    </CardHeader>
                                    <CardFooter Class="flex-col items-start gap-1.5 text-sm">
                                        <div class="line-clamp-1 flex gap-2 font-medium">Strong user retention <SvgGlyph Svg="@(Lucide.TrendingUp)" class="size-4" /></div>
                                        <div class="text-muted-foreground">Engagement exceed targets</div>
                                    </CardFooter>
                                </Card>
                                <Card Class="@("@container/card")">
                                    <CardHeader>
                                        <CardDescription>Growth Rate</CardDescription>
                                        <CardTitle Class="@("text-2xl font-semibold tabular-nums @[250px]/card:text-3xl")">4.5%</CardTitle>
                                        <CardAction>
                                            <Badge Variant="Badge.BadgeVariant.Outline"><SvgGlyph Svg="@(Lucide.TrendingUp)" />+4.5%</Badge>
                                        </CardAction>
                                    </CardHeader>
                                    <CardFooter Class="flex-col items-start gap-1.5 text-sm">
                                        <div class="line-clamp-1 flex gap-2 font-medium">Steady performance increase <SvgGlyph Svg="@(Lucide.TrendingUp)" class="size-4" /></div>
                                        <div class="text-muted-foreground">Meets growth projections</div>
                                    </CardFooter>
                                </Card>
                            </div>
                            <div class="px-4 lg:px-6">
                                <Card Class="@("@container/card")">
                                    <CardHeader>
                                        <CardTitle>Total Visitors</CardTitle>
                                        <CardDescription>
                                            <span class="hidden @@[540px]/card:block">Total for the last 3 months</span>
                                            <span class="@@[540px]/card:hidden">Last 3 months</span>
                                        </CardDescription>
                                        <CardAction>
                                            <ToggleGroup Type="ToggleGroup.ToggleGroupType.Single" Variant="ToggleGroup.ToggleGroupVariant.Outline" Value="@_range" ValueChanged="@(v => _range = v ?? "90d")" Class="@("hidden *:data-[slot=toggle-group-item]:px-4! @[767px]/card:flex")">
                                                <ToggleGroupItem Value="90d">Last 3 months</ToggleGroupItem>
                                                <ToggleGroupItem Value="30d">Last 30 days</ToggleGroupItem>
                                                <ToggleGroupItem Value="7d">Last 7 days</ToggleGroupItem>
                                            </ToggleGroup>
                                            <Select Value="@_range" ValueChanged="@(v => _range = v ?? "90d")" Class="@("@[767px]/card:hidden")">
                                                <SelectTrigger Class="w-40" aria-label="Select a value">@RangeLabel</SelectTrigger>
                                                <SelectContent Class="rounded-xl">
                                                    <SelectItem Value="90d" Class="rounded-lg">Last 3 months</SelectItem>
                                                    <SelectItem Value="30d" Class="rounded-lg">Last 30 days</SelectItem>
                                                    <SelectItem Value="7d" Class="rounded-lg">Last 7 days</SelectItem>
                                                </SelectContent>
                                            </Select>
                                        </CardAction>
                                    </CardHeader>
                                    <CardContent Class="px-2 pt-4 sm:px-6 sm:pt-6">
                                        <AreaChart Categories="@ChartCategories" Series="@ChartSeries" Height="250px" Stacked="true" Smooth="true" GradientFill="true" ShowDots="false" ShowLegend="false" LabelStrategy="ChartLabelStrategy.Auto" LabelRotate="0" />
                                    </CardContent>
                                </Card>
                            </div>
                            <Tabs ActiveValue="@_tab" ActiveValueChanged="@(v => _tab = v)" Class="w-full flex-col justify-start gap-6">
                                <div class="flex items-center justify-between px-4 lg:px-6">
                                    <Label For="dash-view-selector" Class="sr-only">View</Label>
                                    <Select Value="@_tab" ValueChanged="@(v => _tab = v ?? "outline")" Class="@("flex w-fit @4xl/main:hidden")">
                                        <SelectTrigger id="dash-view-selector">@TabLabel</SelectTrigger>
                                        <SelectContent>
                                            <SelectItem Value="outline">Outline</SelectItem>
                                            <SelectItem Value="past-performance">Past Performance</SelectItem>
                                            <SelectItem Value="key-personnel">Key Personnel</SelectItem>
                                            <SelectItem Value="focus-documents">Focus Documents</SelectItem>
                                        </SelectContent>
                                    </Select>
                                    <TabsList Class="@("hidden @4xl/main:flex")">
                                        <TabsTrigger Value="outline">Outline</TabsTrigger>
                                        <TabsTrigger Value="past-performance">Past Performance <Badge Variant="Badge.BadgeVariant.Secondary" Class="size-5 justify-center rounded-full bg-muted-foreground/30 px-0">3</Badge></TabsTrigger>
                                        <TabsTrigger Value="key-personnel">Key Personnel <Badge Variant="Badge.BadgeVariant.Secondary" Class="size-5 justify-center rounded-full bg-muted-foreground/30 px-0">2</Badge></TabsTrigger>
                                        <TabsTrigger Value="focus-documents">Focus Documents</TabsTrigger>
                                    </TabsList>
                                    <div class="flex items-center gap-2">
                                        <DropdownMenu>
                                            <DropdownMenuTrigger AsChild>
                                                <ChildContentSlot Context="slot">
                                                    <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" id="@slot.Id" @attributes="slot.Attributes" OnClick="slot.OnClick">
                                                        <SvgGlyph Svg="@(Lucide.Columns3)" />
                                                        <span class="hidden lg:inline">Customize Columns</span>
                                                        <span class="lg:hidden">Columns</span>
                                                        <SvgGlyph Svg="@(Lucide.ChevronDown)" />
                                                    </Button>
                                                </ChildContentSlot>
                                            </DropdownMenuTrigger>
                                            <DropdownMenuContent Align="Lumeo.Align.End" Class="w-56">
                                                @foreach (var col in _hideable)
                                                {
                                                    <DropdownMenuCheckboxItem Class="capitalize" Checked="@(!_hidden.Contains(col))" CheckedChanged="@(on => ToggleColumn(col, on))">@col</DropdownMenuCheckboxItem>
                                                }
                                            </DropdownMenuContent>
                                        </DropdownMenu>
                                        <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm">
                                            <SvgGlyph Svg="@(Lucide.Plus)" />
                                            <span class="hidden lg:inline">Add Section</span>
                                        </Button>
                                    </div>
                                </div>
                                <TabsContent Value="outline" Class="relative flex flex-col gap-4 overflow-auto px-4 lg:px-6">
                                    <div class="overflow-hidden rounded-lg border">
                                        <Table>
                                            <TableHeader Class="sticky top-0 z-10 bg-muted">
                                                <TableRow>
                                                    <TableHead Class="w-8"></TableHead>
                                                    <TableHead>
                                                        <div class="flex items-center justify-center">
                                                            <Checkbox Checked="@AllPageSelected" IsIndeterminate="@SomePageSelected" CheckedChanged="@ToggleAllPage" AriaLabel="Select all" />
                                                        </div>
                                                    </TableHead>
                                                    <TableHead>Header</TableHead>
                                                    @if (!_hidden.Contains("type")) { <TableHead>Section Type</TableHead> }
                                                    @if (!_hidden.Contains("status")) { <TableHead>Status</TableHead> }
                                                    @if (!_hidden.Contains("target")) { <TableHead><div class="w-full text-right">Target</div></TableHead> }
                                                    @if (!_hidden.Contains("limit")) { <TableHead><div class="w-full text-right">Limit</div></TableHead> }
                                                    @if (!_hidden.Contains("reviewer")) { <TableHead>Reviewer</TableHead> }
                                                    <TableHead></TableHead>
                                                </TableRow>
                                            </TableHeader>
                                            <TableBody>
                                                @foreach (var row in PageRows)
                                                {
                                                    @* A raw tr: Blazor's @ondragover:preventDefault (what makes a drop target) cannot be
                                                       passed through a component, and TableRow is only this element with these classes. *@
                                                    <tr @key="row.Id" data-state="@(_selected.Contains(row.Id) ? "selected" : null)"
                                                        draggable="true" @ondragstart="@(() => _dragId = row.Id)" @ondragover:preventDefault @ondrop="@(() => DropOn(row.Id))"
                                                        class="@($"border-b border-border/40 transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted {(_dragId == row.Id ? "relative z-10 opacity-80" : "relative z-0")}")">
                                                        <TableCell Class="w-8">
                                                            <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Icon" Class="size-7 cursor-grab text-muted-foreground hover:bg-transparent">
                                                                <SvgGlyph Svg="@(Lucide.GripVertical)" class="size-3 text-muted-foreground" />
                                                                <span class="sr-only">Drag to reorder</span>
                                                            </Button>
                                                        </TableCell>
                                                        <TableCell>
                                                            <div class="flex items-center justify-center">
                                                                <Checkbox Checked="@_selected.Contains(row.Id)" CheckedChanged="@(on => ToggleRow(row.Id, on))" AriaLabel="Select row" />
                                                            </div>
                                                        </TableCell>
                                                        <TableCell>
                                                            <Button Variant="Button.ButtonVariant.Link" Class="w-fit px-0 text-left text-foreground" OnClick="@(() => OpenDrawer(row))">@row.Header</Button>
                                                        </TableCell>
                                                        @if (!_hidden.Contains("type"))
                                                        {
                                                            <TableCell><div class="w-32"><Badge Variant="Badge.BadgeVariant.Outline" Class="px-1.5 text-muted-foreground">@row.Type</Badge></div></TableCell>
                                                        }
                                                        @if (!_hidden.Contains("status"))
                                                        {
                                                            <TableCell>
                                                                <Badge Variant="Badge.BadgeVariant.Outline" Class="px-1.5 text-muted-foreground">
                                                                    @if (row.Status == "Done")
                                                                    {
                                                                        <SvgGlyph Svg="@(Lucide.CircleCheck)" class="fill-green-500 text-background dark:fill-green-400" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <SvgGlyph Svg="@(Lucide.Loader)" />
                                                                    }
                                                                    @row.Status
                                                                </Badge>
                                                            </TableCell>
                                                        }
                                                        @if (!_hidden.Contains("target"))
                                                        {
                                                            <TableCell>
                                                                <Label For="@($"dash-{row.Id}-target")" Class="sr-only">Target</Label>
                                                                <Input id="@($"dash-{row.Id}-target")" Value="@row.Target" Class="h-8 w-16 border-transparent bg-transparent text-right shadow-none hover:bg-input/30 focus-visible:border focus-visible:bg-background dark:bg-transparent dark:hover:bg-input/30" />
                                                            </TableCell>
                                                        }
                                                        @if (!_hidden.Contains("limit"))
                                                        {
                                                            <TableCell>
                                                                <Label For="@($"dash-{row.Id}-limit")" Class="sr-only">Limit</Label>
                                                                <Input id="@($"dash-{row.Id}-limit")" Value="@row.Limit" Class="h-8 w-16 border-transparent bg-transparent text-right shadow-none hover:bg-input/30 focus-visible:border focus-visible:bg-background dark:bg-transparent dark:hover:bg-input/30" />
                                                            </TableCell>
                                                        }
                                                        @if (!_hidden.Contains("reviewer"))
                                                        {
                                                            <TableCell>
                                                                @if (row.Reviewer != "Assign reviewer")
                                                                {
                                                                    @row.Reviewer
                                                                }
                                                                else
                                                                {
                                                                    <Select>
                                                                        <SelectTrigger Class="w-38" Placeholder="Assign reviewer" />
                                                                        <SelectContent>
                                                                            <SelectItem Value="Eddie Lake">Eddie Lake</SelectItem>
                                                                            <SelectItem Value="Jamik Tashpulatov">Jamik Tashpulatov</SelectItem>
                                                                        </SelectContent>
                                                                    </Select>
                                                                }
                                                            </TableCell>
                                                        }
                                                        <TableCell>
                                                            <DropdownMenu>
                                                                <DropdownMenuTrigger AsChild>
                                                                    <ChildContentSlot Context="slot">
                                                                        <Button Variant="Button.ButtonVariant.Ghost" Size="Button.ButtonSize.Icon" Class="flex size-8 text-muted-foreground data-[state=open]:bg-muted" id="@slot.Id" @attributes="slot.Attributes" OnClick="slot.OnClick">
                                                                            <SvgGlyph Svg="@(Lucide.EllipsisVertical)" />
                                                                            <span class="sr-only">Open menu</span>
                                                                        </Button>
                                                                    </ChildContentSlot>
                                                                </DropdownMenuTrigger>
                                                                <DropdownMenuContent Align="Lumeo.Align.End" Class="w-32">
                                                                    <DropdownMenuItem>Edit</DropdownMenuItem>
                                                                    <DropdownMenuItem>Make a copy</DropdownMenuItem>
                                                                    <DropdownMenuItem>Favorite</DropdownMenuItem>
                                                                    <DropdownMenuSeparator />
                                                                    <DropdownMenuItem Variant="MenuItemVariant.Destructive">Delete</DropdownMenuItem>
                                                                </DropdownMenuContent>
                                                            </DropdownMenu>
                                                        </TableCell>
                                                    </tr>
                                                }
                                            </TableBody>
                                        </Table>
                                    </div>
                                    <div class="flex items-center justify-between px-4">
                                        <div class="hidden flex-1 text-sm text-muted-foreground lg:flex">@_selected.Count of @_rows.Count row(s) selected.</div>
                                        <div class="flex w-full items-center gap-8 lg:w-fit">
                                            <div class="hidden items-center gap-2 lg:flex">
                                                <Label For="dash-rows-per-page" Class="text-sm font-medium">Rows per page</Label>
                                                <Select Value="@_pageSize.ToString()" ValueChanged="@(v => SetPageSize(v))">
                                                    <SelectTrigger id="dash-rows-per-page" Class="w-20">@_pageSize</SelectTrigger>
                                                    <SelectContent>
                                                        @foreach (var size in new[] { 10, 20, 30, 40, 50 })
                                                        {
                                                            <SelectItem Value="@size.ToString()">@size</SelectItem>
                                                        }
                                                    </SelectContent>
                                                </Select>
                                            </div>
                                            <div class="flex w-fit items-center justify-center text-sm font-medium">Page @(_page + 1) of @PageCount</div>
                                            <div class="ml-auto flex items-center gap-2 lg:ml-0">
