@namespace Lumeo

@* A native button, not a div[role=button] — the same shape AccordionTrigger already uses.
   The div version had to hand-roll everything the browser gives a button for free: a manual
   tabindex, an @onkeydown synthesising Enter and Space, and a JS prevent-default
   registration on first render for EVERY trigger on the page, because Space on a div both
   toggles and scrolls. All of that is gone, along with its interop round-trip (#438). *@
<button data-slot="collapsible-trigger" type="button"
        id="@Context.TriggerId"
        class="@CssClass"
        disabled="@Context.Disabled"
        aria-expanded="@(Context.IsOpen ? "true" : "false")"
        aria-controls="@Context.ContentId"
        data-state="@(Context.IsOpen ? "open" : "closed")"
        data-disabled="@(Context.Disabled ? string.Empty : null)"
        @onclick="Context.Toggle"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [CascadingParameter] public Collapsible.CollapsibleContext Context { get; set; } = default!;
    /// <summary>The trigger's label content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS classes merged onto the trigger element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes splatted onto the trigger element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // w-full and text-start restore what the div gave for nothing: a div is block-level and
    // left-aligned, a button is inline-block and centres its label. Without them the swap
    // would silently reflow every existing trigger. `font: inherit` needs no class — the
    // shipped reset already sets it on button. The rest is unchanged from the div version,
    // and mirrors AccordionTrigger's disabled treatment.
    private string CssClass => Cx.Merge(
        "w-full text-start focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded-sm",
        (Context.Disabled ? "cursor-not-allowed opacity-50" : "cursor-pointer"),
        Class);
}
