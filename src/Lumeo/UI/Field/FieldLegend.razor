@namespace Lumeo
@* shadcn's FieldLegend. Variant Legend is the fieldset title (16px/500), Label sizes it like
   a field label (14px/500) for a group of checkboxes or radios. *@
<legend data-slot="field-legend" data-variant="@(Variant == LegendVariant.Label ? "label" : "legend")" class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</legend>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS classes, merged after the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Title size: <see cref="LegendVariant.Legend"/> (default) or <see cref="LegendVariant.Label"/>.</summary>
    [Parameter] public LegendVariant Variant { get; set; } = LegendVariant.Legend;

    public enum LegendVariant
    {
        Legend,
        Label
    }

    private string CssClass => Cx.Merge(
        "mb-1.5 font-medium",
        Variant == LegendVariant.Label ? "text-sm" : "text-base",
        Class);
}
