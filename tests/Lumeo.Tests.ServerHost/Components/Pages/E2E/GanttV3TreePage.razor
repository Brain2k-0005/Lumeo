@page "/e2e/gantt-v3-tree"
@using Lumeo.GanttV3
@using Lumeo.Tests.ServerHost.E2E

@* Gantt v2/v3 parity harness (feat/gantt-v3, T4) — v3-ONLY. v2 has no
   GanttTask.ParentId concept at all, so GanttParityFixtures.TreeTasks() (a
   3-level hierarchy) is never rendered through the v2 route; there is no
   parity assertion possible here by definition, only v3-specific behavior
   (tree pane rows/indent/collapse hides bars + arrows). ShowTreePane defaults
   to true here anyway (any task sets ParentId), set explicitly for clarity.

   Phase 2, T4 (drag parity suite): ?allowCreate=1 turns on drag-create so the
   row-track y-alignment assertion (pin item J: "row-track divs align with
   virtualized bar rows for leaf/summary/group-header contexts") has a LEAF row
   (grandchild1/root2), a SUMMARY row (root1/child1 — both have children), and
   this fixture's own hierarchy depths to check against — GanttV3Page's
   SharedTasks fixture covers the GROUP-HEADER context instead (flat GroupBy,
   no hierarchy), so together the two AllowCreate-enabled routes cover all
   three row kinds the pin item asks for.

   ?fixture=tall (Codex round 6, P1 #2): swaps in GanttParityFixtures.
   TallHierarchyFixture() — tall enough to need real virtualization/arrow-
   culling, unlike the default TreeTasks (5 rows, always fully visible).

   ?fixture=rollup (design spec Phase 3, T3): swaps in GanttParityFixtures.
   RollupTasks() and turns on ShowSummaryBars — see that fixture's own
   remarks for the exact duration-weighted math this drives
   (GanttV3SummaryRollupTests). Summary bars default OFF (T3's own
   Phase-3-ledger-pinned v2/REUI look-delta — see GanttTimeline.ShowSummaryBars),
   so every OTHER route/fixture on this page renders with no strips at all,
   unaffected by this opt-in.

   ?fixture=columns (design spec Phase 3, T5): turns on TreeColumns (a
   "Duration" column, days-derived — deterministic against TreeTasks' own
   known dates) + TreeHeaderMenu (a plain trigger button) + RowTemplate (a
   bullet-prefixed name span) so GanttV3TreeColumnsSplitterTests can assert
   real column alignment/header-menu/RowTemplate-vs-chrome behavior against a
   live browser. The splitter itself (GanttTree's own divider) needs no
   fixture flag — it renders whenever the tree pane does, on every route on
   this page.

   ?checkboxes=1 / ?reorder=1 / ?readonly=1 / ?veto=1 (design spec Phase 3,
   T6): independent opt-in flags against the DEFAULT TreeTasks() fixture
   (root1[child1[grandchild1], child2], root2 — child1/child2 share root1 as
   ParentId, a real 2-member sibling bucket for a real reorder drag) —
   UNCONTROLLED (no SelectedIds/OnRowReorder bound at all): Gantt3 owns
   _state internally, so a real checkbox click / real row drag is directly
   observable in the rendered DOM with no extra page-level wiring, exactly
   like every other uncontrolled fixture on this page. ?veto=1 wires a
   CanDropRow that rejects every candidate position (GanttV3RowSelectionReorderTests'
   own veto-path spec) — deterministic and fixture-independent, unlike
   pinning the rejection to one specific task id. *@

<PageTitle>E2E - Gantt v3 tree</PageTitle>

<div class="p-4" style="max-width: 1600px;">
    <h1 data-testid="gantt-e2e-title">Gantt v3 tree (parity fixture)</h1>
    <Gantt3 Tasks="@_tasks"
            ViewMode="GanttViewMode.Day"
            Height="900px"
            ShowTreePane="true"
            AllowCreate="@_allowCreate"
            ShowSummaryBars="@_showSummaryBars"
            TreeColumns="@_treeColumns"
            TreeHeaderMenu="@(_showColumns ? TreeHeaderMenuContent : null)"
            RowTemplate="@(_showColumns ? RowTemplateContent : null)"
            Readonly="@_readonly"
            ShowRowCheckboxes="@_showRowCheckboxes"
            AllowRowReorder="@_allowRowReorder"
            CanDropRow="@(_vetoAll ? RejectEveryDrop : null)"
            data-testid="gantt-v3-tree-root" />
</div>

@code {
    [SupplyParameterFromQuery] public string? AllowCreate { get; set; }
    [SupplyParameterFromQuery] public string? Fixture { get; set; }
    [SupplyParameterFromQuery] public string? Checkboxes { get; set; }
    [SupplyParameterFromQuery] public string? Reorder { get; set; }
    [SupplyParameterFromQuery] public string? Readonly { get; set; }
    [SupplyParameterFromQuery] public string? Veto { get; set; }

    private List<GanttTask> _tasks = new();
    private bool _allowCreate;
    private bool _showSummaryBars;
    private bool _showColumns;
    private List<GanttTreeColumn>? _treeColumns;
    private bool _showRowCheckboxes;
    private bool _allowRowReorder;
    private bool _readonly;
    private bool _vetoAll;

    protected override void OnInitialized()
    {
        _tasks = Fixture switch
        {
            "tall" => GanttParityFixtures.TallHierarchyFixture(),
            "rollup" => GanttParityFixtures.RollupTasks(),
            _ => GanttParityFixtures.TreeTasks(),
        };
        _allowCreate = AllowCreate == "1";
        _showSummaryBars = Fixture == "rollup";
        _showColumns = Fixture == "columns";
        _treeColumns = _showColumns
            ? new List<GanttTreeColumn>
            {
                new("Duration", 80, DurationCellContent),
            }
            : null;
        _showRowCheckboxes = Checkboxes == "1";
        _allowRowReorder = Reorder == "1";
        _readonly = Readonly == "1";
        _vetoAll = Veto == "1";
    }

    // Design spec Phase 3, T6 — deterministic veto-path fixture (?veto=1):
    // rejects every candidate row-reorder position regardless of context, so
    // GanttV3RowSelectionReorderTests can assert a real drag never commits
    // (the drop-index line paints invalid, the task order is unchanged after
    // release) without pinning the rejection to one specific task/position.
    private static bool RejectEveryDrop(GanttTask task, GanttDropContext context) => false;

    private static RenderFragment<GanttTask> DurationCellContent => task => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "gantt-e2e-duration-cell");
        builder.AddContent(2, $"{(task.End.Date - task.Start.Date).Days}d");
        builder.CloseElement();
    };

    private static RenderFragment<GanttTask> RowTemplateContent => task => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "gantt-e2e-row-template truncate text-sm");
        builder.AddContent(2, $"• {task.Name}");
        builder.CloseElement();
    };

    private static RenderFragment TreeHeaderMenuContent => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "gantt-e2e-tree-header-menu");
        builder.AddContent(3, "...");
        builder.CloseElement();
    };
}
