@namespace Lumeo.Docs.Shared.Showcases

@* HoverCardContent is positioned via Interop.PositionFixed — per the wave brief this shows the
   trigger plus a static replica of the card (bg-popover, border-border/60, shadow-lg — lifted
   from HoverCardContent) rendered inline rather than requiring a hover interaction. *@
<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <Button Variant="Button.ButtonVariant.Link" Size="Button.ButtonSize.Sm" Class="w-fit px-0">@@blazor</Button>
        <Stack Gap="1" Class="w-56 rounded-md border border-border/60 bg-popover p-2 text-popover-foreground shadow-lg">
            <Lumeo.Text As="span" Size="sm" Weight="semibold">@@blazor</Lumeo.Text>
            <Lumeo.Text Size="xs" Color="muted">A free and open-source web framework for building interactive web UIs using C#.</Lumeo.Text>
            <Lumeo.Text Size="xs" Color="muted" Class="pt-1">Joined December 2018</Lumeo.Text>
        </Stack>
    </Stack>
</div>
