@namespace Lumeo
@* shadcn's SidebarInput: an Input dressed for the sidebar header (a search box). *@
<Input data-slot="sidebar-input" data-sidebar="input" Class="@CssClass" @attributes="AdditionalAttributes" />

@code {
    /// <summary>Additional CSS classes, merged after the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes (placeholder, value bindings, id) forwarded to the Input.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Cx.Merge("bg-background h-8 w-full shadow-none", Class);
}
