@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <TreeSelect @bind-Value="_selected" Items="@_categories" Class="w-full" />
</div>

@code {
    private string? _selected = "phones";

    private readonly List<TreeSelect.TreeSelectItem> _categories = new()
    {
        new()
        {
            Label = "Electronics", Value = "electronics",
            Children = new()
            {
                new() { Label = "Phones", Value = "phones" },
                new() { Label = "Computers", Value = "computers" },
            }
        },
        new() { Label = "Books", Value = "books" },
    };
}
