    private void HandleReconnect(FlowReconnectEventArgs args)
    {
        var updated = args.OldEdge with
        {
            Source = args.NewConnection.Source, SourceHandle = args.NewConnection.SourceHandle,
            Target = args.NewConnection.Target, TargetHandle = args.NewConnection.TargetHandle,
        };
        _reconnectEdges = _reconnectEdges.Select(e => e.Id == updated.Id ? updated : e).ToList();
        _reconnectMessage = $"{args.OldEdge.Source} → {args.OldEdge.Target} became {updated.Source} → {updated.Target}.";
    }

