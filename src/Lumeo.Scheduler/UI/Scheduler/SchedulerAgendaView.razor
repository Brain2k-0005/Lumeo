@namespace Lumeo
@using System.Globalization
@using Lumeo.SchedulerKernel
@inject Lumeo.Services.Localization.ILumeoLocalizer L

@* First-party agenda/list view (spec §1.1/§1.2/§5.1) — the existing SchedulerView.List value,
   just a first-party renderer instead of FullCalendar's listWeek (spec §0's decision to keep
   the enum member and change only the internal rendering). Not a grid — a flat, day-grouped
   list, which is what it visually already is (spec §5.1). *@
<div class="@($"flex flex-col rounded-md border border-border/60 overflow-hidden {Class}".Trim())" @attributes="AdditionalAttributes">
    <div role="list" aria-label="@L["Scheduler.List"]" class="max-h-[34rem] overflow-y-auto divide-y divide-border/60">
        @if (_days.Count == 0)
        {
            <div class="p-4 text-sm text-muted-foreground">@L["Scheduler.NoEvents"]</div>
        }
        else
        {
            @foreach (var day in _days)
            {
                <div class="p-3">
                    <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-1.5">
                        @day.Date.ToString("D", CultureInfo.CurrentUICulture)
                    </div>
                    @foreach (var row in day.Rows)
                    {
                        <div role="listitem"
                             tabindex="0"
                             class="flex items-center gap-2.5 py-1.5 px-1 rounded-md cursor-pointer hover:bg-accent/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring"
                             aria-label="@RowAriaLabel(row)"
                             @onclick="() => OnEventClickAsync(row.Source)"
                             @onkeydown="e => OnRowKeyDownAsync(e, row.Source)">
                            <span class="w-2 h-2 rounded-[calc(var(--radius)*2)] flex-none" style="background-color: @(ResolveEventColor?.Invoke(row.Source) ?? row.Source.Color ?? "var(--color-primary)")" aria-hidden="true"></span>
                            <span class="flex-1 min-w-0 text-sm font-medium truncate">@row.Source.Title</span>
                            <span class="text-xs text-muted-foreground flex-none">@TimeLabel(row)</span>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public IEnumerable<SchedulerEvent>? Events { get; set; }

    /// <summary>The window's start (inclusive). Default: today.</summary>
    [Parameter] public DateTime AnchorDate { get; set; } = DateTime.Today;

    /// <summary>How many days from <see cref="AnchorDate"/> to list. Default 30, matching the uploaded demo's "next 30 days" agenda.</summary>
    [Parameter] public int DaysToShow { get; set; } = 30;

    [Parameter] public EventCallback<SchedulerEvent> OnEventClick { get; set; }
    [Parameter] public Func<SchedulerEvent, string?>? ResolveEventColor { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private List<AgendaDay> _days = new();

    protected override void OnParametersSet()
    {
        var events = (Events ?? Enumerable.Empty<SchedulerEvent>()).ToList();
        var byId = new Dictionary<string, SchedulerEvent>(StringComparer.Ordinal);
        foreach (var ev in events)
            if (!string.IsNullOrEmpty(ev.Id)) byId[ev.Id] = ev;

        var rangeStart = AnchorDate.Date;
        var rangeEnd = rangeStart.AddDays(Math.Max(1, DaysToShow));
        var instances = SchedulerRecurrenceExpander.ExpandAll(events, rangeStart, rangeEnd)
            .Where(i => byId.ContainsKey(i.EventId))
            .ToList();

        var byDay = new SortedDictionary<DateTime, List<AgendaRow>>();
        foreach (var inst in instances)
        {
            var src = byId[inst.EventId];
            var day = inst.Start.Date < rangeStart ? rangeStart : inst.Start.Date;
            if (!byDay.TryGetValue(day, out var list))
                byDay[day] = list = new List<AgendaRow>();
            list.Add(new AgendaRow(inst, src));
        }

        _days = byDay
            .Select(kvp => new AgendaDay(kvp.Key, kvp.Value.OrderBy(r => r.Source.AllDay ? TimeSpan.Zero : r.Instance.Start.TimeOfDay).ToList()))
            .ToList();
    }

    private static string TimeLabel(AgendaRow row) => row.Source.AllDay
        ? "—"
        : row.Instance.Start.ToString("t", CultureInfo.CurrentUICulture);

    private static string RowAriaLabel(AgendaRow row) => row.Source.AllDay
        ? row.Source.Title
        : $"{row.Source.Title}, {row.Instance.Start:t}";

    private async Task OnEventClickAsync(SchedulerEvent ev)
    {
        if (OnEventClick.HasDelegate) await OnEventClick.InvokeAsync(ev);
    }

    private async Task OnRowKeyDownAsync(KeyboardEventArgs e, SchedulerEvent ev)
    {
        if (e.Key is "Enter" or " ") await OnEventClickAsync(ev);
    }

    private sealed record AgendaDay(DateTime Date, List<AgendaRow> Rows);
    private sealed record AgendaRow(SchedulerEventInstance Instance, SchedulerEvent Source);
}
