@namespace Lumeo.Docs.Shared.Showcases

@* Same reasoning as ThemeSwitcherShowcase: the real ThemeToggle calls the live
   ThemeService on click, which would flip the whole docs site's light/dark mode from
   inside a catalog card. This mirrors its exact button markup and icon swap with local
   @code state instead of the shared ThemeService, so clicking it stays contained. *@
<div class="w-full max-w-[22rem]">
    <Flex Align="center" Gap="3" Class="rounded-lg border bg-card px-4 py-3 w-full">
        <button type="button"
                class="inline-flex items-center justify-center h-8 w-8 cursor-pointer rounded-md border border-input bg-background shadow-sm transition-colors"
                aria-label="Toggle theme"
                @onclick="() => _isDark = !_isDark">
            @if (_isDark)
            {
                <SvgGlyph Svg="@(Lucide.Sun)" class="h-4 w-4" />
            }
            else
            {
                <SvgGlyph Svg="@(Lucide.Moon)" class="h-4 w-4" />
            }
        </button>
        <Stack Gap="0">
            <Lumeo.Text Size="sm" Weight="medium" Color="foreground">Dark Mode</Lumeo.Text>
            <Lumeo.Text Size="xs" Color="muted">@(_isDark ? "Dark" : "Light") mode</Lumeo.Text>
        </Stack>
    </Flex>
</div>

@code {
    private bool _isDark;
}
