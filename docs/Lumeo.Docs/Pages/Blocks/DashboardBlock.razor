                            </Tabs>
                        </div>
                    </div>
                </div>
            </SidebarInset>
        </SidebarProvider>
        <Drawer Open="@_drawerOpen" OpenChanged="@(v => _drawerOpen = v)">
            <DrawerContent Side="Lumeo.Side.Right">
                <DrawerHeader Class="gap-1">
                    <DrawerTitle>@(_drawerItem?.Header)</DrawerTitle>
