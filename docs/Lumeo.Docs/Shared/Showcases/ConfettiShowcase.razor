@namespace Lumeo.Docs.Shared.Showcases

<div class="flex w-full max-w-[22rem] items-center justify-center py-6">
    <Confetti @ref="_confetti" ParticleCount="70" Spread="80">
        <Button OnClick="HandleFire">Celebrate!</Button>
    </Confetti>
</div>

@code {
    private Lumeo.Confetti? _confetti;

    private Task HandleFire() => _confetti?.Fire() ?? Task.CompletedTask;
}
