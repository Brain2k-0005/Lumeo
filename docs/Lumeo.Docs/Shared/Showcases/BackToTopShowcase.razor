@namespace Lumeo.Docs.Shared.Showcases
@* Static exception (see ../README.md): BackToTop only appears past a real scroll
   threshold, which a catalog card can't reproduce. This renders the exact button
   markup/classes the component produces once visible, positioned within the card
   instead of fixed to the viewport. *@

<div class="relative w-full max-w-[22rem] h-24 rounded-lg border border-border/40 bg-muted/20">
    <button type="button"
            class="absolute bottom-3 end-3 flex h-10 w-10 items-center justify-center rounded-[calc(var(--radius)*3)] bg-primary text-primary-foreground shadow-lg transition-all hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-[1.5px] focus-visible:ring-ring focus-visible:ring-offset-2"
            aria-label="Back to top">
        <DynamicIcon Name="ArrowUp" Class="h-5 w-5" />
    </button>
</div>
