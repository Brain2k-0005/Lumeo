@page "/e2e/gantt-v3-preview"
@using Microsoft.AspNetCore.Components
@using Lumeo.GanttV3

@* Kitchen-sink preview of GanttChart (promoted Phase 4 — public API, docs at
   /components/gantt-chart). Deliberately NOT linked in navigation and NOT part
   of the component registry — kept as a dedicated E2E fixture page (see
   tests/Lumeo.Tests.E2E/Smokes/GanttV3PreviewPageTests.cs and the wider Gantt
   E2E suite) exercising every feature side by side with the legacy Gantt (v2)
   renderer, independent of whatever the polished docs page chooses to show. *@

<PageTitle>Gantt v3 preview — Lumeo</PageTitle>

<PageHeader Title="Gantt v3 (E2E fixture)"
            Description="Side-by-side preview of GanttChart against the legacy Gantt (v2) renderer. Same data, two engines. Kept as a dedicated E2E fixture, not linked in navigation — see /components/gantt-chart for the public docs." />

<Alert Variant="Alert.AlertVariant.Info" ShowIcon="true" Class="mt-6">
    <ChildContent>
        <strong>E2E fixture page, not a docs page.</strong> Everything below renders the public
        <code>GanttChart</code> component tree, exercised here for the browser-driven test suite
        alongside the legacy v2 renderer. For the curated docs and demos, see
        <a href="/components/gantt-chart">/components/gantt-chart</a>.
    </ChildContent>
</Alert>

<Stack Gap="8" Class="mt-8">
    <div class="space-y-3">
        <Heading Id="v3-flat" Level="2" Class="scroll-mt-20">v3 — dependencies, milestone, custom colours</Heading>
        <GanttChart Tasks="_planTasks" ViewMode="GanttViewMode.Day" Height="380px" BarColor="_barColor" />
    </div>

    <div class="space-y-3">
        <Heading Id="v3-grouped" Level="2" Class="scroll-mt-20">v3 — grouped (flat swim-lanes)</Heading>
        <GanttChart Tasks="_planTasks" ViewMode="GanttViewMode.Day" Height="420px" GroupBy="_groupBy" />
    </div>

    <div class="space-y-3">
        <Heading Id="v3-tree" Level="2" Class="scroll-mt-20">v3 — ParentId hierarchy with tree pane (new in v3)</Heading>
        <GanttChart Tasks="_treeTasks" ViewMode="GanttViewMode.Day" Height="380px" />
    </div>

    <div class="space-y-3">
        <Heading Id="v3-tree-columns" Level="2" Class="scroll-mt-20">v3 — multi-column tree, resizable splitter, tree meta line (Phase 3, T5 + T10a)</Heading>
        <p class="text-sm text-muted-foreground">Drag the divider at the tree pane's trailing edge to resize it. "Progress" is a typed <code>GanttTreeColumn</code>; the second line under each name is <code>ShowTaskMeta</code> (2026-08-10 shadcn alignment, G6 — off by default, opt-in here).</p>
        <GanttChart Tasks="_treeTasks" ViewMode="GanttViewMode.Day" Height="380px" TreeColumns="_treeColumns" ShowTaskMeta="true" />
    </div>

    <div class="space-y-3">
        <Heading Id="v3-summary-bars" Level="2" Class="scroll-mt-20">v3 — duration-weighted summary rollup bars (Phase 3, T3)</Heading>
        <p class="text-sm text-muted-foreground">Parent rows ("Platform", "UI") render an envelope strip spanning their children's dates, with a duration-weighted progress % — <code>ShowSummaryBars</code> defaults <c>false</c> (a pinned v2/REUI look-delta), on here.</p>
        <GanttChart Tasks="_treeTasks" ViewMode="GanttViewMode.Day" Height="380px" ShowSummaryBars="true" />
    </div>

    <div class="space-y-3">
        <Heading Id="v3-settings-quarter" Level="2" Class="scroll-mt-20">v3 — <code>GanttSettingsMenu</code> companion, starting in Quarter mode (Phase 3, T2 + T8)</Heading>
        <p class="text-sm text-muted-foreground">
            The gear icon in the toolbar opens the settings popover (Display/Behavior/Region/Style — every REUI-parity toggle this component ships, two-way bound to the fields below).
            Quarter is a v3-only scale (3-month columns, no v2 counterpart) — switch to Day/Week/Month/Year via the zoom switcher, now a <code>Segmented</code> control
            (2026-08-10 shadcn alignment, G1) instead of separately-bordered buttons.
        </p>
        <GanttChart Tasks="_roadmapTasks" ViewMode="GanttViewMode.Quarter" Height="420px"
                ShowRowCheckboxes="@_showRowCheckboxes" ShowSummaryBars="@_showSummaryBars" ShowZoomControl="@_showZoomControl"
                ShowOffscreenIndicators="@_showOffscreenIndicators" InfiniteScroll="@_infiniteScroll" NowIndicator="@_nowIndicator"
                MarkOffDays="@_markOffDays" Readonly="@_readonly" AllowCreate="@_allowCreate" AllowRowReorder="@_allowRowReorder"
                FirstDayOfWeek="@_firstDayOfWeek" OffDays="@_offDays" ColorByGroup="@_colorByGroup">
            <TrailingContent>
                <GanttSettingsMenu @bind-ShowRowCheckboxes="_showRowCheckboxes"
                                    @bind-ShowSummaryBars="_showSummaryBars"
                                    @bind-ShowZoomControl="_showZoomControl"
                                    @bind-ShowOffscreenIndicators="_showOffscreenIndicators"
                                    @bind-InfiniteScroll="_infiniteScroll"
                                    @bind-NowIndicator="_nowIndicator"
                                    @bind-MarkOffDays="_markOffDays"
                                    @bind-Readonly="_readonly"
                                    @bind-AllowCreate="_allowCreate"
                                    @bind-AllowRowReorder="_allowRowReorder"
                                    @bind-FirstDayOfWeek="_firstDayOfWeek"
                                    @bind-OffDays="_offDays"
                                    @bind-ColorByGroup="_colorByGroup" />
            </TrailingContent>
        </GanttChart>
    </div>

    <div class="space-y-3">
        <Heading Id="v2-reference" Level="2" Class="scroll-mt-20">v2 reference — same data, shipping renderer</Heading>
        <Gantt Tasks="_planTasks" ViewMode="GanttViewMode.Day" Height="380px" BarColor="_barColor" />
    </div>
</Stack>

@code {
    // Deterministic offsets around today so the today marker is always in range.
    private static readonly DateTime _t = DateTime.Today;

    private readonly Func<GanttTask, string?> _barColor = t => t.Id switch
    {
        "design" => "var(--color-chart-2)",
        "review" => "var(--color-destructive)",
        _ => null,
    };

    private readonly Func<GanttTask, string> _groupBy = t => t.GroupLabel ?? "Other";

    private readonly List<GanttTask> _planTasks = new()
    {
        new("kickoff", "Kickoff", _t.AddDays(-6), _t.AddDays(-6), Progress: 100, IsMilestone: true, GroupLabel: "Planning"),
        new("spec", "Write spec", _t.AddDays(-5), _t.AddDays(-2), Progress: 100, Dependencies: new[] { "kickoff" }, GroupLabel: "Planning"),
        new("design", "Design pass", _t.AddDays(-1), _t.AddDays(2), Progress: 60, Dependencies: new[] { "spec" }, GroupLabel: "Build"),
        new("impl", "Implementation", _t, _t.AddDays(5), Progress: 35, Dependencies: new[] { "spec" }, GroupLabel: "Build"),
        new("review", "Review", _t.AddDays(6), _t.AddDays(8), Dependencies: new[] { "design", "impl" }, GroupLabel: "Ship"),
        new("release", "Release", _t.AddDays(9), _t.AddDays(9), IsMilestone: true, Dependencies: new[] { "review" }, GroupLabel: "Ship"),
    };

    private readonly List<GanttTask> _treeTasks = new()
    {
        new("platform", "Platform", _t.AddDays(-4), _t.AddDays(6), Progress: 45),
        new("api", "API", _t.AddDays(-4), _t.AddDays(1), Progress: 80) { ParentId = "platform" },
        new("ui", "UI", _t.AddDays(-1), _t.AddDays(6), Progress: 30) { ParentId = "platform" },
        new("uiTheme", "Theming", _t.AddDays(2), _t.AddDays(6), Progress: 10, Dependencies: new[] { "api" }) { ParentId = "ui" },
        new("qa", "QA", _t.AddDays(4), _t.AddDays(8)),
    };

    // Design spec Phase 3, T5 — a typed extra column (Progress %) alongside the
    // pinned name column, same "Duration" pattern the E2E fixture
    // (GanttV3TreePage.razor's ?fixture=columns) already established.
    private readonly List<GanttTreeColumn> _treeColumns = new()
    {
        new("Progress", 90, ProgressCellContent),
    };

    private static RenderFragment<GanttTask> ProgressCellContent => task => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "text-xs text-muted-foreground");
        builder.AddContent(2, $"{task.Progress}%");
        builder.CloseElement();
    };

    // 2026-08-10 shadcn alignment / Phase 3, T2 — a wider, quarter-spanning
    // fixture: _planTasks/_treeTasks' own +/-9-day windows are too tight to
    // show anything meaningful at Quarter zoom (3-month columns).
    private readonly List<GanttTask> _roadmapTasks = new()
    {
        new("discovery", "Discovery", _t.AddMonths(-4), _t.AddMonths(-3), Progress: 100, GroupLabel: "Foundation"),
        new("architecture", "Architecture", _t.AddMonths(-3), _t.AddMonths(-1), Progress: 100, Dependencies: new[] { "discovery" }, GroupLabel: "Foundation"),
        new("beta", "Beta launch", _t.AddMonths(-1), _t.AddMonths(-1), Progress: 100, IsMilestone: true, Dependencies: new[] { "architecture" }, GroupLabel: "Foundation"),
        new("coreBuild", "Core build-out", _t.AddMonths(-1), _t.AddMonths(3), Progress: 55, Dependencies: new[] { "beta" }, GroupLabel: "Growth"),
        new("integrations", "Partner integrations", _t.AddMonths(1), _t.AddMonths(5), Progress: 20, GroupLabel: "Growth"),
        new("ga", "General availability", _t.AddMonths(6), _t.AddMonths(6), IsMilestone: true, Dependencies: new[] { "coreBuild", "integrations" }, GroupLabel: "Growth"),
        new("scale", "Scale + hardening", _t.AddMonths(6), _t.AddMonths(11), GroupLabel: "Maturity"),
    };

    // v3-only settings, two-way bound to GanttSettingsMenu — same field set
    // GanttV3Page.razor (the E2E parity host) wires, ShowOffscreenIndicators
    // and InfiniteScroll seeded to their own library defaults (both true).
    private bool _showRowCheckboxes;
    private bool _showSummaryBars;
    private bool _showZoomControl;
    private bool _showOffscreenIndicators = true;
    private bool _infiniteScroll = true;
    private bool _nowIndicator;
    private bool _markOffDays;
    private bool _readonly;
    private bool _allowCreate;
    private bool _allowRowReorder;
    private DayOfWeek? _firstDayOfWeek;
    private IReadOnlySet<DayOfWeek>? _offDays;
    private bool _colorByGroup;
}
