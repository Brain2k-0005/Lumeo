@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Mention @bind-Value="_text" Options="@_people" Placeholder="@_placeholder" Rows="2" Class="w-full" />
</div>

@code {
    private string _text = "";
    private readonly string _placeholder = "Type @ to mention someone...";
    private readonly List<Mention.MentionOption> _people = new()
    {
        new("Ada Lovelace", "ada"),
        new("Grace Hopper", "grace"),
        new("Alan Turing", "alan"),
    };
}
