@namespace Lumeo
@inject Lumeo.Services.Localization.ILumeoLocalizer L

@* FlowHandle — a connection port, placed inside a node template. Positions itself on the node
   host's edge (the host is the containing block), and tells the engine where edges attach: the
   engine measures every [data-flow-handle] inside a node and edges bound to this handle (by Id,
   or the node's first handle of this Type) start/end at its centre.

   Dragging from a Source handle to a compatible Target handle proposes a connection (flow.js
   owns the gesture end to end — see CommitConnect on FlowCanvas). A tab stop (tabindex="0") so
   keyboard connect works: Enter on a Source handle enters "connecting" mode (flow.js marks every
   compatible target with data-flow-handle-valid and announces it), Enter on a Target handle
   commits, Escape cancels — all handled by flow.js's pane-level keydown listener, not a Blazor
   event, so it works without a render round trip per keystroke.

   LU-05: when connecting is impossible anyway (the canvas is Readonly/locked, NodesConnectable is
   off, or this NODE's own Connectable is off) the handle drops out of the tab order
   (tabindex="-1") and is hidden from assistive tech (aria-hidden) — it stays VISIBLE (still a
   port, just not an affordance) rather than disappearing, so the diagram still reads the same.
   Standalone (no cascaded FlowCanvasContext, e.g. a component test rendering FlowHandle on its
   own) keeps the plain tab stop — there is no readonly/connectable state to check. *@

<button type="button"
        data-flow-handle
        data-handle-type="@(Type == FlowHandleType.Source ? "source" : "target")"
        data-handle-id="@Id"
        data-position="@FlowGeometry.FormatPosition(Position)"
        tabindex="@(Interactive ? "0" : "-1")"
        aria-hidden="@(Interactive ? null : "true")"
        aria-label="@AriaLabel"
        class="@Cx.Merge("lumeo-flow-handle", Class)"
        style="@PositionStyle"
        @attributes="AdditionalAttributes"></button>

@code {
    [CascadingParameter] private FlowCanvas.FlowCanvasContext? Context { get; set; }
    [CascadingParameter(Name = "LumeoFlowNode")] private FlowNode? Node { get; set; }

    /// <summary>Source (edges start here) or target (edges end here).</summary>
    [Parameter] public FlowHandleType Type { get; set; } = FlowHandleType.Source;

    /// <summary>The side of the node the handle sits on, and the direction edges leave/enter it.</summary>
    [Parameter] public FlowPosition Position { get; set; } = FlowPosition.Right;

    /// <summary>Handle id, for nodes with several handles of the same type (matched by <c>FlowEdge.SourceHandle</c>/<c>TargetHandle</c>).</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Additional CSS classes merged onto the handle button.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Captures unmatched attributes and applies them to the handle button.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // LU-05: no cascaded canvas (standalone render) => can't tell, stay interactive. Otherwise:
    // canvas-level connect switch (NodesConnectable/Readonly/lock, via the internal
    // CanConnectGlobally that already backs FlowNodeHost's own Connectable data attribute) AND
    // this handle's own node's Connectable, when the node is known.
    private bool Interactive
        => Context is null || (Context.Canvas.CanConnectGlobally && (Node is null || Node.Connectable));

    private string AriaLabel
    {
        get
        {
            var name = Node?.Id ?? string.Empty;
            return Type == FlowHandleType.Source ? L["Flow.ConnectFrom", name] : L["Flow.ConnectTo", name];
        }
    }

    private string PositionStyle => Position switch
    {
        FlowPosition.Left => "position:absolute;left:0;top:50%;transform:translate(-50%,-50%);",
        FlowPosition.Right => "position:absolute;left:100%;top:50%;transform:translate(-50%,-50%);",
        FlowPosition.Top => "position:absolute;left:50%;top:0;transform:translate(-50%,-50%);",
        _ => "position:absolute;left:50%;top:100%;transform:translate(-50%,-50%);",
    };
}
