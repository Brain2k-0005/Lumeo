@namespace Lumeo.Docs.Shared.Showcases

@* Hero's inner wrapper hardcodes h1 sizing (text-4xl..6xl) and py-16 sm:py-24 —
   neither is exposed via Class. TitleSlot bypasses the fixed-size h1 in favour
   of a compact heading; the fixed vertical padding still clips at the bottom
   in the 236px box, matching the wave brief's "Hero headline + button" example
   of a cropped, scaled-down slice. *@
<div class="w-full max-w-[22rem] overflow-hidden">
    <Hero Alignment="Hero.HeroAlignment.Center">
        <TitleSlot>
            <Lumeo.Text Class="text-xl font-bold text-foreground">Build faster with Lumeo</Lumeo.Text>
        </TitleSlot>
        <Actions>
            <Button Size="Button.ButtonSize.Sm">Get Started</Button>
        </Actions>
    </Hero>
</div>
