@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Stack Gap="3" Class="w-full">
        <Container MaxWidth="xs" Class="border border-dashed border-border rounded-lg py-2">
            <Lumeo.Text Size="xs" Color="muted" Align="center">max-w-xs</Lumeo.Text>
        </Container>
        <Container MaxWidth="sm" Class="border border-dashed border-border rounded-lg py-2">
            <Lumeo.Text Size="xs" Color="muted" Align="center">max-w-sm</Lumeo.Text>
        </Container>
        <Container MaxWidth="md" Class="border border-dashed border-border rounded-lg py-2">
            <Lumeo.Text Size="xs" Color="muted" Align="center">max-w-md</Lumeo.Text>
        </Container>
    </Stack>
</div>
