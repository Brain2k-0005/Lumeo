@namespace Lumeo.Docs.Shared.Showcases

@* Real component end to end (fix round 1): DropdownMenuContent is positioned through
   Interop.PositionFixed and escapes the card's overflow-hidden (README rule 4). Default
   closed, real trigger, click to open the real menu. *@
<div class="w-full max-w-[22rem]">
    <DropdownMenu>
        <DropdownMenuTrigger>
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm">
                Open
                <DynamicIcon Name="ChevronDown" Class="ml-2 h-4 w-4" />
            </Button>
        </DropdownMenuTrigger>
        <DropdownMenuContent>
            <DropdownMenuLabel>My Account</DropdownMenuLabel>
            <DropdownMenuSeparator />
            <DropdownMenuItem>Profile</DropdownMenuItem>
            <DropdownMenuItem>Settings</DropdownMenuItem>
            <DropdownMenuSeparator />
            <DropdownMenuItem>Log out</DropdownMenuItem>
        </DropdownMenuContent>
    </DropdownMenu>
</div>
