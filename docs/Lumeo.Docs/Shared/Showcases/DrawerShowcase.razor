@namespace Lumeo.Docs.Shared.Showcases

@* DrawerContent renders `position: fixed; inset-x-0 bottom-0` — a real Drawer slides up over
   the full viewport width, not a 16:9 card. This shows the trigger plus a static replica of
   the bottom sheet (drag handle, rounded-t corners, bg-background, shadow-lg — lifted from
   DrawerContent/DrawerHeader/DrawerTitle), pinned to the bottom of the box in normal flow. *@
<div class="w-full max-w-[22rem] h-40 rounded-lg border border-border/40 bg-muted/20 overflow-hidden relative">
    <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Xs" Class="absolute top-2 start-2">Open Drawer</Button>
    <Stack Gap="2" Class="absolute inset-x-0 bottom-0 rounded-t-[10px] bg-background p-3 shadow-lg">
        <div class="mx-auto h-1.5 w-16 rounded-full bg-muted"></div>
        <Stack Gap="0.5">
            <Lumeo.Text Size="sm" Weight="semibold">Move Goal</Lumeo.Text>
            <Lumeo.Text Size="xs" Color="muted">Set your daily activity goal.</Lumeo.Text>
        </Stack>
        <Flex Justify="end" Gap="2">
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Xs">Cancel</Button>
            <Button Size="Button.ButtonSize.Xs">Submit</Button>
        </Flex>
    </Stack>
</div>
