@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Card>
        <CardHeader>
            <Heading Level="3" Size="sm" Class="leading-none tracking-tight">Notifications</Heading>
            <Lumeo.Text Size="xs" Color="muted">You have 3 unread messages.</Lumeo.Text>
        </CardHeader>
        <CardContent>
            <Lumeo.Text Size="xs">Stay up to date with the latest activity.</Lumeo.Text>
        </CardContent>
        <CardFooter>
            <Button Size="Button.ButtonSize.Sm" Class="w-full">Mark all as read</Button>
        </CardFooter>
    </Card>
</div>
