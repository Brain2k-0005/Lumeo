@page "/blocks/authentication"
@namespace Lumeo.Docs.Pages.Blocks

<PageTitle>Authentication — Lumeo Blocks</PageTitle>

<PageHeader Title="Authentication"
            Description="shadcn's Authentication example, ported one to one: a split page with a tinted brand panel and a testimonial on the left, and a create-account form on the right: an email field and a submit button inside a FieldGroup, an 'Or continue with' FieldSeparator, a GitHub button, and the terms line as a FieldDescription. Submitting shows the three-second loading state." />

<Stack Gap="10" Class="mt-8">
    <ComponentDemo Id="authentication" Title="Authentication" Description="A split authentication page with an email sign-in form." Code="@_code">
        <div class="relative grid min-h-[800px] items-center justify-center overflow-hidden rounded-[var(--radius-lg)] border border-border/40 bg-background lg:grid-cols-2">
            <Button Variant="Button.ButtonVariant.Ghost" Href="#" Class="absolute top-4 right-4 md:top-8 md:right-8">Login</Button>
            <div class="relative hidden h-full flex-col p-10 text-primary lg:flex dark:border-r">
                <div class="absolute inset-0 bg-primary/5"></div>
                <div class="relative z-20 flex items-center text-lg font-medium">
                    <SvgGlyph Svg="@(Lucide.Command)" class="mr-2 h-6 w-6" />
                    Acme Inc
                </div>
                <div class="relative z-20 mt-auto">
                    <blockquote class="leading-normal text-balance">
                        &ldquo;This library has saved me countless hours of work and helped me deliver stunning designs to my clients faster than ever before.&rdquo; - Sofia Davis
                    </blockquote>
                </div>
            </div>
            <div class="flex items-center justify-center lg:h-[800px] lg:p-8">
                <div class="mx-auto flex w-full flex-col justify-center gap-6 sm:w-[350px]">
                    <div class="flex flex-col gap-2 text-center">
                        <h1 class="text-2xl font-semibold tracking-tight">Create an account</h1>
                        <p class="text-sm text-muted-foreground">Enter your email below to create your account</p>
                    </div>
                    <div class="grid gap-6">
                        <form @onsubmit="Submit" @onsubmit:preventDefault>
                            <FieldGroup>
                                <Field>
                                    <FieldLabel Class="sr-only" For="auth-email">Email</FieldLabel>
                                    <Input id="auth-email" Placeholder="name@example.com" type="email" autocapitalize="none" autocomplete="email" autocorrect="off" Disabled="@_loading" />
                                </Field>
                                <Field>
                                    <Button Type="Button.ButtonType.Submit" Disabled="@_loading">
                                        @if (_loading)
                                        {
                                            <Spinner />
                                        }
                                        Sign In with Email
                                    </Button>
                                </Field>
                            </FieldGroup>
                        </form>
                        <FieldSeparator>Or continue with</FieldSeparator>
                        <Button Variant="Button.ButtonVariant.Outline" Disabled="@_loading">
                            @if (_loading)
                            {
                                <Spinner />
                            }
                            else
                            {
                                <ProviderIcon Provider="GitHub" class="mr-2 h-4 w-4" />
                            }
                            GitHub
                        </Button>
                    </div>
                    <FieldDescription Class="px-6 text-center">
                        By clicking continue, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
                    </FieldDescription>
                </div>
            </div>
        </div>
    </ComponentDemo>
</Stack>

@code {
    private const string _code = @"<div class=""relative grid min-h-[800px] items-center justify-center overflow-hidden rounded-[var(--radius-lg)] border border-border/40 bg-background lg:grid-cols-2"">
    <Button Variant=""Button.ButtonVariant.Ghost"" Href=""#"" Class=""absolute top-4 right-4 md:top-8 md:right-8"">Login</Button>
    <div class=""relative hidden h-full flex-col p-10 text-primary lg:flex dark:border-r"">
        <div class=""absolute inset-0 bg-primary/5""></div>
        <div class=""relative z-20 flex items-center text-lg font-medium"">
            <SvgGlyph Svg=""@(Lucide.Command)"" class=""mr-2 h-6 w-6"" />
            Acme Inc
        </div>
        <div class=""relative z-20 mt-auto"">
            <blockquote class=""leading-normal text-balance"">
                &ldquo;This library has saved me countless hours of work and helped me deliver stunning designs to my clients faster than ever before.&rdquo; - Sofia Davis
            </blockquote>
        </div>
    </div>
    <div class=""flex items-center justify-center lg:h-[800px] lg:p-8"">
        <div class=""mx-auto flex w-full flex-col justify-center gap-6 sm:w-[350px]"">
            <div class=""flex flex-col gap-2 text-center"">
                <h1 class=""text-2xl font-semibold tracking-tight"">Create an account</h1>
                <p class=""text-sm text-muted-foreground"">Enter your email below to create your account</p>
            </div>
            <div class=""grid gap-6"">
                <form @onsubmit=""Submit"" @onsubmit:preventDefault>
                    <FieldGroup>
                        <Field>
                            <FieldLabel Class=""sr-only"" For=""auth-email"">Email</FieldLabel>
                            <Input id=""auth-email"" Placeholder=""name@example.com"" type=""email"" autocapitalize=""none"" autocomplete=""email"" autocorrect=""off"" Disabled=""@_loading"" />
                        </Field>
                        <Field>
                            <Button Type=""Button.ButtonType.Submit"" Disabled=""@_loading"">
                                @if (_loading)
                                {
                                    <Spinner />
                                }
                                Sign In with Email
                            </Button>
                        </Field>
                    </FieldGroup>
                </form>
                <FieldSeparator>Or continue with</FieldSeparator>
                <Button Variant=""Button.ButtonVariant.Outline"" Disabled=""@_loading"">
                    @if (_loading)
                    {
                        <Spinner />
                    }
                    else
                    {
                        <ProviderIcon Provider=""GitHub"" class=""mr-2 h-4 w-4"" />
                    }
                    GitHub
                </Button>
            </div>
            <FieldDescription Class=""px-6 text-center"">
                By clicking continue, you agree to our <a href=""#"">Terms of Service</a> and <a href=""#"">Privacy Policy</a>.
            </FieldDescription>
        </div>
    </div>
</div>";

    private bool _loading;

    // shadcn's onSubmit: three seconds of "isLoading", then back.
    private async Task Submit()
    {
        _loading = true;
        await Task.Delay(3000);
        _loading = false;
    }
}
