    /// hierarchy-parent or flat-group row (design spec Phase 3, T3 — "Summary
    /// rollup bars, duration-weighted"). Default <c>false</c>: a deliberate
    /// v3-look delta from REUI (which defaults its own <c>summaryBars</c>
    /// prop to true) — see the Phase-3 ledger entry for the full reasoning.
    /// Turning this off entirely skips <see cref="GanttRollupModel.ComputeRollups"/>
    /// (see <see cref="Rollups"/>), so an existing chart with hierarchy/GroupBy
    /// already in use pays nothing for the feature until it opts in.
    /// </summary>
    [Parameter] public bool ShowSummaryBars { get; set; }

    /// <summary>
    /// Overrides the default duration-weighted rollup math (design spec Phase
    /// 3, T3 — "Overridable rollup math"; the REUI <c>getSummaryProgress</c>
    /// analog). Invoked once per eligible parent/group row with that row's
    /// DIRECT children — see <see cref="GanttRollupModel"/>'s own remarks for
    /// exactly what "direct children" means for a nested hierarchy parent
    /// (transitivity via substitution, not a flattened descendant list) and
    /// for the defensive contract a throwing or out-of-range-returning
    /// override gets wrapped in regardless (<c>GanttRollupModel.SafeInvokeRollupMath</c>)
    /// — a broken override degrades to the default math for that one row, it
    /// never takes the rest of the chart down. <c>null</c> (the default) uses
    /// <see cref="GanttRollupModel.DefaultRollupMath"/> for every row.
    /// </summary>
    [Parameter] public Func<IReadOnlyList<GanttTask>, GanttRollup>? RollupMath { get; set; }

    /// <summary>
    /// Replaces a summary strip's default (bg + fill + % label) content when
    /// set (design spec Phase 3, T3 — the REUI <c>renderSummary</c> analog).
    /// <c>null</c> (the default) uses <see cref="GanttSummaryBar"/>'s own
    /// built-in rendering.
    /// </summary>
    [Parameter] public RenderFragment<GanttRollup>? SummaryTemplate { get; set; }

    /// <summary>
    /// Assigns each task a stable per-group <c>var(--color-chart-1..5)</c> bar
    /// colour when <see cref="BarColor"/> is null (design spec Phase 3, T7 —
    /// "default palette assigns stable per-group colors ... when BarColor is
    /// null"). Default <c>false</c> — see the Phase-3 ledger entry for the
    /// full "opt-in like every other REUI-parity addition with no v2
    /// precedent" reasoning (<see cref="ShowSummaryBars"/> above already
    /// established the identical default posture for the same reason). The
    /// "group" is the task's own reorder bucket — see
    /// <see cref="GanttColorModel.ResolveGroupColorVar"/> for the exact key
    /// and its cross-reorder/cross-render stability proof.
    /// </summary>
    [Parameter] public bool ColorByGroup { get; set; }

    /// <summary>
    /// Renders a small directional chip at a row's edge when that row's bar
    /// is entirely outside the current horizontal scroll viewport, clicking
    /// it scrolls the bar back into view (design spec Phase 3, T7 —
    /// "Off-screen indicator chips ... direction arrow + click scrolls the
    /// bar into view"). Default <c>true</c> — DELIBERATELY the one exception
    /// to this campaign's "new look-changing REUI-parity features default
    /// off" precedent (<see cref="ShowSummaryBars"/>/<see cref="NowIndicator"/>/
    /// <see cref="MarkOffDays"/> all opt-in): the plan text explicitly pins
    /// this one to REUI's own default-true, and unlike those three, an
    /// off-screen chip is a NAVIGATION AID whose absence is a silent
    /// discoverability regression (a bar scrolled out of view with no
    /// affordance to find it again), not a purely cosmetic surface a
    /// consumer's existing visual-snapshot baseline could be surprised by —
    /// the chip only ever appears in direct response to the VIEWER's own
    /// scroll action, never as part of a chart's initial/at-rest look, so
    /// there is no "chart looked different on upgrade with no code change"
    /// risk the opt-in precedent exists to prevent in the first place. See
    /// the Phase-3 ledger entry for the full reasoning.
    /// </summary>
    [Parameter] public bool ShowOffscreenIndicators { get; set; } = true;

    /// <summary>
    /// Renders a floating +/- zoom control in the canvas corner, stepping
    /// through <see cref="ZoomLevels"/> (design spec Phase 3, T7 — "Floating
    /// zoom control ... in addition to the toolbar switcher"). Default
    /// <c>false</c> — an ADDITIONAL, purely decorative UI surface (unlike
    /// <see cref="ShowOffscreenIndicators"/>'s navigation-aid argument above,
    /// a toolbar zoom switcher already exists via <c>GanttNav</c> in every
    /// existing v3 chart) that changes a chart's at-rest visual footprint the
    /// moment it renders — the standard opt-in posture applies here exactly
    /// as it did for <see cref="ShowSummaryBars"/>.
    /// </summary>
    [Parameter] public bool ShowZoomControl { get; set; }

    /// <summary>
    /// Restricts which zoom levels <see cref="Lumeo.GanttZoomControl"/> steps
    /// through when <see cref="ShowZoomControl"/> is on — same contract
    /// (including the default full Day/Week/Month/Year set and the
    /// Quarter-must-be-explicitly-opted-in rule) as <c>GanttNav.ZoomLevels</c>,
    /// which this deliberately mirrors rather than reimplements (see
    /// <see cref="Lumeo.GanttZoomControl"/>'s own remarks).
    /// </summary>
    [Parameter] public IReadOnlyList<GanttViewMode>? ZoomLevels { get; set; }

    /// <summary>
    /// Ctrl/Cmd + wheel over the timeline zooms, anchored on the pointer
    /// position (ReUI parity — <c>wheelZoom</c>, defaulting <c>true</c>). A
    /// BARE wheel is never touched (no listener decision even looks at it
    /// beyond the ctrl/meta check) — the page/pane keeps scrolling exactly as
    /// it would with no Gantt on it at all, which is the entire reason ReUI
    /// requires the modifier rather than hijacking plain wheel. At the
    /// current <see cref="ZoomLevels"/> list's own zoom limits (already at
    /// the finest/coarsest resolved level) the gesture is left alone
    /// entirely — no <c>preventDefault</c> — so the BROWSER's own ctrl/cmd+wheel
    /// page-zoom takes over instead of the gesture being silently swallowed.
    /// Steps through the SAME resolved <see cref="GanttZoomLevelModel"/> list
    /// <see cref="Lumeo.GanttZoomControl"/>/<c>GanttNav</c> already step
    /// through (see <see cref="GanttZoomLevelModel"/>'s own "shared, never
    /// duplicated" remarks) — a discrete stepper, not a continuous zoom
    /// factor: GanttV3's zoom model is ALREADY a fixed 4-5 mode ladder
    /// (Day/Week/Month/[Quarter]/Year), unlike ReUI's own continuous 0.5-3
    /// factor grafted onto a single view. Introducing a second, continuous
    /// "zoom factor" alongside that existing discrete model would be a much
    /// larger, orthogonal change (a new persisted scale dimension every
    /// other GanttV3 pixel computation would need to multiply through) for a
    /// gesture that, discretely stepped, already reads as "zoom" to a user —
    /// stepping is the right fit for THIS scale model, not a compromise.
    /// </summary>
    [Parameter] public bool WheelZoom { get; set; } = true;

    /// <summary>
    /// Raised instead of <see cref="ViewModeChanged"/> when a wheel-zoom
    /// gesture (<see cref="WheelZoom"/>) picks a new mode AND a richer host
    /// (<c>GanttChart</c>) is listening — carries the anchor date (under the
    /// OLD scale, at the pointer's content-space position) and the pointer's
    /// own local offset from the viewport's left edge, so the host can
    /// recenter the SAME date back under the pointer after the mode switch
    /// instead of merely preserving the viewport's CENTER (what every OTHER
    /// <see cref="ViewMode"/> trigger — the toolbar, an imperative
    /// <c>SetViewMode</c> — already does via <c>GanttChart</c>'s own
    /// capture/recenter pipeline). Falls back to invoking
    /// <see cref="ViewModeChanged"/> directly (no anchor) when this has no
    /// delegate — a standalone <see cref="Lumeo.GanttTimeline"/> (no
    /// <c>GanttChart</c> wrapping it, so nothing to recenter with anyway)
    /// still gets basic wheel-zoom this way. Never invoked TOGETHER with
    /// <see cref="ViewModeChanged"/> for the SAME gesture (would race
    /// <c>GanttChart</c>'s own mode-change guard, applying the intent twice
    /// and silently discarding whichever call lands second) — exactly one of
    /// the two fires.
    /// </summary>
    [Parameter] public EventCallback<(GanttViewMode Mode, DateTime AnchorDate, double AnchorOffsetPx)> OnWheelZoomRequested { get; set; }

    /// <summary>
    /// Pixel-precise offset (from the scroll viewport's own left edge) a
    /// pending <see cref="ScrollTargetXOverride"/>/<see cref="ScrollTargetDate"/>
    /// recenter should land at, INSTEAD of <c>centerOn</c>'s usual
    /// viewport-CENTER placement — <c>GanttChart</c>'s own wheel-zoom anchor
    /// preservation is the one caller (see <see cref="OnWheelZoomRequested"/>'s
    /// remarks): every other recenter in this codebase genuinely wants the
    /// captured date centered, so this stays <c>null</c> for them, preserving
    /// their exact prior "center" behavior. Honored only while the SAME
    /// intent this render's <see cref="ScrollTargetDate"/>/<see cref="ScrollToTodayRequestId"/>
    /// pairs with is still pending — same one-shot-then-expires contract as
    /// <see cref="ScrollTargetXOverride"/> itself.
    /// </summary>
    [Parameter] public double? ScrollTargetOffsetOverride { get; set; }

    /// <summary>
    /// Overrides the drag ghost's rendered content for every bar (design spec Phase
    /// 3, T8). Passed straight through to <see cref="Lumeo.GanttBar.DragGhostTemplate"/>
    /// — see its own remarks for the full coordinate-space contract.
    /// </summary>
    [Parameter] public RenderFragment<GanttTask>? DragGhostTemplate { get; set; }

    /// <summary>
    /// Renders a Lumeo <c>ContextMenu</c> at the pointer when a bar is right-clicked
    /// (design spec Phase 3, T8). Null (the default) leaves right-click on a bar
    /// alone — the browser's native context menu shows, exactly as before this
    /// parameter existed. Deliberately independent of <see cref="Readonly"/> — a
    /// context menu is a VIEW action, not an edit; see
    /// <see cref="NotifyBarContextMenu"/>'s own remarks for the full reasoning and
    /// the drag-isolation contract (a right-click landing on a bar mid-gesture is
    /// swallowed entirely, never opens a menu).
    /// </summary>
    [Parameter] public RenderFragment<GanttTask>? BarContextMenu { get; set; }

    /// <summary>
    /// Nearing either horizontal edge of the currently-rendered range extends
    /// it by another page instead of dead-ending (design spec Phase 3, T9 —
    /// "horizontal infinite scroll ... replaces v2's fixed pad-before/after").
    /// Default <c>true</c> (see the Phase-3 ledger entry, decision 1, for the
    /// full "what does an existing Phase-1 consumer actually notice" reasoning
    /// — the short version: nothing, until they scroll far enough to reach the
    /// ORIGINAL padded edge, at which point the timeline now keeps going
    /// instead of dead-ending). <c>false</c> restores exactly v2's own fixed
    /// pad-before/after — <see cref="Lumeo.GanttChart"/>'s own
    /// <c>ComputeInitialRange</c>/<c>ApplyPadding</c> are COMPLETELY unchanged
    /// by this parameter; it only gates whether <see cref="OnGanttV3VerticalScroll"/>
    /// ever asks for MORE range once the user scrolls near what those already
    /// computed.
    /// </summary>
    [Parameter] public bool InfiniteScroll { get; set; } = true;

    /// <summary>
    /// Bubbles a "the user scrolled near an edge, please extend VisibleRange"
    /// request up to <see cref="Lumeo.GanttChart"/> (design spec Phase 3, T9) — this
    /// component never owns <c>VisibleRange</c> itself (it only ever RECEIVES
    /// <see cref="RangeStart"/>/<see cref="RangeEnd"/> as plain parameters, the
    /// same "GanttChart is the only place that touches GanttState" discipline every
    /// other bubbled edit in this file already follows — see
    /// <see cref="OnTaskUpdate"/>'s own remarks), so it can only ask, never
    /// commit. <c>true</c> = the LEADING (earlier-dates) edge — the coordinate
    /// origin shifts, so the caller must recenter; <c>false</c> = TRAILING
    /// (later-dates) — a pure append, origin unchanged, no recenter needed. Not
    /// part of any consumer-facing contract (this component is only public
    /// because the Razor compiler forces it — see this file's own class
    /// remarks); wired internally by <c>GanttChart</c> only.
    /// </summary>
    [Parameter] public EventCallback<bool> OnRangeExtensionRequested { get; set; }

    // Design spec Phase 3, T9 — re-entrancy guard: a second near-edge report
    // arriving while a PREVIOUS extension request is still awaiting GanttChart's
    // own async pipeline (live-center capture, drag-gesture re-check) is
    // dropped rather than queued or overlapped — the request is LEVEL-
    // triggered, not edge-triggered (VisibleTimelineWindow is re-evaluated
    // fresh on every report), so as long as the user is STILL near the edge
    // once this one resolves, the very next report re-requests it.
    private bool _rangeExtensionInFlight;

    // Design spec Phase 3, T9 — see ScrollToCenterAsync's own remarks. Armed
    // by EVERY programmatic recenter, consumed by the very next
    // OnGanttV3VerticalScroll report regardless of what that report's own
    // scrollLeft/clientWidth actually are — a recenter's own resulting
    // native 'scroll' event must never itself be misread as "the user wants
    // more range."
    private bool _suppressNextExtensionReport;

    // Bug fix (residual #390 double-scroll — reconciling the mount-scroll
    // dedup with infinite scroll's own suppression flag above): #390 closed
    // the race where a SECOND render, dispatched while firstRender's own
    // pass is still mid-flight in its several awaited interop round-trips,
    // independently re-derives "is a scroll still owed" from the (at that
    // point not-yet-claimed) _lastConsumedScrollRequestId and wrongly
    // concludes one is. It did NOT close a sibling race: firstRender's own
    // "initialIntentPending" decision is captured ONCE, in a local variable,
    // before any of those awaits, and is acted on UNCONDITIONALLY once they
    // all resolve — even if a DIFFERENT, faster-racing render already issued
    // the equivalent scroll in the meantime. That other render is real:
    // GanttChart's own firstRender OnAfterRenderAsync calls StateHasChanged()
    // BEFORE its own awaits specifically so GanttTimeline gets a "second
    // chance" once ScrollHost captures (see this component's own
    // OnAfterRenderAsync remarks) — that second, non-firstRender render
    // reaches its scrollHostChanged branch, which (correctly, by design —
    // see its own remarks) issues the centering scroll WITHOUT gating on
    // intentPending, since a host becoming ready is itself a re-scroll
    // trigger independent of the bookkeeping flag. Confirmed live (this
    // task's own E2E gate, with diagnostic logging + a stack trace on the
    // arming call): both passes call ScrollToCenterAsync for the SAME
    // request id, back to back, each re-arming _suppressNextExtensionReport
    // above — invisible on a fast local run (the redundant second call
    // resolves before any later, genuine report arrives), but under CI's
    // slower interop timing (lengthened further by this same PR's own added
    // SyncWheelZoomRegistrationAsync round-trip in the firstRender chain the
    // stuck pass is queued behind) the redundant call can still be
    // in-flight — flag armed — when a real, later scroll (e.g. this test
    // suite's own deliberate near-leading-edge scroll) arrives and gets
    // wrongly swallowed, with nothing left to retry it
    // (GanttV3InfiniteScrollTests' own "scrollWidth never grew ... within
    // the retry budget" failure).
    //
    // NOT a per-request-id "has this id ever been issued" latch — a first
    // attempt at that (this task's own local gate caught it) broke
    // GanttV3CodexRound2Tests/GanttV3CodexRound14Tests' own coverage of a
    // GENUINELY DIFFERENT, later trigger that legitimately reuses the SAME
    // ScrollToTodayRequestId value: Today changing after mount (a browser-
    // date re-resolution landing a render or two later, or midnight ticking
    // over) re-scrolls via the `Today != _lastSeenToday` disjunct below —
    // see that branch's own remarks — WITHOUT ever bumping
    // ScrollToTodayRequestId, since recentering on a changed Today is not
    // itself a new "intent" in that sense. A blanket "already issued for
    // this id" guard cannot tell that legitimate re-trigger apart from the
    // mount race above (same id, both cases) and silently ate it.
    //
    // Scoped instead to the ONE mount-time race described above, and ONLY
    // that race: a claim ticket armed by firstRender's own early decision
    // (only when it decided a scroll IS owed), naming the exact request id
    // it intends to apply. Both of the two call sites that could possibly
    // be racing for THAT SAME id — firstRender's own trailing action below,
    // and the non-firstRender branch's scrollHostChanged-triggered action —
    // clear it if it still matches their own id right before they act;
    // firstRender's OWN trailing action additionally treats a
    // no-longer-matching ticket as "someone else already handled this" and
    // skips. The non-firstRender branch never gates its OWN action on this
    // ticket — it keeps scrolling unconditionally exactly as it always has
    // (Today-changed/scrollHostChanged are independent, legitimate triggers
    // that must never be suppressed) — it only ever clears the ticket as a
    // side effect, so a STILL-mid-flight firstRender pass finds out its own
    // action is now redundant. Nulled out once consumed (by whichever side
    // gets there first) or when firstRender never armed one to begin with
    // (initialIntentPending false), so it can never stick around and
    // wrongly suppress an unrelated LATER id (request ids only ever
    // increase — see _lastConsumedScrollRequestId's own remarks — so a
    // stale ticket for an OLD id can never accidentally match a NEWER one
    // either).
    private int? _mountScrollClaim;

    private ElementReference _scrollHostRef;
    private ElementReference _headerInnerRef;
    // The last scroll-intent version actually CONSUMED (applied to the DOM).
    // ScrollToTodayRequestId differing from this means an intent is pending;
    // once applied they match and ScrollTargetDate expires (Codex round 14,
    // finding #3). Starts below any real request id so the first render's
    // intent (the initial center) counts as pending and is applied.
    private int _lastConsumedScrollRequestId = int.MinValue;
    private DateTime _lastSeenToday;

    // Bug fix (Codex round 7 review, P2 #2): this used to be a plain
    // `_scrollHostWasReady` bool, tracking only the ONE-WAY "not yet
    // captured -> captured" transition. That missed a genuinely different
    // trigger: a caller supplying a LATER or REPLACED host — a standalone
    // timeline whose ScrollHost arrives after mount, or a parent that swaps
    // in a different host element outright — never re-registers, because the
    // bool had already flipped true once and can never flip again. Tracking
    // the host's own captured Id (not just a readiness bool) lets a genuine
    // identity change be detected on ANY render, not just the first
    // not-ready-to-ready one. Null means "not currently registered against
    // any host" (either not yet ready, or nothing registered yet).
    private string? _lastSeenScrollHostId;
    private ElementReference? _registeredScrollHostRef;
    private bool _headerScrollSyncRegistered;

    // Codex round 4, P2 #3 — see GanttV3RegisterVerticalScrollTrackingAsync's
    // own remarks. Null until the first scroll report arrives (registration
    // is async; a JS round-trip separates mount from the first callback) —
    // GanttArrowLayer treats null as "show every arrow, unculled" so there's
    // no flash-of-no-arrows in that brief window.
    private (int Start, int End)? _visibleRowRange;
    private bool _verticalScrollTrackingRegistered;
    // Phase 2, T1 — also the JS drag engine's own callback target (see
    // SyncDragRegistrationAsync below): one shared reference for every
    // JSInvokable this component exposes (drag commits AND vertical-scroll
    // reporting), created lazily by whichever registration path runs first.
    private DotNetObjectReference<GanttTimeline>? _selfRef;

    // Codex round 17 review, P2 — see RegisterVerticalScrollTrackingAsync's
    // own remarks. Same "track disposed state, recheck after the register
    // call's own await" pattern GanttBar.razor already uses for its
    // identical key-handler-registration-vs-dispose race.
    private bool _disposed;

    // Codex round 6, P1 #2 — the last scrollTop/clientHeight actually reported
    // (by JS, OR re-derived here) and the row count the culling window was
    // last computed against. Cached so a rows-count change (empty->populated,
    // collapse/expand) can re-run the EXACT SAME clamping synchronously in
    // C#, without waiting for a native 'scroll' event that may never come —
    // see RecomputeVisibleRowRange's own remarks.
    private double? _lastReportedScrollTop;
    private double? _lastReportedClientHeight;
    private int _lastCulledRowCount = -1;

    // Design spec Phase 3, T7 — off-screen indicators. Extends the SAME
    // report payload above (not a new/fourth registration channel — "extend
    // the existing interop family" is the identical precedent T2's
    // NowIndicator already established for GanttV3GetLocalDateAsync; see
    // OnGanttV3VerticalScroll's own remarks for the full reasoning) with the
    // shared scroll pane's LOGICAL scrollLeft (gantt-v3.js's own
    // fromNativeScrollLeft — already RTL-normalized into the same
    // never-mirrored coordinate space GanttScale.DateToPixel/GanttBar.X live
    // in, so no further conversion is needed here) and clientWidth. Null
    // until the first report arrives — VisibleTimelineWindow treats that as
    // "unknown viewport", so no chip renders (never a WRONG chip) rather
    // than guessing during the brief JS-round-trip gap after mount.
    private double? _lastReportedScrollLeft;
    private double? _lastReportedClientWidth;

    // Phase 2, T1 — drag-registration bookkeeping (see SyncDragRegistrationAsync).
    // Phase 3, T1 — GanttInteropOptions (a record) replaced a plain int hash;
    // see SyncDragRegistrationAsync's own remarks and GanttInteropOptions'.
    private bool _dragRegistered;
    private GanttInteropOptions _lastDragOptions;

    // Bug fix (Codex P2 finding "Keep pointer clicks when drag interop is
    // unavailable") — see SyncDragRegistrationAsync's own remarks and
    // GanttBar.SuppressPointerClick's. Deliberately a SEPARATE flag from
    // _dragRegistered: that one flips true SYNCHRONOUSLY, before the register
    // interop call even starts (needed for the disposal-race fix — see its
    // own remarks), so it means "registration was ATTEMPTED," never
    // "confirmed." This one flips true only once the register call has
    // actually RETURNED without throwing.
    private bool _dragConfirmed;

    // E2E deflake (GanttDragParityTests.Drag_create_after_panning_computes_dates_from_the_new_origin,
    // investigated alongside #390): a pan (RangeStart/Origin change) re-renders,
    // and SyncDragRegistrationAsync detects the resulting GanttInteropOptions
    // change on its NEXT call and re-pushes originIso to gantt-v3.js's
    // dragRegistrations map — but that re-push is its own genuine interop
    // round-trip, with no PRIOR DOM-observable "done" signal for a test to
    // wait on (unlike data-gantt-v3-initial-scroll for the initial centering
    // scroll). The E2E spec used to paper over this with a blind
    // Page.WaitForTimeoutAsync(500) — insufficient under load, per its own
    // "flagged... as a candidate for a proper DOM-observable signal" remark.
    // Recorded here, in ISO date form, ONLY once GanttV3RegisterDragAsync's
    // own await has actually RETURNED (i.e. gantt-v3.js's dragRegistrations
    // entry is confirmed updated — registerDrag mutates `options` in place
    // synchronously within that same call, so a resolved await is definitive
    // proof, not a guess) — see SyncDragRegistrationAsync's own remarks for
    // exactly where. Rendered as data-gantt-v3-drag-origin on _scrollHostRef's
    // own root div so a test can wait for it to reflect the NEW origin
    // instead of sleeping a fixed, load-sensitive duration.
    private string? _lastConfirmedDragOriginIso;

    // Design spec Phase 3, T8 — bar context-menu bookkeeping (see
    // SyncBarContextMenuRegistrationAsync/NotifyBarContextMenu). Deliberately
    // its OWN registration flag, not folded into _dragRegistered — this
    // channel's registration is independent of Readonly (see BarContextMenu's
    // own remarks), so it cannot share _dragRegistered's Readonly-gated
    // lifecycle.
    private bool _barContextMenuRegistered;
    private bool _barContextMenuOpen;
    private GanttTask? _barContextMenuTask;
    private double _barContextMenuX;
    private double _barContextMenuY;

    // Built fresh each render from the four fields above — ContextMenuContent
    // (the reusable building block this renders into) only ever READS this
    // record's fields; SetPosition is wired for interface symmetry with
    // ContextMenu.razor's own context (ContextMenuContent never actually
    // calls it — only ContextMenuTrigger does, and this component uses no
    // ContextMenuTrigger — see BarContextMenu's markup remarks), SetOpen is
    // the real close path (Escape / click-outside).
    private ContextMenu.ContextMenuContext _barContextMenuContext =>
        new(_barContextMenuOpen, _barContextMenuX, _barContextMenuY,
            EventCallback.Factory.Create<bool>(this, SetBarContextMenuOpen),
            EventCallback.Factory.Create<(double, double)>(this, SetBarContextMenuPosition));

    private Task SetBarContextMenuOpen(bool open)
    {
        _barContextMenuOpen = open;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task SetBarContextMenuPosition((double X, double Y) pos)
    {
        _barContextMenuX = pos.X;
        _barContextMenuY = pos.Y;
        return Task.CompletedTask;
    }

    // Codex round 2, P1 #3: this root no longer establishes any scroll
    // container itself at all — the header (sticky) and the row-canvas
    // (overflow-x-auto) are now separate children with their own concerns;
    // see the header's own markup remarks for the CSS-spec detail behind why
    // that split was necessary (an intervening `overflow-x:auto` ancestor,
    // even a never-actually-scrolling one, hijacks `position: sticky`).
    // Bug fix (Codex round 5, P1 #4 root cause): "w-full" (width:100%) here,
    // combined with the shared `.flex` row's own `width:max-content` shrink-
    // to-fit sizing (GanttChart's markup) and this item's `min-width:TotalWidth`
    // (RootStyle) + the caller's `grow` class, resolves this box's rendered
    // width to TotalWidth + GanttScale.TreePaneWidth instead of exactly
    // TotalWidth (confirmed via a live diagnostic: this root measured 224px
    // WIDER than its own `_headerInnerRef`/canvas-relative children, which
    // stay correctly sized at TotalWidth) — a percentage-width flex item
    // inside a shrink-to-fit container is a known circular-sizing case
    // browsers resolve inconsistently. That extra 224px inflates
    // `el.scrollWidth`, which corrupts `maxScroll` (`scrollWidth-clientWidth`)
    // in gantt-v3.js's RTL scrollLeft conversion (`toNativeScrollLeft`/
    // `fromNativeScrollLeft`) specifically — LTR's conversion is a no-op that
    // never reads `maxScroll` at all, which is why this defect was invisible
    // under LTR (scroll-to-today centering happened to still land correctly
    // there) but threw RTL's centering off by exactly TreePaneWidth. "w-full"
    // is now dropped in GanttChart's shared-pane mode (ScrollHost supplied) —
    // width is already fully governed there by RootStyle's min-width plus
    // the caller's own "grow" class, so it was redundant AND the actual
    // source of the bug. Standalone mode (ScrollHost null) is unaffected —
    // it never had a sibling Tree/shared-width scenario to trigger this.
    private string RootClass => Cx.Merge(ScrollHost is null ? "w-full" : null, Class);

    // Bug fix (Codex round 3, cx3 review): when a caller supplies ScrollHost
    // (GanttChart's shared-pane mode), this root needs a REAL min-width equal to
    // the rendered content's TotalWidth — not just visually-overflowing
    // descendants — so the surrounding flex row's own layout box genuinely
    // spans the scrollable content width. GanttTree's sticky-left positioning
    // is bounded within ITS containing block (that flex row), not the outer
    // scroll container's full scrollWidth — a flex item that's merely allowed
    // to shrink (min-w-0/flex-1) with only visually-overflowing content stays
    // viewport-narrow in the LAYOUT sense even though bars visually spill
    // thousands of pixels wider, leaving sticky nothing to stick within past
    // that narrow extent (reproduced live: GanttTree's bbox at x=-458 after
    // scrolling to scrollLeft=1497 — the "1:1 with GanttTree.RootClass" fix
    // note this replaces described the INTENDED behavior, not what actually
    // rendered). min-width (not width) so a range that fits within the
    // available flex space still grows to fill it via GanttChart's "grow" class
    // instead of leaving a gap. Standalone mode (ScrollHost null) is
    // unaffected — it establishes its own inner horizontal scroll instead, so
    // this root never needed to be content-width itself.
    private string? RootStyle => ScrollHost is not null
        ? FormattableString.Invariant($"min-width:{TotalWidth}px;")
        : null;

    // Codex round 3, P2 #1 — see ScrollHost's own remarks. Only self-scrolls
    // (overflow-x-auto) in standalone mode; when a caller supplies ScrollHost,
    // horizontal scrolling lives entirely at THEIR level instead, so this div
    // stays a plain, non-scrolling block (no overflow set at all — not even
    // hidden/clip, which would still block Virtualize's ancestor walk from
    // reaching past it in the same way auto/scroll does).
    private string CanvasScrollClass => Cx.Merge("lumeo-gantt-v3-canvas-scroll w-full", ScrollHost is null ? "overflow-x-auto" : null);

    // The element every scroll interop call targets — GanttChart's outer pane when
    // supplied, else this component's own row-canvas div (unchanged prior
    // behavior for standalone usage).
    private ElementReference EffectiveScrollHost => ScrollHost ?? _scrollHostRef;

    private GanttScaleConfig Cfg => GanttScale.GetConfig(ViewMode);

    // Bug fix (Codex round 17 review, P2): v2 resolves both overrides via a
    // plain JS truthy check (gantt-v2.js: `inst.columnWidth ? ... : ...` /
    // `inst.barHeight || DEFAULT_BAR_HEIGHT`) — 0 (or a negative value) is
    // FALSY, so v2 silently treats it the same as "unset" and falls back to
    // the default. `??` only checks for null, so a caller passing an explicit
    // 0 here (whether deliberately or via some computed value that happens to
    // resolve to it) got a genuinely broken chart in v3 (zero-width columns,
    // zero-height bars) instead of the graceful default v2 falls back to —
    // `> 0` on a nullable int is false for both null and non-positive values,
    // matching v2's own truthy check exactly.
    private int EffectiveColumnWidth => ColumnWidth > 0 ? ColumnWidth!.Value : Cfg.ColumnWidth;
    private int EffectiveBarHeight => BarHeight > 0 ? BarHeight!.Value : GanttScale.DefaultBarHeight;

    private IReadOnlyList<DateTime> Units => GanttScale.BuildDateUnits(ViewMode, RangeStart, RangeEnd);
    private DateTime Origin => Units.Count > 0 ? Units[0] : RangeStart;
    private double TotalWidth => Units.Count * (double)EffectiveColumnWidth;

    // Falls back to a 1:1 Task-per-row list (T2's original contract) when the
    // caller doesn't supply a pre-flattened Rows list — see the Rows parameter's
    // remarks. Every entry is a GanttRowKind.Task row at depth 0 with no
    // collapse/toggle affordance, matching what T2 always rendered.
    private IReadOnlyList<GanttVisibleRow> EffectiveRows => Rows ?? BuildFallbackRows();

    private List<GanttVisibleRow> BuildFallbackRows()
    {
        // Bug fix (Codex round 18 review, P2): route through the SAME duration
        // filter the shared row model applies (GanttRowModel.BuildVisibleRows),
        // so a standalone timeline (Rows==null) drops an invalid End<Start,
        // non-milestone task exactly as the GanttChart-fed path already does.
        // Previously this copied EVERY task 1:1, so a standalone caller rendered
        // the 8px-sliver bar (BarGeometry's Math.Max(8,...) clamp) that filter
        // exists to suppress — the only GanttV3 entry point still bypassing it.
        var valid = GanttRowModel.FilterValidDurationTasks(Tasks);
        var rows = new List<GanttVisibleRow>(valid.Count);
        foreach (var task in valid)
            rows.Add(new GanttVisibleRow(GanttRowKind.Task, task, task.Name, 0, false, null, false));
        return rows;
    }

    // Codex round 2, P1 #3: no longer includes GanttScale.HeaderHeight — the
    // header lives OUTSIDE this canvas subtree entirely now (see the markup's
    // own remarks), so row 0 starts at y=0 in this coordinate space instead
    // of y=HeaderHeight. GanttArrowRouting.SourceEdge/TargetEdge dropped the
    // matching "+HeaderHeight" term for the same reason.
    private double CanvasHeight => Math.Max(1, EffectiveRows.Count) * GanttScale.RowHeight;

    // Design spec Phase 3, T2 — see GanttScale.UpperRuns' own firstDayOfWeek
    // remarks; ignored by every HeaderUpper kind except Week (GanttViewMode.Day).
    private IReadOnlyList<GanttHeaderRun> UpperRuns => GanttScale.UpperRuns(ViewMode, Units, EffectiveFirstDayOfWeek);
    private IReadOnlyList<string> LowerLabels => GanttScale.LowerLabels(ViewMode, Units);

    private DayOfWeek EffectiveFirstDayOfWeek => FirstDayOfWeek ?? CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;
    private IReadOnlySet<DayOfWeek> EffectiveOffDays => OffDays ?? GanttScale.DefaultOffDays(CultureInfo.CurrentCulture);
    // Bug fix (Codex review of the styling-hooks PR, P2): the fallback used to
    // be a bare DateTime.Now, i.e. the SERVER clock on a Blazor Server circuit.
    // That is invisible in the normal composition — GanttChart resolves the
    // browser clock and passes Now down — but this component is public and
    // usable on its own, and a standalone timeline therefore handed every bar a
    // server-clock data-past while the hook's own documentation promises
    // browser time. _selfResolvedNow closes exactly that gap: it is populated
    // ONLY when no Now was supplied (see ResolveOwnBrowserNowAsync), so the
    // hosted path costs no extra interop and a controlled Now still wins
    // outright.
    private DateTime EffectiveNow => Now ?? _selfResolvedNow ?? DateTime.Now;

    private DateTime? _selfResolvedNow;

    /// <summary>
    /// Resolves the BROWSER's current time for a standalone timeline (one with
    /// no <see cref="Now"/> supplied and therefore no host feeding it one).
    /// No-ops entirely when <see cref="Now"/> is set, so the GanttChart-hosted
    /// path — which already resolves this once and passes it down — never pays
    /// a second round trip.
    /// </summary>
    private async Task ResolveOwnBrowserNowAsync()
    {
        // Bug fix (CI, caught on this PR): the guard used to be
        // "_selfResolvedNow is not null", which only trips on a SUCCESSFUL
        // resolve. Whenever the interop legitimately yields nothing —
        // prerendering, a torn-down circuit, a custom IComponentInteropService
        // whose default no-op returns null — the field stayed null, so this ran
        // again on EVERY subsequent render: an unbounded per-render interop
        // call whose awaits kept dispatching further render/registration
        // cycles. It surfaced as an extra prevent-default registration in
        // GanttV3KeyboardNavigationTests, which passed locally and failed in
        // CI — a timing-dependent symptom of an unconditional call, not a
        // flaky test.
        //
        // Tracking the ATTEMPT rather than the outcome is what bounds it, and
        // the flag is claimed BEFORE the await, not after: on a Server circuit
        // a second render dispatches while the first is still awaiting interop,
        // reads a flag set only afterwards, and proceeds too (the guard-before-
        // await rule this component has been bitten by twice already).
        // A controlled Now takes over: drop the self-resolved value AND the
        // attempt flag, so returning to uncontrolled mode re-queries instead of
        // restoring a clock cached before the handover (Codex review of this
        // PR, P2 — a timeline left mounted for days would otherwise resurrect a
        // days-old "now" for data-past and the now indicator).
        if (Now is not null)
        {
            _selfResolvedNow = null;
            _browserNowResolveAttempted = false;
            return;
        }
        if (_browserNowResolveAttempted) return;
        _browserNowResolveAttempted = true;

        string? iso;
        try
        {
            iso = await Interop.GanttV3GetLocalDateTimeAsync();
        }
        catch (Exception)
        {
            return; // prerendering / torn-down circuit — EffectiveNow keeps its documented fallback
        }
        if (_disposed || iso is null) return;
        if (!DateTime.TryParseExact(iso, "yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out var browserNow)) return;
        _selfResolvedNow = browserNow;
        StateHasChanged();
    }

    private bool _browserNowResolveAttempted;

    // Styling-hooks audit — SelectedIds' own default value. A `static readonly`
    // field (not a `new HashSet<string>()` inline default expression) so every
    // unselected chart shares the ONE empty instance rather than allocating a
    // fresh empty set per component instance — mirrors GanttTree's own
    // identical EmptySelectedIds precedent (that field is private to GanttTree,
    // so this is a deliberate, small duplication rather than a cross-component
    // reference).
    private static readonly IReadOnlySet<string> EmptySelectedIds = new HashSet<string>();

    // Bug fix (Codex review wave): must pass EffectiveColumnWidth explicitly —
    // DateToPixel defaults to the mode's own config width when no override is
    // given, which silently ignored a caller's ColumnWidth override here (the
    // header/grid, which compute column positions via EffectiveColumnWidth
    // directly rather than through DateToPixel, were already correct).
    private double TodayX => GanttScale.DateToPixel(ViewMode, Origin, Today, EffectiveColumnWidth);
    private bool TodayInRange => TodayHighlight && Units.Count > 0 && TodayX >= 0 && TodayX <= TotalWidth;

    // Design spec Phase 3, T2 — Today column upgrade. DateToPixel's output is a
    // continuous "column-space" coordinate for EVERY unit (Day/Week/Month/
    // Year/Quarter alike: each formula is `(wholeUnits + fractionWithinUnit) *
    // colW` — see GanttScale.DateToPixel's own per-unit remarks), so flooring
    // TodayX to the nearest whole EffectiveColumnWidth multiple gives the LEFT
    // EDGE of the column containing Today, mode-agnostically — no per-mode
    // switch needed here. For Day/QuarterDay/HalfDay (this codebase's only
    // "1 column = 1 day-or-finer" modes), Today's own DateToPixel value is
    // ALREADY exactly on a column boundary (its date/hour is truncated to the
    // unit before the pixel math runs), so this floor is a no-op there and
    // TodayColumnLeft == TodayX exactly — the E2E parity spec this feeds
    // still reads the identical pixel value the old line-only marker did.
    private double TodayColumnLeft => Math.Floor(TodayX / EffectiveColumnWidth) * EffectiveColumnWidth;
    private int? TodayColumnIndex => TodayInRange ? (int)Math.Floor(TodayX / EffectiveColumnWidth) : null;
    private bool IsTodayColumn(int index) => TodayColumnIndex == index;

    // G7 (2026-08-10 shadcn alignment): the off-day column tint (below) used to
    // start BELOW the sticky header — the header's own cells had no off-day
    // branch at all, so a weekend's date label stayed full-strength and the
    // muted band visibly broke at the header/canvas seam instead of reading as
    // ONE continuous band (the demo tints both: `.g-subcell.we` gets a
    // muted/.5 bg + muted-foreground/.7 label). Same MarkOffDays &&
    // SupportsOffDayMarking gate as the canvas tint below — a header cell for
    // a mode that doesn't support off-day marking never evaluates
    // IsOffDayColumn at all, matching the canvas branch's own short-circuit.
    // Today wins the TEXT colour when a column is both today and an off day
    // (a Saturday "today" should still read as accented, not muted) — the
    // background tint still applies underneath either way, exactly like the
    // canvas's own independently-layered today-tint/off-day-tint divs.
    private string ColumnCellClass(int index)
    {
        var isOffDay = IsOffDayCell(index);
        var textColor = IsTodayColumn(index)
            ? "font-bold text-primary"
            : isOffDay ? "text-muted-foreground/70" : "text-muted-foreground";
        return Cx.Merge("shrink-0 text-center text-xs", textColor, isOffDay ? "bg-muted/50" : null);
    }

    // Styling-hooks audit (ReUI parity: data-off) — extracted so the header
    // cell's CSS class AND its data-off attribute (markup above) read the
    // EXACT same gate as this method's own prior inline calculation; a
    // second, independently-typed copy of "MarkOffDays && SupportsOffDayMarking
    // && IsOffDayColumn(index)" could silently drift from the class.
    private bool IsOffDayCell(int index) => MarkOffDays && SupportsOffDayMarking && IsOffDayColumn(index);

    // Design spec Phase 3, T2 — "Mark off days". Column tinting only makes
    // visual sense when a single rendered column IS a single calendar day (or
    // finer) — Week/Month/Quarter/Year's own columns each already span many
    // days, so "this whole [week/month/quarter/year] column is a weekend"
    // would be a category error, not a useful highlight. Day mode (Unit=Day,
    // Step=1) and the two Hour-unit modes (QuarterDay/HalfDay, several columns
    // PER day) both qualify; Week (Unit=Day, Step=7 — one column per WEEK) is
    // deliberately excluded despite sharing Day's own GanttScaleUnit.
    //
    // G8 (2026-08-10 shadcn alignment): the identical "column IS a single day"
    // test also gates the today marker's full-column tint (see the markup's
    // own remarks) — extracted so off-day marking and today-marker precision
    // can never silently diverge on what counts as day granularity.
    // SupportsOffDayMarking is kept as its own name (the off-day feature's own
    // established public-facing vocabulary in this file's comments/tests)
    // aliasing the shared test, rather than renaming call sites wholesale.
    private bool IsDayGranularityMode => Cfg.Unit == GanttScaleUnit.Hour || (Cfg.Unit == GanttScaleUnit.Day && Cfg.Step == 1);
    private bool SupportsOffDayMarking => IsDayGranularityMode;
    private bool IsOffDayColumn(int index) => EffectiveOffDays.Contains(Units[index].DayOfWeek);

    // Design spec Phase 3, T2 — "Now indicator ... in sub-day modes". Only the
    // two Hour-unit modes render multiple columns within a single day, the
    // only granularity where "the exact current minute" is a meaningfully
    // distinct position from "today's column" above.
    private bool SupportsNowIndicator => Cfg.Unit == GanttScaleUnit.Hour;
    private double NowX => GanttScale.DateToPixel(ViewMode, Origin, EffectiveNow, EffectiveColumnWidth);
    private bool NowInRange => NowIndicator && SupportsNowIndicator && Units.Count > 0 && NowX >= 0 && NowX <= TotalWidth;

    // Codex round 4, P2 #8: the pixel the scroll-to-center mechanism targets —
    // ScrollTargetDate when the caller (GanttChart, after a recenter) supplies one,
    // else Today. Deliberately SEPARATE from TodayX — the marker must always
    // reflect where TODAY is, regardless of what the viewport is being scrolled
    // toward.
    //
    // Codex round 14, finding #3: the explicit ScrollTargetDate is honored ONLY
    // while its scroll intent is still pending (its ScrollToTodayRequestId bump
    // hasn't been applied yet) — an AMBIENT re-scroll (a browser-"today" change
    // at midnight, a host swap) passes intentPending=false and so targets Today,
    // letting a consumed preserved-center intent expire instead of re-applying
    // it forever. A standalone timeline leaves ScrollTargetDate null, so this is
    // always Today there, unchanged.
    // Design spec Phase 3, T9 — ScrollTargetXOverride's own priority: only
    // while intentPending (the SAME "is this intent still live" gate
    // ScrollTargetDate already respects, immediately above), and ONLY takes
    // over the resolution entirely — never blended with the date-derived
    // value — see ScrollTargetXOverride's own remarks for why a leading-edge
    // extension needs pixel-exact precision the date path cannot provide.
    private double ResolveScrollTargetX(bool intentPending) =>
        intentPending && ScrollTargetXOverride is { } pixelOverride
            ? pixelOverride
            : GanttScale.DateToPixel(ViewMode, Origin, (intentPending ? ScrollTargetDate : null) ?? Today, EffectiveColumnWidth);

    // Companion to ResolveScrollTargetX — see ScrollTargetOffsetOverride's own
    // remarks. Null (every existing caller) preserves centerOn's usual
    // viewport-center placement unchanged; only while the SAME intent is
    // still pending does a caller-supplied offset take over, mirroring
    // ScrollTargetXOverride's own "only while intentPending" gate exactly.
    private double? ResolveScrollTargetOffset(bool intentPending) =>
        intentPending ? ScrollTargetOffsetOverride : null;

    // v2 parity (Codex round 2, P2 #8): v2's scroll-to-today gate is
    // `todayPx > 0` (gantt-v2.js:684) — deliberately LOOSER than the
    // today-LINE marker's own render gate (`todayInRange`, upper+lower
    // bounded, gantt-v2.js:329, mirrored by TodayInRange above). v2 still
    // attempts `scrollLeft = todayPx - w/2` even when today is PAST the
    // rendered window's end, relying on the BROWSER's own scrollLeft clamp
    // (assigning past the max valid value clamps to the far edge) to land at
    // the latest-visible dates instead of leaving scrollLeft at its DOM
    // default 0 (the EARLIEST dates — visibly wrong, and the mechanism behind
    // the visual-snapshot-drift finding: a fixed-date fixture whose "today"
    // has since moved past its rendered window silently flipped from
    // "scrolled toward today" to "stuck at the far left" the moment
    // TodayInRange went false, with no equivalent recovery on the OTHER side
    // of that flip). TodayInRange itself stays the MARKER's own gate,
    // unchanged — only the scroll-ATTEMPT condition needed loosening.
    //
    // Bug fix (Codex round 3, P2 #3): this used to ALSO require TodayHighlight,
    // conflating "should the marker line render" with "should the viewport
    // center on today" — a consumer setting TodayHighlight="false" (wanting no
    // visual line, nothing more) got the EXACT SAME "empty grid on first
    // paint" regression the P1 fix above exists to prevent, just gated by a
    // different flag. v2 parity: gantt-v2.js's scroll block (lines 673-693,
    // tryScroll) runs unconditionally — only the marker draw a few lines
    // later is gated by inst.todayHighlight !== false. TodayHighlight now
    // controls ONLY TodayInRange (the marker); the scroll-attempt is
    // unconditional on it.
    //
    // Codex round 4, P2 #8: gates on ScrollTargetX now (was TodayX) so this
    // generalizes correctly to a non-Today scroll target — reduces to the
    // exact prior behavior when ScrollTargetDate is null (ScrollTargetX ==
    // TodayX in that case). A view-mode-switch's centerDate is, by
    // construction, always the exact midpoint of the freshly-computed range
    // (see GanttChart.HandleViewModeChangedAsync), so this gate is trivially
    // satisfied for that caller — the loosened v2-parity semantics above
    // only actually matter for the Today-targeting case, unchanged.
    //
    // Bug fix (Codex round 5, P2 #9): this used to ALSO require
    // "ScrollTargetX > 0" (matching v2's identical `todayPx > 0` gate,
    // gantt-v2.js:684), skipping the scroll ATTEMPT entirely whenever the
    // target fell before the very first rendered column — relying on the
    // DOM's own untouched default scrollLeft to already show "the earliest
    // edge" instead of an explicit clamp. That default only happens to BE
    // the earliest edge under LTR (native scrollLeft's own default, 0, is
    // the physical-left origin there); under RTL's 'negative' convention
    // (gantt-v3.js's own remarks), native scrollLeft 0 is the RTL START —
    // the PHYSICAL RIGHT edge, i.e. wherever GanttTree ends up pinned (see
    // ScrollHostLeadingOffset's remarks on GanttChart) — so skipping the attempt
    // under RTL left the timeline scrolled entirely out of view instead,
    // showing only the tree pane. centerOn's own `Math.max(0, targetX - w/2)`
    // clamp (applied AFTER toNativeScrollLeft's direction-correct mapping)
    // already lands correctly at the earliest edge in BOTH directions when
    // actually invoked — so the fix is simply to always attempt the scroll
    // whenever there is a rendered range to scroll within, and let that
    // clamp do the direction-aware work instead of skipping the call
    // entirely and hoping the DOM's own default happens to agree.
    private bool ShouldAttemptTodayScroll => Units.Count > 0;

    private string CanvasStyle => FormattableString.Invariant($"width:{TotalWidth}px;min-height:{CanvasHeight}px;");
    private string HeaderOuterStyle => FormattableString.Invariant($"height:{GanttScale.HeaderHeight}px;");
    private string HeaderInnerStyle => FormattableString.Invariant($"width:{TotalWidth}px;");
    private string ColumnCellStyle => FormattableString.Invariant($"width:{EffectiveColumnWidth}px;");

    private string UpperRunStyle(GanttHeaderRun run) =>
        FormattableString.Invariant($"left:{run.StartIndex * EffectiveColumnWidth}px;top:2px;padding-inline-start:8px;");

    // Codex round 2, P1 #3: top:0 (was top:HeaderHeight) — see CanvasHeight's
    // own remarks for why the header no longer occupies space in this
    // coordinate system at all.
    private string GridLinesContainerStyle => "top:0;bottom:0;";

    private string GridLineStyle(int columnIndex) =>
        FormattableString.Invariant($"left:{columnIndex * EffectiveColumnWidth}px;");

    // Design spec Phase 3, T2 — off-day column tint. Same left/width shape as
    // OffDayColumnStyle's caller passes columnIndex directly (Units[i]'s own
    // index), so no separate pixel-to-column lookup is needed the way
    // TodayColumnStyle below needs one (Today is an arbitrary DateTime, not
    // already an index into Units).
    private string OffDayColumnStyle(int index) =>
        FormattableString.Invariant($"left:{index * EffectiveColumnWidth}px;width:{EffectiveColumnWidth}px;");

    // Design spec Phase 3, T2 — replaces the old line-only TodayLineStyle.
    // TodayColumnLeft (see its own remarks) is already the containing
    // column's left edge, mode-agnostically.
    private string TodayColumnStyle =>
        FormattableString.Invariant($"left:{TodayColumnLeft}px;width:{EffectiveColumnWidth}px;");

    // G8 (2026-08-10 shadcn alignment) — coarse-mode (non-day-granularity)
    // fallback for the today marker: TodayX (Today's own exact, unfloored
    // pixel — NOT TodayColumnLeft, which floors to the whole containing
    // column's edge) at the SAME "-4px decorative overhang above row 0's own
    // top" shape NowLineStyle already uses, so the two precise-line markers
    // (today/now) read as one visual family. Only ever rendered when
    // !IsDayGranularityMode (see the markup's own remarks) — a day-granularity
    // chart keeps the wide TodayColumnStyle tint unchanged.
    private string TodayLineStyle =>
        FormattableString.Invariant($"left:{TodayX}px;top:-4px;");

    // Header dot, centered horizontally over the today column, vertically
    // centered within the 20px-tall upper header row (see the markup's own
    // placement remarks) — 3px = half of the dot's own h-1.5/w-1.5 (6px) size.
    private string TodayDotStyle =>
        FormattableString.Invariant($"left:{TodayColumnLeft + EffectiveColumnWidth / 2.0 - 3}px;top:7px;");

    // Design spec Phase 3, T2 — Now indicator. Same "-4px decorative overhang
    // above row 0's own top" shape the old TodayLineStyle used (Codex round 2,
    // P1 #3's own header-height removal note) — NowIndicator is a thin,
    // PRECISE line (unlike Today's now-wide column tint), so it keeps that
    // line-marker shape.
    private string NowLineStyle =>
        FormattableString.Invariant($"left:{NowX}px;top:-4px;");

    // Positions a GanttRowKind.GroupHeader slot's full-width stripe (Codex round
    // 2, P2 #7) — mirrors GanttBar's own RowIndex*RowHeight top math (see its
    // WrapperStyle) but spans the full row width (inset-x-0) rather than a
    // date-bounded bar.
    private string GroupHeaderStyle(int rowIndex) =>
        FormattableString.Invariant($"top:{rowIndex * GanttScale.RowHeight}px;height:{GanttScale.RowHeight}px;");

    // touch-pan-y only when this stripe is actually a drag target (Codex P2
    // finding "Opt touch drag targets out of native horizontal panning") —
    // see the markup's own remarks for why this mirrors the
    // data-gantt-row-track/data-row-key pair's identical gate.
    private string GroupHeaderClass => Cx.Merge(
        "lumeo-gantt-v3-group-header absolute inset-x-0 flex items-center bg-accent/[0.18] px-2 text-[11px] font-bold uppercase tracking-wide text-muted-foreground",
        AllowCreate && !Readonly ? "touch-pan-y" : null);

    private string RowsContainerStyle =>
        FormattableString.Invariant($"height:{Math.Max(1, EffectiveRows.Count) * GanttScale.RowHeight}px;width:{TotalWidth}px;");

    // One row slot's already-resolved geometry, computed fresh from GanttScale
    // each render — see GanttScale.BarGeometry for the underlying math (a 1:1
    // port of gantt-v2.js's dateToX usage: render() lines 508-512 for a regular
    // bar, lines 459-463 for a milestone's diamond center). Task is null for a
    // GanttRowKind.GroupHeader slot — Virtualize still allocates it a slot (so
    // RowIndex stays list-position-aligned for every OTHER row, which its
    // internal viewport math depends on), but no <GanttBar> renders for it
    // (see the @if (row.Task is not null) guard in the markup above).
    //
    // GroupRowKey (Codex P2 finding, "Make group-header tracks hittable"):
    // only ever set for a GroupHeader slot (Task is null) — the SAME RowKey a
    // Task row's own inline track div (see the markup's Task branch) computes
    // for itself, threaded here instead so the markup's group-header stripe
    // can carry the data-gantt-row-track/data-row-key pair ITSELF. Without
    // this, a pointer on that stripe hit-tests the stripe,
    // e.target.closest('[data-gantt-row-track]') finds nothing, and
    // gantt-v3.js's drag-create path can never start for a grouped row. A
    // GroupHeader row's Task is always null, so it never reaches the Task
    // branch's own track div at all — this stripe is the row's ONLY carrier
    // of the pair, never a second one layered over a sibling div.
    /// <summary>
    /// Design spec Phase 3, T7 — which edge (if any) a row's bar is entirely
    /// beyond the current horizontal viewport (see <see cref="ResolveOffscreenDirection"/>).
    /// Internal — this never crosses a public parameter boundary (unlike
    /// <see cref="GanttRowKind"/>/<see cref="GanttVisibleRow"/>, which are
    /// forced public by CS0053 because <c>GanttTree</c>/<c>GanttTimeline</c>'s
    /// <c>Rows</c> parameters expose them — <see cref="GanttTimelineRow"/>,
    /// which carries this, is itself already internal, so no such forcing
    /// applies here).
    /// </summary>
    internal enum GanttOffscreenDirection
    {
        /// <summary>The bar is at least partly visible (or the current viewport isn't known yet).</summary>
        None,

        /// <summary>The bar is entirely EARLIER than the visible window — the chip points toward the start.</summary>
        Before,

        /// <summary>The bar is entirely LATER than the visible window — the chip points toward the end.</summary>
        After,
    }

    internal sealed record GanttTimelineRow(
        GanttTask? Task, double X, double Width, int RowIndex, string? Color, string? Label,
        string? GroupRowKey = null, GanttRollup? Rollup = null, double SummaryX = 0, double SummaryWidth = 0,
        GanttOffscreenDirection Offscreen = GanttOffscreenDirection.None,
        // Whether this row is a hierarchy PARENT, copied straight from the
        // authoritative GanttVisibleRow.HasChildren (Codex review of the
        // styling-hooks PR, P2). An earlier attempt reconstructed this from the
        // Tasks parameter — wrong, because `Rows` takes priority over `Tasks`
        // when a caller supplies it, and `Tasks` is then legitimately empty or
        // stale. Only consumer today is the data-selected gate.
        bool IsParent = false);

    // Virtualize<TItem>.Items requires ICollection<TItem> (IReadOnlyList doesn't
    // implement it) — List<T> both satisfies that and matches the pattern
    // DataGridBody uses for its own Virtualize Items source (_indexedItems).
    private List<GanttTimelineRow> RowItems
    {
        get
        {
            var visibleRows = EffectiveRows;
            var rollups = Rollups; // one dictionary build for the whole row list (see Rollups' own remarks)
            // Design spec Phase 3, T7 — ColorByGroup. Computed ONCE for the
            // whole render (matches Rollups' own "one dictionary build, not
            // per row" discipline immediately above): GanttReorderModel.
            // BucketKey's tasks-taking overload internally re-runs
            // GanttRowModel.UsesHierarchy's own O(n) scan on EVERY call, so
            // calling THAT overload once per row here would turn an O(n)
            // render pass into O(n^2) for no reason — see BucketKey(bool,
            // GanttTask)'s own remarks for why the precomputed-bool overload
            // exists specifically for this call site.
            // Bug fix (Codex review, P2 #7): must scan the SAME
            // FilterValidDurationTasks-filtered set BuildVisibleRows itself
            // decides hierarchy-vs-flat against — scanning the raw `Tasks`
            // parameter directly meant a ParentId on an invalid-duration
            // (End < Start, non-milestone) task that BuildVisibleRows had
            // already dropped from rendering still flipped this to
            // hierarchy mode, even though every ACTUALLY-RENDERED row was
            // flat/GroupLabel-driven — collapsing ColorByGroup's per-group
            // palette onto one color (every real root task shares the same
            // null ParentId "bucket" under the wrong mode).
            var usesHierarchy = ColorByGroup && GanttRowModel.UsesHierarchy(GanttRowModel.FilterValidDurationTasks(Tasks));
            var visibleWindow = ShowOffscreenIndicators ? VisibleTimelineWindow : null;
            // Parent-ness for the data-selected gate, derived from the SAME
            // authoritative row list being rendered — never from the Tasks
            // parameter, which `Rows` overrides and which is then legitimately
            // empty or stale (Codex review of the styling-hooks PR, P2).
            //
            // Two sources, because neither alone is complete:
            //  * row.HasChildren — authoritative when a caller supplies Rows,
            //    and the only way to know about a declared parent whose
            //    children are not themselves in the list.
            //  * the rows' own ParentId links — needed because
            //    BuildFallbackRows (the Rows==null path) hardcodes
            //    HasChildren:false for every row, so a standalone timeline fed
            //    through Tasks would otherwise report every parent as a leaf.
            var parentIds = new HashSet<string>(StringComparer.Ordinal);
            foreach (var r in visibleRows)
            {
                var pid = r.Task?.ParentId;
                if (!string.IsNullOrEmpty(pid)) parentIds.Add(pid!);
            }
            var rows = new List<GanttTimelineRow>(visibleRows.Count);
            for (var i = 0; i < visibleRows.Count; i++)
            {
                var row = visibleRows[i];
                var rollup = RowRollup(row, rollups);
                var (summaryX, summaryWidth) = rollup is { } r ? SummaryGeometry(r) : (0, 0);

                var task = row.Task;
                if (task is null)
                {
                    // Group-header slot: still occupies row index i (matching v2's
                    // rowSlot, which advances for header rows too) — Label carries
                    // the group's own name (Codex round 2, P2 #7) so the markup's
                    // else-branch above can render v2's section-header stripe here.
                    // GroupRowKey calls RowKey(visibleRows[i]) for this SAME row —
                    // see GanttTimelineRow's own remarks.
                    rows.Add(new GanttTimelineRow(null, 0, 0, i, null, row.Label, RowKey(row), rollup, summaryX, summaryWidth));
                    continue;
                }
                // Design spec Phase 3, T7 — ColorByGroup is the FALLBACK the
                // plan describes ("assigns stable per-group colors ... when
                // BarColor is null"): an explicit BarColor delegate result
                // always wins, exactly like the null-coalescing already did
                // before this feature existed.
                var color = BarColor?.Invoke(task) ?? (ColorByGroup ? GanttColorModel.ResolveGroupColorVar(usesHierarchy, task) : null);
                var (x, width) = GanttScale.BarGeometry(task, ViewMode, Origin, EffectiveColumnWidth, EffectiveBarHeight);
                var offscreen = visibleWindow is { } w ? ResolveOffscreenDirection(x, width, w) : GanttOffscreenDirection.None;
                rows.Add(new GanttTimelineRow(task, x, width, i, color, null, null, rollup, summaryX, summaryWidth, offscreen, row.HasChildren || parentIds.Contains(task.Id)));
            }
            return rows;
        }
    }

    // Design spec Phase 3, T7 — "outside the horizontal viewport" means
    // fully outside; a bar that merely OVERLAPS the visible window (even by
    // a single pixel) is already at least partly on screen and gets no chip.
    private static GanttOffscreenDirection ResolveOffscreenDirection(double x, double width, (double Start, double End) visibleWindow)
    {
        if (x + width < visibleWindow.Start) return GanttOffscreenDirection.Before;
        if (x > visibleWindow.End) return GanttOffscreenDirection.After;
        return GanttOffscreenDirection.None;
    }

    // Design spec Phase 3, T3 — every eligible parent/group row's rollup,
    // computed ONCE per render (not per row — see GanttRollupModel's own
    // complexity remarks) and looked up per row below via its ToggleKey. Empty
    // (and GanttRollupModel never invoked at all) when ShowSummaryBars is off,
    // so an existing chart that doesn't opt in pays nothing for this.
    private static readonly IReadOnlyDictionary<string, GanttRollup> EmptyRollups = new Dictionary<string, GanttRollup>();

    private IReadOnlyDictionary<string, GanttRollup> Rollups => ShowSummaryBars
        ? GanttRollupModel.ComputeRollups(GanttRowModel.FilterValidDurationTasks(Tasks), RollupMath)
        : EmptyRollups;

    /// <summary>
    /// Ids of tasks that are hierarchy PARENTS (some other task names them via
    /// <see cref="GanttTask.ParentId"/>). Used only to keep <c>data-selected</c>
    /// off parent bars — see the GanttBar call site.
    /// <para>
    /// Deliberately derived from <see cref="Tasks"/> rather than reusing
    /// <see cref="Rollups"/>, which looks like the same question and is not:
    /// Rollups is EMPTY whenever <see cref="ShowSummaryBars"/> is off, so
    /// keying selection off it would have made a styling hook depend on an
    /// unrelated display toggle.
    /// </para>
    /// </summary>

    // A row has a rollup exactly when it's collapsible (HasChildren) AND the
    // Rollups dictionary actually has an entry for its ToggleKey — the second
    // check is what makes this correctly return null for, e.g., a leaf task
    // row (HasChildren is always false there, ToggleKey is always null) without
    // a separate GanttRowKind switch.
    private static GanttRollup? RowRollup(GanttVisibleRow row, IReadOnlyDictionary<string, GanttRollup> rollups) =>
        row.HasChildren && row.ToggleKey is not null && rollups.TryGetValue(row.ToggleKey, out var rollup) ? rollup : null;

    // Same geometry formula as GanttScale.BarGeometry's own non-milestone
    // branch (date-truncated Start/End, End's own +1-day inclusive-end
    // convention, an 8px minimum width). GanttRollupModel's OWN default math
    // already truncates to .Date, but a CUSTOM RollupMath override is under no
    // such obligation — truncated again HERE (same defensive "truncate at
    // render time, never trust the caller" precedent BarGeometry's own remarks
    // describe for GanttTask.Start/End) rather than assumed. Not hoisted into
    // GanttScale itself (unlike BarGeometry): nothing outside this component
    // needs a rollup's geometry — GanttArrowLayer never draws dependency
    // arrows to/from a synthetic summary strip.
    private (double X, double Width) SummaryGeometry(GanttRollup rollup)
    {
        var x1 = GanttScale.DateToPixel(ViewMode, Origin, rollup.Start.Date, EffectiveColumnWidth);
        var x2 = GanttScale.DateToPixel(ViewMode, Origin, rollup.End.Date.AddDays(1), EffectiveColumnWidth);
        return (x1, Math.Max(8, x2 - x1));
    }

    // Phase 3, T1 — the per-row AllowCreate track div's own style (see the
    // markup's Task branch above): the row-track markup itself now lives
    // INSIDE RowItems' Virtualize item template (one div per rendered Task
    // row, virtualized in lockstep with its own bar — was a separate,
    // un-virtualized RowTrackItems list rendered before the Virtualize block
    // entirely; see GanttV3StickyHeaderTests' remarks on the matching bar/tree
    // fix this mirrors), so only the pure style-string helper remains here.
    private string RowTrackStyle(int rowIndex) =>
        FormattableString.Invariant($"left:0px;top:{rowIndex * GanttScale.RowHeight}px;height:{GanttScale.RowHeight}px;width:{TotalWidth}px;");

    // Design spec Phase 3, T7 — off-screen indicator chip. "sticky" (not
    // "absolute") is the load-bearing class here — see the markup's own
    // remarks for why. "start-2"/"end-2" (logical, RTL-safe — matches every
    // other edge offset in this file, e.g. GanttBar's own "start-full")
    // decide WHICH viewport edge the chip clings to; a "Before" (earlier)
    // bar's chip sits at the viewport's OWN start edge pointing further
    // toward start (ChevronLeft in the markup — un-mirrored, same "v3's date
    // axis is never mirrored for RTL" convention gantt-v3.js's own remarks
    // establish for bar geometry), an "After" (later) bar's chip sits at the
    // end edge pointing further toward end. rounded-[calc(var(--radius)*2)]
    // (the theme-radius-mapped circle utility, deliberately NOT the fully-
    // hardcoded-circle one — see RadiusTokenGuardTests' own remarks; this
    // file is not on its audited allowlist, and that guard scans raw
    // .razor file text, so even a comment spelling out the hardcoded
    // utility's literal name would itself fail it) is the SAME thematic-
    // rounding idiom the today-dot three members below already uses.
    private static string OffscreenChipClass(GanttOffscreenDirection direction) => Cx.Merge(
        "pointer-events-auto sticky inline-flex h-6 w-6 items-center justify-center rounded-[calc(var(--radius)*2)] border border-border/60 bg-card text-muted-foreground shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-[1.5px] focus-visible:ring-ring",
        direction == GanttOffscreenDirection.Before ? "start-2" : "end-2");

    // Real bug found via this campaign's own E2E gate — see
    // LeadingPaneWidth's own remarks for the full mechanism: a "before" chip
    // needs its inline-start offset pushed PAST the pinned tree pane (when
    // shown), or it lands exactly where the tree pane's own rows/grips are.
    // Only the "before" direction is affected — nothing else pins to the
    // opposite (end) edge, so "after" needs no equivalent adjustment. Inline
    // style (not a class) because the offset is a runtime pixel value, not
    // one of Tailwind's fixed spacing steps — matches every other
    // interop-driven geometry value in this file (e.g. WrapperStyle).
    private string? OffscreenChipStyle(GanttOffscreenDirection direction) =>
        direction == GanttOffscreenDirection.Before && LeadingPaneWidth > 0
            ? FormattableString.Invariant($"inset-inline-start:{LeadingPaneWidth + 8}px;")
            : null;

    // Design spec Phase 3, T7 — the off-screen chip's click "routes through
    // this existing scroll interop, not a new channel" (per the dispatch):
    // reuses ScrollToCenterAsync (below) — the SAME private helper
    // Today-centering already calls, itself a thin wrapper over the ONE
    // GanttV3ScrollToXAsync interop call every scroll-to-X path in this
    // component funnels through — rather than bubbling an event up to
    // GanttChart/GanttState.ScrollToTaskAsync. GanttTimeline must keep working
    // fully standalone (no GanttChart/GanttState wrapping it — an established,
    // repeatedly-tested contract throughout this campaign), so routing the
    // chip's click THROUGH GanttState first isn't viable for that case; this
    // way the chip works identically whether GanttChart hosts this timeline or
    // not, and GanttState.ScrollToTaskAsync (when a caller DOES go through
    // it) bottoms out in this exact same interop call anyway — see
    // GanttState's own T4 remarks. Centers on the bar's own pixel midpoint —
    // the SAME "midpoint of the span" convention T4's ScrollToTaskAsync
    // already established (there: a task's DATE span; here: the identical
    // idea applied to this bar's own already-resolved pixel span).
    private Task ScrollToBarAsync(GanttTimelineRow row) => ScrollToCenterAsync(row.X + row.Width / 2);

    // A stable identity for a GanttVisibleRow, independent of its list position
    // (so a row reorder/collapse between pointerdown and the eventual CommitCreate
    // round trip still resolves to the SAME row, unlike an index-based key would).
    // Task rows key off the task's own id (unique by construction); GroupHeader
    // rows key off GanttRowModel's own GroupToggleKey-derived ToggleKey (ALWAYS
    // non-null for a header row — BuildFlatGroupRows sets it unconditionally),
    // already namespaced ("group::" prefix) so it can never collide with a
    // "task:"-prefixed key.
    private static string RowKey(GanttVisibleRow row) =>
        row.Kind == GanttRowKind.Task ? "task:" + row.Task!.Id : row.ToggleKey!;

    // P1 fix (Codex review wave): center the DOM's actual scrollLeft on today,
    // mirroring gantt-v2.js's init-time tryScroll (lines 673-693) — WITHOUT
    // this, GanttChart.ComputeInitialRange's ~60-day padding before the earliest
    // task left scrollLeft at its default 0, showing an empty grid on first
    // paint (the committed v3 Day visual baseline showed exactly this bug).
    // Fires (a) once on first render, mirroring v2's ONE-TIME init-scroll
    // (v2 explicitly does NOT re-scroll on every refresh — see its own
    // "_initialScrolled" flag/comment — recentering on every render would
    // clobber a user's manual pan), and (b) again whenever
    // ScrollToTodayRequestId changes (GanttChart's GoToTodayAsync bumps it) —
    // recentering VisibleRange alone doesn't move the DOM's scrollLeft, since
    // Blazor's diff of a parameter change is not itself a scroll action.
    //
    // Phase 2, T1 — SyncDragRegistrationAsync is checked on EVERY render (not
    // just firstRender), both here and at the end of the non-firstRender path
    // below, so a runtime Readonly/CanDrop/AllowCreate flip re-syncs the JS
    // pointer listener immediately rather than only at mount.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Bug fix (#390 — mount-time scroll race): claim the initial
            // "scroll to today owed" intent RIGHT HERE, before this block's
            // own first await, not after ScrollToCenterAsync resolves further
            // down (where it used to be claimed). GanttChart's own
            // OnAfterRenderAsync calls StateHasChanged BEFORE its own
            // RefreshBrowserTodayAsync/RefreshBrowserNowAsync awaits (see its
            // own remarks) — that can dispatch a SECOND GanttTimeline render
            // (firstRender=false) while THIS firstRender pass is still
            // mid-flight in one of the several awaited interop round-trips
            // below (SyncDragRegistrationAsync, SyncBarContextMenuRegistrationAsync,
            // SyncWheelZoomRegistrationAsync, ReconcileHeaderScrollSyncAsync —
            // none of which touch _lastConsumedScrollRequestId). That second
            // render's own intentPending check used to read the SAME
            // still-unclaimed _lastConsumedScrollRequestId this pass hadn't
            // gotten to yet, independently concluded a scroll was still
            // owed, and issued its OWN duplicate ScrollToCenterAsync call —
            // both targeting the identical pixel (Today doesn't change
            // mid-mount), so invisible unless something ELSE writes
            // scrollLeft between the two landing (exactly what
            // GanttV3StickyHeaderTests'/GanttDragParityTests' own manual
            // scrollLeft resets do — the `-5633`-delta E2E failure this fix
            // closes). Same defect class, same fix shape, as
            // TryRequestRangeExtensionAsync's own _rangeExtensionInFlight
            // (claim BEFORE the first await, not after the round-trip that
            // state guards) — see its remarks. IsScrollHostReady/
            // ShouldAttemptTodayScroll are plain synchronous reads (not
            // themselves awaited), so evaluating them this early, rather
            // than at the original call site further down, changes nothing
            // about what they observe — only WHEN the resulting intent gets
            // recorded. ONLY the claim moves; the awaits below keep their
            // existing, deliberately-reviewed order (see each one's own
            // remarks) — ScrollToCenterAsync itself still fires from its
            // original spot, after SyncDragRegistrationAsync/
            // SyncBarContextMenuRegistrationAsync/SyncWheelZoomRegistrationAsync/
            // ReconcileHeaderScrollSyncAsync/RegisterVerticalScrollTrackingAsync,
            // using the intent decided HERE rather than re-deriving it live
            // (which would just read this pass's OWN now-claimed sentinel
            // and wrongly conclude nothing is owed).
            var initialIntentPending = IsScrollHostReady
                && ShouldAttemptTodayScroll
                && ScrollToTodayRequestId != _lastConsumedScrollRequestId;
            // Bug fix (residual #390 double-scroll — see _mountScrollClaim's
            // own remarks): captured alongside the claim below, not re-read
            // once the several awaits further down resolve — nothing in this
            // component bumps ScrollToTodayRequestId itself (only GanttChart
            // does, via a new parameter push, which is a different render
            // entirely), so it cannot change out from under this local
            // between now and this pass's own trailing action.
            var initialRequestId = ScrollToTodayRequestId;
            if (initialIntentPending)
            {
                _lastConsumedScrollRequestId = Math.Max(_lastConsumedScrollRequestId, initialRequestId);
                _mountScrollClaim = initialRequestId;
            }


            // Phase 2, T1/T4 fix — deflake: this MUST run FIRST, before any of
            // master's own scroll/header interop calls below. WaitV3ReadyAsync
            // (the E2E drag-parity suite's own readiness check) only waits for
            // a bar to ATTACH to the DOM — true on the synchronous first render,
            // well before ANY of this method's own interop round-trips complete.
            // Phase 2's original code called ONLY this here, so it always won
            // that race in practice (one round-trip). Placing it AFTER
            // ReconcileHeaderScrollSyncAsync/RegisterVerticalScrollTrackingAsync/
            // ScrollToCenterAsync (three more sequential awaited round-trips)
            // reproduced live: a real Playwright mouse gesture fired on the bar/
            // row-track before the delegated pointerdown listener was attached,
            // silently swallowing the drag (empty event-sink-taskcreate,
            // ElementNotFoundException-adjacent symptom) — most visible on the
            // drag-CREATE specs, whose own setup (locate track, read its
            // bounding box) leaves less incidental slack before the drag starts
            // than the move/resize/progress specs happen to accumulate. No
            // ordering dependency ties drag registration to the other three
            // calls (each keyed off its own independent Map in gantt-v3.js), so
            // reordering only this call is safe.
            await SyncDragRegistrationAsync();
            // Design spec Phase 3, T8 — a SEPARATE channel from the drag engine
            // above (see BarContextMenu's own remarks for why); registering it
            // here too, in the SAME first-render block, keeps both delegated
            // listeners attached before the first real pointer/mouse event a
            // Playwright spec could possibly fire.
            await SyncBarContextMenuRegistrationAsync();
            // Wheel zoom's own registration channel — see its remarks for why
            // this one is gated on IsScrollHostReady like RegisterVerticalScrollTrackingAsync
            // (it targets EffectiveScrollHost, which can be a not-yet-captured
            // caller-supplied ElementReference), unlike Drag/BarContextMenu
            // above (which always target this component's own always-ready
            // _scrollHostRef).
            await SyncWheelZoomRegistrationAsync();

            // Codex round 3, P2 #1: the JS scroll-sync transform exists ONLY to
            // work around an intervening overflow-x:auto ancestor hijacking the
            // header's own `position:sticky` (see the header markup's remarks) —
            // when ScrollHost is supplied, this component's row-canvas div is no
            // longer such an ancestor (CanvasScrollClass drops overflow-x-auto
            // entirely), so there is nothing left for native sticky positioning
            // to be defeated BY: the header naturally scrolls horizontally with
            // the shared outer pane's content (ordinary document flow) while
            // staying vertically pinned via its own sticky top-0 — no JS needed.
            // Registering the sync anyway in this mode would double-apply the
            // horizontal offset (once via natural scroll, once via the extra
            // transform), so ReconcileHeaderScrollSyncAsync (see its own
            // remarks) skips it entirely in that mode rather than redirecting.
            //
            // Registered BEFORE the scroll-to-today attempt below, so the
            // header-scroll-sync listener already exists by the time that
            // scroll's own (asynchronous, requestAnimationFrame-scheduled)
            // native 'scroll' event fires — otherwise the header could miss
            // mirroring the very first centering scroll.
            await ReconcileHeaderScrollSyncAsync();

            _lastSeenToday = Today;
            _lastSeenScrollHostId = CurrentHostId;

            // Codex round 4, P2 #3: registered unconditionally (both modes —
            // unlike the header-scroll-sync above, this one is NOT skipped for
            // GanttChart's shared-pane mode; see its own registration method
            // remarks for why). Same "not yet captured" ElementReference race
            // as the scroll-to-today attempt below — gated on IsScrollHostReady
            // and retried on the same scrollHostChanged transition.
            if (IsScrollHostReady) await RegisterVerticalScrollTrackingAsync();

            // Standalone-timeline browser clock — LAST among this pass's
            // awaits, deliberately (Codex review of the styling-hooks PR, P2).
            // Placed before SyncDragRegistrationAsync in the first attempt, it
            // pushed the delegated pointer listener behind an extra interop
            // round trip, so a drag begun on an already-painted bar in that
            // window was silently missed. That also hit the NORMAL GanttChart
            // composition, contrary to what the first version of this claimed:
            // GanttChart passes Now="@_browserNow", which is null until its own
            // resolve lands, so the "hosted path is a no-op" gate did not hold
            // on the first render. Nothing about data-past is interaction-
            // critical, so it yields to every registration above it.
            await ResolveOwnBrowserNowAsync();

            // Bug fix (Codex round 3, P2 #1): a caller-supplied ScrollHost's
            // value DURING this render is unavoidably whatever the ancestor's
            // own ref field held when the ANCESTOR's render tree was built —
            // which precedes that SAME render's own ref-capture step (verified
            // empirically: GanttChart's own _scrollPaneRef is already valid inside
            // ITS OnAfterRenderAsync, yet this component sees an uncaptured/
            // empty-Id ElementReference for the identical value on this SAME
            // pass). Attempting the scroll against a not-yet-ready host would
            // silently no-op (gantt-v3.js's centerOn no-ops on a null/
            // unresolvable element) — skipped here entirely rather than
            // wasting the round-trip, deferring to the guaranteed retry below
            // (GanttChart forces exactly one extra render specifically so this
            // component gets a second chance with a now-valid host). Standalone
            // usage (ScrollHost null) is unaffected — IsScrollHostReady is
            // trivially true in that mode, so this still scrolls on
            // firstRender exactly as before ScrollHost existed.
            // The intent — and its claim against _lastConsumedScrollRequestId
            // — were already decided and recorded at the TOP of this block,
            // before any of the awaits above; re-deriving "is a scroll still
            // owed" HERE, live, would just read this pass's OWN now-claimed
            // sentinel and wrongly conclude nothing is (see the bug-fix
            // remarks up top). initialIntentPending is reused as-is, not
            // recomputed, for exactly that reason.
            //
            // Bug fix (residual #390 double-scroll — see _mountScrollClaim's
            // own remarks): the ticket armed at the top of this block only
            // still matches initialRequestId if NOBODY has raced ahead and
            // handled it already — the non-firstRender branch's own
            // scrollHostChanged-triggered action (GanttChart's deliberate
            // "second chance" render, dispatched while this pass was stuck
            // in the several interop round-trips above) clears it the
            // instant it fires. If that already happened, this call would be
            // a purely redundant SECOND scroll for the identical target —
            // re-arming ScrollToCenterAsync's own suppression flag for no
            // reason (see that flag's remarks) — so it's skipped, not fired.
            if (initialIntentPending && _mountScrollClaim == initialRequestId)
            {
                _mountScrollClaim = null;
                await ScrollToCenterAsync(ResolveScrollTargetX(true), ResolveScrollTargetOffset(true));
            }

            return;
        }

        // Bug fix (Codex review of the styling-hooks PR, P2): a timeline that
        // mounted WITH a Now and later has it cleared became eligible for
        // self-resolution but was never asked again, because the only call site
        // was the firstRender branch above. EffectiveNow then fell back to the
        // server clock for the rest of the session. Self-gated the same way, so
        // this is a plain no-op on every render where Now is still supplied or
        // the value is already resolved.
        await ResolveOwnBrowserNowAsync();

        // Today (Codex round 2, P2 #9) changing — e.g. GanttChart's browser-date
        // resolution landing a render or two after mount — is treated exactly
        // like a ScrollToTodayRequestId bump: recentering VisibleRange/TodayX
        // alone never touches the DOM's actual scrollLeft (same reasoning as
        // the pre-existing ScrollToTodayRequestId check below).
        //
        // ScrollHost transitioning from "not yet captured" to "captured"
        // (Codex round 3, P2 #1), OR a genuinely DIFFERENT host arriving
        // later (Codex round 7 review, P2 #2 — a standalone timeline
        // receiving a parent host after mount, or a parent replacing the
        // host element outright), is the SAME kind of trigger: the timeline
        // needs to (re)bind its scroll-tracking registration and re-request
        // the pending centering scroll against whichever host is current.
        // Comparing the CAPTURED ID (not the raw ElementReference struct, and
        // not just a one-way readiness bool) is what makes this a genuine
        // identity-change check rather than either a one-shot latch (the old
        // bug) or something that fires on harmless struct-identity churn for
        // an otherwise-unchanged, already-valid reference.
        var currentHostId = CurrentHostId;
        var scrollHostChanged = currentHostId != _lastSeenScrollHostId;
        // Codex round 14, finding #3: an intent is pending until its request-id
        // bump is actually applied — so an intent deferred because the host
        // wasn't ready yet is still applied on the later host-ready render.
        var intentPending = ScrollToTodayRequestId != _lastConsumedScrollRequestId;
        if (intentPending || Today != _lastSeenToday || scrollHostChanged)
        {
            _lastSeenToday = Today;
            _lastSeenScrollHostId = currentHostId;

            // Minor tightening (cx3 review): this branch can also fire for a
            // Today change alone, independent of scrollHostChanged above —
            // re-checking IsScrollHostReady here guards the (practically
            // unreachable, since GanttChart's own ref is already valid by the time
            // it could bump either of those, but not provably impossible for a
            // future caller) case where one of them changes on the SAME render
            // ScrollHost is still resolving. The explicit ScrollTargetDate is
            // honored only while intentPending; a pure Today/host re-scroll
            // targets Today (finding #3).
            if (IsScrollHostReady && ShouldAttemptTodayScroll)
            {
                // Bug fix (Codex round 15 review, P2) — see the firstRender
                // branch's own remarks above for the full reasoning: capture
                // the id this call is actually applying, mark THAT one
                // consumed (via Math.Max, not a flat overwrite — see the same
                // remarks for why), not whatever ScrollToTodayRequestId
                // happens to read once the interop round-trip resolves.
                //
                // Bug fix (#390): claimed BEFORE the await below, not after —
                // this branch has no OTHER await preceding it (unlike
                // firstRender's own several interop round-trips), so this is
                // its ONLY suspension point; claiming here closes the same
                // race the firstRender fix closes (a render dispatched while
                // THIS call is mid-flight must see the intent already
                // claimed), see the firstRender branch's own remarks for the
                // full defect-class writeup.
                var requestIdBeingApplied = ScrollToTodayRequestId;
                _lastConsumedScrollRequestId = Math.Max(_lastConsumedScrollRequestId, requestIdBeingApplied);
                // Bug fix (residual #390 double-scroll — see
                // _mountScrollClaim's own remarks): this branch keeps
                // scrolling UNCONDITIONALLY here, exactly as it always has —
                // Today-changed/scrollHostChanged are independent, legitimate
                // re-scroll triggers (see this trigger's own class remarks
                // above) that must never be suppressed, including on a
                // request id that was already applied once before (Today
                // changing bumps neither ScrollToTodayRequestId nor this
                // guard). Clearing the ticket here — only when it still
                // names THIS exact id — is purely a courtesy to a firstRender
                // pass that might STILL be mid-flight behind this one: it has
                // no effect on whether THIS call itself proceeds.
                if (_mountScrollClaim == requestIdBeingApplied) _mountScrollClaim = null;
                await ScrollToCenterAsync(ResolveScrollTargetX(intentPending), ResolveScrollTargetOffset(intentPending));
            }

            // Codex round 7 review, P2 #2: a genuine host-identity change
            // must tear down the OLD registration (against the OLD host)
            // before registering the new one — RegisterVerticalScrollTrackingAsync
            // alone is a no-op once _verticalScrollTrackingRegistered is
            // already true, which is exactly what let the old host go on
            // reporting scroll positions for the wrong element forever.
            // RebindVerticalScrollTrackingAsync handles both this and the
            // plain not-ready-to-ready case (unregister is a no-op there,
            // since nothing was registered yet).
            if (scrollHostChanged) await RebindVerticalScrollTrackingAsync();
            else if (IsScrollHostReady) await RegisterVerticalScrollTrackingAsync();

            // Bug fix (Codex round 8 review, P2 #3): the header-sync
            // registration used to be decided ONLY on firstRender — a
            // standalone timeline (ScrollHost null at mount) later receiving
            // a parent host, or a shared-pane timeline later losing its host
            // (ScrollHost reverting to null), never reconfigured it: the
            // firstRender snapshot latched forever, the SAME latch class as
            // the vertical-scroll-tracking bug above. Shares this EXACT
            // scrollHostChanged trigger rather than a second, independent
            // detection mechanism — see ReconcileHeaderScrollSyncAsync's own
            // remarks for what "reconfigure" means here.
            if (scrollHostChanged) await ReconcileHeaderScrollSyncAsync();
        }

        // Bug fix (Codex round 6, P1 #2): a rows-count change (empty->populated,
        // collapse/expand toggling row visibility) never re-triggers the
        // vertical-scroll-tracking JS listener at all — no native 'scroll'
        // event fires, and the pane's own size (what a ResizeObserver would
        // watch) doesn't change either, only its SCROLLABLE CONTENT does. Left
        // unhandled, GanttArrowLayer kept culling against whatever row count
        // was last reported, silently hiding every arrow the moment a task
        // list went from empty to populated (bars/tree render immediately via
        // Virtualize; only the arrow-culling window was stale). Re-derives the
        // SAME clamping synchronously in C# from the last actually-reported
        // scrollTop/clientHeight — no JS round-trip needed, since nothing
        // about the SCROLL POSITION itself changed, only which row indices it
        // now maps to.
        var rowCount = EffectiveRows.Count;
        if (rowCount != _lastCulledRowCount && _lastReportedScrollTop is { } st && _lastReportedClientHeight is { } ch)
        {
            RecomputeVisibleRowRange(st, ch);
        }

        await SyncDragRegistrationAsync();
        // Design spec Phase 3, T8 — checked on EVERY render too (not just
        // firstRender), same "a runtime flip re-syncs immediately" contract as
        // SyncDragRegistrationAsync's own remarks: a caller wiring/un-wiring
        // BarContextMenu after mount takes effect on the very next render.
        await SyncBarContextMenuRegistrationAsync();
        // Checked on EVERY render too, unconditionally (not folded into the
        // intentPending/scrollHostChanged block above) — a bare ViewMode
        // parameter change on a STANDALONE timeline (no GanttChart wrapping
        // it to bump ScrollToTodayRequestId) would otherwise never re-sync
        // the registered currentMode, leaving JS's own synchronous
        // zoom-limit check comparing against a stale mode.
        await SyncWheelZoomRegistrationAsync();
    }

    // Codex round 4, P2 #3. Idempotent per EffectiveScrollHost value — the JS
    // side (registerVerticalScrollTracking) also guards via its own Map, but
    // guarding here too avoids a redundant interop round-trip on every retry
    // once already registered. Records which host it registered against
    // (Codex round 7 review, P2 #2) so a later identity change can unregister
    // the RIGHT (old) element rather than whatever EffectiveScrollHost has
    // since become.
    //
    // Bug fix (Codex round 17 review, P2): _verticalScrollTrackingRegistered
    // is set TRUE synchronously, right here, before the interop call below
    // even starts — so DisposeAsync landing while that call is still in
    // flight already sees it as "registered" and DOES fire its own unregister
    // call. That isn't quite enough on its own: DisposeAsync's unregister can
    // race the JS side's own (still in-flight) register call and lose —
    // arriving before the register's own effects land there — leaving the
    // listener registered forever with nothing left to ever tear it down
    // again. Mirrors GanttBar's own register-vs-dispose fix: explicitly await
    // the register call here (this method is now genuinely async, not just
    // returning the interop Task for the caller to await), then re-check
    // disposed state immediately after and issue one more unregister if so —
    // deterministically closing the ordering gap DisposeAsync's own
    // best-effort attempt can't guarantee alone.
    private async Task RegisterVerticalScrollTrackingAsync()
    {
        if (_verticalScrollTrackingRegistered) return;
        _verticalScrollTrackingRegistered = true;
        _registeredScrollHostRef = EffectiveScrollHost;
        _selfRef ??= DotNetObjectReference.Create(this);
        await Interop.GanttV3RegisterVerticalScrollTrackingAsync(EffectiveScrollHost, _selfRef);

        if (_disposed)
        {
            try { await Interop.GanttV3UnregisterVerticalScrollTrackingAsync(_registeredScrollHostRef.Value); }
            catch (JSDisconnectedException) { }
        }
    }

    // Codex round 7 review, P2 #2: tears down vertical-scroll tracking on the
    // PREVIOUSLY-registered host (if any) before registering against the
    // current one. Safe to call whenever CurrentHostId has changed, whether
    // that's the first "not ready -> ready" capture (nothing to unregister
    // yet) or a genuinely different host replacing an already-registered one.
    private async Task RebindVerticalScrollTrackingAsync()
    {
        if (_verticalScrollTrackingRegistered && _registeredScrollHostRef is { } oldHost)
        {
            _verticalScrollTrackingRegistered = false;
            _registeredScrollHostRef = null;
            try { await Interop.GanttV3UnregisterVerticalScrollTrackingAsync(oldHost); }
            catch (JSDisconnectedException) { }
        }

        if (IsScrollHostReady) await RegisterVerticalScrollTrackingAsync();
    }

    // Bug fix (Codex round 8 review, P2 #3): reconciles the header-scroll-sync
    // JS listener against whichever mode is CURRENT, rather than the
    // firstRender-only registration this used to be — a standalone timeline
    // (ScrollHost null at mount) later receiving a parent host, or the
    // reverse, never reconfigured the listener before this fix, the same
    // one-shot-latch class RebindVerticalScrollTrackingAsync closes above for
    // vertical-scroll tracking. Header sync is wanted in standalone mode
    // ONLY (ScrollHost null — see the firstRender remarks above for why it
    // would double-apply the horizontal offset otherwise), so this is a
    // plain "does the CURRENT mode want it, does that match what's actually
    // registered" reconcile — idempotent, safe to call on every firstRender
    // AND every scrollHostChanged transition, sharing this ONE code path
    // instead of the two independent ones (an inline firstRender block plus
    // nothing at all for later transitions) that existed before.
    private async Task ReconcileHeaderScrollSyncAsync()
    {
        var wantHeaderSync = ScrollHost is null;
        if (wantHeaderSync == _headerScrollSyncRegistered) return;

        if (_headerScrollSyncRegistered)
        {
            _headerScrollSyncRegistered = false;
            try { await Interop.GanttV3UnregisterHeaderScrollSyncAsync(_scrollHostRef); }
            catch (JSDisconnectedException) { }
        }

        if (wantHeaderSync)
        {
            _headerScrollSyncRegistered = true;
            await Interop.GanttV3RegisterHeaderScrollSyncAsync(_scrollHostRef, _headerInnerRef);
        }
    }

    /// <summary>
    /// Reports the shared scroll pane's current scrollTop/clientHeight (Codex
    /// round 4, P2 #3) AND — design spec Phase 3, T7 — its logical
    /// scrollLeft/clientWidth (off-screen indicators' own viewport signal).
    /// Invoked from JS via <c>registerVerticalScrollTracking</c>'s rAF-throttled
    /// listener, on a native 'scroll' event OR (Codex round 6, P1 #2) a
    /// ResizeObserver firing for a pane-size change. Public because
    /// <c>[JSInvokable]</c> requires it — not meant for direct C# callers.
    ///
    /// T7 extended this SAME payload/channel rather than registering a new
    /// one: the identical native 'scroll' event this listener already reacts
    /// to fires for horizontal panning too (there is only one 'scroll' event
    /// per element — see this method's OWN pre-existing round-5 dedup remarks
    /// two methods below), so gantt-v3.js's report() already had everything
    /// it needed to also read el.scrollLeft/el.clientWidth at zero extra
    /// event-listener cost — the same "extend the existing interop family,
    /// no separate channel" precedent T2's NowIndicator established for
    /// GanttV3GetLocalDateAsync. The method/registration NAMES still say
    /// "Vertical" (a deliberate, considered choice, not an oversight — see
    /// the Phase-3 ledger entry): renaming would ripple through the JS
    /// module's exports, IComponentInteropService's default-interface method
    /// signatures, and every existing test referencing this specific channel
    /// by name, for a purely cosmetic gain with no functional upside: this
    /// XML doc comment is the discoverable "also carries horizontal scroll
    /// extent now" pointer instead.
    /// </summary>
    [JSInvokable]
    public void OnGanttV3VerticalScroll(double scrollTop, double clientHeight, double scrollLeft, double clientWidth)
    {
        // Real bug found via the E2E gate (bUnit's own coverage never
        // exercised a SECOND report against an already-populated
        // _visibleRowRange, so it never caught this): RecomputeVisibleRowRange
        // below only calls StateHasChanged when the VERTICAL culling range
        // actually changes (its own "no-op: avoid a redundant re-render"
        // guard — a deliberate, correct optimization for a horizontal-only
        // pan BEFORE off-screen indicators existed, since nothing arrow-
        // culling-relevant changes then). T7 added a SECOND consumer of this
        // same report (VisibleTimelineWindow) that DOES care about a
        // horizontal-only change — a pure horizontal pan with the vertical
        // range unchanged (the common case: scrolling to browse dates
        // without also scrolling rows) silently never re-rendered the
        // off-screen chips at all, since RecomputeVisibleRowRange's own gate
        // has no idea a second, horizontal-only consumer exists. Detected
        // BEFORE committing to the render decision (comparing against the
        // OLD field values, not the ones being overwritten right below).
        var horizontalChanged = ShowOffscreenIndicators &&
            (_lastReportedScrollLeft != scrollLeft || _lastReportedClientWidth != clientWidth);
        _lastReportedScrollTop = scrollTop;
        _lastReportedClientHeight = clientHeight;
        _lastReportedScrollLeft = scrollLeft;
        _lastReportedClientWidth = clientWidth;
        RecomputeVisibleRowRange(scrollTop, clientHeight);
        // Idempotent to call alongside RecomputeVisibleRowRange's own
        // (conditional) call above — Blazor coalesces multiple StateHasChanged
        // calls within one synchronous handler into a single render.
        if (horizontalChanged) StateHasChanged();

        // Design spec Phase 3, T9 — infinite scroll's own edge-detection half.
        // Threshold math lives HERE (C#), not in gantt-v3.js's report(),
        // deliberately: VisibleTimelineWindow/TotalWidth below are ALREADY
        // leading-offset- AND RTL-normalized (see VisibleTimelineWindow's own
        // remarks) — a sibling tree pane's width (LTR-only) is folded OUT of
        // the reported scrollLeft before either value is ever compared, which
        // gantt-v3.js's report() has no way to do on its own (ScrollHostLeadingOffset
        // is a GanttChart/GanttTimeline-only concept, never pushed to JS). Reusing
        // these ALREADY-hardened, already-RTL-correct C# values for the
        // threshold check is "reuse GanttScale origin math, no second
        // implementation" applied to the EDGE-DETECTION half of T9, not only
        // the recenter half (see HandleRangeExtensionRequestAsync's own
        // remarks in GanttChart.razor for that half) — a deliberate departure from
        // the plan's own literal "JS detects threshold" wording once research
        // showed JS lacks the one input (leading offset) that math needs to be
        // correct under a visible tree pane (same "research can replace the
        // plan's literal wording when it doesn't hold up against the actual
        // code" precedent T7's own decision 5 already established).
        // Design spec Phase 3, T9 — consumes ScrollToCenterAsync's own
        // suppression flag (see its remarks) UNCONDITIONALLY, before the
        // InfiniteScroll/VisibleTimelineWindow gate below — a programmatic
        // recenter that happens to fire while InfiniteScroll is false, or
        // before the pane has been measured yet, must still clear the flag
        // rather than leave it armed to wrongly suppress a LATER, genuine
        // near-edge report once those conditions change.
        var suppressThisReport = _suppressNextExtensionReport;
        _suppressNextExtensionReport = false;

        if (!suppressThisReport && InfiniteScroll && VisibleTimelineWindow is { } window)
        {
            // "Nearing an edge" = within one viewport-width of it — the SAME
            // "a page" language the plan uses for how much MORE range an
            // extension adds (see GanttChart.PadBoundaryBefore/After's own
            // remarks), reused here as the TRIGGER distance too: fewer than
            // one more full screenful of already-rendered range remains.
            var thresholdPx = clientWidth;
            var nearLeading = window.Start < thresholdPx;
            var nearTrailing = (TotalWidth - window.End) < thresholdPx;
            // Leading checked first, not both independently — extending
            // EITHER edge moves the threshold for the other one too; a range
            // narrower than 2 viewport-widths (both near at once) still gets
            // the OTHER edge's own request on the very next report instead of
            // firing two overlapping requests from this single one.
            if (nearLeading) _ = TryRequestRangeExtensionAsync(leading: true);
            else if (nearTrailing) _ = TryRequestRangeExtensionAsync(leading: false);
        }
    }

    /// <summary>
    /// The JS-report-to-GanttChart request pipeline's OWN half (design spec Phase
    /// 3, T9) — see <see cref="OnRangeExtensionRequested"/>'s own remarks for
    /// why this component only ever ASKS, never commits <c>VisibleRange</c>
    /// itself. Fire-and-forget from <see cref="OnGanttV3VerticalScroll"/>'s own
    /// synchronous body (<c>_ = TryRequestRangeExtensionAsync(...)</c>): this
    /// method is genuinely async (one interop round-trip here, then
    /// <c>GanttChart</c>'s own longer async pipeline behind the EventCallback),
    /// which a <c>[JSInvokable] void</c> method cannot itself await without
    /// changing its signature — see that method's own remarks on why its
    /// signature stays untouched (a heavily-referenced existing channel, not
    /// worth widening for this one new caller).
    /// </summary>
    private async Task TryRequestRangeExtensionAsync(bool leading)
    {
        if (_rangeExtensionInFlight) return; // see its own remarks
        // Bug fix (Codex review, P2 #6): this used to stay false across the
        // FIRST await below (GanttV3HasActiveDragAsync) and only get set
        // true once that resolved — under real latency, a second near-edge
        // report arriving while that first await is still in flight passed
        // this SAME (still-false) check, so both proceeded, both eventually
        // set the flag, and both invoked OnRangeExtensionRequested — two
        // overlapping extensions for one edge encounter (confirmed via
        // GanttV3Phase3T9Tests' own two_reports-racing specs, both
        // directions — GanttChart.HandleRangeExtensionRequestAsync's own
        // per-request staleness re-check does NOT catch this: continuation
        // #1 can run start-to-finish, INCLUDING clearing this flag again in
        // its own `finally`, entirely within continuation #2's single
        // suspended await, so #2's own fresh capture of VisibleRange never
        // sees anything stale). Set BEFORE the first await, cleared in the
        // SAME try/finally that now wraps the whole method, so no window
        // exists where this instance is genuinely mid-request yet reads as
        // available.
        _rangeExtensionInFlight = true;
        try
        {
            // Design spec Phase 3, T9, decision 3 — the CHEAP half of the
            // gesture-suppression gate: avoids even asking GanttChart (which
            // would itself do a live-scroll-center interop round trip for
            // the leading case) while a drag is visibly active at this
            // exact moment. See GanttV3HasActiveDragAsync's own remarks for
            // why GanttChart ALSO re-checks this, right before it actually
            // commits — this call alone does not close the whole race, only
            // the common case cheaply.
            if (await Interop.GanttV3HasActiveDragAsync()) return;
            if (_disposed) return;
            if (OnRangeExtensionRequested.HasDelegate)
                await OnRangeExtensionRequested.InvokeAsync(leading);
        }
        finally
        {
            _rangeExtensionInFlight = false;
        }
    }

    // Design spec Phase 3, T7 — the current horizontal scroll viewport, in
    // the SAME timeline-origin-relative pixel space GanttBar.X/Width already
    // live in (0 = ViewMode's earliest rendered date) — i.e. WITH
    // ScrollHostLeadingOffset (a sibling tree pane's width, LTR-with-tree
    // only) subtracted back out, since the reported scrollLeft is relative to
    // the shared scroll pane's own content origin, which starts at the TREE
    // pane's edge in hosted mode, not the timeline's (see ScrollToCenterAsync's
    // own remarks — it ADDS this same offset going the other direction, for
    // exactly the inverse reason). Null until the first report arrives, OR
    // when clientWidth hasn't been reported yet — RowItems treats null as
    // "don't compute any row's off-screen status" (see its own remarks),
    // matching _visibleRowRange's identical null-means-unknown convention two
    // members up.
    private (double Start, double End)? VisibleTimelineWindow
    {
        get
        {
            // clientWidth <= 0 is treated as "not yet measured" — the SAME
            // convention RecomputeVisibleRowRange already uses for
            // clientHeight (see its own "if (... || clientHeight <= 0)
            // return" guard) — a real browser viewport never reports a
            // zero/negative width, so this doubles as the test-helper
            // backward-compat path (TrackingInteropService.RaiseGanttV3VerticalScroll's
            // scrollLeft/clientWidth default to 0 for every EXISTING call
            // site that predates T7 and never meant to simulate horizontal
            // scroll at all).
            if (_lastReportedScrollLeft is not { } scrollLeft || _lastReportedClientWidth is not { } clientWidth || clientWidth <= 0) return null;
            var start = scrollLeft - ScrollHostLeadingOffset;
            // Bug fix (Codex review, P2 #3): `clientWidth` is the RAW client
            // width of the shared scroll host — in hosted GanttChart with a tree
            // pane shown, that host also contains the STICKY tree pane, which
            // permanently occupies LeadingPaneWidth px of it regardless of
            // scroll position (sticky positioning doesn't remove an element
            // from layout flow, so it always consumes its own column width).
            // Only `clientWidth - LeadingPaneWidth` px are actually visible
            // TIMELINE content. This is a SEPARATE correction from
            // ScrollHostLeadingOffset above (which only shifts the ORIGIN,
            // LTR-with-tree only, collapsing to 0 under RTL per its own
            // remarks) — LeadingPaneWidth is logical and applies in BOTH
            // directions (see its own remarks), so subtracting it here from
            // the raw width is correct for both LTR and RTL, unlike reusing
            // ScrollHostLeadingOffset for this. Without it, a bar sitting
            // behind the pinned tree's own footprint read as fully inside
            // the window and never got an off-screen indicator/never
            // triggered infinite-scroll edge detection.
            return (start, start + clientWidth - LeadingPaneWidth);
        }
    }

    // Codex round 6, P1 #2: extracted so a rows-count change (empty->populated,
    // collapse/expand) can re-run this SAME clamping without a JS round-trip —
    // it was previously inlined directly in OnGanttV3VerticalScroll, the ONLY
    // thing that ever invalidated the culling window. A rows-count change
    // never touches scrollTop/clientHeight at all (no native 'scroll' event,
    // no resize), so it silently left GanttArrowLayer culling against a
    // STALE row count until the user happened to scroll again — e.g. an
    // empty->populated task list showed no arrows at all until then, even
    // though bars/tree rows themselves render immediately via Virtualize.
    // Recomputes which row indices are actually visible (+ a small buffer
    // margin, matching the spirit of Blazor's own Virtualize overscan) so
    // GanttArrowLayer can cull arrows whose endpoints are both scrolled out
    // of view.
    private void RecomputeVisibleRowRange(double scrollTop, double clientHeight)
    {
        if (GanttScale.RowHeight <= 0 || clientHeight <= 0) return;

        // A few rows of buffer above/below the exact pixel-visible range —
        // Blazor's own Virtualize renders a similar overscan margin so its
        // placeholder-swap doesn't visibly pop in/out at the viewport edge;
        // arrows use the SAME margin so an arrow terminating at a
        // just-off-screen (but still Virtualize-rendered) bar doesn't
        // disappear a frame before its own endpoint does.
        const int marginRows = 10;
        var start = (int)Math.Floor(scrollTop / GanttScale.RowHeight) - marginRows;
        var end = (int)Math.Ceiling((scrollTop + clientHeight) / GanttScale.RowHeight) + marginRows;
        var rowCount = EffectiveRows.Count;
        start = Math.Clamp(start, 0, Math.Max(0, rowCount - 1));
        end = Math.Clamp(end, 0, Math.Max(0, rowCount - 1));

        _lastCulledRowCount = rowCount;
        var newRange = (start, end);
        if (_visibleRowRange == newRange) return; // no-op: avoid a redundant re-render
        _visibleRowRange = newRange;
        StateHasChanged();
    }

    // True once ScrollHost is either not in use (standalone mode, always
    // "ready" — this component always has a valid ref to its own element by
    // OnAfterRenderAsync) or has actually been captured by Blazor (a non-empty
    // Id — see OnAfterRenderAsync's remarks for why a caller-supplied
    // ElementReference can start out uncaptured).
    private bool IsScrollHostReady => ScrollHost is null || !string.IsNullOrEmpty(ScrollHost.Value.Id);

    // Codex round 7 review, P2 #2: the captured host's own Id when ready,
    // null otherwise — used to detect a genuine host IDENTITY change (a
    // different Id, not just "not ready -> ready") across renders. In
    // standalone mode (ScrollHost null) EffectiveScrollHost is always this
    // component's own, stable _scrollHostRef, so this never spuriously
    // "changes" there.
    private string? CurrentHostId => IsScrollHostReady ? EffectiveScrollHost.Id : null;

    // Codex round 4, P2 #2/#8: ScrollHostLeadingOffset (a sibling tree pane's
    // width, when GanttChart shows one) + the resolved target pixel (Today or a
    // caller-supplied override) — the offset defaults to 0, so this reduces to
    // exactly the previous "Interop.GanttV3ScrollToXAsync(EffectiveScrollHost,
    // TodayX)" call for a standalone timeline.
    //
    // Design spec Phase 3, T9 — the ONE shared choke point EVERY programmatic
    // recenter already funnels through (Today/Prev/Next, a view-mode switch,
    // GanttState.ScrollToDateAsync/ScrollToTaskAsync, an off-screen-chip
    // click) is exactly where infinite scroll's own gesture-suppression-
    // adjacent problem needs its fix: a DELIBERATE recenter can legitimately
    // land the viewport within one page of VisibleRange's own edge whenever
    // the rendered range isn't drastically wider than the viewport (e.g. a
    // freshly Today-recentered Month-mode window, ~2x a typical viewport
    // wide) — that is NOT the user "running out of room while exploring," it
    // is the SYSTEM placing them there on purpose, and immediately
    // auto-extending underneath them would silently re-shift the very view
    // they just asked for (a real bug this task's own local E2E gate caught:
    // GanttV3NavTests' Today/Next-Previous specs shifted VisibleRange.Start
    // by an EXTRA Month-mode PadBefore, 12 months, immediately after the
    // recenter they were asserting on). Setting this flag here — BEFORE the
    // interop call, so it is armed even if the awaited call itself is what
    // triggers the resulting native 'scroll' event synchronously — and
    // consuming it on the very NEXT OnGanttV3VerticalScroll report (see its
    // own remarks) treats exactly one post-recenter report as "this is the
    // scroll settling," not "the user wants more."
    // offsetOverride (see ScrollTargetOffsetOverride's own remarks): null for
    // every existing caller (unchanged centerOn/viewport-center behavior);
    // wheel-zoom's own recenter is the one caller that supplies it, routing
    // to GanttV3ScrollToOffsetAsync instead so the anchor date lands at the
    // POINTER's own local offset rather than the viewport's center.
    private Task ScrollToCenterAsync(double targetX, double? offsetOverride = null)
    {
        _suppressNextExtensionReport = true;
        return offsetOverride is { } offset
            ? Interop.GanttV3ScrollToOffsetAsync(EffectiveScrollHost, ScrollHostLeadingOffset + targetX, offset)
            : Interop.GanttV3ScrollToXAsync(EffectiveScrollHost, ScrollHostLeadingOffset + targetX);
    }

    // Phase 2, T1 — (un)registers gantt-v3.js's pointer drag engine against
    // _scrollHostRef (the row-canvas element — where bars/tracks actually
    // live, regardless of which element a caller-supplied ScrollHost makes
    // the scroll owner). Readonly is checked FRESH on every render (not just
    // first-render — see OnAfterRenderAsync above), so a runtime Readonly flip
    // un-registers/re-registers instead of only taking effect at mount.
    // Re-registering when the drag-relevant OPTIONS change (a ColumnWidth
    // override, or a ViewMode zoom that changes EffectiveColumnWidth/
    // PixelsPerDay) is idempotent on the JS side — see ganttV3.registerDrag's
    // own remarks — so calling it again simply updates the stored config
    // instead of attaching a second listener.
    private async Task SyncDragRegistrationAsync()
    {
        if (Readonly)
        {
            if (_dragRegistered)
            {
                _dragRegistered = false;
                _dragConfirmed = false;
                await Interop.GanttV3UnregisterDragAsync(_scrollHostRef);
            }
            return;
        }

        // Phase 2, T2 — CanDrop's null-ness is folded into the options too: a
        // runtime CanDrop change (null <-> non-null) must re-push
        // BuildDragOptions' hasCanDrop flag to JS even when ColumnWidth/
        // PixelsPerDay are unchanged, or a caller that starts/stops validating
        // drops mid-session would leave JS on a stale flag.
        // Phase 2, T3 — AllowCreate is folded in for the same reason (a runtime
        // flip must re-push allowCreate). Origin is folded in too: unlike
        // move/resize/progress (which anchor off an EXISTING bar's own
        // data-task-start/-end, never needing an absolute reference date),
        // drag-create has nothing to anchor off and needs BuildDragOptions'
        // originIso — which tracks RangeStart/ViewMode, NOT
        // EffectiveColumnWidth/PixelsPerDay, so panning via GanttNav's
        // Previous/Next (which moves RangeStart without touching ColumnWidth)
        // would otherwise leave JS computing create dates off a stale origin.
        //
        // Phase 3, T1 — GanttInteropOptions (a record) replaces a plain
        // HashCode.Combine of these same 5 fields: `==` on a record is exact
        // structural equality (no collision risk, no HashCode.Combine 8-arg
        // ceiling to run into as the Phase-3 watch-list adds more candidate
        // fields) — see GanttInteropOptions' own remarks for why this is a
        // pure representation swap, not a behavior change (same 5 fields,
        // same gate, same drag-safety story: gantt-v3.js snapshots options at
        // pointerdown regardless of when/whether a re-registration lands).
        var options = new GanttInteropOptions(EffectiveColumnWidth, PixelsPerDay, CanDrop is not null, AllowCreate, Origin, EffectiveNow.Date);
        if (_dragRegistered && options == _lastDragOptions) return;

        _selfRef ??= DotNetObjectReference.Create(this);
        _dragRegistered = true;
        _lastDragOptions = options;

        // Bug fix (Codex P2 finding, "Keep pointer clicks when drag interop
        // is unavailable"): every existing IComponentInteropService consumer
        // gets a DEFAULT no-op-safe implementation of the Gantt-specific
        // interop methods for backward compatibility — a custom
        // implementation that never overrides GanttV3RegisterDragAsync, or a
        // register call that genuinely throws, must not leave every bar's
        // native onclick suppressed forever with no delegated listener ever
        // actually attached (GanttBar's own SuppressPointerClick reads
        // _dragConfirmed below, not merely "not Readonly"). A thrown
        // exception here is swallowed (not re-thrown) — the chart degrades
        // to native-click-only rather than taking the whole render down —
        // and _dragRegistered reverts too, so a LATER render (an options
        // change, or simply the next sync) retries instead of the early
        // "already registered" return above treating this as done.
        //
        // Residual gap, accepted deliberately: this cannot distinguish "the
        // register call ran and genuinely attached a listener" from "a
        // custom interop service's inherited DEFAULT implementation silently
        // no-op'd without throwing" — IComponentInteropService's contract has
        // no confirmation return value for either case, and adding one is a
        // breaking interface change out of scope here. The exception path
        // (a register call that genuinely fails) is the concrete case this
        // fix closes.
        try
        {
            await Interop.GanttV3RegisterDragAsync(_scrollHostRef, _selfRef, BuildDragOptions(options));

            // E2E deflake — see _lastConfirmedDragOriginIso's own remarks.
            // The await above just RETURNED, so gantt-v3.js's dragRegistrations
            // entry is definitively updated to THIS options.Origin already
            // (registerDrag mutates its stored options synchronously within
            // this same call) — recording it here, unconditionally (not only
            // on the false->true _dragConfirmed transition below), is what
            // lets a LATER pan's own re-push also update the rendered
            // attribute, not just the very first registration.
            var originIso = options.Origin.ToString("yyyy-MM-dd");
            var originChanged = _lastConfirmedDragOriginIso != originIso;
            _lastConfirmedDragOriginIso = originIso;

            if (!_dragConfirmed || originChanged)
            {
                _dragConfirmed = true;
                // OnAfterRenderAsync's own await here doesn't itself trigger
                // another render — every already-rendered GanttBar's
                // SuppressPointerClick binding needs this to actually reach
                // the DOM (see RecomputeVisibleRowRange's identical pattern
                // below for the same "async completion needs its own
                // StateHasChanged" reasoning). Also covers a LATER pan's own
                // origin change, not just the initial confirm, so
                // data-gantt-v3-drag-origin actually reaches the DOM then too.
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // JSDisconnectedException (circuit torn down mid-call) included
            // deliberately, not special-cased — there is nothing left to
            // revert TO in that case either; the component is going away.
            _dragRegistered = false;
        }

        // Bug fix (Codex P2 finding, "Tear down drag registration after an
        // in-flight dispose"): _dragRegistered was set TRUE synchronously
        // above, before this await even started, so DisposeAsync (or a
        // Readonly flip on a LATER render) landing while the interop call
        // above is still in flight already sees this as "registered" and
        // fires its own unregister immediately — which can race this
        // register call's own (still in-flight) JS-side effects and lose,
        // arriving before ganttV3.registerDrag's `dragRegistrations.set`
        // ever runs. That leaves dragRegistrations holding the removed
        // element and a disposed DotNetObjectReference, reachable by later
        // pointer activity. Mirrors RegisterVerticalScrollTrackingAsync's own
        // identical race fix: explicitly await the register call (done
        // above), then re-check BOTH states this method itself branches on
        // — _disposed (DisposeAsync) and Readonly (a runtime flip) — and
        // issue one more unregister if either now disagrees, deterministically
        // closing the ordering gap DisposeAsync's/the Readonly branch's own
        // best-effort attempt can't guarantee alone.
        if (_disposed || Readonly)
        {
            try { await Interop.GanttV3UnregisterDragAsync(_scrollHostRef); }
            catch (JSDisconnectedException) { }
        }
    }

    // Design spec Phase 3, T8 — (un)registers gantt-v3.js's bar context-menu
    // channel against _scrollHostRef (the SAME delegation target
    // SyncDragRegistrationAsync uses — bars/tracks live there). Checked on
    // EVERY render (see both OnAfterRenderAsync call sites' own remarks), so a
    // runtime BarContextMenu wire/un-wire re-syncs immediately.
    //
    // Deliberately INDEPENDENT of Readonly — see BarContextMenu's own remarks
    // for why a context menu is a view action, not an edit, and must not
    // share the drag engine's "no listeners at all when Readonly" contract.
    // Idempotent per gantt-v3.js's own registerBarContextMenu (re-registering
    // just swaps the stored dotNetRef in place), so this only needs to gate
    // on "has BarContextMenu ever been set", not track any options equality
    // the way SyncDragRegistrationAsync's GanttInteropOptions does — there is
    // no options bag for this channel at all (bucket/task identity is read
    // straight off data-task-id, same as every other bar-scoped interaction).
    private async Task SyncBarContextMenuRegistrationAsync()
    {
        if (BarContextMenu is null)
        {
            if (_barContextMenuRegistered)
            {
                _barContextMenuRegistered = false;
                await Interop.GanttV3UnregisterBarContextMenuAsync(_scrollHostRef);
            }
            return;
        }

        if (_barContextMenuRegistered) return;

        _selfRef ??= DotNetObjectReference.Create(this);
        _barContextMenuRegistered = true;
        try
        {
            await Interop.GanttV3RegisterBarContextMenuAsync(_scrollHostRef, _selfRef);
        }
        catch (Exception)
        {
            // Same "degrade, don't take the render down" reasoning as
            // SyncDragRegistrationAsync's own catch — a custom
            // IComponentInteropService that never overrides this method, or a
            // register call that genuinely throws, should leave the chart
            // showing the browser's native context menu on right-click rather
            // than faulting.
            _barContextMenuRegistered = false;
        }

        if (_disposed)
        {
            try { await Interop.GanttV3UnregisterBarContextMenuAsync(_scrollHostRef); }
            catch (JSDisconnectedException) { }
        }
    }

    // Wheel-zoom (see WheelZoom's own remarks) — a FIFTH registration
    // channel, but unlike drag/context-menu/splitter/row-reorder (all
    // delegated on _scrollHostRef, this component's own always-ready row-
    // canvas ref), this one targets EffectiveScrollHost — the SAME element
    // ScrollToCenterAsync/centerOn already scroll, since the pointer's local
    // "offset from the viewport's own left edge" (offsetPx) needs THAT
    // element's real, clipped bounding rect, not the row-canvas's own
    // (which is always exactly TotalWidth wide, never clipped itself — see
    // CommitWheelZoom's own remarks). EffectiveScrollHost can be a
    // caller-supplied ElementReference that isn't ready yet (same
    // "not-yet-captured" race RegisterVerticalScrollTrackingAsync's own
    // remarks describe), so this mirrors THAT method's IsScrollHostReady
    // gate and its own _registeredScrollHostRef bookkeeping — a genuine host
    // IDENTITY change (not just "not ready -> ready") unregisters the OLD
    // element before registering the new one, closing the same leak
    // RegisterVerticalScrollTrackingAsync's own remarks close.
    private bool _wheelZoomRegistered;
    private ElementReference? _registeredWheelZoomHostRef;
    private GanttViewMode? _lastWheelZoomMode;

    private async Task SyncWheelZoomRegistrationAsync()
    {
        if (!IsScrollHostReady) return;

        if (!WheelZoom)
        {
            if (_wheelZoomRegistered)
            {
                _wheelZoomRegistered = false;
                try { await Interop.GanttV3UnregisterWheelZoomAsync(_registeredWheelZoomHostRef ?? EffectiveScrollHost); }
                catch (JSDisconnectedException) { }
            }
            return;
        }

        if (_wheelZoomRegistered && _registeredWheelZoomHostRef is { } oldHost && !oldHost.Equals(EffectiveScrollHost))
        {
            _wheelZoomRegistered = false;
            try { await Interop.GanttV3UnregisterWheelZoomAsync(oldHost); }
            catch (JSDisconnectedException) { }
        }

        // Idempotent per (host, ViewMode) — ganttV3.registerWheelZoom's own
        // Map-keyed-by-element registration additionally swaps its stored
        // options in place on a repeat call (same idempotent contract every
        // other registerX in gantt-v3.js already has), so re-registering
        // here is always safe; this check only avoids a redundant interop
        // round-trip on every otherwise-unrelated render. ZoomLevels itself
        // changing without ViewMode/WheelZoom also changing is rare enough
        // (typically set once by the consumer) that this doesn't track it
        // separately — a small, accepted looseness, not a correctness gap.
        if (_wheelZoomRegistered && _registeredWheelZoomHostRef.HasValue && _lastWheelZoomMode == ViewMode) return;

        _selfRef ??= DotNetObjectReference.Create(this);
        _wheelZoomRegistered = true;
        _registeredWheelZoomHostRef = EffectiveScrollHost;
        _lastWheelZoomMode = ViewMode;

        var options = new Dictionary<string, object?>
        {
            ["currentMode"] = ViewMode.ToString(),
            ["levels"] = GanttZoomLevelModel.Resolve(ZoomLevels).Select(l => l.ToString()).ToArray(),
        };

        try
        {
            await Interop.GanttV3RegisterWheelZoomAsync(EffectiveScrollHost, _selfRef, options);
        }
        catch (Exception)
        {
            // Same "degrade, don't take the render down" reasoning as every
            // other SyncXRegistrationAsync's own catch in this file.
            _wheelZoomRegistered = false;
        }

        if (_disposed || !WheelZoom)
        {
            try { await Interop.GanttV3UnregisterWheelZoomAsync(EffectiveScrollHost); }
            catch (JSDisconnectedException) { }
        }
    }

    // gantt-v2.js's pixelsPerDay(viewMode) (lines 727-734) ported to C# as
    // GanttScale.PixelsPerDay — "JS never re-derives" the snap config (Global
    // constraints), so this number is computed HERE and handed to JS as a
    // plain number, never recomputed from a view-mode table on the JS side.
    private double PixelsPerDay => GanttScale.PixelsPerDay(ViewMode, EffectiveColumnWidth);

    // Trim safety: see ComponentInteropService.GetModuleAsync's own comment —
    // a Dictionary (not an anonymous type) so the option bag survives a
    // trimmed publish (JSRuntime's reflection-based serializer otherwise
    // throws ConstructorContainsNullParameterNames for an anonymous type).
    //
    // Phase 3, T1 — takes the SAME GanttInteropOptions instance
    // SyncDragRegistrationAsync just compared for equality (not a fresh
    // read of EffectiveColumnWidth/PixelsPerDay/etc.), so the wire payload
    // and the re-registration gate can never observe two different values
    // for the same field within one call.
    private object BuildDragOptions(GanttInteropOptions options) => new Dictionary<string, object?>
    {
        ["columnWidth"] = options.ColumnWidth,
        ["pixelsPerDay"] = options.PixelsPerDay,
        ["resizeHandlePx"] = 6,
        // The timeline's EFFECTIVE "now" date (Codex review of the styling-hooks
        // PR, P2) — see GanttInteropOptions.NowDate's own remarks. The drag
        // engine refreshes the ghost's data-past from this, never from its own
        // new Date(), so a consumer-supplied Now (a historical/simulated
        // timeline) governs the ghost exactly as it already governs the bars.
        ["nowDate"] = options.NowDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        // Phase 2, T2 — tells gantt-v3.js whether to bother calling ValidateDrop
        // AT ALL during a move/resize drag. A plain "CanDrop is null on the C#
        // side so just always return true from ValidateDrop" would still let JS
        // invoke the JSInvokable once per snapped position for EVERY drag, which
        // is exactly the "NO ValidateDrop calls happen at all" the plan rules out
        // when no validator is configured — so the gate lives on the JS side,
        // driven by this flag, not merely as a permissive .NET return value.
        ["hasCanDrop"] = options.HasCanDrop,
        // Phase 2, T3 — gates whether gantt-v3.js's onPointerDown even LOOKS for
        // a [data-gantt-row-track] hit when no bar was hit. The row-track
        // elements themselves are also only rendered at all when this is true
        // (see the markup's own @if (AllowCreate && !Readonly) guard) — this
        // flag is defense-in-depth on top of "the elements don't even exist",
        // not the only thing stopping a stray create-drag.
        ["allowCreate"] = options.AllowCreate,
        // Phase 2, T3 — the row-canvas-space date origin (Origin below), needed
        // ONLY for drag-create: unlike move/resize/progress (which always have
        // an EXISTING bar's data-task-start/-end to anchor from), a brand-new
        // create-drag has no anchor at all, so JS needs an absolute reference
        // date to convert a snapped day-COLUMN index back into a real calendar
        // date. "JS never re-derives" (Global constraints) — Origin is computed
        // here from GanttScale.BuildDateUnits, never recalculated in JS.
        ["originIso"] = options.Origin.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        // Bug fix (Codex P2 finding "Map drag-create pixels through the
        // active calendar scale"): drag-create used pixelsPerDay's own
        // columnWidth/30-or-/365 APPROXIMATION (see PixelsPerDay's remarks —
        // deliberately v2-parity for move/resize, where it's a RELATIVE
        // shift and any drift is what v2 itself already has) to compute an
        // ABSOLUTE day-offset from Origin via addDays — for Month/Year, real
        // calendar units are NOT fixed-length, so that offset drifts (Codex's
        // own example: Jan 1 origin, the next Month COLUMN maps to day 30,
        // i.e. Jan 31, not Feb 1). Create has no v2 equivalent to stay
        // parity-faithful to, so it can and should be exact: this tells JS
        // which of GanttScale.PixelToDate's own per-unit formulas to mirror
        // (Month -> AddMonths, Year -> add to the calendar year, else ->
        // addDays as before — see gantt-v3.js's resolveCreateDate).
        ["scaleUnit"] = GanttScale.GetConfig(ViewMode).Unit.ToString(),
    };

    /// <summary>
    /// JS -&gt; .NET drag/resize commit (design spec Phase 2, T1): fired exactly
    /// ONCE, on drop, by gantt-v3.js's <c>ganttV3.registerDrag</c> pointer engine
    /// — the drag itself is entirely ghost-only in JS (ONE JSInvokable call, not
    /// one per frame — the phase-2 plan's carry-forward watch item (a)).
    /// <paramref name="mode"/> is one of <c>"move"</c>/<c>"resize-start"</c>/
    /// <c>"resize-end"</c> (see gantt-v3.js's resolveHitMode); <paramref
    /// name="newStartIso"/>/<paramref name="newEndIso"/> are "yyyy-MM-dd" (no
    /// time component), matching <see cref="GanttBar"/>'s
    /// data-task-start/-end attributes and <see cref="GanttTask"/>'s date-only
    /// contract.
    ///
    /// Looks the original task up in <see cref="EffectiveRows"/> (not the raw
    /// <see cref="Tasks"/> parameter) so a hierarchy-filtered/collapsed caller
    /// still resolves correctly — any task with an active drag is, by
    /// definition, currently rendered and therefore present there.
    ///
    /// A small defensive clamp mirrors gantt-v2.js:755's
    /// <c>if (task.end &lt; task.start) task.end = task.start;</c> (and its
    /// resize-start mirror) even though gantt-v3.js already applies the SAME
    /// clamp before ever calling this — JSInvokable is a public surface a
    /// future/buggy JS caller could still hit with an inverted range, and this
    /// costs nothing to also guard on the .NET side.
    ///
    /// Phase-end fix-round: also no-ops when <see cref="Readonly"/> is true.
    /// <see cref="SyncDragRegistrationAsync"/> unregisters the delegated
    /// pointerdown listener on a Readonly flip, but a drag ALREADY in flight at
    /// the moment of that flip has its move/up handlers living in gantt-v3.js's
    /// own per-drag closure (attached directly to the bar element, not routed
    /// through the delegated listener) — those survive the flip and still call
    /// this JSInvokable on drop. A public JSInvokable is reachable independent
    /// of whatever gated its own registration, so the guard belongs here too,
    /// not only at the JS registration call site.
    /// </summary>
    [JSInvokable]
    public async Task CommitDrag(string taskId, string mode, string newStartIso, string newEndIso)
    {
        if (Readonly) return;

        var original = FindTask(taskId);
        if (original is null) return;

        if (!DateTime.TryParseExact(newStartIso, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var newStart)) return;
        if (!DateTime.TryParseExact(newEndIso, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var newEnd)) return;

        var source = ParseSource(mode);

        if (source == GanttTaskUpdateSource.ResizeEnd && newEnd < original.Start) newEnd = original.Start;
        if (source == GanttTaskUpdateSource.ResizeStart && newStart > original.End) newStart = original.End;

        var updated = original with { Start = newStart, End = newEnd };
        if (OnTaskUpdate.HasDelegate) await OnTaskUpdate.InvokeAsync(new GanttTaskUpdate(updated, source));
    }

    /// <summary>
    /// JS -&gt; .NET drag-create commit (design spec Phase 2, T3): fired exactly
    /// ONCE, on drop, by gantt-v3.js's empty-track pointer path — a REUI-parity
    /// addition with no v2 equivalent (v2 has no drag-create at all). Builds a
    /// brand-new <see cref="GanttTask"/> (a random <see cref="Guid"/>-derived id,
    /// a localized "New task" name — same <see cref="Lumeo.Services.Localization.ILumeoLocalizer"/>
    /// family <see cref="GanttTree"/> uses for its a11y labels) and invokes the
    /// SAME <see cref="OnTaskUpdate"/> event move/resize/progress already use
    /// (Source=<see cref="GanttTaskUpdateSource.Create"/>) — <see cref="Lumeo.GanttChart"/>'s
    /// <c>HandleTaskUpdateAsync</c> is the one place that knows to APPEND rather
    /// than replace-by-id for this source, and to raise its own dedicated
    /// <c>OnTaskCreate</c> alongside it (mirroring the OnProgressChange/OnDateChange
    /// per-source branches T2 already established).
    ///
    /// <paramref name="rowKey"/> resolves against <see cref="EffectiveRows"/> via
    /// <see cref="RowKey"/> — see that method's remarks for why a row's IDENTITY
    /// (task id / group toggle key), not its list position, is what JS captured
    /// at pointerdown time. GroupLabel/ParentId inheritance (design spec: "group
    /// row key or parent task... group-header or summary row targets that
    /// group/parent, leaf row inherits THAT row's group/parent siblingship") is
    /// resolved by <see cref="ResolveCreateContext"/> — see its own remarks for
    /// the three cases and which one is genuinely ambiguous in the plan's wording.
    ///
    /// Defensively no-ops when <see cref="AllowCreate"/> is off (JS should never
    /// call this in that case — no create listeners are ever registered — but a
    /// JSInvokable is a public surface a future/buggy JS caller could still hit,
    /// same "costs nothing to also guard on the .NET side" reasoning
    /// <see cref="CommitDrag"/>'s own defensive clamp already documents) or when
    /// <paramref name="rowKey"/> doesn't resolve to any currently-rendered row.
    ///
    /// Phase-end fix-round: ALSO no-ops when <see cref="Readonly"/> is true —
    /// the original guard checked only <see cref="AllowCreate"/>, which left a
    /// chart with BOTH <c>Readonly=true</c> AND <c>AllowCreate=true</c> mutable
    /// via a direct JSInvokable call (Readonly is supposed to win over
    /// AllowCreate unconditionally, per this parameter's own remarks). Same
    /// mid-drag-flip reachability reasoning as <see cref="CommitDrag"/>'s own
    /// Readonly guard.
    /// </summary>
    [JSInvokable]
    public async Task CommitCreate(string rowKey, string startIso, string endIso)
    {
        if (Readonly || !AllowCreate) return;

        if (!DateTime.TryParseExact(startIso, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start)) return;
        if (!DateTime.TryParseExact(endIso, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var end)) return;
        if (end < start) (start, end) = (end, start); // defensive swap — JS always sends min/max already (see gantt-v3.js's startCreateDrag), same "JSInvokable is a public surface" reasoning as CommitDrag's own clamp

        GanttVisibleRow? matchedRow = null;
        foreach (var row in EffectiveRows)
        {
            if (RowKey(row) == rowKey) { matchedRow = row; break; }
        }
        if (matchedRow is null) return;

        var (groupLabel, parentId) = ResolveCreateContext(matchedRow.Value);
        var newTask = new GanttTask(Guid.NewGuid().ToString("N"), L["Gantt.NewTask"], start, end)
        {
            GroupLabel = groupLabel,
            ParentId = parentId,
        };

        if (OnTaskUpdate.HasDelegate) await OnTaskUpdate.InvokeAsync(new GanttTaskUpdate(newTask, GanttTaskUpdateSource.Create));
    }

    /// <summary>
    /// Resolves a new task's inherited <see cref="GanttTask.GroupLabel"/>/
    /// <see cref="GanttTask.ParentId"/> from the row a drag-create landed on
    /// (design spec Phase 2, T3). Three cases, per the plan's own wording:
    /// <list type="bullet">
    ///   <item><b>Group-header row</b> (<see cref="GanttRowKind.GroupHeader"/>):
    ///   "targets that group" — the new task joins the group, at root (a flat
    ///   group has no parent-task concept).</item>
    ///   <item><b>Summary row</b> (a <see cref="GanttRowKind.Task"/> row with
    ///   <see cref="GanttVisibleRow.HasChildren"/> true — a hierarchy PARENT):
    ///   "targets that... parent" — resolved here as the new task becoming that
    ///   row's CHILD (<see cref="GanttTask.ParentId"/> = the summary task's own
    ///   id), the reading that makes "create on the parent row" behave like
    ///   "add a child under this parent" rather than a no-op/sibling-of-parent.
    ///   This is the plan's genuinely ambiguous case — flagged for reviewer
    ///   sign-off, see the T3 report.</item>
    ///   <item><b>Leaf row</b> (a <see cref="GanttRowKind.Task"/> row with no
    ///   children): "inherits THAT row's group/parent siblingship" — the new
    ///   task becomes that task's SIBLING (same <see cref="GanttTask.GroupLabel"/>/
    ///   <see cref="GanttTask.ParentId"/>, not a child of it).</item>
    /// </list>
    /// </summary>
    private static (string? GroupLabel, string? ParentId) ResolveCreateContext(GanttVisibleRow row)
    {
        if (row.Kind == GanttRowKind.GroupHeader) return (row.Label, null);

        var task = row.Task!;
        return row.HasChildren
            ? (task.GroupLabel, task.Id)        // summary/hierarchy-parent row -> new task becomes ITS CHILD
            : (task.GroupLabel, task.ParentId);  // leaf row -> new task becomes THAT task's SIBLING
    }

    /// <summary>
    /// JS -&gt; .NET progress-drag commit (design spec Phase 2, T2): fired exactly
    /// ONCE, on drop, by gantt-v3.js's progress-handle pointer path — v2 parity
    /// (gantt-v2.js's <c>commitDrag</c> progress branch, lines 757-761) via a
    /// dedicated JSInvokable rather than overloading <see cref="CommitDrag"/>,
    /// since a progress edit carries an int percentage, not two ISO dates.
    /// <paramref name="progress"/> is clamped 0-100 defensively (gantt-v3.js's own
    /// <c>clampProgress</c> already does this before ever calling here — same
    /// "JSInvokable is a public surface" reasoning as <see cref="CommitDrag"/>'s
    /// own defensive clamp).
    ///
    /// Phase-end fix-round: also no-ops when <see cref="Readonly"/> is true —
    /// same mid-drag-flip reachability reasoning as <see cref="CommitDrag"/>'s
    /// own Readonly guard.
    /// </summary>
    [JSInvokable]
    public async Task CommitProgress(string taskId, int progress)
    {
        if (Readonly) return;

        var original = FindTask(taskId);
        if (original is null) return;

        var updated = original with { Progress = Math.Clamp(progress, 0, 100) };
        if (OnTaskUpdate.HasDelegate) await OnTaskUpdate.InvokeAsync(new GanttTaskUpdate(updated, GanttTaskUpdateSource.Progress));
    }

    /// <summary>
    /// JS -&gt; .NET click notification (design spec Phase 2, T2 — the v2-compat
    /// gap T1's report flagged: "v2 falls back to firing JsOnTaskClick... adding
    /// it wasn't part of this task's deliverable"). Called by gantt-v3.js's
    /// <c>onPointerUp</c> ONLY when the pointer-down/up pair never crossed
    /// <c>DRAG_THRESHOLD_PX</c> AND the resolved mode was <c>'move'</c> — mirrors
    /// gantt-v2.js:617-622 exactly: a below-threshold 'resize'/'progress'-mode
    /// mousedown is NOT a click fallback in v2 either (only 'move' has one), and
    /// v3's milestones always resolve to 'move' (T1's <c>resolveHitMode</c>), so
    /// they get click-on-no-drag for free without a separate code path — unlike
    /// v2, where milestones have their own unconditional <c>click</c> listener
    /// (gantt-v2.js:501-503) that fires even when <c>readonly</c>. v3 does NOT
    /// reproduce that asymmetry: <see cref="Readonly"/> gates the ENTIRE delegated
    /// pointerdown listener (no listeners at all — <see
    /// cref="SyncDragRegistrationAsync"/>'s own contract), so a readonly v3 chart
    /// never fires <see cref="OnTaskClick"/> for ANY bar via THIS path (milestones
    /// included) — although a bar can still be activated via keyboard/pointer
    /// straight on <see cref="GanttBar"/> itself when readonly, since GanttBar's
    /// own click/keydown handlers are unrelated to this delegated drag listener
    /// (see GanttBar's own remarks). This is a deliberate deviation from v2's
    /// (arguably accidental — v2's own readonly guard, <c>if (readonly &amp;&amp;
    /// mode !== 'click') return;</c>, is unreachable dead code for regular bars
    /// since <c>mode</c> is never literally <c>'click'</c>, so it silently blocks
    /// EVERY regular-bar mousedown including the would-be click) per-shape-of-bar
    /// asymmetry, favoring one consistent rule over replicating what looks like a
    /// v2 bug.
    ///
    /// Phase-end fix-round: the "no listeners at all" contract above is only
    /// true for a Readonly chart from the START of a drag session — a drag
    /// already in flight at the moment of a MID-drag Readonly flip has its
    /// pointerup handler living in gantt-v3.js's own per-drag closure
    /// (attached directly to the bar element), which survives the flip and
    /// still calls this JSInvokable on release. Guarded here too, same
    /// reasoning as <see cref="CommitDrag"/>'s own Readonly guard.
    /// </summary>
    [JSInvokable]
    public async Task NotifyTaskClick(string taskId)
    {
        if (Readonly) return;

        var task = FindTask(taskId);
        if (task is null) return;
        if (OnTaskClick.HasDelegate) await OnTaskClick.InvokeAsync(task);
    }

    /// <summary>
    /// JS -&gt; .NET bar right-click notification (design spec Phase 3, T8). Called
    /// by gantt-v3.js's own delegated <c>contextmenu</c> listener (<c>ganttV3.
    /// registerBarContextMenu</c>) — see its own remarks for the FULL drag-isolation
    /// contract: it never even reaches here for a bar with an active drag/pending
    /// gesture (the JS side swallows that case itself, <c>preventDefault</c> and no
    /// invocation at all), and it never competes with a drag STARTING either — a real
    /// drag only ever begins from a LEFT-button pointerdown (<c>registerDrag</c>'s own
    /// unconditional <c>e.button !== 0</c> gate), unrelated to this channel's native
    /// 'contextmenu' event entirely.
    ///
    /// Deliberately does NOT check <see cref="Readonly"/> — see <see
    /// cref="BarContextMenu"/>'s own remarks: a context menu is a view action, not an
    /// edit, and stays available on a Readonly chart by design (the caller's own menu
    /// content decides what actions to offer there, exactly like <see
    /// cref="GanttBar"/>'s tooltip/keyboard focus already do). Guards only on <see
    /// cref="BarContextMenu"/> itself being set — a defensive, "public surface, don't
    /// trust it blindly" check mirroring every other JSInvokable in this class, for the
    /// case where a caller un-wires the parameter between this channel's registration
    /// and a JS call already in flight.
    /// </summary>
    [JSInvokable]
    public void NotifyBarContextMenu(string taskId, double clientX, double clientY)
    {
        if (BarContextMenu is null) return;

        var task = FindTask(taskId);
        if (task is null) return;

        _barContextMenuTask = task;
        _barContextMenuX = clientX;
        _barContextMenuY = clientY;
        _barContextMenuOpen = true;
        StateHasChanged();
    }

    /// <summary>
    /// JS -&gt; .NET live scheduling drop validation (design spec Phase 2, T2 —
    /// the REUI <c>canDropEvent</c> analog). Called by gantt-v3.js at most once
    /// per SNAPPED position during a move/resize drag (never for a progress drag)
    /// when <see cref="CanDrop"/> is set — see <see cref="BuildDragOptions"/>'s
    /// <c>hasCanDrop</c> flag for why JS skips calling this AT ALL when it isn't.
    /// Returns <c>true</c> (permit) when <see cref="CanDrop"/> is unset (defensive
    /// — JS shouldn't be calling this at all in that case) or when
    /// <paramref name="taskId"/> doesn't resolve (same "any task with an active
    /// drag is, by definition, currently rendered" reasoning as
    /// <see cref="CommitDrag"/>'s own lookup — unreachable in a real drag).
    /// Returns <c>false</c> (reject) for an unparsable date string — unlike
    /// <see cref="CommitDrag"/>'s "no-op" for the same case, a bool-returning
    /// validator has no silent-no-op option, and rejecting an unprovable
    /// candidate position is the safer default over permitting one.
    ///
    /// Phase-end fix-round: returns <c>true</c> (never blocks, never consults
    /// <see cref="CanDrop"/>) when <see cref="Readonly"/> is true. Unlike the
    /// commit/notify JSInvokables above, permitting rather than no-opping is
    /// correct here — a readonly chart drops nothing anyway (its ghost never
    /// commits), so ValidateDrop's verdict is inert either way; returning
    /// <c>true</c> just avoids invoking a consumer's <see cref="CanDrop"/>
    /// predicate (and the invalid-ghost paint it would drive) for a drag that,
    /// by the time it started, should never have been possible in the first
    /// place under a mid-drag Readonly flip (same reachability reasoning as
    /// <see cref="CommitDrag"/>'s own guard).
    /// </summary>
    [JSInvokable]
    public bool ValidateDrop(string taskId, string mode, string startIso, string endIso)
    {
        if (Readonly) return true;
        if (CanDrop is null) return true;

        var task = FindTask(taskId);
        if (task is null) return true;

        if (!DateTime.TryParseExact(startIso, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var proposedStart)) return false;
        if (!DateTime.TryParseExact(endIso, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var proposedEnd)) return false;

        var context = new GanttScheduleDropContext(proposedStart, proposedEnd, ParseSource(mode));
        return CanDrop(task, context);
    }

    private static GanttTaskUpdateSource ParseSource(string mode) => mode switch
    {
        "resize-start" => GanttTaskUpdateSource.ResizeStart,
        "resize-end" => GanttTaskUpdateSource.ResizeEnd,
        _ => GanttTaskUpdateSource.Move,
    };

    /// <summary>
    /// JS -&gt; .NET wheel-zoom commit (see <see cref="WheelZoom"/>'s own
    /// remarks): fired by gantt-v3.js's <c>registerWheelZoom</c> ONLY when it
    /// already decided, synchronously, that this Ctrl/Cmd+wheel gesture
    /// resolves to a genuine step within the resolved zoom-level list (an
    /// exhausted zoom limit never reaches here at all — JS leaves the native
    /// event alone in that case, see <see cref="WheelZoom"/>'s remarks for
    /// why that matters). <paramref name="contentX"/> is the pointer's
    /// position in FULL logical content-space (<c>EffectiveScrollHost</c>'s
    /// own coordinate origin, i.e. including a sibling tree pane's width in
    /// GanttChart's shared-pane mode) at the moment of the gesture, still
    /// under the OLD (current, pre-switch) <see cref="ViewMode"/>/<see
    /// cref="Origin"/>/<see cref="EffectiveColumnWidth"/> — <see
    /// cref="ScrollHostLeadingOffset"/> is subtracted here to bring it back
    /// into THIS component's own timeline-relative space before resolving a
    /// date, the same subtraction <see cref="ScrollToCenterAsync"/> adds back
    /// on the way out. <see cref="GanttScale.PixelToDateContinuous"/> (not the
    /// snapping <see cref="GanttScale.PixelToDate"/> drag/resize math uses) —
    /// same "don't collapse a live pointer read to the nearest whole
    /// column" reasoning <c>GanttChart.ResolveCurrentCenterDateAsync</c>'s own
    /// remarks give for the identical choice on the toolbar/imperative
    /// recenter path. <paramref name="offsetPx"/> is the pointer's own local
    /// offset from the scroll VIEWPORT's left edge (not the content's) —
    /// forwarded straight through to <see cref="OnWheelZoomRequested"/>/
    /// <see cref="ScrollTargetOffsetOverride"/> unchanged, since it's already
    /// in the exact space <c>ganttV3.scrollToOffset</c> needs.
    /// </summary>
    [JSInvokable]
    public Task CommitWheelZoom(string modeStr, double contentX, double offsetPx)
    {
        if (!WheelZoom) return Task.CompletedTask; // JSInvokable is a public surface — don't trust a stray call blindly, same reasoning as CommitDrag's own Readonly guard
        if (!Enum.TryParse<GanttViewMode>(modeStr, out var newMode) || newMode == ViewMode) return Task.CompletedTask;

        var anchorDate = GanttScale.PixelToDateContinuous(ViewMode, Origin, contentX - ScrollHostLeadingOffset, EffectiveColumnWidth);

        // See OnWheelZoomRequested's own remarks: exactly one of the two
        // fires, never both — a richer host (GanttChart) gets the anchor, a
        // standalone timeline falls back to its own plain ViewModeChanged.
        return OnWheelZoomRequested.HasDelegate
            ? OnWheelZoomRequested.InvokeAsync((newMode, anchorDate, offsetPx))
            : ViewModeChanged.InvokeAsync(newMode);
    }

    // Shared by CommitDrag/CommitProgress/NotifyTaskClick/ValidateDrop — resolves
    // against EffectiveRows (not the raw Tasks parameter), see CommitDrag's own
    // remarks for why that's correct for a hierarchy-filtered/collapsed caller.
    //
    // Phase 3, T1 — O(1) dictionary lookup (was an O(rows) Select+FirstOrDefault
    // LINQ scan, re-walked from scratch on EVERY one of these 4 JSInvokable
    // calls). _taskIndex is rebuilt once per parameter pass (OnParametersSet,
    // below) — "alongside Rows", i.e. from the exact same EffectiveRows a
    // render just committed — rather than lazily on first use, since a
    // JSInvokable can arrive at any time BETWEEN renders (a drag commit, a
    // click) and must resolve against whatever was last actually rendered, the
    // same snapshot-timing CommitDrag's own remarks already rely on ("any task
    // with an active drag is, by definition, currently rendered").
    // ── Roving-tabindex arrow-key navigation (GanttV3's own a11y gap — the
    // engine previously had no arrow-key support at all; only Enter/Space
    // activation existed) ────────────────────────────────────────────────
    //
    // _focusedTaskId is the roving-focus "current" bar; null until a
    // keyboard interaction has actually happened. EffectiveFocusedTaskId
    // falls back to the FIRST visible task row so a single Tab always
    // reaches exactly ONE bar (never zero, and never every bar the way an
    // unconditional tabindex="0" used to) even before that.
    private string? _focusedTaskId;

    private string? EffectiveFocusedTaskId
    {
        get
        {
            if (_focusedTaskId is { } id && _taskIndex.ContainsKey(id)) return id;
            foreach (var row in EffectiveRows)
            {
                if (row.Task is not null) return row.Task.Id;
            }
            return null;
        }
    }

    // The aria-live region's own live text (see the markup's own remarks for
    // why this follows Lumeo.Sortable/Lumeo.DataGrid's existing sr-only
    // announcement convention). Replaced, never appended — aria-atomic reads
    // the WHOLE new value on each change.
    private string? _keyboardAnnouncement;

    /// <summary>
    /// Entry point for every <see cref="Lumeo.GanttBar.OnKeyNavigation"/>
    /// event — see <see cref="GanttBarKeyNavigation"/>'s own remarks for the
    /// full Shift-held/not-held split this dispatches on.
    /// </summary>
    private Task HandleBarKeyNavigationAsync(GanttBarKeyNavigation nav) =>
        nav.ShiftKey ? CommitKeyboardTimingChangeAsync(nav.Task, nav.Key) : MoveBarFocusAsync(nav.Task, nav.Key);

    /// <summary>
    /// Plain arrow (no Shift): roving focus moves to the bar in the
    /// previous/next VISIBLE row. Up and Left both mean "previous", Down and
    /// Right both mean "next" — GanttV3 rows are one-task-per-row, so there
    /// is no distinct "leftward" bar within the same row to move to; Left/
    /// Right alias Up/Down rather than being left as dead keys (the ARIA
    /// listbox authoring pattern permits this for a single-axis list).
    ///
    /// Resolved against <see cref="EffectiveRows"/> — the FULL logical row
    /// list (hierarchy-filter/collapse-aware, same source <see
    /// cref="CommitDrag"/>/<see cref="FindTask"/> already use), not just the
    /// currently-virtualized subset — so "next task" always means the next
    /// one in the list. Whether the move actually LANDS focus depends on
    /// that row being currently rendered: <see
    /// cref="Lumeo.Services.IComponentInteropService.GanttV3FocusBarAsync"/>
    /// calls a plain <c>element.focus()</c>, which the browser auto-scrolls
    /// into view for an element that's in the DOM but visually clipped — so
    /// this reaches every row inside Virtualize's own overscan buffer for
    /// free. A row far enough outside that buffer needs a scroll first
    /// (out of this feature's scope — the same limitation any virtualized
    /// list's keyboard nav has without dedicated scroll-into-view wiring; no
    /// vertical "scroll to task" primitive exists anywhere in GanttV3 today
    /// to build that on top of).
    /// </summary>
    private async Task MoveBarFocusAsync(GanttTask current, string key)
    {
        var forward = key is "ArrowDown" or "ArrowRight";
        var backward = key is "ArrowUp" or "ArrowLeft";
        if (!forward && !backward) return;

        var rows = EffectiveRows;
        var currentIndex = -1;
        for (var i = 0; i < rows.Count; i++)
        {
            if (rows[i].Task?.Id == current.Id) { currentIndex = i; break; }
        }
        if (currentIndex < 0) return;

        var step = forward ? 1 : -1;
        for (var i = currentIndex + step; i >= 0 && i < rows.Count; i += step)
        {
            if (rows[i].Task is not { } target) continue;
            _focusedTaskId = target.Id;
            StateHasChanged();
            try { await Interop.GanttV3FocusBarAsync(_scrollHostRef, target.Id); }
            catch (JSDisconnectedException) { }
            return;
        }

        // No further visible row in that direction — nothing else would
        // announce this (focus never moved, so no new aria-label is ever
        // read), unlike a successful move, where the browser's own
        // focus-change announcement of the newly-focused bar's
        // Gantt.TaskAriaLabel already covers it without a separate string.
        _keyboardAnnouncement = L["Gantt.KeyboardNoMoreTasks"];
        StateHasChanged();
    }

    /// <summary>
    /// Shift+Arrow: nudges the FOCUSED task's own schedule by one day,
    /// through the SAME <see cref="OnTaskUpdate"/> commit gate a mouse drag
    /// uses (see <see cref="CommitDrag"/>) — tagged <see
    /// cref="GanttTaskUpdateSource.Keyboard"/> so a consumer's gate can tell
    /// a keyboard nudge apart from a mouse drag with one check, the way
    /// ReUI's own <c>onEventUpdate</c> tags a keyboard-originated edit with a
    /// flat "keyboard" source (see <see cref="GanttTaskUpdateSource.Keyboard"/>'s
    /// own remarks for why this is ONE source covering both the move and
    /// resize cases below, not two/three separate keyboard-specific members).
    ///
    /// Always ONE DAY per key press, never a per-<see cref="ViewMode"/>
    /// calendar unit — mirrors <see cref="CommitDrag"/>/<c>computeSnappedDates</c>'s
    /// own move/resize math, which is ALSO always day-based regardless of
    /// ViewMode (only drag-CREATE steps by a calendar unit — see
    /// <c>BuildDragOptions</c>'s own <c>scaleUnit</c> remarks for why that
    /// case differs), so keyboard and mouse editing always agree on what one
    /// nudge means, independent of how zoomed in/out the view happens to be.
    ///
    /// Left/Right move the whole task (Start+End shift together, Source=Move
    /// shape but tagged Keyboard); Up/Down resize the End edge only (grow on
    /// Up, shrink on Down, clamped to never cross Start — mirrors
    /// <see cref="CommitDrag"/>'s own resize-end clamp). A keyboard binding
    /// for resizing the START edge is a legitimate follow-up, deliberately
    /// out of scope here: v2 itself never had ANY left-edge resize (only a
    /// single right/End handle), so covering that one edge via keyboard is a
    /// consistent, v2-parity-sized scope cut, not an arbitrary one.
    /// </summary>
    private async Task CommitKeyboardTimingChangeAsync(GanttTask task, string key)
    {
        if (Readonly) return;

        // Resolve the LIVE task — repeated Shift+Arrow presses must each
        // apply against whatever the LAST commit actually produced (once
        // OnTaskUpdate's gate gets a chance to run and, if accepted, land in
        // Tasks/EffectiveRows), not a stale closure snapshot from whenever
        // this bar first received focus.
        var original = FindTask(task.Id) ?? task;

        DateTime newStart = original.Start, newEnd = original.End;
        bool isResize;
        switch (key)
        {
            case "ArrowLeft":
                newStart = original.Start.AddDays(-1);
                newEnd = original.End.AddDays(-1);
                isResize = false;
                break;
            case "ArrowRight":
                newStart = original.Start.AddDays(1);
                newEnd = original.End.AddDays(1);
                isResize = false;
                break;
            case "ArrowUp":
                newEnd = original.End.AddDays(1);
                isResize = true;
                break;
            case "ArrowDown":
                newEnd = original.End.AddDays(-1);
                if (newEnd < original.Start) newEnd = original.Start; // mirrors CommitDrag's own resize-end clamp
                isResize = true;
                break;
            default:
                return;
        }

        var updated = original with { Start = newStart, End = newEnd };
        if (!OnTaskUpdate.HasDelegate) return; // no gate wired — nothing to commit, nothing to announce (mirrors CommitDrag's own no-delegate no-op)

        _keyboardAnnouncement = isResize
            ? L["Gantt.KeyboardTaskResized", original.Name, newEnd.ToString("MMM d, yyyy", CultureInfo.CurrentCulture)]
            : L["Gantt.KeyboardTaskMoved", original.Name,
                newStart.ToString("MMM d, yyyy", CultureInfo.CurrentCulture),
                newEnd.ToString("MMM d, yyyy", CultureInfo.CurrentCulture)];
        StateHasChanged();

        await OnTaskUpdate.InvokeAsync(new GanttTaskUpdate(updated, GanttTaskUpdateSource.Keyboard));
    }

    private GanttTask? FindTask(string taskId) =>
        _taskIndex.TryGetValue(taskId, out var task) ? task : null;

    // Phase 3, T1 — the task-index dictionary itself (see FindTask's remarks).
    // Starts as a shared empty instance so FindTask is always safe to call even
    // before the first OnParametersSet has run (unreachable in practice — no JS
    // listener exists yet at that point — but costs nothing to make provably
    // safe rather than relying on that being true).
    private Dictionary<string, GanttTask> _taskIndex = new();

    // Rebuilds _taskIndex from EffectiveRows — called once per parameter pass
    // (OnParametersSet), so it always reflects whatever Rows/Tasks a render
    // just committed, in lockstep with every other EffectiveRows-derived
    // markup this component renders (RowItems, the per-row drag-create track).
    // GroupHeader rows (Task null) are skipped, same population FindTask's old
    // LINQ scan implicitly filtered via `t is not null`.
    private void RebuildTaskIndex()
    {
        var rows = EffectiveRows;
        var index = new Dictionary<string, GanttTask>(rows.Count);
        foreach (var row in rows)
        {
            if (row.Task is not null) index[row.Task.Id] = row.Task;
        }
        _taskIndex = index;
    }

    // Phase 3, T1 — the one place _taskIndex is kept in sync with Rows/Tasks:
    // OnParametersSet runs synchronously on EVERY parameter-driven render pass
    // (including the very first, before OnInitialized's own first render), so
    // by the time any JSInvokable below could possibly be reachable (a JS
    // listener only attaches after OnAfterRenderAsync's own first pass), the
    // index already reflects the just-set parameters.
    protected override void OnParametersSet() => RebuildTaskIndex();

    public async ValueTask DisposeAsync()
    {
        // Codex round 17 review, P2 — set UNCONDITIONALLY, before anything
        // else: RegisterVerticalScrollTrackingAsync's own in-flight register
        // call checks this right after its own await (see its remarks).
        _disposed = true;

        // Phase 2, T1 — tear down the drag pointer listener too.
        if (_dragRegistered)
        {
            try { await Interop.GanttV3UnregisterDragAsync(_scrollHostRef); }
            catch (JSDisconnectedException) { }
        }

        // Design spec Phase 3, T8 — tear down the bar context-menu channel too
        // (a separate registration from the drag listener above — see its own
        // remarks).
        if (_barContextMenuRegistered)
        {
            try { await Interop.GanttV3UnregisterBarContextMenuAsync(_scrollHostRef); }
            catch (JSDisconnectedException) { }
        }

        if (_headerScrollSyncRegistered)
        {
            try { await Interop.GanttV3UnregisterHeaderScrollSyncAsync(_scrollHostRef); }
            catch (JSDisconnectedException) { }
        }
        if (_verticalScrollTrackingRegistered)
        {
            // Unregister against whichever host was ACTUALLY registered
            // (Codex round 7 review, P2 #2) — falls back to EffectiveScrollHost
            // only for the (unreachable in practice) case where the flag is
            // set but the tracked reference somehow isn't.
            try { await Interop.GanttV3UnregisterVerticalScrollTrackingAsync(_registeredScrollHostRef ?? EffectiveScrollHost); }
            catch (JSDisconnectedException) { }
        }
        if (_wheelZoomRegistered)
        {
            // Same "unregister against whichever host was ACTUALLY
            // registered" reasoning as vertical-scroll-tracking above.
            try { await Interop.GanttV3UnregisterWheelZoomAsync(_registeredWheelZoomHostRef ?? EffectiveScrollHost); }
            catch (JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }
}
