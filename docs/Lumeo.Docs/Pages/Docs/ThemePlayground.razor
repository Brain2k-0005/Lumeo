    private string _css = _presets[0].Css;
    private ThemeParseResult _result = ThemePlaygroundParser.Parse(_presets[0].Css);
    private bool _dark;
    private bool _copied;
    private string? _fruit;
    private bool _switch = true;
    private bool _check = true;
    private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);

    private string PreviewClass =>
        "rounded-xl border border-border bg-background text-foreground p-5" + (_dark ? " dark" : "");

    private string PreviewStyle
    {
        get
        {
            if (!_dark) return ThemePlaygroundParser.ToScopedStyle(_result.Light);
            // Dark = the :root values (radius, fonts, ...) overlaid with the .dark values.
            var merged = new Dictionary<string, string>(_result.Light);
            foreach (var (k, v) in _result.Dark) merged[k] = v;
            return ThemePlaygroundParser.ToScopedStyle(merged);
        }
    }

    private void OnCssInput(ChangeEventArgs e) => SetCss(e.Value?.ToString() ?? "");

    private void LoadPreset(string css) => SetCss(css);

    private void Reset() => SetCss(_presets[0].Css);

    private void SetCss(string css)
    {
        _css = css;
        _result = ThemePlaygroundParser.Parse(css);
        _copied = false;
    }

    private void OnModeChanged(string? v) { if (v != null) _dark = v == "dark"; }

    private async Task CopyOverride()
    {
        await Interop.CopyToClipboard(ThemePlaygroundParser.ToOverrideCss(_result));
        _copied = true;
    }
}
