@namespace Lumeo

@* Bug fix (feedback wave): a <div> root is invalid directly inside a <ul>
   (SidebarMenu) — see SidebarMenu's own remarks on the cascaded
   LumeoSidebarInsideMenu marker this reads to auto-detect that placement.
   #381 Codex P2: the cascade only reflects the DIRECT-child shape correctly
   (SidebarMenuItem re-cascades false for its own deeper content — see its
   own remarks); AsListItem is the explicit override for any OTHER nesting
   shape (e.g. a consumer's own wrapper inside a SidebarMenu) the cascade
   can't auto-detect, in either direction. *@
@* #381 round 10 (P2) — "Keep consumer layout classes on the menu flex item"
   (see SidebarGroupLabel's own remarks, same wrapper pattern): SidebarMenu's
   <ul> is a flex container, so the <li> — not the inner <div> — is the
   actual flex item when EffectiveInsideMenu. Class/AdditionalAttributes go
   on the <li> so order-*/self-*/hidden etc. actually affect the menu's
   layout instead of only the div's own content; unwrapped (canonical)
   placement is untouched. role="none" is this component's own fixed
   semantic marker, not consumer-configurable, so it stays on the div in
   both shapes. *@
@if (EffectiveInsideMenu)
{
    <li role="presentation" class="@Cx.Merge(Class)" @attributes="AdditionalAttributes">
        <div class="@BaseClass" role="none"></div>
    </li>
}
else
{
    <div class="@CssClass" role="none" @attributes="AdditionalAttributes"></div>
}

@code {
    /// <summary>
    /// Cascaded by <see cref="Lumeo.SidebarMenu"/> when this separator is used to break
    /// up a single menu's items into visual sub-sections. Absent (false) everywhere
    /// else — e.g. between two <see cref="Lumeo.SidebarGroup"/>s, the pattern this
    /// library's own docs demonstrate. Only correct for a DIRECT SidebarMenu child or
    /// a plain <see cref="Lumeo.SidebarMenuItem"/> descendant (which re-cascades false) —
    /// see <see cref="AsListItem"/> for any other nesting shape.
    /// </summary>
    [CascadingParameter(Name = "LumeoSidebarInsideMenu")] private bool InsideMenu { get; set; }

    /// <summary>
    /// Explicit override for whether this separator renders its <c>&lt;li role="presentation"&gt;</c>
    /// wrapper. Null (the default) defers to the cascaded <see cref="InsideMenu"/> marker, which is
    /// correct for the two shapes Lumeo itself recognizes (a direct <see cref="Lumeo.SidebarMenu"/>
    /// child, or one nested inside a <see cref="Lumeo.SidebarMenuItem"/>). Set explicitly when neither
    /// applies — e.g. a custom wrapper component of your own nested inside a SidebarMenu that should
    /// still get the &lt;li&gt; wrapper, or the reverse.
    /// </summary>
    [Parameter] public bool? AsListItem { get; set; }

    private bool EffectiveInsideMenu => AsListItem ?? InsideMenu;

    /// <summary>Additional CSS classes merged onto the root <c>div</c> element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes are splatted onto the root <c>div</c> element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // #381 round 10 — split so the wrapped shape can put Class on the <li>
    // (the actual flex item) instead of here; this is just the separator's
    // own presentational styling, no consumer Class merged in.
    private string BaseClass => "mx-3 my-2 h-px bg-border";

    // Unwrapped (canonical) placement only — there the div IS the root.
    private string CssClass => Cx.Merge(BaseClass, Class);
}
