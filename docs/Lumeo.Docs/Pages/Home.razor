@page "/"

<PageTitle>Lumeo - Blazor Components, Blocks and Motion Primitives</PageTitle>

<!-- ======================= HERO ======================= -->
@* Minimal, shadcn-scale landing: announcement pill, headline, subline, two buttons,
   one full-width live example. Nothing else. The hero's grid background and the
   one-shot BlurFade entrance are the only motion; the live example mounts through
   IdleMount off the first-paint critical path. Live demos live at /demos/saas and
   /demos/enterprise. *@
<section class="relative overflow-hidden border-b border-border/40">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--border))_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--border))_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_80%_60%_at_50%_0%,#000_60%,transparent_110%)] pointer-events-none opacity-30"></div>

    <Container MaxWidth="[1400px]" Class="relative px-4 pt-8 pb-6">

        <!-- Announcement ribbon (single slim line) -->
        <BlurFade DelayMs="0">
            <Flex Justify="center" Class="mb-6">
                <Lumeo.Link Href="docs/changelog" Class="no-underline group">
                    <Flex Inline="true" Align="center" Gap="2" Class="whitespace-nowrap rounded-full border border-border/60 bg-background/80 px-3 py-1 text-xs font-medium text-muted-foreground backdrop-blur-sm hover:border-primary/40 hover:text-foreground transition-colors">
                        <Badge Variant="Badge.BadgeVariant.Default" Class="h-4 px-1.5 text-[10px] leading-none">v5.10</Badge>
                        <Lumeo.Text As="span" Class="hidden sm:inline">IconPicker, picker sizes, DataGrid cell editing and a field report worked through</Lumeo.Text>
                        <Lumeo.Text As="span" Class="sm:hidden">New in 5.10: IconPicker</Lumeo.Text>
                        <DynamicIcon Name="ArrowRight" Class="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
                    </Flex>
                </Lumeo.Link>
            </Flex>
        </BlurFade>

        <!-- Headline, subline, CTAs -->
        <div class="text-center max-w-3xl mx-auto">
            <BlurFade DelayMs="90">
                <Heading Level="1" Class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-[-0.02em] leading-[1.05] text-foreground">
                    Own your Blazor UI.
                </Heading>
            </BlurFade>
            <BlurFade DelayMs="140">
                <Lumeo.Text Color="muted" Class="mt-4 mx-auto max-w-2xl text-base sm:text-lg leading-relaxed">
                    Composable, accessible Blazor components with thoughtful defaults. Vendor the source, theme with CSS variables, ship without lock-in.
                </Lumeo.Text>
            </BlurFade>
            <BlurFade DelayMs="190">
                <Flex Wrap="true" Justify="center" Align="center" Gap="3" Class="mt-8">
                    <Lumeo.Link Href="docs/introduction" Class="no-underline">
                        <ShimmerButton Size="Button.ButtonSize.Lg" Class="rounded-lg">
                            Get Started
                            <DynamicIcon Name="ArrowRight" Class="h-4 w-4" />
                        </ShimmerButton>
                    </Lumeo.Link>
                    <Lumeo.Link Href="components" Class="no-underline">
                        <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Lg" Class="rounded-lg">
                            View Components
                        </Button>
                    </Lumeo.Link>
                </Flex>
            </BlurFade>
        </div>
    </Container>
</section>

<!-- ======================= LIVE EXAMPLE ======================= -->
@* dashboard-01, shared with /blocks/dashboard via Shared/Blocks/Dashboard01.razor so
   both routes render the exact same live markup. IdleMount defers the mount off the
   first-paint critical path; the Skeleton placeholder matches its final box (same
   min-h and frame classes) so nothing shifts when it swaps in. *@
<section class="py-10 sm:py-14">
    <Container MaxWidth="[1400px]" Class="px-4">
        <IdleMount>
            <Placeholder>
                <Skeleton Class="min-h-[820px] w-full rounded-[var(--radius-lg)] border border-border/40" AriaLabel="Loading dashboard example" />
            </Placeholder>
            <ChildContent>
                <Dashboard01 Class="min-h-[820px] overflow-hidden rounded-[var(--radius-lg)] border border-border/40" />
            </ChildContent>
        </IdleMount>

        <Lumeo.Text Color="muted" Size="sm" Class="mt-4 text-center">
            Full applications built with Lumeo:
            <Lumeo.Link Href="demos/saas" Class="text-foreground hover:underline no-underline">Northlight</Lumeo.Link> (demos/saas)
            &middot;
            <Lumeo.Link Href="demos/enterprise" Class="text-foreground hover:underline no-underline">Meridian Ops</Lumeo.Link> (demos/enterprise)
        </Lumeo.Text>
    </Container>
</section>

