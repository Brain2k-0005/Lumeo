@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <List Bordered="true" Hoverable="true" Size="Lumeo.Size.Sm">
        <ListItem Title="Inbox" Description="12 unread">
            <Leading><DynamicIcon Name="Inbox" Class="h-4 w-4 text-muted-foreground" /></Leading>
            <Trailing><Badge Size="Lumeo.Size.Sm">12</Badge></Trailing>
        </ListItem>
        <ListItem Title="Sent">
            <Leading><DynamicIcon Name="Send" Class="h-4 w-4 text-muted-foreground" /></Leading>
        </ListItem>
        <ListItem Title="Settings">
            <Leading><DynamicIcon Name="Settings" Class="h-4 w-4 text-muted-foreground" /></Leading>
            <Trailing><DynamicIcon Name="ChevronRight" Class="h-4 w-4 text-muted-foreground" /></Trailing>
        </ListItem>
    </List>
</div>
