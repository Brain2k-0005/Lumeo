@namespace Lumeo.Docs.Shared.Showcases

@* ContextMenuContent is positioned via `position: fixed` at the click coordinates, which only
   make sense at real right-click time. Per the wave brief this shows the trigger area plus a
   static replica of the opened menu (classes lifted from ContextMenuContent/ContextMenuItem/
   ContextMenuSeparator) laid out under it in normal flow. *@
<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <Flex Class="h-10 items-center justify-center rounded-md border border-dashed border-border/60 text-xs text-muted-foreground">
            Right click here
        </Flex>
        <Stack Gap="0" Class="w-36 rounded-md border border-border/40 bg-popover p-1 text-popover-foreground shadow-lg">
            <Lumeo.Text As="span" Size="sm" Class="rounded-sm px-2 py-1.5 hover:bg-accent">Back</Lumeo.Text>
            <Lumeo.Text As="span" Size="sm" Class="rounded-sm px-2 py-1.5 hover:bg-accent">Forward</Lumeo.Text>
            <Lumeo.Text As="span" Size="sm" Class="rounded-sm px-2 py-1.5 hover:bg-accent">Reload</Lumeo.Text>
            <div class="-mx-1 my-1 h-px bg-border"></div>
            <Lumeo.Text As="span" Size="sm" Class="rounded-sm px-2 py-1.5 hover:bg-accent">Print</Lumeo.Text>
        </Stack>
    </Stack>
</div>
