@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Stack Gap="3">
        <FormField Label="Email">
            <Input Type="email" @bind-Value="_email" Placeholder="name@example.com" />
        </FormField>
        <Stack Class="relative">
            <DynamicIcon Name="Search" Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
            <Input Class="pl-9" Placeholder="Search..." />
        </Stack>
    </Stack>
</div>

@code {
    private string _email = "";
}
