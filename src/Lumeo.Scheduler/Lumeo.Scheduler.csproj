<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedPlatform>browser</SupportedPlatform>
    <!-- RootNamespace must be "Lumeo" (matching @namespace in .razor files), NOT "Lumeo.Scheduler"
         (which would be the SDK default derived from the project name). If RootNamespace
         differs from the @namespace directive, the Razor SDK source generator generates
         duplicate type definitions causing CS0101. -->
    <RootNamespace>Lumeo</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>

    <!-- NuGet Package Metadata -->
    <PackageId>Lumeo.Scheduler</PackageId>
    <!-- Version is inherited from /Directory.Build.props (lockstep with all Lumeo packages) -->
    <Title>Lumeo.Scheduler</Title>
    <Authors>nativ.sh</Authors>
    <Description>Scheduler package for Lumeo — install alongside Lumeo. A first-party Blazor calendar engine: month, week, day, N-day, agenda, resource and resource-timeline views, recurrence, time zones and drag-to-reschedule, with no third-party calendar library on the page.</Description>
    <PackageTags>blazor;components;ui;scheduler;calendar;timeline;resource;lumeo</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Brain2k-0005/Lumeo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Brain2k-0005/Lumeo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(LumeoComponentsWebVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference core for shared types: ComponentInteropService, theme primitives, etc. -->
    <ProjectReference Include="..\Lumeo\Lumeo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wave-1a Scheduler kernel (Kernel/*.cs — SchedulerDateMath, SchedulerRecurrenceExpander,
         SchedulerTimeGridLayout, SchedulerMonthLayout, SchedulerTitleFormatter) is deliberately
         `internal`, mirroring Lumeo.Gantt's GanttScale/GanttState precedent (see
         Lumeo.Gantt.csproj's own InternalsVisibleTo comment): it's an implementation detail the
         wave-1b view components (same project, not yet written) will consume directly, not a
         public contract of its own. Tests need to see the internal surface directly. -->
    <InternalsVisibleTo Include="Lumeo.Tests" />
  </ItemGroup>

</Project>
