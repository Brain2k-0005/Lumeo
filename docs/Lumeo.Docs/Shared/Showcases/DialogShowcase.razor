@namespace Lumeo.Docs.Shared.Showcases

@* DialogContent renders `position: fixed; inset-0` as a full-viewport modal backdrop — see
   AlertDialogShowcase for why this shows a static replica of the open panel (bg-background,
   shadow-lg, rounded-xl, text-lg/sm tokens lifted from DialogContent/DialogHeader/DialogTitle)
   instead of the real fixed-positioned component. *@
<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <Button Size="Button.ButtonSize.Sm" Class="w-fit">Share</Button>
        <Stack Gap="3" Class="rounded-lg border border-border/40 bg-background p-3 shadow-lg">
            <Stack Gap="1">
                <Lumeo.Text Size="sm" Weight="semibold">Share this document</Lumeo.Text>
                <Lumeo.Text Size="xs" Color="muted">Anyone with the link can view this document.</Lumeo.Text>
            </Stack>
            <Input Value="https://example.com/share/abc123" Class="h-8 text-xs" />
            <Flex Justify="end" Class="pt-2 border-t border-border/40">
                <Button Size="Button.ButtonSize.Xs">Copy Link</Button>
            </Flex>
        </Stack>
    </Stack>
</div>
