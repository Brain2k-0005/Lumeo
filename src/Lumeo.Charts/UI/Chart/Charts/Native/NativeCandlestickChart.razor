@namespace Lumeo

@* Native (first-party, non-ECharts) Candlestick chart — OHLC body+wick geometry
   on a band-scale category axis, per the charts-first-party-engine spec.
   Correctly handles open == close (zero-height body renders as a thin line,
   not a skipped/invisible candle) and doesn't assume the body has non-zero
   height. Sits ALONGSIDE the legacy ECharts CandlestickChart — that file is
   untouched. *@

<div class="lumeo-native-candlestick relative flex flex-col gap-2 @Class" style="width:@Width;height:@Height" @attributes="AdditionalAttributes">
    <div class="relative min-h-0 flex-1">
        <svg viewBox="0 0 @ViewW @ViewH" preserveAspectRatio="xMidYMid meet" class="h-full w-full" role="img" aria-label="@_a11ySummary">
            <ChartAxis Ticks="_yTicks" Orientation="ChartAxisOrientation.Left" GridStart="@_plot.X" GridEnd="@_plot.Right" AxisLinePosition="@_plot.X" />
            @((MarkupString)_xAxisMarkup)
            @for (var i = 0; i < _candles.Count; i++)
            {
                var c = _candles[i];
                var dimmed = _hoverIndex is { } hi && hi != i;
                <g opacity="@(dimmed ? "0.4" : "1")" style="transition:opacity 120ms ease;">
                    <line x1="@NativeChartShared.Fmt(c.CX)" x2="@NativeChartShared.Fmt(c.CX)" y1="@NativeChartShared.Fmt(c.YHigh)" y2="@NativeChartShared.Fmt(c.YLow)" stroke="@c.Color" stroke-width="1" />
                    <rect x="@NativeChartShared.Fmt(c.CX - c.HalfWidth)" y="@NativeChartShared.Fmt(c.YBodyTop)" width="@NativeChartShared.Fmt(c.HalfWidth * 2)" height="@NativeChartShared.Fmt(c.BodyHeight)" fill="@c.Color" rx="1">
                        <animate attributeName="height" from="0" to="@NativeChartShared.Fmt(c.BodyHeight)" dur="@(EntryDurationMs)ms" begin="@(Math.Min(i, 60) * 8)ms" fill="freeze" />
                    </rect>
                </g>
            }
            <ChartInteractionSurface PlotX="@_plot.X" PlotY="@_plot.Y" PlotWidth="@_plot.Width" PlotHeight="@_plot.Height"
                                      PointCount="@_candles.Count" AriaLabel="@_a11ySummary"
                                      OnIndexChanged="@(EventCallback.Factory.Create<int?>(this, OnIndexChanged))" />
            <ChartCrosshair Active="@(_hoverIndex.HasValue)" X="@_crosshairX" GridStart="@_plot.Y" GridEnd="@_plot.Bottom" Markers="_crosshairMarkers" />
        </svg>
        @if (ShowTooltip && _hoverIndex is { } hoverIdx && hoverIdx < _candles.Count)
        {
            <ChartTooltipHost Active="true" X="@_pointerX" Y="@_pointerY" Context="ChartTooltipContext.Empty">
                <div class="rounded-md border border-border/60 bg-popover px-2.5 py-1.5 text-xs shadow-md">
                    <div class="font-semibold text-foreground">@_candles[hoverIdx].Category</div>
                    <div class="text-muted-foreground">Open @NativeChartShared.FmtValue(_candles[hoverIdx].Open)</div>
                    <div class="text-muted-foreground">High @NativeChartShared.FmtValue(_candles[hoverIdx].High)</div>
                    <div class="text-muted-foreground">Low @NativeChartShared.FmtValue(_candles[hoverIdx].Low)</div>
                    <div class="text-muted-foreground">Close @NativeChartShared.FmtValue(_candles[hoverIdx].Close)</div>
                    <div class="@(_candles[hoverIdx].Up ? "text-[var(--color-success)]" : "text-[var(--color-destructive)]") font-medium">
                        @(_candles[hoverIdx].ChangePercent >= 0 ? "+" : "")@NativeChartShared.FmtValue(_candles[hoverIdx].ChangePercent)%
                    </div>
                </div>
            </ChartTooltipHost>
        }
        @if (ShouldShowSkeleton)
        {
            <div class="absolute inset-0 pointer-events-none">
                <ChartSkeleton Kind="@SkeletonKind" Width="100%" Height="100%" Class="!rounded-none" />
            </div>
            @if (ShowLoadingLabel)
            {
                <div role="status" aria-live="polite" class="pointer-events-none absolute top-2 right-2 rounded-[calc(var(--radius)*2)] border border-border/60 bg-background/85 px-2.5 py-1 text-xs shadow-sm">
                    @(LoadingText ?? "Loading…")
                </div>
            }
        }
    </div>
    @if (DataZoom && Categories.Count > 1)
    {
        <ChartZoomSlider Width="@ViewW" Height="18" Start="@_zoom.Start" End="@_zoom.End"
                          OnRangeChanged="@(EventCallback.Factory.Create<(double, double)>(this, OnZoomRangeChanged))" />
    }
    @if (ShowLegend)
    {
        <ChartLegend Items="_legendItems" Class="justify-center" />
    }
    @if (_a11yTable is { } table)
    {
        <table class="sr-only" aria-label="@table.Summary">
            <caption>@table.Summary</caption>
            <thead><tr>@foreach (var h in table.ColumnHeaders) { <th scope="col">@h</th> }</tr></thead>
            <tbody>
                @foreach (var row in table.Rows)
                {
                    <tr><th scope="row">@row.Header</th>@foreach (var cell in row.Cells) { <td>@cell</td> }</tr>
                }
                @if (table.TruncationNote is { } note)
                {
                    <tr><td colspan="@table.ColumnHeaders.Count">@note</td></tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    /// <summary>Category labels along the axis, one per data point.</summary>
    [Parameter] public List<string> Categories { get; set; } = new();
    /// <summary>OHLC values as <c>[open, close, low, high]</c> arrays, one entry per <see cref="Categories"/> item — same order the legacy ECharts wrapper documents.</summary>
    [Parameter] public List<double[]> Data { get; set; } = new();
    /// <summary>When true (default), renders a small up/down color-key legend.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;
    /// <summary>When true (default), shows an OHLC tooltip under the cursor on hover.</summary>
    [Parameter] public bool ShowTooltip { get; set; } = true;
    /// <summary>
    /// Up/down candle colors as a 2-entry list — <c>[0]</c> = up (close ≥ open),
    /// <c>[1]</c> = down. Defaults to <c>var(--color-success)</c> / <c>var(--color-destructive)</c>,
    /// matching the semantic tokens the rest of Lumeo uses for gain/loss — never raw hex.
    /// </summary>
    [Parameter] public List<string>? Colors { get; set; }
    /// <summary>Present for API parity with the legacy wrapper's shared color-palette parameter; candlestick only ever uses two colors (see <see cref="Colors"/>), so this has no additional effect here.</summary>
    [Parameter] public List<string>? ColorPalette { get; set; }
    /// <summary>CSS width of the chart container. Defaults to <c>100%</c>.</summary>
    [Parameter] public string Width { get; set; } = "100%";
    /// <summary>CSS height of the chart container. Defaults to <c>350px</c>.</summary>
    [Parameter] public string Height { get; set; } = "350px";
    /// <summary>Additional CSS class(es) applied to the chart's root element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Additional HTML attributes captured and forwarded to the chart's root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    /// <summary>When true, overlays a shape-aware loading skeleton on top of the chart (consumer is fetching data).</summary>
    [Parameter] public bool IsLoading { get; set; }
    /// <summary>When true (default), renders a shape-aware skeleton while <see cref="IsLoading"/> is true.</summary>
    [Parameter] public bool ShowLoadingSkeleton { get; set; } = true;
    /// <summary>Shape family for the loading skeleton. Defaults to <c>ChartSkeletonKind.Candlestick</c>.</summary>
    [Parameter] public ChartSkeletonKind SkeletonKind { get; set; } = ChartSkeletonKind.Candlestick;
    /// <summary>See <see cref="NativePieChart.SkeletonStyle"/> — only <c>Silhouette</c> is implemented natively.</summary>
    [Parameter] public ChartSkeletonStyle SkeletonStyle { get; set; } = ChartSkeletonStyle.Phantom;
    /// <summary>Inert on the native engine; kept for API parity.</summary>
    [Parameter] public int PhantomCycleMs { get; set; } = 1400;
    /// <summary>When true (default), shows a small "Loading…" pill in the top-right corner whenever <see cref="IsLoading"/> is active.</summary>
    [Parameter] public bool ShowLoadingLabel { get; set; } = true;
    /// <summary>Label rendered next to the loading pill. Defaults to "Loading…".</summary>
    [Parameter] public string? LoadingText { get; set; } = "Loading…";
    /// <summary>Present for API parity; native candlesticks don't render an additional value label (the OHLC tooltip already surfaces every value).</summary>
    [Parameter] public bool ShowDataLabels { get; set; }
    /// <summary>Present for API parity with the legacy wrapper; currently unused (see <see cref="ShowDataLabels"/>).</summary>
    [Parameter] public string LabelPosition { get; set; } = "top";
    /// <summary>Present for API parity with the legacy wrapper; currently unused (see <see cref="ShowDataLabels"/>).</summary>
    [Parameter] public string? LabelFormat { get; set; }
    /// <summary>Controls category-axis label rendering. Smart auto-rotates at higher densities; ShowAll forces all horizontal; Auto thins overlapping labels.</summary>
    [Parameter] public ChartLabelStrategy LabelStrategy { get; set; } = ChartLabelStrategy.Smart;
    /// <summary>Manual rotation override (degrees) for category-axis labels.</summary>
    [Parameter] public int? LabelRotate { get; set; }
    /// <summary>When true, adds a zoom slider so users can navigate a wide category range.</summary>
    [Parameter] public bool DataZoom { get; set; }
    /// <summary>Entrance-animation duration (ms) for each candle body's grow-in. Defaults to 350ms.</summary>
    [Parameter] public int? AnimationDuration { get; set; }
    /// <summary>See <see cref="NativePieChart.AnimationEasing"/> — accepted for API parity, currently has no effect.</summary>
    [Parameter] public string? AnimationEasing { get; set; }

    private const double ViewW = 640, ViewH = 320;
    private int EntryDurationMs => AnimationDuration ?? 350;
    private bool ShouldShowSkeleton => IsLoading && ShowLoadingSkeleton;

    private readonly ChartZoomState _zoom = new();
    private ChartPlotRect _plot;
    private List<Candle> _candles = new();
    private List<string> _visibleCategories = new();
    private List<ChartAxisTick> _yTicks = new();
    private List<ChartLegendItem> _legendItems = new();
    private int? _hoverIndex;
    private double _pointerX, _pointerY, _crosshairX;
    private List<ChartCrosshairMarker> _crosshairMarkers = new();
    private string _xAxisMarkup = string.Empty;
    private string _a11ySummary = string.Empty;
    private ChartAccessibility.ChartDataTable? _a11yTable;

    private string UpColor => Colors is { Count: > 0 } ? Colors[0] : "var(--color-success)";
    private string DownColor => Colors is { Count: > 1 } ? Colors[1] : "var(--color-destructive)";

    protected override void OnParametersSet()
    {
        _legendItems = new List<ChartLegendItem>
        {
            new("up", "Up", UpColor),
            new("down", "Down", DownColor),
        };
        Rebuild();
        BuildAccessibility();
    }

    private void Rebuild()
    {
        var margin = new ChartMargin(Top: 16, Right: 16, Bottom: 36, Left: 46);
        _plot = ChartLayout.ComputePlotRect(ViewW, ViewH, margin);

        var start = (int)Math.Round(_zoom.Start * Categories.Count);
        var end = Math.Max(start + 1, (int)Math.Round(_zoom.End * Categories.Count));
        end = Math.Min(end, Categories.Count);
        _visibleCategories = Categories.Skip(start).Take(end - start).ToList();

        var xScale = new BandScale(_visibleCategories.Count, _plot.X, _plot.Right, paddingInner: 0.35, paddingOuter: 0.15);

        var window = Data.Skip(start).Take(end - start).Where(d => d.Length >= 4).ToList();
        var lo = window.Count > 0 ? window.Min(d => d[2]) : 0;
        var hi = window.Count > 0 ? window.Max(d => d[3]) : 1;
        if (hi <= lo) hi = lo + 1;
        var pad = (hi - lo) * 0.08;
        var ticks = NiceTicks.Compute(lo - pad, hi + pad, 5);
        var yScale = new LinearScale(ticks[0], ticks[^1], _plot.Bottom, _plot.Y);
        _yTicks = ticks.Select(t => new ChartAxisTick(yScale.Scale(t), NativeChartShared.FmtValue(t))).ToList();

        _candles = new List<Candle>();
        for (var i = 0; i < _visibleCategories.Count; i++)
        {
            var globalIndex = start + i;
            if (globalIndex >= Data.Count || Data[globalIndex].Length < 4) continue;
            var d = Data[globalIndex];
            var (open, close, low, high) = (d[0], d[1], d[2], d[3]);
            var up = close >= open;
            var cx = xScale.Center(i);
            var halfWidth = Math.Min(18, xScale.Bandwidth / 2);
            var yOpen = yScale.Scale(open);
            var yClose = yScale.Scale(close);
            var bodyTop = Math.Min(yOpen, yClose);
            // Doji (open == close) is a real case: never let the body disappear —
            // a zero-height rect renders as an invisible line, so it gets a 1px
            // floor instead of being treated as "no body to draw".
            var bodyHeight = Math.Max(1, Math.Abs(yOpen - yClose));
            var changePct = open != 0 ? (close / open - 1) * 100 : 0;

            _candles.Add(new Candle(
                globalIndex, _visibleCategories[i], up ? UpColor : DownColor, cx, halfWidth,
                yScale.Scale(high), yScale.Scale(low), bodyTop, bodyHeight,
                open, high, low, close, up, changePct));
        }

        BuildXAxisMarkup(xScale);
        if (_hoverIndex is { } hv && hv >= _candles.Count) _hoverIndex = null;
    }

    private void BuildXAxisMarkup(BandScale xScale)
    {
        var (interval, rotate) = ChartLabelHelper.Resolve(LabelStrategy, _visibleCategories.Count, LabelRotate);
        var step = interval is > 0 ? interval.Value + 1 : 1;
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < _visibleCategories.Count; i++)
        {
            if (step > 1 && i % step != 0) continue;
            var x = xScale.Center(i);
            var y = _plot.Bottom + 14;
            var transform = rotate is { } r && r != 0 ? $" transform=\"rotate({r} {NativeChartShared.Fmt(x)} {NativeChartShared.Fmt(y)})\"" : string.Empty;
            var anchor = rotate is { } r2 && r2 != 0 ? (r2 < 0 ? "end" : "start") : "middle";
            sb.Append("<text x=\"").Append(NativeChartShared.Fmt(x)).Append("\" y=\"").Append(NativeChartShared.Fmt(y))
              .Append("\" fill=\"var(--color-muted-foreground)\" font-size=\"10.5\" text-anchor=\"").Append(anchor).Append('"').Append(transform).Append('>')
              .Append(System.Net.WebUtility.HtmlEncode(_visibleCategories[i])).Append("</text>");
        }
        _xAxisMarkup = sb.ToString();
    }

    private void OnIndexChanged(int? index)
    {
        _hoverIndex = index;
        if (index is { } i && i < _candles.Count)
        {
            var c = _candles[i];
            _crosshairX = c.CX;
            _pointerX = c.CX;
            _pointerY = c.YHigh;
            _crosshairMarkers = new List<ChartCrosshairMarker> { new(c.CX, (c.YHigh + c.YLow) / 2, c.Color) };
        }
        else
        {
            _crosshairMarkers = new List<ChartCrosshairMarker>();
        }
    }

    private void OnZoomRangeChanged((double Start, double End) range)
    {
        _zoom.SetRange(range.Start, range.End);
        Rebuild();
    }

    private void BuildAccessibility()
    {
        var series = new List<(string Name, IReadOnlyList<double> Values)>
        {
            ("Open", _candles.Select(c => c.Open).ToList()),
            ("High", _candles.Select(c => c.High).ToList()),
            ("Low", _candles.Select(c => c.Low).ToList()),
            ("Close", _candles.Select(c => c.Close).ToList()),
        };
        var json = NativeChartShared.BuildCartesianOptionJson("candlestick", _visibleCategories, series);
        _a11yTable = ChartAccessibility.Build(json);
        _a11ySummary = _a11yTable?.Summary ?? "Candlestick chart";
    }

    private sealed record Candle(
        int Index, string Category, string Color, double CX, double HalfWidth,
        double YHigh, double YLow, double YBodyTop, double BodyHeight,
        double Open, double High, double Low, double Close, bool Up, double ChangePercent);
}
