@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Flex Gap="2">
        <Toggle @bind-Pressed="_bold">
            <DynamicIcon Name="Bold" Class="h-4 w-4" />
        </Toggle>
        <Toggle Variant="Toggle.ToggleVariant.Outline" @bind-Pressed="_italic">
            <DynamicIcon Name="Italic" Class="h-4 w-4" />
        </Toggle>
        <Toggle @bind-Pressed="_underline">
            <DynamicIcon Name="Underline" Class="h-4 w-4" />
        </Toggle>
    </Flex>
</div>

@code {
    private bool _bold = true;
    private bool _italic;
    private bool _underline;
}
