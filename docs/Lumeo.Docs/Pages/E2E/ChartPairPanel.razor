@* Small side-by-side comparison panel used only by ChartsNative.razor
   (/e2e/charts-native) — a labeled border box around one chart instance so a
   screenshot of the page is self-explanatory about which panel is the native
   engine and which is the ECharts legacy renderer. *@

<div class="rounded-lg border border-border/40 bg-card/40 p-4 space-y-3">
    <Badge Variant="@(IsNative ? Badge.BadgeVariant.Secondary : Badge.BadgeVariant.Outline)" Size="Badge.BadgeSize.Sm">
        @Title
    </Badge>
    <div class="w-full">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsNative => Title.Contains("Native", StringComparison.OrdinalIgnoreCase);
}
