@namespace Lumeo

@if (Animation == SkeletonAnimation.Wave)
{
    <style>
        @@keyframes skeleton-wave {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
    </style>
    <div data-slot="skeleton" role="@RoleAttr" aria-busy="@AriaBusyAttr" aria-hidden="@AriaHiddenAttr" aria-label="@AriaLabelAttr"
         class="@(Cx.Merge("rounded-md bg-gradient-to-r from-primary/10 via-primary/5 to-primary/10 bg-[length:200%_100%]", Class))"
         style="animation: skeleton-wave 1.5s ease-in-out infinite"
         @attributes="AdditionalAttributes"></div>
}
else
{
    <div data-slot="skeleton" role="@RoleAttr" aria-busy="@AriaBusyAttr" aria-hidden="@AriaHiddenAttr" aria-label="@AriaLabelAttr"
         class="@(Cx.Merge(AnimationClass, "rounded-md bg-primary/10", Class))" @attributes="AdditionalAttributes"></div>
}

@inject Lumeo.Services.Localization.ILumeoLocalizer L

@code {
    /// <summary>Loading animation style: <see cref="SkeletonAnimation.Pulse"/> (default,
    /// opacity pulse), <see cref="SkeletonAnimation.Wave"/> (a shimmer sweeping across),
    /// or <see cref="SkeletonAnimation.None"/> (static placeholder).</summary>
    [Parameter] public SkeletonAnimation Animation { get; set; } = SkeletonAnimation.Pulse;
    /// <summary>
    /// Screen-reader name used ONLY when the placeholder actually announces itself (see
    /// <see cref="Announce"/>). Defaults to the localized <c>L["Skeleton.Loading"]</c>;
    /// set this (or pass <c>aria-label</c> directly) to override with a custom string.
    /// Setting this parameter — even without <see cref="Announce"/> — opts the bar into
    /// announcing, on the theory that a caller who bothered to customize the label wants
    /// it read aloud.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>
    /// When <c>true</c>, the bar announces itself to assistive tech as a single
    /// <c>role="status"</c> live region (using <see cref="AriaLabel"/>, or the localized
    /// default when unset). Default <c>false</c>: the bar is a plain, <c>aria-hidden</c>
    /// placeholder — matching shadcn's Skeleton — so a card of many bars doesn't become
    /// many competing live regions (field report #464, finding 3). A composite like
    /// <see cref="SkeletonCard"/> should announce loading once at the container level
    /// instead of setting this on every child bar.
    /// </summary>
    [Parameter] public bool Announce { get; set; }
    /// <summary>Additional CSS classes merged onto the root <c>div</c> — typically size
    /// (<c>h-4 w-32</c>) and shape utilities.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Unmatched attributes splatted onto the root <c>div</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // Explicitly customizing AriaLabel is itself an opt-in — a caller who set a specific
    // label clearly wants it announced, without also having to flip Announce.
    private bool ShouldAnnounce => Announce || !string.IsNullOrEmpty(AriaLabel);

    private string EffectiveAriaLabel => string.IsNullOrEmpty(AriaLabel) ? L["Skeleton.Loading"] : AriaLabel!;

    private string? RoleAttr => ShouldAnnounce ? "status" : null;
    private string? AriaBusyAttr => ShouldAnnounce ? "true" : null;
    private string? AriaHiddenAttr => ShouldAnnounce ? null : "true";
    private string? AriaLabelAttr => ShouldAnnounce ? EffectiveAriaLabel : null;

    private string AnimationClass => Animation switch
    {
        SkeletonAnimation.Pulse => "animate-pulse",
        SkeletonAnimation.None => "",
        _ => "animate-pulse"
    };

    public enum SkeletonAnimation { Pulse, Wave, None }
}
