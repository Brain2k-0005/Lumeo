@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <SortableList TItem="string" Items="@_items" ItemsChanged="@(v => _items = v)">
        <ItemTemplate Context="item">
            <Lumeo.Text Class="text-sm">@item</Lumeo.Text>
        </ItemTemplate>
    </SortableList>
</div>

@code {
    private List<string> _items = new() { "Design the flow", "Write the copy" };
}
