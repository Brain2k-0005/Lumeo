@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Stack Gap="4">
        <Stack Gap="1.5">
            <Flex Justify="between">
                <Lumeo.Text As="span" Size="xs" Color="muted">Uploading</Lumeo.Text>
                <Lumeo.Text As="span" Size="xs" Color="muted">60%</Lumeo.Text>
            </Flex>
            <Progress Value="60" />
        </Stack>
        <Stack Gap="1.5">
            <Flex Justify="between">
                <Lumeo.Text As="span" Size="xs" Color="muted">Storage</Lumeo.Text>
                <Lumeo.Text As="span" Size="xs" Color="muted">85%</Lumeo.Text>
            </Flex>
            <Progress Value="85" Variant="Progress.ProgressVariant.Success" />
        </Stack>
    </Stack>
</div>
