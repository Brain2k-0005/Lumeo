@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Tabs ActiveValue="account">
        <TabsList>
            <TabsTrigger Value="account">Account</TabsTrigger>
            <TabsTrigger Value="password">Password</TabsTrigger>
        </TabsList>
        <TabsContent Value="account">
            <Stack Gap="1.5" Class="rounded-md border border-border/40 p-3">
                <Lumeo.Text Size="xs" Weight="medium">Account</Lumeo.Text>
                <Lumeo.Text Size="xs" Color="muted">Make changes to your account.</Lumeo.Text>
            </Stack>
        </TabsContent>
        <TabsContent Value="password">
            <Stack Gap="1.5" Class="rounded-md border border-border/40 p-3">
                <Lumeo.Text Size="xs" Weight="medium">Password</Lumeo.Text>
                <Lumeo.Text Size="xs" Color="muted">Change your password here.</Lumeo.Text>
            </Stack>
        </TabsContent>
    </Tabs>
</div>
