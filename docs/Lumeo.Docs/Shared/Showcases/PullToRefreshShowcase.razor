@namespace Lumeo.Docs.Shared.Showcases

@* PullToRefresh reacts to a real touch/pointer drag gesture, which a static preview
   card can't meaningfully simulate. This is a faithful rendition of the component's
   own visible "engaged" state — the spinner tile pulled below the top edge — exactly
   as it renders mid-pull, without any drag wiring. *@
<div class="w-full max-w-[22rem] h-36 rounded-lg border border-border/40 overflow-hidden relative bg-background">
    <Flex Class="absolute inset-x-0 top-2 justify-center">
        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-background text-foreground shadow-md ring-1 ring-border">
            <SvgGlyph Svg="@(Lucide.RefreshCw)" class="h-4 w-4" />
        </div>
    </Flex>
    <Stack Gap="2" Class="p-3 pt-12">
        <div class="rounded-md border border-border/40 bg-muted/20 px-3 py-2 text-xs text-foreground">Item 1</div>
        <div class="rounded-md border border-border/40 bg-muted/20 px-3 py-2 text-xs text-foreground">Item 2</div>
    </Stack>
</div>
