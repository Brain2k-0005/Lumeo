@namespace Lumeo
@* shadcn's SidebarInset: the main column beside the sidebar. It is the flex-1 sibling of
   SidebarComponent inside SidebarProvider, so a page header and content stack in it. *@
<main data-slot="sidebar-inset" class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</main>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS classes, merged after the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Cx.Merge("relative flex min-w-0 w-full flex-1 flex-col bg-background", Class);
}
