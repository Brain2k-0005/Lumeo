@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Stack Gap="3">
        <Flex Gap="2">
            <Button Size="Button.ButtonSize.Sm"
                    Variant="@(_direction == Lumeo.Orientation.Vertical ? Button.ButtonVariant.Default : Button.ButtonVariant.Outline)"
                    OnClick="@(() => _direction = Lumeo.Orientation.Vertical)">Vertical</Button>
            <Button Size="Button.ButtonSize.Sm"
                    Variant="@(_direction == Lumeo.Orientation.Horizontal ? Button.ButtonVariant.Default : Button.ButtonVariant.Outline)"
                    OnClick="@(() => _direction = Lumeo.Orientation.Horizontal)">Horizontal</Button>
        </Flex>
        <Stack Direction="@_direction" Gap="2">
            <Flex Class="h-9 w-20 rounded-md bg-primary/20 items-center justify-center text-xs text-primary">Item 1</Flex>
            <Flex Class="h-9 w-20 rounded-md bg-primary/20 items-center justify-center text-xs text-primary">Item 2</Flex>
            <Flex Class="h-9 w-20 rounded-md bg-primary/20 items-center justify-center text-xs text-primary">Item 3</Flex>
        </Stack>
    </Stack>
</div>

@code {
    private Lumeo.Orientation _direction = Lumeo.Orientation.Vertical;
}
