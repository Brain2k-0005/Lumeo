@namespace Lumeo.Docs.Shared.Showcases

@* Real component end to end (fix round 1): PopConfirm wraps Popover, positioned through
   Interop.PositionFixed, and escapes the card's overflow-hidden (README rule 4). No
   exposed controlled-open param, so default closed with a real trigger; click to open. *@
<div class="w-full max-w-[22rem]">
    <Flex Class="items-center gap-3 flex-wrap">
        <PopConfirm Title="Delete this item?"
                    Description="This action cannot be undone."
                    OnConfirm="@(() => _result = "Confirmed!")"
                    OnCancel="@(() => _result = "Cancelled.")">
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm">Delete item</Button>
        </PopConfirm>
        @if (!string.IsNullOrEmpty(_result))
        {
            <Lumeo.Text Size="xs" Color="muted">@_result</Lumeo.Text>
        }
    </Flex>
</div>

@code {
    private string? _result;
}
