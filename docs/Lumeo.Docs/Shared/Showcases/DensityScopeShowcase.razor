@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Stack Gap="4">
        <Stack Gap="1">
            <Lumeo.Text Size="xs" Color="muted">Compact</Lumeo.Text>
            <DensityScope Value="Density.Compact">
                <Flex Gap="2" Wrap="true">
                    <Button>Save</Button>
                    <Button Variant="Button.ButtonVariant.Outline">Cancel</Button>
                </Flex>
            </DensityScope>
        </Stack>
        <Stack Gap="1">
            <Lumeo.Text Size="xs" Color="muted">Spacious</Lumeo.Text>
            <DensityScope Value="Density.Spacious">
                <Flex Gap="2" Wrap="true">
                    <Button>Save</Button>
                    <Button Variant="Button.ButtonVariant.Outline">Cancel</Button>
                </Flex>
            </DensityScope>
        </Stack>
    </Stack>
</div>
