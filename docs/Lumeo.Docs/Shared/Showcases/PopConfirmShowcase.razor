@namespace Lumeo.Docs.Shared.Showcases

@* PopConfirm wraps Popover (Interop.PositionFixed) — per the wave brief this shows the
   trigger plus a static replica of the confirm panel (classes lifted straight from
   PopConfirm.razor's own pop-confirm-content markup) rendered inline. *@
<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" Class="w-fit">Delete item</Button>
        <Stack Gap="3" Class="w-64 rounded-md border border-border/60 bg-popover p-3 text-popover-foreground shadow-md">
            <Stack Gap="1">
                <Lumeo.Text As="span" Size="sm" Weight="medium">Delete this item?</Lumeo.Text>
                <Lumeo.Text Size="xs" Color="muted">This action cannot be undone.</Lumeo.Text>
            </Stack>
            <Flex Justify="end" Gap="2">
                <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Xs">Cancel</Button>
                <Button Size="Button.ButtonSize.Xs">Confirm</Button>
            </Flex>
        </Stack>
    </Stack>
</div>
