@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Stack Gap="2" Class="max-w-xs">
        <InputMask @bind-Value="_phone" Mask="(###) ###-####" />
        <InputMask @bind-Value="_zip" Mask="#####" Placeholder="ZIP code" />
    </Stack>
</div>

@code {
    private string _phone = "(415) 555-0132";
    private string _zip = "";
}
