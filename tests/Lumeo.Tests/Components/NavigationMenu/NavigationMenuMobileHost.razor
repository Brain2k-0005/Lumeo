@namespace Lumeo.Tests.Components.NavigationMenu

@* Mirrors the docs demo: a Hamburger and a Mobile sheet bound to one flag, plus a
   counter that forces the owner to re-render (what a trigger hover/click does). *@
<Lumeo.NavigationMenuHamburger @bind-Open="MobileOpen" />
<Lumeo.NavigationMenuMobile @bind-Open="MobileOpen">
    <span>mobile-links</span>
</Lumeo.NavigationMenuMobile>
<span data-testid="flag">@MobileOpen</span>
<span data-testid="renders">@_renders</span>

@code {
    public bool MobileOpen { get; set; }
    private int _renders;

    public void Rerender()
    {
        _renders++;
        StateHasChanged();
    }
}
