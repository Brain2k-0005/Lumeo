<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedPlatform>browser</SupportedPlatform>
    <RootNamespace>Lumeo</RootNamespace>
    <!-- CA2255: a module initializer is exactly the right tool here — this assembly
         self-registers its export backend with the core registry the moment it loads
         (eagerly or via lazy loading), with no app-side wiring required. -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>

    <!-- Its OWN NuGet package as of 5.1. It used to be an internal helper DLL bundled
         inside Lumeo.DataGrid.nupkg, which meant ClosedXML and QuestPDF had to be declared
         as dependencies of Lumeo.DataGrid so a consumer's app would restore them - about
         1.44 MB brotli that every DataGrid consumer paid, including those who switch export
         off (#433).

         Splitting the package moves that cost to the consumers who ask for it. Nothing about
         the runtime design changes: the DLL still self-registers through the core's
         IDataGridExportBackend registry and is still lazy-loadable on WebAssembly. -->
    <IsPackable>true</IsPackable>
    <PackageId>Lumeo.DataGrid.Export</PackageId>
    <Description>Excel and PDF export for Lumeo.DataGrid. Add this package only if you need
      those formats - CSV export is built into Lumeo.DataGrid and needs nothing extra.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core supplies IDataGridExportBackend, IDataGridExportService, DataGridExportColumn. -->
    <ProjectReference Include="..\Lumeo\Lumeo.csproj" />
    <!-- Not needed to compile - the interfaces live in the core - but it is what a consumer
         means when they install this package, and it keeps them from ending up with the
         export backend and no grid to export from. -->
    <ProjectReference Include="..\Lumeo.DataGrid\Lumeo.DataGrid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumeo.Tests" />
  </ItemGroup>

</Project>
