@page "/docs/theme-playground"
@namespace Lumeo.Docs.Pages.Docs
@using Lumeo.Docs.Services
@inject Lumeo.Services.IComponentInteropService Interop

<PageTitle>Theme Playground — Lumeo</PageTitle>

<Container MaxWidth="6xl" Padding="0" Center="false">
<Stack Gap="8">

    <Stack Gap="4">
        <Heading Level="1" Size="3xl">Theme Playground</Heading>
        <Lumeo.Text Size="base" Color="muted" Leading="relaxed">
            Paste a <a class="text-primary hover:underline" href="https://tweakcn.com/editor/theme" target="_blank" rel="noopener">tweakcn</a>
            or shadcn export (<code class="rounded bg-muted px-1.5 py-0.5 text-xs font-mono">:root</code> and
            <code class="rounded bg-muted px-1.5 py-0.5 text-xs font-mono">.dark</code>) and watch Lumeo's components re-skin live.
            The variables are applied to the preview panel only, the rest of this site keeps its own theme. Everything runs in your browser.
            See <a class="text-primary hover:underline" href="docs/tweakcn">Theming with tweakcn</a> for how to ship the result.
        </Lumeo.Text>
    </Stack>

    <Grid Columns="1" Gap="6" Class="lg:grid-cols-2">

        <Stack Gap="4">
            <Flex Gap="2" Wrap="true" Align="center">
                @foreach (var p in _presets)
                {
                    var preset = p;
                    <Button Size="Button.ButtonSize.Sm" Variant="Button.ButtonVariant.Outline" OnClick="@(() => LoadPreset(preset.Css))" data-testid="@($"preset-{preset.Id}")">@preset.Name</Button>
                }
                <Button Size="Button.ButtonSize.Sm" Variant="Button.ButtonVariant.Ghost" OnClick="Reset" data-testid="reset">Reset</Button>
            </Flex>

            <Textarea Value="@_css" OnInput="@OnCssInput" rows="16" Class="font-mono text-xs" aria-label="tweakcn export" data-testid="theme-input"
                      placeholder=":root { --primary: oklch(...); ... }  .dark { ... }" />

            @if (_result.Warnings.Count > 0)
            {
                <Alert data-testid="theme-warnings">
                    <Heading Level="5" Size="sm" Weight="medium" Class="mb-1 leading-none tracking-tight">Not read by Lumeo (@_result.Warnings.Count)</Heading>
                    <ul class="list-disc list-inside space-y-1 text-xs">
                        @foreach (var w in _result.Warnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                </Alert>
            }

            <Flex Gap="2" Align="center" Wrap="true">
                <Button Size="Button.ButtonSize.Sm" OnClick="CopyOverride" Disabled="@_result.IsEmpty" data-testid="copy-override">@(_copied ? "Copied" : "Copy as Lumeo override CSS")</Button>
                <Lumeo.Text Size="xs" Color="muted">
                    @_result.Light.Count light and @_result.Dark.Count dark variables parsed.
                </Lumeo.Text>
            </Flex>
            <Lumeo.Text Size="xs" Color="muted" Leading="relaxed">
                Paste the copied block into your global stylesheet <strong class="text-foreground">after</strong> the Lumeo import and keep it
                <strong class="text-foreground">unlayered</strong>, exactly as described in
                <a class="text-primary hover:underline" href="docs/tweakcn">Theming with tweakcn</a>.
            </Lumeo.Text>
        </Stack>

        <Stack Gap="3">
            <Flex Justify="between" Align="center">
                <Heading Level="2" Size="lg">Preview</Heading>
                <ToggleGroup Type="ToggleGroup.ToggleGroupType.Single" Value="@(_dark ? "dark" : "light")" ValueChanged="@OnModeChanged" Variant="ToggleGroup.ToggleGroupVariant.Outline">
                    <ToggleGroupItem Value="light" data-testid="mode-light">Light</ToggleGroupItem>
                    <ToggleGroupItem Value="dark" data-testid="mode-dark">Dark</ToggleGroupItem>
                </ToggleGroup>
            </Flex>

            <div data-testid="theme-preview" class="@PreviewClass" style="@PreviewStyle">
                <Stack Gap="5">
                    <Flex Gap="2" Wrap="true">
                        <Button data-testid="preview-primary">Primary</Button>
                        <Button Variant="Button.ButtonVariant.Secondary">Secondary</Button>
                        <Button Variant="Button.ButtonVariant.Outline">Outline</Button>
                        <Button Variant="Button.ButtonVariant.Destructive">Destructive</Button>
                        <Button Variant="Button.ButtonVariant.Ghost">Ghost</Button>
                    </Flex>

                    <Card>
                        <Stack Gap="3" Class="p-4">
                            <Heading Level="3" Size="lg">Card title</Heading>
                            <Lumeo.Text Size="sm" Color="muted">A card with an input, a select and a few controls.</Lumeo.Text>
                            <Input placeholder="Email address" />
                            <Select @bind-Value="_fruit">
                                <SelectTrigger>
                                    <Lumeo.Text As="span" Class="@(_fruit == null ? "text-muted-foreground" : "")">@(_fruit ?? "Pick a fruit")</Lumeo.Text>
                                </SelectTrigger>
                                <SelectContent>
                                    <SelectItem Value="apple">Apple</SelectItem>
                                    <SelectItem Value="banana">Banana</SelectItem>
                                </SelectContent>
                            </Select>
                            <Flex Gap="4" Align="center" Wrap="true">
                                <Flex Gap="2" Align="center"><Switch @bind-Checked="_switch" /><Lumeo.Text Size="sm">Notifications</Lumeo.Text></Flex>
                                <Flex Gap="2" Align="center"><Checkbox @bind-Checked="_check" /><Lumeo.Text Size="sm">Accept terms</Lumeo.Text></Flex>
                            </Flex>
                            <Flex Gap="2" Wrap="true">
                                <Badge>Default</Badge>
                                <Badge Variant="Badge.BadgeVariant.Secondary">Secondary</Badge>
                                <Badge Variant="Badge.BadgeVariant.Destructive">Destructive</Badge>
                                <Badge Variant="Badge.BadgeVariant.Outline">Outline</Badge>
                            </Flex>
                        </Stack>
                    </Card>

                    <Tabs DefaultValue="a">
                        <TabsList>
                            <TabsTrigger Value="a">Account</TabsTrigger>
                            <TabsTrigger Value="b">Billing</TabsTrigger>
                        </TabsList>
                        <TabsContent Value="a"><Lumeo.Text Size="sm" Color="muted" Class="p-3">Account settings.</Lumeo.Text></TabsContent>
                        <TabsContent Value="b"><Lumeo.Text Size="sm" Color="muted" Class="p-3">Billing details.</Lumeo.Text></TabsContent>
                    </Tabs>

                    <Alert>
                        <Heading Level="5" Size="sm" Weight="medium" Class="mb-1 leading-none tracking-tight">Heads up</Heading>
                        <Lumeo.Text Size="sm" Leading="relaxed">Every colour here comes from the pasted variables.</Lumeo.Text>
                    </Alert>

                    <div class="overflow-x-auto rounded-lg border border-border">
                        <Table>
                            <TableHeader>
                                <TableRow>
                                    <TableHead>Name</TableHead>
                                    <TableHead>Status</TableHead>
                                    <TableHead>Plan</TableHead>
                                </TableRow>
                            </TableHeader>
                            <TableBody>
                                <TableRow><TableCell>Ada</TableCell><TableCell><Badge>Active</Badge></TableCell><TableCell>Pro</TableCell></TableRow>
                                <TableRow><TableCell>Linus</TableCell><TableCell><Badge Variant="Badge.BadgeVariant.Secondary">Invited</Badge></TableCell><TableCell>Free</TableCell></TableRow>
                            </TableBody>
                        </Table>
                    </div>

                    <Calendar @bind-Value="_date" />
                </Stack>
            </div>
        </Stack>
    </Grid>
</Stack>
</Container>

