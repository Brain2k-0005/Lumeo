@page "/e2e/shadcn-parity"

@*
    One element per primitive, at its DEFAULT settings, each tagged with data-probe.

    The counterpart of this page is a React app built with the shadcn CLI at its own defaults.
    Measuring the two side by side in one browser is the only way to compare DENSITY honestly:
    class names can match while the rendered box does not, and a class-level diff cannot see a
    theme token like --radius at all.
*@

<div class="p-8 flex flex-col gap-6" data-probe-root>

    <div class="flex items-center gap-3 flex-wrap">
        <Button data-probe="button-default">Default</Button>
        <Button Size="Button.ButtonSize.Sm" data-probe="button-sm">Small</Button>
        <Button Size="Button.ButtonSize.Lg" data-probe="button-lg">Large</Button>
        <Button Size="Button.ButtonSize.Icon" data-probe="button-icon">I</Button>
        <Toggle data-probe="toggle">Toggle</Toggle>
    </div>

    <div class="flex items-center gap-3 flex-wrap">
        <Input Placeholder="Input" Class="w-56" data-probe="input" />
        <Badge data-probe="badge">Gesammelt</Badge>
        <Avatar data-probe="avatar"><AvatarFallback>AB</AvatarFallback></Avatar>
        <Checkbox data-probe="checkbox" />
        <Switch data-probe="switch" />
        <Label data-probe="label">Label</Label>
    </div>

    <Textarea Placeholder="Textarea" Class="w-96" data-probe="textarea" />

    <Tabs ActiveValue="a">
        <TabsList data-probe="tabslist">
            <TabsTrigger Value="a" data-probe="tabstrigger">Reiter</TabsTrigger>
            <TabsTrigger Value="b">Zwei</TabsTrigger>
        </TabsList>
    </Tabs>

    <Alert data-probe="alert">Beschreibung</Alert>

    <Card Class="w-96" data-probe="card">
        <CardHeader data-probe="cardheader"><CardTitle>Karte</CardTitle></CardHeader>
        <CardContent data-probe="cardcontent">Inhalt</CardContent>
    </Card>

    @* A badge inside a stretching flex column - the case reported from a running app. *@
    <div class="flex flex-col w-[300px] outline outline-1 outline-neutral-400">
        <Badge data-probe="badge-in-column">Gesammelt</Badge>
    </div>

    <Table data-probe="table">
        <TableHeader>
            <TableRow>
                <TableHead data-probe="tablehead">Belegnummer</TableHead>
                <TableHead>Kunde</TableHead>
            </TableRow>
        </TableHeader>
        <TableBody>
            <TableRow data-probe="tablerow">
                <TableCell data-probe="tablecell">2403</TableCell>
                <TableCell>D650618</TableCell>
            </TableRow>
            <TableRow>
                <TableCell>2402</TableCell>
                <TableCell>D650973</TableCell>
            </TableRow>
        </TableBody>
    </Table>

</div>
