@namespace Lumeo.Docs.Shared.Showcases

@* Real component end to end (fix round 1): PopoverContent is positioned through
   Interop.PositionFixed and escapes the card's overflow-hidden like any real dropdown
   (README rule 4) — no reason to fake it. Default closed (Popover has no exposed
   controlled-open param that positions correctly before the first real click), real
   trigger, real content, click to open. *@
<div class="w-full max-w-[22rem]">
    <Popover>
        <PopoverTrigger>
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm">Open Popover</Button>
        </PopoverTrigger>
        <PopoverContent>
            <Stack Gap="4">
                <Stack Gap="2">
                    <Heading Level="4" Class="text-base font-medium leading-none">Dimensions</Heading>
                    <Lumeo.Text Size="sm" Color="muted">Set the dimensions for the layer.</Lumeo.Text>
                </Stack>
                <Grid Columns="3" Gap="4" Class="items-center">
                    <Label>Width</Label>
                    <Input Class="col-span-2 h-8" Value="100%" />
                    <Label>Height</Label>
                    <Input Class="col-span-2 h-8" Value="25px" />
                </Grid>
            </Stack>
        </PopoverContent>
    </Popover>
</div>
