@namespace Lumeo
@using Lumeo.Services
@implements IAsyncDisposable
@implements IOverlayExitCallback

@*
    Animation=Slide is now safe (rc.21 fixed the transform trap), but
    Animation=Fade or None still available for consumers who want maximum
    predictability. The Slide keyframes were updated so they end at
    `transform: none` rather than an identity-translate, which used to create
    a CSS containing-block trap that broke `position: fixed` popovers
    (Select/DatePicker/Combobox) rendered inside a Drawer.
*@

@if (Shell is not null)
{
    @* See OverlayShellMarker — host DrawerContent already painted the shell.
       Pass children through to avoid a second backdrop + panel + swipe handler. *@
    @ChildContent
}
else if (Context.IsOpen || _exiting)
{
    @* pointer-events-none wrapper + -auto on backdrop/panel: the full-viewport
       wrapper must never be a hit-target itself. A drawer panel that wedges
       mid slide-in (mobile viewport shift) previously left this invisible layer
       swallowing every tap below it — the reported "second drawer breaks and the
       first can no longer be closed" failure shape (B4 hardening). *@
    <div data-slot="drawer-content" class="fixed inset-0 pointer-events-none" style="z-index:@BackdropZ">
        @* Backdrop — theme-aware --color-overlay-backdrop token (was a hardcoded
           bg-black/80 that ignored the token, unlike Sheet/Dialog). #218. Fades
           out alongside the panel while exiting (service-opened only). *@
        <div class="@BackdropClass" style="@BackdropStyle" @onclick="HandleBackdropClick" @onmousedown:preventDefault="true"></div>
        @* @onkeydown:stopPropagation — keys handled inside this modal must not
           bubble into ancestor overlays (an Escape would cascade-close them).
           See DialogContent for the full rationale. aria-modal drops to false
           while exiting (affordances already torn down — mirrors SheetContent #185). *@
        <div id="@_contentId" class="@CssClass" style="z-index:@ContentZ" role="dialog" aria-modal="@(Context.IsOpen ? "true" : "false")" aria-labelledby="@Context.TitleId" aria-describedby="@DescribedBy" @onkeydown="HandleKeyDown" @onkeydown:stopPropagation tabindex="-1" inert="@ExitInert" @attributes="AdditionalAttributes">
            @if (ShowDragHandle)
            {
                @* #381 Codex P2 (round 2) — data-drawer-handle is the stable hook
                   components.js's gesture handlers use to identify a touch that
                   started on the visual drag handle: those touches always arm
                   dismiss regardless of the panel's scroll position (the handle
                   itself is never part of the scrollable content).

                   #381 round 6 (P2) — this element is a sibling of the child
                   content inside the SAME overflow-y-auto flex column as
                   _contentId (the scroll container the JS gesture also reads
                   scrollTop/scrollHeight from for boundary gating — it must
                   stay that element, so the fix is CSS-only, not a restructure
                   onto a separate inner scroller). Without "sticky", the
                   handle was an ordinary in-flow flex item: scrolling the
                   content scrolled the handle away with it, so a drawer with
                   content taller than the panel lost its grab handle the
                   moment the user scrolled down. "sticky top-0" pins it to the
                   scroll container's own top edge; "shrink-0" matches
                   DrawerHeader/DrawerFooter's own defensive flex-shrink guard
                   for the same overflow-y-auto flex column.

                   #381 round 7 (P2, two findings) — "touch-action: none" (via
                   the touch-none utility, the same idiom Splitter/DataGrid's
                   own drag handles already use) hands a touch starting here
                   straight to the gesture code instead of letting the browser
                   also try to interpret it as a vertical page/content scroll.
                   The background is set inline as "inherit" rather than the
                   bg-background utility: a consumer overriding the panel's
                   own background via Class (a custom color, not the default
                   token) previously left the sticky strip showing the
                   DEFAULT bg-background regardless — a visible seam against
                   the panel's real background. Inheriting the computed
                   background-color from the panel (its direct parent) keeps
                   the strip matching whatever background the panel actually
                   has, default or overridden. *@
                <div class="sticky top-0 z-10 shrink-0 touch-none pb-2" style="background-color: inherit;" data-drawer-handle="true">
                    <div class="mx-auto mt-4 h-2 w-[100px] rounded-full bg-muted"></div>
                </div>
            }
            @ChildContent
        </div>
    </div>
}

@inject IComponentInteropService Interop
@inject Microsoft.Extensions.Options.IOptions<Lumeo.Services.LumeoGestureOptions> GestureOpts
@inject Lumeo.Services.ThemeService Theme

@code {
    [CascadingParameter] public Drawer.DrawerContext Context { get; set; } = default!;
    [CascadingParameter] public OverlayShellMarker? Shell { get; set; }
    /// <summary>The panel's content, typically <see cref="DrawerHeader"/>, body content, and <see cref="DrawerFooter"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Which viewport edge the panel rests against and slides in from. Default <see cref="Lumeo.Side.Bottom"/>.</summary>
    [Parameter] public Lumeo.Side Side { get; set; } = Lumeo.Side.Bottom;

    /// <summary>The open/close transition style. Default <see cref="DrawerAnimation.Slide"/>.</summary>
    [Parameter] public DrawerAnimation Animation { get; set; } = DrawerAnimation.Slide;

    /// <summary>Disables Escape, backdrop-click and swipe dismissal; the drawer can then only be closed programmatically (or, in snap mode, settles at the lowest snap instead of closing). Default <c>false</c>.</summary>
    [Parameter] public bool PreventClose { get; set; }

    /// <summary>
    /// When <c>true</c> (default), the panel is a vertically-scrollable container
    /// so content taller than its height cap (<c>max-h-[96vh]</c>/<c>max-h-screen</c>)
    /// stays reachable. Set to <c>false</c> to keep the panel <c>overflow-visible</c>
    /// instead, if you host an absolutely-positioned overlay inside (e.g. a
    /// <c>MegaMenuPanel</c> or <c>NavigationMenuViewport</c>) that needs to extend
    /// past the panel's own bounds — <c>overflow</c> other than <c>visible</c> clips
    /// any <c>position: absolute</c> descendant regardless of its containing block,
    /// a hard CSS constraint no positioning trick inside the panel can work around.
    /// With this <c>false</c>, your own content becomes responsible for fitting the
    /// height cap or scrolling itself, since the panel no longer will.
    /// </summary>
    [Parameter] public bool ScrollableBody { get; set; } = true;

    /// <summary>
    /// vaul-style snap points: fractional resting heights in ascending order,
    /// each <c>0 &lt; f ≤ 1</c> (e.g. <c>[0.4, 0.75, 1]</c> = 40% / 75% / fully
    /// open). When set on a Top/Bottom drawer, the panel rests at one of these
    /// heights, drags between them, and dismisses when flicked/dragged below the
    /// lowest. Ignored for Left/Right (which keep plain swipe-to-dismiss). (#218)
    /// </summary>
    [Parameter] public IReadOnlyList<double>? SnapPoints { get; set; }

    /// <summary>
    /// Index into <see cref="SnapPoints"/> of the current resting snap. Two-way
    /// bindable: updates as the user drags between snaps, and setting it moves
    /// the drawer programmatically. <c>-1</c> (default) opens at the most-open
    /// (last) snap. (#218)
    /// </summary>
    [Parameter] public int ActiveSnapPoint { get; set; } = -1;

    /// <summary>Two-way callback for <see cref="ActiveSnapPoint"/>, fired as the user drags between snaps or the panel settles.</summary>
    [Parameter] public EventCallback<int> ActiveSnapPointChanged { get; set; }

    /// <summary>
    /// Panel width (Left/Right sides) or height (Top/Bottom sides). Default
    /// <see cref="DrawerSize.Default"/> keeps the original <c>max-w-sm</c> /
    /// <c>max-h-[96vh]</c> caps unchanged. Family completion of the same lever
    /// <see cref="SheetContent.Size"/> already gives <c>Sheet</c> — Drawer is Sheet's
    /// structural twin for the bottom-sheet / edge-panel shape, so it gets its own
    /// mirrored <c>DrawerSize</c> enum rather than the unified <see cref="Lumeo.Size"/>
    /// scale: <see cref="DrawerSize.Full"/> is a layout intent (the mobile-fullscreen
    /// bottom-sheet pattern on Top/Bottom), not a point on a scale — the same documented
    /// reason <c>DialogSize</c>/<c>SheetSize</c> stay outside <see cref="Lumeo.Size"/>.
    /// On Left/Right, <see cref="DrawerSize.Full"/> only lifts the width cap — the panel's
    /// own <c>w-3/4</c> base stays unaffected, mirroring <c>SheetContent.SheetSize.Full</c>'s
    /// own Left/Right precedent (documented there as NOT reaching full width, unlike
    /// Top/Bottom).
    /// </summary>
    [Parameter] public DrawerSize Size { get; set; } = DrawerSize.Default;

    /// <summary>Additional CSS classes merged onto the panel element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>When <c>true</c> (the default), closing keeps the panel mounted for
    /// a slide/fade out before unmounting instead of vanishing instantly — so a
    /// declarative drawer animates its close the same way <see cref="OverlayProvider"/>
    /// already animates service-opened ones. Set to <c>false</c> to opt OUT
    /// (immediate unmount) for tests or consumers who want an instant dismiss.
    /// Ignored in snap-point mode (the JS gesture owns the transform).</summary>
    [Parameter] public bool PlayExitAnimation { get; set; } = true;
    /// <summary>Backdrop z-index. Content sits at <c>ZIndex + 1</c>. Defaults
    /// to <see cref="OverlayService.BaseZIndex"/>; <see cref="OverlayProvider"/>
    /// supplies an incrementing value per nested overlay.</summary>
    [Parameter] public int ZIndex { get; set; } = OverlayService.BaseZIndex;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _contentId = LumeoIds.New("drawer");
    // True once we've rendered open and not yet processed the close. Drives the
    // exit animation INDEPENDENTLY of whether the open-interop finished — a dismiss
    // during the Blazor Server interop round-trip window still slides out instead of
    // vanishing (the B11 "no exit animation on real apps" regression). See
    // SheetContent for the full write-up.
    private bool _shownOpen;
    // True once the open-interop chain (scroll lock + focus trap + slide-end +
    // gesture) has run and needs tearing down on close. On Server the panel is
    // visible and dismissable before this flips true.
    private bool _interopReady;
    // Exit-animation state — see DialogContent / SheetContent. Only set when
    // PlayExitAnimation is true (service-opened drawers) and not in snap mode.
    private bool _exiting;
    private readonly DelayedDispatch _exitDispatch = new();
    // Radix-Presence parity: the real unmount is driven by the panel's own
    // animationend (attachOverlayExitEnd), which also clears the open-time inline
    // animation:none guard so the slide-out can run. _exitDispatch is the fallback.
    private DotNetObjectReference<DrawerContent>? _selfRef;
    private bool _exitWired;

    // FALLBACK window only — the real unmount is the panel's animationend
    // (OnExitAnimationEnd). Sits above the CSS duration (slide 300ms, fade 150ms)
    // so the timer never preempts a slightly-late animationend; it covers only the
    // JS-dead / lost-event case. 0 when no exit animation applies (exit opted out
    // via PlayExitAnimation=false, snap mode, or Animation=None) → immediate unmount.
    private int ExitDurationMs => (PlayExitAnimation && !UsesSnapPoints)
        ? (Animation switch { DrawerAnimation.Slide => 450, DrawerAnimation.Fade => 260, _ => 0 })
        : 0;

    // The exiting backdrop KEEPS pointer-events-auto so it goes on shielding the
    // page beneath until it unmounts — a modal backdrop must block the page until
    // it is gone (Radix keeps the overlay blocking until close completes), so a
    // fast double-click during the fade lands on the scrim, not on the page below.
    // HandleBackdropClick is already a no-op while exiting (it gates on
    // Context.IsOpen), so swallowing that click can't re-trigger a dismiss/reopen.
    // The PANEL stays pointer-events-none + inert (PointerClass / ExitInert).
    private string BackdropClass => _exiting
        ? "fixed inset-0 animate-fade-out pointer-events-auto"
        : "fixed inset-0 animate-fade-in pointer-events-auto";

    // Exit-window inertness (mirrors DropdownMenuContent). While the panel is kept
    // mounted for the slide/fade-out (Context.IsOpen == false, _exiting == true) its
    // focus trap + scroll lock + gesture are already torn down, so make the leaving
    // panel pointer-events-none + inert: no stray tap / Tab hits a closing drawer.
    // Focus was restored to the trigger by RemoveFocusTrap at close time, independent
    // of this. _exiting is never set in snap mode (ExitDurationMs == 0), so a snap-mode
    // dismiss keeps pointer-events-auto and unmounts immediately — unaffected.
    private string PointerClass => _exiting ? "pointer-events-none" : "pointer-events-auto";
    private string? ExitInert => _exiting ? "true" : null;

    // Couple the backdrop exit duration to the panel's slide duration (300ms)
    // when the Slide animation is active — identical rationale to SheetContent.
    // Snap mode is excluded (the JS gesture owns the panel transform; no CSS
    // slide-out plays, so the backdrop uses its default 0.15s fade-out).
    private string BackdropStyle => (_exiting && Animation == DrawerAnimation.Slide && !UsesSnapPoints)
        ? $"background-color:var(--color-overlay-backdrop);z-index:{BackdropZ};animation-duration:300ms"
        : $"background-color:var(--color-overlay-backdrop);z-index:{BackdropZ}";

    // Slide-animation transform trap is fixed via JS interop:
    // Interop.AttachOverlaySlideEnd registers a native animationend listener
    // that filters strictly on slide-in-from-* AND on event.target === this
    // element, then sets inline `transform: none`. See SheetContent for the
    // full rationale.

    private int BackdropZ => ZIndex;
    private int ContentZ => ZIndex + 1;

    // Only reference the description id when a <DrawerDescription> was actually
    // rendered; otherwise aria-describedby would dangle to a missing element
    // (returning null makes Blazor omit the attribute entirely). This is what
    // every service-opened Drawer (no description child) hits.
    private string? DescribedBy => Context.DescriptionRegistry.HasDescription ? Context.DescriptionId : null;

    // #381 round 10 (P2) — "Avoid disabling touch scrolling when dragging is
    // disabled": the handle renders touch-none (touch-action: none) so a
    // touch starting on it always goes to the gesture code instead of also
    // being interpreted as a native scroll/pan — but for a Top/Bottom
    // drawer with PreventClose AND no SnapPoints, RegisterGestureAsync (see
    // its own remarks) deliberately registers NO gesture at all (a
    // non-snap, non-dismissible drawer has nothing to drag). Showing the
    // handle there anyway left a dead touch region — touch-none blocked
    // native scrolling, but no listener existed to do anything else with
    // the touch either — at the top of what OnAfterRenderAsync's own
    // overflow-y-auto fix made scrollable. GestureWillBeRegistered mirrors
    // RegisterGestureAsync's own condition for "does ANY gesture actually
    // get wired up" exactly, so the handle (whose sole documented purpose
    // is being that gesture's stable DOM hook, not decoration) only renders
    // when there is a live gesture underneath it to hand the touch to.
    private bool GestureWillBeRegistered => UsesSnapPoints || !PreventClose;

    private bool ShowDragHandle => Side is Lumeo.Side.Top or Lumeo.Side.Bottom && GestureWillBeRegistered;

    // Snap points only apply to vertical drawers (vaul is vertical-only).
    private bool UsesSnapPoints => SnapPoints is { Count: > 0 } && Side is Lumeo.Side.Top or Lumeo.Side.Bottom;

    // Clamp the requested initial snap into range; -1 (default) → most-open (last).
    private int InitialSnapIndex
    {
        get
        {
            var last = (SnapPoints?.Count ?? 1) - 1;
            return (ActiveSnapPoint >= 0 && ActiveSnapPoint <= last) ? ActiveSnapPoint : last;
        }
    }

    // Last index we pushed to / received from JS, to distinguish a consumer's
    // programmatic ActiveSnapPoint change from an echo of a gesture-driven one.
    private int _appliedSnap = -1;

    // Which gesture path was actually registered on open, so cleanup and
    // programmatic updates target the right one even if SnapPoints/Side change
    // while the drawer stays open (PR #345 review).
    private bool _gestureRegistered;
    private bool _registeredWithSnap;

    // #381 round 12 (P1) — true once OnAfterRenderAsync's OWN initial
    // RegisterGestureAsync call has returned for the CURRENT open session.
    // _interopReady flips true SYNCHRONOUSLY, before LockScroll/
    // SetupFocusTrap/AttachOverlaySlideEnd/RegisterGestureAsync ever run —
    // a realistic window on Blazor Server for a parameter update to land
    // (triggering OnParametersSetAsync) while that chain is still
    // suspended. Gesture reconciliation below reads _interopReady as its
    // own "is it safe to touch the gesture yet" gate, but with only that
    // gate a reconciliation could fire (and legitimately decide "yes,
    // register") BEFORE the original chain's own RegisterGestureAsync call
    // has ever run — both call it, `registerDrawerSwipe` has no de-dupe
    // guard (unlike registerDrawerSnap, which already tears down a stale
    // registration first — see its own round-5 remarks), so the second
    // call's addEventListener calls stack a SECOND set of listeners
    // instead of replacing the first, and unregister only ever removes
    // whichever set is currently in the map. Gating reconciliation on this
    // flag too closes the window: nothing here touches the gesture until
    // the session's own first registration has actually landed.
    private bool _initialGestureSetupComplete;

    // #381 round 13 (P2) — "Defer snap baseline capture until the new side
    // renders": OnParametersSetAsync's reconciliation used to unregister +
    // re-register THE INSTANT it detected a mismatch (e.g. a Side flip),
    // which runs BEFORE Blazor commits the render containing the new
    // PositionClasses (bottom-0/top-0 etc.) — registerDrawerSnap's own
    // baseline capture (restBaseRaw) reads the CURRENT DOM via
    // getComputedStyle when there's no inline override, so it captured the
    // STILL-STALE side's classes. Reconciliation now only sets this flag +
    // returns; OnAfterRenderAsync (which runs AFTER a render commits, by
    // definition) does the actual unregister/register once the DOM the
    // baseline capture reads from is guaranteed current.
    private bool _gestureReconcilePending;

    // #381 round 13 — how many times RegisterGestureAndReconcileAsync will
    // re-check-and-retry before giving up. One correction covers the
    // realistic case (a single parameter change landing mid-registration);
    // bounded rather than unbounded so a hypothetical pathological case
    // (parameters changing on every single await) can't loop forever.
    private const int MaxGestureReconcileAttempts = 5;

    // The swipe direction + snap-point geometry baked into the live JS gesture.
    // A runtime Side/RTL flip (#76) or a same-count SnapPoints fraction change
    // (#77) doesn't trip the mode-flip gate below, so the gesture would keep the
    // OLD edge / resting offsets. We record what was actually registered and
    // re-register when it diverges. Seeded inside RegisterGestureAsync.
    private string? _registeredDirection;
    private double[]? _registeredSnapPoints;

    // Left/Right: width cap only (the w-3/4 base stays fixed regardless of Size — see the
    // Size parameter doc, mirrors SheetContent.SizeClass's own Left/Right precedent).
    // Top/Bottom: height cap. DrawerSize.Default keeps the pre-existing literal
    // "max-h-[96vh]" so a consumer who sets nothing gets byte-identical output. Full on
    // Top/Bottom hands over to "inset-y-0 h-full max-h-full"
    // (mirrors SheetContent.SheetSize.Full's own Top/Bottom branch) — MarginClass below
    // drops the mt-24 "peek" offset for that one case so the panel actually reaches both
    // viewport edges instead of the offset fighting the height override.
    private string SizeClass => Side is Lumeo.Side.Left or Lumeo.Side.Right
        ? Size switch
        {
            DrawerSize.Sm => "max-w-xs",
            DrawerSize.Lg => "max-w-lg",
            DrawerSize.Xl => "max-w-xl",
            DrawerSize.Full => "max-w-full",
            _ => "max-w-sm"
        }
        // DrawerSize.Default's own max-h-[96vh] is already a generous near-fullscreen cap
        // (the historical Drawer default, unchanged) — there is no already-shipped
        // arbitrary-vh utility between 96vh and 100vh to slot Lg/Xl into without adding a
        // NEW Tailwind utility (which would need both bundles rebuilt — see the repo's own
        // "new utility class in the DOM with no rule behind it" warning). max-h-screen /
        // max-h-full are both already in the shipped bundle (Drawer's own Left/Right arm
        // uses max-h-screen already) and read as "taller than the 96vh default, functionally
        // uncapped" — Lg/Xl/Full then differ by whether mt-24's peek offset still applies
        // (Lg/Xl keep it; only Full drops it via MarginClass, so Full is the one size that
        // actually reaches both viewport edges).
        : Size switch
        {
            DrawerSize.Sm => "max-h-[40vh]",
            DrawerSize.Lg => "max-h-screen",
            DrawerSize.Xl => "max-h-full",
            DrawerSize.Full => "inset-y-0 h-full max-h-full",
            _ => "max-h-[96vh]"
        };

    // The permanent mt-24 top offset (the "peek" gap that lets the backdrop show above a
    // Bottom drawer / below a Top drawer) fights a true Top/Bottom Full takeover, so it's
    // the one case that drops it. Every other Side/Size combination keeps mt-24 exactly as
    // before — including Left/Right at any Size, where mt-24 is unrelated to width.
    private string? MarginClass => (Side is Lumeo.Side.Top or Lumeo.Side.Bottom) && Size == DrawerSize.Full
        ? null
        : "mt-24";

    private string PositionClasses => Side switch
    {
        Lumeo.Side.Top => $"inset-x-0 top-0 rounded-b-[10px] {SizeClass}",
        Lumeo.Side.Right => $"inset-y-0 end-0 w-3/4 {SizeClass} rounded-s-[10px] h-full max-h-screen",
        Lumeo.Side.Bottom => $"inset-x-0 bottom-0 rounded-t-[10px] {SizeClass}",
        Lumeo.Side.Left => $"inset-y-0 start-0 w-3/4 {SizeClass} rounded-e-[10px] h-full max-h-screen",
        _ => $"inset-x-0 bottom-0 rounded-t-[10px] {SizeClass}"
    };

    // Snap mode: the JS gesture owns the transform (slide-in + resting offset),
    // so the CSS slide keyframe is suppressed to avoid fighting it. While exiting
    // (service-opened close) the panel slides/fades back out toward its edge.
    private string AnimationClass => UsesSnapPoints ? "" : (_exiting ? ExitAnimationClass : EnterAnimationClass);

    private string EnterAnimationClass => Animation switch
    {
        DrawerAnimation.None => "",
        DrawerAnimation.Fade => "animate-fade-in",
        DrawerAnimation.Slide => Side switch
        {
            Lumeo.Side.Top => "animate-slide-in-from-top",
            Lumeo.Side.Right => "animate-slide-in-from-right",
            Lumeo.Side.Bottom => "animate-slide-in-from-bottom",
            Lumeo.Side.Left => "animate-slide-in-from-left",
            _ => "animate-slide-in-from-bottom"
        },
        _ => ""
    };

    private string ExitAnimationClass => Animation switch
    {
        DrawerAnimation.None => "",
        DrawerAnimation.Fade => "animate-fade-out",
        DrawerAnimation.Slide => Side switch
        {
            Lumeo.Side.Top => "animate-slide-out-to-top",
            Lumeo.Side.Right => "animate-slide-out-to-right",
            Lumeo.Side.Bottom => "animate-slide-out-to-bottom",
            Lumeo.Side.Left => "animate-slide-out-to-left",
            _ => "animate-slide-out-to-bottom"
        },
        _ => ""
    };

    // Bug fix (feedback wave): the panel caps its OWN height (PositionClasses:
    // max-h-[96vh] for Top/Bottom, max-h-screen for Left/Right) but never gave
    // itself a scroll fallback. Verified with a real headless Chromium render
    // (not just reasoning about the flexbox spec): once content — an EditForm
    // with enough fields, or any sufficiently tall block content — exceeds that
    // cap, the excess simply overflows past the panel's bottom edge (the
    // browser's default overflow:visible) with NO way to scroll to it. The
    // header (first child) stays visible; everything below a certain point,
    // INCLUDING THE FOOTER/SUBMIT BUTTON, renders completely off-screen and is
    // permanently unreachable — from a user's perspective the form is simply
    // gone, which is what got reported as "the drawer collapses my form."
    // overflow-y-auto turns that same overflow into an internally-scrollable
    // panel instead, so the full form (and the footer beneath it) is always
    // reachable regardless of how tall the content grows.
    //
    // #381 Codex P2: setting ONLY overflow-y is a well-known CSS quirk (the
    // same class of quirk documented on GanttTimeline's own RootClass, just
    // the other axis here) — a browser computes the OTHER axis's overflow to
    // "auto" too the moment either axis is non-visible (verified: overflow-x
    // resolves to "auto" here even though this class list never sets it
    // explicitly), so ANY content that visually extends past the panel's
    // horizontal edges — including a focus ring drawn via box-shadow with a
    // ring-offset, which extends a few px past its own element's border box —
    // gets hard-clipped where it wasn't before. Confirmed with a real headless
    // Chromium render: a flush-edge button's ring-offset-2 ring clips on both
    // sides with no padding, fully visible with p-1.5. This is genuinely
    // Lumeo's own responsibility to guard against (this panel decides its own
    // overflow), unlike bug #4's fix (a consumer's own content). p-1.5 is a
    // baseline inset just for this — content still gets its OWN padding from
    // DrawerHeader/DrawerFooter (p-4) or whatever the consumer wraps it in;
    // this only protects RAW content placed directly, and costs a barely
    // perceptible few px more inset even where a p-4 wrapper already exists.
    // A consumer drawing their OWN focus rings can also reach for ring-inset
    // (already this library's established idiom for a ring inside a
    // scrolling/clipping context — see Image/PasswordInput/PivotGrid/
    // SwipeActions/ToolCallCard) to avoid needing any reserved inset at all.
    //
    // #381 round 12 (P2) — "Keep descendant overlays outside the scroll
    // clip": overflow-y-auto (any overflow value but visible) ALSO clips
    // position:absolute descendants whose containing block sits inside this
    // panel — e.g. MegaMenuPanel / NavigationMenuViewport, both `absolute
    // top-full` off their own trigger. This is a HARD CSS constraint, not a
    // bug in either component: unlike position:fixed (which escapes an
    // ancestor's overflow clip once that ancestor isn't its containing
    // block — the mechanism the earlier Codex round-3 popover-clipping fix
    // relies on), a position:absolute element is clipped by EVERY ancestor
    // between it and the viewport that has overflow != visible, full stop,
    // regardless of which ancestor is its actual containing block.
    // Verified empirically (Chromium/Firefox/WebKit, identical result): a
    // MegaMenuPanel-shaped absolute overlay taller than its drawer is
    // invisible past the drawer's own bounds with ScrollableBody true, and
    // renders in full with it false.
    //
    // There is consequently no single default that gives both "tall content
    // scrolls automatically" AND "an absolutely-positioned overlay anywhere
    // inside can always escape" — those are mutually exclusive under plain
    // CSS (the alternatives are DOM portaling or switching those components
    // to JS-positioned position:fixed, both changes to MegaMenuPanel/
    // NavigationMenuViewport themselves, well outside a Drawer fix). Instead
    // of guessing which a given consumer needs, ScrollableBody makes the
    // trade-off explicit: true (default, unchanged behavior) keeps content
    // taller than the height cap reachable via scrolling; false restores
    // overflow-visible so a hosted overlay can extend past the panel — at
    // the cost of the consumer's own content needing to fit the height cap,
    // or scroll itself, since the panel no longer will.
    private string CssClass =>
        Cx.Merge("fixed", MarginClass, "flex h-auto flex-col p-1.5 bg-background shadow-lg",
            ScrollableBody ? "overflow-y-auto" : "overflow-visible",
            PositionClasses, AnimationClass, PointerClass, Class);

    // A scoped <DirectionProvider> wins over the global ThemeService, so a subtree
    // can be RTL even if the app is LTR. Null when no provider wraps this drawer.
    [CascadingParameter(Name = "LumeoDirection")] private LayoutDirection? ScopedDirection { get; set; }
    private LayoutDirection EffectiveDirection => ScopedDirection ?? Theme.CurrentDirection;

    // PositionClasses use logical start/end-0 and the slide keyframes mirror under
    // [dir=rtl], so under RTL a Side.Right drawer rests on (and animates from) the
    // visual LEFT edge. The swipe direction must follow that visual edge — otherwise
    // a right-side RTL drawer only dismisses by dragging toward the page instead of
    // off its anchored edge. Top/Bottom are unaffected by direction.
    private Lumeo.Side EffectiveSide => EffectiveDirection == LayoutDirection.Rtl
        ? Side switch
        {
            Lumeo.Side.Left => Lumeo.Side.Right,
            Lumeo.Side.Right => Lumeo.Side.Left,
            var s => s,
        }
        : Side;

    private string SwipeDirection => EffectiveSide switch
    {
        Lumeo.Side.Top => "up",
        Lumeo.Side.Right => "right",
        Lumeo.Side.Bottom => "down",
        Lumeo.Side.Left => "left",
        _ => "down"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Passthrough mode — host DrawerContent owns scroll lock, focus trap, swipe.
        if (Shell is not null) return;

        if (Context.IsOpen && !_interopReady)
        {
            // Mark BEFORE the awaits so a dismiss Server-dispatched between the
            // interop round-trips hits the undo-check below exactly once.
            _interopReady = true;
            try
            {
                await Interop.LockScroll();
                await Interop.SetupFocusTrap(_contentId);
                // Same animationend cleanup as SheetContent — bypasses Blazor
                // event roundtrip + filters strictly on slide-in-from-* names.
                // Skipped in snap mode: the JS snap gesture owns the transform.
                if (!UsesSnapPoints && Animation == DrawerAnimation.Slide)
                {
                    await Interop.AttachOverlaySlideEnd(_contentId);
                }
                // #381 round 13 — RegisterGestureAndReconcileAsync (not a bare
                // RegisterGestureAsync call) so a parameter change landing
                // during THIS call's own internal interop await is caught
                // immediately too — see its own remarks.
                await RegisterGestureAndReconcileAsync();
                // #381 round 12 — see the field's own remarks: only flips once
                // THIS call has actually returned, closing the window where a
                // concurrent OnParametersSetAsync could otherwise reconcile
                // against a gesture that hasn't been registered even once yet.
                _initialGestureSetupComplete = true;
            }
            catch (JSDisconnectedException) { }

            // Dismissed while the open interop was still in flight (the Server
            // round-trip window that used to swallow the slide-out): tear the
            // just-registered handlers back down. The slide-out itself is owned by
            // OnParametersSetAsync, so it plays regardless.
            if (!Context.IsOpen)
            {
                await Cleanup();
                _interopReady = false;
                _initialGestureSetupComplete = false;
                _gestureReconcilePending = false;
            }
        }
        else if (!Context.IsOpen && _interopReady)
        {
            // Close: tear down scroll-lock / focus-trap / gesture (focus returns to
            // the trigger now). The slide-out + deferred unmount are already
            // scheduled by OnParametersSetAsync — this branch is interop teardown
            // only.
            await Cleanup();
            _interopReady = false;
            _initialGestureSetupComplete = false;
            _gestureReconcilePending = false;
        }
        else if (Context.IsOpen && _interopReady && _gestureReconcilePending)
        {
            // #381 round 13 (P2) — "Defer snap baseline capture until the new
            // side renders": runs AFTER the render OnParametersSetAsync's
            // reconciliation trigger scheduled has actually committed (this
            // method only ever runs post-render, by definition), so
            // RegisterGestureAsync's baseline capture reads the CURRENT DOM —
            // e.g. a Side flip's new top-0/bottom-0 class — not whatever was
            // there before the parameter change that triggered this.
            _gestureReconcilePending = false;
            try
            {
                await UnregisterGestureAsync();
                await RegisterGestureAndReconcileAsync();
            }
            catch (JSDisconnectedException) { }
        }

        // Radix-Presence parity: hand the unmount to the panel's OWN exit
        // animationend. attachOverlayExitEnd first strips the open-time inline
        // animation:none/transform:none guard (otherwise it overrides the
        // animate-slide-out-* class and the panel can't move — the B11 root cause),
        // then notifies OnExitAnimationEnd once the slide/fade-out finishes so the
        // backdrop + panel drop together. _exitDispatch stays armed as a fallback.
        if (_exiting && !_exitWired)
        {
            _exitWired = true;
            _selfRef ??= DotNetObjectReference.Create(this);
            try { await Interop.AttachOverlayExitEnd(_contentId, _selfRef); }
            catch (JSDisconnectedException) { }
        }
    }

    // Invoked from JS (attachOverlayExitEnd) when the panel's exit animation ends.
    [JSInvokable]
    public Task OnExitAnimationEnd() => InvokeAsync(FinishExit);

    // Ends the exit phase: cancel the fallback timer and drop backdrop + panel in
    // the same render commit. Idempotent with the fallback timer.
    private void FinishExit()
    {
        if (!_exiting) return;
        _exitDispatch.Cancel();
        _exiting = false;
        _exitWired = false;
        StateHasChanged();
    }

    // Inert during the exit phase (Context.IsOpen == false, panel only kept
    // mounted for the animation): a stray backdrop click must not re-enter dismiss.
    private Task HandleBackdropClick() => !Context.IsOpen || PreventClose ? Task.CompletedTask : Dismiss("outside");

    private Task HandleSwipe() => Dismiss("swipe");

    // Invoked from JS when a drag settles on a new snap. Mirror it into the
    // two-way ActiveSnapPoint without re-pushing to JS (it's already there).
    private async Task HandleSnapChange(int index)
    {
        _appliedSnap = index;
        if (index != ActiveSnapPoint)
        {
            await ActiveSnapPointChanged.InvokeAsync(index);
        }
    }

    // Registers the appropriate gesture for the current state and records which
    // one (so cleanup/updates target it even if SnapPoints/Side change later).
    private async Task RegisterGestureAsync()
    {
        if (UsesSnapPoints)
        {
            _appliedSnap = InitialSnapIndex;
            // dismissible: a PreventClose drawer still snaps between points but
            // never closes (the gesture settles at the lowest snap instead).
            await Interop.RegisterDrawerSnap(_contentId, SwipeDirection,
                () => Context.TryDismiss("swipe"), HandleSnapChange,
                SnapPoints!, _appliedSnap, !PreventClose,
                GestureOpts.Value.SwipeDismissThresholdPx, GestureOpts.Value.SwipeDismissFirePx, GestureOpts.Value.SwipeDismissVelocity);
            _registeredWithSnap = true;
            _registeredDirection = SwipeDirection;
            _registeredSnapPoints = SnapPoints!.ToArray();
            _gestureRegistered = true;
            if (_appliedSnap != ActiveSnapPoint) await ActiveSnapPointChanged.InvokeAsync(_appliedSnap);
        }
        else if (!PreventClose)
        {
            await Interop.RegisterDrawerSwipe(_contentId, SwipeDirection, HandleSwipe,
                GestureOpts.Value.SwipeDismissThresholdPx, GestureOpts.Value.SwipeDismissFirePx, GestureOpts.Value.SwipeDismissVelocity);
            _registeredWithSnap = false;
            _registeredDirection = SwipeDirection;
            _registeredSnapPoints = null;
            _gestureRegistered = true;
        }
    }

    private async Task UnregisterGestureAsync()
    {
        if (!_gestureRegistered) return;
        if (_registeredWithSnap) await Interop.UnregisterDrawerSnap(_contentId);
        else await Interop.UnregisterDrawerSwipe(_contentId);
        _gestureRegistered = false;
    }

    // True when the SnapPoints fractions baked into the live JS gesture still
    // match the current parameter (sequence-equal). In non-snap mode both sides
    // are null → match, so only a genuine snap-geometry edit (#77) returns false.
    private bool SnapPointsMatchRegistered()
    {
        var current = UsesSnapPoints ? SnapPoints : null;
        if (_registeredSnapPoints is null) return current is null;
        if (current is null) return false;
        return _registeredSnapPoints.SequenceEqual(current);
    }

    // #381 round 13 — the SHARED "does the live gesture still match what the
    // CURRENT parameters describe" check, extracted so OnParametersSetAsync's
    // reconciliation trigger and RegisterGestureAndReconcileAsync's own
    // post-registration self-check (below) can't drift apart into two
    // slightly-different definitions of "needs a re-register". True for: a
    // snap-mode flip; an already-live gesture's own recorded direction or
    // snap-point geometry going stale (#76/#77); or (non-snap mode only —
    // snap mode always registers regardless of PreventClose) the live
    // registration state disagreeing with what PreventClose currently implies
    // it should be (round 11/12).
    private bool GestureNeedsReconcile() =>
        _registeredWithSnap != UsesSnapPoints
        || (_gestureRegistered
            && (_registeredDirection != SwipeDirection
                || !SnapPointsMatchRegistered()))
        || (!UsesSnapPoints && _gestureRegistered != GestureWillBeRegistered);

    // #381 round 13 (P2) — "Reconcile parameters changed during gesture
    // registration": RegisterGestureAsync's own branch condition
    // (UsesSnapPoints / !PreventClose) is read ONCE, before its internal
    // interop await, and never re-checked after resuming — a parameter
    // change landing WHILE that specific await is in flight (a real Blazor
    // Server window, distinct from — and not covered by — the earlier
    // LockScroll-wait window _initialGestureSetupComplete gates) lands a
    // registration that was already stale the instant it committed, and no
    // later reconciliation catches it if nothing else changes afterward.
    // Re-validate immediately after every RegisterGestureAsync call and
    // self-correct in a bounded loop (not one extra check pinned to this
    // ONE window — closes the window in general, so a future added await
    // inside RegisterGestureAsync doesn't reopen it) rather than widening
    // the gate by yet another specific await.
    private async Task RegisterGestureAndReconcileAsync()
    {
        await RegisterGestureAsync();
        for (var i = 0; i < MaxGestureReconcileAttempts && GestureNeedsReconcile(); i++)
        {
            await UnregisterGestureAsync();
            await RegisterGestureAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Passthrough mode — the host DrawerContent owns the shell, exit animation
        // and gesture; this nested instance is a no-op for lifecycle effects.
        if (Shell is not null) return;

        // The exit animation is driven ENTIRELY here, from the open->closed render
        // transition, decoupled from the open-interop completion (the old `_wasOpen`
        // gate). On Blazor Server the open interop is a chain of round-trips; keying
        // the slide/fade-out off `_shownOpen` (flipped true the instant we first
        // render open) makes it play whenever the dismiss lands, and scheduling the
        // unmount here means the panel is never stranded mounted. Snap mode + an
        // opted-out exit (PlayExitAnimation=false) keep ExitDurationMs == 0 →
        // immediate unmount. (B11.)
        if (Context.IsOpen)
        {
            if (_exiting)
            {
                _exitDispatch.Cancel();
                _exiting = false;
                _exitWired = false;
            }
            _shownOpen = true;
        }
        else if (_shownOpen)
        {
            _shownOpen = false;
            if (ExitDurationMs > 0)
            {
                _exiting = true;
                _exitWired = false;
                _exitDispatch.Schedule(ExitDurationMs, () => InvokeAsync(FinishExit));
            }
        }

        // Below is gesture reconciliation, which only applies while the drawer is
        // actually open; skip it during the exit phase (Context.IsOpen == false,
        // panel only kept mounted for the animation — Cleanup already unwired the
        // gesture in the close branch of OnAfterRenderAsync).
        //
        // #381 round 12 (P1) — also skip until _initialGestureSetupComplete:
        // _interopReady alone flips true synchronously, before
        // OnAfterRenderAsync's own RegisterGestureAsync call has actually run.
        // A parameter update landing in that window used to let reconciliation
        // register a gesture ahead of — and then a second time duplicated by —
        // the original chain resuming; see the field's own remarks.
        if (!_interopReady || !Context.IsOpen || !_initialGestureSetupComplete) return;

        // SnapPoints/Side changed while open → the gesture mode flipped (e.g.
        // empty→populated SnapPoints); re-register so the right JS is attached.
        //
        // A same-mode change can also strand the gesture: (#76) a Side flip — or
        // an app/scoped RTL flip — leaves a non-snap gesture wired to the OLD
        // edge (UsesSnapPoints is unchanged for Left↔Right, so the mode gate above
        // never fires); (#77) editing the SnapPoints fraction values (same count,
        // still non-empty) keeps _registeredWithSnap == UsesSnapPoints, so the JS
        // would keep the stale resting geometry. Re-register whenever the live
        // gesture's recorded direction or snap-point array diverges from what the
        // current parameters describe.
        // #381 round 11 (P2) — "Reconcile the gesture before displaying its
        // handle": the two checks above only re-register when
        // _registeredWithSnap disagrees with UsesSnapPoints (a mode flip),
        // or when an ALREADY-live gesture's own recorded geometry is stale.
        // Neither ever fires for a non-snap drawer whose PreventClose flips
        // while open — UsesSnapPoints stays false on both sides, so there's
        // no mode flip, and RegisterGestureAsync's plain-swipe gate
        // (`!PreventClose`) is invisible to both checks. That left
        // GestureWillBeRegistered's PREDICTION (which ShowDragHandle relies
        // on for the handle's visibility, to avoid a flash on the interop-
        // pending first render) able to diverge from the ACTUAL
        // _gestureRegistered state: PreventClose true->false rendered the
        // handle with no listener underneath it (a touch-none dead zone —
        // this finding); PreventClose false->true left a stale swipe
        // listener that could still dismiss a now-protected drawer (the
        // mirror case). Comparing _gestureRegistered against
        // GestureWillBeRegistered's own condition directly (only meaningful
        // in non-snap mode — UsesSnapPoints always registers regardless of
        // PreventClose) keeps the prediction a maintained INVARIANT instead
        // of a guess that can silently go stale: whenever they'd disagree,
        // this makes them agree again the same way every other
        // reconciliation case here does, rather than switching the handle
        // to poll _gestureRegistered directly (which would need a
        // StateHasChanged() call threaded through OnAfterRenderAsync's own
        // registration path to avoid the handle silently never appearing
        // after the FIRST render, since mutating a field there doesn't
        // trigger a re-render on its own — a bigger, riskier change for a
        // problem this reconciliation already fully solves).
        //
        // #381 round 13 (P2) — "Defer snap baseline capture until the new
        // side renders": this used to unregister + re-register RIGHT HERE,
        // synchronously, which runs BEFORE Blazor commits the render
        // containing whatever CSS the parameter change implies (e.g. a Side
        // flip's new top-0/bottom-0 PositionClasses) — registerDrawerSnap's
        // baseline capture reads the CURRENT DOM via getComputedStyle when
        // there's no inline override, so it captured the STALE side's
        // classes, and settleAtRest later wrote that stale value inline
        // over the new class, visibly misplacing the drawer. Setting the
        // flag and returning defers the actual work to OnAfterRenderAsync
        // (see its own remarks) — which, running after a render commits by
        // definition, always sees the current DOM.
        if (GestureNeedsReconcile())
        {
            _gestureReconcilePending = true;
            return;
        }

        // Consumer moved the drawer programmatically (set ActiveSnapPoint to a
        // new in-range index that didn't originate from a gesture) → push to JS.
        if (_registeredWithSnap && SnapPoints is not null
            && ActiveSnapPoint >= 0 && ActiveSnapPoint < SnapPoints.Count
            && ActiveSnapPoint != _appliedSnap)
        {
            _appliedSnap = ActiveSnapPoint;
            await Interop.SetDrawerSnap(_contentId, ActiveSnapPoint);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && Context.IsOpen && !PreventClose) await Dismiss("escape");
    }

    private Task Dismiss(string reason) => Context.TryDismiss(reason);

    private async Task Cleanup()
    {
        try
        {
            await UnregisterGestureAsync();
            await Interop.RemoveFocusTrap(_contentId);
            await Interop.UnlockScroll();
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _exitDispatch.Dispose();
        _selfRef?.Dispose();
        if (_interopReady) await Cleanup();
    }

    public enum DrawerAnimation { Slide, Fade, None }

    /// <summary>Drawer sizes. Mirrors <see cref="SheetContent.SheetSize"/>'s shape — <c>Full</c>
    /// is layout-intent (entire viewport on Top/Bottom), not a scale value, so this enum is
    /// intentionally NOT replaced by <see cref="Lumeo.Size"/>.</summary>
    public enum DrawerSize { Sm, Default, Lg, Xl, Full }
}
