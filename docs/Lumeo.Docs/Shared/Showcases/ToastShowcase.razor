@namespace Lumeo.Docs.Shared.Showcases
@using Lumeo.Services

@* Two stacked toasts, composed from the real Toast/ToastTitle/ToastDescription/ToastClose
   primitives directly (no ToastService/ToastProvider) — Toast has no JS interop of its own
   (its entrance animation is cleared by a local C# timer, not a JS callback), so it renders
   deterministically standalone. *@
<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <Toast Variant="ToastVariant.Success">
            <Stack Gap="0.5" Class="flex-1">
                <ToastTitle>Changes saved</ToastTitle>
                <ToastDescription>Your profile has been updated.</ToastDescription>
            </Stack>
            <ToastClose />
        </Toast>
        <Toast>
            <Stack Gap="0.5" Class="flex-1">
                <ToastTitle>New message</ToastTitle>
                <ToastDescription>You have 3 unread messages.</ToastDescription>
            </Stack>
            <ToastClose />
        </Toast>
    </Stack>
</div>
