@namespace Lumeo

@* Apply and discard: fused to the input as icon buttons, or as a footer row. Only an editor
   amending a rule shows them; a rule being built commits through the flow itself. *@
@if (Fused)
{
    <button type="button" class="@Cx.Merge(ButtonClass, Class)" aria-label="@Context.Labels.Apply" @attributes="AdditionalAttributes" @onclick="() => Context.Commit()">
        <SvgGlyph Svg="@(LumeoIcons.Check)" class="h-4 w-4" />
    </button>
    <button type="button" class="@Cx.Merge(ButtonClass, Class)" aria-label="@Context.Labels.Discard" @attributes="AdditionalAttributes" @onclick="() => Context.Cancel()">
        <SvgGlyph Svg="@(LumeoIcons.X)" class="h-4 w-4" />
    </button>
}
else
{
    <div class="@Cx.Merge("flex items-center justify-end gap-1.5 pt-1", Class)" @attributes="AdditionalAttributes">
        <Button Variant="Button.ButtonVariant.Ghost" Size="FilterStyles.ButtonSizeOf(Context.Size)" OnClick="() => Context.Cancel()">@Context.Labels.Discard</Button>
        <Button Size="FilterStyles.ButtonSizeOf(Context.Size)" OnClick="() => Context.Commit()">@Context.Labels.Apply</Button>
    </div>
}

@code {
    [Parameter, EditorRequired] public FilterEditorContext Context { get; set; } = default!;
    /// <summary>Icon buttons fused to the input (true) or a footer row (false).</summary>
    [Parameter] public bool Fused { get; set; }
    /// <summary>Classes for the footer row, or for each fused button.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // Inside FilterStyles.FieldGroup: a divider on the leading edge, no border or radius of its
    // own (the group draws those), the focus shown as a fill because the group carries the ring.
    private string ButtonClass => Cx.Join(
        "inline-flex shrink-0 items-center justify-center border-s border-input bg-transparent text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground focus-visible:outline-none",
        FilterStyles.ControlHeight(Context.Size), FilterStyles.IconWidth(Context.Size));
}
