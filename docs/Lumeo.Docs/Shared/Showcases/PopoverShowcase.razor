@namespace Lumeo.Docs.Shared.Showcases

@* PopoverContent is positioned via Interop.PositionFixed — per the wave brief this shows the
   trigger plus a static replica of the panel (bg-popover, border-border/60, shadow-md — lifted
   from PopoverContent) rendered inline instead of a click-driven open. *@
<div class="w-full max-w-[22rem]">
    <Stack Gap="2">
        <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" Class="w-fit">Open Popover</Button>
        <Stack Gap="2" Class="w-60 rounded-md border border-border/60 bg-popover p-2.5 text-popover-foreground shadow-md">
            <Stack Gap="0.5">
                <Lumeo.Text As="span" Size="sm" Weight="medium">Dimensions</Lumeo.Text>
                <Lumeo.Text Size="xs" Color="muted">Set the dimensions for the layer.</Lumeo.Text>
            </Stack>
            <Grid Columns="3" Gap="2" Class="items-center">
                <Label Class="text-xs">Width</Label>
                <Input Class="col-span-2 h-7 text-xs" Value="100%" />
                <Label Class="text-xs">Height</Label>
                <Input Class="col-span-2 h-7 text-xs" Value="25px" />
            </Grid>
        </Stack>
    </Stack>
</div>
