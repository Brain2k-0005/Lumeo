@namespace Lumeo.Docs.Shared.Showcases
@using Lumeo

@* LIVE (see ../README.md's "Wave 1 — Data Display category" table + phase-3b promotion note):
   CatalogCard now routes every showcase through SatelliteBoundShowcase, which lazy-loads
   Lumeo.Flow.dll (ShowcaseResolver.SatelliteAssembliesFor) before this mounts — the
   TypeLoadException that forced the earlier static dot-grid replica is gone. Real FlowCanvas,
   three fixed nodes/two edges, a fixed non-fitting viewport (no FitViewOnInit measurement
   race — deterministic every render per rule 1) and no pan/zoom (kept off so a stray wheel/
   drag on the catalog page can't scroll the card away from its cards) — node drag stays on,
   so the showcase is genuinely interactive: drag any card. *@

<div class="w-full max-w-[22rem] h-36 rounded-md border border-border/60 overflow-hidden bg-background">
    <FlowCanvas Nodes="_nodes" Edges="_edges" Height="144px"
                Viewport="new FlowViewport(20, 26, 0.58)" FitViewOnInit="false"
                NodesConnectable="false" ElementsSelectable="true"
                PanOnDrag="false" ZoomOnScroll="false" MinZoom="0.58" MaxZoom="0.58">
        <NodeTemplate Context="ctx">
            <div class="w-28 rounded-md border border-border bg-card px-2 py-1.5 text-[10px] font-medium text-card-foreground shadow-sm">
                @(((StepInfo)ctx.Node.Data!).Title)
            </div>
        </NodeTemplate>
        <ChildContent>
            <FlowBackground Gap="14" Size="1" />
        </ChildContent>
    </FlowCanvas>
</div>

@code {
    private sealed record StepInfo(string Title);

    private readonly List<FlowNode> _nodes =
    [
        new("intake", 0, 44, Data: new StepInfo("New order")),
        new("check", 168, 0, Data: new StepInfo("Check stock")),
        new("ship", 168, 88, Data: new StepInfo("Dispatch")),
    ];

    private readonly List<FlowEdge> _edges =
    [
        new("e-intake-check", "intake", "check"),
        new("e-intake-ship", "intake", "ship"),
    ];
}
