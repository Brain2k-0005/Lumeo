    // Table state: what TanStack Table keeps in sorting / columnFilters / columnVisibility /
    // rowSelection / pagination, held as plain fields.
    private string _filter = "";
    private readonly HashSet<string> _statusFilter = new();
    private readonly HashSet<string> _priorityFilter = new();
    private string? _sortColumn;
    private bool _sortDesc;
    private readonly HashSet<string> _hidden = new();
    private readonly HashSet<string> _selected = new();
    private int _page;
    private int _pageSize = 25;

    private static string LabelOf(string value) => Labels.First(l => l.Value == value).Label;

    private bool IsFiltered => _filter.Length > 0 || _statusFilter.Count > 0 || _priorityFilter.Count > 0;

    private bool MatchesText(Task t) => _filter.Length == 0 || t.Title.Contains(_filter, StringComparison.OrdinalIgnoreCase);

    private List<Task> Filtered
    {
        get
        {
            IEnumerable<Task> rows = _tasks.Where(t => MatchesText(t)
                && (_statusFilter.Count == 0 || _statusFilter.Contains(t.Status))
                && (_priorityFilter.Count == 0 || _priorityFilter.Contains(t.Priority)));
            rows = _sortColumn switch
            {
                "title" => _sortDesc ? rows.OrderByDescending(t => t.Title, StringComparer.OrdinalIgnoreCase) : rows.OrderBy(t => t.Title, StringComparer.OrdinalIgnoreCase),
                "status" => _sortDesc ? rows.OrderByDescending(t => t.Status, StringComparer.OrdinalIgnoreCase) : rows.OrderBy(t => t.Status, StringComparer.OrdinalIgnoreCase),
                "priority" => _sortDesc ? rows.OrderByDescending(t => t.Priority, StringComparer.OrdinalIgnoreCase) : rows.OrderBy(t => t.Priority, StringComparer.OrdinalIgnoreCase),
                _ => rows,
            };
            return rows.ToList();
        }
    }

    // TanStack's faceted counts are taken over the rows that pass every OTHER column filter.
    private int FacetCount(string column, string value) => _tasks.Count(t => MatchesText(t)
        && (column == "status" ? t.Status == value : _statusFilter.Count == 0 || _statusFilter.Contains(t.Status))
        && (column == "priority" ? t.Priority == value : _priorityFilter.Count == 0 || _priorityFilter.Contains(t.Priority)));

    private int PageCount => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)_pageSize));
    private int Page => Math.Min(_page, PageCount - 1);
    private List<Task> PageRows => Filtered.Skip(Page * _pageSize).Take(_pageSize).ToList();
    private int ColumnCount => 3 + HideableColumns.Count(c => !_hidden.Contains(c));
    private int FilteredSelectedCount => Filtered.Count(t => _selected.Contains(t.Id));
    private bool AllPageSelected => PageRows.Count > 0 && PageRows.All(t => _selected.Contains(t.Id));
    private bool SomePageSelected => !AllPageSelected && PageRows.Any(t => _selected.Contains(t.Id));

    private void SetFilter(string? value) { _filter = value ?? ""; _page = 0; }

    private void ToggleFacet(HashSet<string> set, string value)
    {
        if (!set.Remove(value)) set.Add(value);
        _page = 0;
    }

    private void ClearFacet(HashSet<string> set) { set.Clear(); _page = 0; }

    private void ResetFilters() { _filter = ""; _statusFilter.Clear(); _priorityFilter.Clear(); _page = 0; }

    private void Sort(string column, bool desc) { _sortColumn = column; _sortDesc = desc; }

    private void SetVisible(string column, bool visible)
    {
        if (visible) _hidden.Remove(column); else _hidden.Add(column);
    }

    private void ToggleRow(string id, bool on)
    {
        if (on) _selected.Add(id); else _selected.Remove(id);
    }

    private void ToggleAllPage(bool on)
    {
        foreach (var t in PageRows) ToggleRow(t.Id, on);
    }

    private void SetPageSize(string? value)
    {
        if (int.TryParse(value, out var size)) { _pageSize = size; _page = 0; }
    }

    private void GoTo(int page) => _page = Math.Clamp(page, 0, PageCount - 1);
}
