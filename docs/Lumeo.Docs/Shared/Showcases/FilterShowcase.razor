@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <FilterBar Filters="_filters" OnRemoveFilter="@(f => _filters = _filters.Where(x => x != f).ToList())">
        <Lumeo.Text Size="xs" Color="muted">Filtering by:</Lumeo.Text>
    </FilterBar>
</div>

@code {
    private List<FilterBar.FilterDescriptor> _filters = new()
    {
        new("Status", "is", "Active"),
        new("Priority", "=", "High"),
    };
}
