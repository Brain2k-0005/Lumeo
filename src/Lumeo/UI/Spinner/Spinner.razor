@namespace Lumeo

@if (Variant == SpinnerVariant.Ring)
{
    <div data-slot="spinner" class="@WrapperClass" role="status" aria-live="polite" aria-busy="true" aria-label="@AriaLabelOrDefault" @attributes="AdditionalAttributes">
        <svg class="@RingCssClass" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <span class="text-sm text-muted-foreground">@Label</span>
        }
    </div>
}
else if (Variant == SpinnerVariant.Dots)
{
    <div data-slot="spinner" class="@WrapperClass" role="status" aria-live="polite" aria-busy="true" aria-label="@AriaLabelOrDefault" @attributes="AdditionalAttributes">
        <div class="@DotsContainerClass" aria-hidden="true">
            <div class="@DotClass" style="animation-delay: 0ms"></div>
            <div class="@DotClass" style="animation-delay: 150ms"></div>
            <div class="@DotClass" style="animation-delay: 300ms"></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <span class="text-sm text-muted-foreground">@Label</span>
        }
    </div>
}
else if (Variant == SpinnerVariant.Bars)
{
    <div data-slot="spinner" class="@WrapperClass" role="status" aria-live="polite" aria-busy="true" aria-label="@AriaLabelOrDefault" @attributes="AdditionalAttributes">
        <div class="@BarsContainerClass" aria-hidden="true">
            <div class="@BarClass" style="height: 60%; animation-delay: 0ms"></div>
            <div class="@BarClass" style="height: 100%; animation-delay: 150ms"></div>
            <div class="@BarClass" style="height: 60%; animation-delay: 300ms"></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <span class="text-sm text-muted-foreground">@Label</span>
        }
    </div>
}

@code {
    /// <summary>Spinner size — scales the SVG ring / dot / bar dimensions and their gap.
    /// Supports all 7 <see cref="Lumeo.Size"/> values (Xxs–Xxl). Default <see cref="Lumeo.Size.Md"/>.
    /// Xxs/Xs on the Dots and Bars variants floor at very small dimensions — see component notes.</summary>
    [Parameter] public Lumeo.Size Size { get; set; } = Lumeo.Size.Md;
    /// <summary>Visual style: <see cref="SpinnerVariant.Ring"/> (rotating arc, default),
    /// <see cref="SpinnerVariant.Dots"/> (three bouncing dots), or
    /// <see cref="SpinnerVariant.Bars"/> (three pulsing bars).</summary>
    [Parameter] public SpinnerVariant Variant { get; set; } = SpinnerVariant.Ring;
    /// <summary>Visible text shown next to the spinner. Also used as the accessible
    /// name (via <see cref="AriaLabel"/>'s fallback chain) when <see cref="AriaLabel"/>
    /// isn't set.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>
    /// Screen-reader name when there is no visible <see cref="Label"/>. Defaults
    /// to "Loading"; set it to a localized string (or pass <c>aria-label</c>
    /// directly) so the spinner announces in the app's language.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>CSS text-color class (e.g. <c>text-primary</c>) applied to the wrapper;
    /// the SVG/dots/bars all paint via <c>currentColor</c>/<c>bg-current</c>, so this
    /// controls the spinner's color.</summary>
    [Parameter] public string? Color { get; set; }
    /// <summary>Additional CSS classes merged onto the wrapper <c>div</c>.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Unmatched attributes splatted onto the wrapper <c>div</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string WrapperClass => Cx.Merge("inline-flex items-center gap-2", Color, Class);

    // Always advertise an accessible name to AT. Prefers an explicit AriaLabel
    // (localizable), then the visible Label, then "Loading" — the SVG/Dots/Bars
    // are aria-hidden because their shapes carry no semantic meaning, so without
    // this the spinner is invisible to screen readers. A consumer-supplied
    // aria-label via attributes still wins (splatted last).
    private string AriaLabelOrDefault =>
        !string.IsNullOrWhiteSpace(AriaLabel) ? AriaLabel! :
        !string.IsNullOrWhiteSpace(Label) ? Label! : "Loading";

    private string RingCssClass => Cx.Join("animate-spin", SizeClasses);

    private string SizeClasses => Size switch
    {
        // shadcn's spinner is size-4, so Md sits there and the ladder moves down with it:
        // 6 / 8 / 12 / 16 / 24 / 32 / 40px across the seven rungs.
        Lumeo.Size.Xxs => "h-1.5 w-1.5",
        Lumeo.Size.Xs => "h-2 w-2",
        Lumeo.Size.Sm => "h-3 w-3",
        Lumeo.Size.Lg => "h-6 w-6",
        Lumeo.Size.Xl => "h-8 w-8",
        Lumeo.Size.Xxl => "h-10 w-10",
        _ => "h-4 w-4"
    };

    private string DotsContainerClass => $"flex items-center {DotGapClass}".Trim();

    // Xxs/Xs both floor at gap-0 (dots touch) — no valid Tailwind token between
    // 0 and Sm's gap-0.5; a deliberate tie, not a bug (spec-flagged).
    private string DotGapClass => Size switch
    {
        Lumeo.Size.Xxs => "gap-0",
        Lumeo.Size.Xs => "gap-0",
        Lumeo.Size.Sm => "gap-0.5",
        Lumeo.Size.Md => "gap-1",
        Lumeo.Size.Lg => "gap-1.5",
        Lumeo.Size.Xl => "gap-2",
        Lumeo.Size.Xxl => "gap-2.5",
        _ => "gap-1"
    };

    private string DotClass
    {
        get
        {
            var sizeClass = Size switch
            {
                Lumeo.Size.Xxs => "h-0.5 w-0.5",
                Lumeo.Size.Xs => "h-1 w-1",
                Lumeo.Size.Sm => "h-1.5 w-1.5",
                Lumeo.Size.Md => "h-2 w-2",
                Lumeo.Size.Lg => "h-3 w-3",
                Lumeo.Size.Xl => "h-4 w-4",
                Lumeo.Size.Xxl => "h-5 w-5",
                _ => "h-2 w-2"
            };
            return $"{sizeClass} rounded-full bg-current animate-bounce";
        }
    }

    private string BarsContainerClass
    {
        get
        {
            var heightClass = Size switch
            {
                Lumeo.Size.Xxs => "h-1",
                Lumeo.Size.Xs => "h-2",
                Lumeo.Size.Sm => "h-3",
                Lumeo.Size.Md => "h-4",
                Lumeo.Size.Lg => "h-6",
                Lumeo.Size.Xl => "h-8",
                Lumeo.Size.Xxl => "h-10",
                _ => "h-4"
            };
            return $"flex items-end gap-0.5 {heightClass}";
        }
    }

    // Xxs/Xs both floor at w-0.5, tying Sm — Sm - 0.5-step would be zero-width
    // (invisible); a deliberate three-way tie on width alone (spec-flagged).
    // Bar height (BarsContainerClass) still differs across these three rungs.
    private string BarClass
    {
        get
        {
            var widthClass = Size switch
            {
                Lumeo.Size.Xxs => "w-0.5",
                Lumeo.Size.Xs => "w-0.5",
                Lumeo.Size.Sm => "w-0.5",
                Lumeo.Size.Md => "w-1",
                Lumeo.Size.Lg => "w-1.5",
                Lumeo.Size.Xl => "w-2",
                Lumeo.Size.Xxl => "w-2.5",
                _ => "w-1"
            };
            return $"{widthClass} bg-current rounded-sm animate-pulse";
        }
    }

    public enum SpinnerVariant { Ring, Dots, Bars }
}
