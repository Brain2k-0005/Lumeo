@namespace Lumeo
@using Lumeo.SchedulerKernel
@inject Lumeo.Services.IComponentInteropService Interop
@inject Lumeo.Services.Localization.ILumeoLocalizer L

<div class="@($"flex flex-col gap-3 rounded-md border border-border/60 bg-card p-3 {Class}".Trim())" @attributes="AdditionalAttributes">
    @* Lumeo-styled toolbar above the calendar grid. *@
    <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-1">
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" OnClick="PrevAsync" aria-label="@L["Scheduler.Previous"]">
                <SvgGlyph Svg="@(LumeoIcons.ChevronLeft)" class="h-4 w-4" />
            </Button>
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" OnClick="TodayAsync">@L["Scheduler.Today"]</Button>
            <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" OnClick="NextAsync" aria-label="@L["Scheduler.Next"]">
                <SvgGlyph Svg="@(LumeoIcons.ChevronRight)" class="h-4 w-4" />
            </Button>
        </div>
        <div class="flex-1 text-center text-sm font-medium text-foreground truncate px-2">
            @_title
        </div>
        <ToggleGroup Type="ToggleGroup.ToggleGroupType.Single"
                     Variant="ToggleGroup.ToggleGroupVariant.Outline"
                     Size="Lumeo.Size.Sm"
                     Value="@_currentViewValue"
                     ValueChanged="OnViewChangedAsync">
            <ToggleGroupItem Value="Month">@L["Scheduler.Month"]</ToggleGroupItem>
            <ToggleGroupItem Value="Week">@L["Scheduler.Week"]</ToggleGroupItem>
            <ToggleGroupItem Value="Day">@L["Scheduler.Day"]</ToggleGroupItem>
            <ToggleGroupItem Value="List">@L["Scheduler.List"]</ToggleGroupItem>
            @if (VisibleDays is > 0)
            {
                @* Labelled with the actual count — "N days" is meaningless as a fixed string,
                   and this button only exists once a caller has chosen an N. *@
                <ToggleGroupItem Value="MultiDay">@string.Format(L["Scheduler.NDays"], EffectiveVisibleDays)</ToggleGroupItem>
            }
            @if (Resources is { Count: > 0 })
            {
                <ToggleGroupItem Value="Resource">@L["Scheduler.Resources"]</ToggleGroupItem>
                <ToggleGroupItem Value="Timeline">@L["Scheduler.Timeline"]</ToggleGroupItem>
            }
        </ToggleGroup>
    </div>

    @* Resource legend — rendered when Resources are provided.
       Uses simple color-coded dots. *@
    @if (_resolvedResources is { Count: > 0 })
    {
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-1 pb-1" aria-label="@L["Scheduler.ResourceLegend"]">
            @foreach (var resource in _resolvedResources)
            {
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="inline-block h-2.5 w-2.5 rounded-[calc(var(--radius)*2)] flex-shrink-0"
                          style="background: @(resource.Color ?? "var(--color-primary)")"></span>
                    <span>@resource.Title</span>
                </div>
            }
        </div>
    }

    @* Height bounds the SCROLL viewport (Codex review, P2): applied only as an
       outer max-height it left the inner views free to grow past it, so a tall
       month rendered outside the box the caller asked for. *@
    <div style="height: @Height; max-height: @Height; overflow: auto;">
            @switch (_currentView)
            {
                case SchedulerView.Month:
                    <SchedulerMonthView Events="@EffectiveEvents" AnchorDate="@_fpAnchor"
                                        FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                        BusinessHours="@BusinessHours"
                                        ShowWeekNumbers="@ShowWeekNumbers" HideWeekends="@HideWeekends"
                                        Editable="@Editable" Selectable="@Selectable" CanDrop="@CanDrop"
                                        ResolveEventColor="@ResolveFirstPartyColor"
                                        ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                        OnEventClick="@OnEventClick" OnDateSelect="@OnDateSelect"
                                        OnEventChange="@OnFirstPartyEventChangeAsync"
                                        OnRequestPrev="@PrevAsync" OnRequestNext="@NextAsync" />
                    break;
                case SchedulerView.Week:
                    <SchedulerTimeGridView Events="@EffectiveEvents" AnchorDate="@_fpAnchor" Days="7"
                                           FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                           BusinessHours="@BusinessHours" NowIndicator="@NowIndicator" NowTimeZoneId="@SchedulerTimeZoneProjection.JsZoneId(_displayZone)"
                                           SlotMinTime="@SlotMinTime" SlotMaxTime="@SlotMaxTime" SlotDuration="@SlotDuration"
                                           Editable="@Editable" Selectable="@Selectable" CanDrop="@CanDrop"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@OnEventClick" OnDateSelect="@OnDateSelect"
                                           OnEventChange="@OnFirstPartyEventChangeAsync"
                                           OnRequestPrev="@PrevAsync" OnRequestNext="@NextAsync" />
                    break;
                case SchedulerView.Day:
                    <SchedulerTimeGridView Events="@EffectiveEvents" AnchorDate="@_fpAnchor" Days="1"
                                           FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                           BusinessHours="@BusinessHours" NowIndicator="@NowIndicator" NowTimeZoneId="@SchedulerTimeZoneProjection.JsZoneId(_displayZone)"
                                           SlotMinTime="@SlotMinTime" SlotMaxTime="@SlotMaxTime" SlotDuration="@SlotDuration"
                                           Editable="@Editable" Selectable="@Selectable" CanDrop="@CanDrop"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@OnEventClick" OnDateSelect="@OnDateSelect"
                                           OnEventChange="@OnFirstPartyEventChangeAsync"
                                           OnRequestPrev="@PrevAsync" OnRequestNext="@NextAsync" />
                    break;
                case SchedulerView.MultiDay:
                    @* Days != 7 makes the time grid start at the anchor itself instead of a
                       week boundary, which is exactly the rolling window this view wants. *@
                    <SchedulerTimeGridView Events="@EffectiveEvents" AnchorDate="@_fpAnchor" Days="@EffectiveVisibleDays"
                                           AlignToWeek="false"
                                           FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                           BusinessHours="@BusinessHours" NowIndicator="@NowIndicator" NowTimeZoneId="@SchedulerTimeZoneProjection.JsZoneId(_displayZone)"
                                           SlotMinTime="@SlotMinTime" SlotMaxTime="@SlotMaxTime" SlotDuration="@SlotDuration"
                                           Editable="@Editable" Selectable="@Selectable" CanDrop="@CanDrop"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@OnEventClick" OnDateSelect="@OnDateSelect"
                                           OnEventChange="@OnFirstPartyEventChangeAsync"
                                           OnRequestPrev="@PrevAsync" OnRequestNext="@NextAsync" />
                    break;
                case SchedulerView.Timeline when Resources is { Count: > 0 }:
                    @* Today comes from the DISPLAY zone (Codex review, P2): events are
                       projected into it, so letting the view fall back to the host's
                       DateTime.Today highlighted a different column than the data sits in —
                       and disagreed with this wrapper's own Today button. *@
                    <SchedulerTimelineView Events="@EffectiveEvents" Resources="@Resources"
                                           Today="@(_displayZone is not null ? SchedulerTimeZoneProjection.TodayIn(_displayZone) : _browserToday)"
                                           RangeStart="@_fpAnchor" Columns="@EffectiveTimelineColumns"
                                           Unit="@TimelineUnit" FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@OnEventClick" />
                    break;
                case SchedulerView.Resource when Resources is { Count: > 0 }:
                    <SchedulerResourceView Events="@EffectiveEvents" Date="@_fpAnchor"
                                           Resources="@Resources"
                                           SlotMinTime="@SlotMinTime" SlotMaxTime="@SlotMaxTime" SlotDuration="@SlotDuration"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@OnEventClick" />
                    break;
                case SchedulerView.Resource:
                case SchedulerView.Timeline:
                    @* Both views need Resources to mean anything. Their documentation has
                       always said they degrade to the day view; without this case they fell
                       through to `default`, i.e. the AGENDA — a flat list, which is not what
                       was promised and not the nearest thing either. Caught by a test written
                       against the documented behaviour. *@
                    <SchedulerTimeGridView Events="@EffectiveEvents" AnchorDate="@_fpAnchor" Days="1"
                                           FirstDayOfWeek="@EffectiveFirstDayOfWeek"
                                           BusinessHours="@BusinessHours" NowIndicator="@NowIndicator" NowTimeZoneId="@SchedulerTimeZoneProjection.JsZoneId(_displayZone)"
                                           SlotMinTime="@SlotMinTime" SlotMaxTime="@SlotMaxTime" SlotDuration="@SlotDuration"
                                           Editable="@Editable" Selectable="@Selectable" CanDrop="@CanDrop"
                                           ResolveEventColor="@ResolveFirstPartyColor"
                                           ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                           OnEventClick="@OnEventClick" OnDateSelect="@OnDateSelect"
                                           OnEventChange="@OnFirstPartyEventChangeAsync"
                                           OnRequestPrev="@PrevAsync" OnRequestNext="@NextAsync" />
                    break;
                default:
                    @* List maps to the agenda view — the same "flat, chronological"
                       reading a week-long agenda gives. *@
                    <SchedulerAgendaView Events="@EffectiveEvents" AnchorDate="@FirstPartyAgendaStart" DaysToShow="7"
                                         ResolveEventColor="@ResolveFirstPartyColor"
                                         ResolveEventClassNames="@ResolveFirstPartyClassNames"
                                         OnEventClick="@OnEventClick" />
                    break;
            }
    </div>
</div>

@code {
    // ── Core parameters ──────────────────────────────────────────────────
    /// <summary>The calendar's events. Controlled when <see cref="EventsChanged"/> has a delegate — the
    /// caller owns the collection and must apply drag/resize/click edits back onto it; otherwise the
    /// component manages its own working copy internally, seeded from this value.</summary>
    [Parameter] public IEnumerable<SchedulerEvent>? Events { get; set; }
    /// <summary>Invoked with the updated event collection after a drag, resize, or other edit. Binding
    /// this makes <see cref="Events"/> controlled.</summary>
    [Parameter] public EventCallback<IEnumerable<SchedulerEvent>> EventsChanged { get; set; }


    /// <summary>
    /// Shows an ISO-8601 week-number column in the month view..
    /// </summary>
    [Parameter] public bool ShowWeekNumbers { get; set; }

    /// <summary>
    /// Hides the Saturday and Sunday columns in the month view..
    /// </summary>
    [Parameter] public bool HideWeekends { get; set; }

    /// <summary>
    /// Three-way drop validation for first-party drags: reject, accept, or accept with an
    /// adjustment.
    /// seam.
    /// </summary>
    [Parameter] public Func<SchedulerEvent, SchedulerScheduleDropContext, SchedulerDropResult>? CanDrop { get; set; }
    /// <summary>The calendar view shown on mount. Default: <see cref="SchedulerView.Month"/>.</summary>
    [Parameter] public SchedulerView InitialView { get; set; } = SchedulerView.Month;
    /// <summary>The date the calendar is centered on at mount. Default: today.</summary>
    [Parameter] public DateTime? InitialDate { get; set; }
    /// <summary>Allows events to be dragged and resized. Default: true.</summary>
    [Parameter] public bool Editable { get; set; } = true;
    /// <summary>Allows the user to click/drag a date range to select it, raising <see cref="OnDateSelect"/>.
    /// Default: true.</summary>
    [Parameter] public bool Selectable { get; set; } = true;
    /// <summary>Shades non-business hours in the time-grid views.</summary>
    [Parameter] public bool BusinessHours { get; set; }
    /// <summary>CSS height of the calendar canvas. Default: <c>"640px"</c>.</summary>
    [Parameter] public string Height { get; set; } = "640px";
    /// <summary>The first day of the week, 0 (Sunday) through 6 (Saturday). Default: 1 (Monday).</summary>
    [Parameter] public int FirstDayOfWeek { get; set; } = 1;
    /// <summary>Invoked when an event chip is clicked.</summary>
    [Parameter] public EventCallback<SchedulerEvent> OnEventClick { get; set; }
    /// <summary>Invoked when the user selects a date/time range (click-drag on the grid).</summary>
    [Parameter] public EventCallback<SchedulerDateRange> OnDateSelect { get; set; }
    /// <summary>Invoked when an event's time window changes via drag or resize, alongside <see cref="EventsChanged"/>.</summary>
    [Parameter] public EventCallback<SchedulerEvent> OnEventChange { get; set; }

    // ── Time-grid display parameters ─────────────────────────────────────
    /// <summary>
    /// Show the current-time indicator line in time-grid views. Default: true.
    /// </summary>
    [Parameter] public bool NowIndicator { get; set; } = true;

    /// <summary>
    /// Earliest visible time slot in time-grid views (e.g. 07:00).
    /// Default: 00:00 — the full day.
    /// </summary>
    [Parameter] public TimeOnly? SlotMinTime { get; set; }

    /// <summary>
    /// Latest visible time slot in time-grid views (e.g. 22:00).
    /// Default: 24:00 — the full day.
    /// </summary>
    [Parameter] public TimeOnly? SlotMaxTime { get; set; }

    /// <summary>
    /// Duration of each time slot row in time-grid views.
    /// Default: one hour. Values that do not divide an hour are rounded up to one that does.
    /// </summary>
    [Parameter] public TimeSpan? SlotDuration { get; set; }

    /// <summary>
    /// How many days <see cref="SchedulerView.MultiDay"/> shows, and the step size when paging
    /// through it. Clamped to 1..14. Leaving this unset hides the view's toolbar button
    /// entirely — an N-day view with no N is not a view.
    /// <para>First-party engine only; see <see cref="SchedulerView.MultiDay"/>.</para>
    /// </summary>
    [Parameter] public int? VisibleDays { get; set; }

    /// <summary>
    /// Column granularity for <see cref="SchedulerView.Timeline"/> — a day, a week, or a
    /// calendar month per column. Default: days.
    /// </summary>
    [Parameter] public SchedulerTimelineUnit TimelineUnit { get; set; } = SchedulerTimelineUnit.Day;

    /// <summary>
    /// How many columns <see cref="SchedulerView.Timeline"/> spans. Default 14. Kept separate
    /// from <see cref="VisibleDays"/> because the two count different things: a timeline column
    /// is one <see cref="TimelineUnit"/> — a day, a week or a month — while
    /// <see cref="VisibleDays"/> always counts days.
    /// </summary>
    [Parameter] public int? TimelineColumns { get; set; }

    private int EffectiveTimelineColumns => Math.Clamp(TimelineColumns ?? 14, 1, 366);

    private int _lastTimelineShape;
    private bool _titleSeeded;

    /// <summary>
    /// IANA time zone the grid is READ in, e.g. <c>"Europe/Berlin"</c>. Unset renders the
    /// values exactly as given.
    /// <para>
    /// Only events carrying a real instant move — see
    /// <see cref="SchedulerTimeZoneProjection"/> for why <see cref="DateTimeKind"/> decides,
    /// and why a caller passing naive wall-clock values (the overwhelming majority) sees no
    /// change at all. Edits are converted back before they reach
    /// <see cref="OnEventChange"/>/<see cref="EventsChanged"/>, so what you get out is in the
    /// frame you put in. An id this host has no data for degrades to "no projection" rather
    /// than failing the render.
    /// </para>
    /// <para>First-party engine only.</para>
    /// </summary>
    [Parameter] public string? TimeZone { get; set; }

    private TimeZoneInfo? _displayZone;

    /// <summary>The clamped <see cref="VisibleDays"/>, defaulting to 3 — the window ReUI's own N-day example uses.</summary>
    private int EffectiveVisibleDays => Math.Clamp(VisibleDays ?? 3, 1, 14);

    // ── Resource / color-coding parameters ──────────────────────────────
    /// <summary>
    /// Optional list of resources (people, rooms, equipment). When provided, events
    /// are color-coded by their <see cref="SchedulerEvent.ResourceId"/> and a legend
    /// is rendered above the calendar.
    /// <br />
    /// Note: this colour-codes events by resource. <see cref="SchedulerView.Resource"/> is
    /// what lays out one lane per resource.
    /// </summary>
    [Parameter] public IReadOnlyList<SchedulerResource>? Resources { get; set; }

    // ── Event styling callbacks ──────────────────────────────────────────
    /// <summary>
    /// Optional callback that returns extra CSS class names for an event chip.
    /// The classes are appended to the event chip's own.
    /// Use for conditional styling without touching <see cref="SchedulerEvent.Color"/>.
    /// </summary>
    [Parameter] public Func<SchedulerEvent, string>? EventClassNames { get; set; }

    /// <summary>
    /// Optional callback that returns a CSS color string for an event.
    /// Applied to the event chip's background and text colour.
    /// Supersedes <see cref="SchedulerEvent.Color"/> when both are set; resource
    /// color applies as a fallback when neither is set.
    /// </summary>
    [Parameter] public Func<SchedulerEvent, string>? EventColor { get; set; }

    // ── Error handling ───────────────────────────────────────────────────

    // ── Standard pass-through ────────────────────────────────────────────
    /// <summary>Additional CSS classes merged onto the root card.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Additional HTML attributes captured and forwarded to the root card.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int _lastEventsHash;
    private SchedulerView _currentView;
    // EffectiveView, not _currentView: with Timeline selected and no resources the Timeline
    // item is hidden while the day grid renders, so binding the raw selection left every
    // visible item — Day included — unpressed (Codex review round 2, P2).
    private string _currentViewValue => EffectiveView.ToString();
    private string _title = "";

    // The UI culture the cached title was last formatted for.
    // Re-read on every parameter set, not just at init: the title is cached, so a culture
    // change arriving through an ordinary re-render has to invalidate it.
    private string _currentLocale = "en";

    // Snapshot of the most recent events set — used by eventChange to build the
    // updated collection without reaching back into `Events` (which may have
    // been replaced by the parent since init).
    private List<SchedulerEvent> _events = new();

    // CONTROLLED discriminator: hash of the events collection most recently pushed via
    // EventsChanged (also re-synced whenever we adopt an authoritative Events collection).
    // A controlled parent re-render that echoes back this exact collection is safe to
    // ignore (keep in-flight state); any other collection is an authoritative assertion
    // (veto / normalization / reset) and must win.
    private int _lastPushedEventsHash;

    // Resolved resource lookup — built once and used for both legend rendering
    // and event colour-coding.
    private List<SchedulerResource> _resolvedResources = new();
    private Dictionary<string, SchedulerResource> _resourceById = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        _currentView = InitialView;
        _events = Events?.ToList() ?? new List<SchedulerEvent>();
        _lastEventsHash = ComputeEventsHash(_events);
        _lastPushedEventsHash = _lastEventsHash;
        SeedFirstPartyAnchor();
        // ComputeTitle has no branch for List, Resource or MultiDay, so all three used to
        // open on the month name and only corrected themselves once the user navigated.
        _title = ComputeFirstPartyTitle();
        _titleSeeded = true;
        _currentLocale = System.Globalization.CultureInfo.CurrentUICulture.Name;
        RebuildResourceLookup();
    }

    protected override void OnParametersSet()
    {
        _displayZone = SchedulerTimeZoneProjection.Resolve(TimeZone);

        // The timeline rebuilds its columns from these immediately, but the toolbar title is
        // cached and was only refreshed by navigation or a culture change — so it kept naming
        // the old end date until the user pressed something (Codex review, P2).
        // EffectiveFirstDayOfWeek moves a week timeline's column origin, and resource presence
        // decides EffectiveView outright — gaining or losing Resources swaps the day grid for the
        // timeline. Both change what the title should read without touching unit or column count
        // (Codex review round 2, P2).
        var timelineShape = HashCode.Combine(TimelineUnit, EffectiveTimelineColumns,
                                             EffectiveFirstDayOfWeek, EffectiveView);
        if (timelineShape != _lastTimelineShape)
        {
            _lastTimelineShape = timelineShape;
            if (_titleSeeded) RefreshFirstPartyTitle();
        }
        // Rebuild the resource lookup whenever the Resources param changes.
        RebuildResourceLookup();

        // The title is cached, so a UI-culture change that arrives through a normal
        // re-render has to invalidate it explicitly — otherwise a German toolbar sat over
        // an English calendar until the user happened to navigate.
        var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        if (culture != _currentLocale)
        {
            _currentLocale = culture;
            RefreshFirstPartyTitle();
        }

        if (Events is not null)
        {
            var incoming = Events.ToList();
            var hash = ComputeEventsHash(incoming);

            bool shouldAdopt;
            if (EventsChanged.HasDelegate)
            {
                // CONTROLLED: the parent owns the collection.
                // Echo of our own push (hash == _lastPushedEventsHash) → keep in-flight state.
                // Anything else (veto, normalization, reset) → adopt the parent's assertion.
                shouldAdopt = hash != _lastPushedEventsHash;
            }
            else
            {
                // UNCONTROLLED: component owns the live collection.
                // Adopt the parameter only when the parent genuinely changes it; a stale
                // re-render that re-supplies the same collection must not clobber local edits.
                shouldAdopt = hash != _lastEventsHash;
            }

            if (shouldAdopt)
            {
                _events = incoming;
                _lastPushedEventsHash = hash;
            }

            // Keep the uncontrolled discriminator pointing at the last Events hash observed.
            _lastEventsHash = hash;
        }
    }

    private void RebuildResourceLookup()
    {
        _resolvedResources = Resources?.ToList() ?? new List<SchedulerResource>();

        // Duplicate (or null) resource Ids must not throw. ToDictionary blows up on a
        // duplicate key, taking down the whole render; consumers may legitimately pass a
        // list with repeated/blank Ids (e.g. a merged or partially-populated source).
        // Build defensively instead — last entry wins, and null Ids are skipped (they can
        // never be matched by SchedulerEvent.ResourceId lookups anyway).
        var lookup = new Dictionary<string, SchedulerResource>(StringComparer.Ordinal);
        foreach (var r in _resolvedResources)
        {
            if (r.Id is null) continue;
            lookup[r.Id] = r;
        }
        _resourceById = lookup;
    }

    private static int ComputeEventsHash(IEnumerable<SchedulerEvent> events)
    {
        // Cheap identity hash good enough to detect "did the caller hand us a
        // new event list?" without triggering a JS round-trip on every render.
        var hash = new HashCode();
        foreach (var ev in events)
        {
            hash.Add(ev.Id);
            hash.Add(ev.Title);
            hash.Add(ev.Start);
            hash.Add(ev.End);
            hash.Add(ev.AllDay);
            hash.Add(ev.Color);
            hash.Add(ev.Url);
            hash.Add(ev.ResourceId);
            hash.Add(ev.ClassNames);
            hash.Add(ev.RecurrenceEnd);

            // Hash the recurrence rule by value — not just its length. Folding only
            // DaysOfWeek.Count missed edits that swap days without changing the count
            // (e.g. {Mon} → {Tue}), so the calendar never re-rendered.
            if (ev.DaysOfWeek is { Count: > 0 })
            {
                foreach (var d in ev.DaysOfWeek)
                    hash.Add((int)d);
            }

            // Same reasoning, extended to the wave-1 structured Recurrence rule
            // (Lumeo.Scheduler's SchedulerEvent.Recurrence, additive alongside the
            // legacy DaysOfWeek pair above): fold it by value, not by reference/
            // presence, so e.g. flipping Freq or editing an Interval/Count/Until/
            // ByDay entry is detected even though the record reference itself may
            // differ from a caller rebuilding it each render regardless of edit.
            if (ev.Recurrence is { } rule)
            {
                hash.Add(rule.Freq);
                hash.Add(rule.Interval);
                hash.Add(rule.Count);
                hash.Add(rule.Until);
                if (rule.ByDay is { Count: > 0 })
                {
                    foreach (var byDay in rule.ByDay)
                    {
                        hash.Add((int)byDay.Day);
                        hash.Add(byDay.Ordinal);
                    }
                }
            }

            // ExceptionDates carry real recurrence edits (skip/un-skip a day);
            // omitting them suppressed the JS round-trip entirely.
            if (ev.ExceptionDates is { Count: > 0 })
            {
                foreach (var ex in ev.ExceptionDates)
                    hash.Add(ex);
            }

            // ExtendedProps is arbitrary app metadata round-tripped to JS; fold a
            // stable per-entry signature so changing a value is detected.
            if (ev.ExtendedProps is { Count: > 0 })
            {
                foreach (var kvp in ev.ExtendedProps)
                {
                    hash.Add(kvp.Key);
                    hash.Add(kvp.Value);
                }
            }
        }
        return hash.ToHashCode();
    }

    /// <summary>Recomputes the toolbar title from the anchor date.</summary>
    private void RefreshFirstPartyTitle() => _title = ComputeFirstPartyTitle();
    /// <summary>
    /// Title for a first-party view. List shows a WEEK from the aligned start and Resource shows
    /// a single day, neither of which ComputeTitle's wrapper-shaped branches describe (Codex
    /// review of this PR, P2) — List fell through to the month name, Resource to a week.
    /// </summary>
    private string ComputeFirstPartyTitle() => EffectiveView switch
    {
        SchedulerView.List => ComputeTitle(FirstPartyAgendaStart, SchedulerView.Week),
        SchedulerView.Resource => ComputeTitle(_fpAnchor, SchedulerView.Day),
        // Neither a month nor a week: name both ends, or two adjacent pages are indistinguishable.
        SchedulerView.MultiDay => MultiDayTitle(),
        SchedulerView.Timeline => TimelineTitle(),
        var v => ComputeTitle(_fpAnchor, v),
    };

    private string ComputeTitle(DateTime date, SchedulerView view) => view switch
    {
        SchedulerView.Month => date.ToString("MMMM yyyy", Ui),
        SchedulerView.Week => string.Format(L["Scheduler.WeekOf"], StartOfWeek(date).ToString("MMM d, yyyy", Ui)),
        SchedulerView.Day => date.ToString("dddd, MMM d, yyyy", Ui),
        SchedulerView.List => date.ToString("MMMM yyyy", Ui),
        _ => date.ToString("MMMM yyyy", Ui)
    };

    /// <summary>
    /// The UI culture, not the ambient one. Every view formats its own dates against
    /// CurrentUICulture and the toolbar's change detection watches it too, so formatting the
    /// title against CurrentCulture left the two disagreeing whenever a host set them apart —
    /// German buttons over an English month name.
    /// </summary>
    private static System.Globalization.CultureInfo Ui => System.Globalization.CultureInfo.CurrentUICulture;

    private string MultiDayTitle()
    {
        var start = _fpAnchor.Date;
        var end = start.AddDays(EffectiveVisibleDays - 1);
        return EffectiveVisibleDays == 1
            ? ComputeTitle(start, SchedulerView.Day)
            : $"{start:MMM d} – {end:MMM d, yyyy}";
    }

    /// <summary>
    /// What the view effectively is. Resource and Timeline both need <see cref="Resources"/>;
    /// without it they render the day grid — and the toolbar has to agree (Codex review, P2).
    /// Previously only the RENDERER fell back, so the title still described a timeline range
    /// and prev/next still jumped by TimelineColumns while a single day was on screen.
    /// </summary>
    private SchedulerView EffectiveView =>
        _currentView is SchedulerView.Resource or SchedulerView.Timeline && Resources is not { Count: > 0 }
            ? SchedulerView.Day
            : _currentView;

    private string TimelineTitle()
    {
        var origin = SchedulerTimelineScale.AlignOrigin(TimelineUnit, _fpAnchor, EffectiveFirstDayOfWeek);
        // Derived from the columns actually built, not from the requested count: near the end
        // of the calendar the axis is truncated, and subtracting a day from a saturated
        // endpoint read the title backwards — "Dec 31 – Dec 30, 9999" (Codex review round 6).
        var cols = SchedulerTimelineScale.BuildColumns(TimelineUnit, origin, EffectiveTimelineColumns);
        // A saturated advance is DateTime.MaxValue — a later instant on the SAME final day, so
        // it compares as progress while not being a real exclusive end. Subtracting a day from
        // it read the title backwards. The last VISIBLE day is then the last representable date,
        // not the final column's start: a month column titled "Dec 1 – Dec 1, 9999" while the
        // axis draws through the 31st is just as wrong (Codex review round 7).
        var exclusiveEnd = SchedulerTimelineScale.Advance(TimelineUnit, cols[^1], 1);
        var last = exclusiveEnd == DateTime.MaxValue ? DateTime.MaxValue.Date : exclusiveEnd.AddDays(-1);
        return $"{origin.ToString("MMM d", Ui)} – {last.ToString("MMM d, yyyy", Ui)}";
    }

    private DateTime StartOfWeek(DateTime date)
    {
        // FirstDayOfWeek is 0-6 (Sun-Sat).
        var first = (DayOfWeek)FirstDayOfWeek;
        var diff = (7 + (date.DayOfWeek - first)) % 7;
        return date.AddDays(-diff).Date;
    }

    // ── Navigation state ─────────────────────────────────────────────────
    // The views are pure Blazor renderers of a date range, so the toolbar owns the
    // anchor date. Seeded once from InitialDate.
    private DateTime _fpAnchor = DateTime.Today;

    /// <summary>
    /// The browser's calendar date, resolved once interop is available. Without it the timeline
    /// marked the HOST's today while this wrapper's own Today button jumped to the browser's —
    /// on a Blazor Server circuit those can be different days, so after clicking Today the axis
    /// moved and the marker stayed behind or left the range entirely (Codex review round 9).
    /// Null until the first render completes, which is the documented prerender fallback.
    /// </summary>
    private DateTime? _browserToday;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var resolved = await ResolveBrowserTodayAsync();
        if (resolved == _browserToday) return;

        _browserToday = resolved;
        StateHasChanged();
    }
    private bool _fpAnchorSeeded;


    /// <summary>
    /// What the first-party views render: the component's own working copy, which is
    /// what makes uncontrolled edits stick. Reading the raw <see cref="Events"/>
    /// parameter would show the parent's unchanged collection straight back.
    /// </summary>
    /// <summary>
    /// What the first-party views actually render. With no <see cref="TimeZone"/> this is the
    /// working copy itself; with one it is that copy read in the display zone. The projection
    /// lives HERE rather than inside the views so they stay pure wall-clock renderers.
    /// </summary>
    private IEnumerable<SchedulerEvent>? EffectiveEvents =>
        _displayZone is null
            ? _events
            : _events.Select(e => SchedulerTimeZoneProjection.ToDisplay(e, _displayZone));

    /// <summary>
    /// Colour for a first-party chip, preserving the wrapper's own precedence
    /// (Codex review of this PR, P2): EventColor delegate, then the event's own
    /// Color, then its resource's. Passing EventColor straight through dropped the
    /// resource fallback, so an event carrying only a ResourceId lost its colour
    /// the moment a consumer switched engines.
    /// </summary>
    private string? ResolveFirstPartyColor(SchedulerEvent ev) =>
        EventColor?.Invoke(ev)
        ?? ev.Color
        ?? (ev.ResourceId is { } rid && _resourceById.TryGetValue(rid, out var res) ? res.Color : null);

    /// <summary>
    /// Extra chip classes, combining the EventClassNames delegate with the event's
    /// own ClassNames — the pair the removed JS wrapper used to merge on its side
    /// (Codex review, P2), which neither reached the first-party views before.
    /// </summary>
    private string? ResolveFirstPartyClassNames(SchedulerEvent ev)
    {
        var fromDelegate = EventClassNames?.Invoke(ev);
        if (string.IsNullOrEmpty(fromDelegate)) return ev.ClassNames;
        return string.IsNullOrEmpty(ev.ClassNames) ? fromDelegate : $"{fromDelegate} {ev.ClassNames}";
    }

    /// <summary>
    /// Applies a first-party edit through this component's own state before telling
    /// the parent (Codex review of this PR, P1). Forwarding OnEventChange straight
    /// to the children skipped EventsChanged entirely, so a consumer using
    /// @bind-Events without a separate OnEventChange handler saw the chip snap back:
    /// the edit reached nobody.
    /// </summary>
    private async Task OnFirstPartyEventChangeAsync(SchedulerEvent updated)
    {
        // Applied to the component's OWN working copy first (Codex review of this
        // PR, P1). My previous fix built a local list and pushed it through
        // EventsChanged — which repaired the controlled case and left the
        // documented UNCONTROLLED mode broken: with no EventsChanged delegate the
        // edit went into a temporary list and was dropped, so the chip snapped
        // back exactly as before.
        // Resolve by Id, but only when it resolves UNAMBIGUOUSLY (battle-test finding #21,
        // carried over from the deleted JS bridge — the guard lived only there,
        // and this path used the same bare FindIndex the finding was about). A blank Id
        // identifies nothing, and a duplicate Id is genuinely ambiguous; silently merging
        // onto the first match corrupts the wrong record. In both cases the stored
        // collection is left untouched and only the reported event is surfaced.
        var matches = 0;
        var idx = -1;
        if (!string.IsNullOrEmpty(updated.Id))
        {
            for (var i = 0; i < _events.Count; i++)
            {
                if (string.Equals(_events[i].Id, updated.Id, StringComparison.Ordinal))
                {
                    matches++;
                    if (idx < 0) idx = i;
                }
            }
        }
        if (matches > 1) idx = -1;

        // Converted back BEFORE it is stored or handed on: the views work in display
        // wall-clock and cannot know what frame the caller used, so the original event is what
        // says whether these instants were UTC, local, or naive. Storing the display reading
        // would quietly rewrite the caller's data into a different frame on every drag.
        var committed = SchedulerTimeZoneProjection.FromDisplay(updated, idx >= 0 ? _events[idx] : null, _displayZone);

        if (idx >= 0)
        {
            _events[idx] = committed;
        }
        else if (matches == 0 && !string.IsNullOrEmpty(updated.Id))
        {
            // A genuinely new event (the drag-create path) — an ambiguous or blank Id adds
            // nothing, which is what leaves the stored collection untouched above.
            _events.Add(committed);
        }
        // Recorded BEFORE invoking the parent (Codex review, P1): a controlled parent
        // re-renders synchronously inside InvokeAsync, so OnParametersSetAsync must
        // already see this hash as "the value we just pushed" to tell an accepted echo
        // from a veto. Set afterwards, a parent that REJECTS the edit by handing its old
        // collection straight back looked like an unrelated change and was adopted — the
        // rejection silently became the new truth.
        //
        // _lastEventsHash is deliberately NOT touched here. It tracks what the Events
        // PARAMETER last was, and that is what the uncontrolled path compares against:
        // writing the locally-edited hash into it made the parent's very next re-render —
        // re-supplying the same collection it always passes, for some unrelated reason —
        // look like a genuine change, and the user's drag was clawed back. The deleted
        // deleted JS bridge had this right; the commit path that replaced it did not.
        _lastPushedEventsHash = ComputeEventsHash(_events);

        if (OnEventChange.HasDelegate) await OnEventChange.InvokeAsync(committed);
        if (EventsChanged.HasDelegate) await EventsChanged.InvokeAsync(_events.ToList());
    }

    /// <summary>
    /// The agenda's inclusive start, snapped to the configured week (Codex review,
    /// P2). Passing the raw anchor showed "the next seven days from wherever we
    /// happen to be", which is not the week the toolbar's own title names.
    /// </summary>
    private DateTime FirstPartyAgendaStart =>
        SchedulerDateMath.StartOfWeek(_fpAnchor, EffectiveFirstDayOfWeek);

    private DayOfWeek EffectiveFirstDayOfWeek => (DayOfWeek)Math.Clamp(FirstDayOfWeek, 0, 6);

    /// <summary>The browser's calendar date, falling back to the server's when interop yields nothing.</summary>
    private async Task<DateTime> ResolveBrowserTodayAsync()
    {
        try
        {
            var iso = await Interop.GanttV3GetLocalDateAsync();
            if (!string.IsNullOrEmpty(iso)
                && DateTime.TryParseExact(iso, "yyyy-MM-dd",
                                          System.Globalization.CultureInfo.InvariantCulture,
                                          System.Globalization.DateTimeStyles.None, out var browserToday))
            {
                return browserToday.Date;
            }
        }
        catch (Exception) { /* prerender / torn-down circuit — fall through */ }
        return DateTime.Today;
    }

    private void SeedFirstPartyAnchor()
    {
        if (_fpAnchorSeeded) return;
        _fpAnchor = (InitialDate ?? DateTime.Today).Date;
        _fpAnchorSeeded = true;
    }

    /// <summary>Steps the first-party anchor by one view-sized unit. Month moves whole months, Week/List a week, Day a day.</summary>
    private void StepFirstPartyAnchor(int direction) => _fpAnchor = EffectiveView switch
    {
        SchedulerView.Month => _fpAnchor.AddMonths(direction),
        // Resource renders a SINGLE date, so a week-sized step skipped six days
        // (Codex review of this PR, P2).
        SchedulerView.Day or SchedulerView.Resource => _fpAnchor.AddDays(direction),
        // A rolling window pages by its OWN width, so consecutive pages tile the calendar
        // instead of overlapping or skipping days.
        SchedulerView.MultiDay => _fpAnchor.AddDays(EffectiveVisibleDays * direction),
        // Pages by the WHOLE axis, in whatever unit its columns are — a month-per-column
        // timeline stepping by days would barely move.
        // Clamped in both directions: an axis at either calendar boundary renders, so its own
        // Next/Previous must not be able to crash it (Codex review round 6).
        SchedulerView.Timeline =>
            SchedulerTimelineScale.Step(TimelineUnit, _fpAnchor, EffectiveTimelineColumns * direction),
        _ => _fpAnchor.AddDays(7 * direction),
    };

    private void PrevAsync()
    {
        StepFirstPartyAnchor(-1);
        RefreshFirstPartyTitle();
    }

    private void NextAsync()
    {
        StepFirstPartyAnchor(1);
        RefreshFirstPartyTitle();
    }

    private async Task TodayAsync()
    {
        // An explicit display zone is more specific than the browser's own clock, so it
        // wins: "Today" in Europe/Berlin must be Berlin's today even for a viewer in Tokyo.
        // Failing that, the BROWSER's date rather than the host's — on a Blazor Server
        // circuit the two can be different calendar days, so "Today" jumped to the wrong
        // day for anyone whose timezone is ahead of or behind the server. DateTime.Today
        // stays the documented fallback when interop is unavailable at all (prerender, a
        // torn-down circuit, a custom service that no-ops).
        _fpAnchor = _displayZone is not null
            ? SchedulerTimeZoneProjection.TodayIn(_displayZone)
            : await ResolveBrowserTodayAsync();
        RefreshFirstPartyTitle();
    }

    private void OnViewChangedAsync(string? v)
    {
        // A single-select ToggleGroup emits null when the already-pressed item is clicked, so
        // ignoring null used to leave _currentView on the hidden Timeline/Resource selection
        // while Day was shown — and that hidden view came back the moment Resources was
        // repopulated. Normalising to what is actually on screen makes the fallback a real
        // state change rather than a display trick (Codex review round 6).
        if (string.IsNullOrEmpty(v))
        {
            if (_currentView != EffectiveView)
            {
                _currentView = EffectiveView;
                RefreshFirstPartyTitle();
            }
            return;
        }
        if (!Enum.TryParse<SchedulerView>(v, out var parsed)) return;
        _currentView = parsed;
        RefreshFirstPartyTitle();
    }

}
