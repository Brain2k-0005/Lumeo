@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Stack Gap="2" Class="w-full">
        <Slider @bind-Value="_value" Min="0" Max="100" Step="1" />
        <Lumeo.Text Size="xs" Color="muted">@(_value)%</Lumeo.Text>
    </Stack>
</div>

@code {
    private double _value = 60;
}
