@namespace Lumeo
@implements IAsyncDisposable
@using System.ComponentModel
@using System.Globalization
@using System.Text
@inject Lumeo.Services.IComponentInteropService Interop
@inject Lumeo.Services.Localization.ILumeoLocalizer L

@* FlowCanvas — a node/flow editor surface (Lumeo.Flow, spec: src/Lumeo.Flow/DESIGN.md).

   Rendering: the root carries role="application"; the pane clips and receives every gesture;
   inside it one viewport layer (transform: translate + scale) holds the SVG edge layer and the
   absolutely positioned node hosts, so nodes and edges live in FLOW coordinates and pan/zoom is a
   single transform. ChildContent (FlowBackground, FlowControls, ...) renders beside the viewport
   layer inside the pane.

   Ownership: after the first render the viewport transform belongs to flow.js. .NET changes it
   only by stamping data-flow-viewport="x|y|zoom|id" on the pane; the engine's MutationObserver
   applies the stamp in the same frame the render lands. Pan, wheel zoom and node drag run in JS
   without a render per frame; .NET hears about them through the JSInvokable members below. *@

<div data-slot="flow-canvas"
     role="application"
     aria-label="@L["Flow.CanvasLabel"]"
     class="@RootClass"
     style="@RootStyle"
     data-flow-fit-pending="@(FitViewOnInit ? "" : null)"
     data-readonly="@(Readonly ? "" : null)"
     @attributes="AdditionalAttributes">
    <div @ref="_paneRef"
         data-slot="flow-pane"
         data-flow-viewport="@ViewportStamp"
         data-flow-generation="@_state.Generation.ToString(CultureInfo.InvariantCulture)"
         tabindex="-1"
         @onkeydown="HandlePaneKeyDownAsync"
         style="position:relative;width:100%;height:100%;overflow:hidden;touch-action:none;">
        <CascadingValue Value="_context" IsFixed="false">
            <div data-slot="flow-viewport" style="@_viewportLayerStyle">
                <FlowEdgeLayer />
                <div data-slot="flow-nodes">
                    @foreach (var node in _nodes)
                    {
                        <FlowNodeHost @key="node.Id" Node="node" />
                    }
                </div>
                @if (EdgesReconnectable && !Readonly)
                {
                    @* Reconnect grab handles: a SEPARATE overlay, rendered AFTER (so painted above)
                       the node layer — an edge's anchor point routinely coincides exactly with a
                       real FlowHandle button (same coordinates), which lives in the node layer and
                       would otherwise always win the pointer hit test. Pointer/touch only; no
                       keyboard equivalent yet (documented a11y gap in the docs page). *@
                    <svg aria-hidden="true" style="position:absolute;left:0;top:0;width:1px;height:1px;overflow:visible;pointer-events:none;">
                        @foreach (var (edge, _, sourcePt, targetPt) in RenderableEdges())
                        {
                            if (!IsEdgeSelected(edge.Id) || !CanSelectEdges) continue;
                            <circle @key="@("end-source-" + edge.Id)" data-flow-edge-end data-edge-id="@edge.Id" data-end="source"
                                    cx="@FlowGeometry.Fmt(sourcePt.X)" cy="@FlowGeometry.Fmt(sourcePt.Y)" r="6"
                                    style="fill:var(--color-primary);stroke:var(--color-background);stroke-width:1.5;cursor:grab;pointer-events:all;" />
                            <circle @key="@("end-target-" + edge.Id)" data-flow-edge-end data-edge-id="@edge.Id" data-end="target"
                                    cx="@FlowGeometry.Fmt(targetPt.X)" cy="@FlowGeometry.Fmt(targetPt.Y)" r="6"
                                    style="fill:var(--color-primary);stroke:var(--color-background);stroke-width:1.5;cursor:grab;pointer-events:all;" />
                        }
                    </svg>
                }
            </div>
            @ChildContent
        </CascadingValue>
    </div>
    @* Phase 4: a plain aria-live region for .NET-originated announcements (edge label commits) —
       everything else the engine announces itself (flow.js's own liveEl, connect/reconnect). *@
    <div aria-live="polite" class="sr-only">@_liveMessage</div>
</div>

@code {
    // ── Data ─────────────────────────────────────────────────────────────

    /// <summary>The nodes to render. Two-way bindable (<c>@bind-Nodes</c>): every committed drag or keyboard move emits a new list through <see cref="NodesChanged"/>. Without a binding the canvas keeps its own copy until you pass a different list.</summary>
    [Parameter] public IReadOnlyList<FlowNode>? Nodes { get; set; }

    /// <summary>Raised with the new node list after a committed drag or keyboard move.</summary>
    [Parameter] public EventCallback<IReadOnlyList<FlowNode>> NodesChanged { get; set; }

    /// <summary>The edges to draw between nodes. Edges whose source or target node is missing are skipped. Two-way bindable (<c>@@bind-Edges</c>): a committed connect or delete emits a new list through <see cref="EdgesChanged"/>. Without a binding the canvas keeps its own copy until you pass a different list — the same echo/replace rule <see cref="Nodes"/> follows.</summary>
    [Parameter] public IReadOnlyList<FlowEdge>? Edges { get; set; }

    /// <summary>Raised with the new edge list after a committed connect (when <see cref="OnConnect"/> has no handler) or a delete that removed edges.</summary>
    [Parameter] public EventCallback<IReadOnlyList<FlowEdge>> EdgesChanged { get; set; }

    /// <summary>The pan/zoom state. Two-way bindable (<c>@bind-Viewport</c>). Setting a new value moves the canvas; the canvas reports user pans and zooms back through <see cref="ViewportChanged"/>. A zoom of 0 or less means "not set" (the canvas starts at 0,0 and 100%).</summary>
    [Parameter] public FlowViewport Viewport { get; set; } = new(0, 0, 1);

    /// <summary>Raised when the viewport changes — at most once per animation frame while a pan or wheel zoom is running, once more when it ends, and after every imperative change (<see cref="FitViewAsync"/>, <see cref="ZoomInAsync"/>, ...).</summary>
    [Parameter] public EventCallback<FlowViewport> ViewportChanged { get; set; }

    /// <summary>Renders each node's content. The canvas wraps it in a positioned, focusable host. Without a template a node renders a small card with its <c>Data</c> (or <c>Id</c>).</summary>
    [Parameter] public RenderFragment<FlowNodeContext>? NodeTemplate { get; set; }

    /// <summary>Renders an edge's label. Without a template, <see cref="FlowEdge.Label"/> (when set) renders as a small themed pill. Positioned at the path midpoint and moved live by the engine while a connected node is dragged.</summary>
    [Parameter] public RenderFragment<FlowEdgeContext>? EdgeLabelTemplate { get; set; }

    /// <summary>Names a node for assistive technology (its host's <c>aria-label</c> and the "Connect from/to" handle labels). Without it every node is named by its <see cref="FlowNode.Id"/>.</summary>
    [Parameter] public Func<FlowNode, string>? NodeAriaLabel { get; set; }

    /// <summary>Overlays rendered inside the pane: <see cref="FlowBackground"/>, <see cref="FlowControls"/>, <see cref="FlowMiniMap"/>, <see cref="FlowPanel"/>, your own panels.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // ── Layout and behaviour ─────────────────────────────────────────────

    /// <summary>CSS height of the canvas.</summary>
    [Parameter] public string Height { get; set; } = "500px";

    /// <summary>Smallest zoom a gesture or method may reach.</summary>
    [Parameter] public double MinZoom { get; set; } = 0.25;

    /// <summary>Largest zoom a gesture or method may reach.</summary>
    [Parameter] public double MaxZoom { get; set; } = 2;

    /// <summary>Fits every node into view once the canvas has mounted and measured its nodes (the nodes stay invisible until then, so the un-fitted frame never shows).</summary>
    [Parameter] public bool FitViewOnInit { get; set; } = true;

    /// <summary>Breathing room for fit-view, as a fraction of the nodes' bounds (0.1 = 10%).</summary>
    [Parameter] public double FitViewPadding { get; set; } = 0.1;

    /// <summary>
    /// Snaps dragged and keyboard-moved nodes to <see cref="SnapGrid"/>. Two-way bindable
    /// (<c>@bind-SnapToGrid</c>) so <see cref="FlowControls"/>' <c>ShowSnapToggle</c> button can flip
    /// it; without a binding it still works, the canvas just keeps its own toggled copy after the
    /// first render (the same rule <see cref="Nodes"/>/<see cref="Edges"/> follow).
    /// </summary>
    [Parameter] public bool SnapToGrid { get; set; }

    /// <summary>Raised when <see cref="SnapToGrid"/> changes — a caller toggle, or <see cref="FlowControls"/>' snap button.</summary>
    [Parameter] public EventCallback<bool> SnapToGridChanged { get; set; }

    /// <summary>The snap grid in flow units (X, Y).</summary>
    [Parameter] public (double X, double Y) SnapGrid { get; set; } = (16, 16);

    /// <summary>Nodes can be moved by dragging or with the arrow keys.</summary>
    [Parameter] public bool NodesDraggable { get; set; } = true;

    /// <summary>Dragging the empty background pans the canvas. Holding Space pans from anywhere either way.</summary>
    [Parameter] public bool PanOnDrag { get; set; } = true;

    /// <summary>The mouse wheel zooms, anchored on the pointer (a plain wheel — no modifier — like React Flow; the page does not scroll while the pointer is over the canvas).</summary>
    [Parameter] public bool ZoomOnScroll { get; set; } = true;

    /// <summary>Dragging from a source <see cref="FlowHandle"/> to a target handle proposes a connection (pointer or keyboard — Enter on a source handle, then Enter on a target). ANDed with <see cref="FlowNode.Connectable"/> on both ends, <see cref="Readonly"/> and the controls' lock toggle.</summary>
    [Parameter] public bool NodesConnectable { get; set; } = true;

    /// <summary>Nodes and edges can be selected: click, shift/ctrl-click to toggle, shift-drag for a marquee (<see cref="SelectionOnShiftDrag"/>). ANDed with <see cref="FlowNode.Selectable"/> per node.</summary>
    [Parameter] public bool ElementsSelectable { get; set; } = true;

    /// <summary>Shift-dragging the empty background draws a marquee that selects every intersected, selectable node. Requires <see cref="ElementsSelectable"/>.</summary>
    [Parameter] public bool SelectionOnShiftDrag { get; set; } = true;

    /// <summary>Key names (<c>KeyboardEventArgs.Key</c>) that delete the current selection while focus is anywhere inside the canvas.</summary>
    [Parameter] public IReadOnlyList<string> DeleteKey { get; set; } = new[] { "Delete", "Backspace" };

    /// <summary>Turns every editing gesture off (node drag, keyboard move, connect and delete). Pan, zoom, selection and click events keep working.</summary>
    [Parameter] public bool Readonly { get; set; }

    /// <summary>
    /// When set, the canvas records a snapshot after every committed change (drag stop, keyboard
    /// move, connect, delete, an externally-applied <see cref="Nodes"/>/<see cref="Edges"/> replace
    /// such as an auto-layout result) and handles <c>Ctrl+Z</c> (undo), <c>Ctrl+Shift+Z</c> and
    /// <c>Ctrl+Y</c> (redo) while the canvas has focus. Selection changes alone do not push a
    /// snapshot. Share one <see cref="FlowHistory"/> with your own undo/redo UI if you have one —
    /// <see cref="UndoAsync"/>/<see cref="RedoAsync"/> are also public for that.
    /// </summary>
    [Parameter] public FlowHistory? History { get; set; }

    /// <summary>Lets an existing selected edge's end be re-dragged onto a different handle (a small grab handle at each end of a selected edge). See <see cref="OnReconnect"/>.</summary>
    [Parameter] public bool EdgesReconnectable { get; set; } = true;

    // ── Phase 4 ──────────────────────────────────────────────────────────

    /// <summary>
    /// What a connect gesture accepts. <see cref="FlowConnectionMode.Strict"/> (default) only lets a
    /// drag start on a Source handle and land on a Target handle, like every earlier phase.
    /// <see cref="FlowConnectionMode.Loose"/> lets a drag start on ANY handle and land on any OTHER
    /// handle (source-to-source, target-to-target included) — the drag's start becomes
    /// <see cref="FlowConnection.Source"/>, its end <see cref="FlowConnection.Target"/>, regardless of
    /// either handle's declared <see cref="FlowHandleType"/>. <see cref="IsValidConnection"/> still
    /// runs on top of either mode.
    /// </summary>
    [Parameter] public FlowConnectionMode ConnectionMode { get; set; } = FlowConnectionMode.Strict;

    /// <summary>
    /// While a single node is dragged (and <see cref="SnapToGrid"/> is off), snaps it to the nearest
    /// other node's left/centre/right and top/middle/bottom within <see cref="HelperLineThreshold"/>
    /// and draws the matching guide(s) in the edge SVG layer. Off by default. A multi-node drag
    /// (several selected nodes moved together) does not compute helper lines.
    /// </summary>
    [Parameter] public bool HelperLines { get; set; }

    /// <summary>How close (in flow units) a dragged node's edge must be to another node's for a helper line to appear.</summary>
    [Parameter] public double HelperLineThreshold { get; set; } = 5;

    /// <summary>
    /// Names newly created nodes for <c>Ctrl+V</c> (paste) and <c>Ctrl+D</c> (duplicate). Defaults to a
    /// short GUID-derived id (<c>"flow-node-" + Guid.NewGuid()</c>). Called once per copied node.
    /// </summary>
    [Parameter] public Func<FlowNode, string>? NewNodeId { get; set; }

    /// <summary>
    /// A hovered connection target is validated against <see cref="IsValidConnection"/> DURING the
    /// drag (one interop round trip per hovered handle change) instead of only on drop, and marked
    /// <c>data-flow-handle-invalid</c> when it would be rejected. Off by default — the structural
    /// heuristic (<c>data-flow-handle-valid</c>) is free; this costs a round trip per hover.
    /// </summary>
    [Parameter] public bool ValidateOnHover { get; set; }

    /// <summary>Double-clicking an edge's label opens an inline text box (Enter commits, Escape cancels). Off by default.</summary>
    [Parameter] public bool EdgeLabelEditable { get; set; }

    // ── Events ───────────────────────────────────────────────────────────

    /// <summary>A node was clicked (not raised for the click that ends a drag).</summary>
    [Parameter] public EventCallback<FlowNode> OnNodeClick { get; set; }

    /// <summary>A node was double-clicked.</summary>
    [Parameter] public EventCallback<FlowNode> OnNodeDoubleClick { get; set; }

    /// <summary>A node was right-clicked. The browser menu is suppressed while this has a handler.</summary>
    [Parameter] public EventCallback<FlowNodeContextMenuEventArgs> OnNodeContextMenu { get; set; }

    /// <summary>The empty background was clicked (not dragged); the point is in flow coordinates.</summary>
    [Parameter] public EventCallback<FlowPoint> OnPaneClick { get; set; }

    /// <summary>A drag (or arrow-key move) was committed; one entry per moved node. Raised after <see cref="NodesChanged"/>.</summary>
    [Parameter] public EventCallback<IReadOnlyList<FlowNodeChange>> OnNodeDragStop { get; set; }

    /// <summary>An edge was clicked (not raised for the click that ends a drag or that opens a connection).</summary>
    [Parameter] public EventCallback<FlowEdge> OnEdgeClick { get; set; }

    /// <summary>
    /// A connection was dropped on a compatible target handle and passed <see cref="IsValidConnection"/>.
    /// Without a handler the canvas appends a new <see cref="FlowEdge"/> itself and raises <see cref="EdgesChanged"/>.
    /// </summary>
    [Parameter] public EventCallback<FlowConnection> OnConnect { get; set; }

    /// <summary>Called for every proposed connection (pointer drop or keyboard commit) before it is accepted. Returning <c>false</c> rejects it — no edge is added and <see cref="OnConnect"/> is not raised.</summary>
    [Parameter] public Func<FlowConnection, bool>? IsValidConnection { get; set; }

    /// <summary>
    /// An existing selected edge's end was dragged onto a different (or the same) compatible handle
    /// and passed <see cref="IsValidConnection"/>. Without a handler the canvas replaces the edge's
    /// moved end itself and raises <see cref="EdgesChanged"/>. Requires <see cref="EdgesReconnectable"/>.
    /// </summary>
    [Parameter] public EventCallback<FlowReconnectEventArgs> OnReconnect { get; set; }

    /// <summary>Raised after the selection changes — a click, shift/ctrl-click, marquee, edge click, <see cref="SelectAsync"/>, <see cref="ClearSelectionAsync"/> or a pane click/Escape that clears it.</summary>
    [Parameter] public EventCallback<FlowSelection> OnSelectionChanged { get; set; }

    /// <summary>
    /// <see cref="DeleteKey"/> was pressed with a non-empty, deletable selection.
    /// Without a handler the canvas removes the selected nodes (and every edge touching one of them)
    /// and the directly selected edges itself, raising <see cref="NodesChanged"/>/<see cref="EdgesChanged"/>.
    /// </summary>
    [Parameter] public EventCallback<FlowSelection> OnDelete { get; set; }

    /// <summary>A node was resized by a <see cref="FlowNodeResizer"/> grip or Shift+arrow keys; one entry per resized node. Raised after <see cref="NodesChanged"/>.</summary>
    [Parameter] public EventCallback<IReadOnlyList<FlowNodeResizeChange>> OnNodeResizeStop { get; set; }

    /// <summary><c>Ctrl+V</c> pasted (or <c>Ctrl+D</c> duplicated) a selection. Raised after <see cref="NodesChanged"/>/<see cref="EdgesChanged"/>, with the NEW nodes/edges selected.</summary>
    [Parameter] public EventCallback<FlowPasteEventArgs> OnPaste { get; set; }

    /// <summary>
    /// An edge's inline-edited label was committed (<see cref="EdgeLabelEditable"/>, Enter). Unlike
    /// <see cref="OnConnect"/>/<see cref="OnDelete"/>/<see cref="OnReconnect"/> this is a plain
    /// notification, not a veto point — there is nothing to validate — so the canvas ALWAYS updates
    /// <see cref="FlowEdge.Label"/> itself and raises <see cref="EdgesChanged"/> first, then this.
    /// </summary>
    [Parameter] public EventCallback<FlowEdge> OnEdgeLabelChanged { get; set; }

    /// <summary>Additional CSS classes merged onto the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Captures unmatched attributes and applies them to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// What the canvas cascades to <see cref="FlowBackground"/>, <see cref="FlowControls"/> and its own
    /// node/edge layers. Re-created on every render (cascaded with <c>IsFixed="false"</c>).
    /// </summary>
    /// <param name="Canvas">The owning canvas.</param>
    /// <param name="Viewport">The latest known viewport.</param>
    /// <param name="InitialViewport">The viewport of the first render — what server-rendered transforms use; the engine owns them after mount.</param>
    /// <param name="Locked">The lock toggle is on (no node drag).</param>
    /// <param name="MinZoom">The canvas' <c>MinZoom</c>.</param>
    /// <param name="MaxZoom">The canvas' <c>MaxZoom</c>.</param>
    /// <param name="SnapToGrid">The canvas' effective <see cref="FlowCanvas.SnapToGrid"/> (parameter value or an internal toggle from <see cref="FlowControls"/>' snap button).</param>
    /// <param name="HistoryVersion">Bumped on every <see cref="FlowHistory"/> push/undo/redo — its only job is giving this otherwise-unchanged record a reason to cascade again so <see cref="FlowControls"/>' undo/redo buttons re-evaluate <c>CanUndo</c>/<c>CanRedo</c>.</param>
    public record FlowCanvasContext(FlowCanvas Canvas, FlowViewport Viewport, FlowViewport InitialViewport, bool Locked, double MinZoom, double MaxZoom, bool SnapToGrid, int HistoryVersion);

    // ── State ────────────────────────────────────────────────────────────

    [CascadingParameter(Name = "LumeoDirection")] private LayoutDirection? Direction { get; set; }

    internal readonly FlowState _state = new();
    private ElementReference _paneRef;
    private DotNetObjectReference<FlowCanvas>? _selfRef;
    private IReadOnlyList<FlowNode> _nodes = Array.Empty<FlowNode>();
    private IReadOnlyList<FlowNode>? _lastNodesParam;
    private readonly List<IReadOnlyList<FlowNode>> _recentEmitted = new();
    private IReadOnlyList<FlowEdge> _edges = Array.Empty<FlowEdge>();
    private IReadOnlyList<FlowEdge>? _lastEdgesParam;
    private readonly List<IReadOnlyList<FlowEdge>> _recentEmittedEdges = new();
    private FlowViewport _lastViewportParam;
    private FlowViewport _initialViewport = new(0, 0, 1);
    private string _viewportLayerStyle = "";
    private FlowCanvasContext _context = default!;
    private bool _initialized;
    private bool _locked;
    private bool _snapOverride;
    private bool _snapInitialized;
    private bool _lastSnapToGridParam;
    private int _historyVersion;
    private bool _registered;
    private bool _disposed;
    private FlowEngineOptions? _lastOptions;
    private string? _liveMessage;

    // Phase 4: nodes with a FlowNodeResizer in their template (registered by the resizer itself)
    // and their resize limits — lets Shift+arrow keyboard resize know which focused node has one
    // (and its Min/Max) without FlowCanvas knowing anything about node-template internals.
    private readonly Dictionary<string, (double MinWidth, double MinHeight, double? MaxWidth, double? MaxHeight)> _resizers = new(StringComparer.Ordinal);

    // Phase 4: Ctrl+C's snapshot for Ctrl+V. Ctrl+D duplicates the CURRENT selection directly and
    // never touches this.
    private (List<FlowNode> Nodes, List<FlowEdge> Edges)? _clipboard;

    /// <summary>The options bag pushed to flow.js. A record, so "changed?" is structural equality.</summary>
    internal sealed record FlowEngineOptions(
        double MinZoom, double MaxZoom, bool SnapToGrid, double SnapX, double SnapY,
        bool NodesDraggable, bool PanOnDrag, bool ZoomOnScroll, bool Readonly,
        bool FitViewOnInit, double FitViewPadding,
        bool Connectable, bool ElementsSelectable, bool SelectionOnShiftDrag, bool Rtl,
        bool Reconnectable, FlowEngineStrings Strings,
        bool Loose, bool HelperLines, double HelperLineThreshold, bool ValidateOnHover)
    {
        /// <summary>Serialised as <c>snap</c>: <c>[gx, gy]</c> or null.</summary>
        public double[]? Snap => SnapToGrid ? new[] { SnapX, SnapY } : null;

        /// <summary>Serialised as <c>connectionMode</c>: <c>"loose"</c>/<c>"strict"</c> — flow.js's own vocabulary, not the C# enum's casing.</summary>
        public string ConnectionMode => Loose ? "loose" : "strict";
    }

    /// <summary>
    /// The localized strings the engine needs for its own aria-live announcements (keyboard connect
    /// and reconnect) — pushed once up front with the rest of the options so no keystroke needs a
    /// .NET round trip. <c>{0}</c> in <see cref="ConnectingFrom"/> is replaced with the source node's
    /// id (matching <c>Flow.ConnectFrom</c>'s own <c>{0}</c> placeholder).
    /// </summary>
    internal sealed record FlowEngineStrings(
        string ConnectingFrom, string Connected, string ConnectionRejected, string ConnectionCancelled,
        string Reconnected, string ReconnectRejected);

    /// <summary>The viewport as .NET last knows it (engine reports and imperative changes).</summary>
    public FlowViewport CurrentViewport => _state.Viewport;

    /// <summary>The nodes as currently rendered (the bound list, or the canvas' own copy).</summary>
    public IReadOnlyList<FlowNode> CurrentNodes => _nodes;

    /// <summary>The edges as currently rendered (the bound list, or the canvas' own copy).</summary>
    public IReadOnlyList<FlowEdge> CurrentEdges => _edges;

    /// <summary>Every node's measured (width, height) known so far — pass to <see cref="FlowLayout.Tree"/>/<see cref="FlowLayout.Layered"/>'s <c>measured</c> parameter so a layout uses real sizes instead of the library default for nodes without a fixed <see cref="FlowNode.Width"/>/<see cref="FlowNode.Height"/>.</summary>
    public IReadOnlyDictionary<string, (double Width, double Height)> MeasuredSizes => _state.SnapshotSizes();

    internal bool Locked => _locked;
    /// <summary>The effective <see cref="SnapToGrid"/> — the last value from the parameter or an internal toggle (<see cref="SetSnapToGridAsync"/>), whichever happened more recently.</summary>
    internal bool EffectiveSnapToGrid => _snapOverride;
    internal bool CanMoveNodes => NodesDraggable && !Readonly && !_locked;
    internal bool CanConnectGlobally => NodesConnectable && !Readonly && !_locked;
    internal bool CanConnect(FlowNode node) => CanConnectGlobally && node.Connectable;
    internal bool CanSelectEdges => ElementsSelectable;
    internal string AriaLabelFor(FlowNode node) => NodeAriaLabel?.Invoke(node) ?? node.Id;
    internal FlowRect GetNodeRect(FlowNode node) => _state.GetNodeRect(node);
    internal FlowNode? SingleSelectedNode() => _state.SelectedNodeIds.Count == 1
        ? _nodes.FirstOrDefault(n => n.Id == _state.SelectedNodeIds.First())
        : null;
    internal (double Width, double Height) PaneSize => (_state.PaneWidth, _state.PaneHeight);

    /// <summary>The union of every selected node's rect, for <see cref="FlowNodeToolbar"/>'s multi-selection layout. Null with zero nodes selected.</summary>
    internal FlowRect? SelectedNodesBounds()
        => _state.SelectedNodeIds.Count == 0
            ? null
            : FlowGeometry.GetBounds(_nodes.Where(n => _state.SelectedNodeIds.Contains(n.Id)).Select(_state.GetNodeRect));

    // Phase 4: FlowNodeResizer registers/unregisters itself here (its own OnParametersSet/Dispose) so
    // Shift+arrow keyboard resize (HandleNodeKeyDownAsync) knows a focused node HAS a resizer, and
    // its Min/Max, without FlowCanvas reaching into NodeTemplate content.
    internal void RegisterResizer(string nodeId, double minWidth, double minHeight, double? maxWidth, double? maxHeight)
        => _resizers[nodeId] = (minWidth, minHeight, maxWidth, maxHeight);

    internal void UnregisterResizer(string nodeId) => _resizers.Remove(nodeId);

    private void Announce(string message)
    {
        _liveMessage = message;
        StateHasChanged();
    }

    private string RootClass => Cx.Merge(
        "relative block w-full overflow-hidden rounded-lg border border-border bg-background text-foreground",
        Class);

    private string RootStyle => "height:" + Height + ";";

    private string ViewportStamp
    {
        get
        {
            var v = _state.StampedViewport;
            return R(v.X) + "|" + R(v.Y) + "|" + R(v.Zoom) + "|" + _state.StampId.ToString(CultureInfo.InvariantCulture);
        }
    }

    internal static string R(double value) => (value == 0 ? 0 : value).ToString("R", CultureInfo.InvariantCulture);

    private static string LayerStyle(FlowViewport v)
        => "position:absolute;left:0;top:0;z-index:1;transform-origin:0 0;transform:translate("
           + R(v.X) + "px, " + R(v.Y) + "px) scale(" + R(v.Zoom) + ");";

    private FlowViewport Sanitize(FlowViewport v)
    {
        if (!(v.Zoom > 0) || !double.IsFinite(v.Zoom) || !double.IsFinite(v.X) || !double.IsFinite(v.Y)) return new(0, 0, 1);
        return v with { Zoom = FlowGeometry.ClampZoom(v.Zoom, MinZoom, MaxZoom) };
    }

    protected override void OnParametersSet()
    {
        var wasInitialized = _initialized;
        var externalReplace = false; // Nodes or Edges replaced from OUTSIDE after init (e.g. an
                                      // applied FlowLayout result) — a History commit, not an echo.

        // Nodes: a list we emitted ourselves coming back through @bind-Nodes is an echo; anything
        // else replaces the state from outside and bumps the generation, so a drag that started
        // before it can never commit over it.
        if (!_initialized || !ReferenceEquals(Nodes, _lastNodesParam))
        {
            _lastNodesParam = Nodes;
            var incoming = Nodes ?? Array.Empty<FlowNode>();
            var emittedIndex = _recentEmitted.FindIndex(l => ReferenceEquals(l, Nodes));
            if (!_initialized)
            {
                _nodes = incoming;
            }
            else if (emittedIndex >= 0)
            {
                // Our own list. Only the latest one is current; an older echo (two commits in quick
                // succession, the parent catching up) must not roll the canvas back.
                if (emittedIndex == _recentEmitted.Count - 1) _nodes = incoming;
            }
            else
            {
                _nodes = incoming;
                _state.BumpGeneration();
                externalReplace = true;
            }
            _state.ForgetMissing(_nodes);
            if (_state.SelectedNodeIds.Count > 0)
            {
                var live = new HashSet<string>(_nodes.Select(n => n.Id), StringComparer.Ordinal);
                _state.SelectedNodeIds.RemoveWhere(id => !live.Contains(id));
            }
        }

        // Edges: the same echo/replace rule as Nodes, without a generation (edges are not committed
        // through a JS drag, so there is no "stale drag" race to guard against).
        if (!_initialized || !ReferenceEquals(Edges, _lastEdgesParam))
        {
            _lastEdgesParam = Edges;
            var incoming = Edges ?? Array.Empty<FlowEdge>();
            var emittedIndex = _recentEmittedEdges.FindIndex(l => ReferenceEquals(l, Edges));
            if (!_initialized || emittedIndex < 0)
            {
                _edges = incoming;
                if (_initialized && emittedIndex < 0) externalReplace = true;
            }
            else if (emittedIndex == _recentEmittedEdges.Count - 1)
            {
                _edges = incoming;
            }
            if (_state.SelectedEdgeIds.Count > 0)
            {
                var live = new HashSet<string>(_edges.Select(e => e.Id), StringComparer.Ordinal);
                _state.SelectedEdgeIds.RemoveWhere(id => !live.Contains(id));
            }
        }

        // Viewport: the first value seeds the state and the server-rendered transform; later values
        // are instructions unless they are an echo of what the engine reported.
        if (!_initialized)
        {
            _initialViewport = Sanitize(Viewport);
            _state.Initialize(_initialViewport);
            _viewportLayerStyle = LayerStyle(_initialViewport);
            _lastViewportParam = Viewport;
        }
        else if (Viewport != _lastViewportParam)
        {
            _lastViewportParam = Viewport;
            var v = Sanitize(Viewport);
            if (!_state.IsEcho(Viewport) && !_state.IsEcho(v)) _state.Stamp(v);
        }

        // SnapToGrid: the first value seeds the toggle; a later value different from what we last
        // observed is a fresh instruction from outside (a real @bind-SnapToGrid, or the caller just
        // changed the literal) and wins over whatever FlowControls' button last set — an internal
        // toggle updates _lastSnapToGridParam itself (SetSnapToGridAsync), so its own echo through
        // @bind never re-triggers this branch.
        if (!_snapInitialized)
        {
            _snapOverride = SnapToGrid;
            _lastSnapToGridParam = SnapToGrid;
            _snapInitialized = true;
        }
        else if (SnapToGrid != _lastSnapToGridParam)
        {
            _lastSnapToGridParam = SnapToGrid;
            _snapOverride = SnapToGrid;
        }

        _initialized = true;
        RefreshContext();

        // History: seed the undo baseline once, before the first edit; push once for any externally
        // applied Nodes/Edges replace after that (e.g. Nodes = FlowLayout.Tree(...)) so it can be
        // undone too — a canvas-internal commit (drag/connect/delete/keyboard move) pushes itself,
        // right after it applies, not here (so it stays exactly one push per commit).
        if (History is not null)
        {
            if (!wasInitialized && History.Current is null) History.Push(_nodes, _edges);
            else if (wasInitialized && externalReplace) PushHistory();
        }
    }

    private void PushHistory()
    {
        if (History is null) return;
        History.Push(_nodes, _edges);
        BumpHistoryVersion();
    }

    // Bumps _historyVersion and re-renders so FlowControls' undo/redo buttons re-evaluate
    // CanUndo/CanRedo — FlowCanvasContext is a record (structural equality), so without an actual
    // field change the CascadingValue would not notify its consumers at all.
    private void BumpHistoryVersion()
    {
        _historyVersion++;
        RefreshContext();
        StateHasChanged();
    }

    /// <summary>Moves one step back in <see cref="History"/> and applies it, or does nothing without a history / without anything to undo.</summary>
    public Task UndoAsync() => ApplyHistoryStepAsync(History?.Undo());

    /// <summary>Moves one step forward in <see cref="History"/> and applies it, or does nothing without a history / without anything to redo.</summary>
    public Task RedoAsync() => ApplyHistoryStepAsync(History?.Redo());

    private async Task ApplyHistoryStepAsync(FlowHistory.Snapshot? snapshot)
    {
        if (snapshot is null) return;
        // A drag (or any gesture) in flight against the pre-undo nodes must never land on top of
        // this — same guard an externally replaced node list gets.
        _state.BumpGeneration();
        _nodes = snapshot.Nodes;
        _recentEmitted.Add(_nodes);
        if (_recentEmitted.Count > 8) _recentEmitted.RemoveAt(0);
        _edges = snapshot.Edges;
        _recentEmittedEdges.Add(_edges);
        if (_recentEmittedEdges.Count > 8) _recentEmittedEdges.RemoveAt(0);
        _state.ForgetMissing(_nodes);
        var liveNodes = new HashSet<string>(_nodes.Select(n => n.Id), StringComparer.Ordinal);
        _state.SelectedNodeIds.RemoveWhere(id => !liveNodes.Contains(id));
        var liveEdges = new HashSet<string>(_edges.Select(e => e.Id), StringComparer.Ordinal);
        _state.SelectedEdgeIds.RemoveWhere(id => !liveEdges.Contains(id));
        BumpHistoryVersion(); // also calls StateHasChanged()
        if (NodesChanged.HasDelegate) await NodesChanged.InvokeAsync(_nodes);
        if (EdgesChanged.HasDelegate) await EdgesChanged.InvokeAsync(_edges);
    }

    private void RefreshContext()
        => _context = new FlowCanvasContext(this, _state.Viewport, _initialViewport, _locked, MinZoom, MaxZoom, _snapOverride, _historyVersion);

    private FlowEngineOptions BuildOptions() => new(
        MinZoom, MaxZoom, EffectiveSnapToGrid, SnapGrid.X, SnapGrid.Y,
        CanMoveNodes, PanOnDrag, ZoomOnScroll, Readonly,
        FitViewOnInit, FitViewPadding,
        CanConnectGlobally, ElementsSelectable, SelectionOnShiftDrag, Direction == LayoutDirection.Rtl,
        EdgesReconnectable && !Readonly, BuildStrings(),
        ConnectionMode == FlowConnectionMode.Loose, HelperLines && !Readonly, HelperLineThreshold, ValidateOnHover);

    private FlowEngineStrings BuildStrings() => new(
        L["Flow.ConnectingFrom"], L["Flow.Connected"], L["Flow.ConnectionRejected"], L["Flow.ConnectionCancelled"],
        L["Flow.Reconnected"], L["Flow.ReconnectRejected"]);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var options = BuildOptions();
        if (firstRender)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            // Claimed BEFORE the await (memory: guard before the await) — a dispose that lands while
            // the register call is in flight sees it and unregisters; the re-check after the await
            // below closes the other half of that race.
            _registered = true;
            _lastOptions = options;
            try
            {
                await Interop.FlowRegisterCanvasAsync(_paneRef, _selfRef, options);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (Exception)
            {
                // A custom interop service that throws: the canvas degrades to a static render
                // instead of taking the page down. A later render does not retry — registration
                // is a mount-time contract.
                _registered = false;
            }
            if (_disposed)
            {
                try { await Interop.FlowUnregisterCanvasAsync(_paneRef); }
                catch (JSDisconnectedException) { }
            }
            return;
        }

        if (_registered && !_disposed && options != _lastOptions)
        {
            _lastOptions = options;
            try { await Interop.FlowUpdateOptionsAsync(_paneRef, options); }
            catch (JSDisconnectedException) { }
        }
    }

    // ── Node rendering helpers (used by FlowNodeHost / FlowEdgeLayer) ────

    internal bool IsSelected(string id) => _state.SelectedNodeIds.Contains(id);
    internal bool IsEdgeSelected(string id) => _state.SelectedEdgeIds.Contains(id);
    internal bool IsDragging(string id) => _state.DraggingNodeIds.Contains(id);
    internal bool CanDrag(FlowNode node) => CanMoveNodes && node.Draggable;
    internal bool HasContextMenuHandler => OnNodeContextMenu.HasDelegate;

    internal RenderFragment RenderNodeContent(FlowNodeContext context)
        => NodeTemplate is not null ? NodeTemplate(context) : DefaultNodeContent(context);

    private static RenderFragment DefaultNodeContent(FlowNodeContext context) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "rounded-md border border-border bg-card px-3 py-2 text-sm text-card-foreground shadow-sm");
        builder.AddContent(2, context.Node.Data?.ToString() ?? context.Node.Id);
        builder.CloseElement();
    };

    internal IEnumerable<(FlowEdge Edge, FlowEdgePath Path, FlowPoint Source, FlowPoint Target)> RenderableEdges()
    {
        if (_edges.Count == 0) yield break;
        var byId = new Dictionary<string, FlowNode>(StringComparer.Ordinal);
        foreach (var n in _nodes) byId[n.Id] = n;
        foreach (var edge in _edges)
        {
            if (edge is null) continue;
            if (!byId.TryGetValue(edge.Source, out var s) || !byId.TryGetValue(edge.Target, out var t)) continue;
            var (sp, spos) = _state.GetAnchor(s, edge.SourceHandle, FlowHandleType.Source);
            var (tp, tpos) = _state.GetAnchor(t, edge.TargetHandle, FlowHandleType.Target);
            yield return (edge, FlowGeometry.GetEdgePath(edge.Type, sp.X, sp.Y, spos, tp.X, tp.Y, tpos), sp, tp);
        }
    }

    // ── Node events (from FlowNodeHost) ──────────────────────────────────

    internal async Task HandleNodeClickAsync(FlowNode node, bool shift, bool ctrl)
    {
        if (ElementsSelectable && node.Selectable)
        {
            var toggle = shift || ctrl;
            var changed = true;
            if (toggle)
            {
                if (!_state.SelectedNodeIds.Add(node.Id)) _state.SelectedNodeIds.Remove(node.Id);
            }
            else if (_state.SelectedNodeIds.Count == 1 && _state.SelectedEdgeIds.Count == 0 && _state.SelectedNodeIds.Contains(node.Id))
            {
                changed = false;
            }
            else
            {
                _state.SelectedNodeIds.Clear();
                _state.SelectedEdgeIds.Clear();
                _state.SelectedNodeIds.Add(node.Id);
            }
            if (changed)
            {
                StateHasChanged();
                await RaiseSelectionChangedAsync();
            }
        }
        if (OnNodeClick.HasDelegate) await OnNodeClick.InvokeAsync(node);
    }

    internal Task HandleNodeDoubleClickAsync(FlowNode node)
        => OnNodeDoubleClick.HasDelegate ? OnNodeDoubleClick.InvokeAsync(node) : Task.CompletedTask;

    internal Task HandleNodeContextMenuAsync(FlowNode node, MouseEventArgs e)
        => OnNodeContextMenu.HasDelegate
            ? OnNodeContextMenu.InvokeAsync(new FlowNodeContextMenuEventArgs(node, e.ClientX, e.ClientY))
            : Task.CompletedTask;

    internal async Task HandleEdgeClickAsync(FlowEdge edge, bool shift, bool ctrl)
    {
        if (ElementsSelectable)
        {
            var toggle = shift || ctrl;
            if (toggle)
            {
                if (!_state.SelectedEdgeIds.Add(edge.Id)) _state.SelectedEdgeIds.Remove(edge.Id);
            }
            else
            {
                _state.SelectedNodeIds.Clear();
                _state.SelectedEdgeIds.Clear();
                _state.SelectedEdgeIds.Add(edge.Id);
            }
            StateHasChanged();
            await RaiseSelectionChangedAsync();
        }
        if (OnEdgeClick.HasDelegate) await OnEdgeClick.InvokeAsync(edge);
    }

    internal async Task HandleNodeKeyDownAsync(FlowNode node, KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                await ClearSelectionInternalAsync();
                return;
            case "ArrowLeft":
            case "ArrowRight":
            case "ArrowUp":
            case "ArrowDown":
                // A node template can render its own focusable content (an inline-edit <input>, an
                // inspector field). The arrow-nudge must leave an editable target's own cursor
                // movement/text-selection keys alone — checked here, not just in flow.js, because
                // KeyboardEventArgs carries no DOM target for a pure-.NET check to use directly.
                if (await IsKeydownFromEditableTargetAsync()) return;
                // Phase 4: Shift+arrow on a node that carries a FlowNodeResizer resizes it instead of
                // the plain "move ×10" every other node's Shift+arrow still does — a resizer changes
                // what Shift means for ITS node, the same way its pointer grips add a new gesture
                // rather than repurposing the drag one.
                if (e.ShiftKey && _resizers.ContainsKey(node.Id))
                {
                    await ResizeByKeyboardAsync(node, e.Key);
                    return;
                }
                await MoveByKeyboardAsync(node, e.Key, e.ShiftKey);
                return;
        }
    }

    private async Task HandlePaneKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await ClearSelectionInternalAsync();
            return;
        }
        // Same guard as the arrow-nudge above: undo/redo/delete must not fire while the user is
        // typing in an editable field somewhere inside the canvas (a node's own input, an
        // inspector panel rendered through ChildContent/FlowPanel) — native browser undo and
        // text editing inside that field keep working since nothing here calls preventDefault.
        if (await IsKeydownFromEditableTargetAsync()) return;
        if ((e.CtrlKey || e.MetaKey) && !e.AltKey)
        {
            if (History is not null)
            {
                // Ctrl+Z: undo. Ctrl+Shift+Z and Ctrl+Y: redo (both spellings — Windows/Linux apps
                // split on this; supporting either costs nothing).
                if (string.Equals(e.Key, "z", StringComparison.OrdinalIgnoreCase))
                {
                    await (e.ShiftKey ? RedoAsync() : UndoAsync());
                    return;
                }
                if (string.Equals(e.Key, "y", StringComparison.OrdinalIgnoreCase))
                {
                    await RedoAsync();
                    return;
                }
            }
            // Phase 4 clipboard: Ctrl+C copies, Ctrl+V pastes, Ctrl+D duplicates — none take Shift,
            // so they never collide with Ctrl+Shift+Z above.
            if (!e.ShiftKey)
            {
                if (string.Equals(e.Key, "c", StringComparison.OrdinalIgnoreCase))
                {
                    CopySelection();
                    return;
                }
                if (string.Equals(e.Key, "v", StringComparison.OrdinalIgnoreCase))
                {
                    await PasteAsync();
                    return;
                }
                if (string.Equals(e.Key, "d", StringComparison.OrdinalIgnoreCase))
                {
                    await DuplicateSelectionAsync();
                    return;
                }
            }
        }
        if (DeleteKey.Contains(e.Key)) await DeleteSelectionAsync();
    }

    // Shared by both keydown paths above (and flow.js's own pane keydown listener applies the
    // identical rule independently — see isKeyboardExempt/isFocusedElementEditable in flow.js —
    // so the guard exists once per runtime, not once globally, because .NET and JS never share a
    // call stack for the same event).
    private Task<bool> IsKeydownFromEditableTargetAsync()
        => _registered && !_disposed ? Interop.FlowIsFocusedElementEditableAsync(_paneRef) : Task.FromResult(false);

    private async Task ClearSelectionInternalAsync()
    {
        if (!_state.ClearSelection()) return;
        StateHasChanged();
        await RaiseSelectionChangedAsync();
    }

    private Task RaiseSelectionChangedAsync()
        => OnSelectionChanged.HasDelegate
            ? OnSelectionChanged.InvokeAsync(new FlowSelection(
                new HashSet<string>(_state.SelectedNodeIds, StringComparer.Ordinal),
                new HashSet<string>(_state.SelectedEdgeIds, StringComparer.Ordinal)))
            : Task.CompletedTask;

    /// <summary>Deletes the current selection: honours <see cref="Readonly"/> and each element's <c>Deletable</c> flag. Without <see cref="OnDelete"/> the canvas removes the selected nodes (plus every edge touching one of them) and the directly selected edges itself.</summary>
    internal async Task DeleteSelectionAsync()
    {
        if (Readonly) return;
        var nodeIds = new HashSet<string>(StringComparer.Ordinal);
        foreach (var id in _state.SelectedNodeIds)
        {
            var n = _nodes.FirstOrDefault(x => x.Id == id);
            if (n is not null && n.Deletable) nodeIds.Add(id);
        }
        var edgeIds = new HashSet<string>(StringComparer.Ordinal);
        foreach (var id in _state.SelectedEdgeIds)
        {
            var edge = _edges.FirstOrDefault(x => x.Id == id);
            if (edge is not null && edge.Deletable) edgeIds.Add(id);
        }
        if (nodeIds.Count == 0 && edgeIds.Count == 0) return;

        var selection = new FlowSelection(nodeIds, edgeIds);
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(selection);
            return;
        }

        if (nodeIds.Count > 0)
        {
            var nextNodes = _nodes.Where(n => !nodeIds.Contains(n.Id)).ToList();
            await EmitNodesAsync(nextNodes);
        }
        var nextEdges = _edges.Where(e => !edgeIds.Contains(e.Id) && !nodeIds.Contains(e.Source) && !nodeIds.Contains(e.Target)).ToList();
        if (nextEdges.Count != _edges.Count) await EmitEdgesAsync(nextEdges);
        PushHistory();

        _state.SelectedNodeIds.Clear();
        _state.SelectedEdgeIds.Clear();
        StateHasChanged();
        await RaiseSelectionChangedAsync();
    }

    private async Task MoveByKeyboardAsync(FlowNode node, string key, bool shift)
    {
        if (!CanMoveNodes) return;
        var current = _nodes.FirstOrDefault(n => n.Id == node.Id);
        if (current is null || !current.Draggable) return;

        var stepX = EffectiveSnapToGrid && SnapGrid.X > 0 ? SnapGrid.X : 1;
        var stepY = EffectiveSnapToGrid && SnapGrid.Y > 0 ? SnapGrid.Y : 1;
        if (shift) { stepX *= 10; stepY *= 10; }
        var (dx, dy) = key switch
        {
            "ArrowLeft" => (-stepX, 0d),
            "ArrowRight" => (stepX, 0d),
            "ArrowUp" => (0d, -stepY),
            _ => (0d, stepY),
        };

        // The focused node, plus the rest of the selection when the focused node is part of it.
        var moving = _state.SelectedNodeIds.Contains(current.Id)
            ? new HashSet<string>(_state.SelectedNodeIds, StringComparer.Ordinal)
            : new HashSet<string>(StringComparer.Ordinal) { current.Id };

        var changes = new List<FlowNodeChange>();
        var next = new List<FlowNode>(_nodes.Count);
        foreach (var n in _nodes)
        {
            if (moving.Contains(n.Id) && n.Draggable)
            {
                var x = n.X + dx;
                var y = n.Y + dy;
                if (EffectiveSnapToGrid)
                {
                    x = FlowGeometry.Snap(x, SnapGrid.X);
                    y = FlowGeometry.Snap(y, SnapGrid.Y);
                }
                next.Add(n with { X = x, Y = y });
                changes.Add(new FlowNodeChange(n.Id, x, y));
            }
            else
            {
                next.Add(n);
            }
        }
        if (changes.Count == 0) return;
        await EmitNodesAsync(next);
        PushHistory();
        if (OnNodeDragStop.HasDelegate) await OnNodeDragStop.InvokeAsync(changes);
    }

    // ── Phase 4: resize (keyboard) ───────────────────────────────────────

    private async Task ResizeByKeyboardAsync(FlowNode node, string key)
    {
        if (Readonly || _locked) return;
        var current = _nodes.FirstOrDefault(n => n.Id == node.Id);
        if (current is null || !_resizers.TryGetValue(node.Id, out var limits)) return;

        var rect = _state.GetNodeRect(current);
        var step = EffectiveSnapToGrid && SnapGrid.X > 0 ? SnapGrid.X : 8;
        var (dw, dh) = key switch
        {
            "ArrowLeft" => (-step, 0d),
            "ArrowRight" => (step, 0d),
            "ArrowUp" => (0d, -step),
            _ => (0d, step),
        };
        var width = Math.Max(limits.MinWidth, rect.Width + dw);
        if (limits.MaxWidth is { } maxW) width = Math.Min(maxW, width);
        var height = Math.Max(limits.MinHeight, rect.Height + dh);
        if (limits.MaxHeight is { } maxH) height = Math.Min(maxH, height);
        if (width == rect.Width && height == rect.Height) return;

        var updated = current with { X = rect.X, Y = rect.Y, Width = width, Height = height };
        await EmitNodesAsync(_nodes.Select(n => n.Id == node.Id ? updated : n).ToList());
        PushHistory();
        if (OnNodeResizeStop.HasDelegate)
            await OnNodeResizeStop.InvokeAsync(new[] { new FlowNodeResizeChange(node.Id, rect.X, rect.Y, width, height) });
    }

    // ── Phase 4: clipboard ───────────────────────────────────────────────

    private void CopySelection()
    {
        if (_state.SelectedNodeIds.Count == 0) return;
        var nodes = _nodes.Where(n => _state.SelectedNodeIds.Contains(n.Id)).ToList();
        var ids = new HashSet<string>(nodes.Select(n => n.Id), StringComparer.Ordinal);
        var edges = _edges.Where(e => ids.Contains(e.Source) && ids.Contains(e.Target)).ToList();
        _clipboard = (nodes, edges);
    }

    private Task PasteAsync() => _clipboard is { } clip ? PasteNodesAsync(clip.Nodes, clip.Edges) : Task.CompletedTask;

    private Task DuplicateSelectionAsync()
    {
        if (_state.SelectedNodeIds.Count == 0) return Task.CompletedTask;
        var nodes = _nodes.Where(n => _state.SelectedNodeIds.Contains(n.Id)).ToList();
        var ids = new HashSet<string>(nodes.Select(n => n.Id), StringComparer.Ordinal);
        var edges = _edges.Where(e => ids.Contains(e.Source) && ids.Contains(e.Target)).ToList();
        return PasteNodesAsync(nodes, edges);
    }

    // Shared by Ctrl+V and Ctrl+D: new ids (NewNodeId, default a short GUID), (20, 20) offset from
    // the COPIED originals (not cumulative — a second Ctrl+V lands on top of the first paste, same
    // as most desktop editors), internal edges remapped, the new nodes selected.
    private async Task PasteNodesAsync(List<FlowNode> nodes, List<FlowEdge> edges)
    {
        if (Readonly || nodes.Count == 0) return;
        var idMap = new Dictionary<string, string>(StringComparer.Ordinal);
        var newNodes = new List<FlowNode>(nodes.Count);
        foreach (var n in nodes)
        {
            var newId = NewNodeId?.Invoke(n) ?? "flow-node-" + Guid.NewGuid().ToString("N")[..10];
            idMap[n.Id] = newId;
            newNodes.Add(n with { Id = newId, X = n.X + 20, Y = n.Y + 20 });
        }
        var newEdges = edges
            .Where(e => idMap.ContainsKey(e.Source) && idMap.ContainsKey(e.Target))
            .Select(e => e with { Id = "flow-edge-" + Guid.NewGuid().ToString("N")[..10], Source = idMap[e.Source], Target = idMap[e.Target] })
            .ToList();

        await EmitNodesAsync(_nodes.Concat(newNodes).ToList());
        if (newEdges.Count > 0) await EmitEdgesAsync(_edges.Concat(newEdges).ToList());
        PushHistory();

        _state.SelectedNodeIds.Clear();
        _state.SelectedEdgeIds.Clear();
        foreach (var n in newNodes) _state.SelectedNodeIds.Add(n.Id);
        StateHasChanged();
        await RaiseSelectionChangedAsync();
        if (OnPaste.HasDelegate) await OnPaste.InvokeAsync(new FlowPasteEventArgs(newNodes, newEdges));
    }

    // ── Phase 4: edge label inline editing (called by FlowEdgeLayer) ─────

    internal async Task CommitEdgeLabelAsync(FlowEdge edge, string? newLabel)
    {
        if (Readonly) return;
        var trimmed = string.IsNullOrEmpty(newLabel) ? null : newLabel;
        var updated = edge with { Label = trimmed };
        await EmitEdgesAsync(_edges.Select(e => e.Id == edge.Id ? updated : e).ToList());
        PushHistory();
        if (OnEdgeLabelChanged.HasDelegate) await OnEdgeLabelChanged.InvokeAsync(updated);
        Announce(L["Flow.EdgeLabelUpdated"]);
    }

    private Task EmitNodesAsync(List<FlowNode> next)
    {
        // State first, synchronously — anything that arrives while NodesChanged is awaited (a
        // second commit, a keyboard move) builds on this list, not on the one it replaced.
        _nodes = next;
        _recentEmitted.Add(next);
        if (_recentEmitted.Count > 8) _recentEmitted.RemoveAt(0);
        StateHasChanged();
        return NodesChanged.HasDelegate ? NodesChanged.InvokeAsync(next) : Task.CompletedTask;
    }

    private Task EmitEdgesAsync(List<FlowEdge> next)
    {
        _edges = next;
        _recentEmittedEdges.Add(next);
        if (_recentEmittedEdges.Count > 8) _recentEmittedEdges.RemoveAt(0);
        StateHasChanged();
        return EdgesChanged.HasDelegate ? EdgesChanged.InvokeAsync(next) : Task.CompletedTask;
    }

    // ── Imperative API ───────────────────────────────────────────────────

    /// <summary>Fits every node into view. <paramref name="padding"/> defaults to <see cref="FitViewPadding"/>.</summary>
    public async Task FitViewAsync(double? padding = null)
    {
        var pad = padding ?? FitViewPadding;
        if (_nodes.Count == 0) return;
        if (_state.PaneWidth > 0 && _state.PaneHeight > 0 && _state.AllSized(_nodes)
            && _state.ComputeFit(_nodes, pad, MinZoom, MaxZoom) is { } vp)
        {
            await SetViewportCoreAsync(vp);
            return;
        }
        // Some node has never been measured: let the engine measure the DOM and fit (it reports back).
        if (_registered && !_disposed)
        {
            try { await Interop.FlowFitViewAsync(_paneRef, pad, MinZoom, MaxZoom); }
            catch (JSDisconnectedException) { }
        }
    }

    /// <summary>Zooms to <paramref name="zoom"/> (clamped to the zoom limits), keeping the pane centre fixed.</summary>
    public async Task ZoomToAsync(double zoom)
    {
        var current = await LiveViewportAsync();
        var z = FlowGeometry.ClampZoom(zoom, MinZoom, MaxZoom);
        await SetViewportCoreAsync(FlowGeometry.ZoomAt(current, z, _state.PaneWidth / 2, _state.PaneHeight / 2));
    }

    /// <summary>Zooms in one step (×1.2) around the pane centre.</summary>
    public async Task ZoomInAsync() => await ZoomToAsync((await LiveViewportAsync()).Zoom * FlowGeometry.ZoomStep);

    /// <summary>Zooms out one step (÷1.2) around the pane centre.</summary>
    public async Task ZoomOutAsync() => await ZoomToAsync((await LiveViewportAsync()).Zoom / FlowGeometry.ZoomStep);

    /// <summary>Centres the pane on flow point (<paramref name="x"/>, <paramref name="y"/>), optionally at a new zoom.</summary>
    public async Task SetCenterAsync(double x, double y, double? zoom = null)
    {
        var current = await LiveViewportAsync();
        var z = FlowGeometry.ClampZoom(zoom ?? current.Zoom, MinZoom, MaxZoom);
        await SetViewportCoreAsync(FlowGeometry.CenterOn(x, y, z, _state.PaneWidth, _state.PaneHeight));
    }

    /// <summary>Moves the canvas to <paramref name="viewport"/> (zoom clamped to the limits).</summary>
    public Task SetViewportAsync(FlowViewport viewport) => SetViewportCoreAsync(Sanitize(viewport));

    /// <summary>Pane-local pixels (relative to the canvas pane's top-left corner, e.g. <c>MouseEventArgs.OffsetX</c> on the pane) → flow coordinates, using the latest known viewport.</summary>
    public FlowPoint ScreenToFlow(double x, double y) => FlowGeometry.ScreenToFlow(x, y, _state.Viewport);

    /// <summary>Flow coordinates → pane-local pixels, using the latest known viewport.</summary>
    public FlowPoint FlowToScreen(double x, double y) => FlowGeometry.FlowToScreen(x, y, _state.Viewport);

    /// <summary>Replaces the selection with the given node ids (unknown ids are ignored). Clears any selected edges. Raises <see cref="OnSelectionChanged"/>.</summary>
    public async Task SelectAsync(IEnumerable<string> nodeIds)
    {
        ArgumentNullException.ThrowIfNull(nodeIds);
        _state.SelectedNodeIds.Clear();
        _state.SelectedEdgeIds.Clear();
        var live = new HashSet<string>(_nodes.Select(n => n.Id), StringComparer.Ordinal);
        foreach (var id in nodeIds) if (live.Contains(id)) _state.SelectedNodeIds.Add(id);
        StateHasChanged();
        await RaiseSelectionChangedAsync();
    }

    /// <summary>Clears the node and edge selection. Raises <see cref="OnSelectionChanged"/> when anything was selected.</summary>
    public Task ClearSelectionAsync() => ClearSelectionInternalAsync();

    internal async Task SetLockedAsync(bool locked)
    {
        if (_locked == locked) return;
        _locked = locked;
        RefreshContext();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Toggles <see cref="SnapToGrid"/> (what <see cref="FlowControls"/>' snap button calls). Raises <see cref="SnapToGridChanged"/>.</summary>
    internal async Task SetSnapToGridAsync(bool value)
    {
        if (_snapOverride == value) return;
        _snapOverride = value;
        _lastSnapToGridParam = value; // our own broadcast — the next OnParametersSet must not re-treat it as external
        RefreshContext();
        await InvokeAsync(StateHasChanged);
        if (SnapToGridChanged.HasDelegate) await InvokeAsync(() => SnapToGridChanged.InvokeAsync(value));
    }

    // ── Phase 4: export / import ─────────────────────────────────────────

    /// <summary>The canvas' current nodes, edges and viewport as one JSON-friendly value. See <see cref="LoadDocumentAsync"/>.</summary>
    public FlowDocument ToDocument() => new(_nodes, _edges, _state.Viewport);

    /// <summary>
    /// Replaces the canvas' nodes, edges and viewport with <paramref name="document"/> (e.g. the
    /// result of <see cref="ToDocument"/>, round-tripped through JSON). Clears the selection, pushes
    /// one <see cref="History"/> snapshot, and raises <see cref="NodesChanged"/>/<see cref="EdgesChanged"/>/<see cref="ViewportChanged"/>.
    /// </summary>
    public async Task LoadDocumentAsync(FlowDocument document)
    {
        ArgumentNullException.ThrowIfNull(document);
        // A drag/gesture in flight against the pre-load nodes must never land on top of this.
        _state.BumpGeneration();
        _state.SelectedNodeIds.Clear();
        _state.SelectedEdgeIds.Clear();
        await EmitNodesAsync((document.Nodes ?? Array.Empty<FlowNode>()).ToList());
        await EmitEdgesAsync((document.Edges ?? Array.Empty<FlowEdge>()).ToList());
        await SetViewportCoreAsync(Sanitize(document.Viewport));
        PushHistory();
        await RaiseSelectionChangedAsync();
    }

    /// <summary>
    /// A self-contained, themeable-independent SVG (edges as paths, nodes as plain rounded boxes,
    /// both with their label text) built purely from the canvas' own state — no DOM access, so it
    /// never fails and needs no interop. For a closer visual copy of the live node templates use
    /// <see cref="ExportPngAsync"/> instead.
    /// </summary>
    public Task<string> ExportSvgAsync()
    {
        var bounds = FlowGeometry.GetBounds(_nodes.Select(_state.GetNodeRect)) ?? new FlowRect(0, 0, 100, 100);
        const double pad = 20;
        var minX = bounds.X - pad;
        var minY = bounds.Y - pad;
        var width = Math.Max(1, bounds.Width + pad * 2);
        var height = Math.Max(1, bounds.Height + pad * 2);

        var sb = new StringBuilder();
        sb.Append("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"")
          .Append(FlowGeometry.Fmt(minX)).Append(' ').Append(FlowGeometry.Fmt(minY)).Append(' ')
          .Append(FlowGeometry.Fmt(width)).Append(' ').Append(FlowGeometry.Fmt(height))
          .Append("\" width=\"").Append(FlowGeometry.Fmt(width)).Append("\" height=\"").Append(FlowGeometry.Fmt(height)).Append("\">");
        sb.Append("<rect x=\"").Append(FlowGeometry.Fmt(minX)).Append("\" y=\"").Append(FlowGeometry.Fmt(minY))
          .Append("\" width=\"").Append(FlowGeometry.Fmt(width)).Append("\" height=\"").Append(FlowGeometry.Fmt(height)).Append("\" fill=\"#ffffff\"/>");

        // Colours here are intentionally hardcoded, not theme tokens: an exported SVG is a portable
        // artifact meant to be opened outside the app (no CSS variables to resolve against once it
        // leaves the page) — see DESIGN.md's Phase 4 section.
        foreach (var (edge, path, _, _) in RenderableEdges())
        {
            sb.Append("<path d=\"").Append(System.Net.WebUtility.HtmlEncode(path.D)).Append("\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"1.5\"/>");
            if (!string.IsNullOrEmpty(edge.Label))
            {
                sb.Append("<text x=\"").Append(FlowGeometry.Fmt(path.LabelX)).Append("\" y=\"").Append(FlowGeometry.Fmt(path.LabelY))
                  .Append("\" font-size=\"10\" text-anchor=\"middle\" font-family=\"sans-serif\" fill=\"#334155\">")
                  .Append(System.Net.WebUtility.HtmlEncode(edge.Label)).Append("</text>");
            }
        }
        foreach (var node in _nodes)
        {
            var rect = _state.GetNodeRect(node);
            sb.Append("<rect x=\"").Append(FlowGeometry.Fmt(rect.X)).Append("\" y=\"").Append(FlowGeometry.Fmt(rect.Y))
              .Append("\" width=\"").Append(FlowGeometry.Fmt(rect.Width)).Append("\" height=\"").Append(FlowGeometry.Fmt(rect.Height))
              .Append("\" rx=\"6\" fill=\"#f8fafc\" stroke=\"#cbd5e1\"/>");
            var label = node.Data?.ToString() ?? node.Id;
            sb.Append("<text x=\"").Append(FlowGeometry.Fmt(rect.X + rect.Width / 2)).Append("\" y=\"").Append(FlowGeometry.Fmt(rect.Y + rect.Height / 2))
              .Append("\" font-size=\"12\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"sans-serif\" fill=\"#0f172a\">")
              .Append(System.Net.WebUtility.HtmlEncode(label)).Append("</text>");
        }
        sb.Append("</svg>");
        return Task.FromResult(sb.ToString());
    }

    /// <summary>
    /// Best-effort raster export of the live node DOM (SVG <c>&lt;foreignObject&gt;</c> with each
    /// node's computed styles inlined, drawn to a <c>&lt;canvas&gt;</c>) as a <c>data:image/png</c>
    /// URL, at <paramref name="scale"/>× the canvas' flow units. Returns <c>null</c> — never throws —
    /// when the canvas is not registered, has no nodes, or the browser refuses to read back the
    /// canvas (a tainted canvas from a cross-origin image/font in a node template is the most likely
    /// cause; nothing here can work around that). A failed attempt is still journaled
    /// (<c>window.__lumeoFlowDiag</c>) for diagnosis. Prefer <see cref="ExportSvgAsync"/> when a
    /// vector export is enough — it cannot fail this way.
    /// </summary>
    public async Task<string?> ExportPngAsync(double scale = 1)
    {
        if (!_registered || _disposed) return null;
        try { return await Interop.FlowExportPngAsync(_paneRef, scale > 0 ? scale : 1); }
        catch (JSDisconnectedException) { return null; }
    }

    private async Task<FlowViewport> LiveViewportAsync()
    {
        if (_registered && !_disposed)
        {
            try
            {
                var live = await Interop.FlowGetViewportAsync(_paneRef);
                if (live is { Length: 3 } && live[2] > 0) return new FlowViewport(live[0], live[1], live[2]);
            }
            catch (JSDisconnectedException) { }
        }
        return _state.Viewport;
    }

    private async Task SetViewportCoreAsync(FlowViewport viewport)
    {
        _state.Stamp(viewport);
        RefreshContext();
        await InvokeAsync(StateHasChanged);
        if (ViewportChanged.HasDelegate) await InvokeAsync(() => ViewportChanged.InvokeAsync(viewport));
    }

    // ── Engine callbacks (flow.js) ───────────────────────────────────────

    /// <summary>Engine callback: a node drag ended. Applies the positions unless the drag started under an older node list (<paramref name="generation"/>) or editing is off; returns whether it did. Not meant for application code.</summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public async Task<bool> CommitNodeDrag(FlowNodeChange[] changes, int generation)
    {
        var hadDragging = _state.DraggingNodeIds.Count > 0;
        _state.DraggingNodeIds.Clear();
        if (changes is null || changes.Length == 0 || !CanMoveNodes || generation != _state.Generation)
        {
            if (hadDragging) StateHasChanged();
            return false;
        }

        var map = new Dictionary<string, FlowNodeChange>(StringComparer.Ordinal);
        foreach (var c in changes)
        {
            if (c is null || string.IsNullOrEmpty(c.Id) || !double.IsFinite(c.X) || !double.IsFinite(c.Y)) continue;
            map[c.Id] = c;
        }

        var applied = new List<FlowNodeChange>();
        var next = new List<FlowNode>(_nodes.Count);
        foreach (var n in _nodes)
        {
            if (n.Draggable && map.TryGetValue(n.Id, out var c))
            {
                next.Add(n with { X = c.X, Y = c.Y });
                applied.Add(new FlowNodeChange(n.Id, c.X, c.Y));
            }
            else
            {
                next.Add(n);
            }
        }
        if (applied.Count == 0)
        {
            if (hadDragging) StateHasChanged();
            return false;
        }

        await EmitNodesAsync(next);
        PushHistory();
        if (OnNodeDragStop.HasDelegate) await OnNodeDragStop.InvokeAsync(applied);
        return true;
    }

    /// <summary>Engine callback: a drag passed its threshold. Not meant for application code.</summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public void NodeDragStart(string[] ids)
    {
        _state.DraggingNodeIds.Clear();
        if (ids is not null) foreach (var id in ids) if (!string.IsNullOrEmpty(id)) _state.DraggingNodeIds.Add(id);
        StateHasChanged();
    }

    /// <summary>Engine callback: a drag was cancelled (Escape, pointer cancel). Not meant for application code.</summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public void NodeDragCancelled()
    {
        if (_state.DraggingNodeIds.Count == 0) return;
        _state.DraggingNodeIds.Clear();
        StateHasChanged();
    }

    /// <summary>Engine callback: the viewport moved (pan, wheel zoom, engine fit). Not meant for application code.</summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public async Task OnViewportChanged(double x, double y, double zoom, bool final)
    {
        if (!double.IsFinite(x) || !double.IsFinite(y) || !(zoom > 0)) return;
        var viewport = new FlowViewport(x, y, zoom);
        _state.Report(viewport);
        if (ViewportChanged.HasDelegate) await ViewportChanged.InvokeAsync(viewport);
        if (final)
        {
            // Once per gesture: refresh what depends on the zoom (the controls' limits).
            RefreshContext();
            StateHasChanged();
        }
    }

    /// <summary>Engine callback: node sizes / handle offsets were measured. Not meant for application code.</summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public void NodesMeasured(FlowNodeMeasurement[] measurements)
    {
        if (measurements is null) return;
        if (_state.ApplyMeasurements(measurements)) StateHasChanged();
    }

    /// <summary>Engine callback: the pane was resized. Not meant for application code.</summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public void PaneResized(double width, double height) => _state.SetPaneSize(width, height);

    /// <summary>Engine callback: the background was clicked at a flow point. Not meant for application code.</summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public async Task PaneClicked(double x, double y)
    {
        await ClearSelectionInternalAsync();
        if (OnPaneClick.HasDelegate) await OnPaneClick.InvokeAsync(new FlowPoint(x, y));
    }

    /// <summary>Engine callback: a connection (pointer drop or keyboard commit) proposed source→target. Validated against <see cref="NodesConnectable"/>, both nodes' <c>Connectable</c>, <see cref="Readonly"/> and <see cref="IsValidConnection"/>; returns whether it was accepted. Not meant for application code.</summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public async Task<bool> CommitConnect(string source, string? sourceHandle, string target, string? targetHandle)
    {
        if (!CanConnectGlobally || string.IsNullOrEmpty(source) || string.IsNullOrEmpty(target)) return false;
        var s = _nodes.FirstOrDefault(n => n.Id == source);
        var t = _nodes.FirstOrDefault(n => n.Id == target);
        if (s is null || t is null || !s.Connectable || !t.Connectable) return false;

        var connection = new FlowConnection(source, sourceHandle, target, targetHandle);
        if (IsValidConnection is not null && !IsValidConnection(connection)) return false;

        if (OnConnect.HasDelegate)
        {
            await OnConnect.InvokeAsync(connection);
            return true;
        }

        var id = "flow-edge-" + Guid.NewGuid().ToString("N")[..10];
        var next = new List<FlowEdge>(_edges) { new(id, source, target, sourceHandle, targetHandle) };
        await EmitEdgesAsync(next);
        PushHistory();
        return true;
    }

    /// <summary>
    /// Engine callback: an existing edge's end (<paramref name="movingEnd"/>: "source" or "target")
    /// was dragged onto a new handle. Re-validated against <see cref="NodesConnectable"/>, the new
    /// endpoint node's <c>Connectable</c>, <see cref="Readonly"/>/<see cref="EdgesReconnectable"/> and
    /// <see cref="IsValidConnection"/> (built from the edge's OTHER, unmoved end); returns whether it
    /// was accepted. Not meant for application code.
    /// </summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public async Task<bool> CommitReconnect(string edgeId, string movingEnd, string newNodeId, string? newHandleId)
    {
        if (!EdgesReconnectable || Readonly || !CanConnectGlobally) return false;
        if (string.IsNullOrEmpty(edgeId) || string.IsNullOrEmpty(newNodeId)) return false;
        var edge = _edges.FirstOrDefault(e => e.Id == edgeId);
        if (edge is null) return false; // Deletable does not gate a reconnect — only a delete
        var newNode = _nodes.FirstOrDefault(n => n.Id == newNodeId);
        if (newNode is null || !newNode.Connectable) return false;

        FlowConnection connection;
        if (movingEnd == "source")
        {
            var t = _nodes.FirstOrDefault(n => n.Id == edge.Target);
            if (t is null || !t.Connectable) return false;
            connection = new FlowConnection(newNodeId, newHandleId, edge.Target, edge.TargetHandle);
        }
        else
        {
            var s = _nodes.FirstOrDefault(n => n.Id == edge.Source);
            if (s is null || !s.Connectable) return false;
            connection = new FlowConnection(edge.Source, edge.SourceHandle, newNodeId, newHandleId);
        }
        if (IsValidConnection is not null && !IsValidConnection(connection)) return false;

        if (OnReconnect.HasDelegate)
        {
            await OnReconnect.InvokeAsync(new FlowReconnectEventArgs(edge, connection));
            return true;
        }

        var updated = edge with { Source = connection.Source, SourceHandle = connection.SourceHandle, Target = connection.Target, TargetHandle = connection.TargetHandle };
        var next = _edges.Select(e => e.Id == edgeId ? updated : e).ToList();
        await EmitEdgesAsync(next);
        PushHistory();
        return true;
    }

    /// <summary>Engine callback: a marquee (shift-drag) selected these node ids. Replaces the selection. Not meant for application code.</summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public async Task CommitMarquee(string[] nodeIds)
    {
        if (!ElementsSelectable) return;
        var live = new HashSet<string>(_nodes.Where(n => n.Selectable).Select(n => n.Id), StringComparer.Ordinal);
        _state.SelectedNodeIds.Clear();
        _state.SelectedEdgeIds.Clear();
        if (nodeIds is not null) foreach (var id in nodeIds) if (live.Contains(id)) _state.SelectedNodeIds.Add(id);
        StateHasChanged();
        await RaiseSelectionChangedAsync();
    }

    /// <summary>Engine callback: a resize gesture ended. Mirrors <see cref="CommitNodeDrag"/>'s generation guard and acceptance rules. Not meant for application code.</summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public async Task<bool> CommitNodeResize(string id, double x, double y, double width, double height, int generation)
    {
        if (Readonly || _locked || generation != _state.Generation || string.IsNullOrEmpty(id)
            || !double.IsFinite(x) || !double.IsFinite(y) || !(width > 0) || !(height > 0))
        {
            return false;
        }
        var current = _nodes.FirstOrDefault(n => n.Id == id);
        if (current is null) return false;

        var updated = current with { X = x, Y = y, Width = width, Height = height };
        await EmitNodesAsync(_nodes.Select(n => n.Id == id ? updated : n).ToList());
        PushHistory();
        if (OnNodeResizeStop.HasDelegate)
            await OnNodeResizeStop.InvokeAsync(new[] { new FlowNodeResizeChange(id, x, y, width, height) });
        return true;
    }

    /// <summary>
    /// Engine callback (<see cref="ValidateOnHover"/> only): the same acceptance check
    /// <see cref="CommitConnect"/> runs, WITHOUT committing anything — called once per hovered
    /// target-handle change while a connect gesture is in flight. Not meant for application code.
    /// </summary>
    [JSInvokable, EditorBrowsable(EditorBrowsableState.Never)]
    public Task<bool> ValidateHoveredConnection(string source, string? sourceHandle, string target, string? targetHandle)
    {
        if (!CanConnectGlobally || string.IsNullOrEmpty(source) || string.IsNullOrEmpty(target)) return Task.FromResult(false);
        var s = _nodes.FirstOrDefault(n => n.Id == source);
        var t = _nodes.FirstOrDefault(n => n.Id == target);
        if (s is null || t is null || !s.Connectable || !t.Connectable) return Task.FromResult(false);
        var connection = new FlowConnection(source, sourceHandle, target, targetHandle);
        return Task.FromResult(IsValidConnection is null || IsValidConnection(connection));
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_registered)
        {
            try { await Interop.FlowUnregisterCanvasAsync(_paneRef); }
            catch (JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }
}
