@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Accordion Type="Accordion.AccordionType.Single" DefaultValues="@(new List<string> { "item-1" })">
        <AccordionItem Value="item-1">
            <AccordionTrigger>Is it accessible?</AccordionTrigger>
            <AccordionContent>Yes. It adheres to the WAI-ARIA design pattern.</AccordionContent>
        </AccordionItem>
        <AccordionItem Value="item-2">
            <AccordionTrigger>Is it styled?</AccordionTrigger>
            <AccordionContent>Yes, it matches the rest of the theme.</AccordionContent>
        </AccordionItem>
        <AccordionItem Value="item-3">
            <AccordionTrigger>Is it animated?</AccordionTrigger>
            <AccordionContent>Yes, and it can be disabled.</AccordionContent>
        </AccordionItem>
    </Accordion>
</div>
