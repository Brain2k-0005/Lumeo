    // ── Demo 3 — connect with validation ──────────────────────────────────
    private IReadOnlyList<FlowNode> _connectNodes = new List<FlowNode>
    {
        new("order", 0, 60, Type: "trigger", Data: "New order"),
        new("check", 280, 0, Data: "Check stock"),
        new("notify", 280, 130, Data: "Notify sales"),
    };
    private IReadOnlyList<FlowEdge> _connectEdges = new List<FlowEdge>();
    private string? _lastConnectionMessage;

    private bool ValidateConnection(FlowConnection connection)
    {
        var targetType = _connectNodes.FirstOrDefault(n => n.Id == connection.Target)?.Type;
        var ok = targetType != "trigger";
        _lastConnectionMessage = ok
            ? $"{connection.Source} → {connection.Target}: connected."
            : $"{connection.Source} → {connection.Target}: rejected — a trigger can't receive an incoming connection.";
        return ok;
    }

    private const string _connectCode = @"<FlowCanvas @bind-Nodes=""_nodes"" @bind-Edges=""_edges"" Height=""300px""
            IsValidConnection=""ValidateConnection"">
    <NodeTemplate Context=""ctx"">
