@namespace Lumeo.Docs.Shared.Showcases

@* Bento is a full landing-grid component — one representative tile (its
   natural minimum unit) is the cropped, scaled-down slice that fits the
   16:9 box, per the wave brief ("one Bento cell"). At card width the grid's
   own responsive classes collapse to a single column anyway, so a single
   tile keeps the showcase compact instead of stacking two. *@
<div class="w-full max-w-[16rem]">
    <Bento Columns="1" Gap="Bento.BentoGap.Sm">
        <BentoTile Title="Active Users" Description="Last 30 days">
            <Lumeo.Text Class="text-2xl font-bold text-foreground">8,204</Lumeo.Text>
        </BentoTile>
    </Bento>
</div>
