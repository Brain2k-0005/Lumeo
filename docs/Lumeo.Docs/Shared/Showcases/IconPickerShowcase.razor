@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <IconPicker Icons="_icons" @bind-Value="_value" Clearable="true" />
</div>

@code {
    private string? _value = "House";

    private readonly List<IconPickerItem> _icons = new()
    {
        new("House", Lucide.House),
        new("Star", Lucide.Star),
        new("Settings", Lucide.Settings),
        new("Heart", Lucide.Heart),
        new("Bell", Lucide.Bell),
        new("Bookmark", Lucide.Bookmark),
    };
}
