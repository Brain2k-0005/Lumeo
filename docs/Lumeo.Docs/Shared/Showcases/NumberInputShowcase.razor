@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Stack Gap="3" Class="max-w-xs">
        <NumberInput @bind-Value="_qty" Min="0" Max="99" Step="1" />
        <NumberInput @bind-Value="_price" Min="0" Step="0.01" Precision="2" Prefix="$" />
    </Stack>
</div>

@code {
    private double? _qty = 3;
    private double? _price = 19.99;
}
