@namespace Lumeo.Docs.Shared.Showcases

@* Disabled/read-only with a deterministic inline SVG data: URI (no network call) —
   the same fixture the component's own docs page uses for its "read-only" demo, so the
   pad shows a recognizable captured signature immediately instead of an empty canvas. *@
<div class="w-full max-w-[22rem]">
    <SignaturePad Disabled="true" Value="@_signature" Width="280" Height="100" />
</div>

@code {
    private readonly string _signature = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 500 200'><path d='M30 130 C 80 60, 130 60, 170 130 S 260 200, 300 130 S 400 60, 470 130' stroke='%2360a5fa' stroke-width='3' fill='none' stroke-linecap='round'/></svg>";
}
