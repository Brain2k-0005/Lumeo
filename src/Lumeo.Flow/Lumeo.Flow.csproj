<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedPlatform>browser</SupportedPlatform>
    <!-- RootNamespace must be "Lumeo" (matching @namespace in .razor files), NOT "Lumeo.Flow"
         (the SDK default derived from the project name). If RootNamespace differs from the
         @namespace directive, the Razor SDK source generator emits duplicate type definitions
         (CS0101) — same reason Lumeo.Gantt pins it. -->
    <RootNamespace>Lumeo</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>

    <!-- NuGet Package Metadata -->
    <PackageId>Lumeo.Flow</PackageId>
    <!-- Version is inherited from /Directory.Build.props (lockstep with all Lumeo packages) -->
    <Title>Lumeo.Flow</Title>
    <Authors>nativ.sh</Authors>
    <Description>Flow package for Lumeo — install alongside Lumeo. Provides FlowCanvas, a node/flow editor canvas with templated nodes, SVG edges, pan, pointer-anchored zoom and node drag. First-party engine — no third-party runtime dependency.</Description>
    <PackageTags>blazor;components;ui;flow;node-editor;diagram;graph;canvas;lumeo</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Brain2k-0005/Lumeo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Brain2k-0005/Lumeo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(LumeoComponentsWebVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference core for shared types: ComponentInteropService, Button, Cx, localization. -->
    <ProjectReference Include="..\Lumeo\Lumeo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FlowState and the interop plumbing keep an internal surface; the bUnit suite
         exercises it directly (same arrangement as Lumeo.Gantt). -->
    <InternalsVisibleTo Include="Lumeo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The spec is committed next to the code (DESIGN.md); keep it out of the package. -->
    <None Remove="DESIGN.md" />
    <Content Remove="DESIGN.md" />
  </ItemGroup>

</Project>
