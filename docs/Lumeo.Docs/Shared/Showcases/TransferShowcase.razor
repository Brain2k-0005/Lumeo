@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <Transfer SourceItems="@_source" TargetItems="@_target"
              SourceItemsChanged="@(v => _source = v)" TargetItemsChanged="@(v => _target = v)"
              ShowSearch="false" ShowSelectAll="false" />
</div>

@code {
    private List<Lumeo.Transfer.TransferItem> _source = new()
    {
        new("Alex", "alex"),
        new("Bailey", "bailey"),
    };

    private List<Lumeo.Transfer.TransferItem> _target = new()
    {
        new("Casey", "casey"),
    };
}
