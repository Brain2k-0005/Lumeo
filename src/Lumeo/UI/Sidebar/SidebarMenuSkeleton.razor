@namespace Lumeo
@* shadcn's SidebarMenuSkeleton: a placeholder entry while the menu loads. The text bar's
   width varies per instance, as theirs does, so a list of them does not read as a grid. *@
<div data-slot="sidebar-menu-skeleton" data-sidebar="menu-skeleton" class="@CssClass" @attributes="AdditionalAttributes">
    @if (ShowIcon)
    {
        <Skeleton Class="size-4 rounded-md" data-sidebar="menu-skeleton-icon" />
    }
    <Skeleton Class="h-4 max-w-(--skeleton-width) flex-1" data-sidebar="menu-skeleton-text" style="@($"--skeleton-width:{_width}%")" />
</div>

@code {
    /// <summary>Show a square placeholder where the icon would be.</summary>
    [Parameter] public bool ShowIcon { get; set; }

    /// <summary>Additional CSS classes, merged after the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Unmatched attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly int _width = Random.Shared.Next(50, 90);

    private string CssClass => Cx.Merge("flex h-8 items-center gap-2 rounded-md px-2", Class);
}
