@namespace Lumeo.Docs.Shared.Showcases

<div class="w-full max-w-[22rem]">
    <ChipGroup>
        @foreach (var tag in _tags)
        {
            var t = tag;
            <Chip Closable="true" OnClose="@(() => _tags.Remove(t))">@t</Chip>
        }
    </ChipGroup>
    @if (_tags.Count == 0)
    {
        <Lumeo.Text Size="xs" Color="muted">All chips removed.</Lumeo.Text>
    }
</div>

@code {
    private List<string> _tags = new() { "Urgent", "Design", "Q3" };
}
