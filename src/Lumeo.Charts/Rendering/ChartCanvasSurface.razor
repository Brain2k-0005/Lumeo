@namespace Lumeo
@inject IComponentInteropService Interop

<canvas @ref="_element" id="@ElementId" class="lumeo-chart-canvas-surface @Class"
        width="@BackingWidth" height="@BackingHeight"
        style="width:@(Fmt(Width))px;height:@(Fmt(Height))px;display:block;"
        @attributes="AdditionalAttributes"></canvas>

@code {
    // The Canvas fallback paint surface (spec §2.4 point 3 / Appendix A's
    // canvasDraw contract) — opt-in only, never the default. C# has already
    // computed every command's geometry by the time it reaches here; this
    // component's only job is re-sending the command list to JS when it
    // actually changes (a cheap reference-equality-of-serialized-JSON dedup,
    // mirroring the same "don't repaint on every render" discipline used
    // elsewhere in the interaction layer).

    /// <summary>Custom CSS classes appended to the <c>&lt;canvas&gt;</c>.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>DOM id JS resolves the canvas by (<c>document.getElementById</c>) —
    /// stable across renders so re-registration on every draw isn't needed.</summary>
    [Parameter, EditorRequired] public string ElementId { get; set; } = string.Empty;

    /// <summary>CSS-pixel width.</summary>
    [Parameter] public double Width { get; set; }

    /// <summary>CSS-pixel height.</summary>
    [Parameter] public double Height { get; set; }

    /// <summary>Backing-store scale factor (typically <c>devicePixelRatio</c>)
    /// so strokes stay crisp on HiDPI displays.</summary>
    [Parameter] public double DevicePixelRatio { get; set; } = 1;

    /// <summary>Pre-computed draw commands. C# owns 100% of the geometry;
    /// JS only executes.</summary>
    [Parameter] public IReadOnlyList<ChartCanvasCommand>? Commands { get; set; }

    private ElementReference _element;
    private string? _lastCommandsJson;

    private int BackingWidth => (int)Math.Round(Width * Math.Max(1, DevicePixelRatio));
    private int BackingHeight => (int)Math.Round(Height * Math.Max(1, DevicePixelRatio));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Commands is null || Commands.Count == 0) return;

        var json = ChartCanvasCommandBuilder.ToJson(Commands);
        if (json == _lastCommandsJson) return;
        _lastCommandsJson = json;

        await Interop.ChartCanvasDraw(ElementId, json);
    }

    private static string Fmt(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
